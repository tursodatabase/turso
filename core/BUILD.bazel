load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script", "cargo_toml_env_vars")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

CORE_FEATURES = [
    "allocation_metric",
    "aristo-instr",
    "autovacuum",
    "bench",
    "cli_only",
    "codspeed",
    "conn_raw_api",
    "encryption",
    "experimental_win_iocp",
    "fs",
    "fts",
    "fuzz",
    "io_memory_yield",
    "io_uring",
    "json",
    "nanosecond-bench",
    "optimizer_params",
    "percentile",
    "pure-rust-crypto",
    "serde",
    "series",
    "simulator",
    "stacker",
    "test_helper",
    "time",
    "tracing_release",
    "uuid",
]

CORE_ALL_FEATURES = CORE_FEATURES + ["checksum"]

cargo_toml_env_vars(
    name = "cargo_env",
    src = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    aliases = aliases(build = True),
    build_script_env_files = [":cargo_env"],
    build_script_env = {"SOURCE_DATE_EPOCH": "0"},
    crate_features = CORE_ALL_FEATURES,
    crate_root = "build.rs",
    deps = all_crate_deps(build = True),
    edition = crate_edition(),
    rustc_env_files = [":cargo_env"],
)

rust_library(
    name = "turso_core",
    srcs = glob(
        ["**/*.rs"],
        exclude = [
            "benches/**/*.rs",
            "build.rs",
        ],
    ),
    aliases = aliases(),
    crate_features = CORE_ALL_FEATURES,
    crate_root = "lib.rs",
    deps = [
        ":build_script",
        "//extensions/core:turso_ext",
        "//sqlite/parser:turso_parser",
        "@crates//:stacker",
    ] + all_crate_deps(normal = True),
    edition = crate_edition(),
    proc_macro_deps = [
        "//macros:turso_macros",
    ] + all_crate_deps(proc_macro = True),
    rustc_flags = ["--allow=unstable-name-collisions"],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "turso_core_test",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate = ":turso_core",
    crate_features = CORE_ALL_FEATURES,
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    tags = ["manual"],
    timeout = "long",
)

sh_test(
    name = "turso_core_test_sharded",
    srcs = ["//tools/bazel:run_rust_tests.sh"],
    args = ["$(rootpath :turso_core_test)"],
    data = [":turso_core_test"],
    shard_count = 8,
    timeout = "long",
)

CORE_BENCHMARKS = {
    "alloc_collections": ["benches/alloc_collections.rs"],
    "benchmark": ["benches/benchmark.rs"],
    "count_benchmark": ["benches/count_benchmark.rs"],
    "create_index_benchmark": ["benches/create_index_benchmark.rs"],
    "fts_benchmark": ["benches/fts_benchmark.rs"],
    "fts_comparison_benchmark": ["benches/fts_comparison_benchmark.rs"],
    "graph_queries_benchmark": ["benches/graph_queries_benchmark.rs"],
    "hash_spill_benchmark": ["benches/hash_spill_benchmark.rs"],
    "json_benchmark": ["benches/json_benchmark.rs"],
    "logical_log_serialization": ["benches/logical_log_serialization.rs"],
    "mvcc_benchmark": ["benches/mvcc_benchmark.rs"],
    "mvcc_recovery_benchmark": ["benches/mvcc_recovery_benchmark.rs"],
    "prepare_benchmark": ["benches/prepare_benchmark.rs"],
    "prepare_params_benchmark": ["benches/prepare_params_benchmark.rs"],
    "record_recycling": ["benches/record_recycling.rs"],
    "scan_loop_benchmark": ["benches/scan_loop_benchmark.rs"],
    "select_star_benchmark": ["benches/select_star_benchmark.rs"],
    "sql_functions": glob(["benches/sql_functions/**/*.rs"]),
    "struct_union_benchmark": ["benches/struct_union_benchmark.rs"],
    "struct_union_profile": ["benches/struct_union_profile.rs"],
    "text_validate_benchmark": ["benches/text_validate_benchmark.rs"],
    "tpc_h_benchmark": ["benches/tpc_h_benchmark.rs"],
    "triggers": ["benches/triggers.rs"],
    "write_perf_benchmark": ["benches/write_perf_benchmark.rs"],
}

[
    rust_binary(
        name = name,
        srcs = srcs,
        aliases = aliases(normal = True, normal_dev = True, proc_macro_dev = True),
        compile_data = ["//:tpc_h_queries"],
        crate_root = srcs[0],
        deps = [":turso_core"] + all_crate_deps(normal = True, normal_dev = True),
        edition = crate_edition(),
        proc_macro_deps = ["//macros:turso_macros"] + all_crate_deps(proc_macro_dev = True),
        tags = ["manual"],
    )
    for name, srcs in CORE_BENCHMARKS.items()
]

[
    rust_binary(
        name = name + "_codspeed",
        srcs = srcs,
        aliases = aliases(normal = True, normal_dev = True, proc_macro_dev = True),
        compile_data = ["//:tpc_h_queries"],
        crate_features = ["codspeed"],
        crate_root = srcs[0],
        deps = [":turso_core"] + all_crate_deps(normal = True, normal_dev = True),
        edition = crate_edition(),
        proc_macro_deps = ["//macros:turso_macros"] + all_crate_deps(proc_macro_dev = True),
        tags = ["manual"],
    )
    for name, srcs in CORE_BENCHMARKS.items()
]
