operator Filter(input: Relation, predicates: Scalars);
operator Project(input: Relation, outputs: Outputs);
operator Distinct(input: Relation);
operator Join(left: Relation, right: Relation, kind: JoinKind, predicates: Scalars);
operator DependentJoin(left: Relation, right: Relation, kind: JoinKind, subquery: TableId);
operator Membership(left: Relation, right: Relation, lhs: Scalars, negated: Bool, subquery: TableId);

predicate Empty(Scalars) = empty_predicates;
predicate Pure(Scalars) = pure_predicates;
predicate Duplicates(Scalars) = duplicate_predicates;
predicate Reorderable(Relation) = reorderable_input;
predicate Inner(JoinKind) = inner_join;
predicate Existence(JoinKind) = existence_join;
predicate Identity(Relation, Outputs) = identity_projection;
predicate Passthrough(Outputs, Scalars) = passthrough_projection;
predicate Pullable(Relation, Relation, JoinKind) = can_pull_dependent_filter;
predicate PullableJoin(Relation, Relation, Scalars, JoinKind) = can_pull_filter_over_join;
predicate UnnestableMembership(Relation, Relation, Scalars) = can_unnest_membership;

constructor Concat(Scalars, Scalars): Scalars = concat_predicates;
constructor Deduplicate(Scalars): Scalars = deduplicate_predicates;
constructor PushFilter(Relation, Outputs, Scalars): Relation = push_filter_into_project;
constructor PullFilter(Relation, Relation, JoinKind): Relation = pull_dependent_filter;
constructor PullJoinedFilter(Relation, Relation, Scalars, JoinKind, TableId): Relation = pull_filter_over_join;
constructor MembershipJoin(Relation, Relation, Scalars, Bool, TableId): Relation = unnest_membership;

rule EliminateSelect normalize 10
    (Filter $input $predicates)
    when (Empty $predicates)
    => $input;

rule MergeSelects normalize 20
    (Filter (Filter $input $inner) $outer)
    when (Pure $inner)
    when (Pure $outer)
    => (Filter $input (Concat $inner $outer));

rule EliminateProject normalize 30
    (Project $input $outputs)
    when (Identity $input $outputs)
    => $input;

rule PushSelectIntoProject normalize 40
    (Filter (Project $input $outputs) $predicates)
    when (Passthrough $outputs $predicates)
    => (PushFilter $input $outputs $predicates);

rule MergeSelectInnerJoin normalize 50
    (Filter (Join $left $right $kind $on) $predicates)
    when (Inner $kind)
    when (Pure $on)
    when (Pure $predicates)
    when (Reorderable $left)
    when (Reorderable $right)
    => (Join $left $right $kind (Concat $on $predicates));

rule PullLeftFilter normalize 60
    (Join (Filter $left $predicates) $right $kind $on)
    when (Existence $kind)
    when (Pure $predicates)
    when (Pure $on)
    when (Reorderable $left)
    when (Reorderable $right)
    => (Filter (Join $left $right $kind $on) $predicates);

rule DeduplicateSelectFilters normalize 70
    (Filter $input $predicates)
    when (Pure $predicates)
    when (Duplicates $predicates)
    => (Filter $input (Deduplicate $predicates));

rule PullDependentFilter explore 10
    (DependentJoin $left $right $kind $subquery)
    when (Pullable $left $right $kind)
    => (PullFilter $left $right $kind);

rule PullDependentFilterOverJoin explore 20 grow 2
    (DependentJoin $left (Filter $input $predicates) $kind $subquery)
    when (PullableJoin $left $input $predicates $kind)
    => (PullJoinedFilter $left $input $predicates $kind $subquery);

rule UnnestMembership explore 30 grow 1
    (Membership $left $right $lhs $negated $subquery)
    when (UnnestableMembership $left $right $lhs)
    => (MembershipJoin $left $right $lhs $negated $subquery);
