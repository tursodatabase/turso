load("//tools/bazel:rust.bzl", "turso_cargo_build_script", "turso_cargo_package_env", "turso_rust_binary", "turso_rust_test")

CLI_FEATURES = [
    "io_uring",
    "mimalloc",
]

turso_cargo_package_env()

turso_cargo_build_script(
    build_script_env_files = [":cargo_env"],
    compile_data = ["//cli:SQL.sublime-syntax"],
    rustc_env_files = [":cargo_env"],
)

turso_rust_binary(
    name = "tursopg",
    srcs = [
        "main.rs",
        "read_state_machine.rs",
        "//cli:postgres_shared_srcs",
    ],
    crate_features = CLI_FEATURES,
    crate_root = "main.rs",
    rustc_env_files = [":cargo_env"],
    visibility = ["//visibility:public"],
    deps = [
        ":build_script",
        "//core:turso_core",
        "//postgres/frontend:turso_pg",
        "//postgres/server:turso_pg_server",
    ],
)

turso_rust_test(
    name = "tursopg_test",
    crate = ":tursopg",
    crate_features = CLI_FEATURES,
)

turso_rust_test(
    name = "tursopg_integration_test",
    srcs = ["tests/tursopg.rs"],
    cargo_target = "test:tursopg",
    crate_features = CLI_FEATURES,
    crate_root = "tests/tursopg.rs",
    data = [":tursopg"],
    rustc_env = {"CARGO_BIN_EXE_tursopg": "$(rootpath :tursopg)"},
)
