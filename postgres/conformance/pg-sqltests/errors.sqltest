test cast-nonzero-integer-to-boolean {
    SELECT 5::boolean, 0::boolean, (-3)::boolean;
}
expect {
    t|f|t
}

test chr-of-null-is-null {
    SELECT CASE WHEN chr(NULL) IS NULL THEN 'null' ELSE 'text' END;
}
expect {
    null
}

test error-chr-of-zero {
    SELECT chr(0);
}
@sqlstate 54000
expect error {
}

test math-functions-accept-nan-and-infinity-words {
    SELECT 'ok' FROM (SELECT ln('NaN') AS a, exp('inf') AS b, mod(1e308, 'NaN') AS c) s;
}
expect {
    ok
}

