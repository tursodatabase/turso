test cast-accepts-non-decimal-integers {
    SELECT '0x10'::int4, '0o17'::int2, '0b101'::int8, '1_000'::int4,
           CASE WHEN '0x10'::numeric = 16 THEN 'ok' ELSE 'no' END;
}
expect {
    16|15|5|1000|ok
}

