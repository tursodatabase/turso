test cast-accepts-valid-text-inputs {
    SELECT ' 42 '::int, '-7'::int2, '+5'::int8, '1.5'::float8, 'true'::boolean, 'f'::boolean;
}
expect {
    42|-7|5|1.5|t|f
}

test cast-json-preserves-text {
    SELECT '{"a" : 1}'::json;
}
expect {
    {"a" : 1}
}

test cast-float-to-int-rounds {
    SELECT 1.7::int, (-1.7)::int;
}
expect {
    2|-2
}

