test cast-numeric-accepts-values-beyond-float8 {
    SELECT CASE WHEN '1e400'::numeric > 0 THEN 'positive' ELSE 'other' END;
}
expect {
    positive
}

test cast-json-accepts-numbers-beyond-float8 {
    SELECT '[1e400]'::json;
}
expect {
    [1e400]
}

