# Error reporting through the PostgreSQL frontend. Expectations compare the
# SQLSTATE and not the message text: turso-pg and real PostgreSQL word their
# errors differently, and this corpus must stay valid for differential runs.

@database :memory:

test error-missing-table {
    SELECT * FROM missing;
}
@sqlstate 42P01
expect error {}

test error-missing-column {
    CREATE TABLE t (a int);
    SELECT nonexistent FROM t;
}
@sqlstate 42703
expect error {}

test error-missing-column-named-like-an-error-message {
    CREATE TABLE t (a int);
    SELECT "no such object" FROM t;
}
@sqlstate 42703
expect error {}

test error-column-default-calls-missing-function {
    CREATE TABLE t (id uuid DEFAULT nosuchfn(), name text);
}
@sqlstate 42883
expect error {}

test error-added-column-default-calls-missing-function {
    CREATE TABLE t (name text);
    ALTER TABLE t ADD COLUMN id uuid DEFAULT nosuchfn();
}
@sqlstate 42883
expect error {}

test error-domain-default-calls-missing-function {
    CREATE DOMAIN d AS int DEFAULT nosuchfn();
}
@sqlstate 42883
expect error {}

test error-domain-check-calls-missing-function {
    CREATE DOMAIN d AS int CHECK (nosuchfn(VALUE) > 0);
}
@sqlstate 42883
expect error {}

test domain-default-and-check-call-existing-functions {
    CREATE DOMAIN d AS int DEFAULT abs(-3) CHECK (abs(VALUE) < 10);
    CREATE TABLE t (a int, b d);
    INSERT INTO t (a) VALUES (1);
    SELECT b FROM t;
}
expect {
    3
}

test error-view-calls-missing-function {
    CREATE VIEW v AS SELECT nosuchfn();
}
@sqlstate 42883
expect error {}

test error-view-calls-missing-function-in-subquery {
    CREATE VIEW v AS SELECT (SELECT nosuchfn()) AS x;
}
@sqlstate 42883
expect error {}

test view-calls-function-from-extension {
    CREATE VIEW v AS SELECT gen_random_uuid() AS u;
    SELECT count(*) FROM v WHERE u IS NOT NULL;
}
expect {
    1
}

test error-syntax {
    SELEC 1;
}
@sqlstate 42601
expect error {}

test error-aborts-rest-of-batch {
    CREATE TABLE t (a int);
    INSERT INTO t VALUES (1);
    SELECT * FROM missing;
    INSERT INTO t VALUES (2);
}
@sqlstate 42P01
expect error {}

# Schema databases are file-backed, so the schema table is dropped before each
# create to keep repeated test runs independent of old sidecar files.
test error-drop-type-used-by-table-in-other-schema {
    CREATE SCHEMA IF NOT EXISTS err_drop_type;
    DROP TABLE IF EXISTS err_drop_type.t;
    CREATE TYPE mood AS ENUM ('happy', 'sad');
    CREATE TABLE err_drop_type.t (m mood);
    DROP TYPE mood;
}
@sqlstate 2BP01
expect error {}

test error-drop-domain-used-by-table-in-other-schema {
    CREATE SCHEMA IF NOT EXISTS err_drop_domain;
    DROP TABLE IF EXISTS err_drop_domain.t;
    CREATE DOMAIN pos AS integer CHECK (VALUE > 0);
    CREATE TABLE err_drop_domain.t (v pos);
    DROP DOMAIN pos;
}
@sqlstate 2BP01
expect error {}
