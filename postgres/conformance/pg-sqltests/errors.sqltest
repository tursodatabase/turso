test order-by-collated-constant-is-an-expression {
    CREATE TABLE obc (x int4);
    INSERT INTO obc VALUES (1), (3);
    SELECT x FROM obc ORDER BY 'a' COLLATE "C";
}
expect {
    1
    3
}

