# Error reporting through the PostgreSQL frontend. Expectations compare the
# SQLSTATE and not the message text: turso-pg and real PostgreSQL word their
# errors differently, and this corpus must stay valid for differential runs.

@database :memory:

test error-missing-table {
    SELECT * FROM missing;
}
@sqlstate 42P01
expect error {}

test error-missing-column {
    CREATE TABLE t (a int);
    SELECT nonexistent FROM t;
}
@sqlstate 42703
expect error {}

test error-missing-column-named-like-an-error-message {
    CREATE TABLE t (a int);
    SELECT "no such object" FROM t;
}
@sqlstate 42703
expect error {}

test error-syntax {
    SELEC 1;
}
@sqlstate 42601
expect error {}

test error-aborts-rest-of-batch {
    CREATE TABLE t (a int);
    INSERT INTO t VALUES (1);
    SELECT * FROM missing;
    INSERT INTO t VALUES (2);
}
@sqlstate 42P01
expect error {}

# Schema databases are file-backed, so the schema table is dropped before each
# create to keep repeated test runs independent of old sidecar files.
test error-drop-type-used-by-table-in-other-schema {
    CREATE SCHEMA IF NOT EXISTS err_drop_type;
    DROP TABLE IF EXISTS err_drop_type.t;
    CREATE TYPE mood AS ENUM ('happy', 'sad');
    CREATE TABLE err_drop_type.t (m mood);
    DROP TYPE mood;
}
@sqlstate 2BP01
expect error {}

test error-drop-domain-used-by-table-in-other-schema {
    CREATE SCHEMA IF NOT EXISTS err_drop_domain;
    DROP TABLE IF EXISTS err_drop_domain.t;
    CREATE DOMAIN pos AS integer CHECK (VALUE > 0);
    CREATE TABLE err_drop_domain.t (v pos);
    DROP DOMAIN pos;
}
@sqlstate 2BP01
expect error {}

test error-create-table-duplicate-column {
    CREATE TABLE dupcol (x int, x int);
}
@sqlstate 42701
expect error {
}

test error-add-column-duplicate {
    CREATE TABLE adddup (x int);
    ALTER TABLE adddup ADD COLUMN x int;
}
@sqlstate 42701
expect error {
}

test error-drop-missing-view {
    DROP VIEW no_such_view;
}
@sqlstate 42P01
expect error {
}

test error-drop-missing-index {
    DROP INDEX no_such_index;
}
@sqlstate 42704
expect error {
}

test error-foreign-key-enforced-by-default {
    CREATE TABLE fkparent (id int PRIMARY KEY);
    CREATE TABLE fkchild (pid int REFERENCES fkparent(id));
    INSERT INTO fkchild VALUES (999);
}
@sqlstate 23503
expect error {
}

test error-foreign-key-delete-enforced-by-default {
    CREATE TABLE delparent (id int PRIMARY KEY);
    CREATE TABLE delchild (pid int REFERENCES delparent(id));
    INSERT INTO delparent VALUES (1);
    INSERT INTO delchild VALUES (1);
    DELETE FROM delparent WHERE id = 1;
}
@sqlstate 23503
expect error {
}

