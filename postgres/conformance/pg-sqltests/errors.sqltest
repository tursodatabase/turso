# Error reporting through the PostgreSQL frontend. Expectations compare the
# SQLSTATE and not the message text: turso-pg and real PostgreSQL word their
# errors differently, and this corpus must stay valid for differential runs.

@database :memory:

test error-missing-table {
    SELECT * FROM missing;
}
@sqlstate 42P01
expect error {}

test error-missing-column {
    CREATE TABLE t (a int);
    SELECT nonexistent FROM t;
}
@sqlstate 42703
expect error {}

test error-missing-column-named-like-an-error-message {
    CREATE TABLE t (a int);
    SELECT "no such object" FROM t;
}
@sqlstate 42703
expect error {}

test error-syntax {
    SELEC 1;
}
@sqlstate 42601
expect error {}

test error-zero-parameter {
    SELECT $0;
}
@sqlstate 42P02
expect error {}

# tursopg does not have LISTEN.
@compat-gap "syntax:unsupported-statement"
test error-unsupported-statement {
    LISTEN channel;
}
expect {
}
@sqlstate 0A000
expect @tursopg error {
}

test error-values-lists-have-different-lengths {
    VALUES (1), (2, 3), (4);
}
@sqlstate 42601
expect error {}

test error-insert-values-lists-have-different-lengths {
    CREATE TABLE t (a int, b int);
    INSERT INTO t VALUES (1), (2, 3), (4);
}
@sqlstate 42601
expect error {}

test error-insert-values-default-and-short-row {
    CREATE TABLE t (a int, b int);
    INSERT INTO t (a, b) VALUES (1, DEFAULT), (2);
}
@sqlstate 42601
expect error {}

test error-aborts-rest-of-batch {
    CREATE TABLE t (a int);
    INSERT INTO t VALUES (1);
    SELECT * FROM missing;
    INSERT INTO t VALUES (2);
}
@sqlstate 42P01
expect error {}

# Schema databases are file-backed, so the schema table is dropped before each
# create to keep repeated test runs independent of old sidecar files.
test error-drop-type-used-by-table-in-other-schema {
    CREATE SCHEMA IF NOT EXISTS err_drop_type;
    DROP TABLE IF EXISTS err_drop_type.t;
    CREATE TYPE mood AS ENUM ('happy', 'sad');
    CREATE TABLE err_drop_type.t (m mood);
    DROP TYPE mood;
}
@sqlstate 2BP01
expect error {}

test error-drop-domain-used-by-table-in-other-schema {
    CREATE SCHEMA IF NOT EXISTS err_drop_domain;
    DROP TABLE IF EXISTS err_drop_domain.t;
    CREATE DOMAIN pos AS integer CHECK (VALUE > 0);
    CREATE TABLE err_drop_domain.t (v pos);
    DROP DOMAIN pos;
}
@sqlstate 2BP01
expect error {}

test error-drop-type-used-by-a-cast-in-a-policy {
    CREATE TYPE err_policy_mood AS ENUM ('happy', 'sad');
    CREATE TABLE err_policy_t (m text);
    CREATE POLICY err_policy_p ON err_policy_t USING (m::err_policy_mood = 'happy');
    DROP TYPE err_policy_mood;
}
@sqlstate 2BP01
expect error {}

# The statements below are valid PostgreSQL that tursopg refuses. A refusal
# has SQLSTATE 0A000, never a syntax error or an internal error.

@compat-gap "syntax:select"
test error-unsupported-select-without-columns {
    CREATE TABLE t (a int);
    SELECT FROM t;
}
expect {
}
@sqlstate 0A000
expect @tursopg error {}

@compat-gap "syntax:values"
test error-unsupported-values-in-a-set-operation {
    VALUES (1) UNION VALUES (2) ORDER BY 1;
}
expect {
    1
    2
}
@sqlstate 0A000
expect @tursopg error {}

@compat-gap "syntax:create-function"
test error-unsupported-function-cost-with-underscores {
    CREATE FUNCTION f() RETURNS int LANGUAGE sql COST 1_000.5 AS 'SELECT 1';
}
expect {
}
@sqlstate 0A000
expect @tursopg error {}

@compat-gap "syntax:select-into"
test error-unsupported-select-into-in-a-set-operation {
    SELECT 1 AS a INTO t UNION SELECT 2;
}
expect {
}
@sqlstate 0A000
expect @tursopg error {}

@compat-gap "syntax:array-slice"
test error-unsupported-array-slice-without-lower-bound {
    SELECT (ARRAY[1, 2, 3])[:2];
}
expect {
    {1,2}
}
@sqlstate 0A000
expect @tursopg error {}

@compat-gap "syntax:from-function"
test error-unsupported-coalesce-in-from {
    SELECT * FROM coalesce(1, 2);
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {}

@compat-gap "syntax:drop-cast"
test error-unsupported-drop-cast {
    DROP CAST IF EXISTS (int AS text);
}
expect {
}
@sqlstate 0A000
expect @tursopg error {}

@compat-gap "syntax:drop-operator"
test error-unsupported-drop-operator {
    DROP OPERATOR IF EXISTS ### (int, int);
}
expect {
}
@sqlstate 0A000
expect @tursopg error {}

@compat-gap "syntax:copy"
test error-unsupported-copy-to-program {
    CREATE TABLE t (a int);
    COPY t TO PROGRAM 'cat';
}
expect {
}
@sqlstate 0A000
expect @tursopg error {}

@compat-gap "syntax:with-search"
test error-unsupported-search-depth-first {
    WITH RECURSIVE r(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM r WHERE n < 2)
        SEARCH DEPTH FIRST BY n SET ord
    SELECT n FROM r ORDER BY ord;
}
expect {
    1
    2
}
@sqlstate 0A000
expect @tursopg error {}

test error-drop-policy-on-a-table-of-another-database {
    DROP POLICY p ON db.s.t;
}
@sqlstate 0A000
expect error {}

test error-json-to-record-with-two-arguments {
    SELECT * FROM json_to_record('{"a": 1}', 1) AS x(a int);
}
@sqlstate 42883
expect error {}

test error-distinct-on-a-function-that-is-not-an-aggregate {
    SELECT int4(DISTINCT a) FROM (VALUES (1)) AS t(a);
}
@sqlstate 42809
expect error {}

# The statements below fail in PostgreSQL with an error other than
# feature_not_supported, and tursopg reports the same SQLSTATE.

test error-update-assigns-a-column-twice {
    CREATE TABLE t (a int);
    UPDATE t SET a = 1, a = 2;
}
@sqlstate 42601
expect error {}

test error-on-conflict-assigns-a-column-twice {
    CREATE TABLE t (a int PRIMARY KEY);
    INSERT INTO t VALUES (1) ON CONFLICT (a) DO UPDATE SET a = 2, a = 3;
}
@sqlstate 42601
expect error {}

@compat-gap "syntax:copy"
test copy-to-with-freeze-false {
    CREATE TABLE t (a int);
    COPY t TO STDOUT (FREEZE false);
}
expect {
}
@sqlstate 0A000
expect @tursopg error {}

test error-alter-sequence-owned-by-one-name {
    CREATE SEQUENCE s;
    ALTER SEQUENCE s OWNED BY x;
}
@sqlstate 42601
expect error {}

@compat-gap "syntax:row-star"
test union-of-a-row-star-and-two-columns {
    CREATE TABLE u2(a int, b int);
    INSERT INTO u2 VALUES (1, 2);
    SELECT (u2).* FROM u2 UNION ALL SELECT 3, 4 ORDER BY 1;
}
expect {
    1|2
    3|4
}
@sqlstate 0A000
expect @tursopg error {}

@compat-gap "syntax:row-field"
test field-of-a-row-constructor {
    SELECT (ROW(1, 2)).f1;
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {}
