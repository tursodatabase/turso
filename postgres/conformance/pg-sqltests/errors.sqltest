test insert-rounds-float-into-integer-column {
    CREATE TABLE ins4 (a bigint);
    INSERT INTO ins4 VALUES (2.5), (-2.5);
    SELECT a FROM ins4 ORDER BY a;
}
expect {
    -3
    3
}

test insert-fills-missing-trailing-columns {
    CREATE TABLE ins5 (a int4, b text, c int4);
    INSERT INTO ins5 VALUES (1);
    SELECT count(*) FROM ins5 WHERE a = 1 AND b IS NULL AND c IS NULL;
}
expect {
    1
}

test error-short-insert-violates-not-null {
    CREATE TABLE ins6 (a int4, b int4 NOT NULL);
    INSERT INTO ins6 VALUES (1);
}
@sqlstate 23502
expect error {
}

