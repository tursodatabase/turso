test error-cast-out-of-range-hex-text-to-int {
    SELECT '0x80000000'::int4;
}
@sqlstate 22003
expect error {value "0x80000000" is out of range for type integer}

test error-cast-out-of-range-hex-text-to-bigint {
    SELECT '0xFFFFFFFFFFFFFFFF'::int8;
}
@sqlstate 22003
expect error {value "0xFFFFFFFFFFFFFFFF" is out of range for type bigint}

test error-cast-underflow-text-to-float8 {
    SELECT '1e-400'::float8;
}
@sqlstate 22003
expect error {"1e-400" is out of range for type double precision}

test error-cast-underflow-text-to-real {
    SELECT '1e-50'::real;
}
@sqlstate 22003
expect error {"1e-50" is out of range for type real}

test cast-float-to-int-rounds-half-away-from-zero {
    SELECT 1.5::int, (-1.5)::int, 0.4::int, 2.5::int, (-2.5)::int, 2.4::int2, 2.5::numeric::int, (-2.5)::numeric::int8, 2.6::float8::int;
}
expect {
2|-2|0|3|-3|2|3|-3|3
}

test cast-in-range-integer-to-narrower-integer {
    SELECT 32767::int4::int2, (-32768)::int8::int2, 2147483647::int8::int4, (-2147483648)::int8::int4;
}
expect {
32767|-32768|2147483647|-2147483648
}

test error-cast-float-to-int-out-of-range {
    SELECT 2147483647.5::int;
}
@sqlstate 22003
expect error {integer out of range}

test error-cast-float-to-smallint-out-of-range {
    SELECT 32767.5::int2;
}
@sqlstate 22003
expect error {smallint out of range}

test error-cast-float-to-bigint-out-of-range {
    SELECT 1e19::int8;
}
@sqlstate 22003
expect error {bigint out of range}

test error-cast-infinity-to-int {
    SELECT 'Infinity'::float8::int4;
}
@sqlstate 22003
expect error {integer out of range}

test error-cast-int-to-smallint-out-of-range {
    SELECT 40000::int4::int2;
}
@sqlstate 22003
expect error {smallint out of range}

test error-cast-negative-int-to-smallint-out-of-range {
    SELECT (-32769)::int4::int2;
}
@sqlstate 22003
expect error {smallint out of range}

test error-cast-bigint-to-int-out-of-range {
    SELECT 3000000000::int8::int4;
}
@sqlstate 22003
expect error {integer out of range}

test error-cast-literal-to-smallint-out-of-range {
    SELECT 40000::int2;
}
@sqlstate 22003
expect error {smallint out of range}

test error-cast-float8-to-real-out-of-range {
    SELECT 1e39::float8::float4;
}
@sqlstate 22003
expect error {value out of range: overflow}

test error-drop-type-used-by-table-in-other-schema {
    CREATE SCHEMA IF NOT EXISTS err_drop_type;
    DROP TABLE IF EXISTS err_drop_type.t;
    CREATE TYPE mood AS ENUM ('happy', 'sad');
    CREATE TABLE err_drop_type.t (m mood);
    DROP TYPE mood;
}
@sqlstate 2BP01
expect error {}

test error-drop-domain-used-by-table-in-other-schema {
    CREATE SCHEMA IF NOT EXISTS err_drop_domain;
    DROP TABLE IF EXISTS err_drop_domain.t;
    CREATE DOMAIN pos AS integer CHECK (VALUE > 0);
    CREATE TABLE err_drop_domain.t (v pos);
    DROP DOMAIN pos;
}
@sqlstate 2BP01
expect error {}

test error-generate-series-infinite-stop {
    SELECT * FROM generate_series(0::numeric, 'inf'::numeric, 10::numeric);
}
@sqlstate 22023
expect error {stop value cannot be infinity}

test error-generate-series-negative-infinite-stop {
    SELECT * FROM generate_series(0::numeric, '-inf'::numeric, -10::numeric);
}
@sqlstate 22023
expect error {stop value cannot be infinity}

test error-generate-series-infinite-start {
    SELECT * FROM generate_series('inf'::numeric, 10::numeric, 1::numeric);
}
@sqlstate 22023
expect error {start value cannot be infinity}

test error-generate-series-negative-infinite-start {
    SELECT * FROM generate_series('-inf'::numeric, 10::numeric, 1::numeric);
}
@sqlstate 22023
expect error {start value cannot be infinity}

test error-generate-series-infinite-step {
    SELECT * FROM generate_series(0::numeric, 10::numeric, 'inf'::numeric);
}
@sqlstate 22023
expect error {step size cannot be infinity}

test error-generate-series-negative-infinite-step {
    SELECT * FROM generate_series(0::numeric, 10::numeric, '-inf'::numeric);
}
@sqlstate 22023
expect error {step size cannot be infinity}

test error-generate-series-zero-step {
    SELECT * FROM generate_series(0, 10, 0);
}
@sqlstate 22023
expect error {step size cannot equal zero}

test error-generate-series-numeric-zero-step {
    SELECT * FROM generate_series(0::numeric, 10::numeric, 0::numeric);
}
@sqlstate 22023
expect error {step size cannot equal zero}

test generate-series-numeric-finite-bounds {
    SELECT count(*) FROM generate_series(1::numeric, 5::numeric);
    SELECT count(*) FROM generate_series(0::numeric, 10::numeric, 5::numeric);
}
expect {
    5
    3
}
