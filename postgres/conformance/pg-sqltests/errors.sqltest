# Error reporting through the PostgreSQL frontend. Expectations compare the
# SQLSTATE and not the message text: turso-pg and real PostgreSQL word their
# errors differently, and this corpus must stay valid for differential runs.

@database :memory:

test error-missing-table {
    SELECT * FROM missing;
}
@sqlstate 42P01
expect error {}

test error-missing-column {
    CREATE TABLE t (a int);
    SELECT nonexistent FROM t;
}
@sqlstate 42703
expect error {}

test error-missing-column-named-like-an-error-message {
    CREATE TABLE t (a int);
    SELECT "no such object" FROM t;
}
@sqlstate 42703
expect error {}

test error-syntax {
    SELEC 1;
}
@sqlstate 42601
expect error {}

test error-aborts-rest-of-batch {
    CREATE TABLE t (a int);
    INSERT INTO t VALUES (1);
    SELECT * FROM missing;
    INSERT INTO t VALUES (2);
}
@sqlstate 42P01
expect error {}

# Schema databases are file-backed, so the schema table is dropped before each
# create to keep repeated test runs independent of old sidecar files.
test error-drop-type-used-by-table-in-other-schema {
    CREATE SCHEMA IF NOT EXISTS err_drop_type;
    DROP TABLE IF EXISTS err_drop_type.t;
    CREATE TYPE mood AS ENUM ('happy', 'sad');
    CREATE TABLE err_drop_type.t (m mood);
    DROP TYPE mood;
}
@sqlstate 2BP01
expect error {}

test error-drop-domain-used-by-table-in-other-schema {
    CREATE SCHEMA IF NOT EXISTS err_drop_domain;
    DROP TABLE IF EXISTS err_drop_domain.t;
    CREATE DOMAIN pos AS integer CHECK (VALUE > 0);
    CREATE TABLE err_drop_domain.t (v pos);
    DROP DOMAIN pos;
}
@sqlstate 2BP01
expect error {}

test error-star-argument-to-plain-function {
    SELECT version(*) IS NOT NULL;
}
@sqlstate 42809
expect error {version\(\*\) specified, but version is not an aggregate function}

test error-star-argument-to-plain-function-now {
    SELECT now(*) IS NOT NULL;
}
@sqlstate 42809
expect error {now\(\*\) specified, but now is not an aggregate function}

test error-star-argument-to-plain-function-in-column-check {
    CREATE TABLE star_check_column (a int CHECK (random(*) IS NOT NULL));
}
@sqlstate 42809
expect error {random\(\*\) specified, but random is not an aggregate function}

test error-star-argument-to-plain-function-in-table-check {
    CREATE TABLE star_check_table (a int, CHECK (random(*) IS NOT NULL));
}
@sqlstate 42809
expect error {random\(\*\) specified, but random is not an aggregate function}

# PostgreSQL has no jsonb_object() without arguments, so it reports a missing
# function. turso-pg has one and reports that it is not an aggregate.
test error-star-argument-to-jsonb-object-in-select-list {
    CREATE TABLE star_jsonb_select (a int);
    INSERT INTO star_jsonb_select VALUES (1);
    SELECT jsonb_object(*) FROM star_jsonb_select;
}
@sqlstate 42883
expect error {function jsonb_object\(\) does not exist}
@sqlstate 42809
expect @tursopg error {jsonb_object\(\*\) specified, but jsonb_object is not an aggregate function}

test error-star-argument-to-jsonb-object-in-where {
    CREATE TABLE star_jsonb_where (a int);
    INSERT INTO star_jsonb_where VALUES (1);
    SELECT a FROM star_jsonb_where WHERE jsonb_object(*) IS NOT NULL;
}
@sqlstate 42883
expect error {function jsonb_object\(\) does not exist}
@sqlstate 42809
expect @tursopg error {jsonb_object\(\*\) specified, but jsonb_object is not an aggregate function}

test star-argument-to-aggregate {
    SELECT count(*);
}
expect {
    1
}
