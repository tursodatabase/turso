# Error reporting through the PostgreSQL frontend. Expectations compare the
# SQLSTATE and not the message text: turso-pg and real PostgreSQL word their
# errors differently, and this corpus must stay valid for differential runs.

@database :memory:

test error-missing-table {
    SELECT * FROM missing;
}
@sqlstate 42P01
expect error {}

test error-missing-column {
    CREATE TABLE t (a int);
    SELECT nonexistent FROM t;
}
@sqlstate 42703
expect error {}

test error-missing-column-named-like-an-error-message {
    CREATE TABLE t (a int);
    SELECT "no such object" FROM t;
}
@sqlstate 42703
expect error {}

test error-syntax {
    SELEC 1;
}
@sqlstate 42601
expect error {}

test error-aborts-rest-of-batch {
    CREATE TABLE t (a int);
    INSERT INTO t VALUES (1);
    SELECT * FROM missing;
    INSERT INTO t VALUES (2);
}
@sqlstate 42P01
expect error {}

test error-cast-non-numeric-text-to-int {
    SELECT 'abc'::int;
}
@sqlstate 22P02
expect error {invalid input syntax for type integer: "abc"}

test error-cast-function-non-numeric-text-to-int {
    SELECT CAST('abc' AS int);
}
@sqlstate 22P02
expect error {invalid input syntax for type integer: "abc"}

test error-cast-text-with-trailing-junk-to-int {
    SELECT '12abc'::int;
}
@sqlstate 22P02
expect error {invalid input syntax for type integer: "12abc"}

test error-cast-empty-text-to-int {
    SELECT ''::int;
}
@sqlstate 22P02
expect error {invalid input syntax for type integer: ""}

test error-cast-non-numeric-text-to-float8 {
    SELECT 'abc'::float8;
}
@sqlstate 22P02
expect error {invalid input syntax for type double precision: "abc"}

test error-cast-non-numeric-text-to-real {
    SELECT 'abc'::real;
}
@sqlstate 22P02
expect error {invalid input syntax for type real: "abc"}

test error-cast-float4-alias-non-numeric-text {
    SELECT 'abc'::float4;
}
@sqlstate 22P02
expect error {invalid input syntax for type real: "abc"}

test error-cast-non-numeric-text-to-numeric {
    SELECT 'abc'::numeric;
}
@sqlstate 22P02
expect error {invalid input syntax for type numeric: "abc"}

test error-cast-text-with-trailing-junk-to-numeric {
    SELECT '12abc'::numeric;
}
@sqlstate 22P02
expect error {invalid input syntax for type numeric: "12abc"}

test error-cast-empty-text-to-numeric {
    SELECT ''::numeric;
}
@sqlstate 22P02
expect error {invalid input syntax for type numeric: ""}

test error-cast-non-numeric-text-to-smallint {
    SELECT 'abc'::smallint;
}
@sqlstate 22P02
expect error {invalid input syntax for type smallint: "abc"}

test error-cast-non-numeric-text-to-bigint {
    SELECT 'abc'::bigint;
}
@sqlstate 22P02
expect error {invalid input syntax for type bigint: "abc"}

test error-cast-out-of-range-text-to-int {
    SELECT '3000000000'::int;
}
@sqlstate 22003
expect error {value "3000000000" is out of range for type integer}

test error-cast-out-of-range-text-to-smallint {
    SELECT '40000'::smallint;
}
@sqlstate 22003
expect error {value "40000" is out of range for type smallint}

test error-cast-out-of-range-text-to-bigint {
    SELECT '9223372036854775808'::bigint;
}
@sqlstate 22003
expect error {value "9223372036854775808" is out of range for type bigint}

test error-cast-out-of-range-text-to-double {
    SELECT '1e400'::float8;
}
@sqlstate 22003
expect error {"1e400" is out of range for type double precision}

test error-cast-out-of-range-text-to-real {
    SELECT '1e39'::real;
}
@sqlstate 22003
expect error {"1e39" is out of range for type real}

test error-cast-non-numeric-text-to-domain-over-int {
    CREATE DOMAIN cast_int_domain AS int;
    SELECT 'abc'::cast_int_domain;
}
@sqlstate 22P02
expect error {invalid input syntax for type integer: "abc"}

test cast-text-with-spaces-to-int {
    SELECT ' 12 '::int;
}
expect {
12
}

test cast-text-with-plus-sign-to-int {
    SELECT '+7'::int;
}
expect {
7
}

test cast-numeric-text-to-int {
    SELECT '12'::int;
}
expect {
12
}

test cast-exponent-text-to-float8 {
    SELECT '1e2'::float8::int;
}
expect {
100
}

test cast-exponent-text-to-numeric {
    SELECT '1e2'::numeric::int;
}
expect {
100
}

test cast-text-with-spaces-to-smallint {
    SELECT ' -3 '::smallint;
}
expect {
-3
}

test cast-infinity-text-to-double {
    SELECT ('-Infinity'::float8 < 0)::int;
}
expect {
1
}

test cast-infinity-text-to-numeric {
    SELECT ('Infinity'::numeric > 1e300)::int;
}
expect {
1
}

test cast-infinity-words-to-float8 {
    SELECT ('Infinity'::float8 > 1e300::float8)::int, ('-inf'::float8 < 0)::int, ('+inf'::float8 > 0)::int, (' INF '::float8 > 0)::int, ('-Infinity '::float8 < 0)::int;
}
expect {
1|1|1|1|1
}

test cast-infinity-words-to-real {
    SELECT ('Infinity'::real > 1e30::real)::int, ('-inf'::float4 < 0)::int, ('+inf'::float4 > 0)::int, (' iNf '::real > 0)::int;
}
expect {
1|1|1|1
}

test cast-infinity-words-to-numeric {
    SELECT ('Infinity'::numeric > 1e300)::int, ('-inf'::numeric < 0)::int, ('+inf'::numeric > 0)::int, (' INFINITY '::numeric > 0)::int, ('+Infinity'::decimal > 0)::int;
}
expect {
1|1|1|1|1
}

test cast-hex-binary-octal-text-to-int {
    SELECT '0x1F'::int2, '0x1F'::int4, '0x1F'::int8, '0b101'::int4, '0o17'::int4, '0X1f'::int4;
}
expect {
31|31|31|5|15|31
}

test cast-signed-and-spaced-hex-text-to-int {
    SELECT '-0x1F'::int, '+0x1F'::int, ' 0x1F '::int, '-0x8000'::int2, '0x7FFFFFFF'::int4;
}
expect {
-31|31|31|-32768|2147483647
}

test cast-underscore-text-to-int {
    SELECT '1_000'::int2, '1_000'::int4, '1_000'::int8, '0x_1'::int4, '0x1_F'::int4, '-1_0'::int;
}
expect {
1000|1000|1000|1|31|-10
}

test cast-prefixed-and-underscore-text-to-numeric {
    SELECT '0x1F'::numeric::int, '-0b101'::numeric::int, '0o17'::numeric::int, ('1_000.5'::numeric = 1000.5)::int, ('1_0.2_5e1'::numeric = 102.5)::int;
}
expect {
31|-5|15|1|1
}

test cast-hex-text-to-float8 {
    SELECT '0x1F'::float8::int, '-0x1F'::float4::int;
}
expect {
31|-31
}

test cast-denormal-and-zero-exponent-text-to-float8 {
    SELECT ('1e-310'::float8 > 0)::int, ('0e-400'::float8 = 0)::int, ('3.4e38'::real > 0)::int;
}
expect {
1|1|1
}

test error-cast-empty-hex-text-to-int {
    SELECT '0x'::int;
}
@sqlstate 22P02
expect error {invalid input syntax for type integer: "0x"}

