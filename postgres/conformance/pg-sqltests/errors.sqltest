# Error reporting through the PostgreSQL frontend. Expectations compare the
# SQLSTATE and not the message text: turso-pg and real PostgreSQL word their
# errors differently, and this corpus must stay valid for differential runs.

@database :memory:

test error-missing-table {
    SELECT * FROM missing;
}
@sqlstate 42P01
expect error {}

test error-missing-column {
    CREATE TABLE t (a int);
    SELECT nonexistent FROM t;
}
@sqlstate 42703
expect error {}

test error-missing-column-named-like-an-error-message {
    CREATE TABLE t (a int);
    SELECT "no such object" FROM t;
}
@sqlstate 42703
expect error {}

test error-syntax {
    SELEC 1;
}
@sqlstate 42601
expect error {}

test error-zero-parameter {
    SELECT $0;
}
@sqlstate 42P02
expect error {}

# tursopg does not have LISTEN.
@compat-gap "syntax:unsupported-statement"
test error-unsupported-statement {
    LISTEN channel;
}
expect {
}
@sqlstate 0A000
expect @tursopg error {
}

test error-values-lists-have-different-lengths {
    VALUES (1), (2, 3), (4);
}
@sqlstate 42601
expect error {}

test error-insert-values-lists-have-different-lengths {
    CREATE TABLE t (a int, b int);
    INSERT INTO t VALUES (1), (2, 3), (4);
}
@sqlstate 42601
expect error {}

test error-insert-values-default-and-short-row {
    CREATE TABLE t (a int, b int);
    INSERT INTO t (a, b) VALUES (1, DEFAULT), (2);
}
@sqlstate 42601
expect error {}

test error-aborts-rest-of-batch {
    CREATE TABLE t (a int);
    INSERT INTO t VALUES (1);
    SELECT * FROM missing;
    INSERT INTO t VALUES (2);
}
@sqlstate 42P01
expect error {}

# Schema databases are file-backed, so the schema table is dropped before each
# create to keep repeated test runs independent of old sidecar files.
test error-drop-type-used-by-table-in-other-schema {
    CREATE SCHEMA IF NOT EXISTS err_drop_type;
    DROP TABLE IF EXISTS err_drop_type.t;
    CREATE TYPE mood AS ENUM ('happy', 'sad');
    CREATE TABLE err_drop_type.t (m mood);
    DROP TYPE mood;
}
@sqlstate 2BP01
expect error {}

test error-drop-domain-used-by-table-in-other-schema {
    CREATE SCHEMA IF NOT EXISTS err_drop_domain;
    DROP TABLE IF EXISTS err_drop_domain.t;
    CREATE DOMAIN pos AS integer CHECK (VALUE > 0);
    CREATE TABLE err_drop_domain.t (v pos);
    DROP DOMAIN pos;
}
@sqlstate 2BP01
expect error {}

test error-drop-type-used-by-a-cast-in-a-policy {
    CREATE TYPE err_policy_mood AS ENUM ('happy', 'sad');
    CREATE TABLE err_policy_t (m text);
    CREATE POLICY err_policy_p ON err_policy_t USING (m::err_policy_mood = 'happy');
    DROP TYPE err_policy_mood;
}
@sqlstate 2BP01
expect error {}

# A built-in type belongs to the system, so dropping it is refused even with
# IF EXISTS (#12023). `integer` reaches the parser as pg_catalog.int4.
test error-drop-builtin-type {
    DROP TYPE int4;
}
@sqlstate 2BP01
expect error {}

test error-drop-builtin-type-if-exists {
    DROP TYPE IF EXISTS int4;
}
@sqlstate 2BP01
expect error {}

test error-drop-builtin-type-by-sql-name {
    DROP TYPE integer;
}
@sqlstate 2BP01
expect error {}

test error-drop-builtin-array-type {
    DROP TYPE IF EXISTS _text;
}
@sqlstate 2BP01
expect error {}

test error-drop-missing-type {
    DROP TYPE err_no_such_type;
}
@sqlstate 42704
expect error {}

test error-drop-missing-domain {
    DROP DOMAIN err_no_such_domain;
}
@sqlstate 42704
expect error {}

test error-drop-builtin-array-type-written-with-brackets {
    DROP TYPE IF EXISTS int4[];
}
@sqlstate 2BP01
expect error {}

test error-drop-builtin-pseudo-array-type {
    DROP TYPE IF EXISTS _record;
}
@sqlstate 2BP01
expect error {}

test error-drop-builtin-type-cascade {
    DROP TYPE int4 CASCADE;
}
@sqlstate 2BP01
expect error {}

test error-drop-domain-builtin-type {
    DROP DOMAIN IF EXISTS int4;
}
@sqlstate 42809
expect error {}

# Only an unqualified or pg_catalog name is the built-in type.
test error-drop-builtin-type-name-in-public {
    DROP TYPE public.int4;
}
@sqlstate 42704
expect error {}

# PostgreSQL refuses with 2BP01 because the element type requires the array
# type; tursopg refuses dropping an array type instead of dropping mood.
@skip-if postgres "PostgreSQL reports that mood requires mood[] (2BP01)"
test error-drop-array-of-custom-type {
    DROP TYPE IF EXISTS err_array_mood;
    CREATE TYPE err_array_mood AS ENUM ('a');
    DROP TYPE err_array_mood[];
}
@sqlstate 0A000
expect error {}

# PostgreSQL has no array type of void, any or pg_node_tree, so these don't
# exist; record and cstring have one.
test error-drop-array-of-type-without-arrays {
    DROP TYPE _void;
}
@sqlstate 42704
expect error {}

test error-drop-bracketed-array-of-type-without-arrays {
    DROP TYPE void[];
}
@sqlstate 42704
expect error {}

test error-drop-domain-bracketed-array-of-type-without-arrays {
    DROP DOMAIN void[];
}
@sqlstate 42704
expect error {}

# PostgreSQL skips it; tursopg refuses it, as it refuses every array type,
# rather than drop a custom type named "void[]".
@compat-gap "syntax:drop-type"
test drop-if-exists-bracketed-array-of-type-without-arrays {
    DROP TYPE IF EXISTS void[];
}
expect {
}
@sqlstate 0A000
expect @tursopg error {}

test error-drop-bracketed-array-of-base-type-without-arrays {
    DROP TYPE pg_node_tree[];
}
@sqlstate 42704
expect error {}

# An array type has no array type of its own.
test error-drop-array-of-array-type {
    DROP TYPE _int4[];
}
@sqlstate 42704
expect error {}

test error-drop-domain-array-of-type-without-arrays {
    DROP DOMAIN _void;
}
@sqlstate 42704
expect error {}

test error-drop-array-of-base-type-without-arrays {
    DROP TYPE _pg_node_tree;
}
@sqlstate 42704
expect error {}

test error-drop-builtin-cstring-array-type {
    DROP TYPE _cstring;
}
@sqlstate 2BP01
expect error {}
