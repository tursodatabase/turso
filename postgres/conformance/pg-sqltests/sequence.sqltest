# CREATE SEQUENCE through the PostgreSQL frontend.

@database :memory:

# Turso sequences do not cache values: each nextval writes the sequence state.
# Thus tursopg accepts only CACHE 1. PostgreSQL accepts every CACHE that is
# greater than zero.

test create-sequence-with-cache-1 {
    CREATE SEQUENCE cache_one CACHE 1;
    SELECT nextval('cache_one'), nextval('cache_one');
    SELECT cache_size, last_value FROM pg_sequences WHERE sequencename = 'cache_one';
}
expect {
    1|2
    1|2
}

test create-sequence-with-cache-10 {
    CREATE SEQUENCE cache_ten CACHE 10;
    SELECT nextval('cache_ten');
    SELECT cache_size, last_value FROM pg_sequences WHERE sequencename = 'cache_ten';
}
expect {
    1
    10|10
}
@sqlstate 0A000
expect @tursopg error {
    CACHE 10 \(Turso sequences do not cache values, so CACHE must be 1\) is not supported
}

test create-sequence-with-cache-too-large-for-int4 {
    CREATE SEQUENCE cache_large CACHE 9999999999;
    SELECT cache_size FROM pg_sequences WHERE sequencename = 'cache_large';
}
expect {
    9999999999
}
@sqlstate 0A000
expect @tursopg error {
    CACHE 9999999999 \(Turso sequences do not cache values, so CACHE must be 1\) is not supported
}

test create-sequence-with-cache-0 {
    CREATE SEQUENCE cache_zero CACHE 0;
}
@sqlstate 22023
expect error {
    CACHE \(0\) must be greater than zero
}

test create-sequence-with-negative-cache {
    CREATE SEQUENCE cache_negative CACHE -1;
}
@sqlstate 22023
expect error {
    CACHE \(-1\) must be greater than zero
}

test create-sequence-with-fractional-cache {
    CREATE SEQUENCE cache_fraction CACHE 1.5;
}
@sqlstate 22P02
expect error {
    invalid input syntax for type bigint: "1.5"
}
@sqlstate 0A000
expect @tursopg error {
    this CACHE value in CREATE SEQUENCE is not supported
}

test create-sequence-with-cache-too-large-for-bigint {
    CREATE SEQUENCE cache_huge CACHE 99999999999999999999;
}
@sqlstate 22003
expect error {
    value "99999999999999999999" is out of range for type bigint
}
@sqlstate 0A000
expect @tursopg error {
    this CACHE value in CREATE SEQUENCE is not supported
}

@skip-if postgres "PostgreSQL supports ALTER SEQUENCE ... RENAME"
test alter-sequence-rename-is-not-supported {
    CREATE SEQUENCE rn_sequence;
    ALTER SEQUENCE rn_sequence RENAME TO rn_sequence_renamed;
}
@sqlstate 0A000
expect error {
    ALTER SEQUENCE ... RENAME is not supported
}

test drop-table-drops-its-serial-sequence {
    CREATE TABLE zz_drop_serial (id serial, label text);
    DROP TABLE zz_drop_serial;
    SELECT count(*) FROM pg_class WHERE relname = 'zz_drop_serial_id_seq';
}
expect {
    0
}

test recreated-table-gets-the-first-serial-sequence-name {
    CREATE TABLE zz_recreate (id serial);
    DROP TABLE zz_recreate;
    CREATE TABLE zz_recreate (id serial);
    SELECT relname FROM pg_class WHERE relname LIKE 'zz_recreate%' AND relkind = 'S';
}
expect {
    zz_recreate_id_seq
}

test rolled-back-drop-table-keeps-its-serial-sequence {
    CREATE TABLE zz_rollback_drop (id serial, label text);
    INSERT INTO zz_rollback_drop (label) VALUES ('a');
    BEGIN;
    DROP TABLE zz_rollback_drop;
    ROLLBACK;
    INSERT INTO zz_rollback_drop (label) VALUES ('b');
    SELECT id, label FROM zz_rollback_drop ORDER BY id;
}
expect {
    1|a
    2|b
}

test drop-table-keeps-a-sequence-it-does-not-own {
    CREATE SEQUENCE zz_keep_seq;
    CREATE TABLE zz_keep_owner (id serial, n bigint DEFAULT nextval('zz_keep_seq'));
    DROP TABLE zz_keep_owner;
    SELECT relname FROM pg_class WHERE relname LIKE 'zz_keep%' AND relkind = 'S';
}
expect {
    zz_keep_seq
}

test drop-column-drops-its-serial-sequence {
    CREATE TABLE zz_dropcol_serial (id serial, label text);
    ALTER TABLE zz_dropcol_serial DROP COLUMN id;
    SELECT count(*) FROM pg_class WHERE relname = 'zz_dropcol_serial_id_seq';
}
expect {
    0
}

test drop-column-keeps-the-sequences-of-other-columns {
    CREATE TABLE zz_dropcol_two (
        a serial,
        b serial,
        label text
    );
    ALTER TABLE zz_dropcol_two DROP COLUMN b;
    INSERT INTO zz_dropcol_two (label) VALUES ('x');
    SELECT relname FROM pg_class WHERE relname LIKE 'zz_dropcol_two%' AND relkind = 'S';
}
expect {
    zz_dropcol_two_a_seq
}

test drop-column-keeps-a-sequence-it-does-not-own {
    CREATE SEQUENCE zz_dropcol_shared;
    CREATE TABLE zz_dropcol_user (n bigint DEFAULT nextval('zz_dropcol_shared'), label text);
    ALTER TABLE zz_dropcol_user DROP COLUMN n;
    SELECT relname FROM pg_class WHERE relname LIKE 'zz_dropcol_shared%' AND relkind = 'S';
}
expect {
    zz_dropcol_shared
}

test rolled-back-drop-column-keeps-its-serial-sequence {
    CREATE TABLE zz_dropcol_rollback (id serial, label text);
    INSERT INTO zz_dropcol_rollback (label) VALUES ('a');
    BEGIN;
    ALTER TABLE zz_dropcol_rollback DROP COLUMN id;
    ROLLBACK;
    INSERT INTO zz_dropcol_rollback (label) VALUES ('b');
    SELECT id, label FROM zz_dropcol_rollback ORDER BY id;
}
expect {
    1|a
    2|b
}

test drop-table-refuses-when-another-default-uses-its-sequence {
    DROP TABLE IF EXISTS zz_dep_user;
    DROP TABLE IF EXISTS zz_dep_owner;
    CREATE TABLE zz_dep_owner (id serial, label text);
    CREATE TABLE zz_dep_user (n bigint DEFAULT nextval('zz_dep_owner_id_seq'));
    DROP TABLE zz_dep_owner;
}
@sqlstate 2BP01
expect error {
    cannot drop table zz_dep_owner because other objects depend on it
}

test drop-table-works-once-the-other-default-is-gone {
    DROP TABLE IF EXISTS zz_dep_user2;
    DROP TABLE IF EXISTS zz_dep_owner2;
    CREATE TABLE zz_dep_owner2 (id serial, label text);
    CREATE TABLE zz_dep_user2 (n bigint DEFAULT nextval('zz_dep_owner2_id_seq'));
    DROP TABLE zz_dep_user2;
    DROP TABLE zz_dep_owner2;
    SELECT count(*) FROM pg_class WHERE relname = 'zz_dep_owner2_id_seq';
}
expect {
    0
}

test drop-column-refuses-when-another-default-uses-its-sequence {
    DROP TABLE IF EXISTS zz_depcol_user;
    DROP TABLE IF EXISTS zz_depcol_owner;
    CREATE TABLE zz_depcol_owner (id serial, label text);
    CREATE TABLE zz_depcol_user (n bigint DEFAULT nextval('zz_depcol_owner_id_seq'));
    ALTER TABLE zz_depcol_owner DROP COLUMN id;
}
@sqlstate 2BP01
expect error {
    cannot drop column id of table zz_depcol_owner because other objects depend on it
}

test drop-column-refuses-when-a-column-of-the-same-table-uses-its-sequence {
    DROP TABLE IF EXISTS zz_depsame;
    CREATE TABLE zz_depsame (id serial, copy bigint DEFAULT nextval('zz_depsame_id_seq'));
    ALTER TABLE zz_depsame DROP COLUMN id;
}
@sqlstate 2BP01
expect error {
    cannot drop column id of table zz_depsame because other objects depend on it
}

test drop-sequence-refuses-when-a-default-uses-it {
    DROP TABLE IF EXISTS zz_dropseq_user;
    DROP SEQUENCE IF EXISTS zz_dropseq;
    CREATE SEQUENCE zz_dropseq;
    CREATE TABLE zz_dropseq_user (n bigint DEFAULT nextval('zz_dropseq'));
    DROP SEQUENCE zz_dropseq;
}
@sqlstate 2BP01
expect error {
    cannot drop sequence zz_dropseq because other objects depend on it
}

test drop-sequence-refuses-when-a-view-uses-it {
    DROP VIEW IF EXISTS zz_dropseq_view;
    DROP SEQUENCE IF EXISTS zz_dropseq2;
    CREATE SEQUENCE zz_dropseq2;
    CREATE VIEW zz_dropseq_view AS SELECT nextval('zz_dropseq2') AS n;
    DROP SEQUENCE zz_dropseq2;
}
@sqlstate 2BP01
expect error {
    cannot drop sequence zz_dropseq2 because other objects depend on it
}

test drop-sequence-works-once-nothing-uses-it {
    DROP TABLE IF EXISTS zz_dropseq_user3;
    DROP SEQUENCE IF EXISTS zz_dropseq3;
    CREATE SEQUENCE zz_dropseq3;
    CREATE TABLE zz_dropseq_user3 (n bigint DEFAULT nextval('zz_dropseq3'));
    DROP TABLE zz_dropseq_user3;
    DROP SEQUENCE zz_dropseq3;
    SELECT count(*) FROM pg_class WHERE relname = 'zz_dropseq3';
}
expect {
    0
}

test drop-table-refuses-when-a-view-uses-its-serial-sequence {
    DROP VIEW IF EXISTS zz_serialview_view;
    DROP TABLE IF EXISTS zz_serialview;
    CREATE TABLE zz_serialview (id serial);
    CREATE VIEW zz_serialview_view AS SELECT nextval('zz_serialview_id_seq') AS n;
    DROP TABLE zz_serialview;
}
@sqlstate 2BP01
expect error {
    cannot drop table zz_serialview because other objects depend on it
}

test drop-sequence-refuses-when-a-default-calls-it-inside-an-expression {
    DROP TABLE IF EXISTS zz_dropseq_expr_user;
    DROP SEQUENCE IF EXISTS zz_dropseq_expr;
    CREATE SEQUENCE zz_dropseq_expr;
    CREATE TABLE zz_dropseq_expr_user (n bigint DEFAULT nextval('zz_dropseq_expr') + 1);
    DROP SEQUENCE zz_dropseq_expr;
}
@sqlstate 2BP01
expect error {
    cannot drop sequence zz_dropseq_expr because other objects depend on it
}
