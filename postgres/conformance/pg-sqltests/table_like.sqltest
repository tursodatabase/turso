# CREATE TABLE ... (LIKE source): the bare form copies column names, types,
# and not-null constraints. This clause used to be dropped silently,
# creating a zero-column table whose next ALTER took the server down and
# whose stored DDL corrupted the database file.

@database :memory:

test like-copies-columns {
    CREATE TABLE like_src (a int NOT NULL, b text, c real);
    CREATE TABLE like_dst (LIKE like_src);
    INSERT INTO like_dst VALUES (1, 'x', 2.5);
    SELECT a, b, c FROM like_dst;
}
expect {
    1|x|2.5
}

test like-copies-not-null {
    CREATE TABLE nn_src (a int NOT NULL, b text);
    CREATE TABLE nn_dst (LIKE nn_src);
    INSERT INTO nn_dst VALUES (NULL, 'x');
}
expect error {}

test like-then-alter-column-dance {
    CREATE TABLE dance_src (b int NOT NULL, v varchar);
    CREATE TABLE dance_dst (LIKE dance_src);
    ALTER TABLE dance_dst ADD a int;
    ALTER TABLE dance_dst DROP a;
    ALTER TABLE dance_dst ADD a int;
    INSERT INTO dance_dst VALUES (1, 'x', 2);
    SELECT count(*) FROM dance_dst;
}
expect {
    1
}

test like-missing-source-errors {
    CREATE TABLE oops (LIKE no_such_source);
}
expect error {}

test like-if-not-exists {
    CREATE TABLE ine_src (a int);
    CREATE TABLE ine_dst (LIKE ine_src);
    CREATE TABLE IF NOT EXISTS ine_dst (LIKE ine_src);
    SELECT count(*) FROM ine_dst;
}
expect {
    0
}

test alter-column-type-keeps-constraints {
    CREATE TABLE retype_t (c varchar(10) PRIMARY KEY);
    ALTER TABLE retype_t ALTER c TYPE varchar(20);
    INSERT INTO retype_t VALUES ('x');
    INSERT INTO retype_t VALUES ('x');
}
expect error {}

# Regression guard for a translator bug where this UPDATE's array-encode
# loop jumped past its own exit test and spun forever. The count assertion
# holds in PostgreSQL too; the slice's element-wise semantics are still
# wrong here (the whole array is replaced) and are tracked separately.
test array-update-with-cast-where-completes {
    CREATE TABLE arr_upd (a int2[]);
    INSERT INTO arr_upd VALUES ('{1,2,3,4,5}');
    UPDATE arr_upd SET a[1:2] = '{16,25}' WHERE NOT a = '{}'::_int2;
    SELECT count(*) FROM arr_upd;
}
expect {
    1
}

test drop-multiple-tables {
    CREATE TABLE mdrop_a (x int);
    CREATE TABLE mdrop_b (x int);
    DROP TABLE mdrop_a, mdrop_b;
    SELECT count(*) FROM pg_tables WHERE tablename IN ('mdrop_a', 'mdrop_b');
}
expect {
    0
}

test truncate-multiple-tables {
    CREATE TABLE mtrunc_a (x int);
    CREATE TABLE mtrunc_b (x int);
    INSERT INTO mtrunc_a VALUES (1), (2);
    INSERT INTO mtrunc_b VALUES (3);
    TRUNCATE mtrunc_a, mtrunc_b;
    SELECT (SELECT count(*) FROM mtrunc_a) + (SELECT count(*) FROM mtrunc_b);
}
expect {
    0
}
