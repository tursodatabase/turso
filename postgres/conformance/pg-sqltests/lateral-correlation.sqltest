@database :memory:

# What a LATERAL subquery can read: tables, views, CTEs, subqueries,
# table-valued functions, VALUES and earlier LATERAL subqueries on its
# left, at one or more nesting levels.
# The statements run only through the PostgreSQL frontend (tursopg).
# PostgreSQL 16 gave every expected result.
# Tests with the same SQL for both frontends are in
# testing/shared-sqltests/lateral-correlation.sqltest.

setup data {
    CREATE TABLE t1(a INT, b TEXT);
    CREATE TABLE t2(a INT, c INT, d TEXT);
    CREATE TABLE t3(c INT, e TEXT);
    INSERT INTO t1 VALUES (1, 'p'), (2, 'q'), (3, 'r'), (4, 's');
    INSERT INTO t2 VALUES (1, 10, 'x'), (2, 20, 'y'), (2, 30, 'z'), (3, 40, 'w'), (5, 50, 'v');
    INSERT INTO t3 VALUES (10, 'k'), (20, 'l'), (30, 'm'), (30, 'n'), (60, 'o');
}

@setup data
test reads-generate-series-on-its-left {
    SELECT g.value, s.c FROM generate_series(1, 3) AS g(value), LATERAL (SELECT c FROM t2 WHERE t2.a = g.value) AS s ORDER BY 1, 2;
}
expect {
    1|10
    2|20
    2|30
    3|40
}

@setup data
test reads-generate-series-with-step-on-its-left {
    SELECT g.value, s.v FROM generate_series(0, 10, 5) AS g(value), LATERAL (SELECT g.value * 2 AS v) AS s ORDER BY 1;
}
expect {
    0|0
    5|10
    10|20
}

@setup data
test reads-generate-series-that-reads-a-table {
    SELECT t1.a, g.value, s.v
    FROM t1, generate_series(1, t1.a) AS g(value), LATERAL (SELECT t1.a * 10 + g.value AS v) AS s
    WHERE t1.a < 4
    ORDER BY 1, 2;
}
expect {
    1|1|11
    2|1|21
    2|2|22
    3|1|31
    3|2|32
    3|3|33
}

@setup data
test lateral-subquery-reads-generate-series-of-an-outer-column {
    SELECT t1.a, s.total FROM t1, LATERAL (SELECT sum(value) AS total FROM generate_series(1, t1.a) AS g(value)) AS s ORDER BY 1;
}
expect {
    1|1
    2|3
    3|6
    4|10
}

setup function-argument-names {
    CREATE TABLE args(value INT, start INT, stop INT, step INT);
    INSERT INTO args VALUES (2, 2, 3, 1), (3, 1, 2, 1);
}

@setup function-argument-names
test generate-series-arguments-read-left-columns-named-like-its-own-columns {
    SELECT value, generate_series FROM args, generate_series(1, value) ORDER BY 1, 2;
    SELECT start, stop, g FROM args, generate_series(start, stop, step) g ORDER BY 1, 3;
    SELECT value, n FROM args, generate_series(1, value) AS g(n) ORDER BY 1, 2;
}
expect {
    2|1
    2|2
    3|1
    3|2
    3|3
    1|2|1
    1|2|2
    2|3|2
    2|3|3
    2|1
    2|2
    3|1
    3|2
    3|3
}

@setup data
test lateral-reads-an-outer-column-in-like {
    CREATE TABLE t6(p TEXT);
    INSERT INTO t6 VALUES ('p%'), ('%s'), ('z%');
    SELECT t6.p, s.b FROM t6, LATERAL (SELECT b FROM t1 WHERE t1.b LIKE t6.p) AS s ORDER BY 2;
}
expect {
    p%|p
    %s|s
}
