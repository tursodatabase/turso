# Foreign keys through the PostgreSQL frontend. PostgreSQL always enforces
# them, so no setting is needed to turn them on.

@database :memory:

test fk-insert-missing-parent {
    CREATE TABLE parent (id int PRIMARY KEY);
    CREATE TABLE child (pid int REFERENCES parent(id));
    INSERT INTO child VALUES (42);
}
@sqlstate 23503
expect error {insert or update on table "child" violates foreign key constraint "child_pid_fkey"}

test fk-insert-several-rows-one-missing-parent {
    CREATE TABLE parent (id int PRIMARY KEY);
    CREATE TABLE child (pid int REFERENCES parent(id));
    INSERT INTO parent VALUES (1);
    INSERT INTO child VALUES (1), (99);
}
@sqlstate 23503
expect error {insert or update on table "child" violates foreign key constraint "child_pid_fkey"}

test fk-insert-select-missing-parent {
    CREATE TABLE parent (id int PRIMARY KEY);
    CREATE TABLE child (pid int REFERENCES parent(id));
    INSERT INTO child SELECT 7;
}
@sqlstate 23503
expect error {insert or update on table "child" violates foreign key constraint "child_pid_fkey"}

test fk-insert-existing-parent {
    CREATE TABLE parent (id int PRIMARY KEY);
    CREATE TABLE child (pid int REFERENCES parent(id));
    INSERT INTO parent VALUES (1);
    INSERT INTO child VALUES (1), (NULL);
    SELECT count(*) FROM child;
}
expect {
    2
}

test fk-update-to-missing-parent {
    CREATE TABLE parent (id int PRIMARY KEY);
    CREATE TABLE child (pid int REFERENCES parent(id));
    INSERT INTO parent VALUES (1);
    INSERT INTO child VALUES (1);
    UPDATE child SET pid = 2;
}
@sqlstate 23503
expect error {}

test fk-delete-referenced-parent {
    CREATE TABLE parent (id int PRIMARY KEY);
    CREATE TABLE child (pid int REFERENCES parent(id));
    INSERT INTO parent VALUES (1);
    INSERT INTO child VALUES (1);
    DELETE FROM parent;
}
@sqlstate 23503
expect error {update or delete on table "parent" violates foreign key constraint "child_pid_fkey" on table "child"}

test fk-update-referenced-parent {
    CREATE TABLE parent (id int PRIMARY KEY);
    CREATE TABLE child (pid int CONSTRAINT child_parent REFERENCES parent(id));
    INSERT INTO parent VALUES (1);
    INSERT INTO child VALUES (1);
    UPDATE parent SET id = 2;
}
@sqlstate 23503
expect error {update or delete on table "parent" violates foreign key constraint "child_parent" on table "child"}

test fk-delete-referenced-parent-restrict {
    CREATE TABLE parent (id int PRIMARY KEY);
    CREATE TABLE child (pid int REFERENCES parent(id) ON DELETE RESTRICT);
    INSERT INTO parent VALUES (1);
    INSERT INTO child VALUES (1);
    DELETE FROM parent;
}
@sqlstate 23001
expect error {update or delete on table "parent" violates RESTRICT setting of foreign key constraint "child_pid_fkey" on table "child"}

test fk-update-referenced-parent-restrict {
    CREATE TABLE parent (id int PRIMARY KEY);
    CREATE TABLE child (pid int REFERENCES parent(id) ON UPDATE RESTRICT);
    INSERT INTO parent VALUES (1);
    INSERT INTO child VALUES (1);
    UPDATE parent SET id = 2;
}
@sqlstate 23001
expect error {update or delete on table "parent" violates RESTRICT setting of foreign key constraint "child_pid_fkey" on table "child"}

test fk-delete-referenced-parent-multicolumn {
    CREATE TABLE parent (a int, b text, PRIMARY KEY (a, b));
    CREATE TABLE child (a int, b text, FOREIGN KEY (a, b) REFERENCES parent(a, b));
    INSERT INTO parent VALUES (1, 'x');
    INSERT INTO child VALUES (1, 'x');
    DELETE FROM parent;
}
@sqlstate 23503
expect error {update or delete on table "parent" violates foreign key constraint "child_a_b_fkey" on table "child"}

test fk-references-missing-table {
    CREATE TABLE child (pid int REFERENCES nosuch(id));
}
@sqlstate 42P01
expect error {relation "nosuch" does not exist}

test fk-references-column-without-unique-constraint {
    CREATE TABLE parent (id int PRIMARY KEY, code int);
    CREATE TABLE child (code int REFERENCES parent(code));
}
@sqlstate 42830
expect error {there is no unique constraint matching given keys for referenced table "parent"}

test fk-references-missing-column {
    CREATE TABLE parent (id int PRIMARY KEY);
    CREATE TABLE child (pid int REFERENCES parent(nosuch));
}
@sqlstate 42703
expect error {column "nosuch" referenced in foreign key constraint does not exist}

test fk-references-table-without-primary-key {
    CREATE TABLE parent (id int);
    CREATE TABLE child (pid int REFERENCES parent);
}
@sqlstate 42704
expect error {there is no primary key for referenced table "parent"}

test fk-references-subset-of-unique-columns {
    CREATE TABLE parent (a int, b int, UNIQUE (a, b));
    CREATE TABLE child (a int REFERENCES parent(a));
}
@sqlstate 42830
expect error {there is no unique constraint matching given keys for referenced table "parent"}

# PostgreSQL accepts the columns of a unique constraint in any order. tursopg
# finds the parent rows only through an index with the columns in the order
# the foreign key names them, so it refuses the foreign key.
@skip-if postgres "PostgreSQL accepts the columns of a unique constraint in any order"
test fk-references-unique-columns-in-other-order {
    CREATE TABLE parent (a int, b int, UNIQUE (a, b));
    CREATE TABLE child (a int, b int, FOREIGN KEY (b, a) REFERENCES parent(b, a));
}
@sqlstate 0A000
expect error {}

test fk-references-itself-in-same-create-table {
    CREATE TABLE t (id int PRIMARY KEY, parent int REFERENCES t(id));
    INSERT INTO t VALUES (1, NULL), (2, 1);
    SELECT count(*) FROM t;
}
expect {
    2
}

test fk-on-delete-cascade {
    CREATE TABLE parent (id int PRIMARY KEY);
    CREATE TABLE child (pid int REFERENCES parent(id) ON DELETE CASCADE);
    INSERT INTO parent VALUES (1), (2);
    INSERT INTO child VALUES (1), (1), (2);
    DELETE FROM parent WHERE id = 1;
    SELECT pid FROM child;
}
expect {
    2
}

test fk-on-delete-set-null {
    CREATE TABLE parent (id int PRIMARY KEY);
    CREATE TABLE child (pid int REFERENCES parent(id) ON DELETE SET NULL);
    INSERT INTO parent VALUES (1);
    INSERT INTO child VALUES (1);
    DELETE FROM parent;
    SELECT count(*) FROM child WHERE pid IS NULL;
}
expect {
    1
}

test fk-on-update-cascade {
    CREATE TABLE parent (id int PRIMARY KEY);
    CREATE TABLE child (pid int REFERENCES parent(id) ON UPDATE CASCADE);
    INSERT INTO parent VALUES (1);
    INSERT INTO child VALUES (1);
    UPDATE parent SET id = 5;
    SELECT pid FROM child;
}
expect {
    5
}

# Schema databases are file-backed, so the schema is dropped before each
# create to keep repeated test runs independent of old sidecar files.
test fk-references-table-in-other-schema {
    DROP SCHEMA IF EXISTS fk_app CASCADE;
    CREATE SCHEMA fk_app;
    CREATE TABLE fk_app.accounts (id uuid PRIMARY KEY);
    CREATE TABLE settings (id uuid PRIMARY KEY REFERENCES fk_app.accounts(id));
    INSERT INTO settings VALUES ('b0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11');
}
@sqlstate 23503
expect error {}

test fk-drop-referenced-table {
    CREATE TABLE parent (id int PRIMARY KEY);
    CREATE TABLE child (pid int REFERENCES parent(id) ON DELETE CASCADE);
    DROP TABLE parent;
}
@sqlstate 2BP01
expect error {cannot drop table parent because other objects depend on it}

test fk-truncate-referenced-table {
    CREATE TABLE parent (id int PRIMARY KEY);
    CREATE TABLE child (pid int REFERENCES parent(id) ON DELETE CASCADE);
    INSERT INTO parent VALUES (1);
    INSERT INTO child VALUES (1);
    TRUNCATE parent;
}
@sqlstate 0A000
expect error {cannot truncate a table referenced in a foreign key constraint}

test fk-drop-child-then-parent {
    CREATE TABLE parent (id int PRIMARY KEY);
    CREATE TABLE child (pid int REFERENCES parent(id));
    INSERT INTO parent VALUES (1);
    INSERT INTO child VALUES (1);
    DROP TABLE child;
    DROP TABLE parent;
    CREATE TABLE parent (id int);
    SELECT count(*) FROM parent;
}
expect {
    0
}

test fk-self-reference-delete-all {
    CREATE TABLE t (id int PRIMARY KEY, parent int REFERENCES t(id));
    INSERT INTO t VALUES (1, NULL), (2, 1), (3, 2);
    DELETE FROM t;
    SELECT count(*) FROM t;
}
expect {
    0
}

test fk-self-reference-update-moves-keys {
    CREATE TABLE t (id int PRIMARY KEY, parent int REFERENCES t(id));
    INSERT INTO t VALUES (1, NULL), (2, 1);
    UPDATE t SET id = id + 10, parent = parent + 10;
    SELECT id, parent FROM t ORDER BY id;
}
expect {
    11|
    12|11
}

test fk-self-reference-truncate-and-drop {
    CREATE TABLE t (id int PRIMARY KEY, parent int REFERENCES t(id));
    INSERT INTO t VALUES (1, NULL), (2, 1);
    TRUNCATE t;
    INSERT INTO t VALUES (1, NULL), (2, 1);
    DROP TABLE t;
    CREATE TABLE t (id int);
    SELECT count(*) FROM t;
}
expect {
    0
}

test fk-swap-referenced-keys {
    CREATE TABLE parent (id int PRIMARY KEY, code int UNIQUE);
    CREATE TABLE child (code int REFERENCES parent(code));
    INSERT INTO parent VALUES (1, 10), (2, 20);
    INSERT INTO child VALUES (10);
    UPDATE parent SET code = CASE code WHEN 10 THEN 30 ELSE 10 END;
    SELECT id, code FROM parent ORDER BY id;
}
expect {
    1|30
    2|10
}

# PostgreSQL drops the foreign key of the table outside the schema. tursopg
# cannot drop a foreign key, so it refuses instead of keeping a foreign key to
# a table that no longer exists.
@skip-if postgres "PostgreSQL drops the foreign key that references the schema"
test fk-drop-schema-referenced-from-other-schema {
    DROP SCHEMA IF EXISTS fk_ref CASCADE;
    CREATE SCHEMA fk_ref;
    CREATE TABLE fk_ref.accounts (id int PRIMARY KEY);
    CREATE TABLE settings (id int PRIMARY KEY REFERENCES fk_ref.accounts(id));
    DROP SCHEMA fk_ref CASCADE;
}
@sqlstate 0A000
expect error {}

test fk-drop-schema-with-references-inside {
    DROP SCHEMA IF EXISTS fk_inside CASCADE;
    CREATE SCHEMA fk_inside;
    CREATE TABLE fk_inside.parent (id int PRIMARY KEY);
    CREATE TABLE fk_inside.child (pid int REFERENCES fk_inside.parent(id));
    INSERT INTO fk_inside.parent VALUES (1);
    INSERT INTO fk_inside.child VALUES (1);
    DROP SCHEMA fk_inside CASCADE;
    SELECT count(*) FROM pg_namespace WHERE nspname = 'fk_inside';
}
expect {
    0
}
