@database :memory:

test numeric-plus-finer-literal {
    CREATE TABLE p (val numeric(10,2));
    INSERT INTO p VALUES (1.5);
    SELECT val + 0.005, val * 0.125, val - 0.001 FROM p;
}
expect {
    1.505|0.18750|1.499
}

test domain-cast-check-with-literal {
    CREATE DOMAIN dd AS timestamptz CHECK (VALUE > '2026-10-08 13:00+02');
    SELECT '2026-10-08 11:30:00'::dd;
}
expect {
    2026-10-08 11:30:00+00
}
