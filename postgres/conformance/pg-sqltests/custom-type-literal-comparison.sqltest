# Comparing a column with a quoted literal converts the literal to the
# column's type first, the same way an INSERT would. The result must not
# depend on whether the column has an index.

@database :memory:

test uuid-literal-uppercase {
    CREATE TABLE t (u uuid);
    INSERT INTO t VALUES ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11');
    SELECT
        (SELECT count(*) FROM t WHERE u = 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11'),
        (SELECT count(*) FROM t WHERE u = 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'),
        (SELECT count(*) FROM t WHERE u > '00000000-0000-0000-0000-000000000000');
}
expect {
    1|1|1
}

test uuid-literal-uppercase-indexed {
    CREATE TABLE t (u uuid);
    CREATE INDEX t_u ON t (u);
    INSERT INTO t VALUES ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11');
    SELECT
        (SELECT count(*) FROM t WHERE u = 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11'),
        (SELECT count(*) FROM t WHERE u = 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11');
}
expect {
    1|1
}

test boolean-literal-spellings {
    CREATE TABLE t (b boolean);
    INSERT INTO t VALUES (true), (false);
    SELECT
        (SELECT count(*) FROM t WHERE b = 'true'),
        (SELECT count(*) FROM t WHERE b = 't'),
        (SELECT count(*) FROM t WHERE b = 'no'),
        (SELECT count(*) FROM t WHERE b <> 'yes');
}
expect {
    1|1|1|1
}

test varchar-literal-longer-than-limit {
    CREATE TABLE t (v varchar(3));
    INSERT INTO t VALUES ('abc');
    SELECT
        (SELECT count(*) FROM t WHERE v = 'abcd'),
        (SELECT count(*) FROM t WHERE v < 'abcd'),
        (SELECT count(*) FROM t WHERE v = 'abc');
}
expect {
    0|1|1
}

test varchar-literal-longer-than-limit-indexed {
    CREATE TABLE t (v varchar(3));
    CREATE INDEX t_v ON t (v);
    INSERT INTO t VALUES ('abc');
    SELECT
        (SELECT count(*) FROM t WHERE v = 'abcd'),
        (SELECT count(*) FROM t WHERE v < 'abcd'),
        (SELECT count(*) FROM t WHERE v = 'abc');
}
expect {
    0|1|1
}

test smallint-literal-compare {
    CREATE TABLE t (s smallint);
    INSERT INTO t VALUES (5);
    SELECT
        (SELECT count(*) FROM t WHERE s = '5'),
        (SELECT count(*) FROM t WHERE s = 5),
        (SELECT count(*) FROM t WHERE s < 100000);
}
expect {
    1|1|1
}

test uuid-in-subquery-of-cast {
    CREATE TABLE t (u uuid);
    INSERT INTO t VALUES ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11');
    SELECT count(*) FROM t WHERE u IN (SELECT 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11'::uuid);
}
expect {
    1
}

test uuid-in-subquery-of-cast-indexed {
    CREATE TABLE t (u uuid);
    CREATE INDEX t_u ON t (u);
    INSERT INTO t VALUES ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11');
    SELECT count(*) FROM t WHERE u IN (SELECT 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11'::uuid);
}
expect {
    1
}

test uuid-view-and-cte-column-compared-with-literal {
    CREATE TABLE t (u uuid);
    INSERT INTO t VALUES ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11');
    CREATE VIEW v AS SELECT u FROM t;
    SELECT
        (SELECT count(*) FROM v WHERE u = 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11'),
        (WITH c AS (SELECT u FROM t) SELECT count(*) FROM c WHERE u = 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11'),
        (SELECT count(*) FROM (SELECT u FROM t) s WHERE s.u = 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11');
}
expect {
    1|1|1
}

test uuid-view-and-cte-column-compared-with-literal-indexed {
    CREATE TABLE t (u uuid);
    CREATE INDEX t_u ON t (u);
    INSERT INTO t VALUES ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11');
    CREATE VIEW v AS SELECT u FROM t;
    SELECT
        (SELECT count(*) FROM v WHERE u = 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11'),
        (WITH c AS (SELECT u FROM t) SELECT count(*) FROM c WHERE u = 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11'),
        (SELECT count(*) FROM (SELECT u FROM t) s WHERE s.u = 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11');
}
expect {
    1|1|1
}

test uuid-union-with-literal-removes-duplicate {
    CREATE TABLE t (u uuid);
    INSERT INTO t VALUES ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11');
    SELECT count(*) FROM (SELECT u FROM t UNION SELECT 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11') s;
}
expect {
    1
}

test uuid-case-compared-with-literal {
    CREATE TABLE t (u uuid);
    INSERT INTO t VALUES ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11');
    SELECT CASE u WHEN 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11' THEN 1 ELSE 0 END, CASE WHEN u = 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11' THEN 1 ELSE 0 END FROM t;
}
expect {
    1|1
}

test timestamp-min-max-coalesce-compared-with-literal {
    CREATE TABLE e (ts timestamp);
    INSERT INTO e VALUES ('2026-10-08 12:00:00');
    SELECT
        (SELECT CASE WHEN max(ts) = '2026-10-08T12:00:00' THEN 1 ELSE 0 END FROM e),
        (SELECT CASE WHEN min(ts) = '2026-10-08T12:00:00' THEN 1 ELSE 0 END FROM e),
        (SELECT count(*) FROM e WHERE coalesce(ts, '2000-01-01') = '2026-10-08T12:00:00');
}
expect {
    1|1|1
}

test timestamp-min-max-coalesce-compared-with-literal-indexed {
    CREATE TABLE e (ts timestamp);
    CREATE INDEX e_ts ON e (ts);
    INSERT INTO e VALUES ('2026-10-08 12:00:00');
    SELECT
        (SELECT CASE WHEN max(ts) = '2026-10-08T12:00:00' THEN 1 ELSE 0 END FROM e),
        (SELECT CASE WHEN min(ts) = '2026-10-08T12:00:00' THEN 1 ELSE 0 END FROM e),
        (SELECT count(*) FROM e WHERE coalesce(ts, '2000-01-01') = '2026-10-08T12:00:00');
}
expect {
    1|1|1
}

test numeric-check-compares-decoded-value {
    CREATE TABLE c (v numeric(10,2) CHECK (v > '1.10'));
    INSERT INTO c VALUES (1.5);
    SELECT v FROM c;
}
expect {
    1.50
}

test numeric-check-rejects-value-below-literal {
    CREATE TABLE c (v numeric(10,2) CHECK (v > '1.10'));
    INSERT INTO c VALUES (1.05);
}
expect error {
    violates check constraint
}

test date-column-compared-with-timestamp-column {
    CREATE TABLE d (dt date, ts timestamp);
    INSERT INTO d VALUES ('2026-10-08', '2026-10-08 00:00:00');
    SELECT count(*) FROM d WHERE dt = ts;
}
expect {
    1
}

test date-column-compared-with-timestamp-column-indexed {
    CREATE TABLE d (dt date, ts timestamp);
    CREATE INDEX d_ts ON d (ts);
    INSERT INTO d VALUES ('2026-10-08', '2026-10-08 00:00:00');
    SELECT count(*) FROM d WHERE dt = ts;
}
expect {
    1
}

test domain-date-joined-with-timestamp {
    CREATE DOMAIN dd AS date;
    CREATE TABLE a (r dd);
    CREATE TABLE b (ts timestamp);
    INSERT INTO a VALUES ('2026-10-08');
    INSERT INTO b VALUES ('2026-10-08 00:00:00');
    SELECT count(*) FROM a JOIN b ON a.r = b.ts;
}
expect {
    1
}

test domain-date-joined-with-timestamp-indexed {
    CREATE DOMAIN dd AS date;
    CREATE TABLE a (r dd);
    CREATE TABLE b (ts timestamp);
    CREATE INDEX b_ts ON b (ts);
    INSERT INTO a VALUES ('2026-10-08');
    INSERT INTO b VALUES ('2026-10-08 00:00:00');
    SELECT count(*) FROM a JOIN b ON a.r = b.ts;
}
expect {
    1
}

test subquery-date-joined-with-timestamp {
    CREATE TABLE t1 (ts timestamp, d date);
    INSERT INTO t1 VALUES ('2026-10-08 00:00:00', '2026-10-08');
    SELECT count(*) FROM (SELECT d AS m FROM t1) s JOIN t1 ON s.m = t1.ts;
}
expect {
    1
}

test subquery-date-joined-with-timestamp-indexed {
    CREATE TABLE t1 (ts timestamp, d date);
    CREATE INDEX t1_ts ON t1 (ts);
    INSERT INTO t1 VALUES ('2026-10-08 00:00:00', '2026-10-08');
    SELECT count(*) FROM (SELECT d AS m FROM t1) s JOIN t1 ON s.m = t1.ts;
}
expect {
    1
}

test date-column-joined-with-timestamp-indexed {
    CREATE TABLE a (d date);
    CREATE TABLE b (ts timestamp);
    CREATE INDEX b_ts ON b (ts);
    INSERT INTO a VALUES ('2026-10-08');
    INSERT INTO b VALUES ('2026-10-08 00:00:00');
    SELECT count(*) FROM a JOIN b ON a.d = b.ts;
}
expect {
    1
}

test numeric-times-float-function-is-float {
    CREATE TABLE p (n numeric(10,2), f float8);
    INSERT INTO p VALUES (1.5, 0.125);
    SELECT n * pi(), n * abs(f), n * sqrt(f * 2) FROM p;
}
expect {
    4.71238898038469|0.1875|0.75
}

test numeric-plus-float-arithmetic-is-float {
    CREATE TABLE p (n numeric(10,2), f float8);
    INSERT INTO p VALUES (1.5, 0.125);
    SELECT n + f * 2, f * 2 - n FROM p;
}
expect {
    1.75|-1.25
}

test numeric-times-integer-expression-stays-numeric {
    CREATE TABLE p (n numeric(10,2), i int);
    INSERT INTO p VALUES (1.5, -2);
    SELECT n * abs(i), n + i * 2 FROM p;
}
expect {
    3.00|-2.50
}

test numeric-literal-is-compared-without-rounding-to-column-scale {
    CREATE TABLE n (v numeric(10,2));
    INSERT INTO n VALUES (1.50), (1.51);
    SELECT count(*) FROM n WHERE v = 1.501;
    SELECT count(*) FROM n WHERE v = '1.501';
    SELECT count(*) FROM n WHERE v >= 1.504;
    SELECT count(*) FROM n WHERE v < 1.505;
    SELECT count(*) FROM n WHERE v <> 1.501;
    SELECT v + 1.501 FROM n WHERE v = 1.5;
}
expect {
    0
    0
    1
    1
    2
    3.001
}

test numeric-literal-is-compared-without-rounding-to-column-scale-with-index {
    CREATE TABLE n (v numeric(10,2));
    CREATE INDEX n_v ON n (v);
    INSERT INTO n VALUES (1.50), (1.51);
    SELECT count(*) FROM n WHERE v = 1.501;
    SELECT count(*) FROM n WHERE v = '1.501';
    SELECT count(*) FROM n WHERE v IN (1.501, 7);
    SELECT count(*) FROM n WHERE v IN (1.5, 7);
    SELECT count(*) FROM n WHERE v IN ('1.501', '1.510');
    SELECT count(*) FROM n WHERE v = 1.5;
    SELECT count(*) FROM n WHERE v >= 1.504;
}
expect {
    0
    0
    0
    1
    1
    1
    1
}

test numeric-literal-too-big-for-column-precision-with-index {
    CREATE TABLE a (v numeric(10,2));
    CREATE INDEX a_v ON a(v);
    INSERT INTO a VALUES (1.50);
    SELECT count(*) FROM a WHERE v IN (12345678901.5);
    SELECT count(*) FROM a WHERE v = 12345678901.5;
    SELECT count(*) FROM a WHERE v IN (12345678901.5, 1.5);
}
expect {
    0
    0
    1
}
