# EXPLAIN through the PostgreSQL frontend.
#
# Simple EXPLAIN is intentionally mapped to SQLite's EXPLAIN QUERY PLAN.
# PostgreSQL EXPLAIN options are rejected until their output semantics exist.

@database :memory:

setup explain_table {
    CREATE TABLE t (id int);
    INSERT INTO t VALUES (1), (2);
}

setup dml_items {
    CREATE TABLE items (id int primary key, value int);
    INSERT INTO items VALUES (1, 10);
}

@setup explain_table
test explain-select {
    EXPLAIN SELECT id FROM t WHERE id = 1;
}
expect {
    1|0|0|SCAN t
}

@setup dml_items
test explain-insert-does-not-execute {
    EXPLAIN INSERT INTO items VALUES (2, 20);
    SELECT id, value FROM items;
}
expect {
    1|10
}

@setup dml_items
test explain-update-does-not-execute {
    EXPLAIN UPDATE items SET value = 99 WHERE id = 1;
    SELECT id, value FROM items;
}
expect {
    2|0|0|SEARCH items USING INTEGER PRIMARY KEY (rowid=?)
    1|10
}

@setup dml_items
test explain-delete-does-not-execute {
    EXPLAIN DELETE FROM items WHERE id = 1;
    SELECT id, value FROM items;
}
expect {
    2|0|0|SEARCH items USING INTEGER PRIMARY KEY (rowid=?)
    1|10
}

test explain-result {
    EXPLAIN SELECT 1;
}
expect {
    1|0|0|SCAN CONSTANT ROW
}

test explain-analyze-errors {
    EXPLAIN ANALYZE SELECT 1;
}
expect error {}

test explain-options-error {
    EXPLAIN (VERBOSE) SELECT 1;
}
expect error {}

test explain-verbose-errors {
    EXPLAIN VERBOSE SELECT 1;
}
expect error {}

test explain-costs-off-errors {
    EXPLAIN (COSTS OFF) SELECT 1;
}
expect error {}

test explain-buffers-errors {
    EXPLAIN (BUFFERS) SELECT 1;
}
expect error {}

test explain-format-json-errors {
    EXPLAIN (FORMAT JSON) SELECT 1;
}
expect error {}

# Indexes on timestamp, date, bigint and uuid columns give range searches and
# an order, like indexes on int columns. A numeric equal test calls the
# numeric `=` function, so a hash join cannot run it.

setup typed_columns {
    CREATE TABLE ev (id int PRIMARY KEY, ts timestamp, day date, note text);
    CREATE INDEX ev_ts ON ev (ts);
    CREATE INDEX ev_day ON ev (day);
    CREATE TABLE orders (id bigint PRIMARY KEY, total bigint);
    CREATE INDEX orders_total ON orders (total);
    CREATE TABLE acct (id uuid PRIMARY KEY, name text);
    CREATE TABLE pa (id int PRIMARY KEY, n numeric(10,2));
    CREATE TABLE pb (id int PRIMARY KEY, m numeric(10,3));
    INSERT INTO pa WITH RECURSIVE s(v) AS (SELECT 1 UNION ALL SELECT v + 1 FROM s WHERE v < 200) SELECT v, v / 4.0 FROM s;
    INSERT INTO pb SELECT id, n FROM pa;
}

@setup typed_columns
test explain-timestamp-and-date-range-search {
    EXPLAIN SELECT id FROM ev WHERE ts > '2024-01-01 12:00:00';
    EXPLAIN SELECT count(*) FROM ev WHERE day BETWEEN '2024-01-05' AND '2024-01-31';
}
expect {
    1|0|0|SEARCH ev USING COVERING INDEX ev_ts (ts>?)
    1|0|0|SEARCH ev USING COVERING INDEX ev_day (day>=? AND day<=?)
}

@setup typed_columns
test explain-timestamp-order-by-limit-uses-index-order {
    EXPLAIN SELECT id, note FROM ev ORDER BY ts DESC LIMIT 10;
}
expect {
    1|0|0|SCAN ev USING INDEX ev_ts
}

@setup typed_columns
test explain-bigint-range-search {
    EXPLAIN SELECT total FROM orders WHERE id > 5;
    EXPLAIN SELECT id FROM orders WHERE total BETWEEN 100 AND 200;
}
expect {
    1|0|0|SEARCH orders USING INDEX sqlite_autoindex_orders_1 (id>?)
    1|0|0|SEARCH orders USING INDEX orders_total (total>=? AND total<=?)
}

@setup typed_columns
test explain-uuid-range-search {
    EXPLAIN SELECT name FROM acct WHERE id > 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11';
}
expect {
    1|0|0|SEARCH acct USING INDEX sqlite_autoindex_acct_1 (id>?)
}

@setup typed_columns
test explain-numeric-join-is-not-a-hash-join {
    EXPLAIN SELECT count(*) FROM pa JOIN pb ON pa.n = pb.m;
}
expect {
    1|0|0|SCAN pa
    2|0|0|SCAN pb
}
