# EXPLAIN through the PostgreSQL frontend.
#
# Simple EXPLAIN is intentionally mapped to SQLite's EXPLAIN QUERY PLAN.
# PostgreSQL EXPLAIN options are rejected until their output semantics exist.

@skip-file-if postgres "EXPLAIN shows the Turso query plan, and Turso rejects EXPLAIN options that PostgreSQL accepts"

@database :memory:

setup explain_table {
    CREATE TABLE t (id int);
    INSERT INTO t VALUES (1), (2);
}

setup uuid_index_table {
    CREATE TABLE ux (id int PRIMARY KEY, u uuid);
    INSERT INTO ux VALUES (1, '11111111-1111-1111-1111-111111111111'), (2, '22222222-2222-2222-2222-222222222222');
    CREATE INDEX ux_u ON ux (u);
}

setup date_index_table {
    CREATE TABLE dx (id int PRIMARY KEY, d date);
    INSERT INTO dx VALUES (1, '2020-01-01'), (2, '2021-06-15');
    CREATE INDEX dx_d ON dx (d);
}

setup like_index_table {
    CREATE TABLE users (id int PRIMARY KEY, age int, name text);
    INSERT INTO users VALUES (1, 3, 'John'), (2, 3, 'Mary'), (3, 4, 'Jane');
    CREATE INDEX users_age ON users (age) WHERE name LIKE 'J%';
}

setup dml_items {
    CREATE TABLE items (id int primary key, value int);
    INSERT INTO items VALUES (1, 10);
}

@setup explain_table
test explain-select {
    EXPLAIN SELECT id FROM t WHERE id = 1;
}
expect {
    1|0|0|SCAN t
}

@setup uuid_index_table
test explain-uses-the-index-of-a-uuid-column-for-a-cast-to-uuid {
    EXPLAIN SELECT id FROM ux WHERE u = '22222222-2222-2222-2222-222222222222'::uuid;
    SELECT id FROM ux WHERE u = '22222222-2222-2222-2222-222222222222'::uuid;
}
expect {
    1|0|0|SEARCH ux USING COVERING INDEX ux_u (u=?)
    2
}

@setup date_index_table
test explain-uses-the-index-of-a-date-column-for-a-cast-to-date {
    EXPLAIN SELECT id FROM dx WHERE d = '2021-06-15'::date;
    SELECT id FROM dx WHERE d = '2021-06-15'::date;
}
expect {
    1|0|0|SEARCH dx USING COVERING INDEX dx_d (d=?)
    2
}

@setup like_index_table
test explain-uses-a-partial-index-with-a-like-predicate {
    EXPLAIN SELECT id FROM users WHERE age = 3 AND name LIKE 'J%';
}
expect {
    1|0|0|SEARCH users USING COVERING INDEX users_age (age=?)
}

@setup like_index_table
test explain-scans-when-the-like-predicate-differs {
    EXPLAIN SELECT id FROM users WHERE age = 3 AND name LIKE 'K%';
}
expect {
    1|0|0|SCAN users
}

@setup dml_items
test explain-insert-does-not-execute {
    EXPLAIN INSERT INTO items VALUES (2, 20);
    SELECT id, value FROM items;
}
expect {
    1|10
}

@setup dml_items
test explain-update-does-not-execute {
    EXPLAIN UPDATE items SET value = 99 WHERE id = 1;
    SELECT id, value FROM items;
}
expect {
    2|0|0|SEARCH items USING INTEGER PRIMARY KEY (rowid=?)
    1|10
}

@setup dml_items
test explain-delete-does-not-execute {
    EXPLAIN DELETE FROM items WHERE id = 1;
    SELECT id, value FROM items;
}
expect {
    2|0|0|SEARCH items USING INTEGER PRIMARY KEY (rowid=?)
    1|10
}

test explain-result {
    EXPLAIN SELECT 1;
}
expect {
    1|0|0|SCAN CONSTANT ROW
}

test explain-analyze-errors {
    EXPLAIN ANALYZE SELECT 1;
}
@sqlstate 0A000
expect error {}

test explain-options-error {
    EXPLAIN (VERBOSE) SELECT 1;
}
expect error {}

test explain-verbose-errors {
    EXPLAIN VERBOSE SELECT 1;
}
expect error {}

test explain-costs-off-errors {
    EXPLAIN (COSTS OFF) SELECT 1;
}
expect error {}

test explain-buffers-errors {
    EXPLAIN (BUFFERS) SELECT 1;
}
expect error {}

test explain-format-json-errors {
    EXPLAIN (FORMAT JSON) SELECT 1;
}
expect error {}

test explain-order-by-primary-key-uses-index {
    CREATE TABLE k (code text PRIMARY KEY, n int);
    CREATE TABLE k2 (code text, n int, PRIMARY KEY (code));
    CREATE TABLE k3 (code text NOT NULL, n int);
    CREATE INDEX k3_code ON k3 (code);
    EXPLAIN SELECT code FROM k ORDER BY code LIMIT 3;
    EXPLAIN SELECT code FROM k2 ORDER BY code DESC LIMIT 3;
    EXPLAIN SELECT code FROM k3 ORDER BY code LIMIT 3;
}
expect {
    1|0|0|SCAN k USING COVERING INDEX sqlite_autoindex___turso_ns1_k_1
    1|0|0|SCAN k2 USING COVERING INDEX sqlite_autoindex___turso_ns1_k2_1
    1|0|0|SCAN k3 USING COVERING INDEX k3_code
}

# The parts of a row-level security policy are conditions the optimizer can
# use, so a role reads its rows through the index on the column the policy
# compares with the role.
test explain-select-seeks-index-of-policy-column {
    CREATE ROLE explain_policy_role;
    CREATE TABLE explain_policy_docs (id int primary key, owner text, archived boolean);
    CREATE INDEX explain_policy_docs_owner ON explain_policy_docs (owner);
    ALTER TABLE explain_policy_docs ENABLE ROW LEVEL SECURITY;
    CREATE POLICY own ON explain_policy_docs USING (owner = current_user AND NOT archived);
    GRANT SELECT ON explain_policy_docs TO explain_policy_role;
    SET ROLE explain_policy_role;
    EXPLAIN SELECT id FROM explain_policy_docs;
}
expect {
    1|0|0|SEARCH explain_policy_docs USING INDEX explain_policy_docs_owner (owner=?)
}

# A subquery of a policy that reads no column is computed once, so the role
# is still sought through the index.
test explain-select-seeks-index-with-subquery-of-policy {
    CREATE ROLE explain_policy_subquery_role;
    CREATE TABLE explain_policy_subquery_docs (id int primary key, owner text);
    CREATE INDEX explain_policy_subquery_docs_owner ON explain_policy_subquery_docs (owner);
    ALTER TABLE explain_policy_subquery_docs ENABLE ROW LEVEL SECURITY;
    CREATE POLICY own ON explain_policy_subquery_docs USING (owner = (SELECT current_user));
    GRANT SELECT ON explain_policy_subquery_docs TO explain_policy_subquery_role;
    SET ROLE explain_policy_subquery_role;
    EXPLAIN SELECT id FROM explain_policy_subquery_docs;
}
expect {
    1|0|0|SEARCH explain_policy_subquery_docs USING COVERING INDEX explain_policy_subquery_docs_owner (owner=?)
}
