# The catalog of SQL functions: CREATE FUNCTION, CREATE OR REPLACE FUNCTION,
# DROP FUNCTION and pg_proc.
#
# tursopg stores a function but cannot call it yet. The tests that call a
# function are in create-function.sqltest.

@database :memory:

# pg_proc

test pg-proc-shows-a-function {
    CREATE FUNCTION add_one(integer) RETURNS integer LANGUAGE sql AS $$SELECT $1 + 1$$;
    SELECT proname, prosrc, pronargs, prorettype, proargtypes, prokind, provolatile
    FROM pg_proc WHERE proname = 'add_one';
}
expect {
    add_one|SELECT $1 + 1|1|23|23|f|v
}

# prosrc is the body as the user wrote it, with its comments and line breaks.
test pg-proc-keeps-the-body-as-written {
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $body$
        -- returns one
        SELECT 1;
    $body$;
    SELECT count(*) FROM pg_proc
    WHERE proname = 'one' AND prosrc = E'\n        -- returns one\n        SELECT 1;\n    ';
}
expect {
    1
}

test pg-proc-shows-the-parameter-types {
    CREATE FUNCTION pad(text, bigint, boolean) RETURNS text LANGUAGE sql AS $$SELECT $1$$;
    SELECT pronargs, proargtypes, prorettype FROM pg_proc WHERE proname = 'pad';
}
expect {
    3|25 20 16|25
}

test pg-proc-shows-the-sql-language {
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    SELECT p.prolang, l.lanname FROM pg_proc p JOIN pg_language l ON l.oid = p.prolang
    WHERE p.proname = 'one';
}
expect {
    14|sql
}

test pg-language-has-the-sql-language {
    SELECT oid, lanname, lanowner, lanispl, lanpltrusted FROM pg_language WHERE lanname = 'sql';
}
expect {
    14|sql|10|f|t
}

# pronamespace is the oid of the function's schema in pg_namespace, as in
# PostgreSQL. The oid of public is the same as in PostgreSQL. The oid of any
# other schema is not: tursopg derives it from the id of the namespace.
test pg-proc-shows-the-schema {
    CREATE SCHEMA app;
    CREATE FUNCTION app.one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    CREATE FUNCTION two() RETURNS integer LANGUAGE sql AS $$SELECT 2$$;
    SELECT p.proname, n.nspname FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
    WHERE p.proname IN ('one', 'two') ORDER BY p.proname;
    SELECT pronamespace FROM pg_proc WHERE proname = 'two';
}
expect {
    one|app
    two|public
    2200
}

test function-oid-is-a-user-object-oid {
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    SELECT count(*) FROM pg_proc WHERE proname = 'one' AND oid >= 16384;
}
expect {
    1
}

test function-is-not-in-pg-class {
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    SELECT count(*) FROM pg_class WHERE relname LIKE 'one%';
}
expect {
    0
}

# Schemas

test function-goes-to-the-first-schema-of-the-search-path {
    CREATE SCHEMA app;
    SET search_path = app, public;
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    SELECT n.nspname FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
    WHERE p.proname = 'one';
}
expect {
    app
}

test function-without-a-schema-to-create-in {
    SET search_path = nosuch;
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
}
@sqlstate 3F000
expect error {
    no schema has been selected to create in
}

test same-function-in-two-schemas {
    CREATE SCHEMA app;
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    CREATE FUNCTION app.one() RETURNS integer LANGUAGE sql AS $$SELECT 10$$;
    SELECT n.nspname, p.prosrc FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
    WHERE p.proname = 'one' ORDER BY n.nspname;
}
expect {
    app|SELECT 10
    public|SELECT 1
}

# PostgreSQL lets a superuser create a function in pg_catalog.
test function-in-pg-catalog {
    CREATE FUNCTION pg_catalog.one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    SELECT count(*) FROM pg_proc WHERE proname = 'one';
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    a function in schema pg_catalog is not supported
}

# PostgreSQL creates an object in the first schema of the search path, also
# when it is pg_catalog. tursopg does not create objects in pg_catalog: for a
# name without a schema, it uses the next schema of the search path.
test function-with-pg-catalog-first-in-the-search-path {
    SET search_path = pg_catalog, public;
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    SELECT n.nspname FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace WHERE p.proname = 'one';
}
expect {
    pg_catalog
}
expect @tursopg {
    public
}

# tursopg names a function of a schema `schema.name` in a call, so neither
# name can have a dot.
test function-name-with-a-dot {
    CREATE FUNCTION "a.b"() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    SELECT count(*) FROM pg_proc WHERE proname = 'a.b';
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    a function or schema name with a dot is not supported
}

# Overloading

test functions-with-different-parameter-types {
    CREATE FUNCTION show(integer) RETURNS text LANGUAGE sql AS $$SELECT 'integer'$$;
    CREATE FUNCTION show(text) RETURNS text LANGUAGE sql AS $$SELECT 'text'$$;
    CREATE FUNCTION show(integer, integer) RETURNS text LANGUAGE sql AS $$SELECT 'two'$$;
    SELECT pronargs, proargtypes FROM pg_proc WHERE proname = 'show' ORDER BY pronargs, proargtypes;
}
expect {
    1|23
    1|25
    2|23 23
}

test function-with-the-same-parameter-types {
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 2$$;
}
@sqlstate 42723
expect error {
    function "one" already exists with same argument types
}

# A type modifier and another name of a type do not make another function.
test function-with-the-same-parameter-types-written-differently {
    CREATE FUNCTION show(varchar(10), int4) RETURNS text LANGUAGE sql AS $$SELECT $1$$;
    CREATE FUNCTION show(character varying, integer) RETURNS text LANGUAGE sql AS $$SELECT $1$$;
}
@sqlstate 42723
expect error {
    function "show" already exists with same argument types
}

# CREATE OR REPLACE

test replace-keeps-the-oid {
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    CREATE TABLE before AS SELECT oid AS function_oid FROM pg_proc WHERE proname = 'one';
    CREATE OR REPLACE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 2$$;
    SELECT p.prosrc, count(*) FROM pg_proc p JOIN before b ON b.function_oid = p.oid
    WHERE p.proname = 'one' GROUP BY p.prosrc;
}
expect {
    SELECT 2|1
}

test replace-creates-a-function-that-does-not-exist {
    CREATE OR REPLACE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    SELECT prosrc FROM pg_proc WHERE proname = 'one';
}
expect {
    SELECT 1
}

test replace-with-other-parameter-types-adds-a-function {
    CREATE FUNCTION show(integer) RETURNS text LANGUAGE sql AS $$SELECT 'integer'$$;
    CREATE OR REPLACE FUNCTION show(text) RETURNS text LANGUAGE sql AS $$SELECT 'text'$$;
    SELECT count(*) FROM pg_proc WHERE proname = 'show';
}
expect {
    2
}

test replace-with-another-return-type {
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    CREATE OR REPLACE FUNCTION one() RETURNS text LANGUAGE sql AS $$SELECT 'one'$$;
}
@sqlstate 42P13
expect error {
    cannot change return type of existing function
}

# DROP FUNCTION

test drop-function-without-parameter-types {
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    DROP FUNCTION one;
    SELECT count(*) FROM pg_proc WHERE proname = 'one';
}
expect {
    0
}

test drop-function-with-parameter-types {
    CREATE FUNCTION show(integer) RETURNS text LANGUAGE sql AS $$SELECT 'integer'$$;
    CREATE FUNCTION show(text) RETURNS text LANGUAGE sql AS $$SELECT 'text'$$;
    DROP FUNCTION show(int);
    SELECT proargtypes FROM pg_proc WHERE proname = 'show';
}
expect {
    25
}

test drop-function-with-a-name-that-is-not-unique {
    CREATE FUNCTION show(integer) RETURNS text LANGUAGE sql AS $$SELECT 'integer'$$;
    CREATE FUNCTION show(text) RETURNS text LANGUAGE sql AS $$SELECT 'text'$$;
    DROP FUNCTION show;
}
@sqlstate 42725
expect error {
    function name "show" is not unique
}

test drop-function-with-a-name-that-is-not-unique-in-the-search-path {
    CREATE SCHEMA app;
    CREATE FUNCTION show(integer) RETURNS text LANGUAGE sql AS $$SELECT 'integer'$$;
    CREATE FUNCTION app.show(text) RETURNS text LANGUAGE sql AS $$SELECT 'text'$$;
    SET search_path = app, public;
    DROP FUNCTION show;
}
@sqlstate 42725
expect error {
    function name "show" is not unique
}

# A function of an earlier schema of the search path hides the functions of
# the later schemas that have its parameter types.
test drop-function-with-a-name-that-a-function-of-a-later-schema-also-has {
    CREATE SCHEMA app;
    CREATE FUNCTION show(integer) RETURNS text LANGUAGE sql AS $$SELECT 'public'$$;
    CREATE FUNCTION app.show(integer) RETURNS text LANGUAGE sql AS $$SELECT 'app'$$;
    SET search_path = app, public;
    DROP FUNCTION show;
    SELECT n.nspname FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace WHERE p.proname = 'show';
}
expect {
    public
}

test drop-function-that-does-not-exist {
    CREATE FUNCTION show(integer) RETURNS text LANGUAGE sql AS $$SELECT 'integer'$$;
    DROP FUNCTION show(text, bigint);
}
@sqlstate 42883
expect error {
    function show\(text, bigint\) does not exist
}

test drop-function-if-exists {
    DROP FUNCTION IF EXISTS nosuch;
    DROP FUNCTION IF EXISTS nosuch(integer);
    DROP FUNCTION IF EXISTS nosuch.one();
    DROP FUNCTION IF EXISTS nosuch(nosuch_type);
    SELECT 1;
}
expect {
    1
}

test drop-function-in-a-schema {
    CREATE SCHEMA app;
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    CREATE FUNCTION app.one() RETURNS integer LANGUAGE sql AS $$SELECT 10$$;
    DROP FUNCTION app.one();
    SELECT n.nspname FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
    WHERE p.proname = 'one';
}
expect {
    public
}

test drop-function-in-a-schema-that-does-not-exist {
    DROP FUNCTION nosuch.one();
}
@sqlstate 3F000
expect error {
    schema "nosuch" does not exist
}

# PostgreSQL names the function as the statement does, with its schema.
test drop-function-that-the-schema-does-not-have {
    CREATE SCHEMA app;
    DROP FUNCTION app.one();
}
@sqlstate 42883
expect error {
    function app\.one\(\) does not exist
}

test drop-function-without-parameter-types-that-the-schema-does-not-have {
    CREATE SCHEMA app;
    DROP FUNCTION app.one;
}
@sqlstate 42883
expect error {
    could not find a function named "app\.one"
}

test drop-function-uses-the-search-path {
    CREATE SCHEMA app;
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    CREATE FUNCTION app.one() RETURNS integer LANGUAGE sql AS $$SELECT 10$$;
    SET search_path = app, public;
    DROP FUNCTION one();
    SELECT n.nspname FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
    WHERE p.proname = 'one';
}
expect {
    public
}

# anyelement is a type of PostgreSQL, so the error is for the function.
test drop-function-with-a-polymorphic-parameter-type {
    DROP FUNCTION one(anyelement);
}
@sqlstate 42883
expect error {
    function one\(anyelement\) does not exist
}

test drop-built-in-function {
    DROP FUNCTION upper(text);
}
@sqlstate 2BP01
expect error {
    cannot drop function upper\(text\) because it is required by the database system
}

test drop-built-in-function-if-exists {
    DROP FUNCTION IF EXISTS lower(text);
}
@sqlstate 2BP01
expect error {
    cannot drop function lower\(text\) because it is required by the database system
}

# PostgreSQL shows the parameter types of the function. tursopg knows them
# only for a function without parameters.
test drop-built-in-function-without-a-parameter-list {
    DROP FUNCTION pg_backend_pid;
}
@sqlstate 2BP01
expect error {
    cannot drop function pg_backend_pid\(\) because it is required by the database system
}

test drop-built-in-function-without-a-parameter-list-if-exists {
    DROP FUNCTION IF EXISTS pg_backend_pid;
}
@sqlstate 2BP01
expect error {
    cannot drop function pg_backend_pid\(\) because it is required by the database system
}

# PostgreSQL has several functions abs, so the name is not unique. tursopg
# does not know the parameter types of its built-in functions.
test drop-built-in-function-with-parameters-without-a-parameter-list {
    DROP FUNCTION abs;
}
@sqlstate 42725
expect error {
    function name "abs" is not unique
}
@sqlstate 2BP01
expect @tursopg error {
    cannot drop function abs because it is required by the database system
}

# PostgreSQL matches the name of a function exactly, and the built-in
# functions have a name in lowercase.
test drop-function-with-the-name-of-a-built-in-function-in-another-case {
    DROP FUNCTION "Abs";
}
@sqlstate 42883
expect error {
    could not find a function named "Abs"
}

# PostgreSQL looks in pg_catalog before the schemas of the search path. It
# finds the built-in function lower(text), which it does not drop. tursopg
# does not know the parameter types of its built-in functions, so it cannot
# tell if the statement names the built-in function or the function of the
# user. It refuses the statement.
test drop-function-with-the-signature-of-a-built-in-function {
    CREATE FUNCTION lower(text) RETURNS text LANGUAGE sql AS $$SELECT 'x'$$;
    DROP FUNCTION lower(text);
}
@sqlstate 2BP01
expect error {
    cannot drop function lower\(text\) because it is required by the database system
}
@sqlstate 0A000
expect @tursopg error {
    DROP FUNCTION without a schema for "lower", a name that a built-in function also has, is not supported
}

# PostgreSQL has no built-in function lower(integer), so it drops the
# function of the user.
test drop-function-with-the-name-of-a-built-in-function-and-other-parameter-types {
    CREATE FUNCTION lower(integer) RETURNS text LANGUAGE sql AS $$SELECT 'x'$$;
    DROP FUNCTION lower(integer);
    SELECT count(*) FROM pg_proc WHERE proname = 'lower' AND oid >= 16384;
}
expect {
    0
}
@sqlstate 0A000
expect @tursopg error {
    DROP FUNCTION without a schema for "lower", a name that a built-in function also has, is not supported
}

test drop-function-with-the-name-of-a-built-in-function-with-its-schema {
    CREATE FUNCTION lower(text) RETURNS text LANGUAGE sql AS $$SELECT 'x'$$;
    DROP FUNCTION public.lower(text);
    SELECT count(*) FROM pg_proc WHERE proname = 'lower' AND oid >= 16384;
}
expect {
    0
}

test drop-function-with-the-name-of-a-built-in-function-without-a-parameter-list {
    CREATE FUNCTION lower(integer) RETURNS text LANGUAGE sql AS $$SELECT 'x'$$;
    DROP FUNCTION lower;
}
@sqlstate 42725
expect error {
    function name "lower" is not unique
}

test drop-function-with-a-parameter-type-that-does-not-exist {
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    DROP FUNCTION one(nosuch);
}
@sqlstate 42704
expect error {
    type "nosuch" does not exist
}

# PostgreSQL finds a type by its exact name.
test drop-function-with-a-parameter-type-in-another-case {
    CREATE TYPE mood AS ENUM ('a');
    DROP FUNCTION one("Mood");
}
@sqlstate 42704
expect error {
    type "Mood" does not exist
}

test drop-function-with-the-row-type-of-a-table-in-another-case {
    CREATE TABLE item (a integer);
    DROP FUNCTION one("Item");
}
@sqlstate 42704
expect error {
    type "Item" does not exist
}

test drop-function-with-the-row-type-of-a-table-with-an-uppercase-letter {
    CREATE TABLE "Item" (a integer);
    DROP FUNCTION one(item);
}
@sqlstate 42704
expect error {
    type "item" does not exist
}

test drop-function-with-the-row-type-of-a-table-with-an-uppercase-letter-in-quotes {
    CREATE TABLE "Item" (a integer);
    DROP FUNCTION one("Item");
}
@sqlstate 42883
expect error {
    function one\("Item"\) does not exist
}

# tursopg stores the name of a custom type in lowercase, so it does not find
# the type by its quoted name, and it finds the type by the name in
# lowercase.
test drop-function-with-a-parameter-type-that-has-an-uppercase-letter {
    CREATE TYPE "Mood" AS ENUM ('a');
    DROP FUNCTION one("Mood");
}
@sqlstate 42883
expect error {
    function one\("Mood"\) does not exist
}
@sqlstate 42704
expect @tursopg error {
    type "Mood" does not exist
}

# Each catalog table has a row type.
test drop-function-with-the-row-type-of-a-catalog-table {
    DROP FUNCTION one(pg_class);
}
@sqlstate 42883
expect error {
    function one\(pg_class\) does not exist
}

# A parameter type without a schema is a type of the search path.
test drop-function-with-a-parameter-type-that-is-not-on-the-search-path {
    CREATE SCHEMA app;
    CREATE TABLE app.item (a integer);
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    DROP FUNCTION one(item);
}
@sqlstate 42704
expect error {
    type "item" does not exist
}

test drop-function-with-a-parameter-type-of-a-schema {
    CREATE SCHEMA app;
    CREATE TABLE app.item (a integer);
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    DROP FUNCTION one(app.item);
}
@sqlstate 42883
expect error {
    function one\(app\.item\) does not exist
}

test drop-function-with-a-parameter-type-that-the-schema-does-not-have {
    CREATE SCHEMA app;
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    DROP FUNCTION one(app.nosuch);
}
@sqlstate 42704
expect error {
    type "app\.nosuch" does not exist
}

test drop-function-with-a-parameter-type-of-a-schema-that-does-not-exist {
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    DROP FUNCTION one(nosuch.item);
}
@sqlstate 3F000
expect error {
    schema "nosuch" does not exist
}

test function-name-is-free-after-drop {
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    DROP FUNCTION one();
    CREATE FUNCTION one() RETURNS text LANGUAGE sql AS $$SELECT 'one'$$;
    SELECT prorettype FROM pg_proc WHERE proname = 'one';
}
expect {
    25
}

# The name of a function keeps its case, so "One" and one are two functions.
test drop-function-whose-name-differs-in-case-from-another-function {
    CREATE FUNCTION "One"() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 2$$;
    DROP FUNCTION one();
    SELECT proname, prosrc FROM pg_proc WHERE proname IN ('One', 'one');
}
expect {
    One|SELECT 1
}

test drop-several-functions {
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    CREATE FUNCTION two() RETURNS integer LANGUAGE sql AS $$SELECT 2$$;
    DROP FUNCTION one(), two();
    SELECT count(*) FROM pg_proc WHERE proname IN ('one', 'two');
}
expect {
    0
}
@sqlstate 0A000
expect @tursopg error {
    DROP FUNCTION of several objects is not supported
}

test drop-function-cascade {
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    DROP FUNCTION one() CASCADE;
    SELECT count(*) FROM pg_proc WHERE proname = 'one';
}
expect {
    0
}
@sqlstate 0A000
expect @tursopg error {
    DROP FUNCTION \.\.\. CASCADE is not supported
}

# Transactions

test rollback-removes-a-created-function {
    BEGIN;
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    SELECT count(*) FROM pg_proc WHERE proname = 'one';
    ROLLBACK;
    SELECT count(*) FROM pg_proc WHERE proname = 'one';
}
expect {
    1
    0
}

test rollback-restores-a-dropped-function {
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    BEGIN;
    DROP FUNCTION one();
    SELECT count(*) FROM pg_proc WHERE proname = 'one';
    ROLLBACK;
    SELECT prosrc FROM pg_proc WHERE proname = 'one';
}
expect {
    0
    SELECT 1
}

test rollback-restores-a-replaced-function {
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    BEGIN;
    CREATE OR REPLACE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 2$$;
    ROLLBACK;
    SELECT prosrc FROM pg_proc WHERE proname = 'one';
}
expect {
    SELECT 1
}

# The body is checked when the function is created.

test body-reads-a-table-that-does-not-exist {
    CREATE FUNCTION first_a() RETURNS integer LANGUAGE sql AS $$SELECT a FROM nosuch$$;
}
@sqlstate 42P01
expect error {
    relation "nosuch" does not exist
}
@sqlstate 42P01
expect @tursopg error {
    no such table: nosuch
}

test body-reads-a-column-that-does-not-exist {
    CREATE TABLE t (a integer);
    CREATE FUNCTION first_b() RETURNS integer LANGUAGE sql AS $$SELECT b FROM t$$;
}
@sqlstate 42703
expect error {
    column "b" does not exist
}
@sqlstate 42703
expect @tursopg error {
    no such column: b
}

# To give PostgreSQL's message, tursopg must know the types of the arguments.
test body-calls-a-function-that-does-not-exist {
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT nosuch(1)$$;
}
@sqlstate 42883
expect error {
    function nosuch\(integer\) does not exist
}
@sqlstate 42883
expect @tursopg error {
    no such function: nosuch
}

test body-reads-a-table {
    CREATE TABLE t (a integer);
    CREATE FUNCTION first_a() RETURNS integer LANGUAGE sql AS $$SELECT a FROM t ORDER BY a LIMIT 1$$;
    SELECT prosrc FROM pg_proc WHERE proname = 'first_a';
}
expect {
    SELECT a FROM t ORDER BY a LIMIT 1
}

test body-uses-a-parameter-that-the-function-does-not-have {
    CREATE FUNCTION add(integer) RETURNS integer LANGUAGE sql AS $$SELECT $1 + $2$$;
}
@sqlstate 42P02
expect error {
    there is no parameter \$2
}

# PostgreSQL gives the first error that it finds in the query, and it reads
# the FROM clause first.
test body-with-a-table-and-a-parameter-that-do-not-exist {
    CREATE FUNCTION one(integer) RETURNS integer LANGUAGE sql AS $$SELECT $2 FROM nosuch$$;
}
@sqlstate 42P01
expect error {
    relation "nosuch" does not exist
}
@sqlstate 42P01
expect @tursopg error {
    no such table: nosuch
}

# tursopg compiles the body before it checks the parameters, so it gives the
# error of the column also when the parameter comes first in the query.
test body-with-a-parameter-and-then-a-column-that-do-not-exist {
    CREATE TABLE t (a integer);
    CREATE FUNCTION one(integer) RETURNS integer LANGUAGE sql AS $$SELECT $2 + nosuch FROM t$$;
}
@sqlstate 42P02
expect error {
    there is no parameter \$2
}
@sqlstate 42703
expect @tursopg error {
    no such column: nosuch
}

test body-uses-a-parameter-that-the-function-does-not-have-in-limit {
    CREATE FUNCTION one(integer) RETURNS integer LANGUAGE sql AS $$SELECT 1 LIMIT $2$$;
}
@sqlstate 42P02
expect error {
    there is no parameter \$2
}

test body-returns-two-columns {
    CREATE FUNCTION pair() RETURNS integer LANGUAGE sql AS $$SELECT 1, 2$$;
}
@sqlstate 42P13
expect error {
    return type mismatch in function declared to return integer
}

test body-returns-the-two-columns-of-a-table {
    CREATE TABLE t (a integer, b integer);
    CREATE FUNCTION first_row() RETURNS integer LANGUAGE sql AS $$SELECT * FROM t$$;
}
@sqlstate 42P13
expect error {
    return type mismatch in function declared to return integer
}

test body-returns-no-column {
    CREATE FUNCTION nothing() RETURNS integer LANGUAGE sql AS $$SELECT$$;
}
@sqlstate 42P13
expect error {
    return type mismatch in function declared to return integer
}

test body-is-empty {
    CREATE FUNCTION nothing() RETURNS integer LANGUAGE sql AS $$ $$;
}
@sqlstate 42P13
expect error {
    return type mismatch in function declared to return integer
}

# PostgreSQL rejects a result that has no assignment cast to the return type.
# tursopg does not know the types of expressions, so it accepts the function.
test body-returns-another-type {
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 'one'::text$$;
}
@sqlstate 42P13
expect error {
    return type mismatch in function declared to return integer
}
expect @tursopg {
}

# pg_dump turns check_function_bodies off, because it writes a function
# before the tables that the body reads.
test body-is-not-checked-when-check-function-bodies-is-off {
    SHOW check_function_bodies;
    SET check_function_bodies = off;
    CREATE FUNCTION first_a() RETURNS integer LANGUAGE sql AS $$SELECT a FROM t LIMIT 1$$;
    CREATE TABLE t (a integer);
    SELECT proname FROM pg_proc WHERE proname = 'first_a';
    SHOW check_function_bodies;
}
expect {
    on
    first_a
    off
}

test body-is-checked-after-check-function-bodies-is-reset {
    SET check_function_bodies = off;
    RESET check_function_bodies;
    CREATE FUNCTION first_a() RETURNS integer LANGUAGE sql AS $$SELECT a FROM nosuch$$;
}
@sqlstate 42P01
expect error {
    relation "nosuch" does not exist
}
@sqlstate 42P01
expect @tursopg error {
    no such table: nosuch
}

# tursopg reads the body when it stores the function, so it also refuses a
# body with a syntax error when check_function_bodies is off. PostgreSQL
# finds the error when the function is called.
test body-with-a-syntax-error-when-check-function-bodies-is-off {
    SET check_function_bodies = off;
    CREATE FUNCTION bad() RETURNS integer LANGUAGE sql AS $$SELEC 1$$;
    SELECT proname FROM pg_proc WHERE proname = 'bad';
}
expect {
    bad
}
@sqlstate 42601
expect @tursopg error {
    syntax error at or near "SELEC"
}

test check-function-bodies-set-local-ends-with-the-transaction {
    BEGIN;
    SET LOCAL check_function_bodies = off;
    SHOW check_function_bodies;
    COMMIT;
    SHOW check_function_bodies;
}
expect {
    off
    on
}

test check-function-bodies-with-a-value-that-is-not-boolean {
    SET check_function_bodies = sometimes;
}
@sqlstate 22023
expect error {
    parameter "check_function_bodies" requires a Boolean value
}

# The value of a Boolean parameter cannot have spaces around it, but a cast
# of text to boolean ignores them.
test check-function-bodies-with-a-space-before-the-value {
    SET check_function_bodies = ' off';
}
@sqlstate 22023
expect error {
    parameter "check_function_bodies" requires a Boolean value
}

test check-function-bodies-with-a-space-after-the-value {
    SELECT set_config('check_function_bodies', 'off ', false);
}
@sqlstate 22023
expect error {
    parameter "check_function_bodies" requires a Boolean value
}

test check-function-bodies-with-the-start-of-a-boolean-word {
    SET check_function_bodies = 'OF';
    SHOW check_function_bodies;
    SET check_function_bodies = 'T';
    SHOW check_function_bodies;
    SET check_function_bodies = 0;
    SHOW check_function_bodies;
}
expect {
    off
    on
    off
}

# PostgreSQL makes the catalog checks before it checks the body.
test function-that-exists-with-a-body-that-does-not-compile {
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT a FROM nosuch$$;
}
@sqlstate 42723
expect error {
    function "one" already exists with same argument types
}

test function-in-a-schema-that-does-not-exist-with-a-body-that-does-not-compile {
    CREATE FUNCTION nosuch.one() RETURNS integer LANGUAGE sql AS $$SELECT a FROM nosuch$$;
}
@sqlstate 3F000
expect error {
    schema "nosuch" does not exist
}

test replace-with-another-return-type-and-a-body-that-does-not-compile {
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    CREATE OR REPLACE FUNCTION one() RETURNS text LANGUAGE sql AS $$SELECT a FROM nosuch$$;
}
@sqlstate 42P13
expect error {
    cannot change return type of existing function
}

# PostgreSQL has the type point, so it creates the function and checks the
# body. tursopg refuses the type, but an error of the body comes first, as
# in PostgreSQL.
test function-with-a-type-that-is-not-supported-and-a-body-that-does-not-compile {
    CREATE FUNCTION far(point) RETURNS integer LANGUAGE sql AS $$SELECT a FROM nosuch$$;
}
@sqlstate 42P01
expect error {
    relation "nosuch" does not exist
}
@sqlstate 42P01
expect @tursopg error {
    no such table: nosuch
}

# PostgreSQL does not check the body of a function that exists already: it
# gives an error for the function first. Thus tursopg does not give the error
# of the body. It refuses the type.
test function-that-exists-with-a-result-type-that-is-not-supported-and-a-body-that-does-not-compile {
    CREATE FUNCTION far() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    CREATE FUNCTION far() RETURNS point LANGUAGE sql AS $$SELECT a FROM nosuch$$;
}
@sqlstate 42723
expect error {
    function "far" already exists with same argument types
}
@sqlstate 0A000
expect @tursopg error {
    a function result of type point is not supported
}

test replaced-function-with-a-result-type-that-is-not-supported-and-a-body-that-does-not-compile {
    CREATE FUNCTION far() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    CREATE OR REPLACE FUNCTION far() RETURNS point LANGUAGE sql AS $$SELECT a FROM nosuch$$;
}
@sqlstate 42P13
expect error {
    cannot change return type of existing function
}
@sqlstate 0A000
expect @tursopg error {
    a function result of type point is not supported
}

test function-with-a-type-that-is-not-supported-when-check-function-bodies-is-off {
    SET check_function_bodies = off;
    CREATE FUNCTION far(point) RETURNS integer LANGUAGE sql AS $$SELECT a FROM nosuch$$;
    SELECT count(*) FROM pg_proc WHERE proname = 'far';
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    a function parameter of type point is not supported
}

# Features that tursopg does not support

# PostgreSQL stores a function before it checks the body, so the check finds
# a call of the new function. tursopg checks the body before it stores the
# function.
test function-that-calls-itself {
    CREATE FUNCTION forever(integer) RETURNS integer LANGUAGE sql AS $$SELECT forever($1)$$;
    SELECT count(*) FROM pg_proc WHERE proname = 'forever';
}
expect {
    1
}
@sqlstate 42883
expect @tursopg error {
    no such function: forever
}

# PostgreSQL accepts these bodies. tursopg cannot compile them, so it refuses
# the function when it is created, with the error that the query gets as a
# statement.
test body-with-a-clause-that-is-not-supported {
    CREATE TABLE items (id integer);
    CREATE FUNCTION locked() RETURNS integer LANGUAGE sql AS $$SELECT id FROM items FOR UPDATE$$;
    SELECT count(*) FROM pg_proc WHERE proname = 'locked';
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    SELECT ... FOR UPDATE / FOR SHARE is not supported
}

test body-with-a-built-in-function-that-tursopg-does-not-have {
    CREATE FUNCTION type_name() RETURNS text LANGUAGE sql AS $$SELECT pg_typeof(1)::text$$;
    SELECT count(*) FROM pg_proc WHERE proname = 'type_name';
}
expect {
    1
}
@sqlstate 42883
expect @tursopg error {
    no such function: pg_typeof
}

test body-with-a-clause-that-is-not-supported-when-check-function-bodies-is-off {
    SET check_function_bodies = off;
    CREATE TABLE items (id integer);
    CREATE FUNCTION locked() RETURNS integer LANGUAGE sql AS $$SELECT id FROM items FOR UPDATE$$;
    SELECT count(*) FROM pg_proc WHERE proname = 'locked';
}
expect {
    1
}

# tursopg cannot call a stored function yet, so the check of a body that
# calls one fails.
test body-that-calls-a-stored-function {
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    CREATE FUNCTION two() RETURNS integer LANGUAGE sql AS $$SELECT one() + 1$$;
    SELECT count(*) FROM pg_proc WHERE proname IN ('one', 'two');
}
expect {
    2
}
@sqlstate 42883
expect @tursopg error {
    no such function: one
}

test body-that-calls-a-stored-function-when-check-function-bodies-is-off {
    SET check_function_bodies = off;
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    CREATE FUNCTION two() RETURNS integer LANGUAGE sql AS $$SELECT one() + 1$$;
    SELECT count(*) FROM pg_proc WHERE proname IN ('one', 'two');
}
expect {
    2
}

# tursopg cannot call a function of a schema yet.
test function-that-calls-a-function-of-its-name-in-another-schema {
    CREATE SCHEMA app;
    CREATE FUNCTION app.one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT app.one()$$;
    SELECT count(*) FROM pg_proc WHERE proname = 'one';
}
expect {
    2
}
@sqlstate 0A000
expect @tursopg error {
    a schema-qualified function name is not supported
}

test replaced-function-that-calls-itself {
    CREATE FUNCTION forever(integer) RETURNS integer LANGUAGE sql AS $$SELECT $1$$;
    CREATE OR REPLACE FUNCTION forever(integer) RETURNS integer LANGUAGE sql AS $$SELECT forever($1)$$;
    SELECT prosrc FROM pg_proc WHERE proname = 'forever';
}
expect {
    SELECT forever($1)
}
@sqlstate 42883
expect @tursopg error {
    no such function: forever
}

# In PostgreSQL a table and a function of one schema can have the same name.
test function-with-the-name-of-a-table {
    CREATE TABLE item (a integer);
    CREATE FUNCTION item() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    SELECT count(*) FROM pg_proc WHERE proname = 'item';
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    a function with the name of relation "item" of the same schema is not supported
}

test table-with-the-name-of-a-function {
    CREATE FUNCTION item() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    CREATE TABLE item (a integer);
    SELECT count(*) FROM item;
}
expect {
    0
}
@sqlstate 0A000
expect @tursopg error {
    a relation with the name of function "item" of the same schema is not supported
}

test view-with-the-name-of-a-function {
    CREATE FUNCTION item() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    CREATE VIEW item AS SELECT 1 AS a;
    SELECT a FROM item;
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    a relation with the name of function "item" of the same schema is not supported
}

test table-renamed-to-the-name-of-a-function {
    CREATE FUNCTION item() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    CREATE TABLE thing (a integer);
    ALTER TABLE thing RENAME TO item;
    SELECT count(*) FROM item;
}
expect {
    0
}
@sqlstate 0A000
expect @tursopg error {
    a relation with the name of function "item" of the same schema is not supported
}

test table-and-function-with-the-same-name-in-two-schemas {
    CREATE SCHEMA app;
    CREATE TABLE item (a integer);
    CREATE FUNCTION app.item() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    SELECT count(*) FROM pg_proc WHERE proname = 'item';
}
expect {
    1
}

# A relation can have the text of a function's signature as its name.
test table-with-the-signature-of-a-function-as-its-name {
    CREATE TABLE "one()" (a integer);
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    CREATE FUNCTION two() RETURNS integer LANGUAGE sql AS $$SELECT 2$$;
    CREATE VIEW "two()" AS SELECT 2 AS a;
    SELECT count(*) FROM pg_proc WHERE proname IN ('one', 'two');
    SELECT count(*) FROM "one()";
    SELECT a FROM "two()";
}
expect {
    2
    0
    2
}

# tursopg has fewer base types than PostgreSQL.
test parameter-of-a-base-type-that-tursopg-does-not-have {
    CREATE FUNCTION cents(money) RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    SELECT pronargs FROM pg_proc WHERE proname = 'cents';
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    a function parameter of type money is not supported
}

test result-of-a-base-type-that-tursopg-does-not-have {
    CREATE FUNCTION origin() RETURNS point LANGUAGE sql AS $$SELECT '(0,0)'::point$$;
    SELECT pronargs FROM pg_proc WHERE proname = 'origin';
}
expect {
    0
}
@sqlstate 0A000
expect @tursopg error {
    a function result of type point is not supported
}

# ALTER FUNCTION

test alter-function {
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    ALTER FUNCTION one() IMMUTABLE;
    SELECT provolatile FROM pg_proc WHERE proname = 'one';
}
expect {
    i
}
@sqlstate 0A000
expect @tursopg error {
    ALTER FUNCTION is not supported
}

test alter-function-rename {
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    ALTER FUNCTION one() RENAME TO uno;
    SELECT count(*) FROM pg_proc WHERE proname = 'uno';
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    ALTER FUNCTION is not supported
}

test alter-function-owner {
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    ALTER FUNCTION one() OWNER TO CURRENT_USER;
    SELECT count(*) FROM pg_proc WHERE proname = 'one';
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    ALTER FUNCTION is not supported
}

test alter-function-set-schema {
    CREATE SCHEMA app;
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    ALTER FUNCTION one() SET SCHEMA app;
    SELECT n.nspname FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
    WHERE p.proname = 'one';
}
expect {
    app
}
@sqlstate 0A000
expect @tursopg error {
    ALTER FUNCTION is not supported
}

test alter-routine {
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    ALTER ROUTINE one() IMMUTABLE;
    SELECT provolatile FROM pg_proc WHERE proname = 'one';
}
expect {
    i
}
@sqlstate 0A000
expect @tursopg error {
    ALTER ROUTINE is not supported
}

# DROP SCHEMA

test drop-schema-with-a-function {
    CREATE SCHEMA app;
    CREATE FUNCTION app.one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    DROP SCHEMA app;
}
@sqlstate 2BP01
expect error {
    cannot drop schema app because other objects depend on it
}
@sqlstate 2BP01
expect @tursopg error {
    cannot drop schema "app" because other objects depend on it
}

test drop-schema-cascade-with-functions {
    CREATE SCHEMA app;
    CREATE TABLE app.t (a integer);
    CREATE FUNCTION app.one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    CREATE FUNCTION app.one(integer) RETURNS integer LANGUAGE sql AS $$SELECT $1$$;
    CREATE FUNCTION one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    DROP SCHEMA app CASCADE;
    SELECT n.nspname, p.pronargs FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
    WHERE p.proname = 'one';
    SELECT count(*) FROM pg_namespace WHERE nspname = 'app';
}
expect {
    public|0
    0
}

# The names of the functions of a dropped schema are free again.
test create-function-in-a-schema-that-was-dropped-with-its-functions {
    CREATE SCHEMA app;
    CREATE FUNCTION app.one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    DROP SCHEMA app CASCADE;
    CREATE SCHEMA app;
    CREATE FUNCTION app.one() RETURNS integer LANGUAGE sql AS $$SELECT 2$$;
    SELECT prosrc FROM pg_proc WHERE proname = 'one';
}
expect {
    SELECT 2
}

test drop-schema-after-its-function {
    CREATE SCHEMA app;
    CREATE FUNCTION app.one() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;
    DROP FUNCTION app.one();
    DROP SCHEMA app;
    SELECT count(*) FROM pg_namespace WHERE nspname = 'app';
}
expect {
    0
}
