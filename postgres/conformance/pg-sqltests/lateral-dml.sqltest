@database :memory:

# LATERAL subqueries in INSERT, UPDATE, DELETE, RETURNING, views,
# triggers and after ALTER TABLE ... RENAME.
# The statements run only through the PostgreSQL frontend (tursopg).
# PostgreSQL 16 gave every expected result.
# Tests with the same SQL for both frontends are in
# testing/shared-sqltests/lateral-dml.sqltest.

setup data {
    CREATE TABLE t1(a INT, b TEXT);
    CREATE TABLE t2(a INT, c INT, d TEXT);
    CREATE TABLE t4(a INT PRIMARY KEY, v INT);
    INSERT INTO t1 VALUES (1, 'p'), (2, 'q'), (3, 'r'), (4, 's');
    INSERT INTO t2 VALUES (1, 10, 'x'), (2, 20, 'y'), (2, 30, 'z'), (3, 40, 'w'), (5, 50, 'v');
    INSERT INTO t4 VALUES (1, 0), (2, 0), (3, 0), (4, 0);
}

@setup data
test update-from-lateral-cannot-read-the-target-table-by-its-alias {
    UPDATE t4 AS z SET v = s.x FROM LATERAL (SELECT z.a * 2 AS x) AS s;
}
@sqlstate 42P10
expect error {
    invalid reference to FROM-clause entry for table "z"
}

@setup data
test update-from-lateral-function-cannot-read-the-target-table {
    UPDATE t4 SET v = s.x FROM t1, LATERAL generate_series(1, t4.a) AS s(x) WHERE t1.a = t4.a;
}
@sqlstate 42P10
expect error {
    invalid reference to FROM-clause entry for table "t4"
}

@setup data
test update-from-lateral-cannot-read-the-target-table-in-a-nested-subquery {
    UPDATE t4 SET v = s.x FROM LATERAL (SELECT * FROM (SELECT t4.a AS x) AS q) AS s;
}
@sqlstate 42P10
expect error {
    invalid reference to FROM-clause entry for table "t4"
}

@setup data
test update-from-subquery-cannot-see-the-target-table-in-its-lateral-item {
    UPDATE t4 SET v = s.x FROM (SELECT * FROM t1, LATERAL (SELECT t4.a AS x) AS q) AS s;
}
@sqlstate 42P01
expect error {}

@setup data
test update-from-function-without-lateral-cannot-read-the-target-table {
    UPDATE t4 SET v = s.x FROM generate_series(1, t4.a) AS s(x);
}
@sqlstate 42P10
expect error {
    invalid reference to FROM-clause entry for table "t4"
}

@setup data
test update-from-join-with-lateral-cannot-read-the-target-table {
    UPDATE t4 SET v = s.x FROM t1 JOIN LATERAL (SELECT t4.a AS x) AS s ON true;
}
@sqlstate 42P10
expect error {
    invalid reference to FROM-clause entry for table "t4"
}

@setup data
test update-from-lateral-reads-its-own-table-with-the-name-of-the-target {
    UPDATE t4 SET v = s.x FROM LATERAL (SELECT max(t4.a) AS x FROM t4) AS s;
    SELECT a, v FROM t4 ORDER BY 1;
}
expect {
    1|4
    2|4
    3|4
    4|4
}
