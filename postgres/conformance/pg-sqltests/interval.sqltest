test interval-age {
    SELECT age(timestamp '2001-04-10 12:00:00.5', timestamp '2000-02-14 14:30:16');
    SELECT age(timestamp '2000-02-14', timestamp '2001-04-10');
}
expect {
    1 year 1 mon 24 days 21:29:44.5
    -1 years -1 mons -25 days
}

# tursopg has no + operator for a timestamp and an interval.
test interval-plus-timestamp {
    SELECT timestamp '2020-01-01' + interval '1 day';
}
expect {
    2020-01-02 00:00:00
}
expect @tursopg error {
    operator does not exist: timestamp \+ interval
}

test interval-catalog {
    CREATE TABLE r (iv interval);
    SELECT a.atttypid FROM pg_attribute a JOIN pg_class c ON a.attrelid = c.oid WHERE c.relname = 'r' AND a.attname = 'iv';
    SELECT typname, typlen, typarray FROM pg_type WHERE oid = 1186;
    SELECT typname, typelem FROM pg_type WHERE oid = 1187;
}
expect {
    1186
    interval|16|1187
    _interval|1186
}

test interval-array {
    CREATE TABLE a (iv interval[]);
    INSERT INTO a VALUES (ARRAY[interval '1 day']);
    SELECT iv FROM a;
}
expect {
    {"1 day"}
}
@sqlstate 0A000
expect @tursopg error {
    an array of type interval, whose elements
}
