test interval-infinite-values-are-refused {
    SELECT '178956970 years 7 mons 2147483647 days 2562047788:00:54.775807'::interval;
}
expect {
    infinity
}
@sqlstate 0A000
expect @tursopg error {
    the interval of 2147483647 months, 2147483647 days and 9223372036854775807 microseconds is not supported
}

