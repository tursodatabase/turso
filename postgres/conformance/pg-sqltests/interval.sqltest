test interval-type-modifier {
    CREATE TABLE tm (iv interval(3));
    INSERT INTO tm VALUES ('1.123456 seconds');
    SELECT iv FROM tm;
}
expect {
    00:00:01.123
}
@sqlstate 0A000
expect @tursopg error {
    a type modifier on interval is not supported
}

test interval-field-qualifier {
    CREATE TABLE tf (iv interval day);
    INSERT INTO tf VALUES ('1 day 02:00');
    SELECT iv FROM tf;
}
expect {
    1 day
}
@sqlstate 0A000
expect @tursopg error {
    a type modifier on interval is not supported
}

test interval-literal-field-qualifier {
    SELECT INTERVAL '1' DAY;
}
expect {
    1 day
}
@sqlstate 0A000
expect @tursopg error {
    a type modifier in a cast is not supported
}

# tursopg gives the same 0A000 for input PostgreSQL rejects as for forms it
# does not read.
test interval-invalid-input {
    SELECT 'abc'::interval;
}
@sqlstate 22007
expect error {
    invalid input syntax for type interval: "abc"
}
@sqlstate 0A000
expect @tursopg error {
    interval input form "abc" is not supported
}

