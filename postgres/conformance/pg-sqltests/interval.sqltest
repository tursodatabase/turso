# The interval type: input, output, comparison, casts and functions. The
# session time zone is UTC on both servers.
#
# Where tursopg refuses something PostgreSQL does, the default block shows
# PostgreSQL's result and an `expect @tursopg error` block shows the refusal.

@database :memory:

# tursopg reads PostgreSQL's output form and `[+-]N unit` sequences, and
# refuses every other form with 0A000.
test interval-accepted-forms {
    CREATE TABLE r (id int, iv interval);
    INSERT INTO r VALUES (1, '1 day 6:00:00'), (2, '-1 day 23:59:58.500000'), (3, '0:00:00'), (4, '1 years 2 mons 3 days 04:05:06.5');
    INSERT INTO r VALUES (5, '1 days 6 hours'), (6, '0'), (7, '1 mon 2 day 03:04:05.000006'), (8, '-00:00:01.500000'), (9, '30:00:00');
    INSERT INTO r VALUES (10, '1 hour -30 minutes'), (11, '-1 years -2 mons +3 days -04:05:06'), (12, '2 weeks 5 milliseconds 6 microseconds'), (13, '-5 seconds');
    SELECT id, iv, CAST(iv AS text) FROM r ORDER BY id;
}
expect {
    1|1 day 06:00:00|1 day 06:00:00
    2|-1 days +23:59:58.5|-1 days +23:59:58.5
    3|00:00:00|00:00:00
    4|1 year 2 mons 3 days 04:05:06.5|1 year 2 mons 3 days 04:05:06.5
    5|1 day 06:00:00|1 day 06:00:00
    6|00:00:00|00:00:00
    7|1 mon 2 days 03:04:05.000006|1 mon 2 days 03:04:05.000006
    8|-00:00:01.5|-00:00:01.5
    9|30:00:00|30:00:00
    10|00:30:00|00:30:00
    11|-1 years -2 mons +3 days -04:05:06|-1 years -2 mons +3 days -04:05:06
    12|14 days 00:00:00.005006|14 days 00:00:00.005006
    13|-00:00:05|-00:00:05
}

test interval-fraction-of-a-second-unit {
    SELECT '-1 days 86398.500000 seconds'::interval;
}
expect {
    -1 days +23:59:58.5
}
@sqlstate 0A000
expect @tursopg error {
    interval input form "-1 days 86398.500000 seconds" is not supported
}

test interval-ago {
    SELECT '1 day ago'::interval;
}
expect {
    -1 days
}
@sqlstate 0A000
expect @tursopg error {
    interval input form "1 day ago" is not supported
}

test interval-abbreviated-unit {
    SELECT '2 hr 3 m'::interval;
}
expect {
    02:03:00
}
@sqlstate 0A000
expect @tursopg error {
    interval input form "2 hr 3 m" is not supported
}

# Intervals compare by length, with a month of 30 days.
test interval-compares-by-length {
    CREATE TABLE c (id int, iv interval);
    INSERT INTO c VALUES (1, '1 day'), (2, '24 hours'), (3, '1 mon'), (4, '30 days'), (5, '31 days');
    SELECT a.id, b.id FROM c a JOIN c b ON a.iv = b.iv AND a.id < b.id ORDER BY a.id;
    SELECT id FROM c WHERE iv > '1 mon' ORDER BY id;
    SELECT id FROM c WHERE iv = interval '86400 seconds' ORDER BY id;
}
expect {
    1|2
    3|4
    5
    1
    2
}

test interval-order-by {
    CREATE TABLE o (iv interval);
    INSERT INTO o VALUES ('31 days'), ('1 mon 2 days'), ('-1 day'), ('00:00:01'), ('1 year'), ('-1 mon');
    SELECT iv FROM o ORDER BY iv;
    SELECT iv FROM o ORDER BY iv DESC LIMIT 2;
}
expect {
    -1 mons
    -1 days
    00:00:01
    31 days
    1 mon 2 days
    1 year
    1 year
    1 mon 2 days
}

test interval-unique-compares-by-length {
    CREATE TABLE u (iv interval UNIQUE);
    INSERT INTO u VALUES ('1 mon');
    INSERT INTO u VALUES ('30 days');
}
@sqlstate 23505
expect error {
    duplicate key value violates unique constraint
}

test interval-primary-key-compares-by-length {
    CREATE TABLE p (iv interval PRIMARY KEY);
    INSERT INTO p VALUES ('1 day');
    INSERT INTO p VALUES ('24 hours');
}
@sqlstate 23505
expect error {
    duplicate key value violates unique constraint
}

test interval-index-lookup {
    CREATE TABLE s (id int, iv interval);
    CREATE INDEX s_iv ON s (iv);
    INSERT INTO s VALUES (1, '1 day'), (2, '2 days'), (3, '1 hour');
    SELECT id FROM s WHERE iv = '24 hours';
    SELECT id FROM s WHERE iv > '23 hours' ORDER BY id;
}
expect {
    1
    1
    2
}

test interval-group-by {
    CREATE TABLE g (iv interval);
    INSERT INTO g VALUES ('1 day'), ('24 hours'), ('2 days'), ('48:00:00'), ('1 hour'), ('25 hours');
    SELECT count(*) FROM g GROUP BY iv ORDER BY count(*), min(iv);
    SELECT count(DISTINCT iv) FROM g;
}
expect {
    1
    1
    2
    2
    4
}

test interval-min-max {
    CREATE TABLE o (iv interval);
    INSERT INTO o VALUES ('31 days'), ('1 mon 1 day'), ('-1 day'), ('1 year'), ('-1 mon');
    SELECT min(iv), max(iv) FROM o;
}
expect {
    -1 mons|1 year
}

test interval-coalesce {
    SELECT coalesce(NULL::interval, '24 hours');
}
expect {
    24:00:00
}
@sqlstate 0A000
expect @tursopg error {
    function coalesce\(interval, text\) is not supported
}

test interval-nullif {
    SELECT nullif(interval '1 day', interval '24 hours') IS NULL;
}
expect {
    t
}
@sqlstate 0A000
expect @tursopg error {
    function nullif\(interval, interval\) is not supported
}

test interval-like {
    CREATE TABLE o (iv interval);
    SELECT iv LIKE '%day%' FROM o;
}
@sqlstate 42883
expect error {
    operator does not exist: interval ~~ unknown
}
# tursopg runs PostgreSQL's case-sensitive LIKE as GLOB.
@sqlstate 0A000
expect @tursopg error {
    function glob\(text, interval\) is not supported
}

test interval-cast-to-text-before-like {
    CREATE TABLE o (id int, iv interval);
    INSERT INTO o VALUES (1, '1 day'), (2, '1 mon');
    SELECT id FROM o WHERE iv::text LIKE '%day%';
}
expect {
    1
}

test interval-sum {
    CREATE TABLE o (iv interval);
    INSERT INTO o VALUES ('1 day'), ('2 hours');
    SELECT sum(iv) FROM o;
}
expect {
    1 day 02:00:00
}
@sqlstate 0A000
expect @tursopg error {
    function sum\(interval\) is not supported
}

test interval-avg {
    CREATE TABLE o (iv interval);
    INSERT INTO o VALUES ('1 day'), ('2 hours');
    SELECT avg(iv) FROM o;
}
expect {
    13:00:00
}
@sqlstate 0A000
expect @tursopg error {
    function avg\(interval\) is not supported
}

test interval-abs {
    CREATE TABLE o (iv interval);
    SELECT abs(iv) FROM o;
}
@sqlstate 42883
expect error {
    function abs\(interval\) does not exist
}
@sqlstate 0A000
expect @tursopg error {
    function abs\(interval\) is not supported
}

# tursopg creates the table and refuses the CHECK when a row is written.
test interval-check-calling-abs-is-refused {
    CREATE TABLE c1 (iv interval, CHECK (abs(iv) IS NOT NULL));
    INSERT INTO c1 VALUES ('1 day');
}
@sqlstate 42883
expect error {
    function abs\(interval\) does not exist
}
@sqlstate 0A000
expect @tursopg error {
    function abs\(interval\) is not supported
}

test interval-column-check-calling-length-is-refused {
    CREATE TABLE c2 (id int, iv interval CHECK (length(iv) > 0));
    INSERT INTO c2 VALUES (1, '1 day');
}
@sqlstate 42883
expect error {
    function length\(interval\) does not exist
}
@sqlstate 0A000
expect @tursopg error {
    function length\(interval\) is not supported
}

test interval-casts {
    SELECT CAST('1 day' AS interval), '1 day'::interval, interval '1 day', CAST(interval '1 day' AS text), '25 hours'::interval::text;
}
expect {
    1 day|1 day|1 day|1 day|25:00:00
}

test interval-cast-from-integer {
    SELECT 42::interval;
}
@sqlstate 42846
expect error {
    cannot cast type integer to interval
}
@sqlstate 0A000
expect @tursopg error {
    cast from integer to interval is not supported
}

test interval-cast-to-integer {
    SELECT interval '1 day'::integer;
}
@sqlstate 42846
expect error {
    cannot cast type interval to integer
}
@sqlstate 0A000
expect @tursopg error {
    cast from interval to integer is not supported
}

test interval-cast-to-time {
    SELECT interval '1 day 01:00'::time;
}
expect {
