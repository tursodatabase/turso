# SQLite built-ins are not available in tursopg. Core has the built-in
# functions of SQLite and Turso, such as typeof and iif, and the functions
# of the extensions that Turso has built in, such as uuid4. tursopg has
# only those that PostgreSQL also has. A call to another one fails with
# SQLSTATE 42883, as a call to an unknown function fails in PostgreSQL.
# Each test gives the arguments that the function takes.

@database :memory:

# SQLite's scalar functions. COALESCE, NULLIF and TRIM are PostgreSQL
# syntax, and only their quoted names call a function.

test changes-is-not-available {
    SELECT changes();
}
@sqlstate 42883
expect error {}

test coalesce-is-not-available {
    SELECT "coalesce"(NULL, 1);
}
@sqlstate 42883
expect error {}

test glob-is-not-available {
    SELECT glob('a*', 'abc');
}
@sqlstate 42883
expect error {}

test hex-is-not-available {
    SELECT hex('a');
}
@sqlstate 42883
expect error {}

test if-is-not-available {
    SELECT if(true, 1, 2);
}
@sqlstate 42883
expect error {}

test ifnull-is-not-available {
    SELECT ifnull(NULL, 1);
}
@sqlstate 42883
expect error {}

test iif-is-not-available {
    SELECT iif(true, 1, 2);
}
@sqlstate 42883
expect error {}

