# SQLite's JSON functions. PostgreSQL reads json(...) and
# json_array(...) as syntax, and casts a text literal with jsonb(...), so
# these tests call json and json_array by their quoted names and give
# json and jsonb an integer, which PostgreSQL cannot cast.

test json-is-not-available {
    SELECT "json"(1);
}
@sqlstate 42883
expect error {}

test json-array-is-not-available {
    SELECT "json_array"(1, 2);
}
@sqlstate 42883
expect error {}

test json-error-position-is-not-available {
    SELECT json_error_position('[1');
}
@sqlstate 42883
expect error {}

test json-extract-is-not-available {
    SELECT json_extract('{"a": 1}', '$.a');
}
@sqlstate 42883
expect error {}

test json-group-array-is-not-available {
    SELECT json_group_array(1);
}
@sqlstate 42883
expect error {}

test json-group-object-is-not-available {
    SELECT json_group_object('a', 1);
}
@sqlstate 42883
expect error {}

test json-insert-is-not-available {
    SELECT json_insert('{}', '$.a', 1);
}
@sqlstate 42883
expect error {}

test json-patch-is-not-available {
    SELECT json_patch('{}', '{"a": 1}');
}
@sqlstate 42883
expect error {}

test json-pretty-is-not-available {
    SELECT json_pretty('{}');
}
@sqlstate 42883
expect error {}

test json-quote-is-not-available {
    SELECT json_quote('a');
}
@sqlstate 42883
expect error {}

test json-remove-is-not-available {
    SELECT json_remove('{"a": 1}', '$.a');
}
@sqlstate 42883
expect error {}

test json-replace-is-not-available {
    SELECT json_replace('{"a": 1}', '$.a', 2);
}
@sqlstate 42883
expect error {}

test json-set-is-not-available {
    SELECT json_set('{}', '$.a', 1);
}
@sqlstate 42883
expect error {}

test json-type-is-not-available {
    SELECT json_type('{}');
}
@sqlstate 42883
expect error {}

test json-valid-is-not-available {
    SELECT json_valid('{}');
}
@sqlstate 42883
expect error {}

test jsonb-is-not-available {
    SELECT jsonb(1);
}
@sqlstate 42883
expect error {}

test jsonb-array-is-not-available {
    SELECT jsonb_array(1);
}
@sqlstate 42883
expect error {}

test jsonb-extract-is-not-available {
    SELECT jsonb_extract('{"a": 1}', '$.a');
}
@sqlstate 42883
expect error {}

test jsonb-group-array-is-not-available {
    SELECT jsonb_group_array(1);
}
@sqlstate 42883
expect error {}

test jsonb-group-object-is-not-available {
    SELECT jsonb_group_object('a', 1);
}
@sqlstate 42883
expect error {}

test jsonb-patch-is-not-available {
    SELECT jsonb_patch('{}', '{"a": 1}');
}
@sqlstate 42883
expect error {}

test jsonb-remove-is-not-available {
    SELECT jsonb_remove('{"a": 1}', '$.a');
}
@sqlstate 42883
expect error {}

test jsonb-replace-is-not-available {
    SELECT jsonb_replace('{"a": 1}', '$.a', 2);
}
@sqlstate 42883
expect error {}

# Turso's array functions. The translator writes some of them for
# array syntax, such as array_element for a subscript.

