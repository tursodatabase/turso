# SET, SHOW, RESET and DISCARD ALL of configuration parameters through the
# PostgreSQL frontend.

@database :memory:

test set-and-show-custom-parameter {
    SET app.user_id = '42';
    SHOW app.user_id;
    SET app.user_id TO 43;
    SHOW app.user_id;
    SET app.user_id = some_name;
    SHOW app.user_id;
    SELECT current_setting('app.user_id');
}
expect {
    42
    43
    some_name
    some_name
}

test set-custom-parameter-name-is-not-case-sensitive {
    SET "App.Mixed_Case" = 'v';
    SHOW app.mixed_case;
}
expect {
    v
}

test set-custom-parameter-with-two-values-errors {
    SET app.list = a, b;
}
@sqlstate 22023
expect error {
    SET app\.list takes only one argument
}

test show-custom-parameter-set-by-set-config {
    SELECT set_config('app.from_function', 'v', false);
    SHOW app.from_function;
}
expect {
    v
    v
}

test show-undefined-custom-parameter-errors {
    SHOW app.never_set;
}
@sqlstate 42704
expect error {
    unrecognized configuration parameter "app\.never_set"
}

test set-local-custom-parameter-ends-at-commit {
    SET app.mode = 'session';
    BEGIN;
    SET LOCAL app.mode = 'local';
    SHOW app.mode;
    COMMIT;
    SHOW app.mode;
}
expect {
    local
    session
}

test set-custom-parameter-is-undone-by-rollback {
    SET app.mode = 'before';
    BEGIN;
    SET app.mode = 'in transaction';
    ROLLBACK;
    SHOW app.mode;
}
expect {
    before
}

test reset-custom-parameter {
    SET app.mode = 'v';
    RESET app.mode;
    SELECT quote_literal(current_setting('app.mode'));
    SET app.mode = 'w';
    SET app.mode TO DEFAULT;
    SELECT quote_literal(current_setting('app.mode'));
    SET app.mode = 'x';
    SET app.mode = DEFAULT;
    SELECT quote_literal(current_setting('app.mode'));
}
expect {
    ''
    ''
    ''
}

test reset-defines-a-custom-parameter-that-was-never-set {
    RESET app.never_set;
    SELECT quote_literal(current_setting('app.never_set'));
}
expect {
    ''
}

test set-from-current-keeps-the-current-value {
    SET app.v = 'q';
    BEGIN;
    SET LOCAL app.v FROM CURRENT;
    SHOW app.v;
    COMMIT;
    SHOW app.v;
    SET search_path = a, "B c";
    SET search_path FROM CURRENT;
    SHOW search_path;
}
expect {
    q
    q
    a, "B c"
}

test set-from-current-makes-a-local-value-the-session-value {
    SET app.v = 'session';
    BEGIN;
    SET LOCAL app.v = 'local';
    SET app.v FROM CURRENT;
    COMMIT;
    SHOW app.v;
}
expect {
    local
}

test set-from-current-of-an-undefined-custom-parameter-errors {
    SET app.never_set FROM CURRENT;
}
@sqlstate 42704
expect error {
    unrecognized configuration parameter "app\.never_set"
}

test reset-search-path {
    SET search_path = other_schema;
    RESET search_path;
    SHOW search_path;
    SET search_path = other_schema;
    SET search_path TO DEFAULT;
    SHOW search_path;
}
expect {
    "$user", public
    "$user", public
}

test reset-local-search-path-ends-at-commit {
    SET search_path = other_schema;
    BEGIN;
    SET LOCAL search_path TO DEFAULT;
    SHOW search_path;
    COMMIT;
    SHOW search_path;
}
expect {
    "$user", public
    other_schema
}

test reset-all {
    SET app.a = 'a';
    SET search_path = other_schema;
    RESET ALL;
    SELECT quote_literal(current_setting('app.a'));
    SHOW search_path;
}
expect {
    ''
    "$user", public
}

test reset-all-also-resets-local-values {
    BEGIN;
    SET LOCAL app.a = 'local';
    RESET ALL;
    SELECT quote_literal(current_setting('app.a'));
    COMMIT;
}
expect {
    ''
}

test reset-all-is-undone-by-rollback {
    SET app.a = 'a';
    SET search_path = other_schema;
    BEGIN;
    RESET ALL;
    ROLLBACK;
    SHOW app.a;
    SHOW search_path;
}
expect {
    a
    other_schema
}

test discard-all-resets-parameters {
    SET app.a = 'a';
    SET search_path = other_schema;
    DISCARD ALL;
    SELECT quote_literal(current_setting('app.a'));
    SHOW search_path;
}
expect {
    ''
    "$user", public
}

test discard-all-forgets-currval {
    CREATE SEQUENCE discard_seq;
    SELECT nextval('discard_seq');
    DISCARD ALL;
    SELECT currval('discard_seq');
}
expect error {
    currval of sequence "discard_seq" is not yet defined in this session
}

test discard-all-inside-a-transaction-errors {
    BEGIN;
    DISCARD ALL;
}
@sqlstate 25001
expect error {
    DISCARD ALL cannot run inside a transaction block
}

test builtin-datestyle-apis-agree {
    SET DATESTYLE = ISO;
    SHOW DateStyle;
    SELECT pg_catalog.set_config('datestyle', 'iso', true);
    SELECT current_setting('DATESTYLE');
    SET datestyle = ISO, MDY;
    SHOW datestyle;
    RESET datestyle;
    SELECT set_config('datestyle', NULL, false);
    SET datestyle FROM CURRENT;
    SHOW datestyle;
}
expect {
    ISO, MDY
    ISO, MDY
    ISO, MDY
    ISO, MDY
    ISO, MDY
    ISO, MDY
}

test builtin-application-name-transaction-scope {
    SELECT CASE WHEN set_config('app.default_name', current_setting('application_name'), false) IS NOT NULL THEN 'yes' ELSE 'no' END;
    SET application_name = 'session';
    SELECT set_config('application_name', 'probe', true);
    SHOW application_name;
    BEGIN;
    SET LOCAL application_name = 'local';
    SHOW application_name;
    COMMIT;
    SHOW application_name;
    BEGIN;
    SET application_name = 'rolled back';
    ROLLBACK;
    SHOW application_name;
    SELECT CASE WHEN set_config('application_name', NULL, false) = current_setting('app.default_name') THEN 'yes' ELSE 'no' END;
    SELECT CASE WHEN current_setting('application_name') = current_setting('app.default_name') THEN 'yes' ELSE 'no' END;
}
expect {
    yes
    probe
    session
    local
    session
    session
    yes
    yes
}

test builtin-pgdump-setup-functions {
    SELECT set_config('client_encoding', 'unicode', true);
    SELECT set_config('standard_conforming_strings', 'true', true);
    SELECT set_config('statement_timeout', '0', true);
    SELECT set_config('lock_timeout', '0', true);
    SELECT set_config('idle_in_transaction_session_timeout', '0', true);
    SELECT set_config('row_security', 'false', true);
    SELECT set_config('IntervalStyle', 'postgres', true);
    SELECT set_config('extra_float_digits', '1', true);
    SELECT set_config('check_function_bodies', 'false', true);
    SELECT set_config('client_min_messages', 'warning', true);
    SELECT set_config('default_table_access_method', 'heap', true);
    SELECT set_config('xmloption', 'content', true);
}
expect {
    UTF8
    on
    0
    0
    0
    off
    postgres
    1
    off
    warning
    heap
    content
}

test builtin-invalid-datestyle-function {
    SELECT set_config('datestyle', 'bogus', true);
}
@sqlstate 22023
expect error {
    invalid value for parameter "DateStyle"
}

test builtin-invalid-datestyle-set {
    SET datestyle = bogus;
}
@sqlstate 22023
expect error {
    invalid value for parameter "DateStyle"
}

test builtin-application-name-local-reset-and-from-current {
    SELECT CASE WHEN set_config('app.default_name', current_setting('application_name'), false) IS NOT NULL THEN 'yes' ELSE 'no' END;
    SET application_name = 'session';
    BEGIN;
    SET LOCAL application_name TO DEFAULT;
    SELECT CASE WHEN current_setting('application_name') = current_setting('app.default_name') THEN 'yes' ELSE 'no' END;
    COMMIT;
    SHOW application_name;
    BEGIN;
    SET LOCAL application_name = 'local';
    SET application_name FROM CURRENT;
    COMMIT;
    SHOW application_name;
    SELECT current_setting('datestyle', true);
    SELECT CASE WHEN current_setting('datestyle', NULL) IS NULL THEN 'yes' ELSE 'no' END;
    SELECT CASE WHEN current_setting(NULL) IS NULL THEN 'yes' ELSE 'no' END;
}
expect {
    yes
    yes
    session
    local
    ISO, MDY
    yes
    yes
}
