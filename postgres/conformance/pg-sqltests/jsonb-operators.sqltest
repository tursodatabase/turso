# The jsonb operators ->, ->>, #>, #>>, ?, ?|, ?&, @> and <@. The Data API
# turns a filter on a jsonb field into `data ->> 'field' = 'value'`.
#
# -> returns the field as JSON text, and ->> returns it as text: a string has
# no quotes, a number is written as jsonb writes it (`1e2` as `100`), a
# boolean is `true` or `false`, and a JSON null is NULL. A text key is the
# name of a field, not a JSON path, and of two fields with the same name the
# last one counts. #> and #>> find the value at a path of field names and
# array indexes, and return it as -> and ->> do. ?, ?| and ?& test the
# top-level keys, and @> and <@ compare jsonb values by containment.

@database :memory:

setup items_with_jsonb_rows {
    CREATE TABLE items (id int PRIMARY KEY, data jsonb);
    INSERT INTO items VALUES
        (1, '{"name":"apple","price":1.50,"qty":10,"active":true,"tags":["fruit","red"],"dims":{"w":3,"h":4}}'),
        (2, '{"name":"bread","price":2,"qty":2,"active":false,"tags":["bakery"],"dims":{"w":20,"h":10},"note":null}'),
        (3, '[1,2,3]'),
        (4, NULL);
}

# ->>

@setup items_with_jsonb_rows
test jsonb-text-arrow-returns-scalars-as-text {
    SELECT id, data ->> 'qty', data ->> 'price', data ->> 'active' FROM items WHERE id <= 2 ORDER BY id;
}
expect {
    1|10|1.50|true
    2|2|2|false
}

@setup items_with_jsonb_rows
test jsonb-text-arrow-of-integer-equals-text {
    SELECT id FROM items WHERE data ->> 'qty' = '2';
}
expect {
    2
}

@setup items_with_jsonb_rows
test jsonb-text-arrow-of-decimal-keeps-its-digits {
    SELECT id FROM items WHERE data ->> 'price' = '1.50';
}
expect {
    1
}

@setup items_with_jsonb_rows
test jsonb-text-arrow-of-boolean-equals-true {
    SELECT id FROM items WHERE data ->> 'active' = 'true';
}
expect {
    1
}

# A text comparison: '2' > '19' because '2' > '1'. A numeric comparison
# would return no rows.
@setup items_with_jsonb_rows
test jsonb-text-arrow-compares-as-text {
    SELECT id FROM items WHERE data ->> 'qty' > '19';
}
expect {
    2
}

@setup items_with_jsonb_rows
test jsonb-text-arrow-in-text-list {
    SELECT id FROM items WHERE data ->> 'qty' IN ('2', '3') ORDER BY id;
}
expect {
    2
}

@setup items_with_jsonb_rows
test jsonb-text-arrow-of-nested-field {
    SELECT id FROM items WHERE data -> 'dims' ->> 'w' = '20';
}
expect {
    2
}

@setup items_with_jsonb_rows
test jsonb-text-arrow-of-array-element {
    SELECT id FROM items WHERE data ->> 1 = '2';
}
expect {
    3
}

# ->> writes a number as jsonb stores it, with the scale that numeric reads.
test jsonb-text-arrow-writes-numbers-as-numeric-does {
    SELECT '{"a":-0}'::jsonb ->> 'a', '{"a":0e0}'::jsonb ->> 'a', '{"a":2e-3}'::jsonb ->> 'a', '[-0]'::jsonb ->> 0, '{"a":1E+2}'::jsonb ->> 'a', '{"a":12.50e1}'::jsonb ->> 'a', '{"a":-0.0}'::jsonb ->> 'a', '{"a":0e-3}'::jsonb ->> 'a', '{"a":-1.5e-1}'::jsonb ->> 'a', '{"a":100e-2}'::jsonb ->> 'a';
}
expect {
    0|0|0.002|0|100|125.0|0.0|0.000|-0.15|1.00
}

test jsonb-text-arrow-of-number-past-the-limits-of-numeric-errors {
    SELECT '{"a":1e-20000}'::jsonb ->> 'a';
}
@sqlstate 22003
expect error {}

test jsonb-text-arrow-key-is-a-field-name-not-a-path {
    SELECT '{"$.a":1,"a":2}'::jsonb ->> '$.a', '{"a.b":3,"a":{"b":4}}'::jsonb ->> 'a.b';
}
expect {
    1|3
}

test jsonb-arrows-take-the-last-of-two-equal-keys {
    SELECT '{"a":1,"a":2}'::jsonb ->> 'a', '{"a":1,"a":2}'::jsonb -> 'a';
}
expect {
    2|2
}

test jsonb-text-arrow-in-check-constraint {
    CREATE TABLE stock (data jsonb CHECK (data ->> 'qty' <> '0'));
    INSERT INTO stock VALUES ('{"qty":2}');
    INSERT INTO stock VALUES ('{"qty":0}');
}
@sqlstate 23514
expect error {}

test jsonb-text-arrow-of-invalid-json-errors {
    SELECT 'not json'::jsonb ->> 'a';
}
@sqlstate 22P02
expect error {}

test arrow-on-integer-errors {
    SELECT 5 -> 'a';
}
@sqlstate 42883
expect error {}

@setup items_with_jsonb_rows
test jsonb-arrow-returns-json-text {
    SELECT data -> 'name', data -> 'tags', data -> 'qty', data -> 'note' FROM items WHERE id = 2;
}
expect {
    "bread"|["bakery"]|2|null
}

test jsonb-text-arrow-of-string-has-no-quotes-or-escapes {
    SELECT '{"a":"x\"yé"}'::jsonb ->> 'a';
}
expect {
    x"yé
}

@setup items_with_jsonb_rows
test jsonb-text-arrow-of-json-null-is-null {
    SELECT coalesce(data ->> 'note', 'sql null') FROM items WHERE id = 2;
}
expect {
    sql null
}

@setup items_with_jsonb_rows
test jsonb-arrows-with-negative-index-count-from-the-end {
    SELECT data ->> -1, data -> -3, data ->> 3, data ->> -4 FROM items WHERE id = 3;
}
expect {
    3|1||
}

# A name on an array and an index on an object find nothing.
@setup items_with_jsonb_rows
test jsonb-arrows-with-key-of-the-wrong-kind-are-null {
    SELECT (SELECT count(*) FROM items WHERE data -> 0 IS NULL), (SELECT count(*) FROM items WHERE data ->> 'name' IS NULL);
}
expect {
    3|2
}

@setup items_with_jsonb_rows
test jsonb-arrows-with-null-key-are-null {
    SELECT count(*) FROM items WHERE data -> NULL::text IS NULL AND data ->> NULL::int IS NULL;
}
expect {
    4
}

test jsonb-arrow-of-input-nested-500-levels {
    SELECT length(((repeat('[', 500) || repeat(']', 500))::jsonb -> 0)::text);
}
expect {
    998
}

# A jsonb value of tursopg holds at most 500 levels of nested arrays and
# objects, and a deeper value fails with 22P02. The depth limit of
# PostgreSQL depends on max_stack_depth.
@compat-gap "type:jsonb"
test jsonb-arrow-of-input-nested-1000-levels {
    SELECT length(((repeat('[', 1000) || repeat(']', 1000))::jsonb -> 0)::text);
}
expect {
    1998
}
@sqlstate 22P02
expect @tursopg error {}

@compat-gap "type:jsonb"
test jsonb-arrow-of-deeply-nested-input-errors {
    SELECT (repeat('[', 50000) || repeat(']', 50000))::jsonb -> 0;
}
@sqlstate 54001
expect error {}
@sqlstate 22P02
expect @tursopg error {}

# A json value reads as text, so -> reads it to the depth limit of the
# frontend.
test json-arrow-of-input-nested-1000-levels {
    SELECT length(((repeat('[', 1000) || repeat(']', 1000))::json -> 0)::text);
}
expect {
    1998
}

test json-arrow-of-deeply-nested-input-errors {
    SELECT (repeat('[', 50000) || repeat(']', 50000))::json -> 0;
}
@sqlstate 54001
expect error {}

test jsonb-text-arrow-of-nul-escape-errors {
    SELECT '{"a":"\u0000"}'::jsonb ->> 'a';
}
@sqlstate 22P05
expect error {}

# The lookup decodes every string of the document, not only the field that it
# returns, as PostgreSQL does.
test jsonb-arrow-of-nul-escape-in-another-field-errors {
    SELECT '{"b":"\u0000","a":1}'::json -> 'a';
}
@sqlstate 22P05
expect error {}

test jsonb-arrow-of-lone-surrogate-in-another-element-errors {
    SELECT '["\ud83d",1]'::json -> 1;
}
@sqlstate 22P02
expect error {}

test jsonb-arrow-with-numeric-key-errors {
    SELECT '[1]'::jsonb -> 1.5;
}
@sqlstate 42883
expect error {}

test bytea-arrow-errors {
    SELECT '\x01'::bytea -> 'a';
}
@sqlstate 42883
expect error {}

# PostgreSQL roles belong to the whole server, so the test uses its own role
# and table names.
test jsonb-text-arrow-in-row-security-policy {
    CREATE ROLE jo_reader_1;
    CREATE TABLE jo_docs_1 (id int PRIMARY KEY, data jsonb);
    INSERT INTO jo_docs_1 VALUES (1, '{"owner":"jo_reader_1","level":1}'), (2, '{"owner":"jo_reader_1","level":2}'), (3, '{"owner":"other","level":1}');
    GRANT SELECT ON jo_docs_1 TO jo_reader_1;
    ALTER TABLE jo_docs_1 ENABLE ROW LEVEL SECURITY;
    CREATE POLICY jo_own_1 ON jo_docs_1 FOR SELECT USING (data ->> 'owner' = current_user AND data ->> 'level' = '1');
    SET ROLE jo_reader_1;
    SELECT id FROM jo_docs_1;
    RESET ROLE;
}
expect {
    1
}

# An index expression can use only core functions, and -> and ->> run
# functions of the PostgreSQL frontend. Thus tursopg refuses them in an index
# with 0A000.

# TODO let expression indexes use frontend functions
@setup items_with_jsonb_rows
@compat-gap "syntax:create-index"
test jsonb-text-arrow-in-index-expression {
    CREATE INDEX items_qty ON items ((data ->> 'qty'));
    SELECT id FROM items WHERE data ->> 'qty' = '2';
}
expect {
    2
}
@sqlstate 0A000
expect @tursopg error {}

# TODO let expression indexes use frontend functions
@setup items_with_jsonb_rows
@compat-gap "syntax:create-index"
test jsonb-arrow-in-partial-index {
    CREATE INDEX items_dims ON items (id) WHERE data -> 'dims' IS NOT NULL;
    SELECT count(*) FROM items WHERE data -> 'dims' IS NOT NULL;
}
expect {
    2
}
@sqlstate 0A000
expect @tursopg error {}

# A generation expression can use only core functions too, so tursopg refuses
# -> and ->> there with 0A000. The column reads a text column, because a
# generated column cannot read a column of a custom type such as jsonb.

# TODO let generated columns use frontend functions
@compat-gap "syntax:generated-column"
test jsonb-text-arrow-in-generated-column {
    CREATE TABLE gen_items (data text, name text GENERATED ALWAYS AS (data::jsonb ->> 'name') STORED);
    INSERT INTO gen_items (data) VALUES ('{"name":"pear"}');
    SELECT name FROM gen_items;
}
expect {
    pear
}
@sqlstate 0A000
expect @tursopg error {}

# TODO let generated columns use frontend functions
@compat-gap "syntax:generated-column"
test jsonb-arrow-in-added-generated-column {
    CREATE TABLE gen_items_2 (data text);
    ALTER TABLE gen_items_2 ADD COLUMN dims text GENERATED ALWAYS AS (data::jsonb -> 'dims') STORED;
    INSERT INTO gen_items_2 VALUES ('{"dims":[1]}');
    SELECT dims FROM gen_items_2;
}
expect {
    [1]
}
@sqlstate 0A000
expect @tursopg error {}

# Known differences of -> and ->>

# ->> writes a number as jsonb writes it, also for a json value, where the
# json type of PostgreSQL keeps the text of the input.
@compat-gap "operator:json ->> text"
test json-text-arrow-keeps-the-text-of-a-number {
    SELECT '{"n":1e2}'::json ->> 'n';
}
expect {
    1e2
}
expect @tursopg {
    100
}

# A number with more digits than numeric allows makes ->> fail, also for a
# json value, which PostgreSQL does not read as numeric.
@compat-gap "operator:json ->> text"
test json-text-arrow-of-number-past-the-limits-of-numeric {
    SELECT '{"n":1e-20000}'::json ->> 'n';
}
expect {
    1e-20000
}
@sqlstate 22003
expect @tursopg error {}

# -> gives the text of a number as it is stored, where jsonb of PostgreSQL
# writes it as numeric does.
@compat-gap "operator:jsonb -> text"
test jsonb-arrow-keeps-the-text-of-a-number {
    SELECT '{"n":1e2}'::jsonb -> 'n';
}
expect {
    100
}
expect @tursopg {
    1e2
}

# tursopg checks the types of the operands of -> and ->> for each value when
# the query runs. Thus a text left operand and a bigint key work, and a table
# without rows gives no error, where PostgreSQL fails with 42883.
@compat-gap "operator:text -> text"
test text-arrow {
    SELECT '{"a":1}'::text -> 'a';
}
@sqlstate 42883
expect error {}
expect @tursopg {
    1
}

@compat-gap "operator:jsonb -> int8"
test jsonb-arrow-with-bigint-key {
    SELECT '[1,2]'::jsonb -> 1::bigint;
}
@sqlstate 42883
expect error {}
expect @tursopg {
    2
}

@compat-gap "operator:int4 -> text"
test integer-arrow-on-a-table-without-rows {
    CREATE TABLE no_rows (n int);
    SELECT n -> 'a' FROM no_rows;
}
@sqlstate 42883
expect error {}
expect @tursopg {
}

# jsonb of PostgreSQL reads a scalar as an array with one element, so the
# index 0 finds the scalar. tursopg finds nothing, as PostgreSQL does for json.
@compat-gap "operator:jsonb ->> int4"
test jsonb-text-arrow-of-scalar-with-index-0 {
    SELECT coalesce('"x"'::jsonb ->> 0, 'none');
}
expect {
    x
}
expect @tursopg {
    none
}

# @>

@setup items_with_jsonb_rows
test jsonb-contains-field {
    SELECT id FROM items WHERE data @> '{"qty":2}';
}
expect {
    2
}

@setup items_with_jsonb_rows
test jsonb-contains-several-fields {
    SELECT id FROM items WHERE data @> '{"name":"apple","active":true}';
}
expect {
    1
}

@setup items_with_jsonb_rows
test jsonb-contains-part-of-nested-object {
    SELECT id FROM items WHERE data @> '{"dims":{"w":3}}';
}
expect {
    1
}

@setup items_with_jsonb_rows
test jsonb-contains-array-elements-in-any-order {
    SELECT id FROM items WHERE data @> '{"tags":["red","fruit"]}';
}
expect {
    1
}

@setup items_with_jsonb_rows
test jsonb-contains-compares-numbers-by-value {
    SELECT id FROM items WHERE data @> '{"price":1.5}';
}
expect {
    1
}

@setup items_with_jsonb_rows
test jsonb-contains-empty-object-matches-objects-only {
    SELECT id FROM items WHERE data @> '{}' ORDER BY id;
}
expect {
    1
    2
}

@setup items_with_jsonb_rows
test jsonb-contains-elements-of-top-level-array {
    SELECT id FROM items WHERE data @> '[3,1]';
}
expect {
    3
}

@setup items_with_jsonb_rows
test jsonb-contains-scalar-in-top-level-array {
    SELECT id FROM items WHERE data @> '2';
}
expect {
    3
}

# The string "2" does not match the number 2.
@setup items_with_jsonb_rows
test jsonb-contains-does-not-match-string-to-number {
    SELECT id FROM items WHERE NOT (data @> '{"qty":"2"}') ORDER BY id;
}
expect {
    1
    2
    3
}

# Containment does not look for the field at a deeper level.
@setup items_with_jsonb_rows
test jsonb-contains-does-not-match-nested-field-at-top-level {
    SELECT id FROM items WHERE NOT (data @> '{"w":3}') ORDER BY id;
}
expect {
    1
    2
    3
}

@setup items_with_jsonb_rows
test jsonb-contains-of-null-is-null {
    SELECT id FROM items WHERE (data @> '{}') IS NULL;
}
expect {
    4
}

# <@

@setup items_with_jsonb_rows
test jsonb-contained-by-object {
    SELECT id FROM items WHERE data <@ '{"name":"bread","price":2,"qty":2,"active":false,"tags":["bakery","extra"],"dims":{"w":20,"h":10,"d":5},"note":null,"x":1}';
}
expect {
    2
}

@setup items_with_jsonb_rows
test jsonb-contained-by-array {
    SELECT id FROM items WHERE data <@ '[3,2,1,0]';
}
expect {
    3
}

@setup items_with_jsonb_rows
test jsonb-contained-by-does-not-match-object-with-more-fields {
    SELECT id FROM items WHERE NOT (data <@ '{"name":"apple"}') ORDER BY id;
}
expect {
    1
    2
    3
}

# More rules of @> and <@

# The tests that follow cast each comparison to int, so that the result does
# not depend on B-04, where a boolean prints as 0 or 1 instead of f or t.

# A scalar document is an array with one element in jsonb, so a scalar
# contains an equal scalar, and an array contains each of its elements.
test jsonb-contains-scalar-documents {
    SELECT ('1'::jsonb @> '1')::int, ('"a"'::jsonb <@ '["a","b"]')::int, ('null'::jsonb @> 'null')::int, ('true'::jsonb @> 'false')::int;
}
expect {
    1|1|1|0
}

test jsonb-contains-takes-the-last-of-two-equal-keys {
    SELECT ('{"a":1,"a":2}'::jsonb @> '{"a":2}')::int, ('{"a":1,"a":2}'::jsonb @> '{"a":1}')::int, ('{"a":2}'::jsonb @> '{"a":1,"a":2}')::int;
}
expect {
    1|0|1
}

test jsonb-contains-empty-object-or-array {
    SELECT ('{"a":1}'::jsonb @> '{}')::int, ('[1]'::jsonb @> '[]')::int, ('{}'::jsonb @> '[]')::int, ('[]'::jsonb @> '{}')::int, ('1'::jsonb @> '[]')::int;
}
expect {
    1|1|0|0|0
}

# Only at the top level does an array contain a scalar.
test jsonb-contains-nested-arrays {
    SELECT ('[[1,2]]'::jsonb @> '[[2]]')::int, ('[[1,2]]'::jsonb @> '[2]')::int, ('[{"a":1,"b":2}]'::jsonb @> '[{"a":1}]')::int, ('[[1]]'::jsonb @> '[{}]')::int;
}
expect {
    1|0|1|0
}

test jsonb-contains-deeply-nested-values {
    SELECT ('{"a":{"b":[1,{"c":2}]}}'::jsonb @> '{"a":{"b":[{"c":2}]}}')::int, ('{"a":[1,2,3]}'::jsonb @> '{"a":[3,3]}')::int;
}
expect {
    1|1
}

test jsonb-contains-compares-numbers-as-exact-decimals {
    SELECT ('[1e2]'::jsonb @> '[100]')::int, ('{"n":-0}'::jsonb @> '{"n":0}')::int, ('[12345678901234567890]'::jsonb @> '[12345678901234567891]')::int, ('[0.1]'::jsonb @> '[1e-1]')::int;
}
expect {
    1|1|0|1
}

test jsonb-contains-compares-strings-after-escapes {
    SELECT ('{"a":"é"}'::jsonb @> '{"a":"é"}')::int;
}
expect {
    1
}

test jsonb-contains-null-value-is-not-a-missing-field {
    SELECT ('{"a":null}'::jsonb @> '{"a":null}')::int, ('{}'::jsonb @> '{"a":null}')::int, ('{"a":1}'::jsonb @> '{"a":null}')::int;
}
expect {
    1|0|0
}

test jsonb-contains-input-nested-500-levels {
    SELECT ((repeat('[', 500) || repeat(']', 500))::jsonb @> (repeat('[', 499) || repeat(']', 499))::jsonb)::int;
}
expect {
    1
}

test jsonb-contains-objects-nested-500-levels {
    SELECT ((repeat('{"a":', 500) || '1' || repeat('}', 500))::jsonb @> (repeat('{"a":', 500) || '1' || repeat('}', 500))::jsonb)::int;
}
expect {
    1
}

# A jsonb value of tursopg holds at most 500 levels of nested arrays and
# objects, and a deeper value fails with 22P02. The depth limit of
# PostgreSQL depends on max_stack_depth.
@compat-gap "type:jsonb"
test jsonb-contains-input-nested-1000-levels {
    SELECT ((repeat('[', 1000) || repeat(']', 1000))::jsonb @> (repeat('[', 999) || repeat(']', 999))::jsonb)::int;
}
expect {
    1
}
@sqlstate 22P02
expect @tursopg error {}

@compat-gap "type:jsonb"
test jsonb-contains-objects-nested-1000-levels {
    SELECT ((repeat('{"a":', 1000) || '1' || repeat('}', 1000))::jsonb @> (repeat('{"a":', 1000) || '1' || repeat('}', 1000))::jsonb)::int;
}
expect {
    1
}
@sqlstate 22P02
expect @tursopg error {}

@compat-gap "type:jsonb"
test jsonb-contains-of-deeply-nested-input-errors {
    SELECT '[1]'::jsonb @> (repeat('[', 50000) || repeat(']', 50000))::jsonb;
}
@sqlstate 54001
expect error {}
@sqlstate 22P02
expect @tursopg error {}

test jsonb-contains-invalid-json-errors {
    SELECT '{"a":1}'::jsonb @> 'not json';
}
@sqlstate 22P02
expect error {}

# jsonb stores a number as numeric, which has at most 131072 digits before the
# decimal point.
test jsonb-contains-of-number-beyond-numeric-limits-errors {
    SELECT ('[1e131071]'::jsonb @> '[1e131071]')::int;
    SELECT '[1]'::jsonb @> '[1e131072]';
}
@sqlstate 22003
expect error {}

test bytea-contains-errors {
    SELECT '\x01'::bytea @> '{}';
}
@sqlstate 42883
expect error {}

# Core does not know that a column of a VALUES list or of a table that CREATE
# TABLE AS made is an array, so it runs the jsonb function for @> and <@ on
# such a column. That function compares two arrays as arrays.
test array-contains-of-values-list-column {
    SELECT count(*) FROM (VALUES (ARRAY['a','b'])) v(x) WHERE x @> '{a}';
    SELECT count(*) FROM (VALUES (ARRAY['a','b'])) v(x) WHERE x <@ '{a}';
}
expect {
    1
    0
}

test array-contains-of-cte-and-view-of-values-list {
    CREATE VIEW jc_tag_view AS SELECT * FROM (VALUES (ARRAY['a','b'])) v(x);
    WITH tags(x) AS (VALUES (ARRAY['a','b'])) SELECT count(*) FROM tags WHERE '{b}' <@ x;
    SELECT count(*) FROM jc_tag_view WHERE x @> '{a,b}';
}
expect {
    1
    1
}

test array-contains-of-create-table-as-column {
    CREATE TABLE jc_tag_copy AS SELECT ARRAY['a','b'] AS tags, ARRAY[1,2] AS ids;
    SELECT count(*) FROM jc_tag_copy WHERE tags @> '{a}' AND ids @> '{2}' AND NOT (tags @> '{c}');
}
expect {
    1
}

test jsonb-contains-in-check-constraint {
    CREATE TABLE jc_stock (data jsonb CHECK (data @> '{"kind":"fruit"}'));
    INSERT INTO jc_stock VALUES ('{"kind":"fruit","n":1}');
    INSERT INTO jc_stock VALUES ('{"kind":"bread"}');
}
@sqlstate 23514
expect error {}

# PostgreSQL roles belong to the whole server, so the test uses its own role
# and table names.
test jsonb-contains-in-row-security-policy {
    CREATE ROLE jc_reader_1;
    CREATE TABLE jc_docs_1 (id int PRIMARY KEY, data jsonb);
    INSERT INTO jc_docs_1 VALUES (1, '{"readers":["jc_reader_1","x"]}'), (2, '{"readers":["x"]}'), (3, '{"readers":[]}');
    GRANT SELECT ON jc_docs_1 TO jc_reader_1;
    ALTER TABLE jc_docs_1 ENABLE ROW LEVEL SECURITY;
    CREATE POLICY jc_readers_1 ON jc_docs_1 FOR SELECT USING (data @> '{"readers":["jc_reader_1"]}');
    SET ROLE jc_reader_1;
    SELECT id FROM jc_docs_1;
    RESET ROLE;
}
expect {
    1
}

# An index expression can use only core functions, so an index on @> keeps
# the array function. A query must not read such an index.
@setup items_with_jsonb_rows
test jsonb-contains-with-an-index-on-the-same-expression {
    CREATE INDEX items_fruit ON items ((data @> '{"tags":["fruit"]}'));
    SELECT id FROM items WHERE data @> '{"tags":["fruit"]}';
}
expect {
    1
}

# The definition of a table is translated again each time the schema is read.
# A cast to jsonb in a generation expression thus stays the cast to text of
# earlier versions, so that the column gives new rows the values that it gave
# old rows.
@compat-gap "type:jsonb"
test jsonb-cast-in-generated-column-is-a-cast-to-text {
    CREATE TABLE gen_texts (data text, normal text GENERATED ALWAYS AS (data::jsonb::text) STORED);
    INSERT INTO gen_texts (data) VALUES ('[1,  2]');
    SELECT normal FROM gen_texts;
}
expect {
    [1, 2]
}
expect @tursopg {
    [1,  2]
}

# A generation expression can use only core functions too, so a generated
# column keeps the array function, which gives NULL for jsonb values.
# TODO let generated columns use frontend functions
@compat-gap "operator:jsonb @> jsonb"
test jsonb-contains-in-generated-column-uses-the-array-function {
    CREATE TABLE gen_tags (data text, fruit int GENERATED ALWAYS AS ((data::jsonb @> '{"tags":["fruit"]}')::int) STORED);
    INSERT INTO gen_tags (data) VALUES ('{"tags":["fruit","red"]}');
    SELECT coalesce(fruit, -1) FROM gen_tags;
}
expect {
    1
}
expect @tursopg {
    -1
}

# Known differences of @> and <@

# tursopg compares a json or text value as jsonb, where PostgreSQL has @> only
# for jsonb and for arrays.
@compat-gap "operator:json @> json"
test json-contains {
    SELECT '{"a":1}'::json @> '{"a":1}';
}
@sqlstate 42883
expect error {}
expect @tursopg {
    1
}

@compat-gap "operator:text @> text"
test text-contains {
    SELECT '{"a":1}'::text @> '{"a":1}';
}
@sqlstate 42883
expect error {}
expect @tursopg {
    1
}

# PostgreSQL has @> for jsonb and for arrays, so it cannot choose one for two
# string literals. tursopg compares them as jsonb.
@compat-gap "operator:unknown @> unknown"
test contains-of-two-string-literals {
    SELECT '{"a":1}' @> '{"a":1}';
}
@sqlstate 42725
expect error {}
expect @tursopg {
    1
}

# tursopg compares two values that are arrays and not JSON documents as
# arrays. `{}` is also an empty array, so `'{}'::jsonb @> '{a}'` is false,
# where PostgreSQL reads `{a}` as jsonb and fails with 22P02.
@compat-gap "operator:jsonb @> jsonb"
test jsonb-contains-of-array-literal-that-is-not-json {
    SELECT ('{}'::jsonb @> '{a}')::int;
}
@sqlstate 22P02
expect error {}
expect @tursopg {
    0
}

# ?, ?| and ?&

# A field whose value is null is a key too.
@setup items_with_jsonb_rows
test jsonb-has-key {
    SELECT id FROM items WHERE data ? 'note';
}
expect {
    2
}

# Only the fields of the top-level object are keys.
@setup items_with_jsonb_rows
test jsonb-has-key-only-at-top-level {
    SELECT count(*) FROM items WHERE data ? 'w';
}
expect {
    0
}

# The keys of an array are its string elements, and a scalar string document
# is an array with one element in jsonb. A number element is not a key.
test jsonb-has-key-of-array-or-scalar {
    SELECT ('["a",1]'::jsonb ? 'a')::int, ('["a",1]'::jsonb ? '1')::int, ('"a"'::jsonb ? 'a')::int, ('1'::jsonb ? '1')::int, ('[["a"]]'::jsonb ? 'a')::int;
}
expect {
    1|0|1|0|0
}

test jsonb-has-key-compares-keys-after-escapes {
    SELECT ('{"é":1}'::jsonb ? 'é')::int, ('["a\"b"]'::jsonb ? 'a"b')::int, ('{"a":1,"a":2}'::jsonb ? 'a')::int;
}
expect {
    1|1|1
}

@setup items_with_jsonb_rows
test jsonb-has-key-of-null-is-null {
    SELECT id FROM items WHERE (data ? 'name') IS NULL OR ('{"a":1}'::jsonb ? NULL) IS NOT NULL;
}
expect {
    4
}

# A string literal on the left is read as jsonb, because PostgreSQL has ? only
# for jsonb.
test jsonb-has-key-of-string-literal {
    SELECT ('{"a":1}' ? 'a')::int;
}
expect {
    1
}

test jsonb-has-key-of-invalid-json-errors {
    SELECT 'not json' ? 'a';
}
@sqlstate 22P02
expect error {}

test bytea-has-key-errors {
    SELECT '\x01'::bytea ? 'a';
}
@sqlstate 42883
expect error {}

@setup items_with_jsonb_rows
test jsonb-has-any-key {
    SELECT id FROM items WHERE data ?| array['note','zzz'];
}
expect {
    2
}

# A string literal on the right is read as a text array.
@setup items_with_jsonb_rows
test jsonb-has-any-key-of-array-literal {
    SELECT id FROM items WHERE data ?| '{dims,zzz}' ORDER BY id;
}
expect {
    1
    2
}

@setup items_with_jsonb_rows
test jsonb-has-all-keys {
    SELECT id FROM items WHERE data ?& array['name','note'];
}
expect {
    2
}

@setup items_with_jsonb_rows
test jsonb-has-all-keys-of-array-literal {
    SELECT id FROM items WHERE data ?& '{name,tags}' ORDER BY id;
}
expect {
    1
    2
}

# A NULL element does not count, so ?| finds no key and ?& finds every key in
# an array that has no other element.
test jsonb-has-any-or-all-keys-skips-null-elements {
    SELECT ('{"a":1}'::jsonb ?| array[NULL,'a'])::int, ('{"a":1}'::jsonb ?| array[NULL]::text[])::int, ('{"a":1}'::jsonb ?| array[]::text[])::int, ('{"a":1}'::jsonb ?& array[NULL,'b'])::int, ('{"a":1}'::jsonb ?& array[NULL]::text[])::int, ('{"a":1}'::jsonb ?& array[]::text[])::int;
}
expect {
    1|0|0|0|1|1
}

test jsonb-has-any-or-all-keys-of-null-array-is-null {
    SELECT coalesce(('{"a":1}'::jsonb ?| NULL)::int, -1), coalesce(('{"a":1}'::jsonb ?& NULL)::int, -1);
}
expect {
    -1|-1
}

test jsonb-has-key-functions {
    SELECT jsonb_exists('{"a":1}', 'a')::int, jsonb_exists_any('{"a":1}', '{a,b}')::int, jsonb_exists_all('{"a":1}', '{a,b}')::int;
}
expect {
    1|1|0
}

# #> and #>>

@setup items_with_jsonb_rows
test jsonb-path-of-nested-field {
    SELECT data #> '{tags,0}', data #>> '{tags,0}', data #>> '{dims,w}' FROM items WHERE id = 1;
}
expect {
    "fruit"|fruit|3
}

@setup items_with_jsonb_rows
test jsonb-path-in-filter {
    SELECT id FROM items WHERE data #>> '{dims,h}' = '10';
}
expect {
    2
}

# A negative index counts from the end of the array.
@setup items_with_jsonb_rows
test jsonb-path-with-array-index {
    SELECT data #>> '{tags,-1}', data #>> '{tags,1}' FROM items WHERE id = 1;
    SELECT data #> '{1}', data #>> '{-3}' FROM items WHERE id = 3;
}
expect {
    red|red
    2|1
}

# An index is read as C's strtol() reads it: after white space and an
# optional sign, decimal digits only, and nothing after them. An index that
# does not fit in 32 bits leads nowhere.
test jsonb-path-index-is-read-as-a-c-integer {
    SELECT '[1,2]'::jsonb #>> '{" 1"}', '[1,2]'::jsonb #>> '{+1}', '[1,2]'::jsonb #>> '{01}', '[1,2]'::jsonb #>> '{-0}', coalesce('[1,2]'::jsonb #>> '{"1 "}', 'none'), coalesce('[1,2]'::jsonb #>> '{0x1}', 'none'), coalesce('[1,2]'::jsonb #>> '{1.0}', 'none'), coalesce('[1,2]'::jsonb #>> '{2147483648}', 'none'), coalesce('[1,2]'::jsonb #>> '{-2147483648}', 'none');
}
expect {
    2|2|2|1|none|none|none|none|none
}

# A path element of an object is the name of a field, also when it looks like
# an index.
test jsonb-path-of-field-named-like-an-index {
    SELECT '{"1":"x"}'::jsonb #>> '{1}', '{"a":[1,{"b":2}]}'::jsonb #>> '{a,-1,b}', '[[1,2],[3]]'::jsonb #>> '{0,1}';
}
expect {
    x|2|2
}

test jsonb-path-takes-the-last-of-two-equal-keys {
    SELECT '{"a":1,"a":2}'::jsonb #>> '{a}';
}
expect {
    2
}

test jsonb-empty-path-gives-the-whole-document {
    SELECT '"s"'::jsonb #> '{}', '"s"'::jsonb #>> '{}', '[1]'::jsonb #>> '{}', 'null'::jsonb #> '{}', coalesce('null'::jsonb #>> '{}', 'sql null');
}
expect {
    "s"|s|[1]|null|sql null
}

# A scalar has no value at a path that is not empty, and neither has a path
# with a NULL element.
test jsonb-path-to-no-value-is-null {
    SELECT coalesce('"s"'::jsonb #>> '{0}', 'none'), coalesce('[1,2]'::jsonb #>> '{a}', 'none'), coalesce('{"a":1}'::jsonb #>> '{a,b}', 'none'), coalesce('{"a":1}'::jsonb #>> '{b}', 'none'), coalesce('{"a":1}'::jsonb #>> array['a',NULL], 'none'), coalesce('{"a":1}'::jsonb #>> NULL, 'none');
}
expect {
    none|none|none|none|none|none
}

test jsonb-path-to-json-null {
    SELECT '{"a":null}'::jsonb #> '{a}', coalesce('{"a":null}'::jsonb #>> '{a}', 'sql null');
}
expect {
    null|sql null
}

test json-path {
    SELECT '{"a":{"b":1}}'::json #> '{a,b}', '{"a":{"b":"x"}}'::json #>> '{a,b}';
}
expect {
    1|x
}

# The functions take the path as more arguments. A text argument is one
# element, not a text array.
test jsonb-path-functions {
    SELECT jsonb_extract_path('{"a":{"b":1}}', 'a', 'b'), jsonb_extract_path_text('{"a":{"b":"x"}}', 'a', 'b'), jsonb_extract_path_text('{"{a}":"y"}', '{a}'), coalesce(jsonb_extract_path_text('{"a":1}', 'a', NULL), 'none');
}
expect {
    1|x|y|none
}

test jsonb-path-of-nul-escape-errors {
    SELECT '{"b":"\u0000","a":1}'::json #> '{a}';
}
@sqlstate 22P05
expect error {}

# The operators run functions of the PostgreSQL frontend. Thus tursopg
# refuses them with 0A000 in an index expression and in a generation
# expression, which can use only core functions.

# TODO let expression indexes use frontend functions
@setup items_with_jsonb_rows
@compat-gap "syntax:create-index"
test jsonb-has-key-in-index-expression {
    CREATE INDEX items_noted ON items ((data ? 'note'));
    SELECT id FROM items WHERE data ? 'note';
}
expect {
    2
}
@sqlstate 0A000
expect @tursopg error {}

# TODO let expression indexes use frontend functions
@setup items_with_jsonb_rows
@compat-gap "syntax:create-index"
test jsonb-path-in-partial-index {
    CREATE INDEX items_wide ON items (id) WHERE data #>> '{dims,w}' = '20';
    SELECT id FROM items WHERE data #>> '{dims,w}' = '20';
}
expect {
    2
}
@sqlstate 0A000
expect @tursopg error {}

# TODO let generated columns use frontend functions
@compat-gap "syntax:generated-column"
test jsonb-path-in-generated-column {
    CREATE TABLE gen_items_3 (data text, w text GENERATED ALWAYS AS (data::jsonb #>> '{dims,w}') STORED);
    INSERT INTO gen_items_3 (data) VALUES ('{"dims":{"w":3}}');
    SELECT w FROM gen_items_3;
}
expect {
    3
}
@sqlstate 0A000
expect @tursopg error {}

# PostgreSQL roles belong to the whole server, so the test uses its own role
# and table names.
test jsonb-has-key-in-row-security-policy {
    CREATE ROLE jk_reader_1;
    CREATE TABLE jk_docs_1 (id int PRIMARY KEY, data jsonb);
    INSERT INTO jk_docs_1 VALUES (1, '{"public":true}'), (2, '{"owner":"x"}');
    GRANT SELECT ON jk_docs_1 TO jk_reader_1;
    ALTER TABLE jk_docs_1 ENABLE ROW LEVEL SECURITY;
    CREATE POLICY jk_public_1 ON jk_docs_1 FOR SELECT USING (data ? 'public');
    SET ROLE jk_reader_1;
    SELECT id FROM jk_docs_1;
    RESET ROLE;
}
expect {
    1
}

# Known differences of ?, ?|, ?&, #> and #>>

# tursopg reads a json or text value on the left of ?, ?| and ?& as jsonb,
# where PostgreSQL has these operators only for jsonb.
@compat-gap "operator:json ? text"
test json-has-key {
    SELECT '{"a":1}'::json ? 'a';
}
@sqlstate 42883
expect error {}
expect @tursopg {
    t
}

@compat-gap "operator:text ? text"
test text-has-key {
    SELECT '{"a":1}'::text ? 'a';
}
@sqlstate 42883
expect error {}
expect @tursopg {
    t
}

@compat-gap "operator:json ?| _text"
test json-has-any-key {
    SELECT '{"a":1}'::json ?| array['a'];
}
@sqlstate 42883
expect error {}
expect @tursopg {
    t
}

@compat-gap "operator:json ?& _text"
test json-has-all-keys {
    SELECT '{"a":1}'::json ?& array['a'];
}
@sqlstate 42883
expect error {}
expect @tursopg {
    t
}

# tursopg casts the right operand of ? to text, and the right operand of ?|,
# ?&, #> and #>> to a text array. Thus a number and an array of numbers work
# there, where PostgreSQL has these operators only for text and text arrays.
@compat-gap "operator:jsonb ? int4"
test jsonb-has-integer-key {
    SELECT '{"1":0}'::jsonb ? 1;
}
@sqlstate 42883
expect error {}
expect @tursopg {
    t
}

@compat-gap "operator:jsonb ?| _int4"
test jsonb-has-any-key-of-integer-array {
    SELECT '{"1":0}'::jsonb ?| ARRAY[1];
}
@sqlstate 42883
expect error {}
expect @tursopg {
    t
}

@compat-gap "operator:jsonb ?& _int4"
test jsonb-has-all-keys-of-integer-array {
    SELECT '{"1":0}'::jsonb ?& ARRAY[1];
}
@sqlstate 42883
expect error {}
expect @tursopg {
    t
}

@compat-gap "operator:jsonb #> _int4"
test jsonb-path-of-integer-array {
    SELECT '{"1":{"2":3}}'::jsonb #> ARRAY[1,2];
}
@sqlstate 42883
expect error {}
expect @tursopg {
    3
}

@compat-gap "operator:jsonb #>> _int4"
test jsonb-text-path-of-integer-array {
    SELECT '{"1":{"2":3}}'::jsonb #>> ARRAY[1,2];
}
@sqlstate 42883
expect error {}
expect @tursopg {
    3
}

# PostgreSQL has #> and #>> for json and for jsonb, so it cannot choose one
# for two string literals. tursopg reads the left one as JSON.
@compat-gap "operator:unknown #> unknown"
test path-of-two-string-literals {
    SELECT '{"a":{"b":1}}' #> '{a,b}';
}
@sqlstate 42725
expect error {}
expect @tursopg {
    1
}

@compat-gap "operator:unknown #>> unknown"
test text-path-of-two-string-literals {
    SELECT '{"a":{"b":1}}' #>> '{a,b}';
}
@sqlstate 42725
expect error {}
expect @tursopg {
    1
}

# tursopg reads the right operand of ?|, ?&, #> and #>> as its cast to a
# text array reads text. Text that is not an array literal fails with 23000,
# where PostgreSQL fails with 22P02.
@compat-gap "cast:text -> _text"
test jsonb-has-any-key-of-text-that-is-not-an-array-errors {
    SELECT '{"a":1}'::jsonb ?| 'abc';
}
@sqlstate 22P02
expect error {}
@sqlstate 23000
expect @tursopg error {}

@compat-gap "cast:text -> _text"
test jsonb-path-of-text-that-is-not-an-array-errors {
    SELECT '{"a":1}'::jsonb #> 'abc';
}
@sqlstate 22P02
expect error {}
@sqlstate 23000
expect @tursopg error {}

# The cast of tursopg does not read an unquoted element with a space inside,
# such as `- 1`.
@compat-gap "type:_text"
test jsonb-path-with-unquoted-element-with-a-space {
    SELECT coalesce('[1,2]'::jsonb #>> '{- 1}', 'none');
}
expect {
    none
}
@sqlstate 23000
expect @tursopg error {}

# The cast of tursopg reads an array literal with two dimensions as an array
# with one dimension, whose elements are the inner literals, such as `{a}`.
# PostgreSQL reads each element of both dimensions as a key.
@compat-gap "type:_text"
test jsonb-has-any-key-of-two-dimensional-array-literal {
    SELECT '{"a":1}'::jsonb ?| '{ {a}, {b} }';
}
expect {
    t
}
expect @tursopg {
    f
}

# jsonb_extract_path() and jsonb_extract_path_text() of tursopg take the path
# also as one text array, as the operators give it. PostgreSQL takes a text
# array there only after the keyword VARIADIC.
@compat-gap "function:jsonb_extract_path"
test jsonb-extract-path-of-text-array {
    SELECT jsonb_extract_path('{"a":{"b":1}}', ARRAY['a','b']);
}
@sqlstate 42883
expect error {}
expect @tursopg {
    1
}

@compat-gap "function:jsonb_extract_path_text"
test jsonb-extract-path-text-of-text-array {
    SELECT jsonb_extract_path_text('{"a":{"b":1}}', ARRAY['a','b']);
}
@sqlstate 42883
expect error {}
expect @tursopg {
    1
}

# -> and #> return text in tursopg, not jsonb, so || joins text on their
# results.
@compat-gap "operator:jsonb -> text"
test jsonb-arrow-result-is-text {
    SELECT ('{"a":[1]}'::jsonb -> 'a') || '[2]';
}
expect {
    [1, 2]
}
expect @tursopg {
    [1][2]
}

@compat-gap "operator:jsonb #> _text"
test jsonb-path-result-is-text {
    SELECT ('{"a":[1]}'::jsonb #> '{a}') || '[2]';
}
expect {
    [1, 2]
}
expect @tursopg {
    [1][2]
}

# || and -

# The tests that follow compare a result with a jsonb value or read one of its
# fields, so that they do not depend on A-45, where tursopg writes jsonb
# without the spaces of PostgreSQL. A comparison is cast to int, because of
# B-04.

@setup items_with_jsonb_rows
test jsonb-concat-adds-fields {
    SELECT (data || '{"qty":99,"new":true}') ->> 'qty', (data || '{"qty":99,"new":true}') ->> 'new', (data || '{"qty":99}') ->> 'name' FROM items WHERE id = 1;
}
expect {
    99|true|apple
}

# Of two fields with the same name, the field of the right object counts.
test jsonb-concat-of-objects {
    SELECT ('{"a":1,"b":2}'::jsonb || '{"a":3,"c":4}' = '{"a":3,"b":2,"c":4}')::int, ('{"a":1}'::jsonb || '{"a":2}' = '{"a":2}')::int, '{}'::jsonb || '{}';
}
expect {
    1|1|{}
}

test jsonb-concat-of-arrays {
    SELECT ('[1,2]'::jsonb || '[2,3]' = '[1,2,2,3]')::int, ('[1]'::jsonb || '[[2]]' = '[1,[2]]')::int, '[]'::jsonb || '[]';
}
expect {
    1|1|[]
}

# A value that is not an array counts as an array with one element.
test jsonb-concat-of-other-values {
    SELECT ('[1]'::jsonb || '2' = '[1,2]')::int, ('{"a":1}'::jsonb || '[2]' = '[{"a":1},2]')::int, ('[2]'::jsonb || '{"a":1}' = '[2,{"a":1}]')::int, ('1'::jsonb || '"x"' = '[1,"x"]')::int, '{}'::jsonb || '[]', '[]'::jsonb || '1';
}
expect {
    1|1|1|1|[{}]|[1]
}

# Only the top level is joined.
test jsonb-concat-joins-only-the-top-level {
    SELECT ('{"a":{"b":1}}'::jsonb || '{"a":{"c":2}}') -> 'a' ->> 'c', coalesce(('{"a":{"b":1}}'::jsonb || '{"a":{"c":2}}') -> 'a' ->> 'b', 'none');
}
expect {
    2|none
}

# A string literal on the other side is read as jsonb, also on the left.
test jsonb-concat-reads-a-string-literal-as-jsonb {
    SELECT ('[1]' || '[2]'::jsonb = '[1,2]')::int, ('{"a":1}'::jsonb || '{"b": 2}' = '{"a":1,"b":2}')::int;
}
expect {
    1|1
}

test jsonb-concat-of-invalid-json-literal-errors {
    SELECT '[1]'::jsonb || 'not json';
}
@sqlstate 22P02
expect error {}

# A value of type text on the other side is joined as text.
test jsonb-concat-of-text-joins-text {
    SELECT '[1]'::jsonb || 'x'::text, 'x'::text || '[1]'::jsonb;
}
expect {
    [1]x|x[1]
}

test jsonb-concat-of-null-is-null {
    SELECT coalesce(('[1]'::jsonb || NULL)::text, 'none'), coalesce((NULL || '[1]'::jsonb)::text, 'none');
}
expect {
    none|none
}

# The result is jsonb, so the operators of jsonb run on it.
test jsonb-concat-result-is-jsonb {
    SELECT ('[1]'::jsonb || '[2]' || '[3]' = '[1,2,3]')::int, (('{"a":1}'::jsonb || '{"b":2}') - 'a') ->> 'b', ('{"a":1}'::jsonb || '{"b":2}') ? 'b';
}
expect {
    1|2|t
}

@setup items_with_jsonb_rows
test jsonb-concat-in-update {
    UPDATE items SET data = data || '{"qty":3}' WHERE id = 2;
    SELECT data ->> 'qty', data ->> 'name' FROM items WHERE id = 2;
}
expect {
    3|bread
}

test jsonb-concat-function {
    SELECT (jsonb_concat('{"a":1}', '{"b":2}') = '{"a":1,"b":2}')::int;
}
expect {
    1
}

@setup items_with_jsonb_rows
test jsonb-delete-key {
    SELECT coalesce((data - 'name') ->> 'name', 'none'), (data - 'name') ->> 'qty' FROM items WHERE id = 1;
}
expect {
    none|10
}

# A text deletes the string elements of an array that are equal to it, and
# only at the top level.
test jsonb-delete-string-elements {
    SELECT ('["a","b","a",1]'::jsonb - 'a' = '["b",1]')::int, '["1",1]'::jsonb - '1', '["a",["a"]]'::jsonb - 'a', ('{"a":1,"b":{"a":2}}'::jsonb - 'a' = '{"b":{"a":2}}')::int;
}
expect {
    1|[1]|[["a"]]|1
}

# A negative index counts from the end. An index past either end deletes
# nothing.
test jsonb-delete-element {
    SELECT '[1,2]'::jsonb - 0, '[1,2]'::jsonb - -1, ('[1,2]'::jsonb - 2 = '[1,2]')::int, ('[1,2]'::jsonb - -3 = '[1,2]')::int, ('[1,2,3]'::jsonb - (-2147483648) = '[1,2,3]')::int;
}
expect {
    [2]|[1]|1|1|1
}

# A text array deletes each of its elements, and a NULL element deletes
# nothing. A string literal is a text, not a text array.
test jsonb-delete-keys {
    SELECT '{"a":1,"b":2}'::jsonb - '{a,b}'::text[], '{"a":1,"b":2}'::jsonb - ARRAY['a','b'], ('{"a":1,"b":2}'::jsonb - ARRAY['a',NULL]) ->> 'b', ('{"a":1,"b":2}'::jsonb - '{a,b}' = '{"a":1,"b":2}')::int, '["a","b"]'::jsonb - ARRAY['a','b'];
}
expect {
    {}|{}|2|1|[]
}

test jsonb-delete-from-empty-value {
    SELECT '[]'::jsonb - 0, '[]'::jsonb - 'a', '{}'::jsonb - 'a', '{}'::jsonb - '{a}'::text[];
}
expect {
    []|[]|{}|{}
}

test jsonb-delete-of-null-is-null {
    SELECT coalesce(('{"a":1}'::jsonb - NULL::text)::text, 'none'), coalesce(('[1]'::jsonb - NULL::int)::text, 'none'), coalesce((NULL::jsonb - 'a')::text, 'none');
}
expect {
    none|none|none
}

test jsonb-delete-from-scalar-errors {
    SELECT '"a"'::jsonb - 'a';
}
@sqlstate 22023
expect error {}

test jsonb-delete-index-from-object-errors {
    SELECT '{}'::jsonb - 0;
}
@sqlstate 22023
expect error {}

test jsonb-delete-of-two-dimensional-array-errors {
    SELECT '{"a":1}'::jsonb - ARRAY[ARRAY['a']];
}
@sqlstate 2202E
expect error {}

# PostgreSQL has `jsonb - integer`, and no `jsonb - numeric` or
# `jsonb - bigint`.
test jsonb-delete-of-decimal-errors {
    SELECT '[1]'::jsonb - 1.5;
}
@sqlstate 42883
expect error {}

test jsonb-delete-of-bigint-errors {
    SELECT '[1]'::jsonb - 3000000000;
}
@sqlstate 42883
expect error {}

@setup items_with_jsonb_rows
test jsonb-delete-in-update {
    UPDATE items SET data = data - 'dims' - 'tags' WHERE id = 1;
    SELECT coalesce(data ->> 'dims', 'none'), coalesce(data ->> 'tags', 'none'), data ->> 'qty' FROM items WHERE id = 1;
}
expect {
    none|none|10
}

test jsonb-delete-function {
    SELECT jsonb_delete('{"a":1,"b":2,"c":3}', 'a', 'b') ->> 'c', jsonb_delete('[1,2]', 0);
}
expect {
    3|[2]
}

# Core runs || and - on jsonb values, so an index expression can use them.
@setup items_with_jsonb_rows
test jsonb-concat-and-delete-in-index-expressions {
    CREATE INDEX items_without_name ON items ((data - 'name'));
    CREATE INDEX items_with_flag ON items ((data || '{"flag":1}'));
    UPDATE items SET data = data || '{"qty":5}' WHERE id = 2;
    SELECT id FROM items WHERE data - 'name' = '{"price":2,"qty":5,"active":false,"tags":["bakery"],"dims":{"w":20,"h":10},"note":null}' OR (data || '{"flag":1}') ->> 'qty' = '10' ORDER BY id;
}
expect {
    1
    2
}

# Known differences of || and -

# tursopg joins text for a value that is not jsonb, such as an integer, where
# PostgreSQL has no `jsonb || integer`.
@compat-gap "operator:jsonb || int4"
test jsonb-concat-of-integer {
    SELECT '[1]'::jsonb || 5;
}
@sqlstate 42883
expect error {}
expect @tursopg {
    [1]5
}

# A cast to json is a cast to text in tursopg, so || joins text.
@compat-gap "operator:jsonb || json"
test jsonb-concat-of-json {
    SELECT '[1]'::jsonb || '[2]'::json;
}
@sqlstate 42883
expect error {}
expect @tursopg {
    [1][2]
}

# The error of an operator that a type does not have reports 42601 in
# tursopg.
@compat-gap "operator:jsonb - jsonb"
test jsonb-delete-of-jsonb-errors {
    SELECT '{"a":1}'::jsonb - '{"a":1}'::jsonb;
}
@sqlstate 42883
expect error {}
@sqlstate 42601
expect @tursopg error {}

# The check of the types of a CHECK constraint does not know the operators
# of custom types.
@compat-gap "operator:jsonb - text"
test jsonb-delete-in-check-constraint {
    CREATE TABLE checked_rest (data jsonb CHECK (data - 'a' <> '{}'));
    INSERT INTO checked_rest VALUES ('{"a":1,"b":2}');
    SELECT count(*) FROM checked_rest;
}
expect {
    1
}
@sqlstate 42601
expect @tursopg error {}

# A cast to jsonb in a generation expression is a cast to text (see
# jsonb-cast-in-generated-column-is-a-cast-to-text), so - subtracts numbers.
@compat-gap "type:jsonb"
test jsonb-delete-in-generated-column-subtracts-numbers {
    CREATE TABLE gen_rest (data text, rest text GENERATED ALWAYS AS (data::jsonb - 'a') STORED);
    INSERT INTO gen_rest (data) VALUES ('[1]');
    SELECT rest FROM gen_rest;
}
expect {
    [1]
}
expect @tursopg {
    0
}

# A result keeps the order of the fields, where PostgreSQL sorts the fields of
# a jsonb object by the length of their names and then by name.
@compat-gap "type:jsonb"
test jsonb-concat-keeps-the-order-of-the-fields {
    SELECT '{"b":1}'::jsonb || '{"a":2}';
}
expect {
    {"a": 2, "b": 1}
}
expect @tursopg {
    {"b":1,"a":2}
}

@compat-gap "type:jsonb"
test jsonb-delete-keeps-the-order-of-the-fields {
    SELECT '{"b":1,"a":2}'::jsonb - 'c';
}
expect {
    {"a": 2, "b": 1}
}
expect @tursopg {
    {"b":1,"a":2}
}

# A varchar with a length is a custom type of tursopg that has no ||. Thus ||
# of a jsonb value and such a varchar fails, where PostgreSQL joins text.
@compat-gap "operator:jsonb || varchar"
test jsonb-concat-of-varchar {
    CREATE TABLE jv (j jsonb, v varchar(5));
    INSERT INTO jv VALUES ('[1]', 'x');
    SELECT j || v FROM jv;
}
expect {
    [1]x
}
@sqlstate 42601
expect @tursopg error {}

# PostgreSQL has `jsonb - integer` and no `jsonb - bigint`. tursopg deletes
# the element at the index that the bigint gives.
@compat-gap "operator:jsonb - int8"
test jsonb-delete-of-bigint {
    CREATE TABLE jb (j jsonb, b bigint);
    INSERT INTO jb VALUES ('[1,2]', 0);
    SELECT j - b FROM jb;
}
@sqlstate 42883
expect error {}
expect @tursopg {
    [2]
}

# A cast to jsonb in a generation expression is a cast to text (see
# jsonb-cast-in-generated-column-is-a-cast-to-text), so || joins text.
@compat-gap "type:jsonb"
test jsonb-concat-in-generated-column-joins-text {
    CREATE TABLE gen_more (data text, more text GENERATED ALWAYS AS (data::jsonb || '[2]') STORED);
    INSERT INTO gen_more (data) VALUES ('[1]');
    SELECT more FROM gen_more;
}
expect {
    [1, 2]
}
expect @tursopg {
    [1][2]
}

# Operators and functions of jsonb that tursopg does not have

@compat-gap "operator:jsonb @@ jsonpath"
test jsonb-matches-jsonpath {
    SELECT '{"a":1}'::jsonb @@ '$.a == 1';
}
expect {
    t
}
@sqlstate 42601
expect @tursopg error {}

@compat-gap "operator:jsonb #- _text"
test jsonb-delete-path {
    SELECT '{"a":{"b":1}}'::jsonb #- '{a,b}';
}
expect {
    {"a": {}}
}
@sqlstate 42601
expect @tursopg error {}

# jsonb_insert() of tursopg is the function of SQLite, which takes a JSON
# path.
@compat-gap "function:jsonb_insert"
test jsonb-insert {
    SELECT jsonb_insert('{"a":[1]}', '{a,0}', '0');
}
expect {
    {"a": [0, 1]}
}
@sqlstate 42601
expect @tursopg error {}
