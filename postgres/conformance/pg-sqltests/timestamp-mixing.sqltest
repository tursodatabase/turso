@setup tsmix
test ts-tz-order-80 {
    SELECT x FROM (SELECT tz AS x FROM t UNION ALL SELECT ts FROM t) q ORDER BY x DESC;
}
expect {
    
    9999-12-31 23:59:59.999999+00
    2024-01-05 11:00:00+00
    2024-01-05 10:00:00+00
    2024-01-05 10:00:00+00
    2024-01-05 10:00:00+00
    2024-01-05 10:00:00+00
    2024-01-05 09:00:00.5+00
    2024-01-05 09:00:00.5+00
    0001-01-01 00:00:00+00
}

@setup tsmix
test ts-tz-order-81 {
    SELECT id, CASE WHEN id % 2 = 0 THEN ts ELSE tz END AS x FROM t ORDER BY x, id;
}
expect {
    3|2024-01-05 09:00:00.5+00
    1|2024-01-05 10:00:00+00
    2|2024-01-05 11:00:00+00
    5|9999-12-31 23:59:59.999999+00
    4|
}

@setup tsmix
test ts-tz-order-82 {
    SELECT coalesce(ts, tz) AS x FROM t ORDER BY x;
}
expect {
    0001-01-01 00:00:00+00
    2024-01-05 09:00:00.5+00
    2024-01-05 10:00:00+00
    2024-01-05 10:00:00+00
    2024-01-05 11:00:00+00
}

@setup tsmix
test ts-tz-order-83 {
    SELECT x, count(*) FROM (SELECT coalesce(ts, tz) AS x FROM t) q GROUP BY x ORDER BY x;
}
expect {
    0001-01-01 00:00:00+00|1
    2024-01-05 09:00:00.5+00|1
    2024-01-05 10:00:00+00|2
    2024-01-05 11:00:00+00|1
}

@setup tsmix
test ts-tz-order-84 {
    SELECT DISTINCT coalesce(ts, tz) AS x FROM t ORDER BY x;
}
expect {
    0001-01-01 00:00:00+00
    2024-01-05 09:00:00.5+00
    2024-01-05 10:00:00+00
    2024-01-05 11:00:00+00
}

@setup tsmix
test ts-tz-order-85 {
    SELECT DISTINCT x FROM (SELECT tz AS x FROM t UNION ALL SELECT ts FROM t) q ORDER BY x;
}
expect {
    0001-01-01 00:00:00+00
    2024-01-05 09:00:00.5+00
    2024-01-05 10:00:00+00
    2024-01-05 11:00:00+00
    9999-12-31 23:59:59.999999+00
    
}

@setup tsmix
test ts-tz-order-86 {
    SELECT x, count(*) FROM (SELECT tz AS x FROM t UNION ALL SELECT ts FROM t) q GROUP BY x ORDER BY x;
}
expect {
    0001-01-01 00:00:00+00|1
    2024-01-05 09:00:00.5+00|2
    2024-01-05 10:00:00+00|4
    2024-01-05 11:00:00+00|1
    9999-12-31 23:59:59.999999+00|1
    |1
}

@setup tsmix
test ts-tz-order-87 {
    SELECT ts FROM t UNION SELECT tz FROM t ORDER BY 1;
}
expect {
    0001-01-01 00:00:00+00
    2024-01-05 09:00:00.5+00
    2024-01-05 10:00:00+00
    2024-01-05 11:00:00+00
    9999-12-31 23:59:59.999999+00
    
}

@setup tsmix
test ts-tz-order-88 {
    SELECT ts FROM t INTERSECT SELECT tz FROM t ORDER BY 1;
}
expect {
    2024-01-05 09:00:00.5+00
    2024-01-05 10:00:00+00
}

@setup tsmix
test ts-tz-order-89 {
    SELECT min(x), max(x) FROM (SELECT tz AS x FROM t UNION ALL SELECT ts FROM t) q;
}
expect {
    0001-01-01 00:00:00+00|9999-12-31 23:59:59.999999+00
}

@setup tsmix
test ts-tz-order-90 {
    SELECT id, GREATEST(ts, tz), LEAST(ts, tz) FROM t WHERE ts IS NOT NULL ORDER BY id;
}
expect {
    1|2024-01-05 10:00:00+00|2024-01-05 10:00:00+00
    2|2024-01-05 11:00:00+00|2024-01-05 10:00:00+00
    3|2024-01-05 09:00:00.5+00|2024-01-05 09:00:00.5+00
    5|9999-12-31 23:59:59.999999+00|0001-01-01 00:00:00+00
}

setup tsmix_two_tables {
    CREATE TABLE a (id int, ts timestamp);
    CREATE TABLE b (id int, tz timestamptz);
    INSERT INTO a VALUES (1, '2024-01-05 10:00'), (2, '2024-01-05 11:00'), (3, NULL);
    INSERT INTO b VALUES (1, '2024-01-05 10:00+00'), (2, '2024-01-05 12:00+00'), (3, NULL);
}

# Column operands, not literals, in IN, CASE and ANY.
@setup tsmix_two_tables
test ts-tz-columns-in-list {
    SELECT a.id FROM a, b WHERE a.ts IN (b.tz) ORDER BY a.id;
}
expect {
    1
}

@setup tsmix_two_tables
test ts-tz-columns-case-operand {
    SELECT a.id, b.id, CASE a.ts WHEN b.tz THEN 'same' ELSE 'other' END FROM a, b WHERE a.id = b.id ORDER BY a.id;
}
expect {
    1|1|same
    2|2|other
    3|3|other
}

@setup tsmix_two_tables
test ts-tz-columns-any-array {
    SELECT a.id FROM a, b WHERE a.ts = ANY(ARRAY[b.tz]) ORDER BY a.id;
}
expect {
    1
}

setup tsmix_domain {
    CREATE DOMAIN dts AS timestamp;
    CREATE TABLE d (x dts);
    CREATE TABLE z (x timestamptz);
    INSERT INTO d VALUES ('2024-01-05 10:00');
    INSERT INTO z VALUES ('2024-01-05 10:00+00');
}

# A domain over timestamp is a timestamp.
@setup tsmix_domain
test ts-tz-domain-union {
    SELECT x FROM d UNION SELECT x FROM z;
}
expect {
    2024-01-05 10:00:00+00
}

@setup tsmix_domain
test ts-tz-domain-compare {
    SELECT count(*) FROM d, z WHERE d.x = z.x;
}
expect {
    1
}

@setup tsmix_domain
test ts-tz-domain-order-by {
    SELECT x FROM (SELECT x FROM d UNION ALL SELECT x FROM z) q ORDER BY x;
}
expect {
    2024-01-05 10:00:00+00
    2024-01-05 10:00:00+00
}
