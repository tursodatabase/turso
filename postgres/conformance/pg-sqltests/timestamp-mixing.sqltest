# timestamp mixed with timestamptz. PostgreSQL compares a timestamp with a
# timestamptz after converting the timestamp in the session time zone, UTC on
# both servers, and gives CASE, coalesce, UNION and the like the type
# timestamptz. Every expected result comes from PostgreSQL 18.
#
# tursopg rejects infinity, BC dates and years above 9999, so the edge rows
# are the earliest and latest years it accepts, and fractions. The queries
# that tursopg cannot run yet are in gaps/timestamp-mixing.sqltest.

@database :memory:

setup tsmix {
    CREATE TABLE t (id int, ts timestamp, tz timestamptz);
    INSERT INTO t VALUES
        (1, '2024-01-05 10:00', '2024-01-05 10:00+00'),
        (2, '2024-01-05 11:00', '2024-01-05 10:00+00'),
        (3, '2024-01-05 09:00:00.5', '2024-01-05 09:00:00.5+00'),
        (4, NULL, '2024-01-05 10:00+00'),
        (5, '0001-01-01 00:00:00', '9999-12-31 23:59:59.999999+00');
}

setup tsmix_idx {
    CREATE TABLE t (id int, ts timestamp, tz timestamptz);
    INSERT INTO t VALUES
        (1, '2024-01-05 10:00', '2024-01-05 10:00+00'),
        (2, '2024-01-05 11:00', '2024-01-05 10:00+00'),
        (3, '2024-01-05 09:00:00.5', '2024-01-05 09:00:00.5+00'),
        (4, NULL, '2024-01-05 10:00+00'),
        (5, '0001-01-01 00:00:00', '9999-12-31 23:59:59.999999+00');
    CREATE INDEX t_ts ON t (ts);
    CREATE INDEX t_tz ON t (tz);
}

@setup tsmix
test ts-tz-mix-01 {
    SELECT id FROM t WHERE ts = tz ORDER BY id;
}
expect {
    1
    3
}

@setup tsmix
test ts-tz-mix-02 {
    SELECT id FROM t WHERE ts <> tz ORDER BY id;
}
expect {
    2
    5
}

@setup tsmix
test ts-tz-mix-03 {
    SELECT id FROM t WHERE ts < tz ORDER BY id;
}
expect {
    5
}

@setup tsmix
test ts-tz-mix-04 {
    SELECT id FROM t WHERE ts <= tz ORDER BY id;
}
expect {
    1
    3
    5
}

@setup tsmix
test ts-tz-mix-05 {
    SELECT id FROM t WHERE ts > tz ORDER BY id;
}
expect {
    2
}

@setup tsmix
test ts-tz-mix-06 {
    SELECT id FROM t WHERE ts >= tz ORDER BY id;
}
expect {
    1
    2
    3
}

@setup tsmix
test ts-tz-mix-07 {
    SELECT id FROM t WHERE tz = ts ORDER BY id;
}
expect {
    1
    3
}

@setup tsmix
test ts-tz-mix-08 {
    SELECT id FROM t WHERE ts IS DISTINCT FROM tz ORDER BY id;
}
expect {
    2
    4
    5
}

@setup tsmix
test ts-tz-mix-09 {
    SELECT id FROM t WHERE ts IS NOT DISTINCT FROM tz ORDER BY id;
}
expect {
    1
    3
}

@setup tsmix
test ts-tz-mix-10 {
    SELECT id FROM t WHERE ts IN (tz, '2030-01-01') ORDER BY id;
}
expect {
    1
    3
}

@setup tsmix
test ts-tz-mix-11 {
    SELECT id FROM t WHERE tz IN (ts, '2030-01-01') ORDER BY id;
}
expect {
    1
    3
}

@setup tsmix
test ts-tz-mix-12 {
    SELECT id FROM t WHERE ts = ANY(ARRAY[tz]) ORDER BY id;
}
expect {
    1
    3
}

@setup tsmix
test ts-tz-mix-13 {
    SELECT id FROM t WHERE ts = ANY(ARRAY[tz, '2030-01-01'::timestamptz]) ORDER BY id;
}
expect {
    1
    3
}

@setup tsmix
test ts-tz-mix-14 {
    SELECT id, CASE ts WHEN tz THEN 'eq' ELSE 'ne' END FROM t ORDER BY id;
}
expect {
    1|eq
    2|ne
    3|eq
    4|ne
    5|ne
}

@setup tsmix
test ts-tz-mix-15 {
    SELECT id, NULLIF(ts, tz) FROM t ORDER BY id;
}
expect {
    1|
    2|2024-01-05 11:00:00
    3|
    4|
    5|0001-01-01 00:00:00
}

@setup tsmix
test ts-tz-mix-16 {
    SELECT id, GREATEST(ts, tz) FROM t WHERE ts IS NOT NULL ORDER BY id;
}
expect {
    1|2024-01-05 10:00:00+00
    2|2024-01-05 11:00:00+00
    3|2024-01-05 09:00:00.5+00
    5|9999-12-31 23:59:59.999999+00
}

@setup tsmix
test ts-tz-mix-17 {
    SELECT id, LEAST(ts, tz) FROM t WHERE ts IS NOT NULL ORDER BY id;
}
expect {
    1|2024-01-05 10:00:00+00
    2|2024-01-05 10:00:00+00
    3|2024-01-05 09:00:00.5+00
    5|0001-01-01 00:00:00+00
}

@setup tsmix
test ts-tz-mix-18 {
    SELECT id, COALESCE(ts, tz) FROM t ORDER BY id;
}
expect {
    1|2024-01-05 10:00:00+00
    2|2024-01-05 11:00:00+00
    3|2024-01-05 09:00:00.5+00
    4|2024-01-05 10:00:00+00
    5|0001-01-01 00:00:00+00
}

@setup tsmix
test ts-tz-mix-19 {
    SELECT id, COALESCE(NULL::timestamp, tz) FROM t ORDER BY id;
}
expect {
    1|2024-01-05 10:00:00+00
    2|2024-01-05 10:00:00+00
    3|2024-01-05 09:00:00.5+00
    4|2024-01-05 10:00:00+00
    5|9999-12-31 23:59:59.999999+00
}

@setup tsmix
test ts-tz-mix-20 {
    SELECT id, COALESCE(NULL::timestamptz, ts) FROM t ORDER BY id;
}
expect {
    1|2024-01-05 10:00:00+00
    2|2024-01-05 11:00:00+00
    3|2024-01-05 09:00:00.5+00
    4|
    5|0001-01-01 00:00:00+00
}

@setup tsmix
test ts-tz-mix-21 {
    SELECT x FROM (SELECT ts AS x FROM t UNION ALL SELECT tz FROM t) q ORDER BY x;
}
expect {
    0001-01-01 00:00:00+00
    2024-01-05 09:00:00.5+00
    2024-01-05 09:00:00.5+00
    2024-01-05 10:00:00+00
    2024-01-05 10:00:00+00
    2024-01-05 10:00:00+00
    2024-01-05 10:00:00+00
    2024-01-05 11:00:00+00
    9999-12-31 23:59:59.999999+00
    
}

@setup tsmix
test ts-tz-mix-22 {
    SELECT ts FROM t UNION SELECT tz FROM t ORDER BY 1;
}
expect {
    0001-01-01 00:00:00+00
    2024-01-05 09:00:00.5+00
    2024-01-05 10:00:00+00
    2024-01-05 11:00:00+00
    9999-12-31 23:59:59.999999+00
    
}

@setup tsmix
test ts-tz-mix-23 {
    SELECT tz FROM t UNION SELECT ts FROM t ORDER BY 1;
}
expect {
    0001-01-01 00:00:00+00
    2024-01-05 09:00:00.5+00
    2024-01-05 10:00:00+00
    2024-01-05 11:00:00+00
    9999-12-31 23:59:59.999999+00
    
}

@setup tsmix
test ts-tz-mix-24 {
    SELECT ts FROM t INTERSECT SELECT tz FROM t ORDER BY 1;
}
expect {
    2024-01-05 09:00:00.5+00
    2024-01-05 10:00:00+00
}

@setup tsmix
test ts-tz-mix-25 {
    SELECT ts FROM t EXCEPT SELECT tz FROM t ORDER BY 1;
}
expect {
    0001-01-01 00:00:00+00
    2024-01-05 11:00:00+00
    
}

@setup tsmix
test ts-tz-mix-26 {
    SELECT tz FROM t EXCEPT SELECT ts FROM t ORDER BY 1;
}
expect {
    9999-12-31 23:59:59.999999+00
}

@setup tsmix
test ts-tz-mix-27 {
    SELECT DISTINCT x FROM (SELECT ts AS x FROM t UNION ALL SELECT tz FROM t) q ORDER BY x;
}
expect {
    0001-01-01 00:00:00+00
    2024-01-05 09:00:00.5+00
    2024-01-05 10:00:00+00
    2024-01-05 11:00:00+00
    9999-12-31 23:59:59.999999+00
    
}

@setup tsmix
test ts-tz-mix-28 {
    SELECT a.id, b.id FROM t a JOIN t b ON a.ts = b.tz ORDER BY 1,2;
}
expect {
    1|1
    1|2
    1|4
    3|3
}

@setup tsmix
test ts-tz-mix-29 {
    SELECT a.id, b.id FROM t a JOIN t b ON a.ts < b.tz ORDER BY 1,2;
}
expect {
    1|5
    2|5
    3|1
    3|2
    3|4
    3|5
    5|1
    5|2
    5|3
    5|4
    5|5
}

