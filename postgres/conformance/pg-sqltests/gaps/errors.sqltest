# Known tursopg gaps against PostgreSQL: D. Errors
#
# The default `expect` block is the PostgreSQL result. An `expect @tursopg`
# block is the current wrong tursopg result. When you fix a gap, delete its
# `@tursopg` block in the same change. See postgres/CONTRIBUTING.md.
# A test without an `@tursopg` block matches PostgreSQL and guards against
# regressions.

@database :memory:

setup parent_id_child_id_pid_with_rows {
    CREATE TABLE parent (id int PRIMARY KEY);
    CREATE TABLE child (id int PRIMARY KEY, pid int CONSTRAINT child_pid_fkey REFERENCES parent(id));
    INSERT INTO parent VALUES (1);
    INSERT INTO child VALUES (1, 1);
}

setup t_n {
    CREATE TABLE t (n int);
}

setup t_id {
    CREATE TABLE t (id int);
}

# D-01 (S1): FK not enforced by default
# D-02 had the same SQL. This test covers it.
@setup parent_id_child_id_pid_with_rows
test gap-d-01-fk-not-enforced-by-default {
    INSERT INTO child VALUES (2, 99);
}
@sqlstate 23503
expect error {}
expect @tursopg {
}

# D-03 (S1): FK violation on update child
# Fails while foreign keys are off, see D-01.
@setup parent_id_child_id_pid_with_rows
test gap-d-03-fk-violation-on-update-child {
    UPDATE child SET pid = 99 WHERE id = 1;
}
@sqlstate 23503
expect error {}
expect @tursopg {
}

# D-04 (S1): FK violation on delete parent
# Fails while foreign keys are off, see D-01.
@setup parent_id_child_id_pid_with_rows
test gap-d-04-fk-violation-on-delete-parent {
    DELETE FROM parent WHERE id = 1;
}
@sqlstate 23503
expect error {}
expect @tursopg {
}

# D-05 (S1): ON DELETE CASCADE
# Fails while foreign keys are off, see D-01.
test gap-d-05-on-delete-cascade {
    CREATE TABLE parent (id int PRIMARY KEY);
    CREATE TABLE child (id int PRIMARY KEY, pid int REFERENCES parent(id) ON DELETE CASCADE);
    INSERT INTO parent VALUES (1);
    INSERT INTO child VALUES (1, 1);
    DELETE FROM parent WHERE id = 1;
    SELECT count(*) FROM child;
}
expect {
    0
}
expect @tursopg {
    1
}

# D-06 (S1): ON DELETE SET NULL
# Fails while foreign keys are off, see D-01.
test gap-d-06-on-delete-set-null {
    CREATE TABLE parent (id int PRIMARY KEY);
    CREATE TABLE child (id int PRIMARY KEY, pid int REFERENCES parent(id) ON DELETE SET NULL);
    INSERT INTO parent VALUES (1);
    INSERT INTO child VALUES (1, 1);
    DELETE FROM parent WHERE id = 1;
    SELECT id, pid FROM child;
}
expect {
    1|
}
expect @tursopg {
    1|1
}

# D-07 (S1): ON UPDATE CASCADE
# Fails while foreign keys are off, see D-01.
test gap-d-07-on-update-cascade {
    CREATE TABLE parent (id int PRIMARY KEY);
    CREATE TABLE child (id int PRIMARY KEY, pid int REFERENCES parent(id) ON UPDATE CASCADE);
    INSERT INTO parent VALUES (1);
    INSERT INTO child VALUES (1, 1);
    UPDATE parent SET id = 2;
    SELECT pid FROM child;
}
expect {
    2
}
expect @tursopg {
    1
}

# D-08 (S1): FK to non-PK unique column
# Fails while foreign keys are off, see D-01.
test gap-d-08-fk-to-non-pk-unique-column {
    CREATE TABLE parent (id int PRIMARY KEY, code text UNIQUE);
    CREATE TABLE child (id int PRIMARY KEY, code text REFERENCES parent(code));
    INSERT INTO parent VALUES (1, 'x');
    INSERT INTO child VALUES (1, 'nope');
}
@sqlstate 23503
expect error {}
expect @tursopg {
}

# D-09: PK duplicate
test gap-d-09-pk-duplicate {
    CREATE TABLE t (id int PRIMARY KEY);
    INSERT INTO t VALUES (1);
    INSERT INTO t VALUES (1);
}
@sqlstate 23505
expect error {}

# D-10: named UNIQUE constraint duplicate
test gap-d-10-named-unique-constraint-duplicate {
    CREATE TABLE t (id int, code text, CONSTRAINT t_code_uq UNIQUE (code));
    INSERT INTO t VALUES (1, 'a');
    INSERT INTO t VALUES (2, 'a');
}
@sqlstate 23505
expect error {}

# D-11: unique index duplicate
test gap-d-11-unique-index-duplicate {
    CREATE TABLE t (id int, email text);
    CREATE UNIQUE INDEX t_email_idx ON t (email);
    INSERT INTO t VALUES (1, 'a');
    INSERT INTO t VALUES (2, 'a');
}
@sqlstate 23505
expect error {}

# D-12: expression unique index duplicate
test gap-d-12-expression-unique-index-duplicate {
    CREATE TABLE t (id int, email text);
    CREATE UNIQUE INDEX t_lower_email_idx ON t (lower(email));
    INSERT INTO t VALUES (1, 'a');
    INSERT INTO t VALUES (2, 'A');
}
@sqlstate 23505
expect error {}

# D-13: composite UNIQUE duplicate
test gap-d-13-composite-unique-duplicate {
    CREATE TABLE t (a int, b int, UNIQUE (a, b));
    INSERT INTO t VALUES (1, 1);
    INSERT INTO t VALUES (1, 1);
}
@sqlstate 23505
expect error {}

# D-14: NOT NULL on insert
test gap-d-14-not-null-on-insert {
    CREATE TABLE t (id int, s text NOT NULL);
    INSERT INTO t VALUES (1, NULL);
}
@sqlstate 23502
expect error {}

# D-15: NOT NULL on update
test gap-d-15-not-null-on-update {
    CREATE TABLE t (id int, s text NOT NULL);
    INSERT INTO t VALUES (1, 'a');
    UPDATE t SET s = NULL;
}
@sqlstate 23502
expect error {}

# D-16: CHECK unnamed (column)
test gap-d-16-check-unnamed-column {
    CREATE TABLE t (qty int CHECK (qty > 0));
    INSERT INTO t VALUES (-1);
}
@sqlstate 23514
expect error {}

# D-17: CHECK named
test gap-d-17-check-named {
    CREATE TABLE t (qty int, CONSTRAINT qty_positive CHECK (qty > 0));
    INSERT INTO t VALUES (-1);
}
@sqlstate 23514
expect error {}

# D-18: CHECK unnamed (table)
test gap-d-18-check-unnamed-table {
    CREATE TABLE t (a int, b int, CHECK (a < b));
    INSERT INTO t VALUES (2, 1);
}
@sqlstate 23514
expect error {}

# D-19: enum invalid value
test gap-d-19-enum-invalid-value {
    CREATE TYPE mood AS ENUM ('happy', 'sad');
    CREATE TABLE t (m mood);
    INSERT INTO t VALUES ('angry');
}
@sqlstate 22P02
expect error {}

# D-20: enum invalid literal cast
test gap-d-20-enum-invalid-literal-cast {
    CREATE TYPE mood AS ENUM ('happy', 'sad');
    SELECT 'angry'::mood;
}
@sqlstate 22P02
expect error {}

# D-21: domain CHECK violation
test gap-d-21-domain-check-violation {
    CREATE DOMAIN posint AS integer CHECK (VALUE > 0);
    CREATE TABLE t (n posint);
    INSERT INTO t VALUES (-1);
}
@sqlstate 23514
expect error {}

