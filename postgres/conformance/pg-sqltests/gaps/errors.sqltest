# D-31: char(n) too long
@compat-gap "type:bpchar"
test char-n-too-long {
    CREATE TABLE t (s char(3));
    INSERT INTO t VALUES ('abcd');
}
@sqlstate 22001
expect error {}
@sqlstate 0A000
expect @tursopg error {}

# D-32: numeric(p,s) overflow
@compat-gap "type:numeric"
test numeric-p-s-overflow {
    CREATE TABLE t (n numeric(5,2));
    INSERT INTO t VALUES (12345.678);
}
@sqlstate 22003
expect error {}
@sqlstate 23000
expect @tursopg error {}

