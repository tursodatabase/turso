# D-40: insert into identity ALWAYS column
test insert-into-identity-always-column {
    CREATE TABLE t (id int GENERATED ALWAYS AS IDENTITY, s text);
    INSERT INTO t (id, s) VALUES (5, 'x');
}
@sqlstate 428C9
expect error {}

# D-41: insert into generated column
test insert-into-generated-column {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    INSERT INTO t (a, b) VALUES (1, 5);
}
@sqlstate 428C9
expect error {}

# D-42: write in READ ONLY transaction
test write-in-read-only-transaction {
    CREATE TABLE t (id int);
    BEGIN READ ONLY;
    INSERT INTO t VALUES (1);
}
@sqlstate 25006
expect error {}

