    unknown
}

# E-26: domain in pg_type typtype d
test gap-e-26-domain-in-pg-type-typtype-d {
    CREATE DOMAIN posint AS integer CHECK (VALUE > 0);
    SELECT typname, typtype, format_type(typbasetype, NULL) FROM pg_type WHERE typname = 'posint';
}
expect {
    posint|d|integer
}

# E-27 (S4): domain column format_type
test gap-e-27-domain-column-format-type {
    CREATE DOMAIN posint AS integer CHECK (VALUE > 0);
    CREATE TABLE t (n posint);
    SELECT format_type(atttypid, atttypmod) FROM pg_attribute WHERE attrelid = (SELECT oid FROM pg_class WHERE relname = 't') AND attname = 'n';
}
