# E-33: pg_class rows for non-public schema
@setup schema_api_api_items_id
test gap-e-33-pg-class-rows-for-non-public-schema {
    SELECT c.relname, n.nspname FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname = 'api' AND c.relkind = 'r';
}
