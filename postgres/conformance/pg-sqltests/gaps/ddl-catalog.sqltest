# E-79: REINDEX
@compat-gap "syntax:reindex"
test reindex {
    CREATE TABLE t (id int, s text);
    CREATE INDEX t_s_idx ON t (s);
    INSERT INTO t VALUES (1, 'a');
    REINDEX TABLE t;
}
