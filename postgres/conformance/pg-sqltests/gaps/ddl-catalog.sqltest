# CREATE TYPE and CREATE DOMAIN create in the first schema of search_path,
# but tursopg keeps every type in public. A table of public with the name
# does not matter.
@compat-gap "syntax:create-type"
test create-type-in-the-first-schema-of-search-path {
    CREATE SCHEMA api;
    CREATE TABLE public.mood (a int);
    SET search_path = api;
    CREATE TYPE mood AS ENUM ('sad', 'happy');
    SELECT n.nspname FROM pg_type t JOIN pg_namespace n ON n.oid = t.typnamespace
    WHERE t.typname = 'mood' ORDER BY 1;
}
expect {
    api
    public
}
@sqlstate 0A000
expect @tursopg error {}

