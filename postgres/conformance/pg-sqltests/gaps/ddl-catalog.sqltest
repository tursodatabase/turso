    CREATE DOMAIN positive AS int CHECK (VALUE > 0);
}
expect {
}
@sqlstate 0A000
expect @tursopg error {}

# A quoted name keeps its letter case in PostgreSQL, so a type and a relation
# whose names differ only in case are two names. tursopg folds the name of a
# type to lower case and finds types and relations by a name in any case, so
# it refuses the second statement.
@compat-gap "syntax:quoted-identifier"
test a-type-after-a-table-whose-name-differs-in-case {
    CREATE TABLE "Mood" (a int);
    CREATE TYPE mood AS ENUM ('sad', 'happy');
    SELECT typname FROM pg_type WHERE typname IN ('mood', 'Mood') ORDER BY 1;
}
expect {
    Mood
    mood
}
@sqlstate 0A000
expect @tursopg error {}

