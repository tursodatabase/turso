# E-109 (S4): table and column privilege functions
test gap-e-109-table-and-column-privilege-functions {
    CREATE ROLE gap_e_109_reader;
    CREATE TABLE t (id int PRIMARY KEY, s text);
    GRANT SELECT ON t TO gap_e_109_reader;
    SELECT has_table_privilege('gap_e_109_reader', 't', 'SELECT'),
           has_table_privilege('gap_e_109_reader', 't', 'INSERT'),
           has_any_column_privilege('gap_e_109_reader', 't', 'SELECT'),
           has_column_privilege('gap_e_109_reader', 't', 's', 'SELECT');
}
expect {
    t|f|t|t
}
@sqlstate 42883
expect @tursopg error {}

