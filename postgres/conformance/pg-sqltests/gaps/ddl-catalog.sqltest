# E-14: generated STORED column value
test generated-stored-column-value {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    INSERT INTO t (a) VALUES (3);
    SELECT a, b FROM t;
}
expect {
    3|6
}

# E-15: identity ALWAYS column assigns ids
test identity-always-column-assigns-ids {
    CREATE TABLE t (id int GENERATED ALWAYS AS IDENTITY, s text);
    INSERT INTO t (s) VALUES ('a'), ('b');
    SELECT id, s FROM t ORDER BY id;
}
expect {
    1|a
    2|b
}

# E-16: identity BY DEFAULT accepts explicit
test identity-by-default-accepts-explicit {
    CREATE TABLE t (id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, s text);
    INSERT INTO t (id, s) VALUES (10, 'a');
    INSERT INTO t (s) VALUES ('b');
    SELECT id FROM t ORDER BY id;
}
expect {
    1
    10
}

# E-17: identity in pg_attribute.attidentity
test identity-in-pg-attribute-attidentity {
    CREATE TABLE t (id int GENERATED ALWAYS AS IDENTITY, s text);
    SELECT attname, attidentity FROM pg_attribute WHERE attrelid = (SELECT oid FROM pg_class WHERE relname = 't') AND attnum > 0 ORDER BY attnum;
}
expect {
    id|a
    s|
}

# E-18: generated column in pg_attribute.attgenerated
test generated-column-in-pg-attribute-attgenerated {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    SELECT attname, attgenerated FROM pg_attribute WHERE attrelid = (SELECT oid FROM pg_class WHERE relname = 't') AND attnum > 0 ORDER BY attnum;
}
expect {
    a|
    b|s
}

