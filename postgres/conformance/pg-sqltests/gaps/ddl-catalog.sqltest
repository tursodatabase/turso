# E-28 (S4): serial column default in pg_attrdef
@setup t_id_serial
test gap-e-28-serial-column-default-in-pg-attrdef {
    SELECT pg_get_expr(adbin, adrelid) FROM pg_attrdef WHERE adrelid = (SELECT oid FROM pg_class WHERE relname = 't');
}
expect {
    nextval('t_id_seq'::regclass)
}
expect @tursopg {
    nextval ('__turso_ns1_t_id_seq')
}

# E-29 (S4): serial internal tables visible
@setup t_id_serial
test gap-e-29-serial-internal-tables-visible {
    SELECT relname, relkind FROM pg_class WHERE relnamespace = (SELECT oid FROM pg_namespace WHERE nspname = 'public') ORDER BY relname;
}
expect {
    t|r
    t_id_seq|S
    t_pkey|i
}
expect @tursopg {
    __turso_internal_pk_index_t|i
    t|r
    t_id_seq|S
}

# E-30 (S4): format_type with typmod
test gap-e-30-format-type-with-typmod {
    CREATE TABLE t (n numeric(10,2), v varchar(5), ts timestamptz, j jsonb, u uuid, a text[]);
    SELECT attname, format_type(atttypid, atttypmod) FROM pg_attribute WHERE attrelid = (SELECT oid FROM pg_class WHERE relname = 't') AND attnum > 0 ORDER BY attnum;
}
expect {
    n|numeric(10,2)
    v|character varying(5)
    ts|timestamp with time zone
    j|jsonb
    u|uuid
    a|text[]
}
expect @tursopg {
    n|numeric
    v|character varying
    ts|timestamp with time zone
    j|jsonb
    u|uuid
    a|text
}

