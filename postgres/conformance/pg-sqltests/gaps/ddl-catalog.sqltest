}

# E-34: pg_attribute rows for non-public schema
test gap-e-34-pg-attribute-rows-for-non-public-schema {
    CREATE SCHEMA api;
    CREATE TABLE api.items (id int PRIMARY KEY, s text);
    SELECT a.attname FROM pg_attribute a JOIN pg_class c ON c.oid = a.attrelid JOIN pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname = 'api' AND c.relkind = 'r' AND a.attnum > 0 ORDER BY a.attnum;
}
expect {
    id
    s
}

