# Known tursopg gaps against PostgreSQL: E. DDL & catalog
#
# The default `expect` block is the PostgreSQL result. An `expect @tursopg`
# block is the current wrong tursopg result. When you fix a gap, delete its
# `@tursopg` block in the same change. See postgres/CONTRIBUTING.md.
# A test without an `@tursopg` block matches PostgreSQL and guards against
# regressions.

@database :memory:

setup t_id_s_with_rows {
    CREATE TABLE t (id int PRIMARY KEY, s text);
    INSERT INTO t VALUES (1, 'a');
}

setup t_id {
    CREATE TABLE t (id int);
}

setup t_id_view_v {
    CREATE TABLE t (id int);
    CREATE VIEW v AS SELECT id FROM t;
}

setup type_mood {
    CREATE TYPE mood AS ENUM ('happy', 'sad');
}

setup t_id_serial {
    CREATE TABLE t (id serial PRIMARY KEY);
}

setup schema_api_api_items_id {
    CREATE SCHEMA api;
    CREATE TABLE api.items (id int PRIMARY KEY);
}

setup p_a_b_c_x_y_fkey {
    CREATE TABLE p (a int, b int, PRIMARY KEY (a, b));
    CREATE TABLE c (x int, y int, CONSTRAINT c_xy_fkey FOREIGN KEY (x, y) REFERENCES p (a, b));
}

@backend postgres
setup auth_uid_on_postgres {
    CREATE SCHEMA auth;
    CREATE FUNCTION auth.uid() RETURNS uuid LANGUAGE sql STABLE AS $$ SELECT nullif(current_setting('request.jwt.claim.sub', true), '')::uuid $$;
}

@backend postgres
setup auth_uid_from_claims_on_postgres {
    CREATE SCHEMA auth;
    CREATE FUNCTION auth.uid() RETURNS uuid LANGUAGE sql STABLE AS $$ SELECT coalesce(nullif(current_setting('request.jwt.claim.sub', true), ''), (nullif(current_setting('request.jwt.claims', true), '')::jsonb ->> 'sub'))::uuid $$;
}

setup t_id_s_policy_p {
    CREATE TABLE t (id int PRIMARY KEY, s text);
    CREATE POLICY p ON t USING (true);
}

# E-01: ALTER TABLE ADD COLUMN with DEFAULT backfills
test gap-e-01-alter-table-add-column-with-default-backfills {
    CREATE TABLE t (id int PRIMARY KEY, s text);
    INSERT INTO t VALUES (1, 'a');
    ALTER TABLE t ADD COLUMN n int NOT NULL DEFAULT 7;
    SELECT n FROM t;
}
expect {
    7
}

# E-02: ALTER TABLE DROP COLUMN
@setup t_id_s_with_rows
test gap-e-02-alter-table-drop-column {
    ALTER TABLE t DROP COLUMN s;
}
expect {
}

