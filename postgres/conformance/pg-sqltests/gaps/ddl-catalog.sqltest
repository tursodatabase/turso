# E-55: SAVEPOINT / ROLLBACK TO
test gap-e-55-savepoint-rollback-to {
    CREATE TABLE t (id int);
    BEGIN;
    INSERT INTO t VALUES (1);
    SAVEPOINT s1;
    INSERT INTO t VALUES (2);
    ROLLBACK TO SAVEPOINT s1;
    SELECT count(*) FROM t;
}
expect {
    1
}

