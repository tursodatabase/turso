    hello
}

# E-41: COMMENT ON COLUMN + col_description
test comment-on-column-col-description {
    CREATE TABLE t (id int);
    COMMENT ON COLUMN t.id IS 'pk';
    SELECT col_description((SELECT oid FROM pg_class WHERE relname = 't'), 1);
}
expect {
    pk
}

