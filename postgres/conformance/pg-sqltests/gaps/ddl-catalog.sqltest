# E-107 (S2): PL/pgSQL trigger function
# Fails because CREATE FUNCTION is not supported, see E-46.
test gap-e-107-pl-pgsql-trigger-function {
    CREATE TABLE users (id int PRIMARY KEY, meta jsonb);
    CREATE TABLE profiles (id int PRIMARY KEY, first_name text);
    CREATE FUNCTION handle_new_user() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
      INSERT INTO profiles (id, first_name) VALUES (new.id, new.meta ->> 'first_name');
      RETURN new;
    END;
    $$;
    CREATE TRIGGER on_user_created AFTER INSERT ON users FOR EACH ROW EXECUTE FUNCTION handle_new_user();
    INSERT INTO users VALUES (1, '{"first_name":"Ada"}');
    SELECT id, first_name FROM profiles;
}
expect {
    1|Ada
}
@sqlstate 0A000
expect @tursopg error {}

