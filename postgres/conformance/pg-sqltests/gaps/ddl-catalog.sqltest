# E-51: pg_get_indexdef
@compat-gap "function:pg_get_indexdef"
test pg-get-indexdef {
    CREATE TABLE t (id int, s text);
    CREATE UNIQUE INDEX t_s_idx ON t (s) WHERE id > 0;
    SELECT pg_get_indexdef((SELECT oid FROM pg_class WHERE relname = 't_s_idx'));
}
expect {
    CREATE UNIQUE INDEX t_s_idx ON public.t USING btree (s) WHERE (id > 0)
}
expect @tursopg {
    CREATE UNIQUE INDEX t_s_idx ON public.t USING btree (s) WHERE id > 0
}

# E-52: pg_get_constraintdef FK
test pg-get-constraintdef-fk {
    CREATE TABLE p (id int PRIMARY KEY);
    CREATE TABLE c (pid int CONSTRAINT c_pid_fkey REFERENCES p(id) ON DELETE CASCADE);
    SELECT pg_get_constraintdef(oid) FROM pg_constraint WHERE conname = 'c_pid_fkey';
}
expect {
    FOREIGN KEY (pid) REFERENCES p(id) ON DELETE CASCADE
}

