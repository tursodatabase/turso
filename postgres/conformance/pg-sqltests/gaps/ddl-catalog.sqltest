# E-25 (S4): enum column atttypid/format_type
test gap-e-25-enum-column-atttypid-format-type {
    CREATE TYPE mood AS ENUM ('happy', 'sad');
    CREATE TABLE t (m mood);
    SELECT format_type(atttypid, atttypmod) FROM pg_attribute WHERE attrelid = (SELECT oid FROM pg_class WHERE relname = 't') AND attname = 'm';
}
