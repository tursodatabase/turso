}
expect {
    items_id_not_null|n
    items_pkey|p
}
expect @tursopg {
}

# E-37: cross-schema FK (public -> auth)
test gap-e-37-cross-schema-fk-public-auth {
    CREATE SCHEMA IF NOT EXISTS auth;
    CREATE TABLE auth.users (id uuid PRIMARY KEY);
    CREATE TABLE profiles (id uuid PRIMARY KEY REFERENCES auth.users(id));
    INSERT INTO auth.users VALUES ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11');
    INSERT INTO profiles VALUES ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11') RETURNING id;
}
expect {
    a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
}

# E-38 (S1): cross-schema FK rejects orphan
# Fails while foreign keys are off, see D-01.
test gap-e-38-cross-schema-fk-rejects-orphan {
    CREATE SCHEMA IF NOT EXISTS auth;
    CREATE TABLE auth.users (id uuid PRIMARY KEY);
    CREATE TABLE profiles (id uuid PRIMARY KEY REFERENCES auth.users(id));
    INSERT INTO profiles VALUES ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11');
}
@sqlstate 23503
expect error {}
expect @tursopg {
}

# E-39 (S4): FK in pg_constraint confrelid/conkey/confkey
test gap-e-39-fk-in-pg-constraint-confrelid-conkey-confkey {
    CREATE TABLE p (id int PRIMARY KEY);
    CREATE TABLE c (id int, pid int CONSTRAINT c_pid_fkey REFERENCES p(id));
    SELECT conname, confrelid = (SELECT oid FROM pg_class WHERE relname = 'p'), conkey::text, confkey::text FROM pg_constraint WHERE contype = 'f';
}
expect {
    c_pid_fkey|t|{2}|{1}
}
expect @tursopg {
    c_pid_fkey|1|2|1
}

# E-40 (S4): COMMENT ON TABLE + obj_description
test gap-e-40-comment-on-table-obj-description {
    CREATE TABLE t (id int);
    COMMENT ON TABLE t IS 'hello';
    SELECT obj_description((SELECT oid FROM pg_class WHERE relname = 't'), 'pg_class');
}
expect {
    hello
}
expect @tursopg {
}

# E-41 (S4): COMMENT ON COLUMN + col_description
test gap-e-41-comment-on-column-col-description {
    CREATE TABLE t (id int);
    COMMENT ON COLUMN t.id IS 'pk';
    SELECT col_description((SELECT oid FROM pg_class WHERE relname = 't'), 1);
}
expect {
    pk
}
expect @tursopg {
}

