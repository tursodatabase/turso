# B-92: date_trunc / extract
@compat-gap "function:extract"
test date-trunc-extract {
    SELECT date_trunc('day', '2026-10-08 12:34:56+00'::timestamptz), extract(year FROM '2026-10-08'::date), extract(epoch FROM '1970-01-02 00:00:00+00'::timestamptz);
}
expect {
    2026-10-08 00:00:00+00|2026|86400.000000
}
@sqlstate 42883
expect @tursopg error {
    no such function: extract
}

# date_trunc(text, timestamp) returns a timestamp.
test date-trunc-timestamp {
    SELECT date_trunc('hour', '2026-10-08 12:34:56'::timestamp)::text;
}
expect {
    2026-10-08 12:00:00
}

# date_trunc of a domain over timestamp returns the base type, timestamp.
test date-trunc-domain-over-timestamp {
    CREATE DOMAIN trunc_ts AS timestamp;
    CREATE TABLE trunc_domain_events (at trunc_ts);
    INSERT INTO trunc_domain_events VALUES ('2026-10-08 12:34:56');
    SELECT date_trunc('day', at) FROM trunc_domain_events;
}
expect {
    2026-10-08 00:00:00
}

