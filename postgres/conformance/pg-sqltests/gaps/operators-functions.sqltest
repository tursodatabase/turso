# Known tursopg gaps against PostgreSQL: B. Operators & functions
#
# Each test with a `@compat-gap "<kind>:<object>"` label records a known
# difference: its default `expect` block is PostgreSQL 18's answer and its
# `expect @tursopg` block is tursopg's current wrong answer. When tursopg
# gives the PostgreSQL answer, the tursopg run fails with "gap fixed": then
# delete only `@compat-gap` and the `expect @tursopg` block, and keep the
# test. A test without `@compat-gap` matches PostgreSQL and guards against
# regressions. The `# X-NN` comments are the IDs from the audit that found
# each gap.

@database :memory:

setup t_id_s_n_arr_ia_j_ok_with_rows {
    CREATE TABLE t (id int PRIMARY KEY, s text, n int, arr text[], ia int[], j jsonb, ok boolean);
    INSERT INTO t VALUES (1, 'abc', 10, '{a,b}', '{1,2}', '{"a":{"b":1},"n":1,"tags":["x","y"]}', true), (2, 'Abd', NULL, '{c}', '{3}', '{"a":2,"n":2}', false), (3, 'a_c', 30, '{}', '{}', NULL, NULL), (4, 'a%c', 5, NULL, NULL, '[1,2]', NULL);
}

setup v_x_with_rows {
    CREATE TABLE v (x int);
    INSERT INTO v VALUES (1), (NULL), (2);
}

@backend postgres
setup auth_role_from_claims_on_postgres {
    CREATE SCHEMA auth;
    CREATE FUNCTION auth.role() RETURNS text LANGUAGE sql STABLE AS $$ SELECT coalesce(nullif(current_setting('request.jwt.claim.role', true), ''), (nullif(current_setting('request.jwt.claims', true), '')::jsonb ->> 'role'))::text $$;
}

# B-01: = NULL yields no rows; IS NULL
@setup t_id_s_n_arr_ia_j_ok_with_rows
test null-yields-no-rows-is-null {
    SELECT id FROM t WHERE n = NULL OR (id = 2 AND n IS NULL) ORDER BY id;
}
expect {
    2
}

# B-02: IS DISTINCT FROM
@setup t_id_s_n_arr_ia_j_ok_with_rows
test is-distinct-from {
    SELECT id FROM t WHERE n IS DISTINCT FROM 10 ORDER BY id;
}
expect {
    2
    3
    4
}

# B-03: IS NOT DISTINCT FROM NULL
@setup t_id_s_n_arr_ia_j_ok_with_rows
test is-not-distinct-from-null {
    SELECT id FROM t WHERE n IS NOT DISTINCT FROM NULL;
}
expect {
    2
}

