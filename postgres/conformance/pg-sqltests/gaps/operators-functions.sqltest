    CREATE TABLE x (g int, v text);
    INSERT INTO x VALUES (1, 'b'), (1, 'a'), (2, 'c');
    SELECT DISTINCT ON (g) g, v FROM x ORDER BY g, v;
}
expect {
    1|a
    2|c
}

