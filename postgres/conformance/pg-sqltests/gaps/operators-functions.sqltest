# B-124: 64 nested scalar subqueries
@compat-gap "syntax:nested-subquery"
test nested-scalar-subqueries-64-deep {
    SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT 1))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))));
}
expect {
    1
}
@sqlstate 42601
expect @tursopg error {}

# B-126: auth.role() reads the role claim
@setup auth_role_from_claims_on_postgres
@compat-gap "syntax:create-function"
test auth-role-reads-the-role-claim {
    SELECT set_config('request.jwt.claims', '{"sub":"a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11","email":"a@b.co","role":"authenticated"}', false);
    SELECT auth.role();
}
expect {
    {"sub":"a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11","email":"a@b.co","role":"authenticated"}
    authenticated
}
@sqlstate 42883
expect @tursopg error {}

# B-128: jsonb || concatenates two objects
# B-122 also uses ||. tursopg concatenates the text of the two values.
@compat-gap "operator:jsonb || jsonb"
test jsonb-concatenates-two-objects {
    SELECT '{"a":1}'::jsonb || '{"b":2}'::jsonb;
}
expect {
    {"a": 1, "b": 2}
}
expect @tursopg {
    {"a": 1}{"b": 2}
}

# B-129: jsonb - removes a key
# B-122 also uses -.
@compat-gap "operator:jsonb - text"
test jsonb-removes-a-key {
    SELECT '{"a":1,"b":2}'::jsonb - 'a';
}
expect {
    {"b": 2}
}
@sqlstate 42883
expect @tursopg error {
    operator does not exist: jsonb - text
}

# B-130: 16 nested scalar subqueries
# Same cause as B-124. tursopg accepts 15 levels, so this is the first depth that fails.
@compat-gap "syntax:nested-subquery"
test nested-scalar-subqueries-16-deep {
    SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT (SELECT 1))))))))))))))));
}
expect {
    1
}
@sqlstate 42601
expect @tursopg error {}

# B-131: pg_options_to_table with a column alias list
@compat-gap "function:pg_options_to_table"
test pg-options-to-table-with-a-column-alias-list {
    SELECT o.k, o.v FROM pg_options_to_table(ARRAY['a=1']) AS o(k, v);
}
expect {
    a|1
}
@sqlstate 0A000
expect @tursopg error {}

# B-132: pg_size_pretty
@compat-gap "function:pg_size_pretty"
test pg-size-pretty {
    SELECT pg_size_pretty(8192::bigint), pg_size_pretty(10485760::bigint);
}
expect {
    8192 bytes|10 MB
}
@sqlstate 42883
expect @tursopg error {}

# to_char with the numeric format patterns: PostgreSQL's answers recorded
# below come from PostgreSQL 18; the tursopg answers are filled in from a run.
@compat-gap "function:to_char"
test to-char-group-separator-bigint {
    SELECT to_char(100000::bigint, '999,999');
}
expect raw {
 100,000
}
expect @tursopg raw {
 100000
}

@compat-gap "function:to_char"
test to-char-fm-no-leading-space {
    SELECT to_char(12, 'FM999');
}
expect {
    12
}
expect @tursopg raw {
 12
}

@compat-gap "function:to_char"
test to-char-overflow-hashes {
    SELECT to_char(12345, '999'), to_char(99.99, '9.9');
}
expect raw {
 ###| #.#
}
expect @tursopg raw {
 12345| 100.0
}

@compat-gap "function:to_char"
test to-char-unknown-literal-is-ambiguous {
    SELECT to_char('12', '99');
}
@sqlstate 42725
expect error {
    function to_char\(unknown, unknown\) is not unique
}
expect @tursopg raw {
 12
}

# Unquoted C folds to c, and PostgreSQL has no collation named "c".
@compat-gap "syntax:collate"
test unquoted-collate-c-does-not-exist {
    SELECT 'a' COLLATE C;
}
@sqlstate 42704
expect error {}
expect @tursopg {
    a
}

# The default collation of the database is en_US.utf8 in PostgreSQL 18;
# tursopg compares text bytewise, so uppercase sorts before lowercase.
@compat-gap "operator:text < text"
test text-order-by-uses-database-collation {
    SELECT x FROM (VALUES ('b'), ('B'), ('a'), ('A')) v(x) ORDER BY x;
}
expect {
    a
    A
    b
    B
}
expect @tursopg {
    A
    B
    a
    b
}

@compat-gap "function:pg_is_in_recovery"
test pg-is-in-recovery-is-false-on-a-primary {
    SELECT pg_is_in_recovery();
}
expect {
    f
}
expect @tursopg {
    t
}
