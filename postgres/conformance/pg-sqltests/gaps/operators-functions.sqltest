}
expect {
    |3|a
}

# B-94: lower/upper non-ASCII
@compat-gap "function:upper"
test lower-upper-non-ascii {
    SELECT upper('äb'), lower('ÄB');
}
expect {
    ÄB|äb
}
expect @tursopg {
    äB|Äb
}

# B-95: string comparison order
@compat-gap "operator:text < text"
test string-comparison-order {
    SELECT 'a' < 'B', 'B' < 'a';
}
expect {
    t|f
}
expect @tursopg {
    f|t
}

# B-96: length / char_length bytes vs chars
test length-char-length-bytes-vs-chars {
    SELECT length('é'), octet_length('é');
}
expect {
    1|2
}

# B-98: pg_catalog.-qualified function
test pg-catalog-qualified-function {
    SELECT pg_catalog.lower('A');
}
expect {
    a
}

# B-99: DELETE ... USING
@setup t_id_s_n_arr_ia_j_ok_with_rows
@compat-gap "syntax:delete-using"
test delete-using {
    DELETE FROM t USING t AS t2 WHERE t.id = t2.id AND t2.id = 1 RETURNING t.id;
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {}

# B-100: TRUNCATE a, b
@compat-gap "syntax:truncate"
test truncate-a-b {
    CREATE TABLE a (x int);
    CREATE TABLE b (x int);
    INSERT INTO a VALUES (1);
    INSERT INTO b VALUES (1);
    TRUNCATE a, b;
    SELECT (SELECT count(*) FROM a), (SELECT count(*) FROM b);
}
expect {
    0|0
}
@sqlstate 0A000
expect @tursopg error {}

# B-101: UPDATE ... FROM
@setup t_id_s_n_arr_ia_j_ok_with_rows
test update-from {
    UPDATE t SET n = t2.n + 1 FROM t AS t2 WHERE t2.id = 3 AND t.id = 1 RETURNING t.id, t.n;
}
expect {
    1|31
}

# B-102: INSERT ON CONFLICT DO UPDATE with EXCLUDED + WHERE
@setup t_id_s_n_arr_ia_j_ok_with_rows
test insert-on-conflict-do-update-with-excluded-where {
    INSERT INTO t (id, s) VALUES (1, 'new') ON CONFLICT (id) DO UPDATE SET s = EXCLUDED.s WHERE t.n = 10 RETURNING id, s;
}
expect {
    1|new
}

# B-103: ON CONFLICT ON CONSTRAINT name
@compat-gap "syntax:on-conflict"
test on-conflict-on-constraint-name {
    CREATE TABLE u (id int, CONSTRAINT u_id_key UNIQUE (id));
    INSERT INTO u VALUES (1);
    INSERT INTO u VALUES (1) ON CONFLICT ON CONSTRAINT u_id_key DO NOTHING RETURNING id;
}
expect {
}
@sqlstate 0A000
expect @tursopg error {}

# B-104: INSERT DEFAULT VALUES
test insert-default-values {
    CREATE TABLE u (id serial PRIMARY KEY, s text DEFAULT 'x');
    INSERT INTO u DEFAULT VALUES RETURNING id, s;
}
expect {
    1|x
}

# B-105: UPDATE multi-column SET (a,b) = (..)
@setup t_id_s_n_arr_ia_j_ok_with_rows
test update-multi-column-set-a-b {
    UPDATE t SET (s, n) = ('z', 0) WHERE id = 1 RETURNING s, n;
}
expect {
    z|0
}

# B-117: VALUES list with column aliases v(x)
test values-list-with-column-aliases-v-x {
    SELECT x FROM (VALUES (1), (2)) v(x) ORDER BY x;
}
expect {
    1
    2
}

# B-120: jsonb_array_elements
@compat-gap "function:jsonb_array_elements"
test jsonb-array-elements {
    SELECT value FROM jsonb_array_elements('[1, {"a": 2}]');
}
expect {
    1
    {"a": 2}
}
@sqlstate 0A000
expect @tursopg error {}

# B-121: jsonb_each
@compat-gap "function:jsonb_each"
test jsonb-each {
    SELECT key, value FROM jsonb_each('{"a": 1}');
}
expect {
    a|1
}
@sqlstate 0A000
expect @tursopg error {}

# B-122: jsonb_set / || / - operators
@compat-gap "function:jsonb_set"
test jsonb-set-operators {
    SELECT jsonb_set('{"a":1}', '{a}', '2'), '{"a":1}'::jsonb || '{"b":2}'::jsonb, '{"a":1,"b":2}'::jsonb - 'a';
}
expect {
    {"a": 2}|{"a": 1, "b": 2}|{"b": 2}
}
@sqlstate 42883
expect @tursopg error {}

# B-123: jsonb_typeof / jsonb_array_length
@compat-gap "function:jsonb_typeof"
test jsonb-typeof-jsonb-array-length {
    SELECT jsonb_typeof('[1]'), jsonb_array_length('[1,2]');
}
expect {
    array|2
}
@sqlstate 42883
expect @tursopg error {}

# B-108: generate_series column alias
test generate-series-column-alias {
    SELECT g.x FROM generate_series(1, 2) AS g(x);
}
expect {
    1
    2
}

# B-109: WITH ... INSERT ... RETURNING (data-modifying CTE)
@setup t_id_s_n_arr_ia_j_ok_with_rows
@compat-gap "syntax:with-data-modifying-cte"
test with-insert-returning-data-modifying-cte {
    WITH ins AS (INSERT INTO t (id, s) VALUES (9, 'z') RETURNING id) SELECT id FROM ins;
}
expect {
    9
}
@sqlstate 0A000
expect @tursopg error {}

# B-110: row comparison (a,b) > (x,y) (keyset pagination)
@setup t_id_s_n_arr_ia_j_ok_with_rows
test row-comparison-a-b-x-y-keyset-pagination {
    SELECT id FROM t WHERE (id, s) > (2, 'Abd') ORDER BY id;
}
expect {
    3
    4
}

# B-111: CASE returning bool
test case-returning-bool {
    SELECT CASE WHEN true THEN true ELSE false END;
}
expect {
    t
}

# B-112: json_agg of row subquery
@setup t_id_s_n_arr_ia_j_ok_with_rows
@compat-gap "function:json_agg"
test json-agg-of-row-subquery {
    SELECT coalesce(json_agg(_s), '[]') FROM (SELECT id, s FROM t WHERE id < 3 ORDER BY id) _s;
}
expect raw {
[{"id":1,"s":"abc"}, 
 {"id":2,"s":"Abd"}]
}
@sqlstate 42703
expect @tursopg error {}

# B-113: RETURNING with expressions
@setup t_id_s_n_arr_ia_j_ok_with_rows
test returning-with-expressions {
    UPDATE t SET n = n + 1 WHERE id = 1 RETURNING id, n * 2 AS dbl;
}
expect {
    1|22
}

# B-114: ORDER BY jsonb ->> key
@setup t_id_s_n_arr_ia_j_ok_with_rows
test order-by-jsonb-key {
    SELECT id FROM t WHERE j IS NOT NULL ORDER BY j ->> 'n' DESC NULLS LAST, id;
}
expect {
    2
    1
    4
}

# B-115: text concat with typed values
test text-concat-with-typed-values {
    SELECT 'id=' || 1::int || ' at ' || '2026-10-08'::date;
}
expect {
    id=1 at 2026-10-08
}

# B-116: to_char(timestamptz)
@compat-gap "function:to_char"
test to-char-timestamptz {
    SELECT to_char('2026-10-08 12:00:00+00'::timestamptz, 'YYYY-MM-DD HH24:MI');
}
expect {
    2026-10-08 12:00
}
@sqlstate 0A000
expect @tursopg error {}

# PostgreSQL has no to_char for boolean, text or jsonb. tursopg decides from
# each row's value, so it formats a row that holds a number and returns NULL
# for a NULL row.
@compat-gap "function:to_char"
test to-char-boolean-column {
    CREATE TABLE to_char_flags (flag boolean);
    INSERT INTO to_char_flags VALUES (true);
    SELECT to_char(flag, '99') FROM to_char_flags;
}
@sqlstate 42883
expect error {
    function to_char\(boolean, unknown\) does not exist
}
expect @tursopg raw {
  1
}

@compat-gap "function:to_char"
test to-char-text-column {
    CREATE TABLE to_char_texts (t text);
    INSERT INTO to_char_texts VALUES ('12');
    SELECT to_char(t, '99') FROM to_char_texts;
}
@sqlstate 42883
expect error {
    function to_char\(text, unknown\) does not exist
}
expect @tursopg raw {
 12
}

@compat-gap "function:to_char"
test to-char-jsonb-column {
    CREATE TABLE to_char_documents (doc jsonb);
    INSERT INTO to_char_documents VALUES ('12');
    SELECT to_char(doc, '99') FROM to_char_documents;
}
@sqlstate 42883
expect error {
    function to_char\(jsonb, unknown\) does not exist
}
expect @tursopg raw {
 12
}

