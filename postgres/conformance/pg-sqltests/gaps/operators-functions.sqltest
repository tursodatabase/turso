# B-128 (S1): jsonb || concatenates two objects
# B-122 also uses ||. After a fix, the output still differs because of A-45.
test gap-b-128-jsonb-concatenates-two-objects {
    SELECT '{"a":1}'::jsonb || '{"b":2}'::jsonb;
}
expect {
    {"a": 1, "b": 2}
}
expect @tursopg {
    {"a":1}{"b":2}
}

# B-129 (S1): jsonb - removes a key
# B-122 also uses -. After a fix, the output still differs because of A-45.
test gap-b-129-jsonb-removes-a-key {
    SELECT '{"a":1,"b":2}'::jsonb - 'a';
}
expect {
    {"b": 2}
}
expect @tursopg {
    0
}

