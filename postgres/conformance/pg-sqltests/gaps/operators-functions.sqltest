# Known tursopg gaps against PostgreSQL: B. Operators & functions
#
# The default `expect` block is the PostgreSQL result. An `expect @tursopg`
# block is the current wrong tursopg result. When you fix a gap, delete its
# `@tursopg` block in the same change. See postgres/CONTRIBUTING.md.
# A test without an `@tursopg` block matches PostgreSQL and guards against
# regressions.

@database :memory:

setup t_id_s_n_arr_ia_j_ok_with_rows {
    CREATE TABLE t (id int PRIMARY KEY, s text, n int, arr text[], ia int[], j jsonb, ok boolean);
    INSERT INTO t VALUES (1, 'abc', 10, '{a,b}', '{1,2}', '{"a":{"b":1},"n":1,"tags":["x","y"]}', true), (2, 'Abd', NULL, '{c}', '{3}', '{"a":2,"n":2}', false), (3, 'a_c', 30, '{}', '{}', NULL, NULL), (4, 'a%c', 5, NULL, NULL, '[1,2]', NULL);
}

setup v_x_with_rows {
    CREATE TABLE v (x int);
    INSERT INTO v VALUES (1), (NULL), (2);
}

@backend postgres
setup auth_role_from_claims_on_postgres {
    CREATE SCHEMA auth;
    CREATE FUNCTION auth.role() RETURNS text LANGUAGE sql STABLE AS $$ SELECT coalesce(nullif(current_setting('request.jwt.claim.role', true), ''), (nullif(current_setting('request.jwt.claims', true), '')::jsonb ->> 'role'))::text $$;
}

# B-01: = NULL yields no rows; IS NULL
@setup t_id_s_n_arr_ia_j_ok_with_rows
test gap-b-01-null-yields-no-rows-is-null {
    SELECT id FROM t WHERE n = NULL OR (id = 2 AND n IS NULL) ORDER BY id;
}
expect {
    2
}

# B-02: IS DISTINCT FROM
@setup t_id_s_n_arr_ia_j_ok_with_rows
test gap-b-02-is-distinct-from {
    SELECT id FROM t WHERE n IS DISTINCT FROM 10 ORDER BY id;
}
expect {
    2
    3
    4
}

# B-03: IS NOT DISTINCT FROM NULL
@setup t_id_s_n_arr_ia_j_ok_with_rows
test gap-b-03-is-not-distinct-from-null {
    SELECT id FROM t WHERE n IS NOT DISTINCT FROM NULL;
}
expect {
    2
}

# B-04 (S1): IS TRUE / IS NOT TRUE on bool col
@setup t_id_s_n_arr_ia_j_ok_with_rows
test gap-b-04-is-true-is-not-true-on-bool-col {
    SELECT id, ok IS TRUE, ok IS NOT TRUE FROM t ORDER BY id;
}
expect {
    1|t|f
    2|f|t
    3|f|t
    4|f|t
}
expect @tursopg {
    1|1|0
    2|0|1
    3|0|1
    4|0|1
}

# B-05: IS UNKNOWN
@setup t_id_s_n_arr_ia_j_ok_with_rows
test gap-b-05-is-unknown {
    SELECT id FROM t WHERE ok IS UNKNOWN ORDER BY id;
}
expect {
    3
    4
}

# B-06: LIKE is case-sensitive
@setup t_id_s_n_arr_ia_j_ok_with_rows
test gap-b-06-like-is-case-sensitive {
    SELECT id FROM t WHERE s LIKE 'Ab%' ORDER BY id;
}
expect {
    2
}

# B-07 (S1): LIKE case-sensitive literal
test gap-b-07-like-case-sensitive-literal {
    SELECT 'ABC' LIKE 'abc', 'abc' LIKE 'a%', 'abc' LIKE 'A%';
}
expect {
    f|t|f
}
expect @tursopg {
    0|1|0
}

