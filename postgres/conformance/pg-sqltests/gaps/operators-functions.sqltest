    3.3000000000000003
}

# B-92 (S2): date_trunc / extract
test gap-b-92-date-trunc-extract {
    SELECT date_trunc('day', '2026-10-08 12:34:56+00'::timestamptz), extract(year FROM '2026-10-08'::date), extract(epoch FROM '1970-01-02 00:00:00+00'::timestamptz);
}
expect {
    2026-10-08 00:00:00+00|2026|86400.000000
}
@sqlstate 0A000
expect @tursopg error {}

