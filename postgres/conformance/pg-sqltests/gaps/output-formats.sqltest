# Known tursopg gaps against PostgreSQL: C. Output formats
#
# The default `expect` block is the PostgreSQL result. An `expect @tursopg`
# block is the current wrong tursopg result. When you fix a gap, delete its
# `@tursopg` block in the same change. See postgres/CONTRIBUTING.md.
# A test without an `@tursopg` block matches PostgreSQL and guards against
# regressions.

@database :memory:

setup t_b_n_ts_j_jb_arr_u_with_rows {
    CREATE TABLE t (b boolean, n numeric(10,2), ts timestamptz, j json, jb jsonb, arr text[], u uuid);
    INSERT INTO t VALUES (true, 1.5, '2026-10-08T12:00:00Z', '{"x": 1}', '{"y": 2}', '{a}', 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11');
}

# C-01 (S2): boolean true: raw value, inside json_build_object
test gap-c-01-boolean-true-raw-value-inside-json-build-object {
    CREATE TABLE t (v boolean);
    INSERT INTO t VALUES (true);
    SELECT v, json_build_object('v', v) FROM t;
}
expect {
    t|{"v" : true}
}
@sqlstate 42883
expect @tursopg error {}

