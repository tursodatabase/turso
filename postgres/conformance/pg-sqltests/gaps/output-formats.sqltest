# C-40 (S2): json_agg of mixed-type row
@setup t_b_n_ts_j_jb_arr_u_with_rows
test gap-c-40-json-agg-of-mixed-type-row {
    SELECT json_agg(json_build_object('b', b, 'n', n, 'ts', ts, 'j', j, 'jb', jb, 'u', u)) FROM t;
}
expect {
    [{"b" : true, "n" : 1.50, "ts" : "2026-10-08T12:00:00+00:00", "j" : {"x": 1}, "jb" : {"y": 2}, "u" : "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"}]
}
@sqlstate 42883
expect @tursopg error {}

# C-41 (S2): text[] inside json object
@setup t_b_n_ts_j_jb_arr_u_with_rows
test gap-c-41-text-inside-json-object {
    SELECT json_build_object('arr', arr) FROM t;
}
expect {
    {"arr" : ["a"]}
}
@sqlstate 42883
expect @tursopg error {}

# C-42 (S1): ::text cast of each type
@setup t_b_n_ts_j_jb_arr_u_with_rows
test gap-c-42-text-cast-of-each-type {
    SELECT b::text, n::text, ts::text, jb::text, arr::text, u::text FROM t;
}
expect {
    true|1.50|2026-10-08 12:00:00+00|{"y": 2}|{a}|a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
}
expect @tursopg {
    1|1.50|2026-10-08 12:00:00+00|{"y":2}|a|a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
}

# C-43 (S2): result column type of bool comparison via pg_typeof
@setup t_b_n_ts_j_jb_arr_u_with_rows
test gap-c-43-result-column-type-of-bool-comparison-via-pg-typ {
    SELECT pg_typeof(b), pg_typeof(n), pg_typeof(ts), pg_typeof(jb), pg_typeof(arr) FROM t;
}
expect {
    boolean|numeric|timestamp with time zone|jsonb|text[]
}
@sqlstate 42883
expect @tursopg error {}

# C-44 (S2): row_to_json of whole row
@setup t_b_n_ts_j_jb_arr_u_with_rows
test gap-c-44-row-to-json-of-whole-row {
    SELECT row_to_json(t) FROM t;
}
expect {
    {"b":true,"n":1.50,"ts":"2026-10-08T12:00:00+00:00","j":{"x": 1},"jb":{"y": 2},"arr":["a"],"u":"a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"}
}
@sqlstate 42703
expect @tursopg error {}

# C-45 (S1): text[] output of an element with a newline
test gap-c-45-text-output-of-an-element-with-a-newline {
    CREATE TABLE t (v text[]);
    INSERT INTO t VALUES ('{"a
b"}');
    SELECT v, v[1] = 'a' || chr(10) || 'b' FROM t;
}
expect {
    {"a
    b"}|t
}
expect @tursopg {
    {"a\nb"}|1
}
