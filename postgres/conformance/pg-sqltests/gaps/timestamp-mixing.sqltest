# Known tursopg gaps: timestamp mixed with timestamptz. These queries work on
# PostgreSQL 18 and fail on tursopg because interval, ALL (subquery), ANY
# (subquery) with an operator other than = and timestamp subtraction are not
# implemented. The default `expect` block is the PostgreSQL result. When you
# fix a gap, delete its `@tursopg` block in the same change.

@database :memory:

setup tsmix {
    CREATE TABLE t (id int, ts timestamp, tz timestamptz);
    INSERT INTO t VALUES
        (1, '2024-01-05 10:00', '2024-01-05 10:00+00'),
        (2, '2024-01-05 11:00', '2024-01-05 10:00+00'),
        (3, '2024-01-05 09:00:00.5', '2024-01-05 09:00:00.5+00'),
        (4, NULL, '2024-01-05 10:00+00'),
        (5, '0001-01-01 00:00:00', '9999-12-31 23:59:59.999999+00');
}

@setup tsmix
test ts-tz-mix-01 {
    SELECT id FROM t WHERE ts BETWEEN tz AND tz + interval '1 day' ORDER BY id;
}
expect {
    1
    2
    3
}
@sqlstate 0A000
expect @tursopg error {
    type "interval" is not supported
}

@setup tsmix
test ts-tz-mix-02 {
    SELECT id FROM t WHERE tz BETWEEN ts AND ts + interval '1 day' ORDER BY id;
}
expect {
    1
    3
}
@sqlstate 0A000
expect @tursopg error {
    type "interval" is not supported
}

@setup tsmix
test ts-tz-mix-03 {
    SELECT id FROM t WHERE ts BETWEEN tz AND ts + interval '2 hour' ORDER BY id;
}
expect {
    1
    2
    3
}
@sqlstate 0A000
expect @tursopg error {
    type "interval" is not supported
}

@setup tsmix
test ts-tz-mix-04 {
    SELECT id, ts - tz FROM t ORDER BY id;
}
expect {
    1|00:00:00
    2|01:00:00
    3|00:00:00
    4|
    5|-3652058 days -23:59:59.999999
}
@sqlstate 42601
expect @tursopg error {
    operator does not exist: timestamp - timestamptz
}

@setup tsmix
test ts-tz-mix-05 {
    SELECT id, tz - ts FROM t ORDER BY id;
}
expect {
    1|00:00:00
    2|-01:00:00
    3|00:00:00
    4|
    5|3652058 days 23:59:59.999999
}
@sqlstate 42601
expect @tursopg error {
    operator does not exist: timestamptz - timestamp
}

@setup tsmix
test ts-tz-mix-06 {
    SELECT id FROM t WHERE ts = ALL(SELECT tz FROM t WHERE id=1) ORDER BY id;
}
expect {
    1
}
@sqlstate 42601
expect @tursopg error {
    Unsupported SubLink type: AllSublink
}

@setup tsmix
test ts-tz-mix-07 {
    SELECT id FROM t WHERE ts > ANY(SELECT tz FROM t) ORDER BY id;
}
expect {
    1
    2
}
@sqlstate 0A000
expect @tursopg error {
    > ANY/SOME \(subquery\) is not supported
}
