# Known tursopg gaps against PostgreSQL: A. Params & casts
#
# The default `expect` block is the PostgreSQL result. An `expect @tursopg`
# block is the current wrong tursopg result. When you fix a gap, delete its
# `@tursopg` block in the same change. See postgres/CONTRIBUTING.md.
# A test without an `@tursopg` block matches PostgreSQL and guards against
# regressions.

@database :memory:

setup t_id {
    CREATE TABLE t (id int);
}

setup t_b {
    CREATE TABLE t (b boolean);
}

# A-01 (S1): bool literal casts, true forms
test gap-a-01-bool-literal-casts-true-forms {
    SELECT 't'::boolean, 'true'::boolean, 'yes'::boolean, 'on'::boolean, '1'::boolean, 'TRUE'::boolean, 'y'::boolean;
}
expect {
    t|t|t|t|t|t|t
}
expect @tursopg {
    0|0|0|0|1|0|0
}

# A-02 (S1): bool literal casts, false forms
test gap-a-02-bool-literal-casts-false-forms {
    SELECT 'f'::boolean, 'false'::boolean, 'no'::boolean, 'off'::boolean, '0'::boolean;
}
expect {
    f|f|f|f|f
}
expect @tursopg {
    0|0|0|0|0
}

# A-04 (S1): bool invalid literal
test gap-a-04-bool-invalid-literal {
    SELECT 'maybe'::boolean;
}
@sqlstate 22P02
expect error {}
expect @tursopg {
    0
}

# A-06 (S1): CAST(... AS boolean) form
test gap-a-06-cast-as-boolean-form {
    SELECT CAST('true' AS boolean), CAST(1 AS boolean), CAST(0 AS boolean);
}
expect {
    t|t|f
}
expect @tursopg {
    0|1|0
}

# A-07 (S1): int4 overflow literal cast
test gap-a-07-int4-overflow-literal-cast {
    SELECT '2147483648'::int4;
}
@sqlstate 22003
expect error {}
expect @tursopg {
    2147483648
}

# A-08 (S1): int2 overflow literal cast
test gap-a-08-int2-overflow-literal-cast {
    SELECT '40000'::smallint;
}
@sqlstate 22003
expect error {}
expect @tursopg {
    40000
}

# A-09 (S1): int8 overflow arithmetic
test gap-a-09-int8-overflow-arithmetic {
    SELECT 9223372036854775807::bigint + 1;
}
@sqlstate 22003
expect error {}
expect @tursopg {
    9.223372036854776e18
}

# A-10 (S1): int4 overflow arithmetic
test gap-a-10-int4-overflow-arithmetic {
    SELECT 2147483647::int4 + 1;
}
@sqlstate 22003
expect error {}
expect @tursopg {
    2147483648
}

# A-11 (S1): invalid int literal cast
test gap-a-11-invalid-int-literal-cast {
    SELECT 'abc'::integer;
}
@sqlstate 22P02
expect error {}
expect @tursopg {
    0
}

# A-13 (S1): '1.5'::int (text) is invalid
test gap-a-13-1-5-int-text-is-invalid {
    SELECT '1.5'::integer;
}
@sqlstate 22P02
expect error {}
expect @tursopg {
    1
}

# A-14 (S1): numeric->int rounds half away from zero
test gap-a-14-numeric-int-rounds-half-away-from-zero {
    SELECT 1.5::integer, 2.5::integer, (-2.5)::integer;
}
expect {
    2|3|-3
}
expect @tursopg {
    1|2|-2
}

# A-16: int with surrounding spaces
test gap-a-16-int-with-surrounding-spaces {
    SELECT ' 42 '::integer;
}
expect {
    42
}

# A-17 (S1): invalid uuid literal cast
test gap-a-17-invalid-uuid-literal-cast {
    SELECT 'nope'::uuid;
}
@sqlstate 22P02
expect error {}
expect @tursopg {
    nope
}

# A-19 (S1): uuid uppercase input normalised
test gap-a-19-uuid-uppercase-input-normalised {
    SELECT 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11'::uuid;
}
expect {
    a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
}
expect @tursopg {
    A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11
}

# A-20 (S1): uuid braces / no-hyphen input
test gap-a-20-uuid-braces-no-hyphen-input {
    SELECT '{a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11}'::uuid, 'a0eebc999c0b4ef8bb6d6bb9bd380a11'::uuid;
}
expect {
    a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11|a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
}
expect @tursopg {
    {a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11}|a0eebc999c0b4ef8bb6d6bb9bd380a11
}

# A-21 (S1): uuid equality across case
test gap-a-21-uuid-equality-across-case {
    SELECT 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11'::uuid = 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'::uuid;
}
expect {
    t
}
expect @tursopg {
    0
}

# A-22 (S2): numeric(10,2) rounding half away from zero
test gap-a-22-numeric-10-2-rounding-half-away-from-zero {
    SELECT '1.005'::numeric(10,2), '2.675'::numeric(10,2), '-1.005'::numeric(10,2);
}
expect {
    1.01|2.68|-1.01
}
@sqlstate 0A000
expect @tursopg error {}

# A-23 (S2): numeric(10,0) rounding
test gap-a-23-numeric-10-0-rounding {
    SELECT '2.5'::numeric(10,0), '3.5'::numeric(10,0);
}
expect {
    3|4
}
@sqlstate 0A000
expect @tursopg error {}

# A-24 (S1): numeric exact decimal arithmetic
test gap-a-24-numeric-exact-decimal-arithmetic {
    SELECT 0.1::numeric + 0.2::numeric, 1::numeric / 3;
}
expect {
    0.3|0.33333333333333333333
}
expect @tursopg {
    0.30000000000000004|0.3333333333333333
}

# A-25 (S1): numeric big precision
test gap-a-25-numeric-big-precision {
    SELECT '123456789012345678901234567890.123'::numeric;
}
expect {
    123456789012345678901234567890.123
}
expect @tursopg {
    1.2345678901234568e29
}

# A-26 (S3): numeric overflow on typmod
test gap-a-26-numeric-overflow-on-typmod {
    SELECT '123456.1'::numeric(5,2);
}
@sqlstate 22003
expect error {}
@sqlstate 0A000
expect @tursopg error {}

# A-27 (S1): invalid numeric
test gap-a-27-invalid-numeric {
    SELECT 'abc'::numeric;
}
@sqlstate 22P02
expect error {}
expect @tursopg {
    0
}

# A-28 (S1): numeric exponent input
test gap-a-28-numeric-exponent-input {
    SELECT '1e3'::numeric, '1.50'::numeric;
}
expect {
    1000|1.50
}
expect @tursopg {
    1000.0|1.5
}

# A-30: timestamptz literal with +02 offset
test gap-a-30-timestamptz-literal-with-02-offset {
    SELECT '2026-10-08 14:00:00+02'::timestamptz;
}
expect {
    2026-10-08 12:00:00+00
}

# A-31: timestamptz literal with Z
test gap-a-31-timestamptz-literal-with-z {
    SELECT '2026-10-08T12:00:00Z'::timestamptz;
}
expect {
    2026-10-08 12:00:00+00
}

# A-32: timestamptz with +05:30 and micros
test gap-a-32-timestamptz-with-05-30-and-micros {
    SELECT '2026-10-08T12:00:00.123456+05:30'::timestamptz;
}
expect {
    2026-10-08 06:30:00.123456+00
}

# A-34: timestamptz from date-only
test gap-a-34-timestamptz-from-date-only {
    SELECT '2026-10-08'::timestamptz;
}
expect {
    2026-10-08 00:00:00+00
}

# A-35: invalid timestamptz
test gap-a-35-invalid-timestamptz {
    SELECT 'nope'::timestamptz;
}
@sqlstate 22007
expect error {}
@sqlstate 0A000
expect @tursopg error {}

# A-36 (S1): timestamptz equality across offsets
test gap-a-36-timestamptz-equality-across-offsets {
    SELECT '2026-10-08 14:00:00+02'::timestamptz = '2026-10-08 12:00:00Z'::timestamptz;
}
expect {
    t
}
expect @tursopg {
    1
}

# A-37: timestamp drops offset
test gap-a-37-timestamp-drops-offset {
    SELECT '2026-10-08 14:00:00+02'::timestamp;
}
expect {
    2026-10-08 14:00:00
}

# A-38 (S2): special values infinity/epoch
test gap-a-38-special-values-infinity-epoch {
    SELECT 'infinity'::timestamptz, 'epoch'::timestamptz;
}
expect {
    infinity|1970-01-01 00:00:00+00
}
@sqlstate 0A000
expect @tursopg error {}

# A-39 (S3): invalid date (Feb 30)
test gap-a-39-invalid-date-feb-30 {
    SELECT '2026-02-30'::date;
}
@sqlstate 22008
expect error {}
@sqlstate 0A000
expect @tursopg error {}

# A-40 (S2): date + int, date - date
test gap-a-40-date-int-date-date {
    SELECT '2026-10-08'::date + 1, '2026-10-08'::date - '2026-10-01'::date;
}
expect {
    2026-10-09|7
}
@sqlstate 0A000
expect @tursopg error {}

# A-42 (S2): interval input forms
test gap-a-42-interval-input-forms {
    SELECT '1 day 2 hours'::interval, '90 minutes'::interval, 'P1DT2H'::interval;
}
expect {
    1 day 02:00:00|01:30:00|1 day 02:00:00
}
@sqlstate 0A000
expect @tursopg error {}

# A-43 (S2): timestamptz + interval
test gap-a-43-timestamptz-interval {
    SELECT '2026-10-08 12:00:00+00'::timestamptz + interval '1 day 1 hour';
}
expect {
    2026-10-09 13:00:00+00
}
@sqlstate 0A000
expect @tursopg error {}

# A-44 (S2): now() - interval comparison
test gap-a-44-now-interval-comparison {
    SELECT now() - interval '1 day' < now();
}
expect {
    t
}
@sqlstate 0A000
expect @tursopg error {}

# A-45 (S1): jsonb literal key order/whitespace
test gap-a-45-jsonb-literal-key-order-whitespace {
    SELECT '{"b": 2,  "a":1, "aa": [1,  2]}'::jsonb;
}
expect {
    {"a": 1, "b": 2, "aa": [1, 2]}
}
expect @tursopg {
    {"b": 2,  "a":1, "aa": [1,  2]}
}

# A-46 (S1): jsonb duplicate keys keep last
test gap-a-46-jsonb-duplicate-keys-keep-last {
    SELECT '{"a":1,"a":2}'::jsonb;
}
expect {
    {"a": 2}
}
expect @tursopg {
    {"a":1,"a":2}
}

# A-47: json literal preserved verbatim
test gap-a-47-json-literal-preserved-verbatim {
    SELECT '{"b": 2,  "a":1}'::json;
}
expect {
    {"b": 2,  "a":1}
}

# A-48 (S1): invalid jsonb literal
test gap-a-48-invalid-jsonb-literal {
    SELECT 'not json'::jsonb;
}
@sqlstate 22P02
expect error {}
expect @tursopg {
    not json
}

# A-50: jsonb number precision
test gap-a-50-jsonb-number-precision {
    SELECT '1.50'::jsonb, '12345678901234567890'::jsonb;
}
expect {
    1.50|12345678901234567890
}

# A-51: int[] literal cast output
test gap-a-51-int-literal-cast-output {
    SELECT '{1,2,3}'::int[];
}
expect {
    {1,2,3}
}

# A-52 (S3): invalid int[] literal
test gap-a-52-invalid-int-literal {
    SELECT '{1,x}'::int[];
}
@sqlstate 22P02
expect error {}
@sqlstate 23000
expect @tursopg error {}

# A-58: ARRAY[] constructor output
test gap-a-58-array-constructor-output {
    SELECT ARRAY[1,2], ARRAY['a','b'];
}
expect {
    {1,2}|{a,b}
}

# A-59: int + unknown literal
test gap-a-59-int-unknown-literal {
    SELECT 1 + '2';
}
expect {
    3
}

# A-60: int column = text literal
test gap-a-60-int-column-text-literal {
    CREATE TABLE t (id int);
    INSERT INTO t VALUES (1);
    SELECT id FROM t WHERE id = '1';
}
expect {
    1
}

# A-61 (S1): text column = int literal (PG: no operator)
test gap-a-61-text-column-int-literal-pg-no-operator {
    CREATE TABLE t (s text);
    INSERT INTO t VALUES ('1');
    SELECT s FROM t WHERE s = 1;
}
@sqlstate 42883
expect error {}
expect @tursopg {
    1
}

# A-62: insert '42' text literal into int column
@setup t_id
test gap-a-62-insert-42-text-literal-into-int-column {
    INSERT INTO t VALUES ('42') RETURNING id;
}
expect {
    42
}

# A-63 (S3): insert 'abc' into int column
@setup t_id
test gap-a-63-insert-abc-into-int-column {
    INSERT INTO t VALUES ('abc') RETURNING id;
}
@sqlstate 22P02
expect error {}
@sqlstate 23000
expect @tursopg error {}

# A-64 (S2): insert 1.7 numeric into int column
@setup t_id
test gap-a-64-insert-1-7-numeric-into-int-column {
    INSERT INTO t VALUES (1.7) RETURNING id;
}
expect {
    2
}
@sqlstate 23000
expect @tursopg error {}

# A-65: insert 'true' into bool column
@setup t_b
test gap-a-65-insert-true-into-bool-column {
    INSERT INTO t VALUES ('true') RETURNING b;
}
expect {
    t
}

# A-66 (S1): insert integer 1 into bool column
@setup t_b
test gap-a-66-insert-integer-1-into-bool-column {
    INSERT INTO t VALUES (1) RETURNING b;
}
@sqlstate 42804
expect error {}
expect @tursopg {
    t
}

# A-79: insert literal with short +00 offset into timestamptz column
test gap-a-79-insert-literal-with-short-00-offset-into-timesta {
    CREATE TABLE t (ts timestamptz);
    INSERT INTO t VALUES ('2026-10-08 12:00:00+00') RETURNING ts;
}
expect {
    2026-10-08 12:00:00+00
}

# A-80: timestamptz column ORDER BY across offsets
test gap-a-80-timestamptz-column-order-by-across-offsets {
    CREATE TABLE t (id int, ts timestamptz);
    INSERT INTO t VALUES (1, '2026-10-08T12:00:00Z'), (2, '2026-10-08T13:00:00+02:00');
    SELECT id FROM t ORDER BY ts;
}
expect {
    2
    1
}

# A-81: numeric(10,2) column rounds on insert
test gap-a-81-numeric-10-2-column-rounds-on-insert {
    CREATE TABLE t (v numeric(10,2));
    INSERT INTO t VALUES (1.005), (1.5);
    SELECT v FROM t;
}
expect {
    1.01
    1.50
}
