# Known tursopg gaps against PostgreSQL: A. Params & casts
#
# Each test with a `@compat-gap "<kind>:<object>"` label records a known
# difference: its default `expect` block is PostgreSQL 18's answer and its
# `expect @tursopg` block is tursopg's current wrong answer. When tursopg
# gives the PostgreSQL answer, the tursopg run fails with "gap fixed": then
# delete only `@compat-gap` and the `expect @tursopg` block, and keep the
# test. A test without `@compat-gap` matches PostgreSQL and guards against
# regressions. The `# X-NN` comments are the IDs from the audit that found
# each gap.

@database :memory:

setup t_id {
    CREATE TABLE t (id int);
}

setup t_b {
    CREATE TABLE t (b boolean);
}

# A-01: bool literal casts, true forms
test bool-literal-casts-true-forms {
    SELECT 't'::boolean, 'true'::boolean, 'yes'::boolean, 'on'::boolean, '1'::boolean, 'TRUE'::boolean, 'y'::boolean;
}
expect {
    t|t|t|t|t|t|t
}

# A-02: bool literal casts, false forms
test bool-literal-casts-false-forms {
    SELECT 'f'::boolean, 'false'::boolean, 'no'::boolean, 'off'::boolean, '0'::boolean;
}
expect {
    f|f|f|f|f
}

# A-04: bool invalid literal
test bool-invalid-literal {
    SELECT 'maybe'::boolean;
}
@sqlstate 22P02
expect error {}

# A-06: CAST(... AS boolean) form
test cast-as-boolean-form {
    SELECT CAST('true' AS boolean), CAST(1 AS boolean), CAST(0 AS boolean);
}
expect {
    t|t|f
}

# A-07: int4 overflow literal cast
test int4-overflow-literal-cast {
    SELECT '2147483648'::int4;
}
@sqlstate 22003
expect error {}

# A-08: int2 overflow literal cast
test int2-overflow-literal-cast {
    SELECT '40000'::smallint;
}
@sqlstate 22003
expect error {}

# A-09: int8 overflow arithmetic
test int8-overflow-arithmetic {
    SELECT 9223372036854775807::bigint + 1;
}
@sqlstate 22003
expect error {}

# A-10: int4 overflow arithmetic
test int4-overflow-arithmetic {
    SELECT 2147483647::int4 + 1;
}
@sqlstate 22003
expect error {}

# A-11: invalid int literal cast
test invalid-int-literal-cast {
    SELECT 'abc'::integer;
}
@sqlstate 22P02
expect error {}

# A-13: '1.5'::int (text) is invalid
test decimal-text-cast-to-int4-is-invalid {
    SELECT '1.5'::integer;
}
@sqlstate 22P02
expect error {}

# A-14: numeric->int rounds half away from zero
test numeric-int-rounds-half-away-from-zero {
    SELECT 1.5::integer, 2.5::integer, (-2.5)::integer;
}
expect {
    2|3|-3
}

# A-16: int with surrounding spaces
test int-with-surrounding-spaces {
    SELECT ' 42 '::integer;
}
expect {
    42
}

# A-17: invalid uuid literal cast
test invalid-uuid-literal-cast {
    SELECT 'nope'::uuid;
}
@sqlstate 22P02
expect error {}

# A-19: uuid uppercase input normalised
test uuid-uppercase-input-normalised {
    SELECT 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11'::uuid;
}
expect {
    a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
}

# A-20: uuid braces / no-hyphen input
test uuid-braces-no-hyphen-input {
    SELECT '{a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11}'::uuid, 'a0eebc999c0b4ef8bb6d6bb9bd380a11'::uuid;
}
expect {
    a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11|a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
}

# A-21: uuid equality across case
test uuid-equality-across-case {
    SELECT 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11'::uuid = 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'::uuid;
}
expect {
    t
}

# A-22: numeric(10,2) rounding half away from zero
@compat-gap "type:numeric"
test numeric-10-2-rounding-half-away-from-zero {
    SELECT '1.005'::numeric(10,2), '2.675'::numeric(10,2), '-1.005'::numeric(10,2);
}
expect {
    1.01|2.68|-1.01
}
@sqlstate 0A000
expect @tursopg error {}

# A-23: numeric(10,0) rounding
@compat-gap "type:numeric"
test numeric-10-0-rounding {
    SELECT '2.5'::numeric(10,0), '3.5'::numeric(10,0);
}
expect {
    3|4
}
@sqlstate 0A000
expect @tursopg error {}

# A-24: numeric exact decimal arithmetic
test numeric-exact-decimal-arithmetic {
    SELECT 0.1::numeric + 0.2::numeric, 1::numeric / 3;
}
expect {
    0.3|0.33333333333333333333
}

# A-25: numeric big precision
test numeric-big-precision {
    SELECT '123456789012345678901234567890.123'::numeric;
}
expect {
    123456789012345678901234567890.123
}

# A-26: numeric overflow on typmod
@compat-gap "type:numeric"
test numeric-overflow-on-typmod {
    SELECT '123456.1'::numeric(5,2);
}
@sqlstate 22003
expect error {}
@sqlstate 0A000
expect @tursopg error {}

# A-27: invalid numeric
test invalid-numeric {
    SELECT 'abc'::numeric;
}
@sqlstate 22P02
expect error {}

# A-28: numeric exponent input
test numeric-exponent-input {
    SELECT '1e3'::numeric, '1.50'::numeric;
}
expect {
    1000|1.50
}

# A-30: timestamptz literal with +02 offset
test timestamptz-literal-with-02-offset {
    SELECT '2026-10-08 14:00:00+02'::timestamptz;
}
expect {
    2026-10-08 12:00:00+00
}

# A-31: timestamptz literal with Z
test timestamptz-literal-with-z {
    SELECT '2026-10-08T12:00:00Z'::timestamptz;
}
expect {
    2026-10-08 12:00:00+00
}

# A-32: timestamptz with +05:30 and micros
test timestamptz-with-05-30-and-micros {
    SELECT '2026-10-08T12:00:00.123456+05:30'::timestamptz;
}
expect {
    2026-10-08 06:30:00.123456+00
}

# A-34: timestamptz from date-only
test timestamptz-from-date-only {
    SELECT '2026-10-08'::timestamptz;
}
expect {
    2026-10-08 00:00:00+00
}

# A-35: invalid timestamptz
test invalid-timestamptz {
    SELECT 'nope'::timestamptz;
}
@sqlstate 22007
expect error {}

# A-36: timestamptz equality across offsets
test timestamptz-equality-across-offsets {
    SELECT '2026-10-08 14:00:00+02'::timestamptz = '2026-10-08 12:00:00Z'::timestamptz;
}
expect {
    t
}

# A-37: timestamp drops offset
test timestamp-drops-offset {
    SELECT '2026-10-08 14:00:00+02'::timestamp;
}
expect {
    2026-10-08 14:00:00
}

# A-38: special values infinity/epoch
@compat-gap "type:timestamptz"
test special-values-infinity-epoch {
    SELECT 'infinity'::timestamptz, 'epoch'::timestamptz;
}
expect {
    infinity|1970-01-01 00:00:00+00
}
@sqlstate 22007
expect @tursopg error {}

# A-39: invalid date (Feb 30)
@compat-gap "type:date"
test invalid-date-feb-30 {
    SELECT '2026-02-30'::date;
}
@sqlstate 22008
expect error {}
@sqlstate 0A000
expect @tursopg error {}

# A-40: date + int, date - date
@compat-gap "operator:date + int4"
test date-int-date-date {
    SELECT '2026-10-08'::date + 1, '2026-10-08'::date - '2026-10-01'::date;
}
expect {
    2026-10-09|7
}
@sqlstate 0A000
expect @tursopg error {}

# A-42: interval input forms
@compat-gap "type:interval"
test interval-input-forms {
    SELECT '1 day 2 hours'::interval, '90 minutes'::interval, 'P1DT2H'::interval;
}
expect {
    1 day 02:00:00|01:30:00|1 day 02:00:00
}
@sqlstate 0A000
expect @tursopg error {}

# A-43: timestamptz + interval
@compat-gap "operator:timestamptz + interval"
test timestamptz-interval {
    SELECT '2026-10-08 12:00:00+00'::timestamptz + interval '1 day 1 hour';
}
expect {
    2026-10-09 13:00:00+00
}
@sqlstate 0A000
expect @tursopg error {}

# A-44: now() - interval comparison
@compat-gap "operator:timestamptz - interval"
test now-interval-comparison {
    SELECT now() - interval '1 day' < now();
}
expect {
    t
}
@sqlstate 0A000
expect @tursopg error {}

# A-45: jsonb literal key order/whitespace
@compat-gap "type:jsonb"
test jsonb-literal-key-order-whitespace {
    SELECT '{"b": 2,  "a":1, "aa": [1,  2]}'::jsonb;
}
expect {
    {"a": 1, "b": 2, "aa": [1, 2]}
}
expect @tursopg {
    {"b": 2,  "a":1, "aa": [1,  2]}
}

# A-46: jsonb duplicate keys keep last
@compat-gap "type:jsonb"
test jsonb-duplicate-keys-keep-last {
    SELECT '{"a":1,"a":2}'::jsonb;
}
expect {
    {"a": 2}
}
expect @tursopg {
    {"a":1,"a":2}
}

# A-47: json literal preserved verbatim
test json-literal-preserved-verbatim {
    SELECT '{"b": 2,  "a":1}'::json;
}
expect {
    {"b": 2,  "a":1}
}

# A-48: invalid jsonb literal
@compat-gap "type:jsonb"
test invalid-jsonb-literal {
    SELECT 'not json'::jsonb;
}
@sqlstate 22P02
expect error {}
expect @tursopg {
    not json
}

# A-50: jsonb number precision
test jsonb-number-precision {
    SELECT '1.50'::jsonb, '12345678901234567890'::jsonb;
}
expect {
    1.50|12345678901234567890
}

# A-51: int[] literal cast output
test int-literal-cast-output {
    SELECT '{1,2,3}'::int[];
}
expect {
    {1,2,3}
}

# A-52: invalid int[] literal
@compat-gap "type:_int4"
test invalid-int-literal {
    SELECT '{1,x}'::int[];
}
@sqlstate 22P02
expect error {}
@sqlstate 23000
expect @tursopg error {}

# A-58: ARRAY[] constructor output
test array-constructor-output {
    SELECT ARRAY[1,2], ARRAY['a','b'];
}
expect {
    {1,2}|{a,b}
}

# A-59: int + unknown literal
test int-unknown-literal {
    SELECT 1 + '2';
}
expect {
    3
}

# A-60: int column = text literal
test int-column-text-literal {
    CREATE TABLE t (id int);
    INSERT INTO t VALUES (1);
    SELECT id FROM t WHERE id = '1';
}
expect {
    1
}

# A-61: text column = int literal (PG: no operator)
test text-column-int-literal-pg-no-operator {
    CREATE TABLE t (s text);
    INSERT INTO t VALUES ('1');
    SELECT s FROM t WHERE s = 1;
}
@sqlstate 42883
expect error {}

# A-62: insert '42' text literal into int column
@setup t_id
test insert-42-text-literal-into-int-column {
    INSERT INTO t VALUES ('42') RETURNING id;
}
expect {
    42
}

# A-63: insert 'abc' into int column
@setup t_id
test insert-abc-into-int-column {
    INSERT INTO t VALUES ('abc') RETURNING id;
}
@sqlstate 22P02
expect error {}

# A-64: insert 1.7 numeric into int column
@setup t_id
test insert-1-7-numeric-into-int-column {
    INSERT INTO t VALUES (1.7) RETURNING id;
}
expect {
    2
}

# A-65: insert 'true' into bool column
@setup t_b
test insert-true-into-bool-column {
    INSERT INTO t VALUES ('true') RETURNING b;
}
expect {
    t
}

# A-66: insert integer 1 into bool column
@setup t_b
test insert-integer-1-into-bool-column {
    INSERT INTO t VALUES (1) RETURNING b;
}
@sqlstate 42804
expect error {}

# A-79: insert literal with short +00 offset into timestamptz column
test insert-literal-with-short-00-offset-into-timestamptz {
    CREATE TABLE t (ts timestamptz);
    INSERT INTO t VALUES ('2026-10-08 12:00:00+00') RETURNING ts;
}
expect {
    2026-10-08 12:00:00+00
}

# A-80: timestamptz column ORDER BY across offsets
test timestamptz-column-order-by-across-offsets {
    CREATE TABLE t (id int, ts timestamptz);
    INSERT INTO t VALUES (1, '2026-10-08T12:00:00Z'), (2, '2026-10-08T13:00:00+02:00');
    SELECT id FROM t ORDER BY ts;
}
expect {
    2
    1
}

# A-81: numeric(10,2) column rounds on insert
test numeric-10-2-column-rounds-on-insert {
    CREATE TABLE t (v numeric(10,2));
    INSERT INTO t VALUES (1.005), (1.5);
    SELECT v FROM t;
}
expect {
    1.01
    1.50
}
