@sqlstate 42704
expect @tursopg error {}

@compat-gap "syntax:set"
test set-datestyle {
    SET datestyle = 'SQL, MDY';
    SELECT timestamptz '2026-01-31 10:20:30Z', '01/02/2026'::timestamptz;
}
expect {
    01/31/2026 10:20:30 UTC|01/02/2026 00:00:00 UTC
}
@sqlstate 22023
expect @tursopg error {}

# tursopg stores dates from 0001-01-01 to 9999-12-31 and refuses date
# arithmetic outside that range; PostgreSQL's date range is wider.
@compat-gap "type:date"
test date-minus-days-before-year-one {
    SELECT '0001-01-01'::date - 1;
}
expect {
    0001-12-31 BC
}
@sqlstate 22008
expect @tursopg error {}

@compat-gap "type:date"
test date-plus-days-after-year-9999 {
    SELECT '9999-12-31'::date + 1;
}
expect {
    10000-01-01
}
@sqlstate 22008
expect @tursopg error {}

test insert-integer-into-timestamp-column {
    CREATE TABLE t (ts timestamp);
    INSERT INTO t VALUES (20200101);
    SELECT ts FROM t;
}
@sqlstate 42804
expect error {}

# PostgreSQL has no casts between date or time types and numbers.
@compat-gap "cast:int4 -> date"
test cast-integer-to-date {
    SELECT 20200101::date;
}
@sqlstate 42846
expect error {}
expect @tursopg {
    2020-01-01
}

# PostgreSQL finds no common type for an integer and a timestamp in one VALUES
# column; tursopg accepts them.
@compat-gap "syntax:values"
test in-values-mixing-integer-and-timestamp {
    CREATE TABLE t (id int, ts timestamp, tz timestamptz);
    INSERT INTO t VALUES (1, '2024-01-05 00:00:00', '2024-01-05 00:00:00+00');
    SELECT tz IN (VALUES (1), (ts)) FROM t;
}
@sqlstate 42804
expect error {}
expect @tursopg {
    t
}

# tursopg refuses at compile time with 0A000 because it cannot tell which types
# have the operator.
@compat-gap "operator:integer + interval"
test integer-plus-interval-over-no-rows {
    CREATE TABLE t (i int);
    SELECT i + interval '1 day' FROM t;
}
@sqlstate 42883
expect error {
    operator does not exist: integer \+ interval
}
@sqlstate 0A000
expect @tursopg error {
    adding an interval is supported only for timestamp and timestamptz, not int4
}

# PostgreSQL compares a date with a timestamp as the timestamp at midnight of
# that date; tursopg refuses the comparison.
@compat-gap "operator:date = timestamp"
test date-equals-timestamp-from-values-cte {
    CREATE TABLE t (id int, d date);
    INSERT INTO t VALUES (1, '2024-01-05');
    WITH v(x) AS (VALUES (CAST('2024-01-05 00:00:00' AS timestamp))) SELECT count(*) FROM t, v WHERE d = x;
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {}

# sum, avg and abs have no date version in PostgreSQL. tursopg applies them
# to the number the date is stored as.
@compat-gap "function:sum"
test sum-of-date-column {
    CREATE TABLE date_sums (d date);
    INSERT INTO date_sums VALUES ('2020-01-01');
    SELECT sum(d) FROM date_sums;
}
@sqlstate 42883
expect error {
    function sum\(date\) does not exist
}
expect @tursopg {
    2020.0
}

@compat-gap "function:avg"
test avg-of-date-column {
    CREATE TABLE date_avgs (d date);
    INSERT INTO date_avgs VALUES ('2020-01-01');
    SELECT avg(d) FROM date_avgs;
}
@sqlstate 42883
expect error {
    function avg\(date\) does not exist
}
expect @tursopg {
    2020.0
}

@compat-gap "function:abs"
test abs-of-date {
    SELECT abs(DATE '2020-01-01');
}
@sqlstate 42883
expect error {
    function abs\(date\) does not exist
}
expect @tursopg {
    2020.0
}

# length has no date version in PostgreSQL. tursopg applies it to the text
# the date is stored as.
@compat-gap "function:length"
test length-of-date {
    SELECT length(DATE '2020-01-05');
}
@sqlstate 42883
expect error {
    function length\(date\) does not exist
}
expect @tursopg {
    10
}

# PostgreSQL has no LIKE operator for a date.
@compat-gap "operator:date ~~ unknown"
test date-like-text {
    SELECT DATE '2020-01-05' LIKE '2020%';
}
@sqlstate 42883
expect error {
    operator does not exist: date ~~ unknown
}
expect @tursopg {
    t
}

# PostgreSQL accepts the special date value infinity. tursopg refuses it as
# invalid input, where an unsupported value should fail with 0A000.
@compat-gap "type:date infinity"
test date-infinity {
    SELECT DATE 'infinity';
}
expect {
    infinity
}
@sqlstate 22007
expect @tursopg error {
    .*
}
