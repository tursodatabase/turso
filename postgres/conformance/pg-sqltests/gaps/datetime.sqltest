# Known tursopg gaps against PostgreSQL: date and time
#
# Each test with a `@compat-gap "<kind>:<object>"` label records a known
# difference: its default `expect` block is PostgreSQL 18's answer and its
# `expect @tursopg` block is tursopg's current wrong answer. When tursopg
# gives the PostgreSQL answer, the tursopg run fails with "gap fixed": then
# delete only `@compat-gap` and the `expect @tursopg` block, and keep the
# test.
#
# These tests come from running candidate SQL on PostgreSQL 18 and on
# tursopg and keeping one test per cause of a difference. The first
# tests cover storing timestamptz values, `DEFAULT now()`, comparisons with
# literals, `now() - interval`, and `date_trunc` with GROUP BY; the rest
# cover other date and time functions, types, casts and settings.

@database :memory:

test stored-timestamptz-text-cast {
    CREATE TABLE t (id int, created_at timestamptz);
    INSERT INTO t VALUES (1, '2026-01-01 10:00:00.25+02');
    SELECT created_at::text FROM t;
}
expect {
    2026-01-01 08:00:00.25+00
}

# Concatenation converts the value with the same cast.
@compat-gap "cast:timestamptz -> text"
test stored-timestamptz-concat {
    CREATE TABLE t (id int, created_at timestamptz);
    INSERT INTO t VALUES (1, '2026-01-01 10:00:00.25+02');
    SELECT 'at ' || created_at FROM t;
}
expect {
    at 2026-01-01 08:00:00.25+00
}
expect @tursopg {
    at 2026-01-01 08:00:00.25
}

test where-timestamptz-text-compare {
    CREATE TABLE t (id int, ts timestamptz);
    INSERT INTO t VALUES (1, '2026-01-01 00:00Z'), (2, '2026-01-01 01:00+01'), (3, '2025-12-31 21:00-03');
    SELECT id FROM t WHERE ts::text >= '2026-01-01 00:00:00+00' ORDER BY id;
}
expect {
    1
    2
    3
}

@compat-gap "type:_timestamptz"
test array-agg-timestamptz-output {
    SELECT (SELECT array_agg(x) FROM (VALUES (timestamptz '2026-01-31 10:00Z')) v(x));
}
expect {
    {"2026-01-31 10:00:00+00"}
}
expect @tursopg {
    {"2026-01-31 10:00:00"}
}

@compat-gap "function:format"
test format-timestamptz-output {
    SELECT format('%s', timestamptz '2026-01-31 10:00Z');
}
expect {
    2026-01-31 10:00:00+00
}
expect @tursopg {
    2026-01-31 10:00:00
}

@compat-gap "function:concat"
test concat-timestamptz-output {
    SELECT concat('at ', timestamptz '2026-01-31 10:00Z');
}
expect {
    at 2026-01-31 10:00:00+00
}
expect @tursopg {
    at 2026-01-31 10:00:00
}

