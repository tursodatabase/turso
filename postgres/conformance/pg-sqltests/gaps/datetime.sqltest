# PostgreSQL fills the missing trailing columns with their defaults.
@compat-gap "syntax:insert"
test insert-fewer-values-than-columns {
    CREATE TABLE t (id int, created_at timestamptz, done boolean DEFAULT false);
    INSERT INTO t VALUES (1, '2025-12-31 23:00Z'), (2, '2026-01-01 10:00Z'), (3, '2099-01-01Z');
    DELETE FROM t WHERE created_at < '2026-01-01';
    SELECT id, CASE WHEN done THEN 'done' ELSE 'open' END FROM t ORDER BY id;
}
expect {
    2|open
    3|open
}
@sqlstate 42601
expect @tursopg error {}

@compat-gap "function:pg_typeof"
test now-minus-interval-days {
    SELECT pg_typeof(now() - interval '7 days');
    SELECT count(*) FROM (SELECT 1) AS one WHERE (now() - interval '7 days') < now() + interval '1000 years';
}
expect {
    timestamp with time zone
    1
}
@sqlstate 42883
expect @tursopg error {}

@compat-gap "type:interval"
test now-minus-interval-field-qualifier {
    SELECT pg_typeof(now() - interval '7' day);
    SELECT count(*) FROM (SELECT 1) AS one WHERE (now() - interval '7' day) < now() + interval '1000 years';
}
expect {
    timestamp with time zone
    1
}
@sqlstate 0A000
expect @tursopg error {}

# An untyped literal next to timestamptz + resolves to interval.
@compat-gap "operator:timestamptz + interval"
test timestamptz-plus-untyped-literal {
    CREATE TABLE t (ts timestamptz);
    INSERT INTO t VALUES ('2026-01-31 10:00Z');
    SELECT ts + '1 day' FROM t;
}
expect {
    2026-02-01 10:00:00+00
}
@sqlstate 42883
expect @tursopg error {}

# PostgreSQL resolves the untyped literal of now() - '7 days' as timestamptz.
@compat-gap "operator:timestamptz - timestamptz"
test now-minus-untyped-literal {
    CREATE TABLE t (ts timestamptz);
    INSERT INTO t VALUES ('2026-01-31 10:00Z');
    SELECT CASE WHEN now() - '7 days' < now() THEN 'past' ELSE 'not' END FROM t;
}
@sqlstate 22007
expect error {}
@sqlstate 42883
expect @tursopg error {}

@compat-gap "operator:timestamptz - timestamptz"
test timestamptz-minus-timestamptz {
    CREATE TABLE t (a timestamptz, b timestamptz);
    INSERT INTO t VALUES ('2026-01-01 10:00Z', '2026-01-03 12:30Z');
    SELECT b - a FROM t;
}
expect {
    2 days 02:30:00
}
@sqlstate 42883
expect @tursopg error {}

@compat-gap "operator:timestamp - timestamp"
test timestamp-minus-timestamp {
    CREATE TABLE t (id int, ts timestamp);
    INSERT INTO t VALUES (1, '2026-01-31 10:20:30.5');
    SELECT ts - TIMESTAMP '2026-01-01' FROM t;
}
expect {
    30 days 10:20:30.5
}
@sqlstate 42883
expect @tursopg error {}

# The common type of timestamptz and timestamp is timestamptz.
@compat-gap "cast:timestamp -> timestamptz"
test coalesce-timestamptz-timestamp {
    CREATE TABLE t (id int, tstz timestamptz, ts timestamp);
    INSERT INTO t VALUES (1, '2026-01-01 10:00+02', '2026-01-01 08:00'), (2, '2026-01-01 10:00Z', '2026-01-01 09:00');
    SELECT coalesce(tstz, ts) FROM t ORDER BY id;
}
expect {
    2026-01-01 08:00:00+00
    2026-01-01 10:00:00+00
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type timestamptz with type timestamp
}

@compat-gap "cast:timestamp -> timestamptz"
test case-timestamptz-timestamp {
    CREATE TABLE t (id int, tstz timestamptz, ts timestamp);
    INSERT INTO t VALUES (1, '2026-01-01 10:00+02', '2026-01-01 08:00'), (2, '2026-01-01 10:00Z', '2026-01-01 09:00');
    SELECT CASE WHEN id = 1 THEN tstz ELSE ts END FROM t ORDER BY id;
}
expect {
    2026-01-01 08:00:00+00
    2026-01-01 09:00:00+00
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type timestamptz with type timestamp
}

@compat-gap "function:avg"
test avg-timestamptz {
    CREATE TABLE t (id int, ts timestamptz);
    INSERT INTO t VALUES (1, '2026-01-01 10:00+02'), (2, '2026-01-01 09:00Z'), (3, NULL), (4, '2026-01-02Z');
    SELECT avg(ts) FROM t;
}
@sqlstate 42883
expect error {}
expect @tursopg {
    2026.0
}

@compat-gap "function:percentile_disc"
test percentile-disc-timestamptz {
    CREATE TABLE t (id int, ts timestamptz);
    INSERT INTO t VALUES (1, '2026-01-01 10:00+02'), (2, '2026-01-01 09:00Z'), (3, NULL), (4, '2026-01-02Z');
    SELECT percentile_disc(0.5) WITHIN GROUP (ORDER BY ts) FROM t;
}
expect {
    2026-01-01 09:00:00+00
}
expect @tursopg {
    2026-01-01 09:00:00
}

test date-trunc-day {
    SELECT date_trunc('day', timestamptz '2026-08-19 13:45:56.789012+00');
}
expect {
    2026-08-19 00:00:00+00
}

@compat-gap "function:date_trunc"
test date-trunc-with-zone {
    SELECT date_trunc('day', timestamptz '2026-08-19 01:00+00', 'Asia/Tokyo');
}
expect {
    2026-08-18 15:00:00+00
}
@sqlstate 0A000
expect @tursopg error {}

test date-trunc-invalid-field {
    SELECT date_trunc('fortnight', timestamptz '2026-08-19 13:45:56.789012+00');
}
@sqlstate 22023
expect error {}

# to_char on a timestamp is refused.
@compat-gap "function:to_char"
test group-by-to-char-day {
    CREATE TABLE t (id int, created_at timestamptz, done boolean);
    INSERT INTO t VALUES (1, '2026-01-01 10:00Z', true), (2, '2026-01-01 23:30Z', false), (3, '2026-01-02 00:10+02', true), (4, '2026-01-02 08:00Z', true), (5, '2026-02-15 12:00Z', false);
    SELECT to_char(created_at, 'YYYY-MM-DD') AS day, count(*) FROM t GROUP BY 1 ORDER BY 1;
}
expect {
    2026-01-01|3
    2026-01-02|1
    2026-02-15|1
}
@sqlstate 0A000
expect @tursopg error {}

@compat-gap "function:to_char"
