@compat-gap "syntax:prepare"
test prepare-timestamptz-parameter {
    CREATE TABLE t (id int, created_at timestamptz);
    PREPARE ins(int, timestamptz) AS INSERT INTO t VALUES ($1, $2);
    EXECUTE ins(1, '2026-01-01T10:00Z');
    SELECT id, created_at FROM t;
}
expect {
    1|2026-01-01 10:00:00+00
}
@sqlstate 0A000
expect @tursopg error {}

@compat-gap "type:timestamptz"
test default-now-string {
    CREATE TABLE todos (id serial PRIMARY KEY, title text NOT NULL, created_at timestamptz NOT NULL DEFAULT 'now');
    INSERT INTO todos (title) VALUES ('a');
    SELECT id, title FROM todos WHERE created_at > '2020-01-01Z' AND created_at < '2100-01-01Z';
}
expect {
    1|a
}
@sqlstate 22007
expect @tursopg error {}

@compat-gap "type:timestamptz"
test where-greater-than-now-string {
