# GRANT and REVOKE on tables through the PostgreSQL frontend.
# PostgreSQL roles belong to the whole server, not to one database, so every
# test uses its own role names.
#
# The privilege is stored in the relation's access control list, which
# pg_class.relacl shows in PostgreSQL's aclitem[] form. The owner's default
# entry lists every table privilege of PostgreSQL 17 and later. A role reads
# a table only when it owns it or the list gives it SELECT.

@database :memory:

test grant-select-lets-a-role-read-the-table {
    CREATE ROLE gs_reader;
    CREATE TABLE gs_docs (id INT);
    INSERT INTO gs_docs VALUES (1), (2);
    GRANT SELECT ON gs_docs TO gs_reader;
    SET ROLE gs_reader;
    SELECT id FROM gs_docs ORDER BY id;
}
expect {
    1
    2
}

test grant-select-on-table-keyword {
    CREATE ROLE gs_table_keyword;
    CREATE TABLE gs_keyword (id INT);
    INSERT INTO gs_keyword VALUES (1);
    GRANT SELECT ON TABLE gs_keyword TO gs_table_keyword;
    SET ROLE gs_table_keyword;
    SELECT id FROM gs_keyword;
}
expect {
    1
}

test grant-select-on-table-qualified-with-its-schema {
    CREATE ROLE gs_qualified;
    CREATE TABLE gs_public_docs (id INT);
    INSERT INTO gs_public_docs VALUES (1);
    GRANT SELECT ON public.gs_public_docs TO gs_qualified;
    SET ROLE gs_qualified;
    SELECT id FROM public.gs_public_docs;
}
expect {
    1
}

test grant-select-on-several-tables-to-several-roles {
    CREATE ROLE gs_many_a;
    CREATE ROLE gs_many_b;
    CREATE TABLE gs_many_x (id INT);
    CREATE TABLE gs_many_y (id INT);
    INSERT INTO gs_many_x VALUES (1);
    INSERT INTO gs_many_y VALUES (2);
    GRANT SELECT ON gs_many_x, gs_many_y TO gs_many_a, gs_many_b;
    SET ROLE gs_many_b;
    SELECT x.id, y.id FROM gs_many_x x, gs_many_y y;
}
expect {
    1|2
}

test grant-select-to-public-lets-every-role-read {
    CREATE ROLE gs_public_reader;
    CREATE TABLE gs_for_everyone (id INT);
    INSERT INTO gs_for_everyone VALUES (1);
    GRANT SELECT ON gs_for_everyone TO PUBLIC;
    SET ROLE gs_public_reader;
    SELECT id FROM gs_for_everyone;
}
expect {
    1
}

test grant-select-to-current-user {
    CREATE TABLE gs_current (id INT);
    INSERT INTO gs_current VALUES (1);
    GRANT SELECT ON gs_current TO CURRENT_USER;
    SELECT id FROM gs_current;
}
expect {
    1
}

test grant-select-to-quoted-role-name {
    CREATE ROLE "GsQuoted";
    CREATE TABLE gs_quoted (id INT);
    INSERT INTO gs_quoted VALUES (1);
    GRANT SELECT ON gs_quoted TO "GsQuoted";
    SET ROLE "GsQuoted";
    SELECT id FROM gs_quoted;
}
expect {
    1
}

test grant-select-on-all-tables-in-schema {
    CREATE ROLE gs_all_tables;
    CREATE TABLE gs_all_a (id INT);
    CREATE TABLE gs_all_b (id INT);
    INSERT INTO gs_all_a VALUES (1);
    INSERT INTO gs_all_b VALUES (2);
    GRANT SELECT ON ALL TABLES IN SCHEMA public TO gs_all_tables;
    SET ROLE gs_all_tables;
    SELECT a.id, b.id FROM gs_all_a a, gs_all_b b;
}
expect {
    1|2
}

test grant-select-on-view {
    CREATE ROLE gs_view_reader;
    CREATE TABLE gs_view_base (id INT);
    INSERT INTO gs_view_base VALUES (1), (2);
    CREATE VIEW gs_view AS SELECT id FROM gs_view_base WHERE id > 1;
    GRANT SELECT ON gs_view TO gs_view_reader;
    SET ROLE gs_view_reader;
    SELECT id FROM gs_view;
}
expect {
    2
}

test grant-select-twice {
    CREATE ROLE gs_twice;
    CREATE TABLE gs_twice_docs (id INT);
    INSERT INTO gs_twice_docs VALUES (1);
    GRANT SELECT ON gs_twice_docs TO gs_twice;
    GRANT SELECT ON gs_twice_docs TO gs_twice;
    SET ROLE gs_twice;
    SELECT id FROM gs_twice_docs;
}
expect {
    1
}

test grant-select-in-a-transaction {
    CREATE ROLE gs_in_tx;
    CREATE TABLE gs_tx_docs (id INT);
    INSERT INTO gs_tx_docs VALUES (1);
    BEGIN;
    GRANT SELECT ON gs_tx_docs TO gs_in_tx;
    COMMIT;
    SET ROLE gs_in_tx;
    SELECT id FROM gs_tx_docs;
}
expect {
    1
}

test grant-select-on-missing-table-fails {
    CREATE ROLE gs_missing_table;
    GRANT SELECT ON gs_no_such_table TO gs_missing_table;
}
@sqlstate 42P01
expect error {
    relation "gs_no_such_table" does not exist
}

test grant-select-on-missing-table-in-schema-fails {
    CREATE ROLE gs_missing_qualified;
    GRANT SELECT ON public.gs_no_such_table TO gs_missing_qualified;
}
@sqlstate 42P01
expect error {
    relation "public.gs_no_such_table" does not exist
}

test grant-select-on-table-in-missing-schema-fails {
    CREATE ROLE gs_missing_schema;
    GRANT SELECT ON gs_no_such_schema.t TO gs_missing_schema;
}
@sqlstate 3F000
expect error {
    schema "gs_no_such_schema" does not exist
}

test grant-select-on-all-tables-in-missing-schema-fails {
    CREATE ROLE gs_all_missing_schema;
    GRANT SELECT ON ALL TABLES IN SCHEMA gs_no_such_schema TO gs_all_missing_schema;
}
@sqlstate 3F000
expect error {
    schema "gs_no_such_schema" does not exist
}

test grant-select-on-all-tables-in-an-empty-schema-checks-the-role {
    CREATE SCHEMA gs_empty_schema;
    GRANT SELECT ON ALL TABLES IN SCHEMA gs_empty_schema TO gs_no_such_role;
}
@sqlstate 42704
expect error {
    role "gs_no_such_role" does not exist
}

test grant-select-to-missing-role-fails {
    CREATE TABLE gs_missing_role_docs (id INT);
    GRANT SELECT ON gs_missing_role_docs TO gs_no_such_role;
}
@sqlstate 42704
expect error {
    role "gs_no_such_role" does not exist
}

test grant-select-checks-the-table-before-the-role {
    GRANT SELECT ON gs_no_such_table TO gs_no_such_role;
}
@sqlstate 42P01
expect error {
    relation "gs_no_such_table" does not exist
}

test grant-select-to-role-named-in-another-case-fails {
    CREATE ROLE "GsCased";
    CREATE TABLE gs_cased (id INT);
    GRANT SELECT ON gs_cased TO GsCased;
}
@sqlstate 42704
expect error {
    role "gscased" does not exist
}

test grant-select-in-a-read-only-transaction-fails {
    CREATE ROLE gs_read_only;
    CREATE TABLE gs_read_only_docs (id INT);
    BEGIN READ ONLY;
    GRANT SELECT ON gs_read_only_docs TO gs_read_only;
}
@sqlstate 25006
expect error {}

test grant-select-on-catalog-tables {
    CREATE ROLE gs_catalog_reader;
    CREATE TABLE gs_catalog_docs (id INT);
    GRANT SELECT ON pg_catalog.pg_class, pg_namespace, pg_catalog.pg_roles TO gs_catalog_reader;
    SET ROLE gs_catalog_reader;
    SELECT relname FROM pg_catalog.pg_class WHERE relname = 'gs_catalog_docs';
}
expect {
    gs_catalog_docs
}

test grant-select-on-information-schema-table {
    CREATE ROLE gs_schemata_reader;
    GRANT SELECT ON information_schema.schemata TO gs_schemata_reader;
    SET ROLE gs_schemata_reader;
    SELECT schema_name FROM information_schema.schemata WHERE schema_name = 'public';
}
expect {
    public
}

test grant-select-on-index-fails {
    CREATE ROLE gs_index_grantee;
    CREATE TABLE gs_indexed (id INT);
    CREATE INDEX gs_indexed_idx ON gs_indexed (id);
    GRANT SELECT ON gs_indexed_idx TO gs_index_grantee;
}
@sqlstate 42809
expect error {
    "gs_indexed_idx" is an index
}

test grant-select-on-table-in-another-database-fails {
    CREATE ROLE gs_cross_database;
    GRANT SELECT ON gs_other_db.public.t TO gs_cross_database;
}
@sqlstate 0A000
expect error {}

test grant-select-to-pg-database-owner {
    CREATE TABLE gs_database_owner (id INT);
    INSERT INTO gs_database_owner VALUES (1);
    GRANT SELECT ON gs_database_owner TO pg_database_owner;
    SELECT id FROM gs_database_owner;
}
expect {
    1
}

# What GRANT stores: pg_class.relacl.

test grant-select-is-stored-in-relacl {
    CREATE ROLE gs_acl_reader;
    CREATE TABLE gs_acl (id INT);
    GRANT SELECT ON gs_acl TO gs_acl_reader;
    SELECT relacl FROM pg_class WHERE relname = 'gs_acl';
}
expect {
    {postgres=arwdDxtm/postgres,gs_acl_reader=r/postgres}
}

test relacl-is-null-before-the-first-grant {
    CREATE TABLE gs_untouched (id INT);
    SELECT coalesce(relacl::text, 'null') FROM pg_class WHERE relname = 'gs_untouched';
}
expect {
    null
}

test grant-select-to-public-is-stored-with-an-empty-grantee {
    CREATE TABLE gs_acl_public (id INT);
    GRANT SELECT ON gs_acl_public TO PUBLIC;
    SELECT relacl FROM pg_class WHERE relname = 'gs_acl_public';
}
expect {
    {postgres=arwdDxtm/postgres,=r/postgres}
}

test grant-select-to-several-roles-is-stored-in-order {
    CREATE ROLE gs_acl_first;
    CREATE ROLE gs_acl_second;
    CREATE TABLE gs_acl_many (id INT);
    GRANT SELECT ON gs_acl_many TO gs_acl_first, PUBLIC, gs_acl_second;
    SELECT relacl FROM pg_class WHERE relname = 'gs_acl_many';
}
expect {
    {postgres=arwdDxtm/postgres,gs_acl_first=r/postgres,=r/postgres,gs_acl_second=r/postgres}
}

test grant-select-twice-is-stored-once {
    CREATE ROLE gs_acl_twice;
    CREATE TABLE gs_acl_twice_docs (id INT);
    GRANT SELECT ON gs_acl_twice_docs TO gs_acl_twice;
    GRANT SELECT ON gs_acl_twice_docs TO gs_acl_twice;
    SELECT relacl FROM pg_class WHERE relname = 'gs_acl_twice_docs';
}
expect {
    {postgres=arwdDxtm/postgres,gs_acl_twice=r/postgres}
}

test grant-select-to-the-owner-stores-the-default-list {
    CREATE TABLE gs_acl_owner (id INT);
    GRANT SELECT ON gs_acl_owner TO postgres;
    SELECT relacl FROM pg_class WHERE relname = 'gs_acl_owner';
}
expect {
    {postgres=arwdDxtm/postgres}
}

test grant-select-to-a-mixed-case-role-is-stored-unquoted {
    CREATE ROLE "GsAclCased";
    CREATE TABLE gs_acl_cased (id INT);
    GRANT SELECT ON gs_acl_cased TO "GsAclCased";
    SELECT relacl FROM pg_class WHERE relname = 'gs_acl_cased';
}
expect {
    {postgres=arwdDxtm/postgres,GsAclCased=r/postgres}
}

test grant-select-on-sequence-is-stored-with-sequence-privileges {
    CREATE ROLE gs_acl_seq_reader;
    CREATE SEQUENCE gs_acl_seq;
    GRANT SELECT ON gs_acl_seq TO gs_acl_seq_reader;
    SELECT relacl FROM pg_class WHERE relname = 'gs_acl_seq';
}
expect {
    {postgres=rwU/postgres,gs_acl_seq_reader=r/postgres}
}

test grant-insert-update-delete-is-stored-in-relacl {
    CREATE ROLE gs_acl_writer;
    CREATE TABLE gs_acl_written (id INT);
    GRANT INSERT, UPDATE, DELETE ON gs_acl_written TO gs_acl_writer;
    SELECT relacl FROM pg_class WHERE relname = 'gs_acl_written';
}
expect {
    {postgres=arwdDxtm/postgres,gs_acl_writer=awd/postgres}
}

test grant-of-more-privileges-adds-them-to-the-entry {
    CREATE ROLE gs_acl_more;
    CREATE TABLE gs_acl_more_docs (id INT);
    GRANT SELECT ON gs_acl_more_docs TO gs_acl_more;
    GRANT TRUNCATE, INSERT ON gs_acl_more_docs TO gs_acl_more;
    SELECT relacl FROM pg_class WHERE relname = 'gs_acl_more_docs';
}
expect {
    {postgres=arwdDxtm/postgres,gs_acl_more=arD/postgres}
}

test grant-all-is-stored-as-every-table-privilege {
    CREATE ROLE gs_acl_everything;
    CREATE TABLE gs_acl_all_docs (id INT);
    CREATE TABLE gs_acl_all_privileges_docs (id INT);
    GRANT ALL ON gs_acl_all_docs TO gs_acl_everything;
    GRANT ALL PRIVILEGES ON TABLE gs_acl_all_privileges_docs TO gs_acl_everything;
    SELECT relname, relacl FROM pg_class
        WHERE relname IN ('gs_acl_all_docs', 'gs_acl_all_privileges_docs') ORDER BY relname;
}
expect {
    gs_acl_all_docs|{postgres=arwdDxtm/postgres,gs_acl_everything=arwdDxtm/postgres}
    gs_acl_all_privileges_docs|{postgres=arwdDxtm/postgres,gs_acl_everything=arwdDxtm/postgres}
}

test grant-all-on-all-tables-in-schema-is-stored-on-each-table {
    CREATE ROLE gs_acl_all_schema;
    CREATE SCHEMA gs_acl_all_schema_s;
    CREATE TABLE gs_acl_all_schema_s.a (id INT);
    CREATE TABLE gs_acl_all_schema_s.b (id INT);
    GRANT ALL ON ALL TABLES IN SCHEMA gs_acl_all_schema_s TO gs_acl_all_schema;
    SELECT c.relname, c.relacl FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
        WHERE n.nspname = 'gs_acl_all_schema_s' ORDER BY c.relname;
}
expect {
    a|{postgres=arwdDxtm/postgres,gs_acl_all_schema=arwdDxtm/postgres}
    b|{postgres=arwdDxtm/postgres,gs_acl_all_schema=arwdDxtm/postgres}
}

# A sequence has only SELECT, UPDATE and USAGE, and PostgreSQL leaves out
# the others with a warning.
test grant-all-on-sequence-is-stored-with-sequence-privileges {
    CREATE ROLE gs_acl_seq_all;
    CREATE SEQUENCE gs_acl_seq_all_s;
    GRANT ALL ON gs_acl_seq_all_s TO gs_acl_seq_all;
    SELECT relacl FROM pg_class WHERE relname = 'gs_acl_seq_all_s';
}
expect {
    {postgres=rwU/postgres,gs_acl_seq_all=rwU/postgres}
}

test grant-insert-on-sequence-stores-nothing-for-the-role {
    CREATE ROLE gs_acl_seq_insert;
    CREATE SEQUENCE gs_acl_seq_insert_s;
    GRANT INSERT ON gs_acl_seq_insert_s TO gs_acl_seq_insert;
    SELECT coalesce(relacl::text, 'null') FROM pg_class WHERE relname = 'gs_acl_seq_insert_s';
}
expect {
    null
}

test grant-of-a-privilege-tables-do-not-have-fails {
    CREATE ROLE gs_acl_usage;
    CREATE TABLE gs_acl_usage_docs (id INT);
    GRANT USAGE ON gs_acl_usage_docs TO gs_acl_usage;
}
@sqlstate 0LP01
expect error {
    invalid privilege type USAGE for table
}

@skip-if postgres "PostgreSQL supports column privileges"
test grant-of-column-privileges-is-not-supported {
    CREATE ROLE gs_acl_columns;
    CREATE TABLE gs_acl_columns_docs (id INT, body TEXT);
    GRANT UPDATE (body) ON gs_acl_columns_docs TO gs_acl_columns;
}
@sqlstate 0A000
expect error {
    GRANT of column privileges is not supported
}

# Views are granted on too, which the Rust integration tests cover, because
# pg_class does not list views yet.
test grant-select-on-all-tables-in-schema-is-stored-on-each-table-but-not-sequences {
    CREATE ROLE gs_acl_all;
    CREATE TABLE gs_acl_all_a (id INT);
    CREATE TABLE gs_acl_all_b (id INT);
    CREATE SEQUENCE gs_acl_all_s;
    GRANT SELECT ON ALL TABLES IN SCHEMA public TO gs_acl_all;
    SELECT relname, coalesce(relacl::text, 'null') FROM pg_class
    WHERE relname IN ('gs_acl_all_a', 'gs_acl_all_b', 'gs_acl_all_s') ORDER BY relname;
}
expect {
    gs_acl_all_a|{postgres=arwdDxtm/postgres,gs_acl_all=r/postgres}
    gs_acl_all_b|{postgres=arwdDxtm/postgres,gs_acl_all=r/postgres}
    gs_acl_all_s|null
}

test grant-select-by-the-owner-names-the-owner-as-grantor {
    CREATE ROLE gs_acl_owner_role;
    CREATE ROLE gs_acl_owner_reader;
    CREATE TABLE gs_acl_owned (id INT);
    ALTER TABLE gs_acl_owned OWNER TO gs_acl_owner_role;
    SET ROLE gs_acl_owner_role;
    GRANT SELECT ON gs_acl_owned TO gs_acl_owner_reader;
    SELECT relacl FROM pg_class WHERE relname = 'gs_acl_owned';
}
expect {
    {gs_acl_owner_role=arwdDxtm/gs_acl_owner_role,gs_acl_owner_reader=r/gs_acl_owner_role}
}

test grant-select-by-a-superuser-grants-as-the-owner {
    CREATE ROLE gs_acl_su_owner;
    CREATE ROLE gs_acl_su_reader;
    CREATE TABLE gs_acl_su_owned (id INT);
    ALTER TABLE gs_acl_su_owned OWNER TO gs_acl_su_owner;
    GRANT SELECT ON gs_acl_su_owned TO gs_acl_su_reader;
    SELECT relacl FROM pg_class WHERE relname = 'gs_acl_su_owned';
}
expect {
    {gs_acl_su_owner=arwdDxtm/gs_acl_su_owner,gs_acl_su_reader=r/gs_acl_su_owner}
}

test grant-select-by-a-role-without-privileges-fails {
    CREATE ROLE gs_acl_stranger;
    CREATE ROLE gs_acl_stranger_reader;
    CREATE TABLE gs_acl_not_theirs (id INT);
    SET ROLE gs_acl_stranger;
    GRANT SELECT ON gs_acl_not_theirs TO gs_acl_stranger_reader;
}
@sqlstate 42501
expect error {
    permission denied for table gs_acl_not_theirs
}

# PostgreSQL warns that no privileges were granted and stores nothing.
test grant-select-by-a-role-without-grant-option-stores-nothing {
    CREATE ROLE gs_acl_no_option;
    CREATE ROLE gs_acl_no_option_reader;
    CREATE TABLE gs_acl_readable (id INT);
    GRANT SELECT ON gs_acl_readable TO PUBLIC;
    SET ROLE gs_acl_no_option;
    GRANT SELECT ON gs_acl_readable TO gs_acl_no_option_reader;
    SET ROLE postgres;
    SELECT relacl FROM pg_class WHERE relname = 'gs_acl_readable';
}
expect {
    {postgres=arwdDxtm/postgres,=r/postgres}
}

test owner-to-after-grant-puts-the-new-owner-in-the-list {
    CREATE ROLE gs_acl_new_owner;
    CREATE ROLE gs_acl_kept_reader;
    CREATE TABLE gs_acl_handed_over (id INT);
    GRANT SELECT ON gs_acl_handed_over TO gs_acl_kept_reader;
    ALTER TABLE gs_acl_handed_over OWNER TO gs_acl_new_owner;
    SELECT relacl FROM pg_class WHERE relname = 'gs_acl_handed_over';
}
expect {
    {gs_acl_new_owner=arwdDxtm/gs_acl_new_owner,gs_acl_kept_reader=r/gs_acl_new_owner}
}

test grant-select-in-a-rolled-back-transaction-stores-nothing {
    CREATE ROLE gs_acl_rolled_back;
    CREATE TABLE gs_acl_rollback_docs (id INT);
    BEGIN;
    GRANT SELECT ON gs_acl_rollback_docs TO gs_acl_rolled_back;
    ROLLBACK;
    SELECT coalesce(relacl::text, 'null') FROM pg_class WHERE relname = 'gs_acl_rollback_docs';
}
expect {
    null
}

test grant-select-in-a-committed-transaction-is-stored {
    CREATE ROLE gs_acl_committed;
    CREATE TABLE gs_acl_commit_docs (id INT);
    BEGIN;
    GRANT SELECT ON gs_acl_commit_docs TO gs_acl_committed;
    COMMIT;
    SELECT relacl FROM pg_class WHERE relname = 'gs_acl_commit_docs';
}
expect {
    {postgres=arwdDxtm/postgres,gs_acl_committed=r/postgres}
}

test rename-after-grant-keeps-the-list {
    CREATE ROLE gs_acl_renamed_reader;
    CREATE TABLE gs_acl_before_rename (id INT);
    GRANT SELECT ON gs_acl_before_rename TO gs_acl_renamed_reader;
    ALTER TABLE gs_acl_before_rename RENAME TO gs_acl_after_rename;
    SELECT relacl FROM pg_class WHERE relname = 'gs_acl_after_rename';
}
expect {
    {postgres=arwdDxtm/postgres,gs_acl_renamed_reader=r/postgres}
}

# What GRANT allows: reading the table.

test role-without-select-cannot-read-the-table {
    CREATE ROLE gs_denied;
    CREATE TABLE gs_closed (id INT);
    SET ROLE gs_denied;
    SELECT id FROM gs_closed;
}
@sqlstate 42501
expect error {
    permission denied for table gs_closed
}

test role-without-select-cannot-read-the-table-in-a-join {
    CREATE ROLE gs_denied_join;
    CREATE TABLE gs_open_j (id INT);
    CREATE TABLE gs_closed_j (id INT);
    GRANT SELECT ON gs_open_j TO gs_denied_join;
    SET ROLE gs_denied_join;
    SELECT o.id FROM gs_open_j o JOIN gs_closed_j c ON c.id = o.id;
}
@sqlstate 42501
expect error {
    permission denied for table gs_closed_j
}

test role-without-select-cannot-read-the-table-in-a-subquery {
    CREATE ROLE gs_denied_sub;
    CREATE TABLE gs_closed_sub (id INT);
    SET ROLE gs_denied_sub;
    SELECT 1 WHERE EXISTS (SELECT 1 FROM gs_closed_sub);
}
@sqlstate 42501
expect error {
    permission denied for table gs_closed_sub
}

test role-without-select-cannot-read-the-table-in-a-cte {
    CREATE ROLE gs_denied_cte;
    CREATE TABLE gs_closed_cte (id INT);
    SET ROLE gs_denied_cte;
    WITH c AS (SELECT id FROM gs_closed_cte) SELECT id FROM c;
}
@sqlstate 42501
expect error {
    permission denied for table gs_closed_cte
}

test role-without-select-cannot-read-the-view {
    CREATE ROLE gs_denied_view;
    CREATE TABLE gs_view_closed_base (id INT);
    CREATE VIEW gs_closed_view AS SELECT id FROM gs_view_closed_base;
    SET ROLE gs_denied_view;
    SELECT id FROM gs_closed_view;
}
@sqlstate 42501
expect error {
    permission denied for view gs_closed_view
}

test select-on-the-view-is-enough-when-its-owner-reads-the-table {
    CREATE ROLE gs_view_only;
    CREATE TABLE gs_view_only_base (id INT);
    INSERT INTO gs_view_only_base VALUES (7);
    CREATE VIEW gs_view_only_view AS SELECT id FROM gs_view_only_base;
    GRANT SELECT ON gs_view_only_view TO gs_view_only;
    SET ROLE gs_view_only;
    SELECT id FROM gs_view_only_view;
}
expect {
    7
}

test select-on-the-view-is-not-enough-when-its-owner-cannot-read-the-table {
    CREATE ROLE gs_view_owner;
    CREATE ROLE gs_view_reader2;
    CREATE TABLE gs_view_private_base (id INT);
    CREATE VIEW gs_view_of_private AS SELECT id FROM gs_view_private_base;
    ALTER VIEW gs_view_of_private OWNER TO gs_view_owner;
    GRANT SELECT ON gs_view_of_private TO gs_view_reader2;
    SET ROLE gs_view_reader2;
    SELECT id FROM gs_view_of_private;
}
@sqlstate 42501
expect error {
    permission denied for table gs_view_private_base
}

test the-owner-reads-its-table-without-a-grant {
    CREATE ROLE gs_owner_reads;
    CREATE TABLE gs_owned_by_reader (id INT);
    INSERT INTO gs_owned_by_reader VALUES (3);
    ALTER TABLE gs_owned_by_reader OWNER TO gs_owner_reads;
    SET ROLE gs_owner_reads;
    SELECT id FROM gs_owned_by_reader;
}
expect {
    3
}

test select-granted-to-public-lets-a-role-made-later-read {
    CREATE TABLE gs_for_all (id INT);
    INSERT INTO gs_for_all VALUES (5);
    GRANT SELECT ON gs_for_all TO PUBLIC;
    CREATE ROLE gs_latecomer;
    SET ROLE gs_latecomer;
    SELECT id FROM gs_for_all;
}
expect {
    5
}

test select-granted-to-another-role-does-not-let-this-one-read {
    CREATE ROLE gs_granted_other;
    CREATE ROLE gs_not_granted;
    CREATE TABLE gs_for_other (id INT);
    GRANT SELECT ON gs_for_other TO gs_granted_other;
    SET ROLE gs_not_granted;
    SELECT id FROM gs_for_other;
}
@sqlstate 42501
expect error {
    permission denied for table gs_for_other
}

test reset-role-reads-again {
    CREATE ROLE gs_back_to_super;
    CREATE TABLE gs_after_reset (id INT);
    INSERT INTO gs_after_reset VALUES (9);
    SET ROLE gs_back_to_super;
    RESET ROLE;
    SELECT id FROM gs_after_reset;
}
expect {
    9
}

test role-without-select-cannot-count-the-table {
    CREATE ROLE gs_denied_count;
    CREATE TABLE gs_closed_count (id INT);
    SET ROLE gs_denied_count;
    SELECT count(*) FROM gs_closed_count;
}
@sqlstate 42501
expect error {
    permission denied for table gs_closed_count
}

# What the write privileges let a role do. As in PostgreSQL, a write that
# reads the table's columns, in WHERE, SET, RETURNING or ON CONFLICT, also
# needs SELECT.

test role-without-insert-cannot-insert {
    CREATE ROLE gw_no_insert;
    CREATE TABLE gw_no_insert_docs (id INT);
    GRANT SELECT ON gw_no_insert_docs TO gw_no_insert;
    SET ROLE gw_no_insert;
    INSERT INTO gw_no_insert_docs VALUES (1);
}
@sqlstate 42501
expect error {
    permission denied for table gw_no_insert_docs
}

test grant-insert-lets-a-role-insert {
    CREATE ROLE gw_inserter;
    CREATE TABLE gw_inserted (id INT, body TEXT);
    GRANT INSERT ON gw_inserted TO gw_inserter;
    SET ROLE gw_inserter;
    INSERT INTO gw_inserted VALUES (1, 'a'), (2, 'b');
    INSERT INTO gw_inserted (id) SELECT 3;
    RESET ROLE;
    SELECT id, coalesce(body, 'null') FROM gw_inserted ORDER BY id;
}
expect {
    1|a
    2|b
    3|null
}

test grant-insert-to-public-lets-every-role-insert {
    CREATE ROLE gw_public_inserter;
    CREATE TABLE gw_public_inserted (id INT);
    GRANT INSERT ON gw_public_inserted TO PUBLIC;
    SET ROLE gw_public_inserter;
    INSERT INTO gw_public_inserted VALUES (1);
    RESET ROLE;
    SELECT id FROM gw_public_inserted;
}
expect {
    1
}

test insert-returning-a-column-needs-select {
    CREATE ROLE gw_returning;
    CREATE TABLE gw_returning_docs (id INT);
    GRANT INSERT ON gw_returning_docs TO gw_returning;
    SET ROLE gw_returning;
    INSERT INTO gw_returning_docs VALUES (1) RETURNING id;
}
@sqlstate 42501
expect error {
    permission denied for table gw_returning_docs
}

test insert-returning-a-column-with-select {
    CREATE ROLE gw_returning_reader;
    CREATE TABLE gw_returning_read (id INT);
    GRANT INSERT, SELECT ON gw_returning_read TO gw_returning_reader;
    SET ROLE gw_returning_reader;
    INSERT INTO gw_returning_read VALUES (7) RETURNING id;
}
expect {
    7
}

test insert-on-conflict-with-a-target-needs-select {
    CREATE ROLE gw_conflict_target;
    CREATE TABLE gw_conflict_target_docs (id INT PRIMARY KEY);
    GRANT INSERT ON gw_conflict_target_docs TO gw_conflict_target;
    SET ROLE gw_conflict_target;
    INSERT INTO gw_conflict_target_docs VALUES (1) ON CONFLICT (id) DO NOTHING;
}
@sqlstate 42501
expect error {
    permission denied for table gw_conflict_target_docs
}

test insert-on-conflict-do-nothing-without-a-target-needs-only-insert {
    CREATE ROLE gw_conflict_any;
    CREATE TABLE gw_conflict_any_docs (id INT PRIMARY KEY);
    INSERT INTO gw_conflict_any_docs VALUES (1);
    GRANT INSERT ON gw_conflict_any_docs TO gw_conflict_any;
    SET ROLE gw_conflict_any;
    INSERT INTO gw_conflict_any_docs VALUES (1), (2) ON CONFLICT DO NOTHING;
    RESET ROLE;
    SELECT id FROM gw_conflict_any_docs ORDER BY id;
}
expect {
    1
    2
}

test insert-on-conflict-do-update-needs-update {
    CREATE ROLE gw_upsert_no_update;
    CREATE TABLE gw_upsert_no_update_docs (id INT PRIMARY KEY, n INT);
    GRANT INSERT, SELECT ON gw_upsert_no_update_docs TO gw_upsert_no_update;
    SET ROLE gw_upsert_no_update;
    INSERT INTO gw_upsert_no_update_docs VALUES (1, 1)
        ON CONFLICT (id) DO UPDATE SET n = excluded.n;
}
@sqlstate 42501
expect error {
    permission denied for table gw_upsert_no_update_docs
}

@skip-if postgres "PostgreSQL rejects DO UPDATE without a conflict target as a syntax error"
test insert-on-conflict-do-update-without-a-target-needs-select {
    CREATE ROLE gw_upsert_no_target;
    CREATE TABLE gw_upsert_no_target_docs (id INT PRIMARY KEY, secret INT, n INT);
    INSERT INTO gw_upsert_no_target_docs VALUES (1, 42, 0);
    GRANT INSERT, UPDATE ON gw_upsert_no_target_docs TO gw_upsert_no_target;
    SET ROLE gw_upsert_no_target;
    INSERT INTO gw_upsert_no_target_docs VALUES (1, 0, 0)
        ON CONFLICT DO UPDATE SET n = 1 WHERE gw_upsert_no_target_docs.secret = 42;
}
@sqlstate 42501
expect error {
    permission denied for table gw_upsert_no_target_docs
}

test insert-on-conflict-do-update-with-insert-select-and-update {
    CREATE ROLE gw_upserter;
    CREATE TABLE gw_upserted (id INT PRIMARY KEY, n INT);
    INSERT INTO gw_upserted VALUES (1, 1);
    GRANT INSERT, SELECT, UPDATE ON gw_upserted TO gw_upserter;
    SET ROLE gw_upserter;
    INSERT INTO gw_upserted VALUES (1, 10), (2, 20)
        ON CONFLICT (id) DO UPDATE SET n = gw_upserted.n + excluded.n;
    RESET ROLE;
    SELECT id, n FROM gw_upserted ORDER BY id;
}
expect {
    1|11
    2|20
}

test role-without-update-cannot-update {
    CREATE ROLE gw_no_update;
    CREATE TABLE gw_no_update_docs (id INT);
    GRANT SELECT, INSERT ON gw_no_update_docs TO gw_no_update;
    SET ROLE gw_no_update;
    UPDATE gw_no_update_docs SET id = 2;
}
@sqlstate 42501
expect error {
    permission denied for table gw_no_update_docs
}

test grant-update-lets-a-role-update-every-row {
    CREATE ROLE gw_updater;
    CREATE TABLE gw_updated (id INT, body TEXT);
    INSERT INTO gw_updated VALUES (1, 'a'), (2, 'b');
    GRANT UPDATE ON gw_updated TO gw_updater;
    SET ROLE gw_updater;
    UPDATE gw_updated SET body = 'x';
    RESET ROLE;
    SELECT id, body FROM gw_updated ORDER BY id;
}
expect {
    1|x
    2|x
}

test update-with-where-needs-select {
    CREATE ROLE gw_update_where;
    CREATE TABLE gw_update_where_docs (id INT, body TEXT);
    GRANT UPDATE ON gw_update_where_docs TO gw_update_where;
    SET ROLE gw_update_where;
    UPDATE gw_update_where_docs SET body = 'x' WHERE id = 1;
}
@sqlstate 42501
expect error {
    permission denied for table gw_update_where_docs
}

test update-that-reads-a-column-in-set-needs-select {
    CREATE ROLE gw_update_set;
    CREATE TABLE gw_update_set_docs (id INT, n INT);
    GRANT UPDATE ON gw_update_set_docs TO gw_update_set;
    SET ROLE gw_update_set;
    UPDATE gw_update_set_docs SET n = n + 1;
}
@sqlstate 42501
expect error {
    permission denied for table gw_update_set_docs
}

test update-with-where-and-returning-with-select {
    CREATE ROLE gw_update_reader;
    CREATE TABLE gw_update_read (id INT, n INT);
    INSERT INTO gw_update_read VALUES (1, 1), (2, 2);
    GRANT SELECT, UPDATE ON gw_update_read TO gw_update_reader;
    SET ROLE gw_update_reader;
    UPDATE gw_update_read SET n = n + 10 WHERE id = 2 RETURNING id, n;
}
expect {
    2|12
}

test role-without-delete-cannot-delete {
    CREATE ROLE gw_no_delete;
    CREATE TABLE gw_no_delete_docs (id INT);
    GRANT SELECT, INSERT, UPDATE ON gw_no_delete_docs TO gw_no_delete;
    SET ROLE gw_no_delete;
    DELETE FROM gw_no_delete_docs;
}
@sqlstate 42501
expect error {
    permission denied for table gw_no_delete_docs
}

test grant-delete-lets-a-role-delete-every-row {
    CREATE ROLE gw_deleter;
    CREATE TABLE gw_deleted (id INT);
    INSERT INTO gw_deleted VALUES (1), (2);
    GRANT DELETE ON gw_deleted TO gw_deleter;
    SET ROLE gw_deleter;
    DELETE FROM gw_deleted;
    RESET ROLE;
    SELECT count(*) FROM gw_deleted;
}
expect {
    0
}

test truncate-needs-truncate-not-delete {
    CREATE ROLE gw_truncate_delete;
    CREATE TABLE gw_truncate_delete_docs (id INT);
    GRANT DELETE ON gw_truncate_delete_docs TO gw_truncate_delete;
    SET ROLE gw_truncate_delete;
    TRUNCATE gw_truncate_delete_docs;
}
@sqlstate 42501
expect error {
    permission denied for table gw_truncate_delete_docs
}

test grant-truncate-lets-a-role-truncate {
    CREATE ROLE gw_truncater;
    CREATE TABLE gw_truncated (id INT);
    INSERT INTO gw_truncated VALUES (1), (2);
    GRANT TRUNCATE ON gw_truncated TO gw_truncater;
    SET ROLE gw_truncater;
    TRUNCATE gw_truncated;
    RESET ROLE;
    SELECT count(*) FROM gw_truncated;
}
expect {
    0
}

# Row-level security does not apply to TRUNCATE, as in PostgreSQL.
test truncate-empties-a-table-with-row-level-security {
    CREATE ROLE gw_truncate_rls;
    CREATE TABLE gw_truncated_rls (id INT);
    INSERT INTO gw_truncated_rls VALUES (1), (2);
    ALTER TABLE gw_truncated_rls ENABLE ROW LEVEL SECURITY;
    GRANT TRUNCATE ON gw_truncated_rls TO gw_truncate_rls;
    SET ROLE gw_truncate_rls;
    TRUNCATE gw_truncated_rls;
    RESET ROLE;
    SELECT count(*) FROM gw_truncated_rls;
}
expect {
    0
}

test grant-truncate-does-not-let-a-role-delete {
    CREATE ROLE gw_truncate_only;
    CREATE TABLE gw_truncate_only_docs (id INT);
    GRANT TRUNCATE ON gw_truncate_only_docs TO gw_truncate_only;
    SET ROLE gw_truncate_only;
    DELETE FROM gw_truncate_only_docs;
}
@sqlstate 42501
expect error {
    permission denied for table gw_truncate_only_docs
}

test delete-with-where-needs-select {
    CREATE ROLE gw_delete_where;
    CREATE TABLE gw_delete_where_docs (id INT);
    GRANT DELETE ON gw_delete_where_docs TO gw_delete_where;
    SET ROLE gw_delete_where;
    DELETE FROM gw_delete_where_docs WHERE id = 1;
}
@sqlstate 42501
expect error {
    permission denied for table gw_delete_where_docs
}

test delete-with-where-with-select {
    CREATE ROLE gw_delete_reader;
    CREATE TABLE gw_delete_read (id INT);
    INSERT INTO gw_delete_read VALUES (1), (2);
    GRANT SELECT, DELETE ON gw_delete_read TO gw_delete_reader;
    SET ROLE gw_delete_reader;
    DELETE FROM gw_delete_read WHERE id = 1 RETURNING id;
    RESET ROLE;
    SELECT id FROM gw_delete_read;
}
expect {
    1
    2
}

# A subquery needs SELECT on the table that is written only when it reads a
# column of that table.
test update-with-subqueries-that-do-not-read-the-table-needs-no-select {
    CREATE ROLE gw_update_subquery;
    CREATE TABLE gw_update_subquery_docs (id INT, n INT);
    INSERT INTO gw_update_subquery_docs VALUES (1, 1), (2, 2);
    GRANT UPDATE ON gw_update_subquery_docs TO gw_update_subquery;
    SET ROLE gw_update_subquery;
    UPDATE gw_update_subquery_docs SET n = (SELECT 10) WHERE EXISTS (SELECT 1) RETURNING (SELECT 'ok');
    RESET ROLE;
    SELECT id, n FROM gw_update_subquery_docs ORDER BY id;
}
expect {
    ok
    ok
    1|10
    2|10
}

test update-with-a-subquery-that-reads-the-table-needs-select {
    CREATE ROLE gw_update_correlated;
    CREATE TABLE gw_update_correlated_docs (id INT, n INT);
    CREATE TABLE gw_update_correlated_src (id INT, n INT);
    GRANT UPDATE ON gw_update_correlated_docs TO gw_update_correlated;
    GRANT SELECT ON gw_update_correlated_src TO gw_update_correlated;
    SET ROLE gw_update_correlated;
    UPDATE gw_update_correlated_docs SET n = (SELECT s.n FROM gw_update_correlated_src s WHERE s.id = gw_update_correlated_docs.id);
}
@sqlstate 42501
expect error {
    permission denied for table gw_update_correlated_docs
}

test update-with-a-nested-subquery-that-reads-the-table-needs-select {
    CREATE ROLE gw_update_nested;
    CREATE TABLE gw_update_nested_docs (id INT, n INT);
    GRANT UPDATE ON gw_update_nested_docs TO gw_update_nested;
    SET ROLE gw_update_nested;
    UPDATE gw_update_nested_docs SET n = (SELECT (SELECT gw_update_nested_docs.id));
}
@sqlstate 42501
expect error {
    permission denied for table gw_update_nested_docs
}

test delete-with-subqueries-that-do-not-read-the-table-needs-no-select {
    CREATE ROLE gw_delete_subquery;
    CREATE TABLE gw_delete_subquery_docs (id INT);
    CREATE TABLE gw_delete_subquery_src (id INT);
    INSERT INTO gw_delete_subquery_docs VALUES (1), (2);
    INSERT INTO gw_delete_subquery_src VALUES (1);
    GRANT DELETE ON gw_delete_subquery_docs TO gw_delete_subquery;
    GRANT SELECT ON gw_delete_subquery_src TO gw_delete_subquery;
    SET ROLE gw_delete_subquery;
    DELETE FROM gw_delete_subquery_docs WHERE EXISTS (SELECT 1 FROM gw_delete_subquery_src) RETURNING (SELECT 'ok');
    RESET ROLE;
    SELECT count(*) FROM gw_delete_subquery_docs;
}
expect {
    ok
    ok
    0
}

test delete-with-a-subquery-that-reads-the-table-needs-select {
    CREATE ROLE gw_delete_correlated;
    CREATE TABLE gw_delete_correlated_docs (id INT);
    CREATE TABLE gw_delete_correlated_src (id INT);
    GRANT DELETE ON gw_delete_correlated_docs TO gw_delete_correlated;
    GRANT SELECT ON gw_delete_correlated_src TO gw_delete_correlated;
    SET ROLE gw_delete_correlated;
    DELETE FROM gw_delete_correlated_docs WHERE EXISTS (SELECT 1 FROM gw_delete_correlated_src s WHERE s.id = gw_delete_correlated_docs.id);
}
@sqlstate 42501
expect error {
    permission denied for table gw_delete_correlated_docs
}

test insert-with-a-subquery-in-returning-that-does-not-read-the-table-needs-no-select {
    CREATE ROLE gw_insert_subquery;
    CREATE TABLE gw_insert_subquery_docs (id INT);
    GRANT INSERT ON gw_insert_subquery_docs TO gw_insert_subquery;
    SET ROLE gw_insert_subquery;
    INSERT INTO gw_insert_subquery_docs VALUES (1) RETURNING (SELECT 'ok');
}
expect {
    ok
}

test grant-all-lets-a-role-write {
    CREATE ROLE gw_all;
    CREATE TABLE gw_all_docs (id INT, n INT);
    GRANT ALL ON gw_all_docs TO gw_all;
    SET ROLE gw_all;
    INSERT INTO gw_all_docs VALUES (1, 1), (2, 2);
    UPDATE gw_all_docs SET n = n * 10 WHERE id = 2;
    DELETE FROM gw_all_docs WHERE id = 1;
    SELECT id, n FROM gw_all_docs;
}
expect {
    2|20
}

test owner-writes-its-own-table {
    CREATE ROLE gw_owner;
    CREATE TABLE gw_owned (id INT, n INT);
    ALTER TABLE gw_owned OWNER TO gw_owner;
    SET ROLE gw_owner;
    INSERT INTO gw_owned VALUES (1, 1), (2, 2);
    UPDATE gw_owned SET n = n + 1 WHERE id = 1;
    DELETE FROM gw_owned WHERE id = 2;
    SELECT id, n FROM gw_owned;
}
expect {
    1|2
}

# ALTER TABLE rewrites the table's definition in the schema, which needs no
# privilege besides owning the table.
test owner-alters-the-columns-of-its-own-table {
    CREATE ROLE gw_alter_owner;
    CREATE TABLE gw_altered (id INT);
    CREATE INDEX gw_altered_id ON gw_altered (id);
    CREATE VIEW gw_altered_ids AS SELECT id FROM gw_altered;
    ALTER TABLE gw_altered OWNER TO gw_alter_owner;
    ALTER VIEW gw_altered_ids OWNER TO gw_alter_owner;
    SET ROLE gw_alter_owner;
    ALTER TABLE gw_altered ADD COLUMN n INT;
    ALTER TABLE gw_altered RENAME COLUMN n TO m;
    ALTER TABLE gw_altered RENAME COLUMN id TO key;
    ALTER TABLE gw_altered DROP COLUMN m;
    INSERT INTO gw_altered VALUES (1);
    SELECT key FROM gw_altered;
}
expect {
    1
}

# Sequences. As in PostgreSQL, nextval() needs USAGE or UPDATE on the
# sequence, and setval() needs UPDATE, so a role that inserts into a table
# with a serial column needs USAGE on the column's sequence too. Turso does
# not use the sequence for a serial PRIMARY KEY column, so the tests below
# use serial columns that are not the primary key.

test grant-on-sequence-is-stored-in-relacl {
    CREATE ROLE gq_stored;
    CREATE SEQUENCE gq_stored_s;
    GRANT USAGE, UPDATE ON SEQUENCE gq_stored_s TO gq_stored;
    SELECT relacl FROM pg_class WHERE relname = 'gq_stored_s';
}
expect {
    {postgres=rwU/postgres,gq_stored=wU/postgres}
}

test grant-usage-on-a-sequence-named-as-a-table-is-stored {
    CREATE ROLE gq_usage_as_table;
    CREATE SEQUENCE gq_usage_as_table_s;
    GRANT USAGE ON gq_usage_as_table_s TO gq_usage_as_table;
    SELECT relacl FROM pg_class WHERE relname = 'gq_usage_as_table_s';
}
expect {
    {postgres=rwU/postgres,gq_usage_as_table=U/postgres}
}

test grant-usage-on-a-sequence-and-a-table-fails {
    CREATE ROLE gq_usage_mixed;
    CREATE SEQUENCE gq_usage_mixed_s;
    CREATE TABLE gq_usage_mixed_t (id INT);
    GRANT USAGE ON gq_usage_mixed_s, gq_usage_mixed_t TO gq_usage_mixed;
}
@sqlstate 0LP01
expect error {
    invalid privilege type USAGE for table
}

test grant-all-on-all-sequences-in-schema-is-stored-on-each-sequence-but-not-tables {
    CREATE ROLE gq_all;
    CREATE SCHEMA gq_all_schema;
    CREATE SEQUENCE gq_all_schema.s;
    CREATE TABLE gq_all_schema.t (id INT);
    GRANT ALL ON ALL SEQUENCES IN SCHEMA gq_all_schema TO gq_all;
    SELECT c.relname, coalesce(c.relacl::text, 'null') FROM pg_class c
        JOIN pg_namespace n ON n.oid = c.relnamespace
        WHERE n.nspname = 'gq_all_schema' ORDER BY c.relname;
}
expect {
    s|{postgres=rwU/postgres,gq_all=rwU/postgres}
    t|null
}

test grant-on-sequence-of-a-table-fails {
    CREATE ROLE gq_not_a_sequence;
    CREATE TABLE gq_not_a_sequence_t (id INT);
    GRANT USAGE ON SEQUENCE gq_not_a_sequence_t TO gq_not_a_sequence;
}
@sqlstate 42809
expect error {
    "gq_not_a_sequence_t" is not a sequence
}

test grant-of-a-privilege-sequences-do-not-have-fails {
    CREATE ROLE gq_insert;
    CREATE SEQUENCE gq_insert_s;
    GRANT INSERT ON SEQUENCE gq_insert_s TO gq_insert;
}
@sqlstate 0LP01
expect error {
    invalid privilege type INSERT for sequence
}

test role-without-usage-cannot-call-nextval {
    CREATE ROLE gq_no_usage;
    CREATE SEQUENCE gq_no_usage_s;
    SET ROLE gq_no_usage;
    SELECT nextval('gq_no_usage_s');
}
@sqlstate 42501
expect error {
    permission denied for sequence gq_no_usage_s
}

test grant-usage-lets-a-role-call-nextval {
    CREATE ROLE gq_usage;
    CREATE SEQUENCE gq_usage_s;
    GRANT USAGE ON SEQUENCE gq_usage_s TO gq_usage;
    SET ROLE gq_usage;
    SELECT nextval('gq_usage_s');
    SELECT nextval('gq_usage_s');
}
expect {
    1
    2
}

test grant-update-lets-a-role-call-nextval {
    CREATE ROLE gq_update;
    CREATE SEQUENCE gq_update_s;
    GRANT UPDATE ON SEQUENCE gq_update_s TO gq_update;
    SET ROLE gq_update;
    SELECT nextval('gq_update_s');
}
expect {
    1
}

test setval-needs-update {
    CREATE ROLE gq_setval;
    CREATE SEQUENCE gq_setval_s;
    GRANT USAGE ON SEQUENCE gq_setval_s TO gq_setval;
    SET ROLE gq_setval;
    SELECT setval('gq_setval_s', 10);
}
@sqlstate 42501
expect error {
    permission denied for sequence gq_setval_s
}

test grant-update-lets-a-role-call-setval {
    CREATE ROLE gq_setval_update;
    CREATE SEQUENCE gq_setval_update_s;
    GRANT UPDATE ON SEQUENCE gq_setval_update_s TO gq_setval_update;
    SET ROLE gq_setval_update;
    SELECT setval('gq_setval_update_s', 10);
    SELECT nextval('gq_setval_update_s');
}
expect {
    10
    11
}

test insert-into-a-serial-column-needs-usage-on-its-sequence {
    CREATE ROLE gq_serial_no_usage;
    CREATE TABLE gq_serial_no_usage_t (id SERIAL, body TEXT);
    GRANT INSERT ON gq_serial_no_usage_t TO gq_serial_no_usage;
    SET ROLE gq_serial_no_usage;
    INSERT INTO gq_serial_no_usage_t (body) VALUES ('a');
}
@sqlstate 42501
expect error {
    permission denied for sequence gq_serial_no_usage_t_id_seq
}

test insert-into-a-serial-column-with-usage-on-its-sequence {
    CREATE ROLE gq_serial;
    CREATE TABLE gq_serial_t (id SERIAL, body TEXT);
    GRANT INSERT ON gq_serial_t TO gq_serial;
    GRANT USAGE ON SEQUENCE gq_serial_t_id_seq TO gq_serial;
    SET ROLE gq_serial;
    INSERT INTO gq_serial_t (body) VALUES ('a'), ('b');
    RESET ROLE;
    SELECT id, body FROM gq_serial_t ORDER BY id;
}
expect {
    1|a
    2|b
}

test role-without-privileges-cannot-call-currval {
    CREATE ROLE gq_no_currval;
    CREATE SEQUENCE gq_no_currval_seq;
    SELECT nextval('gq_no_currval_seq');
    SET ROLE gq_no_currval;
    SELECT currval('gq_no_currval_seq');
}
@sqlstate 42501
expect error {
    permission denied for sequence gq_no_currval_seq
}

test grant-select-lets-a-role-call-currval {
    CREATE ROLE gq_currval_select;
    CREATE SEQUENCE gq_currval_select_seq;
    SELECT nextval('gq_currval_select_seq');
    GRANT SELECT ON SEQUENCE gq_currval_select_seq TO gq_currval_select;
    SET ROLE gq_currval_select;
    SELECT currval('gq_currval_select_seq');
}
expect {
    1
    1
}

test grant-usage-lets-a-role-call-currval {
    CREATE ROLE gq_currval_usage;
    CREATE SEQUENCE gq_currval_usage_seq;
    GRANT USAGE ON SEQUENCE gq_currval_usage_seq TO gq_currval_usage;
    SET ROLE gq_currval_usage;
    SELECT nextval('gq_currval_usage_seq');
    SELECT currval('gq_currval_usage_seq');
}
expect {
    1
    1
}

test currval-checks-a-sequence-name-computed-when-the-statement-runs {
    CREATE ROLE gq_currval_computed;
    CREATE SEQUENCE gq_currval_computed_seq;
    CREATE TABLE gq_currval_names (n text);
    INSERT INTO gq_currval_names VALUES ('gq_currval_computed_seq');
    GRANT SELECT ON gq_currval_names TO gq_currval_computed;
    GRANT USAGE ON SEQUENCE gq_currval_computed_seq TO gq_currval_computed;
    SET ROLE gq_currval_computed;
    SELECT nextval('gq_currval_computed_seq');
    SELECT currval(lower('GQ_CURRVAL_COMPUTED_SEQ'));
    SELECT currval(n) FROM gq_currval_names;
}
expect {
    1
    1
    1
}

test currval-denies-a-sequence-name-computed-when-the-statement-runs {
    CREATE ROLE gq_currval_computed_denied;
    CREATE SEQUENCE gq_currval_computed_denied_seq;
    SELECT nextval('gq_currval_computed_denied_seq');
    SET ROLE gq_currval_computed_denied;
    SELECT currval(lower('GQ_CURRVAL_COMPUTED_DENIED_SEQ'));
}
@sqlstate 42501
expect error {
    permission denied for sequence gq_currval_computed_denied_seq
}

test pg-sequences-hides-last-value-from-a-role-without-privileges {
    CREATE ROLE gq_seq_view;
    CREATE SEQUENCE gq_seq_view_seq;
    SELECT nextval('gq_seq_view_seq');
    SET ROLE gq_seq_view;
    SELECT coalesce(last_value::text, 'null') FROM pg_sequences
        WHERE sequencename = 'gq_seq_view_seq';
}
expect {
    1
    null
}

test pg-sequences-shows-last-value-to-a-role-with-usage {
    CREATE ROLE gq_seq_view_usage;
    CREATE SEQUENCE gq_seq_view_usage_seq;
    SELECT nextval('gq_seq_view_usage_seq');
    GRANT USAGE ON SEQUENCE gq_seq_view_usage_seq TO gq_seq_view_usage;
    SET ROLE gq_seq_view_usage;
    SELECT last_value FROM pg_sequences WHERE sequencename = 'gq_seq_view_usage_seq';
}
expect {
    1
    1
}

# The engine keeps its catalogs, such as the roles and the privileges of
# each table, in __turso_internal_* tables, which only a superuser uses.
@skip-if postgres "PostgreSQL has no __turso_internal_* tables"
test role-cannot-read-the-engine-catalog-tables {
    CREATE ROLE gs_catalog_reader;
    SET ROLE gs_catalog_reader;
    SELECT * FROM pg_catalog.__turso_internal_classes;
}
@sqlstate 42501
expect error {
    permission denied for table __turso_internal_classes
}

@skip-if postgres "PostgreSQL has no __turso_internal_* tables"
test superuser-reads-the-engine-catalog-tables {
    CREATE ROLE gs_catalog_listed;
    SELECT name FROM pg_catalog.__turso_internal_roles WHERE name = 'gs_catalog_listed';
}
expect {
    gs_catalog_listed
}

@skip-if postgres "PostgreSQL has no sqlite_sequence table"
test role-cannot-read-sqlite-sequence {
    CREATE ROLE gs_sequence_reader;
    SET ROLE gs_sequence_reader;
    SELECT * FROM pg_catalog.sqlite_sequence;
}
@sqlstate 42501
expect error {
    permission denied for table sqlite_sequence
}

@skip-if postgres "PostgreSQL has no __turso_internal_* tables"
test grant-on-an-engine-table-is-not-supported {
    CREATE ROLE gs_catalog_grantee;
    GRANT SELECT ON pg_catalog.__turso_internal_roles TO gs_catalog_grantee;
}
@sqlstate 0A000
expect error {
    GRANT on internal table __turso_internal_roles is not supported
}

# REVOKE takes privileges out of the entry the owner granted. An entry left
# with no privileges is removed from the list.

test revoke-select-removes-the-entry {
    CREATE ROLE rv_reader;
    CREATE TABLE rv_docs (id INT);
    GRANT SELECT ON rv_docs TO rv_reader;
    REVOKE SELECT ON rv_docs FROM rv_reader;
    SELECT relacl FROM pg_class WHERE relname = 'rv_docs';
}
expect {
    {postgres=arwdDxtm/postgres}
}

test revoke-some-privileges-keeps-the-others {
    CREATE ROLE rv_writer;
    CREATE TABLE rv_written (id INT);
    GRANT SELECT, INSERT, UPDATE ON rv_written TO rv_writer;
    REVOKE INSERT, UPDATE ON TABLE rv_written FROM rv_writer;
    SELECT relacl FROM pg_class WHERE relname = 'rv_written';
}
expect {
    {postgres=arwdDxtm/postgres,rv_writer=r/postgres}
}

test revoke-all-from-public {
    CREATE TABLE rv_public (id INT);
    GRANT ALL ON rv_public TO PUBLIC;
    REVOKE ALL PRIVILEGES ON rv_public FROM PUBLIC;
    SELECT relacl FROM pg_class WHERE relname = 'rv_public';
}
expect {
    {postgres=arwdDxtm/postgres}
}

test revoke-before-any-grant-stores-the-default-list {
    CREATE TABLE rv_untouched (id INT);
    REVOKE SELECT ON rv_untouched FROM PUBLIC;
    SELECT relacl FROM pg_class WHERE relname = 'rv_untouched';
}
expect {
    {postgres=arwdDxtm/postgres}
}

test revoke-from-the-owner {
    CREATE TABLE rv_owner_some (id INT);
    CREATE TABLE rv_owner_all (id INT);
    REVOKE INSERT, DELETE ON rv_owner_some FROM postgres;
    REVOKE ALL ON rv_owner_all FROM CURRENT_USER;
    SELECT relname, relacl FROM pg_class
        WHERE relname IN ('rv_owner_some', 'rv_owner_all') ORDER BY relname;
}
expect {
    rv_owner_all|{}
    rv_owner_some|{postgres=rwDxtm/postgres}
}

test revoke-on-all-tables-in-schema {
    CREATE ROLE rv_all_tables;
    CREATE SCHEMA rv_schema;
    CREATE TABLE rv_schema.a (id INT);
    CREATE TABLE rv_schema.b (id INT);
    GRANT SELECT, INSERT ON ALL TABLES IN SCHEMA rv_schema TO rv_all_tables;
    REVOKE INSERT ON ALL TABLES IN SCHEMA rv_schema FROM rv_all_tables;
    SELECT c.relname, c.relacl FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
        WHERE n.nspname = 'rv_schema' ORDER BY c.relname;
}
expect {
    a|{postgres=arwdDxtm/postgres,rv_all_tables=r/postgres}
    b|{postgres=arwdDxtm/postgres,rv_all_tables=r/postgres}
}

test revoke-on-sequence {
    CREATE ROLE rv_seq_user;
    CREATE SEQUENCE rv_seq;
    GRANT ALL ON SEQUENCE rv_seq TO rv_seq_user;
    REVOKE USAGE ON SEQUENCE rv_seq FROM rv_seq_user;
    SELECT relacl FROM pg_class WHERE relname = 'rv_seq';
}
expect {
    {postgres=rwU/postgres,rv_seq_user=rw/postgres}
}

test revoke-cascade-and-restrict {
    CREATE ROLE rv_cascade;
    CREATE TABLE rv_cascade_docs (id INT);
    GRANT SELECT, INSERT ON rv_cascade_docs TO rv_cascade;
    REVOKE SELECT ON rv_cascade_docs FROM rv_cascade CASCADE;
    REVOKE INSERT ON rv_cascade_docs FROM rv_cascade RESTRICT;
    SELECT relacl FROM pg_class WHERE relname = 'rv_cascade_docs';
}
expect {
    {postgres=arwdDxtm/postgres}
}

test revoke-select-stops-a-role-reading {
    CREATE ROLE rv_former_reader;
    CREATE TABLE rv_closed (id INT);
    GRANT SELECT ON rv_closed TO rv_former_reader;
    REVOKE SELECT ON rv_closed FROM rv_former_reader;
    SET ROLE rv_former_reader;
    SELECT id FROM rv_closed;
}
@sqlstate 42501
expect error {
    permission denied for table rv_closed
}

test revoke-from-public-keeps-a-direct-grant {
    CREATE ROLE rv_direct;
    CREATE TABLE rv_both (id INT);
    INSERT INTO rv_both VALUES (1);
    GRANT SELECT ON rv_both TO PUBLIC, rv_direct;
    REVOKE SELECT ON rv_both FROM PUBLIC;
    SET ROLE rv_direct;
    SELECT id FROM rv_both;
}
expect {
    1
}

test revoke-from-missing-role-fails {
    CREATE TABLE rv_missing_role (id INT);
    REVOKE SELECT ON rv_missing_role FROM rv_no_such_role;
}
@sqlstate 42704
expect error {
    role "rv_no_such_role" does not exist
}

test revoke-on-missing-table-fails {
    REVOKE SELECT ON rv_no_such_table FROM PUBLIC;
}
@sqlstate 42P01
expect error {
    relation "rv_no_such_table" does not exist
}

test revoke-by-a-role-without-privileges-fails {
    CREATE ROLE rv_stranger;
    CREATE TABLE rv_not_theirs (id INT);
    SET ROLE rv_stranger;
    REVOKE SELECT ON rv_not_theirs FROM PUBLIC;
}
@sqlstate 42501
expect error {
    permission denied for table rv_not_theirs
}

# PostgreSQL warns that no privileges could be revoked and changes nothing.
test revoke-by-a-role-without-grant-option-changes-nothing {
    CREATE ROLE rv_no_option;
    CREATE TABLE rv_readable (id INT);
    GRANT SELECT ON rv_readable TO PUBLIC;
    SET ROLE rv_no_option;
    REVOKE SELECT ON rv_readable FROM PUBLIC;
    SET ROLE postgres;
    SELECT relacl FROM pg_class WHERE relname = 'rv_readable';
}
expect {
    {postgres=arwdDxtm/postgres,=r/postgres}
}

@skip-if postgres "PostgreSQL supports grant options"
test revoke-grant-option-for-is-not-supported {
    CREATE ROLE rv_option;
    CREATE TABLE rv_option_docs (id INT);
    REVOKE GRANT OPTION FOR SELECT ON rv_option_docs FROM rv_option;
}
@sqlstate 0A000
expect error {
    REVOKE GRANT OPTION FOR is not supported
}

test revoke-insert-on-sequence-stores-nothing {
    CREATE SEQUENCE rv_seq_insert;
    REVOKE INSERT ON rv_seq_insert FROM PUBLIC;
    SELECT coalesce(relacl::text, 'null') FROM pg_class WHERE relname = 'rv_seq_insert';
}
expect {
    null
}
