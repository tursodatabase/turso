# GRANT SELECT on tables through the PostgreSQL frontend.
# PostgreSQL roles belong to the whole server, not to one database, so every
# test uses its own role names.

@database :memory:

test grant-select-lets-a-role-read-the-table {
    CREATE ROLE gs_reader;
    CREATE TABLE gs_docs (id INT);
    INSERT INTO gs_docs VALUES (1), (2);
    GRANT SELECT ON gs_docs TO gs_reader;
    SET ROLE gs_reader;
    SELECT id FROM gs_docs ORDER BY id;
}
expect {
    1
    2
}

test grant-select-on-table-keyword {
    CREATE ROLE gs_table_keyword;
    CREATE TABLE gs_keyword (id INT);
    INSERT INTO gs_keyword VALUES (1);
    GRANT SELECT ON TABLE gs_keyword TO gs_table_keyword;
    SET ROLE gs_table_keyword;
    SELECT id FROM gs_keyword;
}
expect {
    1
}

test grant-select-on-table-qualified-with-its-schema {
    CREATE ROLE gs_qualified;
    CREATE TABLE gs_public_docs (id INT);
    INSERT INTO gs_public_docs VALUES (1);
    GRANT SELECT ON public.gs_public_docs TO gs_qualified;
    SET ROLE gs_qualified;
    SELECT id FROM public.gs_public_docs;
}
expect {
    1
}

test grant-select-on-several-tables-to-several-roles {
    CREATE ROLE gs_many_a;
    CREATE ROLE gs_many_b;
    CREATE TABLE gs_many_x (id INT);
    CREATE TABLE gs_many_y (id INT);
    INSERT INTO gs_many_x VALUES (1);
    INSERT INTO gs_many_y VALUES (2);
    GRANT SELECT ON gs_many_x, gs_many_y TO gs_many_a, gs_many_b;
    SET ROLE gs_many_b;
    SELECT x.id, y.id FROM gs_many_x x, gs_many_y y;
}
expect {
    1|2
}

test grant-select-to-public-lets-every-role-read {
    CREATE ROLE gs_public_reader;
    CREATE TABLE gs_for_everyone (id INT);
    INSERT INTO gs_for_everyone VALUES (1);
    GRANT SELECT ON gs_for_everyone TO PUBLIC;
    SET ROLE gs_public_reader;
    SELECT id FROM gs_for_everyone;
}
expect {
    1
}

test grant-select-to-current-user {
    CREATE TABLE gs_current (id INT);
    INSERT INTO gs_current VALUES (1);
    GRANT SELECT ON gs_current TO CURRENT_USER;
    SELECT id FROM gs_current;
}
expect {
    1
}

test grant-select-to-quoted-role-name {
    CREATE ROLE "GsQuoted";
    CREATE TABLE gs_quoted (id INT);
    INSERT INTO gs_quoted VALUES (1);
    GRANT SELECT ON gs_quoted TO "GsQuoted";
    SET ROLE "GsQuoted";
    SELECT id FROM gs_quoted;
}
expect {
    1
}

test grant-select-on-all-tables-in-schema {
    CREATE ROLE gs_all_tables;
    CREATE TABLE gs_all_a (id INT);
    CREATE TABLE gs_all_b (id INT);
    INSERT INTO gs_all_a VALUES (1);
    INSERT INTO gs_all_b VALUES (2);
    GRANT SELECT ON ALL TABLES IN SCHEMA public TO gs_all_tables;
    SET ROLE gs_all_tables;
    SELECT a.id, b.id FROM gs_all_a a, gs_all_b b;
}
expect {
    1|2
}

test grant-select-on-view {
    CREATE ROLE gs_view_reader;
    CREATE TABLE gs_view_base (id INT);
    INSERT INTO gs_view_base VALUES (1), (2);
    CREATE VIEW gs_view AS SELECT id FROM gs_view_base WHERE id > 1;
    GRANT SELECT ON gs_view TO gs_view_reader;
    SET ROLE gs_view_reader;
    SELECT id FROM gs_view;
}
expect {
    2
}

test grant-select-twice {
    CREATE ROLE gs_twice;
    CREATE TABLE gs_twice_docs (id INT);
    INSERT INTO gs_twice_docs VALUES (1);
    GRANT SELECT ON gs_twice_docs TO gs_twice;
    GRANT SELECT ON gs_twice_docs TO gs_twice;
    SET ROLE gs_twice;
    SELECT id FROM gs_twice_docs;
}
expect {
    1
}

test grant-select-in-a-transaction {
    CREATE ROLE gs_in_tx;
    CREATE TABLE gs_tx_docs (id INT);
    INSERT INTO gs_tx_docs VALUES (1);
    BEGIN;
    GRANT SELECT ON gs_tx_docs TO gs_in_tx;
    COMMIT;
    SET ROLE gs_in_tx;
    SELECT id FROM gs_tx_docs;
}
expect {
    1
}

test grant-select-on-missing-table-fails {
    CREATE ROLE gs_missing_table;
    GRANT SELECT ON gs_no_such_table TO gs_missing_table;
}
@sqlstate 42P01
expect error {
    relation "gs_no_such_table" does not exist
}

test grant-select-on-missing-table-in-schema-fails {
    CREATE ROLE gs_missing_qualified;
    GRANT SELECT ON public.gs_no_such_table TO gs_missing_qualified;
}
@sqlstate 42P01
expect error {
    relation "public.gs_no_such_table" does not exist
}

test grant-select-on-table-in-missing-schema-fails {
    CREATE ROLE gs_missing_schema;
    GRANT SELECT ON gs_no_such_schema.t TO gs_missing_schema;
}
@sqlstate 3F000
expect error {
    schema "gs_no_such_schema" does not exist
}

test grant-select-on-all-tables-in-missing-schema-fails {
    CREATE ROLE gs_all_missing_schema;
    GRANT SELECT ON ALL TABLES IN SCHEMA gs_no_such_schema TO gs_all_missing_schema;
}
@sqlstate 3F000
expect error {
    schema "gs_no_such_schema" does not exist
}

test grant-select-to-missing-role-fails {
    CREATE TABLE gs_missing_role_docs (id INT);
    GRANT SELECT ON gs_missing_role_docs TO gs_no_such_role;
}
@sqlstate 42704
expect error {
    role "gs_no_such_role" does not exist
}

test grant-select-checks-the-table-before-the-role {
    GRANT SELECT ON gs_no_such_table TO gs_no_such_role;
}
@sqlstate 42P01
expect error {
    relation "gs_no_such_table" does not exist
}

test grant-select-to-role-named-in-another-case-fails {
    CREATE ROLE "GsCased";
    CREATE TABLE gs_cased (id INT);
    GRANT SELECT ON gs_cased TO GsCased;
}
@sqlstate 42704
expect error {
    role "gscased" does not exist
}

test grant-select-in-a-read-only-transaction-fails {
    CREATE ROLE gs_read_only;
    CREATE TABLE gs_read_only_docs (id INT);
    BEGIN READ ONLY;
    GRANT SELECT ON gs_read_only_docs TO gs_read_only;
}
@sqlstate 25006
expect error {}

test grant-select-on-catalog-tables {
    CREATE ROLE gs_catalog_reader;
    CREATE TABLE gs_catalog_docs (id INT);
    GRANT SELECT ON pg_catalog.pg_class, pg_namespace, pg_catalog.pg_roles TO gs_catalog_reader;
    SET ROLE gs_catalog_reader;
    SELECT relname FROM pg_catalog.pg_class WHERE relname = 'gs_catalog_docs';
}
expect {
    gs_catalog_docs
}

test grant-select-on-information-schema-table {
    CREATE ROLE gs_schemata_reader;
    GRANT SELECT ON information_schema.schemata TO gs_schemata_reader;
    SET ROLE gs_schemata_reader;
    SELECT schema_name FROM information_schema.schemata WHERE schema_name = 'public';
}
expect {
    public
}

test grant-select-on-index-fails {
    CREATE ROLE gs_index_grantee;
    CREATE TABLE gs_indexed (id INT);
    CREATE INDEX gs_indexed_idx ON gs_indexed (id);
    GRANT SELECT ON gs_indexed_idx TO gs_index_grantee;
}
@sqlstate 42809
expect error {
    "gs_indexed_idx" is an index
}

test grant-select-on-table-in-another-database-fails {
    CREATE ROLE gs_cross_database;
    GRANT SELECT ON gs_other_db.public.t TO gs_cross_database;
}
@sqlstate 0A000
expect error {}
