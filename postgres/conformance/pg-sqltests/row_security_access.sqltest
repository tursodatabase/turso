    GRANT SELECT ON ra_notes_39 TO ra_role_39;
    ALTER TABLE ra_docs_39 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_39 TO ra_role_39;
    SELECT count(*) FROM (SELECT id FROM ra_docs_39 UNION ALL SELECT id FROM ra_notes_39) AS u;
    SET ROLE ra_role_39;
    SELECT count(*) FROM (SELECT id FROM ra_docs_39 UNION ALL SELECT id FROM ra_notes_39) AS u;
}
expect {
    6
    3
}

test intersect {
    CREATE ROLE ra_role_40;
    CREATE TABLE ra_docs_40 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_40 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    CREATE TABLE ra_notes_40 (id INT);
    INSERT INTO ra_notes_40 VALUES (1), (2), (4);
    GRANT SELECT ON ra_notes_40 TO ra_role_40;
    ALTER TABLE ra_docs_40 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_40 TO ra_role_40;
    SELECT id FROM ra_notes_40 INTERSECT SELECT id FROM ra_docs_40 ORDER BY id;
    SET ROLE ra_role_40;
    SELECT id FROM ra_notes_40 INTERSECT SELECT id FROM ra_docs_40 ORDER BY id;
}
