}

test window-function {
    CREATE ROLE ra_role_16;
    CREATE TABLE ra_docs_16 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_16 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    ALTER TABLE ra_docs_16 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_16 TO ra_role_16;
    SELECT id, row_number() OVER (ORDER BY id DESC) FROM ra_docs_16 ORDER BY id;
    SET ROLE ra_role_16;
    SELECT id, row_number() OVER (ORDER BY id DESC) FROM ra_docs_16 ORDER BY id;
}
expect {
    1|3
    2|2
    3|1
}

test case-on-exists {
    CREATE ROLE ra_role_17;
    CREATE TABLE ra_docs_17 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_17 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    ALTER TABLE ra_docs_17 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_17 TO ra_role_17;
    SELECT CASE WHEN EXISTS (SELECT 1 FROM ra_docs_17) THEN 'some' ELSE 'none' END;
    SET ROLE ra_role_17;
    SELECT CASE WHEN EXISTS (SELECT 1 FROM ra_docs_17) THEN 'some' ELSE 'none' END;
}
expect {
    some
    none
}

test inner-join {
    CREATE ROLE ra_role_18;
    CREATE TABLE ra_docs_18 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_18 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    CREATE TABLE ra_notes_18 (id INT);
    INSERT INTO ra_notes_18 VALUES (1), (2), (4);
    GRANT SELECT ON ra_notes_18 TO ra_role_18;
    ALTER TABLE ra_docs_18 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_18 TO ra_role_18;
    SELECT n.id FROM ra_notes_18 n JOIN ra_docs_18 d ON d.id = n.id ORDER BY n.id;
    SET ROLE ra_role_18;
    SELECT n.id FROM ra_notes_18 n JOIN ra_docs_18 d ON d.id = n.id ORDER BY n.id;
}
expect {
    1
    2
}

