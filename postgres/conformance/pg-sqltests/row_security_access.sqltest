    1
    2
}

test except {
    CREATE ROLE ra_role_41;
    CREATE TABLE ra_docs_41 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_41 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
