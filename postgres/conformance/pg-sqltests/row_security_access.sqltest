test correlated-scalar-subquery {
    CREATE ROLE ra_role_31;
    CREATE TABLE ra_docs_31 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_31 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    CREATE TABLE ra_notes_31 (id INT);
    INSERT INTO ra_notes_31 VALUES (1), (2), (4);
    GRANT SELECT ON ra_notes_31 TO ra_role_31;
    ALTER TABLE ra_docs_31 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_31 TO ra_role_31;
    SELECT n.id, coalesce((SELECT d.title FROM ra_docs_31 d WHERE d.id = n.id), 'none') FROM ra_notes_31 n ORDER BY n.id;
    SET ROLE ra_role_31;
    SELECT n.id, coalesce((SELECT d.title FROM ra_docs_31 d WHERE d.id = n.id), 'none') FROM ra_notes_31 n ORDER BY n.id;
}
expect {
    1|a
    2|b
    4|none
    1|none
    2|none
    4|none
}

