    CREATE TABLE nx_idx (n numeric, n2 numeric(10,2), id uuid, ts timestamptz); CREATE INDEX nx_idx_n ON nx_idx (n); CREATE INDEX nx_idx_n2 ON nx_idx (n2); CREATE INDEX nx_idx_id ON nx_idx (id); CREATE INDEX nx_idx_ts ON nx_idx (ts); INSERT INTO nx_idx VALUES (1.5, 1.50, 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', '2024-01-01Z'), (2.25, 2.25, 'b0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', '2025-06-01Z'), (10, 10, 'c0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', '2023-01-01Z'), (-3.5, -3.5, 'd0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', '2022-01-01Z'); SELECT count(*) FROM nx_idx WHERE ts = '2025-06-01Z';
}
expect {
    1
}
