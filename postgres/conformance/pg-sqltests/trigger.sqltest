test group-by-and-order-by-read-a-variable-of-the-select-list {
    CREATE TABLE items (id int PRIMARY KEY);
    CREATE TABLE events (id int, day int);
    CREATE TABLE stats (day int, cnt int, last_id int);
    INSERT INTO events VALUES (1, 5), (2, 5), (3, 6);
    CREATE FUNCTION count_events() RETURNS trigger LANGUAGE plpgsql AS $$
    DECLARE
        d int := 5;
    BEGIN
        INSERT INTO stats (day, cnt) SELECT d, count(*) FROM events WHERE day = d GROUP BY d;
        INSERT INTO stats (day, last_id) SELECT d, id FROM events ORDER BY d, id DESC LIMIT 1;
        RETURN NEW;
    END
    $$;
    CREATE TRIGGER items_count AFTER INSERT ON items FOR EACH ROW EXECUTE FUNCTION count_events();
    INSERT INTO items VALUES (1);
    SELECT day, coalesce(cnt, 0), coalesce(last_id, 0) FROM stats ORDER BY 2 DESC;
}
expect {
    5|2|0
    5|0|3
}

test variable-with-the-name-of-a-table-of-the-query-is-ambiguous {
    CREATE TABLE items (id int PRIMARY KEY);
    CREATE TABLE prices (id int, amount int);
    CREATE TABLE log (msg text);
    INSERT INTO prices VALUES (1, 100);
    CREATE FUNCTION log_price() RETURNS trigger LANGUAGE plpgsql AS $$
    DECLARE
        prices int := 5;
    BEGIN
        INSERT INTO log SELECT 'p=' || prices FROM prices WHERE id = 1;
        RETURN NEW;
    END
    $$;
    CREATE TRIGGER items_log AFTER INSERT ON items FOR EACH ROW EXECUTE FUNCTION log_price();
    INSERT INTO items VALUES (1);
}
expect error {
    column reference "prices" is ambiguous
}

test variable-in-limit-that-is-also-a-column-of-the-query-is-ambiguous {
    CREATE TABLE items (id int PRIMARY KEY);
    CREATE TABLE a (id int, n int);
    CREATE TABLE log (msg text);
    INSERT INTO a VALUES (1, 10), (2, 20);
    CREATE FUNCTION log_first() RETURNS trigger LANGUAGE plpgsql AS $$
    DECLARE
        n int := 1;
    BEGIN
        INSERT INTO log SELECT id FROM a ORDER BY id LIMIT n;
        RETURN NEW;
    END
    $$;
    CREATE TRIGGER items_log AFTER INSERT ON items FOR EACH ROW EXECUTE FUNCTION log_first();
    INSERT INTO items VALUES (1);
}
expect error {
    column reference "n" is ambiguous
}

test variable-in-a-recursive-cte-without-a-column-list {
    CREATE TABLE items (id int PRIMARY KEY);
    CREATE TABLE log (msg text);
    CREATE FUNCTION count_up() RETURNS trigger LANGUAGE plpgsql AS $$
    DECLARE
        lim int := 3;
    BEGIN
        INSERT INTO log
        WITH RECURSIVE r AS (SELECT 1 AS k UNION ALL SELECT k + 1 FROM r WHERE k < lim)
        SELECT 'k=' || k FROM r;
        RETURN NEW;
    END
    $$;
    CREATE TRIGGER items_count AFTER INSERT ON items FOR EACH ROW EXECUTE FUNCTION count_up();
    INSERT INTO items VALUES (1);
    SELECT msg FROM log ORDER BY msg;
}
expect {
    k=1
    k=2
    k=3
}

test function-name-is-the-label-of-the-outer-block {
    CREATE TABLE items (id int PRIMARY KEY);
    CREATE TABLE log (msg text);
    CREATE FUNCTION log_op() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        PERFORM 1;
        INSERT INTO log VALUES (log_op.tg_op || ' ' || CASE WHEN log_op.found THEN 'found' ELSE 'not found' END);
        RETURN NEW;
    END
    $$;
    CREATE TRIGGER items_log AFTER INSERT ON items FOR EACH ROW EXECUTE FUNCTION log_op();
    INSERT INTO items VALUES (1);
    SELECT msg FROM log;
}
expect {
    INSERT found
}

test order-by-an-output-column-that-is-also-a-variable {
    CREATE TABLE items (id int PRIMARY KEY, n int);
    CREATE TABLE log (msg text);
    CREATE TABLE trig (id int);
    INSERT INTO items VALUES (1, 30), (2, 20);
    CREATE FUNCTION track() RETURNS trigger LANGUAGE plpgsql AS $$
    DECLARE
        k int := 1;
    BEGIN
        INSERT INTO log SELECT n AS k FROM items ORDER BY k LIMIT k;
        RETURN NEW;
    END
    $$;
    CREATE TRIGGER trig_track AFTER INSERT ON trig FOR EACH ROW EXECUTE FUNCTION track();
    INSERT INTO trig VALUES (1);
    SELECT msg FROM log;
}
expect {
    20
}

test assignment-of-null-to-a-not-null-variable-gives-an-error {
    CREATE TABLE items (id int PRIMARY KEY, n int);
    CREATE FUNCTION track() RETURNS trigger LANGUAGE plpgsql AS $$
    DECLARE
        d int NOT NULL := 1;
    BEGIN
        d := NEW.n;
        RETURN NEW;
    END
    $$;
    CREATE TRIGGER items_track AFTER INSERT ON items FOR EACH ROW EXECUTE FUNCTION track();
    INSERT INTO items VALUES (1, 2);
    INSERT INTO items VALUES (2, NULL);
}
expect error {
    null value cannot be assigned to variable "d" declared NOT NULL
}

test select-into-assigns-the-first-row-or-null {
    CREATE TABLE prices (id int PRIMARY KEY, amount int, label text);
    CREATE TABLE trig (id int);
    CREATE TABLE log (msg text);
    INSERT INTO prices VALUES (1, 10, 'a'), (2, 20, 'b');
    CREATE FUNCTION read_prices() RETURNS trigger LANGUAGE plpgsql AS $$
    DECLARE
        amount_value int := 5;
        label_value text := 'q';
        c int;
        d int;
        e text;
    BEGIN
        SELECT amount, label INTO amount_value, label_value FROM prices WHERE id > 100;
        INSERT INTO log VALUES ('1 ' || coalesce(amount_value::text, 'null') || ' ' || coalesce(label_value, 'null'));
        SELECT amount, label INTO amount_value, label_value FROM prices ORDER BY id DESC;
        INSERT INTO log VALUES ('2 ' || amount_value || ' ' || label_value);
        SELECT 1, 2 INTO c;
        SELECT 3 INTO d, e;
        INSERT INTO log VALUES ('3 ' || c || ' ' || d || ' ' || coalesce(e, 'null'));
        SELECT * INTO c, d, e FROM prices WHERE id = 2;
        INSERT INTO log VALUES ('4 ' || c || ' ' || d || ' ' || e);
        RETURN NEW;
    END
    $$;
    CREATE TRIGGER trig_read AFTER INSERT ON trig FOR EACH ROW EXECUTE FUNCTION read_prices();
    INSERT INTO trig VALUES (1);
    SELECT msg FROM log ORDER BY msg;
}
expect {
    1 null null
    2 20 b
    3 1 3 null
    4 2 20 b
}

test found-is-set-by-select-into-perform-and-writes {
    CREATE TABLE prices (id int PRIMARY KEY, amount int);
    CREATE TABLE trig (id int);
    CREATE TABLE log (msg text);
    INSERT INTO prices VALUES (1, 10), (2, 20);
    CREATE FUNCTION track() RETURNS trigger LANGUAGE plpgsql AS $$
    DECLARE
        v int;
    BEGIN
        INSERT INTO log VALUES ('1 ' || CASE WHEN FOUND THEN 'yes' ELSE 'no' END);
        SELECT amount INTO v FROM prices WHERE id = 1;
        INSERT INTO log VALUES ('2 ' || CASE WHEN FOUND THEN 'yes' ELSE 'no' END);
        UPDATE prices SET amount = amount WHERE id = 100;
        INSERT INTO log VALUES ('3 ' || CASE WHEN FOUND THEN 'yes' ELSE 'no' END);
        PERFORM 1 FROM prices;
        INSERT INTO log VALUES ('4 ' || CASE WHEN FOUND THEN 'yes' ELSE 'no' END);
        PERFORM 1 FROM prices WHERE id > 100;
        INSERT INTO log VALUES ('5 ' || CASE WHEN FOUND THEN 'yes' ELSE 'no' END);
        PERFORM count(*) FROM prices WHERE id > 100;
        INSERT INTO log VALUES ('6 ' || CASE WHEN FOUND THEN 'yes' ELSE 'no' END);
        DELETE FROM prices WHERE id = 100;
        IF NEW.id < 0 THEN
            UPDATE prices SET amount = amount WHERE id = 1;
        END IF;
        INSERT INTO log VALUES ('7 ' || CASE WHEN FOUND THEN 'yes' ELSE 'no' END);
        RETURN NEW;
    END
    $$;
    CREATE TRIGGER trig_track AFTER INSERT ON trig FOR EACH ROW EXECUTE FUNCTION track();
    INSERT INTO trig VALUES (1);
    SELECT msg FROM log ORDER BY msg;
}
expect {
    1 no
    2 yes
    3 no
    4 yes
    5 no
    6 yes
    7 no
}

test update-or-insert-with-found {
    CREATE TABLE events (id int PRIMARY KEY, kind text);
    CREATE TABLE totals (kind text PRIMARY KEY, n int);
    CREATE FUNCTION count_event() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        UPDATE totals SET n = n + 1 WHERE kind = NEW.kind;
        IF NOT FOUND THEN
            INSERT INTO totals VALUES (NEW.kind, 1);
        END IF;
        RETURN NEW;
    END
    $$;
    CREATE TRIGGER events_count AFTER INSERT ON events FOR EACH ROW EXECUTE FUNCTION count_event();
    INSERT INTO events VALUES (1, 'a'), (2, 'b'), (3, 'a');
    SELECT kind, n FROM totals ORDER BY kind;
}
expect {
    a|2
    b|1
}

test select-star-into-from-a-join-with-using-counts-the-join-column-one-time {
    CREATE TABLE items (id int PRIMARY KEY);
    CREATE TABLE a (id int, p int);
    CREATE TABLE b (id int, q int);
    CREATE TABLE log (msg text);
    INSERT INTO a VALUES (1, 10);
    INSERT INTO b VALUES (1, 20);
    CREATE FUNCTION log_join() RETURNS trigger LANGUAGE plpgsql AS $$
    DECLARE
        v1 int;
        v2 int;
        v3 int;
    BEGIN
        SELECT * INTO v1, v2, v3 FROM a JOIN b USING (id);
        INSERT INTO log VALUES ('using ' || v1 || ',' || v2 || ',' || v3);
        SELECT * INTO v1, v2, v3 FROM a NATURAL JOIN b;
        INSERT INTO log VALUES ('natural ' || v1 || ',' || v2 || ',' || v3);
        RETURN NEW;
    END
    $$;
    CREATE TRIGGER items_log AFTER INSERT ON items FOR EACH ROW EXECUTE FUNCTION log_join();
    INSERT INTO items VALUES (1);
    SELECT msg FROM log ORDER BY msg;
}
expect {
    natural 1,10,20
    using 1,10,20
}

test select-into-a-field-of-new {
    CREATE TABLE projects (id int PRIMARY KEY, org text);
    CREATE TABLE tasks (id int PRIMARY KEY, project_id int, org text);
    INSERT INTO projects VALUES (1, 'acme'), (2, 'globex');
    CREATE FUNCTION set_org() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        SELECT org INTO NEW.org FROM projects WHERE id = NEW.project_id;
        RETURN NEW;
    END
    $$;
    CREATE TRIGGER tasks_org BEFORE INSERT ON tasks FOR EACH ROW EXECUTE FUNCTION set_org();
    INSERT INTO tasks VALUES (1, 2, 'x'), (2, 9, 'y');
    SELECT id, coalesce(org, 'null') FROM tasks ORDER BY id;
}
expect {
    1|globex
    2|null
}

test select-into-new-assigns-each-column {
    CREATE TABLE items (code text PRIMARY KEY, a text, b text);
    CREATE FUNCTION fill() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        SELECT NEW.code, upper(NEW.a), 'filled' INTO NEW;
        RETURN NEW;
    END
    $$;
    CREATE TRIGGER items_fill BEFORE INSERT ON items FOR EACH ROW EXECUTE FUNCTION fill();
    INSERT INTO items VALUES ('k', 'low', 'b');
    SELECT code, a, b FROM items;
}
expect {
    k|LOW|filled
}

test select-into-in-a-branch-that-does-not-run-changes-nothing {
    CREATE TABLE prices (id int PRIMARY KEY, amount int);
    CREATE TABLE trig (id int);
    CREATE TABLE log (msg text);
    INSERT INTO prices VALUES (1, 10);
    CREATE FUNCTION track() RETURNS trigger LANGUAGE plpgsql AS $$
    DECLARE
        v int := 7;
    BEGIN
        IF NEW.id > 1 THEN
            SELECT amount INTO v FROM prices WHERE id = 1;
        END IF;
        INSERT INTO log VALUES (NEW.id || ' ' || v);
        RETURN NEW;
    END
    $$;
    CREATE TRIGGER trig_track AFTER INSERT ON trig FOR EACH ROW EXECUTE FUNCTION track();
    INSERT INTO trig VALUES (1), (2);
    SELECT msg FROM log ORDER BY msg;
}
expect {
    1 7
    2 10
}

