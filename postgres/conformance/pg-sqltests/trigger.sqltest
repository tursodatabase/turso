# Triggers with PL/pgSQL trigger functions through the PostgreSQL frontend.

@database :memory:

setup log_table {
    CREATE TABLE t (id int, a text);
    CREATE TABLE log (op text, id int, a text);
}

@setup log_table
test after-insert-trigger-writes-to-another-table {
    CREATE FUNCTION log_row() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        INSERT INTO log VALUES (TG_OP, NEW.id, NEW.a);
        RETURN NULL;
    END
    $$;
    CREATE TRIGGER t_log AFTER INSERT ON t FOR EACH ROW EXECUTE FUNCTION log_row();
    INSERT INTO t VALUES (1, 'one'), (2, 'two');
    SELECT op, id, a FROM log ORDER BY id;
}
expect {
    INSERT|1|one
    INSERT|2|two
}

@setup log_table
test new-is-null-in-delete-and-old-is-null-in-insert {
    CREATE FUNCTION log_row() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        INSERT INTO log VALUES (TG_OP, NEW.id, OLD.a);
        RETURN NULL;
    END
    $$;
    CREATE TRIGGER t_log AFTER INSERT OR DELETE ON t FOR EACH ROW EXECUTE FUNCTION log_row();
    INSERT INTO t VALUES (1, 'one'), (2, 'two');
    DELETE FROM t WHERE id = 1;
    SELECT op, coalesce(id::text, 'null'), coalesce(a, 'null') FROM log ORDER BY op, id;
}
expect {
    DELETE|null|one
    INSERT|1|null
    INSERT|2|null
}

@setup log_table
test after-update-trigger-reads-old-and-new {
    CREATE FUNCTION log_change() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        INSERT INTO log VALUES (OLD.a || ' -> ' || NEW.a, NEW.id, TG_WHEN);
        RETURN NEW;
    END
    $$;
    CREATE TRIGGER t_change AFTER UPDATE ON t FOR EACH ROW EXECUTE FUNCTION log_change();
    INSERT INTO t VALUES (1, 'one'), (2, 'two');
    UPDATE t SET a = upper(a) WHERE id = 2;
    SELECT op, id, a FROM log;
}
expect {
    two -> TWO|2|AFTER
}

@setup log_table
test star-of-a-subquery-reads-the-fields-of-new {
    CREATE FUNCTION log_row() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        INSERT INTO log SELECT * FROM (SELECT TG_OP, NEW.id, NEW.a) AS s;
        RETURN NULL;
    END
    $$;
    CREATE TRIGGER t_log AFTER INSERT ON t FOR EACH ROW EXECUTE FUNCTION log_row();
    INSERT INTO t VALUES (1, 'one');
    SELECT op, id, a FROM log;
}
expect {
    INSERT|1|one
}

@setup log_table
test trigger-function-reads-the-trigger-variables {
    CREATE FUNCTION log_row() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        INSERT INTO log VALUES (TG_NAME || ' ' || TG_TABLE_NAME || ' ' || TG_TABLE_SCHEMA || ' ' || TG_LEVEL, TG_NARGS, TG_ARGV[0] || coalesce(TG_ARGV[1], '') || coalesce(TG_ARGV[2], '-'));
        RETURN NULL;
    END
    $$;
    CREATE TRIGGER t_log AFTER INSERT ON t FOR EACH ROW EXECUTE FUNCTION log_row('a', 'b');
    INSERT INTO t VALUES (1, 'one');
    SELECT op, id, a FROM log;
}
expect {
    t_log t public ROW|2|ab-
}

@skip-if postgres "PostgreSQL has no array_element function"
test array-element-of-tg-argv-without-a-subscript-errors {
    CREATE TABLE items (id int PRIMARY KEY);
    CREATE TABLE log (msg text);
    CREATE FUNCTION log_argument() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        INSERT INTO log VALUES (array_element(TG_ARGV));
        RETURN NULL;
    END
    $$;
    CREATE TRIGGER items_log AFTER INSERT ON items FOR EACH ROW EXECUTE FUNCTION log_argument('a');
    INSERT INTO items VALUES (1);
}
expect error {
    TG_ARGV without a subscript is not supported
}

@setup log_table
test update-of-trigger-fires-only-for-the-listed-columns {
    CREATE FUNCTION log_row() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        INSERT INTO log VALUES (TG_OP, NEW.id, NEW.a);
        RETURN NULL;
    END
    $$;
    CREATE TRIGGER t_log AFTER UPDATE OF a ON t FOR EACH ROW EXECUTE FUNCTION log_row();
    INSERT INTO t VALUES (1, 'one');
    UPDATE t SET id = 2;
    UPDATE t SET a = 'uno';
    SELECT op, id, a FROM log;
}
expect {
    UPDATE|2|uno
}

@setup log_table
test trigger-when-clause-filters-rows {
    CREATE FUNCTION log_row() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        INSERT INTO log VALUES (TG_OP, NEW.id, NEW.a);
        RETURN NULL;
    END
    $$;
    CREATE TRIGGER t_log AFTER UPDATE ON t FOR EACH ROW
        WHEN (OLD.a IS DISTINCT FROM NEW.a) EXECUTE FUNCTION log_row();
    INSERT INTO t VALUES (1, 'one'), (2, 'two');
    UPDATE t SET a = 'uno' WHERE id = 1;
    UPDATE t SET id = 3 WHERE id = 2;
    SELECT op, id, a FROM log;
}
expect {
    UPDATE|1|uno
}

test when-clause-compares-the-whole-old-and-new-rows {
    CREATE TABLE items (id int PRIMARY KEY, a text);
    CREATE TABLE changes (msg text);
    CREATE FUNCTION log_change() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        INSERT INTO changes VALUES (TG_NAME || ' ' || NEW.id);
        RETURN NULL;
    END
    $$;
    INSERT INTO items VALUES (1, 'a'), (2, 'c');
    CREATE TRIGGER star AFTER UPDATE ON items FOR EACH ROW WHEN (OLD.* IS DISTINCT FROM NEW.*) EXECUTE FUNCTION log_change();
    CREATE TRIGGER whole AFTER UPDATE ON items FOR EACH ROW WHEN (OLD IS DISTINCT FROM NEW) EXECUTE FUNCTION log_change();
    UPDATE items SET a = 'a';
    ALTER TABLE items ADD COLUMN b int;
    UPDATE items SET b = 5 WHERE id = 1;
    SELECT msg FROM changes ORDER BY msg;
}
expect {
    star 1
    star 2
    whole 1
    whole 2
}

@skip-if postgres "PostgreSQL reads whole rows in any expression"
test when-clause-with-a-whole-row-outside-a-comparison-errors {
    CREATE TABLE items (id int PRIMARY KEY, a text);
    CREATE FUNCTION do_nothing() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RETURN NULL; END $$;
    CREATE TRIGGER json AFTER UPDATE ON items FOR EACH ROW WHEN (to_jsonb(NEW) IS NOT NULL) EXECUTE FUNCTION do_nothing();
}
expect error {
    a whole row in WHEN is supported only in a comparison of OLD and NEW
}

test before-insert-trigger-reads-the-generated-key {
    CREATE TABLE items (id serial PRIMARY KEY, name text, slug text);
    CREATE FUNCTION make_slug() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        NEW.slug := NEW.name || '-' || NEW.id;
        RETURN NEW;
    END
    $$;
    CREATE TRIGGER items_slug BEFORE INSERT ON items FOR EACH ROW EXECUTE FUNCTION make_slug();
    INSERT INTO items (name) VALUES ('a'), ('b');
    INSERT INTO items (name) VALUES ('c');
    SELECT id, name, slug FROM items ORDER BY id;
}
expect {
    1|a|a-1
    2|b|b-2
    3|c|c-3
}

@setup log_table
test statements-after-return-do-not-run {
    CREATE FUNCTION log_row() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        INSERT INTO log VALUES ('first', NEW.id, NEW.a);
        RETURN NULL;
        INSERT INTO log VALUES ('second', NEW.id, NEW.a);
    END
    $$;
    CREATE TRIGGER t_log AFTER INSERT ON t FOR EACH ROW EXECUTE FUNCTION log_row();
    INSERT INTO t VALUES (1, 'one');
    SELECT op FROM log;
}
expect {
    first
}

@setup log_table
test replaced-function-changes-the-trigger {
    CREATE FUNCTION log_row() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        INSERT INTO log VALUES ('old body', NEW.id, NEW.a);
        RETURN NULL;
    END
    $$;
    CREATE TRIGGER t_log AFTER INSERT ON t FOR EACH ROW EXECUTE FUNCTION log_row();
    INSERT INTO t VALUES (1, 'one');
    CREATE OR REPLACE FUNCTION log_row() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        INSERT INTO log VALUES ('new body', NEW.id, NEW.a);
        RETURN NULL;
    END
    $$;
    INSERT INTO t VALUES (2, 'two');
    SELECT op, id FROM log ORDER BY id;
}
expect {
    old body|1
    new body|2
}

@setup log_table
test triggers-with-the-same-name-on-two-tables {
    CREATE TABLE u (id int, a text);
    CREATE FUNCTION log_row() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        INSERT INTO log VALUES (TG_TABLE_NAME, NEW.id, NEW.a);
        RETURN NULL;
    END
    $$;
    CREATE TRIGGER log_it AFTER INSERT ON t FOR EACH ROW EXECUTE FUNCTION log_row();
    CREATE TRIGGER log_it AFTER INSERT ON u FOR EACH ROW EXECUTE FUNCTION log_row();
    INSERT INTO t VALUES (1, 'one');
    INSERT INTO u VALUES (2, 'two');
    DROP TRIGGER log_it ON t;
    INSERT INTO t VALUES (3, 'three');
    INSERT INTO u VALUES (4, 'four');
    SELECT op, id FROM log ORDER BY id;
}
expect {
    t|1
    u|2
    u|4
}

@setup log_table
test create-or-replace-trigger-replaces-the-trigger {
    CREATE FUNCTION log_row() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        INSERT INTO log VALUES (TG_OP, coalesce(NEW.id, OLD.id), TG_ARGV[0]);
        RETURN NULL;
    END
    $$;
    CREATE TRIGGER t_log AFTER INSERT ON t FOR EACH ROW EXECUTE FUNCTION log_row('first');
    CREATE OR REPLACE TRIGGER t_log AFTER DELETE ON t FOR EACH ROW EXECUTE FUNCTION log_row('second');
    INSERT INTO t VALUES (1, 'one');
    DELETE FROM t;
    SELECT op, id, a FROM log;
}
expect {
    DELETE|1|second
}

@setup log_table
test renamed-table-keeps-its-trigger {
    CREATE FUNCTION log_row() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        INSERT INTO log VALUES (TG_TABLE_NAME, NEW.id, NEW.a);
        RETURN NULL;
    END
    $$;
    CREATE TRIGGER t_log AFTER INSERT ON t FOR EACH ROW EXECUTE FUNCTION log_row();
    ALTER TABLE t RENAME TO renamed;
    INSERT INTO renamed VALUES (1, 'one');
    DROP TRIGGER t_log ON renamed;
    INSERT INTO renamed VALUES (2, 'two');
    SELECT op, id FROM log;
}
expect {
    renamed|1
}

test trigger-name-of-a-renamed-table-can-be-used-again {
    CREATE TABLE t (id int PRIMARY KEY);
    CREATE TABLE log (msg text);
    CREATE FUNCTION log_insert() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        INSERT INTO log VALUES (TG_TABLE_NAME || ' ' || NEW.id);
        RETURN NEW;
    END
    $$;
    CREATE TRIGGER tr AFTER INSERT ON t FOR EACH ROW EXECUTE FUNCTION log_insert();
    ALTER TABLE t RENAME TO t_old;
    CREATE TABLE t (id int PRIMARY KEY);
    CREATE TRIGGER tr AFTER INSERT ON t FOR EACH ROW EXECUTE FUNCTION log_insert();
    INSERT INTO t VALUES (1);
    INSERT INTO t_old VALUES (2);
    SELECT msg FROM log ORDER BY msg;
}
expect {
    t 1
    t_old 2
}

# Schema databases are file-backed, so the tables are dropped before each
# create to keep repeated test runs independent of old sidecar files.
test trigger-on-a-table-in-a-schema-writes-to-public {
    CREATE SCHEMA IF NOT EXISTS trigger_auth;
    DROP TABLE IF EXISTS trigger_auth.users;
    CREATE TABLE trigger_auth.users (id int primary key, raw_user_meta_data jsonb);
    CREATE TABLE public.profiles (id int primary key, full_name text);
    CREATE FUNCTION public.handle_new_user() RETURNS trigger AS $$
    BEGIN
        INSERT INTO public.profiles (id, full_name)
        VALUES (NEW.id, NEW.raw_user_meta_data->>'full_name');
        RETURN NEW;
    END;
    $$ LANGUAGE plpgsql SECURITY DEFINER;
    CREATE TRIGGER on_auth_user_created AFTER INSERT ON trigger_auth.users
        FOR EACH ROW EXECUTE PROCEDURE public.handle_new_user();
    INSERT INTO trigger_auth.users VALUES (7, '{"full_name": "Ann Lee"}');
    SELECT id, full_name FROM profiles;
}
expect {
    7|Ann Lee
}

test trigger-keeps-the-function-that-create-trigger-found {
    CREATE SCHEMA IF NOT EXISTS trigger_function_schema;
    DROP FUNCTION IF EXISTS trigger_function_schema.which_function();
    CREATE TABLE items (id int PRIMARY KEY);
    CREATE TABLE log (msg text);
    CREATE FUNCTION trigger_function_schema.which_function() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        INSERT INTO public.log VALUES ('schema ' || NEW.id);
        RETURN NEW;
    END
    $$;
    CREATE FUNCTION which_function() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        INSERT INTO public.log VALUES ('public ' || NEW.id);
        RETURN NEW;
    END
    $$;
    SET search_path = trigger_function_schema, public;
    CREATE TRIGGER items_which AFTER INSERT ON public.items FOR EACH ROW EXECUTE FUNCTION which_function();
    INSERT INTO public.items VALUES (1);
    SET search_path = public;
    INSERT INTO items VALUES (2);
    SELECT msg FROM log ORDER BY msg;
}
expect {
    schema 1
    schema 2
}

test drop-function-that-a-trigger-calls-errors {
    CREATE TABLE items (id int PRIMARY KEY, n int);
    CREATE FUNCTION set_n() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN NEW.n := 5; RETURN NEW; END $$;
    CREATE TRIGGER items_n BEFORE INSERT ON items FOR EACH ROW EXECUTE FUNCTION set_n();
    DROP FUNCTION set_n();
}
expect error {
    cannot drop function set_n\(\) because other objects depend on it
}

test drop-function-cascade-drops-the-triggers-that-call-it {
    CREATE TABLE items (id int PRIMARY KEY, n int);
    CREATE FUNCTION set_n() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN NEW.n := 5; RETURN NEW; END $$;
    CREATE TRIGGER items_n BEFORE INSERT ON items FOR EACH ROW EXECUTE FUNCTION set_n();
    INSERT INTO items (id) VALUES (1);
    DROP FUNCTION IF EXISTS set_n() CASCADE;
    INSERT INTO items (id) VALUES (2);
    CREATE FUNCTION set_n() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN NEW.n := 7; RETURN NEW; END $$;
    CREATE TRIGGER items_n BEFORE INSERT ON items FOR EACH ROW EXECUTE FUNCTION set_n();
    INSERT INTO items (id) VALUES (3);
    SELECT id, n FROM items ORDER BY id;
}
expect {
    1|5
    2|
    3|7
}

@setup log_table
test create-trigger-twice-errors {
    CREATE FUNCTION log_row() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RETURN NULL; END $$;
    CREATE TRIGGER t_log AFTER INSERT ON t FOR EACH ROW EXECUTE FUNCTION log_row();
    CREATE TRIGGER t_log AFTER INSERT ON t FOR EACH ROW EXECUTE FUNCTION log_row();
}
expect error {
    trigger "t_log" for relation "t" already exists
}

@setup log_table
test create-trigger-with-missing-function-errors {
    CREATE TRIGGER t_log AFTER INSERT ON t FOR EACH ROW EXECUTE FUNCTION missing();
}
expect error {
    function missing\(\) does not exist
}

@setup log_table
test create-trigger-with-function-that-is-not-a-trigger-function-errors {
    CREATE FUNCTION forty_two() RETURNS int LANGUAGE sql AS 'SELECT 42';
    CREATE TRIGGER t_log AFTER INSERT ON t FOR EACH ROW EXECUTE FUNCTION forty_two();
}
expect error {
    function forty_two must return type trigger
}

@setup log_table
test drop-missing-trigger-errors {
    DROP TRIGGER missing ON t;
}
expect error {
    trigger "missing" for table "t" does not exist
}

@setup log_table
test drop-trigger-if-exists-ignores-a-missing-trigger {
    DROP TRIGGER IF EXISTS missing ON t;
    SELECT 1;
}
expect {
    1
}

@setup log_table
test select-without-into-in-a-trigger-function-errors {
    CREATE FUNCTION bad() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        SELECT 1;
        RETURN NULL;
    END
    $$;
    CREATE TRIGGER t_bad AFTER INSERT ON t FOR EACH ROW EXECUTE FUNCTION bad();
    INSERT INTO t VALUES (1, 'one');
}
expect error {
    query has no destination for result data
}

@skip-if postgres "PostgreSQL supports statement-level triggers"
@setup log_table
test statement-level-trigger-errors {
    CREATE FUNCTION log_row() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RETURN NULL; END $$;
    CREATE TRIGGER t_log AFTER INSERT ON t FOR EACH STATEMENT EXECUTE FUNCTION log_row();
}
expect error {
    statement-level triggers are not supported
}

@skip-if postgres "PostgreSQL supports loops in trigger functions"
@setup log_table
test loop-in-a-trigger-function-errors-when-the-trigger-fires {
    CREATE FUNCTION loops() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        LOOP
            EXIT;
        END LOOP;
        RETURN NULL;
    END
    $$;
    CREATE TRIGGER t_loops AFTER INSERT ON t FOR EACH ROW EXECUTE FUNCTION loops();
    INSERT INTO t VALUES (1, 'one');
}
expect error {
    LOOP is not supported yet \(PL/pgSQL function loops\(\) line 3 at LOOP\)
}

@setup log_table
test dropped-trigger-can-be-created-again {
    CREATE FUNCTION log_row() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RETURN NULL; END $$;
    CREATE TRIGGER t_log AFTER INSERT OR UPDATE ON t FOR EACH ROW EXECUTE FUNCTION log_row();
    DROP TRIGGER t_log ON t;
    CREATE TRIGGER t_log AFTER INSERT ON t FOR EACH ROW EXECUTE FUNCTION log_row();
    SELECT 1;
}
expect {
    1
}

@setup log_table
test before-insert-trigger-changes-the-new-row {
    CREATE FUNCTION upper_a() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        NEW.a := upper(NEW.a);
        RETURN NEW;
    END
    $$;
    CREATE TRIGGER t_upper BEFORE INSERT ON t FOR EACH ROW EXECUTE FUNCTION upper_a();
    INSERT INTO t VALUES (1, 'one'), (2, 'two');
    SELECT id, a FROM t ORDER BY id;
}
expect {
    1|ONE
    2|TWO
}

test before-update-trigger-changes-a-column-that-update-does-not-set {
    CREATE TABLE items (id int PRIMARY KEY, name text, changed timestamp);
    CREATE INDEX items_changed ON items (changed);
    CREATE FUNCTION set_changed() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        NEW.changed := '2024-05-06 07:08:09';
        RETURN NEW;
    END
    $$;
    CREATE TRIGGER items_changed BEFORE UPDATE ON items FOR EACH ROW EXECUTE FUNCTION set_changed();
    INSERT INTO items VALUES (1, 'a', '2000-01-01 00:00:00'), (2, 'b', '2000-01-01 00:00:00');
    UPDATE items SET name = 'c' WHERE id = 1;
    SELECT id, name, changed FROM items ORDER BY id;
    SELECT id FROM items WHERE changed = '2024-05-06 07:08:09';
}
expect {
    1|c|2024-05-06 07:08:09
    2|b|2000-01-01 00:00:00
    1
}

test set-updated-at-trigger-sets-the-time-of-the-update {
    CREATE TABLE items (id int PRIMARY KEY, name text, updated_at timestamptz NOT NULL DEFAULT now());
    create or replace function public.set_updated_at()
    returns trigger
    language plpgsql
    as $$
    begin
        new.updated_at = now();
        return new;
    end;
    $$;
    create trigger set_items_updated_at before update on items for each row execute function public.set_updated_at();
    INSERT INTO items (id, name, updated_at) VALUES (1, 'a', '2000-01-01 00:00:00');
    UPDATE items SET name = 'b';
    SELECT name, CASE WHEN updated_at > '2020-01-01' THEN 'updated' ELSE 'old' END FROM items;
}
expect {
    b|updated
}

test handle-times-trigger-sets-the-times-of-insert-and-update {
    CREATE TABLE todos (id serial PRIMARY KEY, text text, created_at timestamptz, updated_at timestamptz);
    CREATE OR REPLACE FUNCTION handle_times()
        RETURNS trigger AS
        $$
        BEGIN
        IF (TG_OP = 'INSERT') THEN
            NEW.created_at := now();
            NEW.updated_at := now();
        ELSEIF (TG_OP = 'UPDATE') THEN
            NEW.created_at = OLD.created_at;
            NEW.updated_at = now();
        END IF;
        RETURN NEW;
        END;
        $$ language plpgsql;
    CREATE TRIGGER handle_times
        BEFORE INSERT OR UPDATE ON todos
        FOR EACH ROW
    EXECUTE PROCEDURE handle_times();
    INSERT INTO todos (text, created_at, updated_at) VALUES ('a', '2000-01-01 00:00:00', '2000-01-01 00:00:00');
    SELECT CASE WHEN created_at = updated_at THEN 'same time' ELSE 'different times' END FROM todos;
    UPDATE todos SET created_at = '2001-01-01 00:00:00', updated_at = '2001-01-01 00:00:00';
    SELECT text,
        CASE WHEN created_at > '2020-01-01' THEN 'insert time' ELSE 'old' END,
        CASE WHEN updated_at >= created_at THEN 'update time' ELSE 'old' END
    FROM todos;
}
expect {
    same time
    a|insert time|update time
}

@setup log_table
test assignments-read-the-earlier-assignments {
    CREATE FUNCTION append() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        NEW.a := NEW.a || '1';
        NEW.a := NEW.a || '2';
        INSERT INTO log VALUES (TG_OP, NEW.id, NEW.a);
        RETURN NEW;
    END
    $$;
    CREATE TRIGGER t_append BEFORE INSERT ON t FOR EACH ROW EXECUTE FUNCTION append();
    INSERT INTO t VALUES (1, 'x');
    SELECT id, a FROM t;
    SELECT op, id, a FROM log;
}
expect {
    1|x12
    INSERT|1|x12
}

@setup log_table
test return-null-in-a-before-trigger-skips-the-row {
    CREATE FUNCTION skip_row() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RETURN NULL; END $$;
    INSERT INTO t VALUES (1, 'one');
    CREATE TRIGGER t_skip BEFORE INSERT OR UPDATE OR DELETE ON t FOR EACH ROW EXECUTE FUNCTION skip_row();
    INSERT INTO t VALUES (2, 'two');
    UPDATE t SET a = 'changed';
    DELETE FROM t;
    SELECT id, a FROM t;
}
expect {
    1|one
}

@setup log_table
test return-new-in-a-before-delete-trigger-skips-the-delete {
    CREATE FUNCTION keep_row() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RETURN NEW; END $$;
    INSERT INTO t VALUES (1, 'one');
    CREATE TRIGGER t_keep BEFORE DELETE ON t FOR EACH ROW EXECUTE FUNCTION keep_row();
    DELETE FROM t;
    SELECT id, a FROM t;
}
expect {
    1|one
}

@setup log_table
test return-old-in-a-before-update-trigger-keeps-the-old-row {
    CREATE FUNCTION keep_old() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        NEW.a := 'ignored';
        RETURN OLD;
    END
    $$;
    INSERT INTO t VALUES (1, 'one');
    CREATE TRIGGER t_old BEFORE INSERT OR UPDATE ON t FOR EACH ROW EXECUTE FUNCTION keep_old();
    UPDATE t SET a = 'two';
    INSERT INTO t VALUES (2, 'two');
    SELECT id, a FROM t;
}
expect {
    1|one
}

@setup log_table
test return-coalesce-of-new-and-old-returns-the-row-of-the-event {
    CREATE FUNCTION mark() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        NEW.a := 'marked';
        RETURN COALESCE(NEW, OLD);
    END
    $$;
    CREATE TRIGGER t_mark BEFORE INSERT OR UPDATE OR DELETE ON t FOR EACH ROW EXECUTE FUNCTION mark();
    INSERT INTO t VALUES (1, 'one'), (2, 'two');
    UPDATE t SET a = 'changed' WHERE id = 2;
    DELETE FROM t WHERE id = 1;
    SELECT id, a FROM t;
}
expect {
    2|marked
}

@setup log_table
test update-of-trigger-does-not-fire-for-a-column-that-a-before-trigger-changes {
    CREATE FUNCTION set_a() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        NEW.a := 'set by trigger';
        RETURN NEW;
    END
    $$;
    CREATE FUNCTION log_row() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        INSERT INTO log VALUES (TG_OP, NEW.id, NEW.a);
        RETURN NULL;
    END
    $$;
    INSERT INTO t VALUES (1, 'one');
    CREATE TRIGGER t_set_a BEFORE UPDATE ON t FOR EACH ROW EXECUTE FUNCTION set_a();
    CREATE TRIGGER t_log_a AFTER UPDATE OF a ON t FOR EACH ROW EXECUTE FUNCTION log_row();
    UPDATE t SET id = 2;
    SELECT id, a FROM t;
    SELECT count(*) FROM log;
}
expect {
    2|set by trigger
    0
}

@setup log_table
test assignment-to-a-missing-field-errors-when-the-trigger-fires {
    CREATE FUNCTION bad_field() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        NEW.nope := 1;
        RETURN NEW;
    END
    $$;
    CREATE TRIGGER t_bad BEFORE INSERT ON t FOR EACH ROW EXECUTE FUNCTION bad_field();
    INSERT INTO t VALUES (1, 'one');
}
expect error {
    record "new" has no field "nope"
}

@setup log_table
test trigger-function-without-return-errors-when-it-ends {
    CREATE FUNCTION no_return() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        INSERT INTO log VALUES (TG_OP, NEW.id, NEW.a);
    END
    $$;
    CREATE TRIGGER t_no_return AFTER INSERT ON t FOR EACH ROW EXECUTE FUNCTION no_return();
    INSERT INTO t VALUES (1, 'one');
}
expect error {
    control reached end of trigger procedure without RETURN
}

@skip-if postgres "PostgreSQL lets a BEFORE trigger change the primary key"
test before-trigger-that-changes-an-integer-primary-key-errors {
    CREATE TABLE keyed (id int PRIMARY KEY, a text);
    CREATE FUNCTION move_row() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        NEW.id := NEW.id + 100;
        RETURN NEW;
    END
    $$;
    CREATE TRIGGER keyed_move BEFORE INSERT ON keyed FOR EACH ROW EXECUTE FUNCTION move_row();
    INSERT INTO keyed VALUES (1, 'one');
}
expect error {
    a BEFORE trigger cannot change the INTEGER PRIMARY KEY column "id" yet \(PL/pgSQL function move_row\(\) line 4 at RETURN\)
}

@setup log_table
test before-triggers-fire-in-name-order-and-each-sees-the-row-of-the-one-before {
    CREATE FUNCTION append_one() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        NEW.a := NEW.a || '1';
        RETURN NEW;
    END
    $$;
    CREATE FUNCTION append_two() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        NEW.a := NEW.a || '2';
        RETURN NEW;
    END
    $$;
    CREATE TRIGGER a_first BEFORE INSERT ON t FOR EACH ROW EXECUTE FUNCTION append_one();
    CREATE TRIGGER b_second BEFORE INSERT ON t FOR EACH ROW EXECUTE FUNCTION append_two();
    INSERT INTO t VALUES (1, 'x');
    SELECT a FROM t;
}
expect {
    x12
}

test after-triggers-fire-in-name-order {
    CREATE TABLE t (id int);
    CREATE TABLE fired (n serial, name text);
    CREATE FUNCTION log_name() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        INSERT INTO fired (name) VALUES (TG_NAME);
        RETURN NULL;
    END
    $$;
    CREATE TRIGGER a_first AFTER INSERT ON t FOR EACH ROW EXECUTE FUNCTION log_name();
    CREATE TRIGGER b_second AFTER INSERT ON t FOR EACH ROW EXECUTE FUNCTION log_name();
    INSERT INTO t VALUES (1);
    SELECT name FROM fired ORDER BY n;
}
expect {
    a_first
    b_second
}

test set-updated-at-trigger-fires-for-the-update-of-an-upsert {
    CREATE TABLE items (id int PRIMARY KEY, name text, updated_at timestamptz NOT NULL DEFAULT now());
    CREATE FUNCTION set_updated_at() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        NEW.updated_at := now();
        RETURN NEW;
    END
    $$;
    CREATE TRIGGER items_updated_at BEFORE UPDATE ON items FOR EACH ROW EXECUTE FUNCTION set_updated_at();
    INSERT INTO items (id, name, updated_at) VALUES (1, 'a', '2000-01-01 00:00:00');
    INSERT INTO items (id, name) VALUES (1, 'b') ON CONFLICT (id) DO UPDATE SET name = excluded.name;
    SELECT name, CASE WHEN updated_at > '2020-01-01' THEN 'updated' ELSE 'old' END FROM items;
}
expect {
    b|updated
}

@skip-if postgres "the variables of compiled triggers exist only in tursopg"
test trigger-variables-keep-typed-values-in-the-session {
    SELECT __pl_set('a key', 42);
    SELECT __pl_get('a key') + 1;
    SELECT coalesce(__pl_get('a missing key'), 'missing');
}
expect {
    42
    43
    missing
}
