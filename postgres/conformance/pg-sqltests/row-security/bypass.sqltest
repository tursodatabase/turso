# Which roles row-level security does not apply to, through the PostgreSQL
# frontend: superusers and the owner of the table. A view reads its tables as
# the view's owner, so a view shows its readers the rows its owner sees.
# PostgreSQL roles belong to the whole server, so every test uses its own
# role and table names.

@database :memory:

test reset-role-reads-every-row-again {
    CREATE ROLE ra_role_42;
    CREATE TABLE ra_docs_42 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_42 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    ALTER TABLE ra_docs_42 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_42 TO ra_role_42;
    SET ROLE ra_role_42;
    SELECT count(*) FROM ra_docs_42;
    RESET ROLE;
    SELECT count(*) FROM ra_docs_42;
}
expect {
    0
    3
}

test set-role-none-reads-every-row-again {
    CREATE ROLE ra_role_43;
    CREATE TABLE ra_docs_43 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_43 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    ALTER TABLE ra_docs_43 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_43 TO ra_role_43;
    SET ROLE ra_role_43;
    SELECT count(*) FROM ra_docs_43;
    SET ROLE NONE;
    SELECT count(*) FROM ra_docs_43;
}
expect {
    0
    3
}

test set-role-to-the-superuser-reads-every-row {
    CREATE ROLE ra_role_44;
    CREATE TABLE ra_docs_44 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_44 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    ALTER TABLE ra_docs_44 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_44 TO ra_role_44;
    SET ROLE postgres;
    SELECT count(*) FROM ra_docs_44;
}
expect {
    3
}

test set-local-role-ends-with-the-transaction {
    CREATE ROLE ra_role_45;
    CREATE TABLE ra_docs_45 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_45 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    ALTER TABLE ra_docs_45 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_45 TO ra_role_45;
    BEGIN;
    SET LOCAL ROLE ra_role_45;
    SELECT count(*) FROM ra_docs_45;
    COMMIT;
    SELECT count(*) FROM ra_docs_45;
}
expect {
    0
    3
}

test superuser-inserts-updates-and-deletes-rows {
    CREATE ROLE ra_role_52;
    CREATE TABLE ra_docs_52 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_52 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    ALTER TABLE ra_docs_52 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_52 TO ra_role_52;
    INSERT INTO ra_docs_52 VALUES (5, 'erin', 'e');
    UPDATE ra_docs_52 SET title = 'z' WHERE id = 1;
    DELETE FROM ra_docs_52 WHERE id = 2;
    SELECT id, title FROM ra_docs_52 ORDER BY id;
}
expect {
    1|z
    3|c
    5|e
}

test superuser-inserts-rows-selected-from-table-with-row-security {
    CREATE ROLE ra_role_53;
    CREATE TABLE ra_docs_53 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_53 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    CREATE TABLE ra_notes_53 (id INT);
    INSERT INTO ra_notes_53 VALUES (1), (2), (4);
    GRANT SELECT ON ra_notes_53 TO ra_role_53;
    ALTER TABLE ra_docs_53 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_53 TO ra_role_53;
    INSERT INTO ra_notes_53 SELECT id + 10 FROM ra_docs_53;
    SELECT id FROM ra_notes_53 ORDER BY id;
}
expect {
    1
    2
    4
    11
    12
    13
}

test superuser-updates-from-table-with-row-security {
    CREATE ROLE ra_role_54;
    CREATE TABLE ra_docs_54 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_54 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    CREATE TABLE ra_notes_54 (id INT);
    INSERT INTO ra_notes_54 VALUES (1), (2), (4);
    GRANT SELECT ON ra_notes_54 TO ra_role_54;
    ALTER TABLE ra_docs_54 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_54 TO ra_role_54;
    UPDATE ra_notes_54 SET id = d.id * 10 FROM ra_docs_54 d WHERE d.id = ra_notes_54.id;
    SELECT id FROM ra_notes_54 ORDER BY id;
}
expect {
    4
    10
    20
}

test superuser-deletes-with-subquery-on-table-with-row-security {
    CREATE ROLE ra_role_55;
    CREATE TABLE ra_docs_55 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_55 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    CREATE TABLE ra_notes_55 (id INT);
    INSERT INTO ra_notes_55 VALUES (1), (2), (4);
    GRANT SELECT ON ra_notes_55 TO ra_role_55;
    ALTER TABLE ra_docs_55 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_55 TO ra_role_55;
    DELETE FROM ra_notes_55 WHERE id IN (SELECT id FROM ra_docs_55);
    SELECT id FROM ra_notes_55;
}
expect {
    4
}

# The owner of a table bypasses its row-level security, as in PostgreSQL,
# unless FORCE ROW LEVEL SECURITY is set, which is not supported.
test owner-reads-every-row {
    CREATE ROLE ra_owner_59;
    CREATE TABLE ra_docs_59 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_59 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    ALTER TABLE ra_docs_59 OWNER TO ra_owner_59;
    SET ROLE ra_owner_59;
    ALTER TABLE ra_docs_59 ENABLE ROW LEVEL SECURITY;
    SELECT count(*) FROM ra_docs_59;
}
expect {
    3
}

test former-owner-reads-no-rows {
    CREATE ROLE ra_owner_60;
    CREATE ROLE ra_role_60;
    CREATE TABLE ra_docs_60 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_60 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    ALTER TABLE ra_docs_60 ENABLE ROW LEVEL SECURITY;
    ALTER TABLE ra_docs_60 OWNER TO ra_owner_60;
    GRANT SELECT ON ra_docs_60 TO ra_role_60;
    SET ROLE ra_owner_60;
    SELECT count(*) FROM ra_docs_60;
    RESET ROLE;
    ALTER TABLE ra_docs_60 OWNER TO ra_role_60;
    GRANT SELECT ON ra_docs_60 TO ra_owner_60;
    SET ROLE ra_owner_60;
    SELECT count(*) FROM ra_docs_60;
}
expect {
    3
    0
}

test view-owned-by-superuser-shows-every-row {
    CREATE ROLE ra_role_61;
    CREATE TABLE ra_docs_61 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_61 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    ALTER TABLE ra_docs_61 ENABLE ROW LEVEL SECURITY;
    CREATE VIEW ra_view_61 AS SELECT id FROM ra_docs_61;
    GRANT SELECT ON ra_view_61 TO ra_role_61;
    GRANT SELECT ON ra_docs_61 TO ra_role_61;
    SET ROLE ra_role_61;
    SELECT count(*) FROM ra_view_61;
    SELECT count(*) FROM ra_docs_61;
}
expect {
    3
    0
}

test view-owned-by-role-shows-no-rows {
    CREATE ROLE ra_view_owner_62;
    CREATE ROLE ra_role_62;
    CREATE TABLE ra_docs_62 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_62 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    ALTER TABLE ra_docs_62 ENABLE ROW LEVEL SECURITY;
    CREATE VIEW ra_view_62 AS SELECT id FROM ra_docs_62;
    ALTER VIEW ra_view_62 OWNER TO ra_view_owner_62;
    GRANT SELECT ON ra_docs_62 TO ra_view_owner_62;
    GRANT SELECT ON ra_view_62 TO ra_role_62;
    SET ROLE ra_role_62;
    SELECT count(*) FROM ra_view_62;
}
expect {
    0
}
