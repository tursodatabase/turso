test left-join-shows-hidden-rows-as-nulls {
    CREATE ROLE ra_role_20;
    CREATE TABLE ra_docs_20 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_20 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    CREATE TABLE ra_notes_20 (id INT);
    INSERT INTO ra_notes_20 VALUES (1), (2), (4);
    GRANT SELECT ON ra_notes_20 TO ra_role_20;
    ALTER TABLE ra_docs_20 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_20 TO ra_role_20;
    SELECT n.id, coalesce(d.title, 'none') FROM ra_notes_20 n LEFT JOIN ra_docs_20 d ON d.id = n.id ORDER BY n.id;
    SET ROLE ra_role_20;
    SELECT n.id, coalesce(d.title, 'none') FROM ra_notes_20 n LEFT JOIN ra_docs_20 d ON d.id = n.id ORDER BY n.id;
}
expect {
    1|a
    2|b
    4|none
    1|none
    2|none
    4|none
}

test left-join-from-table-with-row-security {
    CREATE ROLE ra_role_21;
    CREATE TABLE ra_docs_21 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_21 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    CREATE TABLE ra_notes_21 (id INT);
    INSERT INTO ra_notes_21 VALUES (1), (2), (4);
    GRANT SELECT ON ra_notes_21 TO ra_role_21;
    ALTER TABLE ra_docs_21 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_21 TO ra_role_21;
    SELECT d.id, coalesce(n.id, -1) FROM ra_docs_21 d LEFT JOIN ra_notes_21 n ON n.id = d.id ORDER BY d.id;
    SET ROLE ra_role_21;
    SELECT d.id, coalesce(n.id, -1) FROM ra_docs_21 d LEFT JOIN ra_notes_21 n ON n.id = d.id ORDER BY d.id;
}
expect {
    1|1
    2|2
    3|-1
}

test left-join-anti-join {
    CREATE ROLE ra_role_22;
    CREATE TABLE ra_docs_22 (id INT PRIMARY KEY, owner TEXT, title TEXT);
