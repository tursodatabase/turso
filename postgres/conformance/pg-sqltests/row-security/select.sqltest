test every-role-reads-no-rows {
    CREATE ROLE ra_role_46;
    CREATE TABLE ra_docs_46 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_46 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    ALTER TABLE ra_docs_46 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_46 TO ra_role_46;
    CREATE ROLE ra_other_46;
    GRANT SELECT ON ra_docs_46 TO ra_other_46;
    SET ROLE ra_role_46;
    SELECT count(*) FROM ra_docs_46;
    RESET ROLE;
    SET ROLE ra_other_46;
    SELECT count(*) FROM ra_docs_46;
}
expect {
    0
    0
}

