# Which rows a role reads from a table with row-level security, through the
# PostgreSQL frontend, in every shape of query. A role that is not a superuser
# reads no row of a table without policies, as in PostgreSQL, and only the
# rows the policies allow of a table with policies.
#
# Many tests first read as the superuser, then as a role, so the expected
# output shows both. The role is granted SELECT, because without it
# PostgreSQL refuses to read the table at all. PostgreSQL roles belong to the
# whole server, so every test uses its own role and table names.

@database :memory:

test count-of-all-rows {
    CREATE ROLE ra_role_1;
    CREATE TABLE ra_docs_1 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_1 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    ALTER TABLE ra_docs_1 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_1 TO ra_role_1;
    SELECT count(*) FROM ra_docs_1;
    SET ROLE ra_role_1;
    SELECT count(*) FROM ra_docs_1;
}
expect {
    3
    0
}

test select-star {
    CREATE ROLE ra_role_2;
    CREATE TABLE ra_docs_2 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_2 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    ALTER TABLE ra_docs_2 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_2 TO ra_role_2;
    SELECT * FROM ra_docs_2 ORDER BY id;
    SET ROLE ra_role_2;
    SELECT * FROM ra_docs_2 ORDER BY id;
}
expect {
    1|alice|a
    2|bob|b
    3|alice|c
}

test primary-key-lookup {
    CREATE ROLE ra_role_3;
    CREATE TABLE ra_docs_3 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_3 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    ALTER TABLE ra_docs_3 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_3 TO ra_role_3;
    SELECT title FROM ra_docs_3 WHERE id = 2;
    SET ROLE ra_role_3;
    SELECT title FROM ra_docs_3 WHERE id = 2;
}
expect {
    b
}

