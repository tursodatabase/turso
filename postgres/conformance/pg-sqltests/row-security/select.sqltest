    CREATE TABLE "RaDocs47" (id INT);
    INSERT INTO "RaDocs47" VALUES (1), (2);
    ALTER TABLE "RaDocs47" ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON "RaDocs47" TO ra_role_47;
    SELECT count(*) FROM "RaDocs47";
    SET ROLE ra_role_47;
    SELECT count(*) FROM "RaDocs47";
}
expect {
    2
    0
}

test policy-keeps-hidden-rows-from-left-join {
    CREATE ROLE rp_alice_8;
    CREATE TABLE rp_users_8 (id INT PRIMARY KEY);
    CREATE TABLE rp_docs_8 (id INT PRIMARY KEY, user_id INT, owner TEXT);
    INSERT INTO rp_users_8 VALUES (1), (2);
    INSERT INTO rp_docs_8 VALUES (10, 1, 'rp_alice_8'), (20, 2, 'someone else');
    ALTER TABLE rp_docs_8 ENABLE ROW LEVEL SECURITY;
    CREATE POLICY own ON rp_docs_8 USING (owner = current_user);
    GRANT SELECT ON rp_users_8, rp_docs_8 TO rp_alice_8;
    SET ROLE rp_alice_8;
    SELECT u.id, d.id FROM rp_users_8 u LEFT JOIN rp_docs_8 d ON d.user_id = u.id ORDER BY u.id;
}
expect {
    1|10
    2|
}

test policy-applies-in-subqueries-and-joins {
    CREATE ROLE rp_alice_9;
    CREATE TABLE rp_users_9 (id INT PRIMARY KEY);
    CREATE TABLE rp_docs_9 (id INT PRIMARY KEY, user_id INT, owner TEXT);
    INSERT INTO rp_users_9 VALUES (1), (2), (3);
    INSERT INTO rp_docs_9 VALUES (10, 1, 'rp_alice_9'), (20, 2, 'someone else');
    ALTER TABLE rp_docs_9 ENABLE ROW LEVEL SECURITY;
    CREATE POLICY own ON rp_docs_9 USING (owner = current_user);
    GRANT SELECT ON rp_users_9, rp_docs_9 TO rp_alice_9;
    SET ROLE rp_alice_9;
    SELECT u.id FROM rp_users_9 u JOIN rp_docs_9 d ON d.user_id = u.id ORDER BY u.id;
    SELECT id FROM rp_users_9 WHERE id IN (SELECT user_id FROM rp_docs_9) ORDER BY id;
    SELECT id FROM rp_users_9 u WHERE NOT EXISTS (SELECT 1 FROM rp_docs_9 d WHERE d.user_id = u.id) ORDER BY id;
    SELECT (SELECT count(*) FROM rp_docs_9);
}
expect {
    1
    1
    2
    3
    1
}

# The filter of the policies is checked before the conditions of the query,
# so a condition that fails on a hidden row never sees it.
test query-conditions-do-not-see-hidden-rows {
    CREATE ROLE rp_alice_10;
    CREATE TABLE rp_docs_10 (id INT PRIMARY KEY, owner TEXT, status TEXT, n INT);
    INSERT INTO rp_docs_10 VALUES (1, 'rp_alice_10', 'published', 1), (2, 'someone else', 'published', 0);
    ALTER TABLE rp_docs_10 ENABLE ROW LEVEL SECURITY;
    CREATE POLICY own ON rp_docs_10 USING (owner = current_user);
    CREATE POLICY own_published ON rp_docs_10 USING (owner = current_user AND status = 'published');
    GRANT SELECT ON rp_docs_10 TO rp_alice_10;
    SET ROLE rp_alice_10;
    SELECT id FROM rp_docs_10 WHERE 1 / n = 1;
}
expect {
    1
}

test join-keys-do-not-see-hidden-rows {
    CREATE ROLE rp_alice_11;
    CREATE TABLE rp_items_11 (x INT);
    CREATE TABLE rp_docs_11 (id INT PRIMARY KEY, owner TEXT, k INT);
    INSERT INTO rp_items_11 VALUES (5), (7);
    INSERT INTO rp_docs_11 VALUES (1, 'rp_alice_11', 2), (2, 'someone else', 0);
    ALTER TABLE rp_docs_11 ENABLE ROW LEVEL SECURITY;
    CREATE POLICY own ON rp_docs_11 USING (owner = 'rp_alice_11');
    GRANT SELECT ON rp_items_11, rp_docs_11 TO rp_alice_11;
    SET ROLE rp_alice_11;
    SELECT x FROM rp_items_11 i WHERE NOT EXISTS (SELECT 1 FROM rp_docs_11 d WHERE i.x = 10 / d.k) ORDER BY x;
    SELECT i.x FROM rp_items_11 i JOIN rp_docs_11 d ON i.x = 10 / d.k;
}
expect {
    7
    5
}

test or-over-two-indexes-does-not-see-hidden-rows {
    CREATE ROLE rp_alice_32;
    CREATE TABLE rp_docs_32 (id INT PRIMARY KEY, owner TEXT, k INT, j INT, n INT);
    CREATE INDEX rp_docs_32_k ON rp_docs_32 (k);
    CREATE INDEX rp_docs_32_j ON rp_docs_32 (j);
    INSERT INTO rp_docs_32 SELECT g, 'someone else', g, g, 1 FROM generate_series(10, 2000) g;
    INSERT INTO rp_docs_32 VALUES (1, 'rp_alice_32', 1, 1, 1), (2, 'someone else', 2, 2, 0);
    ALTER TABLE rp_docs_32 ENABLE ROW LEVEL SECURITY;
    CREATE POLICY own ON rp_docs_32 USING (owner = 'rp_alice_32');
    GRANT SELECT ON rp_docs_32 TO rp_alice_32;
    SET ROLE rp_alice_32;
    SELECT id FROM rp_docs_32 WHERE k = 1 OR (j = 2 AND 1 / n = 1);
    SELECT (SELECT count(*) FROM rp_docs_32 WHERE k = 1 OR (j = 2 AND 1 / n = 1));
}
expect {
    1
    1
}

test right-join-to-table-with-policy-keeps-only-visible-rows {
    CREATE ROLE rp_alice_35;
    CREATE TABLE rp_docs_35 (id INT PRIMARY KEY, owner TEXT);
    INSERT INTO rp_docs_35 VALUES (1, 'rp_alice_35'), (2, 'bob'), (3, 'rp_alice_35');
    CREATE TABLE rp_notes_35 (id INT);
    INSERT INTO rp_notes_35 VALUES (1), (2), (4);
    ALTER TABLE rp_docs_35 ENABLE ROW LEVEL SECURITY;
    CREATE POLICY own ON rp_docs_35 USING (owner = current_user);
    GRANT SELECT ON rp_docs_35, rp_notes_35 TO rp_alice_35;
    SET ROLE rp_alice_35;
    SELECT coalesce(n.id, -1), d.id FROM rp_notes_35 n RIGHT JOIN rp_docs_35 d ON n.id = d.id ORDER BY d.id;
}
expect {
    1|1
    -1|3
}

test right-join-from-table-with-policy-keeps-every-right-row {
    CREATE ROLE rp_alice_36;
    CREATE TABLE rp_docs_36 (id INT PRIMARY KEY, owner TEXT);
    INSERT INTO rp_docs_36 VALUES (1, 'rp_alice_36'), (2, 'bob'), (3, 'rp_alice_36');
    CREATE TABLE rp_notes_36 (id INT);
    INSERT INTO rp_notes_36 VALUES (1), (2), (4);
    ALTER TABLE rp_docs_36 ENABLE ROW LEVEL SECURITY;
    CREATE POLICY own ON rp_docs_36 USING (owner = current_user);
    GRANT SELECT ON rp_docs_36, rp_notes_36 TO rp_alice_36;
    SET ROLE rp_alice_36;
    SELECT coalesce(d.id, -1), n.id FROM rp_docs_36 d RIGHT JOIN rp_notes_36 n ON d.id = n.id ORDER BY n.id;
}
expect {
    1|1
    -1|2
    -1|4
}

test full-join-with-table-with-policy-on-either-side {
    CREATE ROLE rp_alice_37;
    CREATE TABLE rp_docs_37 (id INT PRIMARY KEY, owner TEXT);
    INSERT INTO rp_docs_37 VALUES (1, 'rp_alice_37'), (2, 'bob'), (3, 'rp_alice_37');
    CREATE TABLE rp_notes_37 (id INT);
    INSERT INTO rp_notes_37 VALUES (1), (2), (4);
    ALTER TABLE rp_docs_37 ENABLE ROW LEVEL SECURITY;
    CREATE POLICY own ON rp_docs_37 USING (owner = current_user);
    GRANT SELECT ON rp_docs_37, rp_notes_37 TO rp_alice_37;
    SET ROLE rp_alice_37;
    SELECT coalesce(d.id, -1), coalesce(n.id, -1) FROM rp_docs_37 d FULL JOIN rp_notes_37 n ON d.id = n.id ORDER BY 1, 2;
    SELECT coalesce(d.id, -1), coalesce(n.id, -1) FROM rp_notes_37 n FULL JOIN rp_docs_37 d ON d.id = n.id ORDER BY 1, 2;
}
expect {
    -1|2
    -1|4
    1|1
    3|-1
    -1|2
    -1|4
    1|1
    3|-1
}

# The unmatched rows of a RIGHT JOIN are read after the join loop. The
# division would fail on the hidden row, so it must not see it there either.
test right-join-conditions-do-not-see-hidden-unmatched-rows {
    CREATE ROLE rp_alice_38;
    CREATE TABLE rp_docs_38 (id INT PRIMARY KEY, owner TEXT, n INT);
    INSERT INTO rp_docs_38 VALUES (1, 'rp_alice_38', 1), (2, 'bob', 0), (3, 'rp_alice_38', 1);
    CREATE TABLE rp_notes_38 (id INT);
    INSERT INTO rp_notes_38 VALUES (1);
    ALTER TABLE rp_docs_38 ENABLE ROW LEVEL SECURITY;
    CREATE POLICY own ON rp_docs_38 USING (owner = current_user);
    GRANT SELECT ON rp_docs_38, rp_notes_38 TO rp_alice_38;
    SET ROLE rp_alice_38;
    SELECT coalesce(n.id, -1), d.id FROM rp_notes_38 n RIGHT JOIN rp_docs_38 d ON n.id = d.id WHERE 1 / d.n = 1 ORDER BY d.id;
}
expect {
    1|1
    -1|3
}

# PostgreSQL computes a subquery that reads no column of the row once per
# query, so a coin flipped in it shows a role every row or none, and the
# next query flips it again.
test scalar-subquery-of-policy-is-computed-once-per-statement {
    CREATE ROLE rp_alice_40;
    CREATE TABLE rp_docs_40 (id INT PRIMARY KEY);
    INSERT INTO rp_docs_40 SELECT g FROM generate_series(1, 200) AS g;
    ALTER TABLE rp_docs_40 ENABLE ROW LEVEL SECURITY;
    CREATE POLICY coin ON rp_docs_40 USING ((SELECT random()) < 0.5);
    GRANT SELECT ON rp_docs_40 TO rp_alice_40;
    SET ROLE rp_alice_40;
    SELECT CASE WHEN count(*) IN (0, 200) THEN 'once' ELSE 'per row' END FROM rp_docs_40;
}
expect {
    once
}

test scalar-subquery-of-policy-that-reads-a-column-is-computed-per-row {
    CREATE ROLE rp_alice_41;
    CREATE TABLE rp_docs_41 (id INT PRIMARY KEY, owner TEXT);
    INSERT INTO rp_docs_41 VALUES (1, 'rp_alice_41'), (2, 'bob'), (3, 'rp_alice_41');
    ALTER TABLE rp_docs_41 ENABLE ROW LEVEL SECURITY;
    CREATE POLICY own ON rp_docs_41 USING ((SELECT owner) = (SELECT (SELECT current_user)));
    GRANT SELECT ON rp_docs_41 TO rp_alice_41;
    SET ROLE rp_alice_41;
    SELECT id FROM rp_docs_41 ORDER BY id;
}
expect {
    1
    3
}

test copy-to-shows-only-the-rows-the-policies-allow {
    CREATE ROLE se_copy_alice;
    CREATE TABLE se_copy_docs (id INT PRIMARY KEY, owner TEXT);
    INSERT INTO se_copy_docs VALUES (1, 'se_copy_alice'), (2, 'someone else'), (3, 'se_copy_alice');
    ALTER TABLE se_copy_docs ENABLE ROW LEVEL SECURITY;
    CREATE POLICY own ON se_copy_docs USING (owner = current_user);
    GRANT SELECT ON se_copy_docs TO se_copy_alice;
    SET ROLE se_copy_alice;
    COPY se_copy_docs TO STDOUT;
}
expect unordered {
    1|se_copy_alice
    3|se_copy_alice
}
