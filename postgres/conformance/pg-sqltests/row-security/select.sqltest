    INSERT INTO ra_notes_38 VALUES (1), (2), (4);
    GRANT SELECT ON ra_notes_38 TO ra_role_38;
    ALTER TABLE ra_docs_38 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_38 TO ra_role_38;
    SELECT id FROM ra_docs_38 UNION SELECT id FROM ra_notes_38 ORDER BY id;
    SET ROLE ra_role_38;
    SELECT id FROM ra_docs_38 UNION SELECT id FROM ra_notes_38 ORDER BY id;
}
expect {
    1
    2
    3
    4
    1
    2
    4
}

test union-all {
