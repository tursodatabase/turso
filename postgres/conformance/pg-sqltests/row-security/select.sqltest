test aggregates {
    CREATE ROLE ra_role_13;
    CREATE TABLE ra_docs_13 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_13 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    ALTER TABLE ra_docs_13 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_13 TO ra_role_13;
    SELECT count(*), count(id), count(DISTINCT owner), coalesce(max(id), -1), coalesce(sum(id), -1) FROM ra_docs_13;
    SET ROLE ra_role_13;
    SELECT count(*), count(id), count(DISTINCT owner), coalesce(max(id), -1), coalesce(sum(id), -1) FROM ra_docs_13;
}
expect {
    3|3|2|3|6
    0|0|0|-1|-1
}

