test join-with-values {
    CREATE ROLE ra_role_25;
    CREATE TABLE ra_docs_25 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_25 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    ALTER TABLE ra_docs_25 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_25 TO ra_role_25;
    SELECT d.title FROM (VALUES (1), (3)) AS v(x) JOIN ra_docs_25 d ON d.id = v.x ORDER BY d.title;
    SET ROLE ra_role_25;
    SELECT d.title FROM (VALUES (1), (3)) AS v(x) JOIN ra_docs_25 d ON d.id = v.x ORDER BY d.title;
}
expect {
    a
    c
}

test table-without-row-security-in-the-same-query {
    CREATE ROLE ra_role_26;
    CREATE TABLE ra_docs_26 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_26 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    CREATE TABLE ra_notes_26 (id INT);
    INSERT INTO ra_notes_26 VALUES (1), (2), (4);
    GRANT SELECT ON ra_notes_26 TO ra_role_26;
    ALTER TABLE ra_docs_26 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_26 TO ra_role_26;
    SELECT (SELECT count(*) FROM ra_notes_26), (SELECT count(*) FROM ra_docs_26);
    SET ROLE ra_role_26;
    SELECT (SELECT count(*) FROM ra_notes_26), (SELECT count(*) FROM ra_docs_26);
}
expect {
    3|3
    3|0
}

