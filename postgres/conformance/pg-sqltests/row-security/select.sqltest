    ALTER TABLE ra_docs_22 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_22 TO ra_role_22;
    SELECT n.id FROM ra_notes_22 n LEFT JOIN ra_docs_22 d ON d.id = n.id WHERE d.id IS NULL ORDER BY n.id;
    SET ROLE ra_role_22;
    SELECT n.id FROM ra_notes_22 n LEFT JOIN ra_docs_22 d ON d.id = n.id WHERE d.id IS NULL ORDER BY n.id;
}
expect {
    4
    1
    2
    4
}

