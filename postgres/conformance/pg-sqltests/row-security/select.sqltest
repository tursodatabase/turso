test derived-table {
    CREATE ROLE ra_role_34;
    CREATE TABLE ra_docs_34 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_34 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    ALTER TABLE ra_docs_34 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_34 TO ra_role_34;
    SELECT count(*) FROM (SELECT id FROM ra_docs_34 WHERE id > 1) AS sub;
    SET ROLE ra_role_34;
    SELECT count(*) FROM (SELECT id FROM ra_docs_34 WHERE id > 1) AS sub;
}
expect {
    2
    0
}

test lateral-subquery {
    CREATE ROLE ra_role_35;
    CREATE TABLE ra_docs_35 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_35 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    CREATE TABLE ra_notes_35 (id INT);
    INSERT INTO ra_notes_35 VALUES (1), (2), (4);
    GRANT SELECT ON ra_notes_35 TO ra_role_35;
    ALTER TABLE ra_docs_35 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_35 TO ra_role_35;
    SELECT n.id, l.c FROM ra_notes_35 n, LATERAL (SELECT count(*) AS c FROM ra_docs_35 d WHERE d.id <= n.id) AS l ORDER BY n.id;
    SET ROLE ra_role_35;
    SELECT n.id, l.c FROM ra_notes_35 n, LATERAL (SELECT count(*) AS c FROM ra_docs_35 d WHERE d.id <= n.id) AS l ORDER BY n.id;
}
expect {
    1|1
    2|2
    4|3
    1|0
    2|0
    4|0
}

test cte {
    CREATE ROLE ra_role_36;
    CREATE TABLE ra_docs_36 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_36 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    ALTER TABLE ra_docs_36 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_36 TO ra_role_36;
    WITH sub AS (SELECT id FROM ra_docs_36) SELECT count(*) FROM sub;
    SET ROLE ra_role_36;
    WITH sub AS (SELECT id FROM ra_docs_36) SELECT count(*) FROM sub;
}
expect {
    3
    0
}

test recursive-cte {
    CREATE ROLE ra_role_37;
    CREATE TABLE ra_docs_37 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_37 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    ALTER TABLE ra_docs_37 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_37 TO ra_role_37;
    WITH RECURSIVE r(id) AS (SELECT id FROM ra_docs_37 WHERE id = 1 UNION ALL SELECT d.id FROM ra_docs_37 d JOIN r ON d.id = r.id + 1) SELECT id FROM r ORDER BY id;
    SET ROLE ra_role_37;
    WITH RECURSIVE r(id) AS (SELECT id FROM ra_docs_37 WHERE id = 1 UNION ALL SELECT d.id FROM ra_docs_37 d JOIN r ON d.id = r.id + 1) SELECT id FROM r ORDER BY id;
}
expect {
    1
    2
    3
}

test union {
    CREATE ROLE ra_role_38;
    CREATE TABLE ra_docs_38 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_38 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
