    ALTER TABLE ra_docs_15 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_15 TO ra_role_15;
    SELECT owner FROM ra_docs_15 GROUP BY owner HAVING count(*) > 1;
    SET ROLE ra_role_15;
    SELECT owner FROM ra_docs_15 GROUP BY owner HAVING count(*) > 1;
}
expect {
