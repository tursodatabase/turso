# What a role may write to a table with row-level security, through the
# PostgreSQL frontend.
# PostgreSQL roles belong to the whole server, so every test uses its own
# role and table names.

@database :memory:

test role-cannot-insert-rows {
    CREATE ROLE ra_role_56;
    CREATE TABLE ra_docs_56 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_56 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    ALTER TABLE ra_docs_56 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_56 TO ra_role_56;
    SET ROLE ra_role_56;
    INSERT INTO ra_docs_56 VALUES (9, 'mallory', 'x');
}
@sqlstate 42501
expect error {
    permission denied for table ra_docs_56
}

test role-cannot-update-rows {
    CREATE ROLE ra_role_57;
    CREATE TABLE ra_docs_57 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_57 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    ALTER TABLE ra_docs_57 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_57 TO ra_role_57;
    SET ROLE ra_role_57;
    UPDATE ra_docs_57 SET title = 'x' WHERE id = 1;
}
@sqlstate 42501
expect error {
    permission denied for table ra_docs_57
}

test role-cannot-delete-rows {
    CREATE ROLE ra_role_58;
    CREATE TABLE ra_docs_58 (id INT PRIMARY KEY, owner TEXT, title TEXT);
    INSERT INTO ra_docs_58 VALUES (1, 'alice', 'a'), (2, 'bob', 'b'), (3, 'alice', 'c');
    ALTER TABLE ra_docs_58 ENABLE ROW LEVEL SECURITY;
    GRANT SELECT ON ra_docs_58 TO ra_role_58;
    SET ROLE ra_role_58;
    DELETE FROM ra_docs_58 WHERE id = 1;
}
@sqlstate 42501
expect error {
    permission denied for table ra_docs_58
}
