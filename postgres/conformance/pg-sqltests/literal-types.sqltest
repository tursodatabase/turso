# The type of an integer written in the statement. The answers come from PostgreSQL 18.

@database :memory:

test literal-typeof-by-size {
    SELECT pg_typeof(1), pg_typeof(2147483647), pg_typeof(2147483648), pg_typeof(9223372036854775807), pg_typeof(9223372036854775808);
}
expect {
    integer|integer|bigint|bigint|numeric
}

test literal-negative-int4-minimum-is-an-int4 {
    SELECT pg_typeof(-2147483648), pg_typeof(-2147483649);
}
expect {
    integer|bigint
}

test literal-only-addition-overflows-int4 {
    SELECT 2147483647 + 1;
}
@sqlstate 22003
expect error {
}

test literal-only-multiplication-overflows-int4 {
    SELECT 2147483647 * 2;
}
@sqlstate 22003
expect error {
}

test literal-only-subtraction-overflows-int4 {
    SELECT -2147483648 - 1;
}
@sqlstate 22003
expect error {
}

test literal-only-addition-overflows-int8 {
    SELECT 9223372036854775807 + 1;
}
@sqlstate 22003
expect error {
}

test literal-only-int8-addition-is-bigint {
    SELECT 2147483648 + 1, pg_typeof(2147483648 + 1);
}
expect {
    2147483649|bigint
}

test literal-beyond-int8-is-numeric {
    SELECT 9223372036854775808 + 1, pg_typeof(9223372036854775808 + 1);
}
expect {
    9223372036854775809|numeric
}

test literal-only-division-is-int4 {
    SELECT 7 / 2, -7 / 2, pg_typeof(7 / 2);
}
expect {
    3|-3|integer
}

test literal-division-by-zero {
    SELECT 1 / 0;
}
@sqlstate 22012
expect error {
}

test int4-column-plus-a-large-literal-is-bigint {
    CREATE TABLE t (n int4);
    INSERT INTO t VALUES (1);
    SELECT n + 3000000000, pg_typeof(n + 3000000000) FROM t;
}
expect {
    3000000001|bigint
}

test int2-column-plus-a-literal-above-int2-is-int4 {
    SELECT 1::int2 + 40000, pg_typeof(1::int2 + 40000);
}
expect {
    40001|integer
}

test int8-literal-compared-with-int8 {
    SELECT 3000000000 = 3000000000::int8;
}
expect {
    t
}

test literal-in-order-by-position {
    SELECT x FROM (VALUES (3), (1), (2)) v(x) ORDER BY 1 DESC;
}
expect {
    3
    2
    1
}

test literal-in-group-by-position {
    SELECT x, y FROM (VALUES (3, 1), (1, 2)) v(x, y) GROUP BY 1, 2 ORDER BY 1;
}
expect {
    1|2
    3|1
}

test literal-in-limit-and-offset {
    SELECT x FROM generate_series(1, 5) x ORDER BY x LIMIT 2 OFFSET 1;
}
expect {
    2
    3
}

test literal-as-an-array-subscript {
    SELECT (ARRAY[10, 20, 30])[2];
}
expect {
    20
}

test literal-in-a-primary-key-lookup {
    CREATE TABLE t (id int4 PRIMARY KEY, v text);
    INSERT INTO t VALUES (1, 'a'), (2, 'b');
    SELECT v FROM t WHERE id = 2;
}
expect {
    b
}
