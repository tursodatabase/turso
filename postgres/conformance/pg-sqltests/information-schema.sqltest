# information_schema.tables and information_schema.columns.

@database :memory:

test tables-lists-tables-and-views-of-user-schemas {
    CREATE SCHEMA api;
    CREATE TABLE t (id int PRIMARY KEY);
    CREATE TABLE api.items (id int);
    CREATE VIEW v AS SELECT id FROM t;
    SELECT table_schema, table_name, table_type
    FROM information_schema.tables
    WHERE table_schema IN ('public', 'api')
    ORDER BY table_schema, table_name;
}
expect {
    api|items|BASE TABLE
    public|t|BASE TABLE
    public|v|VIEW
}

test columns-of-common-types {
    CREATE TABLE t (
        id int PRIMARY KEY,
        name varchar(5) NOT NULL,
        price numeric(10,2),
        tags text[],
        at timestamptz,
        flag boolean DEFAULT true,
        n int DEFAULT 0
    );
    SELECT column_name, ordinal_position, data_type, is_nullable, column_default, udt_name
    FROM information_schema.columns
    WHERE table_name = 't'
    ORDER BY ordinal_position;
}
expect {
    id|1|integer|NO||int4
    name|2|character varying|NO||varchar
    price|3|numeric|YES||numeric
    tags|4|ARRAY|YES||_text
    at|5|timestamp with time zone|YES||timestamptz
    flag|6|boolean|YES|true|bool
    n|7|integer|YES|0|int4
}

test columns-type-sizes {
    CREATE TABLE t (
        a varchar(5),
        b text,
        c numeric(10,2),
        d smallint,
        e bigint,
        g double precision,
        h timestamptz,
        i date
    );
    SELECT column_name, character_maximum_length, character_octet_length,
           numeric_precision, numeric_precision_radix, numeric_scale, datetime_precision
    FROM information_schema.columns
    WHERE table_name = 't'
    ORDER BY ordinal_position;
}
expect {
    a|5|20||||
    b||1073741824||||
    c|||10|10|2|
    d|||16|2|0|
    e|||64|2|0|
    g|||53|2||
    h||||||6
    i||||||0
}

test columns-of-a-view {
    CREATE TABLE t (id int PRIMARY KEY, label text);
    CREATE VIEW v AS SELECT id, label FROM t;
    SELECT table_name, column_name, ordinal_position, data_type
    FROM information_schema.columns
    WHERE table_name = 'v'
    ORDER BY ordinal_position;
}
expect {
    v|id|1|integer
    v|label|2|text
}

test columns-of-a-table-in-another-schema {
    CREATE SCHEMA api;
    CREATE TABLE api.items (id int, s text);
    SELECT table_schema, table_name, column_name
    FROM information_schema.columns
    WHERE table_schema = 'api'
    ORDER BY ordinal_position;
}
expect {
    api|items|id
    api|items|s
}

test columns-of-identity-and-generated-columns {
    CREATE TABLE t (
        id int GENERATED ALWAYS AS IDENTITY,
        d int GENERATED BY DEFAULT AS IDENTITY,
        g int GENERATED ALWAYS AS (id * 2) STORED
    );
    SELECT column_name, column_default, is_identity, identity_generation, is_generated
    FROM information_schema.columns
    WHERE table_name = 't'
    ORDER BY ordinal_position;
}
expect {
    id||YES|ALWAYS|NEVER
    d||YES|BY DEFAULT|NEVER
    g||NO||ALWAYS
}
