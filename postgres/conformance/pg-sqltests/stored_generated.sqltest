test stored-generated-column-catalog-operator-deparse {
    CREATE TABLE t (a int, s text,
        b int GENERATED ALWAYS AS (-a) STORED,
        c int GENERATED ALWAYS AS (coalesce(a, 0)) STORED,
        d boolean GENERATED ALWAYS AS (a BETWEEN 1 AND 3 OR s IS NULL) STORED);
    SELECT d.adnum, pg_get_expr(d.adbin, d.adrelid)
    FROM pg_attrdef d JOIN pg_class c ON c.oid = d.adrelid
    WHERE c.relname = 't'
    ORDER BY d.adnum;
}
expect {
    3|(- a)
    4|COALESCE(a, 0)
    5|(((a >= 1) AND (a <= 3)) OR (s IS NULL))
}

test stored-generated-column-upsert-do-update-not-null-primary-key {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED PRIMARY KEY, c text);
    INSERT INTO t (a, c) VALUES (1, 'x');
    INSERT INTO t (a, c) VALUES (1, 'q') ON CONFLICT (b) DO UPDATE SET a = NULL;
}
@sqlstate 23502
expect error {}

test stored-generated-column-upsert-do-update-not-null-column {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED NOT NULL, c text UNIQUE);
    INSERT INTO t (a, c) VALUES (1, 'x');
    INSERT INTO t (a, c) VALUES (1, 'x') ON CONFLICT (c) DO UPDATE SET a = NULL;
}
@sqlstate 23502
expect error {}

test stored-generated-column-add-column-references-generated-column {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    ALTER TABLE t ADD COLUMN c int GENERATED ALWAYS AS (b + 1) STORED;
}
@sqlstate 42P17
expect error {}

test stored-generated-column-add-column-with-default-rejected {
    CREATE TABLE t2 (a int);
    INSERT INTO t2 VALUES (1);
    ALTER TABLE t2 ADD COLUMN c int DEFAULT 3 GENERATED ALWAYS AS (a + 1) STORED;
}
@sqlstate 42601
expect error {}

test stored-generated-column-catalog-concat-cast-deparse {
    CREATE TABLE t (a int, c text GENERATED ALWAYS AS ('x' || a::text) STORED);
    SELECT pg_get_expr(d.adbin, d.adrelid)
    FROM pg_attrdef d JOIN pg_class c ON c.oid = d.adrelid
    WHERE c.relname = 't';
}
expect {
    ('x'::text || (a)::text)
}

test stored-generated-column-catalog-like-deparse {
    CREATE TABLE t (s text, c boolean GENERATED ALWAYS AS (s LIKE 'x%') STORED);
    SELECT pg_get_expr(d.adbin, d.adrelid)
    FROM pg_attrdef d JOIN pg_class c ON c.oid = d.adrelid
    WHERE c.relname = 't';
}
expect {
    (s ~~ 'x%'::text)
}

test stored-generated-column-catalog-in-list-deparse {
    CREATE TABLE t (s text, c boolean GENERATED ALWAYS AS (s IN ('p', 'q')) STORED);
    SELECT pg_get_expr(d.adbin, d.adrelid)
    FROM pg_attrdef d JOIN pg_class c ON c.oid = d.adrelid
    WHERE c.relname = 't';
}
expect {
    (s = ANY (ARRAY['p'::text, 'q'::text]))
}

test stored-generated-column-catalog-text-literal-deparse {
    CREATE TABLE t (c text GENERATED ALWAYS AS ('m') STORED);
    SELECT pg_get_expr(d.adbin, d.adrelid)
    FROM pg_attrdef d JOIN pg_class c ON c.oid = d.adrelid
    WHERE c.relname = 't';
}
expect {
    'm'::text
}

test stored-generated-column-catalog-negative-literal-deparse {
    CREATE TABLE t (c int GENERATED ALWAYS AS (-1) STORED);
    SELECT pg_get_expr(d.adbin, d.adrelid)
    FROM pg_attrdef d JOIN pg_class c ON c.oid = d.adrelid
    WHERE c.relname = 't';
}
expect {
    '-1'::integer
}

test stored-generated-column-catalog-is-not-distinct-deparse {
    CREATE TABLE t (s text, c boolean GENERATED ALWAYS AS (s IS NOT DISTINCT FROM 'z') STORED);
    SELECT pg_get_expr(d.adbin, d.adrelid)
    FROM pg_attrdef d JOIN pg_class c ON c.oid = d.adrelid
    WHERE c.relname = 't';
}
expect {
    (NOT (s IS DISTINCT FROM 'z'::text))
}

test stored-generated-column-catalog-substring-deparse {
    CREATE TABLE t (s text, c text GENERATED ALWAYS AS (substring(s, 1, 2)) STORED);
    SELECT pg_get_expr(d.adbin, d.adrelid)
    FROM pg_attrdef d JOIN pg_class c ON c.oid = d.adrelid
    WHERE c.relname = 't';
}
expect {
    "substring"(s, 1, 2)
}

