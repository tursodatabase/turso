test stored-generated-column-insert-select-star-before-generated-column {
    CREATE TABLE src (x int, y int);
    INSERT INTO src VALUES (1, 2);
    CREATE TABLE t (a int, b int, g int GENERATED ALWAYS AS (a + b) STORED);
    INSERT INTO t SELECT * FROM src;
    SELECT a, b, g FROM t;
}
expect {
    1|2|3
