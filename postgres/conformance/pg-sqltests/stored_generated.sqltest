    ALTER TABLE t DROP COLUMN a;
}
@sqlstate 2BP01
expect error {}

test stored-generated-column-drop-generated-column {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    INSERT INTO t VALUES (1);
    ALTER TABLE t DROP COLUMN b;
    SELECT * FROM t;
}
expect {
    1
}

test stored-generated-column-rename-referenced-column {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    ALTER TABLE t RENAME COLUMN a TO z;
    INSERT INTO t VALUES (4);
    SELECT z, b FROM t;
}
expect {
    4|8
}

test stored-generated-column-add-column {
    CREATE TABLE t (a int);
    INSERT INTO t VALUES (1);
    ALTER TABLE t ADD COLUMN b int GENERATED ALWAYS AS (a + 1) STORED;
    SELECT a, b FROM t;
}
expect {
    1|2
}

test stored-generated-column-add-column-constant-expression {
    CREATE TABLE t (a int);
    INSERT INTO t VALUES (1), (2);
    ALTER TABLE t ADD COLUMN b int GENERATED ALWAYS AS (5) STORED;
    SELECT a, b FROM t ORDER BY a;
}
expect {
    1|5
    2|5
}

test stored-generated-column-drop-expression {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    INSERT INTO t VALUES (1);
    ALTER TABLE t ALTER COLUMN b DROP EXPRESSION;
    INSERT INTO t VALUES (2, 3);
    SELECT a, b FROM t ORDER BY a;
}
expect {
    1|2
    2|3
}

test stored-generated-column-catalog-attgenerated {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    SELECT a.attname, a.attgenerated, a.atthasdef
    FROM pg_attribute a JOIN pg_class c ON c.oid = a.attrelid
    WHERE c.relname = 't' AND a.attnum > 0
    ORDER BY a.attnum;
}
expect {
    a||f
    b|s|t
}

test stored-generated-column-catalog-generation-expression {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    SELECT pg_get_expr(d.adbin, d.adrelid)
    FROM pg_attrdef d JOIN pg_class c ON c.oid = d.adrelid
    WHERE c.relname = 't';
}
expect {
    (a * 2)
}

test stored-generated-column-drop-expression-of-regular-column {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    ALTER TABLE t ALTER COLUMN a DROP EXPRESSION;
}
@sqlstate 55000
expect error {}

