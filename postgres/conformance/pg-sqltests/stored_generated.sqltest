test stored-generated-column-on-conflict-do-nothing {
    CREATE TABLE t (a int PRIMARY KEY, b int GENERATED ALWAYS AS (a * 2) STORED);
    INSERT INTO t (a) VALUES (1);
    INSERT INTO t (a) VALUES (1) ON CONFLICT DO NOTHING;
    SELECT a, b FROM t;
}
expect {
    1|2
}

test stored-generated-column-foreign-key-plain-reference-allowed {
    CREATE TABLE p (id int PRIMARY KEY);
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a) STORED REFERENCES p (id));
    SELECT 1;
}
expect {
    1
}

test stored-generated-column-foreign-key-on-delete-cascade-allowed {
    CREATE TABLE p (id int PRIMARY KEY);
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a) STORED REFERENCES p (id) ON DELETE CASCADE);
    SELECT 1;
}
expect {
    1
}

test stored-generated-column-catalog-one-entry-per-generated-column {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED, c int);
    SELECT count(*) FROM pg_attrdef d
    JOIN pg_class c ON c.oid = d.adrelid
    WHERE c.relname = 't';
}
expect {
    1
}

