test stored-generated-column-select-star {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    INSERT INTO t (a) VALUES (3);
    SELECT * FROM t;
}
expect {
    3|6
}

test stored-generated-column-where-without-index {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    INSERT INTO t (a) VALUES (1), (3), (5);
    SELECT a FROM t WHERE b > 4 ORDER BY a;
}
expect {
    3
    5
}

test stored-generated-column-group-by {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a % 3) STORED);
    INSERT INTO t (a) VALUES (1), (2), (4), (5);
    SELECT b, count(*) FROM t GROUP BY b ORDER BY b;
}
expect {
    1|2
    2|2
}

test stored-generated-column-having {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a % 3) STORED);
    INSERT INTO t (a) VALUES (1), (2), (4), (5);
    SELECT b FROM t GROUP BY b HAVING count(*) > 1 ORDER BY b;
}
expect {
    1
    2
}

test stored-generated-column-join {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a) STORED);
    CREATE TABLE r (id int, label text);
    INSERT INTO t (a) VALUES (1), (2);
    INSERT INTO r VALUES (1, 'x'), (2, 'y');
    SELECT t.a, r.label FROM t JOIN r ON t.b = r.id ORDER BY t.a;
}
expect {
    1|x
    2|y
}

test stored-generated-column-insert-returning-star {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    INSERT INTO t (a) VALUES (4) RETURNING *;
}
expect {
    4|8
}

test stored-generated-column-update-returning-star {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    INSERT INTO t (a) VALUES (1);
    UPDATE t SET a = 6 RETURNING *;
}
expect {
    6|12
}

