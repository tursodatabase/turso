test stored-generated-column-boolean-recomputed-on-update {
    CREATE TABLE t (id int PRIMARY KEY, b boolean, gb boolean GENERATED ALWAYS AS (NOT b) STORED);
    INSERT INTO t VALUES (1, false);
    UPDATE t SET b = 'true' WHERE id = 1;
    SELECT b, gb FROM t;
}
expect {
    t|f
}

test stored-generated-column-boolean-recomputed-on-upsert {
    CREATE TABLE t (id int PRIMARY KEY, b boolean, gb boolean GENERATED ALWAYS AS (NOT b) STORED);
    INSERT INTO t VALUES (1, false);
    INSERT INTO t VALUES (1, false) ON CONFLICT (id) DO UPDATE SET b = 'true';
    SELECT b, gb FROM t;
}
expect {
    t|f
}

test stored-generated-column-numeric-recomputed-on-update {
    CREATE TABLE t (id int PRIMARY KEY, n numeric(6,2), gn numeric GENERATED ALWAYS AS (n * 2) STORED);
    INSERT INTO t VALUES (1, '1.005');
    UPDATE t SET n = '2.555' WHERE id = 1;
    SELECT n, gn FROM t;
}
expect {
    2.56|5.12
}

test stored-generated-column-numeric-recomputed-on-upsert {
    CREATE TABLE t (id int PRIMARY KEY, n numeric(6,2), gn numeric GENERATED ALWAYS AS (n * 2) STORED);
    INSERT INTO t VALUES (1, '1.005');
    INSERT INTO t VALUES (1, '0') ON CONFLICT (id) DO UPDATE SET n = '2.555';
    SELECT n, gn FROM t;
}
expect {
    2.56|5.12
}

test stored-generated-column-array-element-recomputed-on-update {
    CREATE TABLE t (id int PRIMARY KEY, arr int[], ga int GENERATED ALWAYS AS (arr[1]) STORED);
    INSERT INTO t VALUES (1, '{7,8}');
    UPDATE t SET arr = '{9}' WHERE id = 1;
    SELECT arr, ga FROM t;
}
expect {
    {9}|9
}

test stored-generated-column-array-element-recomputed-on-upsert {
    CREATE TABLE t (id int PRIMARY KEY, arr int[], ga int GENERATED ALWAYS AS (arr[1]) STORED);
    INSERT INTO t VALUES (1, '{7,8}');
    INSERT INTO t VALUES (1, '{1}') ON CONFLICT (id) DO UPDATE SET arr = '{9}';
    SELECT arr, ga FROM t;
}
expect {
    {9}|9
}

test stored-generated-column-int-array-concat-recomputed-on-update {
    CREATE TABLE t (id int PRIMARY KEY, arr int[], g int[] GENERATED ALWAYS AS (arr || 3) STORED);
    INSERT INTO t VALUES (1, '{1,2}');
    UPDATE t SET arr = '{5,6}' WHERE id = 1;
    SELECT arr, g FROM t;
}
expect {
    {5,6}|{5,6,3}
}

test stored-generated-column-int-array-concat-recomputed-on-other-column-upsert {
    CREATE TABLE t (id int PRIMARY KEY, arr int[], g int[] GENERATED ALWAYS AS (arr || 3) STORED, x int);
    INSERT INTO t (id, arr, x) VALUES (1, '{1,2}', 0);
    INSERT INTO t (id, arr, x) VALUES (1, '{9}', 1) ON CONFLICT (id) DO UPDATE SET x = excluded.x + 10;
    SELECT arr, g, x FROM t;
}
expect {
    {1,2}|{1,2,3}|11
}

