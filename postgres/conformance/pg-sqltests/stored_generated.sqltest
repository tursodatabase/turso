test stored-generated-column-unqualified-alter-table-accepts-schema-qualified-expression {
    CREATE SCHEMA s;
    CREATE TABLE s.t (a int);
    SET search_path = s, public;
    ALTER TABLE t ADD COLUMN b int GENERATED ALWAYS AS (s.t.a * 2) STORED;
    INSERT INTO t (a) VALUES (5);
    SELECT a, b FROM t;
}
expect {
    5|10
}

