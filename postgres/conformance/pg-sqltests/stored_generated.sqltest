test stored-generated-column-drop-referenced-column {
    CREATE TABLE t (a int, x int, b int GENERATED ALWAYS AS (a * 2) STORED);
    ALTER TABLE t DROP COLUMN a;
}
@sqlstate 2BP01
expect error {}

test stored-generated-column-drop-generated-column {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    INSERT INTO t (a) VALUES (1);
    ALTER TABLE t DROP COLUMN b;
    SELECT * FROM t;
}
expect {
    1
}

test stored-generated-column-rename-referenced-column {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    ALTER TABLE t RENAME COLUMN a TO z;
    INSERT INTO t (z) VALUES (4);
    SELECT z, b FROM t;
}
expect {
    4|8
}

test stored-generated-column-catalog-attgenerated {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    SELECT a.attname, a.attgenerated, a.atthasdef
    FROM pg_attribute a JOIN pg_class c ON c.oid = a.attrelid
    WHERE c.relname = 't' AND a.attnum > 0
    ORDER BY a.attnum;
}
expect {
    a||f
    b|s|t
}

@skip-if postgres "tursopg rejects positional INSERT on tables with generated columns as unsupported (0A000); PostgreSQL rejects with a column-count mismatch error instead"
