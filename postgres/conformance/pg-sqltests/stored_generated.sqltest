@skip-if postgres "tursopg pg_get_expr returns pg-dialect syntax; real postgres returns a different internal representation"
test stored-generated-column-pg-get-expr-returns-pg-syntax {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (greatest(a, 2)) STORED);
    SELECT pg_get_expr(adbin, adrelid) FROM pg_attrdef pa JOIN pg_class pc ON pa.adrelid = pc.oid WHERE pc.relname = 't';
}
expect {
    greatest(a, 2)
}

@skip-if postgres "real postgres prints adbin differently"
test stored-generated-column-pg-get-expr-keeps-grouping {
    CREATE TABLE t (a int, b int, g int GENERATED ALWAYS AS (a - (1 - b)) STORED);
    SELECT pg_get_expr(adbin, adrelid) FROM pg_attrdef pa JOIN pg_class pc ON pa.adrelid = pc.oid WHERE pc.relname = 't';
}
expect {
    a - (1 - b)
}

@skip-if postgres "real postgres prints adbin differently"
test stored-generated-column-pg-get-expr-quotes-names {
    CREATE TABLE t ("select" int, "Mixed Case" int, g int GENERATED ALWAYS AS ("select" + "Mixed Case") STORED);
    SELECT pg_get_expr(adbin, adrelid) FROM pg_attrdef pa JOIN pg_class pc ON pa.adrelid = pc.oid WHERE pc.relname = 't';
}
expect {
    "select" + "Mixed Case"
}

@skip-if postgres "real postgres prints adbin differently"
test stored-generated-column-pg-get-expr-after-rename {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    ALTER TABLE t RENAME COLUMN a TO z;
    SELECT pg_get_expr(adbin, adrelid) FROM pg_attrdef pa JOIN pg_class pc ON pa.adrelid = pc.oid WHERE pc.relname = 't';
}
expect {
    z * 2
}
