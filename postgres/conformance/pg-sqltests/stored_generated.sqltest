test stored-generated-column-add-column-converts-to-column-type {
    CREATE TABLE t (a int);
    INSERT INTO t VALUES (5);
    ALTER TABLE t ADD COLUMN b numeric(10,2) GENERATED ALWAYS AS (a / 3.0) STORED;
    INSERT INTO t VALUES (7);
    SELECT a, b FROM t ORDER BY a;
}
expect {
    5|1.67
    7|2.33
}

test insert-positional-default-into-regular-columns {
    CREATE TABLE t (a int DEFAULT 7, b int);
    INSERT INTO t VALUES (DEFAULT, 5);
    INSERT INTO t DEFAULT VALUES;
    SELECT a, b FROM t ORDER BY b;
}
expect {
    7|5
    7|
}

