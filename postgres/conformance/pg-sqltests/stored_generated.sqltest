test stored-generated-column-smallint-overflow-checked-before-varchar {
    CREATE TABLE t (a int, s smallint GENERATED ALWAYS AS (a * 1000) STORED, v varchar(3) GENERATED ALWAYS AS (repeat('x', a)) STORED);
    INSERT INTO t (a) VALUES (40);
}
@sqlstate 22003
expect error {}

test stored-generated-column-varchar-overflow-checked-before-smallint {
    CREATE TABLE t (a int, v varchar(3) GENERATED ALWAYS AS (repeat('x', a)) STORED, s smallint GENERATED ALWAYS AS (a * 1000) STORED);
    INSERT INTO t (a) VALUES (40);
}
@sqlstate 22001
expect error {}

test stored-generated-column-drop-expression-mixed-case-name-not-found {
    CREATE TABLE t (id int, "Mixed" text GENERATED ALWAYS AS ('m') STORED);
    ALTER TABLE t ALTER COLUMN mixed DROP EXPRESSION;
}
@sqlstate 42703
expect error {}

test stored-generated-column-alter-if-exists-missing-table-is-noop {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    ALTER TABLE IF EXISTS nosuch ALTER COLUMN b DROP EXPRESSION;
    SELECT 1;
}
expect {
    1
}

test stored-generated-column-insert-more-values-than-columns {
    CREATE TABLE t (id int, a int, g int GENERATED ALWAYS AS (a) STORED);
    INSERT INTO t VALUES (1, 2, DEFAULT, 4);
}
@sqlstate 42601
expect error {
    INSERT has more expressions than target columns
}

test stored-generated-column-catalog-ilike-and-not-like-deparse {
    CREATE TABLE t (s text,
        b boolean GENERATED ALWAYS AS (s ILIKE 'Q%') STORED,
        c boolean GENERATED ALWAYS AS (s NOT LIKE 'a\_b%') STORED);
    SELECT d.adnum, pg_get_expr(d.adbin, d.adrelid)
    FROM pg_attrdef d JOIN pg_class c ON c.oid = d.adrelid
    WHERE c.relname = 't'
    ORDER BY d.adnum;
}
expect {
    2|(s ~~* 'Q%'::text)
    3|(s !~~ 'a\_b%'::text)
}

test stored-generated-column-catalog-not-in-and-is-distinct-deparse {
    CREATE TABLE t (a int, s text,
        b boolean GENERATED ALWAYS AS (a NOT IN (1, 2)) STORED,
        c boolean GENERATED ALWAYS AS (s IS DISTINCT FROM 'z') STORED,
        e boolean GENERATED ALWAYS AS (s ~ '^a') STORED);
    SELECT d.adnum, pg_get_expr(d.adbin, d.adrelid)
    FROM pg_attrdef d JOIN pg_class c ON c.oid = d.adrelid
    WHERE c.relname = 't'
    ORDER BY d.adnum;
}
expect {
    3|(a <> ALL (ARRAY[1, 2]))
    4|(s IS DISTINCT FROM 'z'::text)
    5|(s ~ '^a'::text)
}

test stored-generated-column-catalog-numeric-literal-deparse {
    CREATE TABLE t (a int,
        b bigint GENERATED ALWAYS AS (5000000000) STORED,
        c numeric GENERATED ALWAYS AS (-1.5) STORED,
        e numeric GENERATED ALWAYS AS (1.5) STORED,
        f boolean GENERATED ALWAYS AS (true) STORED);
    SELECT d.adnum, pg_get_expr(d.adbin, d.adrelid)
    FROM pg_attrdef d JOIN pg_class c ON c.oid = d.adrelid
    WHERE c.relname = 't'
    ORDER BY d.adnum;
}
expect {
    2|'5000000000'::bigint
    3|'-1.5'::numeric
    4|1.5
    5|true
}

test stored-generated-column-catalog-quoted-column-deparse {
    CREATE TABLE t ("Ab" int, b int GENERATED ALWAYS AS ("Ab" + 1) STORED);
    SELECT pg_get_expr(d.adbin, d.adrelid)
    FROM pg_attrdef d JOIN pg_class c ON c.oid = d.adrelid
    WHERE c.relname = 't';
}
expect {
    ("Ab" + 1)
}

