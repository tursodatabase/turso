test stored-generated-column-qualified-with-own-table {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (t.a) STORED);
    INSERT INTO t (a) VALUES (3);
    SELECT a, b FROM t;
}
expect {
    3|3
}

