test stored-generated-column-catalog-case-expression-deparse {
    CREATE TABLE t (a int, c int GENERATED ALWAYS AS (CASE WHEN a > 0 THEN 1 ELSE 0 END) STORED);
    SELECT (pg_get_expr(d.adbin, d.adrelid) LIKE '%WHEN (a > 0) THEN 1%')::int
    FROM pg_attrdef d JOIN pg_class c ON c.oid = d.adrelid
    WHERE c.relname = 't';
}
expect {
    1
}

