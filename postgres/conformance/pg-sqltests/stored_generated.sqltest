@database :memory:

test stored-generated-column-computed-on-insert {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    INSERT INTO t (a) VALUES (5);
    SELECT a, b FROM t;
}
expect {
    5|10
}

test stored-generated-column-rejects-explicit-value {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    INSERT INTO t (a, b) VALUES (5, 99);
}
@sqlstate 428C9
expect error {}

test stored-generated-column-updated-on-row-update {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    INSERT INTO t (a) VALUES (3);
    UPDATE t SET a = 7;
    SELECT a, b FROM t;
}
expect {
    7|14
}

test stored-generated-column-constant-expression {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (5) STORED, c text GENERATED ALWAYS AS ('x') STORED);
    INSERT INTO t (a) VALUES (1), (2);
    UPDATE t SET a = a + 10;
    SELECT a, b, c FROM t ORDER BY a;
}
expect {
    11|5|x
    12|5|x
}

test stored-generated-column-string-concat {
    CREATE TABLE t (first text, last text, full_name text GENERATED ALWAYS AS (first || ' ' || last) STORED);
    INSERT INTO t (first, last) VALUES ('John', 'Doe');
    SELECT full_name FROM t;
}
expect {
    John Doe
}

test stored-generated-column-insert-default-with-column-list {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    INSERT INTO t (a, b) VALUES (5, DEFAULT);
    SELECT a, b FROM t;
}
expect {
    5|10
}

test stored-generated-column-insert-default-without-column-list {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    INSERT INTO t VALUES (5, DEFAULT);
    SELECT a, b FROM t;
}
expect {
    5|10
}

test stored-generated-column-insert-default-values {
    CREATE TABLE t (a int DEFAULT 4, b int GENERATED ALWAYS AS (a * 2) STORED);
    INSERT INTO t DEFAULT VALUES;
    SELECT a, b FROM t;
}
expect {
    4|8
}

test stored-generated-column-positional-values-include-generated-column {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED, c int);
    INSERT INTO t VALUES (1, DEFAULT, 3);
    SELECT a, b, c FROM t;
}
expect {
    1|2|3
}

test stored-generated-column-positional-values-reject-value-for-generated-column {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED, c int);
    INSERT INTO t VALUES (1, 3);
}
@sqlstate 428C9
expect error {}

test stored-generated-column-positional-select-rejects-value-for-generated-column {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED, c int);
    INSERT INTO t SELECT 1, 3;
}
@sqlstate 428C9
expect error {}

test stored-generated-column-insert-select-rejects-explicit-value {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    INSERT INTO t SELECT 1, 2;
}
@sqlstate 428C9
expect error {}

test stored-generated-column-insert-returning {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    INSERT INTO t VALUES (1) RETURNING a, b;
}
expect {
    1|2
}

test stored-generated-column-update-rejects-explicit-value {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    INSERT INTO t VALUES (1);
    UPDATE t SET b = 1;
}
@sqlstate 428C9
expect error {}

test stored-generated-column-update-to-default {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    INSERT INTO t VALUES (1);
    UPDATE t SET b = DEFAULT, a = 10;
    SELECT a, b FROM t;
}
expect {
    10|20
}

test stored-generated-column-update-returning {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    INSERT INTO t VALUES (1);
    UPDATE t SET a = a + 1 RETURNING a, b;
}
expect {
    2|4
}

test stored-generated-column-upsert-rejects-explicit-value {
    CREATE TABLE t (a int PRIMARY KEY, b int GENERATED ALWAYS AS (a * 2) STORED);
    INSERT INTO t VALUES (1);
    INSERT INTO t VALUES (1) ON CONFLICT (a) DO UPDATE SET b = 5;
}
@sqlstate 428C9
expect error {}

test stored-generated-column-upsert-updates-index {
    CREATE TABLE t (a int PRIMARY KEY, c int, b int GENERATED ALWAYS AS (c * 2) STORED);
    CREATE INDEX t_b ON t (b);
    INSERT INTO t VALUES (1, 1);
    INSERT INTO t VALUES (1, 5) ON CONFLICT (a) DO UPDATE SET c = excluded.c;
    SELECT a FROM t WHERE b = 10;
}
expect {
    1
}

test stored-generated-column-index-after-update {
    CREATE TABLE t (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    CREATE INDEX t_b ON t (b);
    INSERT INTO t VALUES (1), (2);
    UPDATE t SET a = 5 WHERE a = 1;
    SELECT a FROM t WHERE b = 10;
}
expect {
    5
}

