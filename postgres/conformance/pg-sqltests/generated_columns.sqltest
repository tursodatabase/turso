# Generated columns. `GENERATED ALWAYS AS (expr) STORED` computes the column
# from the other columns of its row, and writing to it directly is an error.
# The clause used to be dropped on the way in, so the column existed but
# stayed NULL and writes to it were accepted — a wrong answer with no
# complaint. PostgreSQL requires the expression to be immutable, so computing
# it on read gives the same values as storing it.

@database :memory:

test generated-column-is-computed-from-its-row {
    CREATE TABLE g (a int, b int GENERATED ALWAYS AS (a + 1) STORED);
    INSERT INTO g (a) VALUES (5), (10);
    SELECT a, b FROM g ORDER BY a;
}
expect {
    5|6
    10|11
}

test generated-column-follows-an-update-of-its-source {
    CREATE TABLE g_upd (a int, b int GENERATED ALWAYS AS (a * 2) STORED);
    INSERT INTO g_upd (a) VALUES (3);
    UPDATE g_upd SET a = 7;
    SELECT a, b FROM g_upd;
}
expect {
    7|14
}

test generated-column-over-several-columns {
    CREATE TABLE g_multi (a int, b int, total int GENERATED ALWAYS AS (a + b) STORED);
    INSERT INTO g_multi (a, b) VALUES (2, 40);
    SELECT total FROM g_multi;
}
expect {
    42
}

test generated-column-of-text-type {
    CREATE TABLE g_text (first text, last text,
                         full_name text GENERATED ALWAYS AS (first || ' ' || last) STORED);
    INSERT INTO g_text (first, last) VALUES ('Ada', 'Lovelace');
    SELECT full_name FROM g_text;
}
expect {
    Ada Lovelace
}

# Counted rather than compared against the value, because a boolean still
# renders as 1/0 here instead of PostgreSQL's t/f.
test generated-column-is-null-when-its-source-is-null {
    CREATE TABLE g_null (a int, b int GENERATED ALWAYS AS (a + 1) STORED);
    INSERT INTO g_null (a) VALUES (NULL), (4);
    SELECT count(b) FROM g_null;
}
expect {
    1
}

# PostgreSQL: ERROR: cannot insert a non-DEFAULT value into column "b"
test inserting-into-a-generated-column-is-refused {
    CREATE TABLE g_ins (a int, b int GENERATED ALWAYS AS (a + 1) STORED);
    INSERT INTO g_ins (a, b) VALUES (1, 999);
}
expect error {
    ^.*generated column.*$
}

# PostgreSQL: ERROR: column "b" can only be updated to DEFAULT
test updating-a-generated-column-is-refused {
    CREATE TABLE g_updx (a int, b int GENERATED ALWAYS AS (a + 1) STORED);
    INSERT INTO g_updx (a) VALUES (1);
    UPDATE g_updx SET b = 5;
}
expect error {
    ^.*generated column.*$
}

test generated-column-appears-in-select-star {
    CREATE TABLE g_star (a int, b int GENERATED ALWAYS AS (a + 1) STORED);
    INSERT INTO g_star (a) VALUES (1);
    SELECT * FROM g_star;
}
expect {
    1|2
}

test generated-column-can-be-filtered-on {
    CREATE TABLE g_where (a int, b int GENERATED ALWAYS AS (a + 1) STORED);
    INSERT INTO g_where (a) VALUES (1), (2), (3);
    SELECT a FROM g_where WHERE b = 3;
}
expect {
    2
}

# GENERATED ... AS IDENTITY numbers the column from a sequence, the standard
# spelling of what SERIAL does. It used to be dropped in the same place as
# GENERATED ALWAYS AS, leaving the column NULL on every insert.

test identity-column-numbers-rows {
    CREATE TABLE ida (a int GENERATED ALWAYS AS IDENTITY, b text);
    INSERT INTO ida (b) VALUES ('x'), ('y'), ('z');
    SELECT a, b FROM ida ORDER BY a;
}
expect {
    1|x
    2|y
    3|z
}

test identity-by-default-numbers-rows-too {
    CREATE TABLE idb (a int GENERATED BY DEFAULT AS IDENTITY, b text);
    INSERT INTO idb (b) VALUES ('x'), ('y');
    SELECT a, b FROM idb ORDER BY a;
}
expect {
    1|x
    2|y
}

test identity-by-default-accepts-an-explicit-value {
    CREATE TABLE idc (a int GENERATED BY DEFAULT AS IDENTITY, b text);
    INSERT INTO idc (a, b) VALUES (42, 'given');
    SELECT a, b FROM idc;
}
expect {
    42|given
}

test bigint-identity-column-numbers-rows {
    CREATE TABLE idd (a bigint GENERATED ALWAYS AS IDENTITY, b text);
    INSERT INTO idd (b) VALUES ('x');
    SELECT a, b FROM idd;
}
expect {
    1|x
}
