@skip-if tursopg "the type of a row value is not known yet"
test row-constructor-comparisons {
    CREATE TABLE row_values (a int, b int);
    INSERT INTO row_values VALUES (1, 2), (3, NULL);
    SELECT CASE WHEN (1, 2) = (1, 2) THEN 1 ELSE 0 END;
    SELECT CASE WHEN ROW(1, 2) = ROW(1, 2) THEN 1 ELSE 0 END;
    SELECT CASE WHEN (1, 2) < (1, 3) THEN 1 ELSE 0 END;
    SELECT CASE WHEN (1, 2) <> (1, 2) THEN 1 ELSE 0 END;
    SELECT CASE WHEN ((1, NULL) = (1, NULL)) IS NULL THEN 1 ELSE 0 END;
    SELECT CASE WHEN (1, 2) IN ((1, 2), (3, 4)) THEN 1 ELSE 0 END;
    SELECT count(*) FROM row_values WHERE (a, b) = (1, 2);
    SELECT count(*) FROM row_values WHERE (a, b) IN ((1, 2));
    SELECT count(*) FROM row_values WHERE ROW(a, b) IN (SELECT 1, 2);
    SELECT count(*) FROM row_values WHERE (a, b) > (1, 2);
    SELECT CASE WHEN ROW(1, NULL) IS NOT NULL THEN 1 ELSE 0 END;
    SELECT CASE WHEN ROW(1, NULL) IS NULL THEN 1 ELSE 0 END;
    SELECT CASE WHEN (NULL, NULL) IS NULL THEN 1 ELSE 0 END;
    SELECT CASE WHEN (1, 2) IS NOT NULL THEN 1 ELSE 0 END;
    SELECT count(*) FROM row_values WHERE (a, b) IS NULL;
    SELECT count(*) FROM row_values WHERE (a, b) IS NOT NULL;
    SELECT count(*) FROM row_values WHERE NOT (a, b) IS NOT NULL;
    DROP TABLE row_values;
}
expect {
    1
    1
    1
    0
    1
    1
    1
    1
    1
    1
    0
    0
    1
    1
    0
    1
    1
}

@skip-if tursopg "the type of a row value is not known yet"
test row-constructor-between {
    CREATE TABLE row_between (a int, b int);
    INSERT INTO row_between VALUES (1, 2), (1, 5), (2, 0);
    SELECT CASE WHEN (1, 2) BETWEEN (0, 0) AND (5, 5) THEN 1 ELSE 0 END;
    SELECT CASE WHEN (1, 2) NOT BETWEEN (1, 3) AND (5, 5) THEN 1 ELSE 0 END;
    SELECT count(*) FROM row_between WHERE (a, b) BETWEEN (1, 1) AND (1, 3);
    DROP TABLE row_between;
}
expect {
    1
    1
    1
}

@skip-if tursopg "the type of a row value is not known yet"
test row-constructor-with-null-in-subquery {
    CREATE TABLE row_nulls (a int, b int);
    INSERT INTO row_nulls VALUES (NULL, 1), (1, NULL), (1, 2);
    SELECT count(*) FROM row_nulls WHERE (a, b) IN (SELECT 1, 2);
    SELECT count(*) FROM row_nulls WHERE (a, b) NOT IN (SELECT 1, 2);
    SELECT count(*) FROM row_nulls WHERE ((a, b) IN (SELECT 1, 2)) IS NULL;
    DROP TABLE row_nulls;
}
expect {
    1
    1
    1
}

