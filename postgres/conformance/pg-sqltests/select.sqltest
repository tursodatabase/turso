# A text in a row value compared with a time is read as a time, component by
# component, in a comparison, an IN list and a row subquery.
@skip-if tursopg "a cast from unknown to time is not supported yet"
test row-constructor-compares-text-with-time {
    CREATE TABLE row_time (id int, tm time);
    INSERT INTO row_time VALUES (1, '09:30'), (2, '10:00');
    SELECT 'eq', id FROM row_time WHERE (id, tm) = (2, '10:00') ORDER BY id;
    SELECT 'lt', id FROM row_time WHERE (tm, id) < ('10:00', 5) ORDER BY id;
    SELECT 'in', id FROM row_time WHERE (id, tm) IN ((1, '09:30'), (2, '09:30')) ORDER BY id;
    SELECT 'subquery', id FROM row_time WHERE (id, tm) = (SELECT 2, tm FROM row_time WHERE id = 2) ORDER BY id;
    DROP TABLE row_time;
}
expect {
    eq|2
    lt|1
    lt|2
    in|1
    subquery|2
}

