test comparison-with-a-column-of-a-table-that-does-not-exist-is-an-undefined-table {
    SELECT 1 FROM nosuch WHERE x = 1;
}
@sqlstate 42P01
expect error {
}

test function-of-unknown-type-over-a-column-that-does-not-exist-is-an-undefined-column {
    CREATE TABLE named_t (x int);
    SELECT mod(nosuch, 2) = 1 FROM named_t;
}
@sqlstate 42703
expect error {
}

test comparison-with-a-column-of-generate-series-is-typed {
    SELECT 1 FROM generate_series(1, 3) AS g WHERE g = 1;
}
expect {
    1
}

