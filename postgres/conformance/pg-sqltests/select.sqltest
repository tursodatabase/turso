    SELECT (SELECT b FROM scalar_u ORDER BY b LIMIT 1 + 0);
    SELECT (SELECT b FROM scalar_u ORDER BY b LIMIT 5 OFFSET 2);
    SELECT (SELECT max(b) FROM scalar_t);
    SELECT (SELECT DISTINCT a / 10 FROM scalar_t);
    SELECT a, (SELECT b FROM scalar_t t2 WHERE t2.a = scalar_t.a) FROM scalar_t ORDER BY a;
}
expect {
    30
    30
    5
    7
    30
    0
    1|30
    2|10
    3|20
}

