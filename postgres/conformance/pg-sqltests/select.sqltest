    N
}

@setup scalar_subquery
test scalar-subquery-with-several-rows-whose-value-is-not-read {
    SELECT CASE WHEN a = 99 THEN (SELECT b FROM scalar_u WHERE scalar_u.a = scalar_t.a) ELSE 0 END FROM scalar_t ORDER BY a;
    SELECT coalesce(1, (SELECT b FROM scalar_u));
    SELECT count(*) FROM (SELECT (SELECT b FROM scalar_u) FROM scalar_t WHERE false) s;
    SELECT count(*) FROM scalar_t WHERE a = 5 AND b = (SELECT b FROM scalar_u);
    SELECT CASE WHEN EXISTS (SELECT (SELECT b FROM scalar_u)) THEN 'yes' ELSE 'no' END;
}
expect {
    0
    0
    0
    1
    0
    0
    yes
}

