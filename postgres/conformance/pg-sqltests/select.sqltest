@skip-if tursopg "a cast from unknown to time is not supported yet"
test where-on-indexed-time-and-date-columns-converts-the-literal {
    CREATE TABLE seek_m(x time PRIMARY KEY);
    INSERT INTO seek_m VALUES ('12:00');
    CREATE TABLE seek_d(d date PRIMARY KEY);
    INSERT INTO seek_d VALUES ('2026-10-08');
    SELECT count(*) FROM seek_m WHERE x = '12:00';
    SELECT count(*) FROM seek_d WHERE d = '2026-10-08T00:00';
    DELETE FROM seek_m WHERE x = '12:00';
    SELECT count(*) FROM seek_m;
}
expect {
    1
    1
    0
}

@skip-if tursopg "a cast from unknown to time is not supported yet"
test where-in-on-indexed-columns-returns-a-row-once-for-two-spellings-of-its-value {
    CREATE TABLE in_spellings(id int, t time, tz timetz, ts timestamp, u uuid, b boolean);
    INSERT INTO in_spellings VALUES
        (1, '12:00:00', '12:00:00', '2024-01-01 00:00:00', 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', true),
        (2, '13:00:00', '13:00:00', '2024-01-02 00:00:00', 'b0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', false);
    CREATE INDEX in_spellings_t ON in_spellings (t);
    CREATE INDEX in_spellings_tz ON in_spellings (tz);
    CREATE INDEX in_spellings_ts ON in_spellings (ts);
    CREATE INDEX in_spellings_u ON in_spellings (u);
    CREATE INDEX in_spellings_b ON in_spellings (b);
    SELECT t FROM in_spellings WHERE t IN ('12:00:00', '12:00');
    SELECT count(*) FROM in_spellings WHERE tz IN ('12:00:00', '12:00');
    SELECT count(*) FROM in_spellings WHERE ts IN ('2024-01-01 00:00:00', '2024-01-01 00:00');
    SELECT count(*) FROM in_spellings WHERE u IN ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11');
    SELECT count(*) FROM in_spellings WHERE b IN ('t', 'true', 'yes');
    SELECT count(*) FROM in_spellings WHERE u = 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11' OR u = 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11';
    SELECT id FROM in_spellings WHERE t IN ('12:00:00', '12:00') OR u IN ('b0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', 'B0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11') ORDER BY id;
}
expect {
    12:00:00
    1
    1
    1
    1
    1
    1
    2
}

@skip-if tursopg "a cast from integer to numeric(10,2) is not supported yet"
test window-range-offset-over-bigint-and-numeric {
    CREATE TABLE range_offsets(b bigint, n numeric(10, 2));
    INSERT INTO range_offsets VALUES (1, 1), (2, 2.5), (4, 4);
    SELECT b, count(*) OVER (ORDER BY b RANGE BETWEEN 1 PRECEDING AND CURRENT ROW) FROM range_offsets ORDER BY b;
    SELECT n, count(*) OVER (ORDER BY n RANGE BETWEEN CURRENT ROW AND 1.5 FOLLOWING) FROM range_offsets ORDER BY n;
    DROP TABLE range_offsets;
}
expect {
    1|1
    2|2
    4|1
    1.00|2
    2.50|2
    4.00|1
}

test window-range-offset-over-date-is-an-error {
    CREATE TABLE range_dates(d date);
    SELECT count(*) OVER (ORDER BY d RANGE BETWEEN 1 PRECEDING AND CURRENT ROW) FROM range_dates;
}
expect error {
    RANGE with offset PRECEDING/FOLLOWING is not supported for column type date
}

test window-range-decimal-offset-over-bigint-is-an-error {
    CREATE TABLE range_bigints(b bigint);
    SELECT count(*) OVER (ORDER BY b RANGE BETWEEN 1.5 PRECEDING AND CURRENT ROW) FROM range_bigints;
}
expect error {
    RANGE with offset PRECEDING/FOLLOWING is not supported for column type bigint and offset type numeric
}

test window-range-string-and-bigint-offsets {
    CREATE TABLE range_strings(b bigint, i int4);
    INSERT INTO range_strings VALUES (1, 1), (2, 2), (4, 4);
    SELECT b, count(*) OVER (ORDER BY b RANGE BETWEEN '1' PRECEDING AND CURRENT ROW) FROM range_strings ORDER BY b;
    SELECT i, count(*) OVER (ORDER BY i RANGE BETWEEN 1::int8 PRECEDING AND CURRENT ROW) FROM range_strings ORDER BY i;
    DROP TABLE range_strings;
}
expect {
    1|1
    2|2
    4|1
    1|1
    2|2
    4|1
}

# A text compared with a time or timestamp takes the column's type first:
# '10:00' is the time 10:00:00. Every query runs before and after the indexes
# exist, so the expected rows are listed twice.
@skip-if tursopg "a cast from unknown to time is not supported yet"
test compare-time-with-text-same-rows-with-and-without-index {
    CREATE TABLE cmp_time (id int PRIMARY KEY, tm time, ts timestamp);
    INSERT INTO cmp_time VALUES (1, '09:30', '2024-01-05 09:30'), (2, '10:00', '2024-01-05 10:00'), (3, '23:59:59', '2024-01-06 00:00'), (4, NULL, NULL);
    SELECT 'eq', id FROM cmp_time WHERE tm = '10:00' ORDER BY id;
    SELECT 'ne', id FROM cmp_time WHERE tm <> '10:00' ORDER BY id;
    SELECT 'lt', id FROM cmp_time WHERE tm < '10:00' ORDER BY id;
    SELECT 'le', id FROM cmp_time WHERE tm <= '10:00' ORDER BY id;
    SELECT 'gt', id FROM cmp_time WHERE tm > '09:30' ORDER BY id;
    SELECT 'ge', id FROM cmp_time WHERE tm >= '10:00' ORDER BY id;
    SELECT 'between', id FROM cmp_time WHERE tm BETWEEN '09:30' AND '10:00' ORDER BY id;
    SELECT 'in', id FROM cmp_time WHERE tm IN ('09:30', '10:00') ORDER BY id;
    SELECT 'distinct', id FROM cmp_time WHERE tm IS DISTINCT FROM '10:00' ORDER BY id;
    SELECT 'not-distinct', id FROM cmp_time WHERE tm IS NOT DISTINCT FROM '10:00' ORDER BY id;
    SELECT 'case', id FROM cmp_time WHERE CASE tm WHEN '10:00' THEN 1 ELSE 0 END = 1 ORDER BY id;
    SELECT 'nullif', id FROM cmp_time WHERE nullif(tm, '10:00') IS NULL ORDER BY id;
    SELECT 'ts-lt', id FROM cmp_time WHERE ts < '2024-01-05T09:31' ORDER BY id;
    SELECT 'ts-eq', id FROM cmp_time WHERE ts = '2024-01-05 10:00' ORDER BY id;
    CREATE INDEX cmp_time_tm ON cmp_time (tm);
    CREATE INDEX cmp_time_ts ON cmp_time (ts);
    SELECT 'eq', id FROM cmp_time WHERE tm = '10:00' ORDER BY id;
    SELECT 'ne', id FROM cmp_time WHERE tm <> '10:00' ORDER BY id;
    SELECT 'lt', id FROM cmp_time WHERE tm < '10:00' ORDER BY id;
    SELECT 'le', id FROM cmp_time WHERE tm <= '10:00' ORDER BY id;
    SELECT 'gt', id FROM cmp_time WHERE tm > '09:30' ORDER BY id;
    SELECT 'ge', id FROM cmp_time WHERE tm >= '10:00' ORDER BY id;
    SELECT 'between', id FROM cmp_time WHERE tm BETWEEN '09:30' AND '10:00' ORDER BY id;
    SELECT 'in', id FROM cmp_time WHERE tm IN ('09:30', '10:00') ORDER BY id;
    SELECT 'distinct', id FROM cmp_time WHERE tm IS DISTINCT FROM '10:00' ORDER BY id;
    SELECT 'not-distinct', id FROM cmp_time WHERE tm IS NOT DISTINCT FROM '10:00' ORDER BY id;
    SELECT 'case', id FROM cmp_time WHERE CASE tm WHEN '10:00' THEN 1 ELSE 0 END = 1 ORDER BY id;
    SELECT 'nullif', id FROM cmp_time WHERE nullif(tm, '10:00') IS NULL ORDER BY id;
    SELECT 'ts-lt', id FROM cmp_time WHERE ts < '2024-01-05T09:31' ORDER BY id;
    SELECT 'ts-eq', id FROM cmp_time WHERE ts = '2024-01-05 10:00' ORDER BY id;
    DROP TABLE cmp_time;
}
expect {
    eq|2
    ne|1
    ne|3
    lt|1
    le|1
    le|2
    gt|2
    gt|3
    ge|2
    ge|3
    between|1
    between|2
    in|1
    in|2
    distinct|1
    distinct|3
    distinct|4
    not-distinct|2
    case|2
    nullif|2
    nullif|4
    ts-lt|1
    ts-eq|2
    eq|2
    ne|1
    ne|3
    lt|1
    le|1
    le|2
    gt|2
    gt|3
    ge|2
    ge|3
    between|1
    between|2
    in|1
    in|2
    distinct|1
    distinct|3
    distinct|4
    not-distinct|2
    case|2
    nullif|2
    nullif|4
    ts-lt|1
    ts-eq|2
}

# x IN (a, b) is x = a OR x = b, so a text on the left of IN is read as a time
# when it is compared with a time: '09:45' IN (tm) is '09:45:00' = tm. That
# holds for a list and a subquery, correlated or not.
@skip-if tursopg "a cast from unknown to time is not supported yet"
test compare-text-on-the-left-of-in-with-time {
    CREATE TABLE in_left_ev (id int PRIMARY KEY, tm time);
    INSERT INTO in_left_ev VALUES (1, '09:45:00'), (2, '10:00:00');
    SELECT 'list', id FROM in_left_ev WHERE '09:45' IN (tm) ORDER BY id;
    SELECT 'list-two', id FROM in_left_ev WHERE '09:45' IN (tm, '10:00') ORDER BY id;
    SELECT 'not-in', id FROM in_left_ev WHERE '09:45' NOT IN (tm) ORDER BY id;
    SELECT 'column', id, ('09:45' IN (tm))::int FROM in_left_ev ORDER BY id;
    SELECT 'subquery', id FROM in_left_ev WHERE '09:45' IN (SELECT tm FROM in_left_ev) ORDER BY id;
    SELECT 'correlated', id FROM in_left_ev WHERE '09:45' IN (SELECT e2.tm FROM in_left_ev e2 WHERE e2.id = in_left_ev.id) ORDER BY id;
    SELECT 'plain', ('a' IN ('a'))::int;
    CREATE INDEX in_left_ev_tm ON in_left_ev (tm);
    SELECT 'list-index', id FROM in_left_ev WHERE '09:45' IN (tm) ORDER BY id;
    SELECT 'subquery-index', id FROM in_left_ev WHERE '09:45' IN (SELECT tm FROM in_left_ev) ORDER BY id;
    DROP TABLE in_left_ev;
}
expect {
    list|1
    list-two|1
    not-in|2
    column|1|1
    column|2|0
    subquery|1
    subquery|2
    correlated|1
    plain|1
    list-index|1
    subquery-index|1
    subquery-index|2
}

# DELETE and UPDATE find their rows with the converted text, by a scan and
# through an index.
@skip-if tursopg "a cast from unknown to time is not supported yet"
test compare-time-with-text-delete-and-update {
    CREATE TABLE cmp_time_a (id int PRIMARY KEY, tm time);
    CREATE TABLE cmp_time_b (id int PRIMARY KEY, tm time);
    CREATE INDEX cmp_time_b_tm ON cmp_time_b (tm);
    INSERT INTO cmp_time_a VALUES (1, '09:30'), (2, '10:00'), (3, '23:59:59'), (4, NULL);
    INSERT INTO cmp_time_b SELECT * FROM cmp_time_a;
    DELETE FROM cmp_time_a WHERE tm < '09:45';
    DELETE FROM cmp_time_b WHERE tm < '09:45';
    UPDATE cmp_time_a SET id = 20 WHERE tm = '10:00';
    UPDATE cmp_time_b SET id = 20 WHERE tm = '10:00';
    SELECT 'a', id, tm FROM cmp_time_a ORDER BY id;
    SELECT 'b', id, tm FROM cmp_time_b ORDER BY id;
    DROP TABLE cmp_time_a;
    DROP TABLE cmp_time_b;
}
expect {
    a|3|23:59:59
    a|4|
    a|20|10:00:00
    b|3|23:59:59
    b|4|
    b|20|10:00:00
}

setup scalar_subquery {
    CREATE TABLE scalar_t (a int, b int);
    INSERT INTO scalar_t VALUES (1, 30), (2, 10), (3, 20);
    CREATE TABLE scalar_u (a int, b int);
    INSERT INTO scalar_u VALUES (1, 5), (1, 6), (2, 7);
}

@setup scalar_subquery
test scalar-subquery-with-several-rows-rejected {
    SELECT (SELECT b FROM scalar_t);
}
@sqlstate 21000
expect error {more than one row returned by a subquery used as an expression}

@setup scalar_subquery
test scalar-subquery-with-several-rows-read-from-index-rejected {
    CREATE INDEX ON scalar_t (b);
    SELECT (SELECT b FROM scalar_t);
}
@sqlstate 21000
expect error {more than one row returned by a subquery used as an expression}

