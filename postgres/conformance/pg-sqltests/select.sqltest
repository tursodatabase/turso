setup convert {
    CREATE TABLE conv (a integer, b text, d boolean, e bigint, ts timestamp);
    INSERT INTO conv VALUES (1, 'x', true, 10, NULL), (2, 'y', false, 20, NULL), (NULL, 'z', true, 30, NULL);
}

@setup convert
test convert-case-results-of-mixed-types-read-the-string-as-an-integer {
    SELECT CASE WHEN d THEN 1 ELSE 'x' END FROM conv;
}
@sqlstate 22P02
expect error {
    invalid input syntax for type integer: "x"
}

@setup convert
test convert-case-results-read-a-string-as-an-integer {
    SELECT CASE WHEN d THEN a ELSE '5' END FROM conv WHERE a IS NOT NULL ORDER BY b;
}
expect {
    1
    5
}

@setup convert
test convert-case-results-that-do-not-match {
    SELECT CASE WHEN d THEN a ELSE b END FROM conv;
}
@sqlstate 42804
expect error {
    CASE types text and integer cannot be matched
}

@setup convert
test convert-case-with-a-base-expression-reads-strings-as-the-base-type {
    SELECT CASE a WHEN 1 THEN 'one' WHEN '2' THEN 'two' ELSE 'many' END FROM conv ORDER BY b;
}
expect {
    one
    two
    many
}

@setup convert
test convert-coalesce-reads-a-string-as-an-integer {
    SELECT COALESCE(a, '0') FROM conv ORDER BY b;
}
expect {
    1
    2
    0
}

@setup convert
test convert-coalesce-of-types-that-do-not-match {
    SELECT COALESCE(a, b) FROM conv;
}
@sqlstate 42804
expect error {
    COALESCE types integer and text cannot be matched
}

@setup convert
test convert-greatest-of-integer-and-bigint {
    SELECT GREATEST(a, e), LEAST(a, e) FROM conv WHERE a IS NOT NULL ORDER BY b;
}
expect {
    10|1
    20|2
}

@setup convert
test convert-greatest-of-types-that-do-not-match {
    SELECT GREATEST(a, b) FROM conv;
}
@sqlstate 42804
expect error {
    GREATEST types integer and text cannot be matched
}

@setup convert
test convert-least-of-types-that-do-not-match {
    SELECT LEAST(a, b) FROM conv;
}
@sqlstate 42804
expect error {
    LEAST types integer and text cannot be matched
}

@skip-if postgres "PostgreSQL reads the string as a timestamp; tursopg rejects a cast from unknown to timestamp"
@setup convert
test convert-coalesce-reads-a-string-as-a-timestamp-is-not-supported {
    SELECT COALESCE(ts, '2024-01-01') FROM conv;
}
@sqlstate 0A000
expect error {
    a cast from unknown to timestamp is not supported
}

@skip-if tursopg "UNION does not convert its operands yet"
test convert-union-reads-a-string-as-an-integer {
    SELECT 1 UNION SELECT 'a';
}
@sqlstate 22P02
expect error {
    invalid input syntax for type integer: "a"
}

@setup convert
test convert-union-of-types-that-do-not-match {
    SELECT a FROM conv UNION SELECT b FROM conv;
}
@sqlstate 42804
expect error {
    UNION types integer and text cannot be matched
}

@setup convert
test convert-intersect-and-except-of-types-that-do-not-match {
    SELECT a FROM conv EXCEPT SELECT b FROM conv;
}
@sqlstate 42804
expect error {
    EXCEPT types integer and text cannot be matched
}

