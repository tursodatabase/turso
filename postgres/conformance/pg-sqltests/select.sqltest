}

test convert-timestamptz-column-compares-with-now {
    CREATE TABLE stamped (t timestamptz);
    INSERT INTO stamped VALUES (now());
    SELECT count(*) FROM stamped WHERE t <= now();
    SELECT count(*) FROM stamped WHERE now() >= t;
}
expect {
    1
    1
}

