test varchar-value-to-integer-explicit {
    CREATE TABLE zz_tv (v varchar(10));
    INSERT INTO zz_tv VALUES ('12'), (' 0x10 ');
    SELECT v::int4, v::int8 FROM zz_tv ORDER BY 1;
}
expect {
    12|12
    16|16
}

test text-value-to-integer-needs-an-explicit-cast-in-an-assignment {
    CREATE TABLE zz_ta (a int);
    CREATE TABLE zz_tb2 (s text);
    INSERT INTO zz_ta SELECT s FROM zz_tb2;
}
@sqlstate 42804
expect error {
    column "a" is of type integer but expression is of type text
}

test text-value-plus-integer-does-not-exist {
    CREATE TABLE zz_tc (s text);
    SELECT s + 1 FROM zz_tc;
}
@sqlstate 42883
expect error {
    operator does not exist: text \+ integer
}

test text-value-compared-with-integer-does-not-exist {
    CREATE TABLE zz_td (s text);
    SELECT s = 1 FROM zz_td;
}
@sqlstate 42883
expect error {
    operator does not exist: text = integer
}

@skip-if tursopg "a cast from text to double precision is not supported yet"
test text-value-to-float-is-not-supported-yet {
    CREATE TABLE zz_tg (s text);
    INSERT INTO zz_tg VALUES ('1.5');
    SELECT (s::float8 * 2)::int FROM zz_tg;
}
expect {
    3
}

@skip-if tursopg "a cast from text to numeric is not supported yet"
test text-value-to-numeric-is-not-supported-yet {
    CREATE TABLE zz_th (s text);
    INSERT INTO zz_th VALUES ('1.5');
    SELECT (s::numeric * 2)::int FROM zz_th;
}
expect {
    3
}

@skip-if tursopg "a cast from text to boolean is not supported yet"
test text-value-to-boolean-is-not-supported-yet {
    CREATE TABLE zz_ti2 (s text);
    INSERT INTO zz_ti2 VALUES ('true');
    SELECT s::boolean::int FROM zz_ti2;
}
expect {
    1
}
