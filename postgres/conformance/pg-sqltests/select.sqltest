}

test text-literal-to-integer-reads-every-input-postgresql-accepts {
    SELECT '42'::int4, ' 42 '::int4, '+7'::int4, '-7'::int4, '0'::int4, '007'::int4, '2147483647'::int4, '-2147483648'::int4, '0x1F'::int4, '0X1f'::int4, '0o17'::int4, '0b101'::int4, '1_000'::int4, '0x1_F'::int4, '-0x10'::int4, '  +0b1_1  '::int4;
}
expect {
    42|42|7|-7|0|7|2147483647|-2147483648|31|31|15|5|1000|31|-16|3
}

test text-value-to-integer-reads-every-input-postgresql-accepts {
    CREATE TABLE zz_ti (id int, s text);
    INSERT INTO zz_ti VALUES (0, '42'), (1, ' 42 '), (2, '+7'), (3, '-7'), (4, '0'), (5, '007'), (6, '2147483647'), (7, '-2147483648'), (8, '0x1F'), (9, '0X1f'), (10, '0o17'), (11, '0b101'), (12, '1_000'), (13, '0x1_F'), (14, '-0x10'), (15, '  +0b1_1  ');
    SELECT s::int4 FROM zz_ti ORDER BY id;
}
expect {
    42
    42
    7
    -7
    0
    7
    2147483647
    -2147483648
    31
    31
    15
    5
    1000
    31
    -16
    3
}

test text-value-to-bigint-reads-every-input-postgresql-accepts {
    CREATE TABLE zz_tb (id int, s text);
    INSERT INTO zz_tb VALUES (0, '42'), (1, ' 42 '), (2, '+7'), (3, '-7'), (4, '0'), (5, '007'), (6, '2147483647'), (7, '-2147483648'), (8, '0x1F'), (9, '0X1f'), (10, '0o17'), (11, '0b101'), (12, '1_000'), (13, '0x1_F'), (14, '-0x10'), (15, '  +0b1_1  '), (99, '9223372036854775807'), (100, '-9223372036854775808'), (101, '0x7FFFFFFFFFFFFFFF');
    SELECT s::int8 FROM zz_tb ORDER BY id;
}
expect {
    42
    42
    7
    -7
    0
    7
    2147483647
    -2147483648
    31
    31
    15
    5
    1000
    31
    -16
    3
    9223372036854775807
    -9223372036854775808
    9223372036854775807
}

test text-literal-to-bigint-reads-the-same-inputs {
    SELECT '42'::int8, ' 42 '::int8, '+7'::int8, '-7'::int8, '0'::int8, '007'::int8, '2147483647'::int8, '-2147483648'::int8, '0x1F'::int8, '0X1f'::int8, '0o17'::int8, '0b101'::int8, '1_000'::int8, '0x1_F'::int8, '-0x10'::int8, '  +0b1_1  '::int8, '9223372036854775807'::int8, '-9223372036854775808'::int8, '0x7FFFFFFFFFFFFFFF'::int8;
}
expect {
    42|42|7|-7|0|7|2147483647|-2147483648|31|31|15|5|1000|31|-16|3|9223372036854775807|-9223372036854775808|9223372036854775807
}

test text-value-with-whitespace-characters-to-integer {
    CREATE TABLE zz_tw (s text);
    INSERT INTO zz_tw VALUES (E'\t42\n'), (E'\r\f\v7 ');
    SELECT s::int4 FROM zz_tw ORDER BY 1;
}
expect {
    7
    42
}

test text-null-to-integer-is-null {
    CREATE TABLE zz_tn (s text);
    INSERT INTO zz_tn VALUES (NULL);
    SELECT s::int4, s::int8, NULL::text::int4 FROM zz_tn;
}
expect {
    ||
}

