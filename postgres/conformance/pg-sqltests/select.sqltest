    CREATE INDEX ON scalar_t (b);
    SELECT 1 WHERE 10 = (SELECT b FROM scalar_t);
}
@sqlstate 21000
expect error {more than one row returned by a subquery used as an expression}

@setup scalar_subquery
test scalar-subquery-with-limit-of-two-rejected {
    SELECT (SELECT b FROM scalar_t LIMIT 2);
}
@sqlstate 21000
expect error {more than one row returned by a subquery used as an expression}

@setup scalar_subquery
test scalar-subquery-with-limit-above-two-stops-at-second-row {
    SELECT (SELECT 1 / (b - 7) FROM scalar_u LIMIT 5);
}
@sqlstate 21000
expect error {more than one row returned by a subquery used as an expression}

@setup scalar_subquery
test scalar-subquery-with-computed-limit-stops-at-second-row {
    SELECT (SELECT 1 / (b - 7) FROM scalar_u LIMIT 2 + 3);
}
@sqlstate 21000
expect error {more than one row returned by a subquery used as an expression}

@setup scalar_subquery
test scalar-subquery-with-limit-all-stops-at-second-row {
    SELECT (SELECT 1 / (b - 7) FROM scalar_u LIMIT ALL);
}
@sqlstate 21000
expect error {more than one row returned by a subquery used as an expression}

@setup scalar_subquery
test scalar-subquery-with-several-sorted-rows-rejected {
    SELECT (SELECT b FROM scalar_t ORDER BY b);
}
@sqlstate 21000
expect error {more than one row returned by a subquery used as an expression}

@setup scalar_subquery
