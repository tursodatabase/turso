test auth-uid-of-claims-with-a-nul-escape-in-a-replaced-object-errors {
    SELECT set_config('request.jwt.claims', '{"o": {"k": ["\u0000"]}, "o": null, "sub": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"}', false);
