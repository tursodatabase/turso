    SELECT coalesce(auth.uid()::text, '<null>'), coalesce(auth.email(), '<null>');
}
expect {
    {"role": "anon"}
    <null>|<null>
}

@setup auth_functions
test auth-functions-of-claims-that-are-not-an-object-return-null {
    SELECT set_config('request.jwt.claims', '[1, 2]', false);
    SELECT coalesce(auth.uid()::text, '<null>'), coalesce(auth.email(), '<null>'), auth.jwt();
}
expect {
    [1, 2]
    <null>|<null>|[1, 2]
}

@setup auth_functions
test auth-functions-of-claims-that-are-a-scalar-return-null {
    SELECT set_config('request.jwt.claims', '"a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"', false);
    SELECT coalesce(auth.uid()::text, '<null>'), coalesce(auth.email(), '<null>'), auth.jwt();
    SELECT set_config('request.jwt.claims', 'null', false);
    SELECT coalesce(auth.uid()::text, '<null>'), coalesce(auth.email(), '<null>'), auth.jwt();
}
expect {
    "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"
    <null>|<null>|"a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"
    null
    <null>|<null>|null
}

@setup auth_functions
test auth-email-of-claims-that-are-not-text {
    SELECT set_config('request.jwt.claims', '{"email": 123}', false);
    SELECT auth.email();
    SELECT set_config('request.jwt.claims', '{"email": true}', false);
    SELECT auth.email();
}
expect {
    {"email": 123}
    123
    {"email": true}
    true
}

@setup auth_functions
test auth-email-of-claims-that-are-objects-or-arrays-prints-them-as-jsonb {
    SELECT set_config('request.jwt.claims', '{"email": {"b": 1, "a": [1, "x", null]}}', false);
    SELECT auth.email();
}
expect {
    {"email": {"b": 1, "a": [1, "x", null]}}
    {"a": [1, "x", null], "b": 1}
}
expect @tursopg {
    {"email": {"b": 1, "a": [1, "x", null]}}
    {"a":[1,"x",null],"b":1}
}

@setup auth_functions
test auth-email-of-claims-that-are-numbers-prints-them-as-jsonb {
    SELECT set_config('request.jwt.claims', '{"email": 1.50}', false);
    SELECT auth.email();
    SELECT set_config('request.jwt.claims', '{"email": 1e2}', false);
    SELECT auth.email();
    SELECT set_config('request.jwt.claims', '{"email": 100000000000000000000}', false);
    SELECT auth.email();
}
expect {
    {"email": 1.50}
    1.50
    {"email": 1e2}
    100
    {"email": 100000000000000000000}
    100000000000000000000
}
expect @tursopg {
    {"email": 1.50}
    1.5
    {"email": 1e2}
    100.0
    {"email": 100000000000000000000}
    1e20
}

@setup auth_functions
test auth-jwt-prints-numbers-as-jsonb {
    SELECT set_config('request.jwt.claims', '[-0, -0.0, 0e-5, 1.5e-3, 1.2345e2, -1e-5, 10e-1, 1E+2, 0.0001e4]', false);
    SELECT auth.jwt();
}
expect {
    [-0, -0.0, 0e-5, 1.5e-3, 1.2345e2, -1e-5, 10e-1, 1E+2, 0.0001e4]
    [0, 0.0, 0.00000, 0.0015, 123.45, -0.00001, 1.0, 100, 1]
}
expect @tursopg {
    [-0, -0.0, 0e-5, 1.5e-3, 1.2345e2, -1e-5, 10e-1, 1E+2, 0.0001e4]
    [-0, -0.0, 0e-5, 1.5e-3, 1.2345e2, -1e-5, 10e-1, 1E+2, 0.0001e4]
}

@setup auth_functions
test auth-email-uses-the-last-of-two-claims-with-the-same-name {
    SELECT set_config('request.jwt.claims', '{"email": "first@example.com", "email": "last@example.com"}', false);
    SELECT auth.email();
}
expect {
    {"email": "first@example.com", "email": "last@example.com"}
    last@example.com
}

@setup auth_functions
test auth-email-decodes-escapes {
    SELECT set_config('request.jwt.claims', '{"email": "caf\u00e9 \"q\" \/"}', false);
    SELECT auth.email();
}
expect {
    {"email": "caf\u00e9 \"q\" \/"}
    café "q" /
}

@setup auth_functions
test auth-email-decodes-a-surrogate-pair {
    SELECT set_config('request.jwt.claims', '{"email": "\ud83d\ude00@example.com"}', false);
    SELECT auth.email();
}
expect {
    {"email": "\ud83d\ude00@example.com"}
    😀@example.com
}

@setup auth_functions
test auth-email-claim-name-is-case-sensitive {
    SELECT set_config('request.jwt.claims', '{"Email": "user@example.com"}', false);
    SELECT coalesce(auth.email(), '<null>');
}
expect {
    {"Email": "user@example.com"}
    <null>
}

@setup auth_functions
test auth-email-ignores-white-space-in-claims {
    SELECT quote_literal(set_config('request.jwt.claims', '  {"email" : "user@example.com"}  ', false));
    SELECT auth.email();
}
expect {
    '  {"email" : "user@example.com"}  '
    user@example.com
}

@setup auth_functions
test auth-email-of-claims-that-are-not-json-errors {
    SELECT set_config('request.jwt.claims', 'not json', false);
    SELECT auth.email();
}
@sqlstate 22P02
expect error {
    invalid input syntax for type json
}

