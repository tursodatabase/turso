}

@setup auth_functions
test auth-email-of-claims-with-an-exponent-too-large-for-numeric-errors {
    SELECT set_config('request.jwt.claims', '{"n": 0e1073741824, "email": "user@example.com"}', false);
    SELECT auth.email();
}
@sqlstate 22003
expect error {
    value overflows numeric format
}
expect @tursopg {
    {"n": 0e1073741824, "email": "user@example.com"}
    user@example.com
}

@setup auth_functions
test auth-email-checks-the-token-after-a-number-before-the-size-of-the-number {
    SELECT set_config('request.jwt.claims', '{"n": 1e131072 "\u0000", "email": "user@example.com"}', false);
    SELECT auth.email();
}
@sqlstate 22P05
expect error {
    unsupported Unicode escape sequence
}
@sqlstate 22P02
expect @tursopg error {
    invalid input syntax for type json
}

@setup auth_functions
test auth-email-of-claims-nested-200-levels-deep {
    SELECT set_config('request.jwt.claims', '{"x": {{repeat:200:[}}{{repeat:200:]}}, "email": "user@example.com"}', false);
    SELECT auth.email();
}
expect {
    {"x": {{repeat:200:[}}{{repeat:200:]}}, "email": "user@example.com"}
    user@example.com
}
@sqlstate 22P02
expect @tursopg error {
    invalid input syntax for type json
}

@setup auth_functions
test auth-functions-of-claims-nested-5000-levels-deep {
    SELECT length(set_config('request.jwt.claims', '{"x": {{repeat:5000:[}}{{repeat:5000:]}}, "email": "user@example.com"}', false));
    SELECT auth.email(), length(auth.jwt()::text);
}
expect {
    10036
    user@example.com|10036
}
@sqlstate 22P02
expect @tursopg error {
    invalid input syntax for type json
}

@setup auth_functions
test auth-functions-do-not-read-the-claims-when-the-claim-settings-are-set {
    SELECT set_config('request.jwt.claims', 'not json', false);
    SELECT set_config('request.jwt.claim.sub', 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', false);
    SELECT set_config('request.jwt.claim.email', 'user@example.com', false);
    SELECT set_config('request.jwt.claim', '{"role": "authenticated"}', false);
    SELECT auth.uid(), auth.email(), auth.jwt();
}
expect {
    not json
    a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
    user@example.com
    {"role": "authenticated"}
    a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11|user@example.com|{"role": "authenticated"}
}

@setup auth_functions
test auth-functions-read-claims-that-are-set-earlier-in-the-same-select {
    SELECT set_config('request.jwt.claims', '{"sub": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11", "email": "user@example.com"}', false), auth.uid(), auth.email(), auth.jwt() ->> 'email';
}
expect {
    {"sub": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11", "email": "user@example.com"}|a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11|user@example.com|user@example.com
}

@setup auth_functions
test auth-uid-reads-claims-that-are-set-for-the-transaction {
    BEGIN;
    SELECT set_config('request.jwt.claims', '{"sub": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"}', true);
    SELECT auth.uid();
    COMMIT;
    SELECT coalesce(auth.uid()::text, '<null>');
}
expect {
    {"sub": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"}
    a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
    <null>
}

@setup auth_functions
test auth-uid-forgets-claims-that-are-rolled-back {
    SELECT set_config('request.jwt.claim.sub', '11111111-1111-1111-1111-111111111111', false);
    BEGIN;
    SELECT set_config('request.jwt.claim.sub', '22222222-2222-2222-2222-222222222222', false);
    SELECT auth.uid();
    ROLLBACK;
    SELECT auth.uid();
}
expect {
    11111111-1111-1111-1111-111111111111
    22222222-2222-2222-2222-222222222222
    22222222-2222-2222-2222-222222222222
    11111111-1111-1111-1111-111111111111
}

@setup auth_functions
test auth-uid-finds-the-rows-of-the-user {
    CREATE TABLE todos (id int, user_id uuid, task text);
    INSERT INTO todos VALUES (1, 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', 'mine'), (2, '11111111-1111-1111-1111-111111111111', 'theirs');
    SELECT set_config('request.jwt.claim.sub', 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11', false);
    SELECT task FROM todos WHERE user_id = auth.uid();
    SELECT task FROM todos WHERE user_id = (SELECT auth.uid());
}
expect {
    A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11
    mine
    mine
}

@setup auth_functions
test auth-uid-finds-the-rows-of-the-user-through-an-index {
    CREATE TABLE todos (id int, user_id uuid, task text);
    CREATE INDEX todos_user_id ON todos (user_id);
    INSERT INTO todos VALUES (1, '{A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11}', 'mine'), (2, '11111111-1111-1111-1111-111111111111', 'theirs');
    SELECT set_config('request.jwt.claims', '{"sub": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"}', false);
    SELECT task FROM todos WHERE user_id = auth.uid();
    SELECT task FROM todos WHERE auth.uid() = user_id;
}
expect {
    {"sub": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"}
    mine
    mine
}

@setup auth_functions
test auth-uid-in-a-column-default {
    SELECT set_config('request.jwt.claim.sub', 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', false);
    CREATE TABLE notes (owner uuid DEFAULT auth.uid(), body text);
    INSERT INTO notes (body) VALUES ('hello');
    SELECT owner, body FROM notes;
}
expect {
    a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
    a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11|hello
}

@setup auth_functions
test auth-uid-in-a-view {
    CREATE TABLE todos (user_id uuid, task text);
    INSERT INTO todos VALUES ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', 'mine'), ('11111111-1111-1111-1111-111111111111', 'theirs');
    CREATE VIEW my_todos AS SELECT task FROM todos WHERE user_id = auth.uid();
    SELECT set_config('request.jwt.claim.sub', '11111111-1111-1111-1111-111111111111', false);
    SELECT task FROM my_todos;
}
expect {
    11111111-1111-1111-1111-111111111111
    theirs
}

@setup auth_functions
test auth-uid-finds-the-user-in-a-table-of-the-auth-schema {
    CREATE SCHEMA IF NOT EXISTS auth;
    DROP TABLE IF EXISTS auth.users;
    CREATE TABLE auth.users (id uuid, email text);
    INSERT INTO auth.users VALUES ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', 'user@example.com'), ('11111111-1111-1111-1111-111111111111', 'other@example.com');
    SELECT set_config('request.jwt.claims', '{"sub": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"}', false);
    SELECT email FROM auth.users WHERE id = auth.uid();
}
expect {
    {"sub": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"}
    user@example.com
}

# tursopg refuses a function that is not deterministic, such as random(), in
# CREATE INDEX with the SQLSTATE 42601, not 42P17. So the tursopg blocks of
# the next two tests have no SQLSTATE.
@setup auth_functions
test auth-uid-in-an-index-expression-errors {
    CREATE TABLE notes (owner uuid);
    CREATE INDEX notes_owner ON notes ((auth.uid()));
}
@sqlstate 42P17
expect error {
    index
}
expect @tursopg error {
    index
}

@setup auth_functions
test auth-uid-in-a-partial-index-predicate-errors {
    CREATE TABLE notes (owner uuid);
    CREATE INDEX notes_owner ON notes (owner) WHERE owner = auth.uid();
}
@sqlstate 42P17
expect error {
    index
}
expect @tursopg error {
    index
}

