test auth-jwt-of-request-jwt-claim-that-is-not-json-errors {
    SELECT set_config('request.jwt.claims', '{"role": "authenticated"}', false);
    SELECT set_config('request.jwt.claim', 'not json', false);
    SELECT auth.jwt();
}
expect error {
    invalid input syntax for type json
}

