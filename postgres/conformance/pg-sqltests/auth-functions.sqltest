@setup auth_functions
test auth-functions-of-null-claims-return-null {
    SELECT set_config('request.jwt.claims', '{"sub": null, "email": null}', false);
    SELECT coalesce(auth.uid()::text, '<null>'), coalesce(auth.email(), '<null>');
}
expect {
    {"sub": null, "email": null}
    <null>|<null>
}

@setup auth_functions
test auth-functions-of-missing-claims-return-null {
    SELECT set_config('request.jwt.claims', '{"role": "anon"}', false);
    SELECT coalesce(auth.uid()::text, '<null>'), coalesce(auth.email(), '<null>');
}
expect {
    {"role": "anon"}
    <null>|<null>
}

@setup auth_functions
test auth-functions-of-claims-that-are-not-an-object-return-null {
    SELECT set_config('request.jwt.claims', '[1, 2]', false);
    SELECT coalesce(auth.uid()::text, '<null>'), coalesce(auth.email(), '<null>'), auth.jwt();
}
expect {
    [1, 2]
    <null>|<null>|[1, 2]
}

@setup auth_functions
test auth-functions-of-claims-that-are-a-scalar-return-null {
    SELECT set_config('request.jwt.claims', '"a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"', false);
    SELECT coalesce(auth.uid()::text, '<null>'), coalesce(auth.email(), '<null>'), auth.jwt();
    SELECT set_config('request.jwt.claims', 'null', false);
    SELECT coalesce(auth.uid()::text, '<null>'), coalesce(auth.email(), '<null>'), auth.jwt();
}
expect {
    "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"
    <null>|<null>|"a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"
    null
    <null>|<null>|null
}

@setup auth_functions
test auth-email-of-claims-that-are-not-text {
    SELECT set_config('request.jwt.claims', '{"email": 123}', false);
    SELECT auth.email();
    SELECT set_config('request.jwt.claims', '{"email": true}', false);
    SELECT auth.email();
}
expect {
    {"email": 123}
    123
    {"email": true}
    true
}

@setup auth_functions
test auth-email-uses-the-last-of-two-claims-with-the-same-name {
    SELECT set_config('request.jwt.claims', '{"email": "first@example.com", "email": "last@example.com"}', false);
    SELECT auth.email();
}
expect {
    {"email": "first@example.com", "email": "last@example.com"}
    last@example.com
}

@setup auth_functions
test auth-email-decodes-escapes {
    SELECT set_config('request.jwt.claims', '{"email": "caf\u00e9 \"q\" \/"}', false);
    SELECT auth.email();
}
expect {
    {"email": "caf\u00e9 \"q\" \/"}
    café "q" /
}

@setup auth_functions
test auth-email-claim-name-is-case-sensitive {
    SELECT set_config('request.jwt.claims', '{"Email": "user@example.com"}', false);
    SELECT coalesce(auth.email(), '<null>');
}
expect {
    {"Email": "user@example.com"}
    <null>
}

@setup auth_functions
test auth-email-ignores-white-space-in-claims {
    SELECT quote_literal(set_config('request.jwt.claims', '  {"email" : "user@example.com"}  ', false));
    SELECT auth.email();
}
expect {
    '  {"email" : "user@example.com"}  '
    user@example.com
}

