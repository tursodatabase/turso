@setup auth_functions
test auth-functions-of-null-claims-return-null {
    SELECT set_config('request.jwt.claims', '{"sub": null, "email": null}', false);
    SELECT coalesce(auth.uid()::text, '<null>'), coalesce(auth.email(), '<null>');
}
expect {
    {"sub": null, "email": null}
    <null>|<null>
}

@setup auth_functions
test auth-functions-of-missing-claims-return-null {
