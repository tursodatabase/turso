    a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
}
@sqlstate 22P02
expect @tursopg error {
    invalid input syntax for type uuid: ".a0eebc999c0b4ef8bb6d6bb9bd380a11."
}

@setup auth_functions
test auth-uid-of-a-urn {
