@setup auth_functions
test auth-jwt-prints-the-claims-as-jsonb {
    SELECT set_config('request.jwt.claims', '{"sub":"a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11","email":"user@example.com","aud":"authenticated","n":1.50,"n":1e2}', false);
    SELECT auth.jwt();
}
expect {
    {"sub":"a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11","email":"user@example.com","aud":"authenticated","n":1.50,"n":1e2}
    {"n": 100, "aud": "authenticated", "sub": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11", "email": "user@example.com"}
}
expect @tursopg {
    {"sub":"a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11","email":"user@example.com","aud":"authenticated","n":1.50,"n":1e2}
    {"sub":"a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11","email":"user@example.com","aud":"authenticated","n":1.50,"n":1e2}
}

@setup auth_functions
test auth-jwt-prints-escapes-as-jsonb {
    SELECT set_config('request.jwt.claims', '{"a": "x\ny\u0001\"\/\u00e9\t"}', false);
    SELECT auth.jwt();
}
expect {
    {"a": "x\ny\u0001\"\/\u00e9\t"}
    {"a": "x\ny\u0001\"/é\t"}
}
expect @tursopg {
    {"a": "x\ny\u0001\"\/\u00e9\t"}
    {"a": "x\ny\u0001\"\/\u00e9\t"}
}

# A CHECK constraint compares a uuid column as it is stored, so auth.uid(),
# which is declared to return uuid, is put in the same stored form first.
@setup auth_functions
test auth-uid-in-a-check-constraint-on-a-uuid-column {
    SELECT set_config('request.jwt.claim.sub', 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', false);
    CREATE TABLE owned (owner uuid CHECK (owner = auth.uid()));
    INSERT INTO owned VALUES ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11');
    SELECT owner FROM owned;
}
expect {
    a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
    a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
}

@setup auth_functions
test auth-uid-check-constraint-rejects-another-uuid {
    SELECT set_config('request.jwt.claim.sub', 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', false);
    CREATE TABLE owned (owner uuid CHECK (owner = auth.uid()));
    INSERT INTO owned VALUES ('b0eebc99-9c0b-4ef8-bb6d-6bb9bd380a22');
}
@sqlstate 23514
expect error {
    check constraint
}

@setup auth_functions
test auth-uid-check-constraint-accepts-null {
    SELECT set_config('request.jwt.claim.sub', 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', false);
    CREATE TABLE owned (owner uuid CHECK (owner = auth.uid()));
    INSERT INTO owned VALUES (NULL);
    SELECT count(*) FROM owned WHERE owner IS NULL;
}
expect {
    a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
    1
}

# Same for UPDATE: the CHECK runs again on the new row.
@setup auth_functions
test auth-uid-check-constraint-runs-on-update {
    SELECT set_config('request.jwt.claim.sub', 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', false);
    CREATE TABLE owned (owner uuid CHECK (owner = auth.uid()));
    INSERT INTO owned VALUES ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11');
    UPDATE owned SET owner = 'b0eebc99-9c0b-4ef8-bb6d-6bb9bd380a22';
}
@sqlstate 23514
expect error {
    check constraint
}

@setup auth_functions
test auth-uid-finds-the-rows-of-a-uuid-column {
    SELECT set_config('request.jwt.claim.sub', 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', false);
    CREATE TABLE owned (id int, owner uuid);
    INSERT INTO owned VALUES (1, 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11');
    INSERT INTO owned VALUES (2, 'b0eebc99-9c0b-4ef8-bb6d-6bb9bd380a22');
    SELECT id FROM owned WHERE owner = auth.uid();
    CREATE INDEX owned_owner ON owned (owner);
    SELECT id FROM owned WHERE owner = auth.uid();
}
expect {
    a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
    1
    1
}

# A CAST of auth.uid() to text compares text with text, so the CHECK constraint
# is accepted and holds.
@setup auth_functions
test auth-uid-cast-to-text-in-a-check-constraint-on-a-text-column {
    SELECT set_config('request.jwt.claim.sub', 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', false);
    CREATE TABLE owned (owner text CHECK (owner = auth.uid()::text));
    INSERT INTO owned VALUES ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11');
    SELECT owner FROM owned;
}
expect {
    a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
    a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
}

# auth.uid() IS NOT NULL compares no uuid values, so it is accepted.
@setup auth_functions
test auth-uid-is-not-null-in-a-check-constraint {
    SELECT set_config('request.jwt.claim.sub', 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', false);
    CREATE TABLE notes (body text CHECK (auth.uid() IS NOT NULL));
    INSERT INTO notes VALUES ('hello');
    SELECT body FROM notes;
}
expect {
    a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
    hello
}
