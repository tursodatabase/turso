    auth\.no_such_function
}

@setup auth_functions
test auth-uid-with-an-argument-errors {
    SELECT auth.uid(1);
}
@sqlstate 42883
expect error {
    auth\.uid
}

@setup auth_functions
test auth-functions-can-be-called-with-quoted-lowercase-names {
    SELECT set_config('request.jwt.claim.sub', 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', false);
    SELECT "auth"."uid"(), coalesce(auth."email"(), '<null>');
}
