@setup auth_functions
test auth-email-of-an-escaped-backslash-before-u0000-is-not-a-nul-escape {
    SELECT length(set_config('request.jwt.claims', '{"email": "a\\\\u0000"}', false));
    SELECT auth.email();
}
expect {
    21
    a\u0000
}

