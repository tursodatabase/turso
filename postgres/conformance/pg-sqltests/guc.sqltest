# Session configuration parameters (GUCs): SET / SHOW / RESET round-trips.
# Expectations avoid environment-dependent defaults (TimeZone, DateStyle
# can vary with initdb settings on real PostgreSQL); they assert values the
# session itself set, and the errors PostgreSQL raises for unknown names.

@database :memory:

test guc-set-show-roundtrip {
    SET extra_float_digits = 2;
    SHOW extra_float_digits;
}
expect {
    2
}

test guc-set-show-string {
    SET datestyle = 'ISO, YMD';
    SHOW datestyle;
}
expect {
    ISO, YMD
}

test guc-set-multi-part-value {
    SET datestyle = ISO, YMD;
    SHOW datestyle;
}
expect {
    ISO, YMD
}

test guc-reset-restores-default {
    SET extra_float_digits = 3;
    RESET extra_float_digits;
    SET extra_float_digits = 2;
    SHOW extra_float_digits;
}
expect {
    2
}

test guc-set-to-default-acts-like-reset {
    SET extra_float_digits = 3;
    SET extra_float_digits TO DEFAULT;
    SET extra_float_digits = 2;
    SHOW extra_float_digits;
}
expect {
    2
}

test guc-custom-dotted-parameter {
    SET myapp.tenant = 'acme';
    SHOW myapp.tenant;
}
expect {
    acme
}

test guc-show-unknown-parameter-errors {
    SHOW no_such_parameter;
}
expect error {
    ^unrecognized configuration parameter "no_such_parameter"$
}

test guc-boolean-value-displays-as-on {
    SET standard_conforming_strings = true;
    SHOW standard_conforming_strings;
}
expect {
    on
}

test guc-current-setting-reads-session-value {
    SET extra_float_digits = 2;
    SELECT current_setting('extra_float_digits');
}
expect {
    2
}

test guc-current-setting-reads-default {
    SELECT current_setting('standard_conforming_strings');
}
expect {
    on
}

test guc-current-setting-unknown-errors {
    SELECT current_setting('no_such_parameter');
}
expect error {
    ^unrecognized configuration parameter "no_such_parameter"$
}

test guc-current-setting-missing-ok-returns-null {
    SELECT coalesce(current_setting('no_such_parameter', true), 'missing');
}
expect {
    missing
}

test guc-current-setting-missing-not-ok-errors {
    SELECT current_setting('no_such_parameter', false);
}
expect error {
    ^unrecognized configuration parameter "no_such_parameter"$
}

test guc-set-config-returns-new-value {
    SELECT set_config('application_name', 'myapp', false);
}
expect {
    myapp
}

test guc-set-config-then-show {
    SELECT set_config('application_name', 'myapp', false);
    SHOW application_name;
}
expect {
    myapp
    myapp
}

test guc-set-config-custom-parameter {
    SELECT set_config('myapp.owner', 'joe', false);
    SELECT current_setting('myapp.owner');
}
expect {
    joe
    joe
}

test guc-set-config-null-resets-to-default {
    SET extra_float_digits = 2;
    SELECT set_config('extra_float_digits', NULL, false);
}
expect {
    1
}

test guc-set-config-search-path {
    SELECT set_config('search_path', 'public', false);
    SHOW search_path;
}
expect {
    public
    public
}

test guc-set-config-drives-float-output {
    SELECT set_config('extra_float_digits', '0', false);
    SELECT sqrt(0.5);
}
expect {
    0
    0.707106781186548
}

test guc-current-setting-canonicalizes-booleans {
    SELECT set_config('standard_conforming_strings', 'true', false);
}
expect {
    on
}
