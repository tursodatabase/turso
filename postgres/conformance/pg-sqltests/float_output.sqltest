# float8 text output. PostgreSQL renders shortest-roundtrip digits by
# default (extra_float_digits = 1), switches to scientific notation below
# 1e-4 and at 1e15, pads exponents to two digits, and drops ".0" from
# integral values. extra_float_digits <= 0 selects the legacy
# fixed-precision form with 15 + n significant digits.

@database :memory:

test float-shortest-roundtrip-digits {
    SELECT sqrt(0.5);
}
expect {
    0.7071067811865476
}

test float-integral-values-have-no-decimal-point {
    SELECT 1.0::float8, -3.0::float8, 100000::float8;
}
expect {
    1|-3|100000
}

test float-scientific-notation-thresholds {
    SELECT 1e14::float8, 1e15::float8, 0.0001::float8, 0.00001::float8;
}
expect {
    100000000000000|1e+15|0.0001|1e-05
}

test float-exponent-is-signed-and-two-digits {
    SELECT 1e300::float8, 1.5e-7::float8, 2.5e5::float8;
}
expect {
    1e+300|1.5e-07|250000
}

test float-zero-and-negatives {
    SELECT 0.0::float8, -2.5::float8, -0.125::float8;
}
expect {
    0|-2.5|-0.125
}

test extra-float-digits-zero-gives-fifteen-digits {
    SET extra_float_digits = 0;
    SELECT sqrt(0.5);
}
expect {
    0.707106781186548
}

test extra-float-digits-negative-rounds-further {
    SET extra_float_digits = -5;
    SELECT sqrt(0.5), 1.0::float8;
}
expect {
    0.7071067812|1
}

test extra-float-digits-reset-restores-shortest {
    SET extra_float_digits = -5;
    RESET extra_float_digits;
    SELECT sqrt(0.5);
}
expect {
    0.7071067811865476
}

test stddev-samp-prints-exact-shortest-form {
    CREATE TABLE vartab (x float8);
    INSERT INTO vartab VALUES (1), (2);
    SELECT stddev_samp(x) FROM vartab;
}
expect {
    0.7071067811865476
}
