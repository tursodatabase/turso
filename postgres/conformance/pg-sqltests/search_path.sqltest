# Runtime coverage for SET search_path in the PostgreSQL frontend.
# Schema databases are file-backed, so schema tables are dropped before each
# create to keep repeated test runs independent of old sidecar files.

@database :memory:

test search-path-first-schema-wins {
    DROP TABLE IF EXISTS demo;
    CREATE TABLE demo (id int, label text);
    INSERT INTO demo VALUES (0, 'from public');
    CREATE SCHEMA IF NOT EXISTS sp_fw_a;
    DROP TABLE IF EXISTS sp_fw_a.demo;
    CREATE TABLE sp_fw_a.demo (id int, label text);
    INSERT INTO sp_fw_a.demo VALUES (1, 'from a');
    CREATE SCHEMA IF NOT EXISTS sp_fw_b;
    DROP TABLE IF EXISTS sp_fw_b.demo;
    CREATE TABLE sp_fw_b.demo (id int, label text);
    INSERT INTO sp_fw_b.demo VALUES (2, 'from b');
    SET search_path TO sp_fw_b, sp_fw_a;
    SELECT id, label FROM demo;
}
expect {
    2|from b
}

test search-path-single-schema {
    DROP TABLE IF EXISTS demo;
    CREATE TABLE demo (id int, label text);
    INSERT INTO demo VALUES (0, 'from public');
    CREATE SCHEMA IF NOT EXISTS sp_ss_a;
    DROP TABLE IF EXISTS sp_ss_a.demo;
    CREATE TABLE sp_ss_a.demo (id int, label text);
    INSERT INTO sp_ss_a.demo VALUES (1, 'from a');
    SET search_path TO sp_ss_a;
    SELECT id, label FROM demo;
}
expect {
    1|from a
}

test search-path-missing-schema-errors {
    DROP TABLE IF EXISTS demo;
    CREATE TABLE demo (id int, label text);
    INSERT INTO demo VALUES (0, 'from public');
    SET search_path TO missing_schema_ms;
    SELECT id, label FROM demo;
}
expect error {}

test search-path-public-resolves-to-main {
    DROP TABLE IF EXISTS demo;
    CREATE TABLE demo (id int, label text);
    INSERT INTO demo VALUES (0, 'from public');
    SET search_path TO public;
    SELECT id, label FROM demo;
}
expect {
    0|from public
}

setup empty_search_path {
    CREATE TABLE t1 (a int);
    INSERT INTO t1 VALUES (99);
    SELECT set_config('search_path', '', false);
}

@setup empty_search_path
test search-path-empty-still-finds-ctes {
    WITH t1 AS (SELECT 17 AS a) SELECT a FROM t1;
    WITH t1 AS (SELECT 23 AS a) SELECT (SELECT a FROM t1);
    WITH RECURSIVE t2(a) AS (
        SELECT 31
        UNION ALL
        SELECT a + 2 FROM t2 WHERE a < 35
    ) SELECT a FROM t2 ORDER BY a;
    SELECT a FROM public.t1;
}
expect {
    17
    23
    31
    33
    35
    99
}

@setup empty_search_path
test search-path-empty-does-not-find-stored-tables {
    SELECT a FROM t1;
}
expect error {}

test public-schema-qualified-column-reference {
    DROP TABLE IF EXISTS demo;
    CREATE TABLE demo (id int, label text);
    INSERT INTO demo VALUES (0, 'a'), (1, 'b');
    SELECT public.demo.label FROM public.demo WHERE public.demo.id > 0;
}
expect {
    b
}

test show-search-path-default {
    SHOW search_path;
}
expect {
    "$user", public
}

test show-search-path-after-set {
    SET search_path TO public, pg_catalog;
    SHOW search_path;
    SET SEARCH_PATH TO public;
    SHOW SEARCH_PATH;
}
expect {
    public, pg_catalog
    public
}

test show-search-path-after-set-config {
    SELECT set_config('search_path', '', false);
    SHOW search_path;
    SELECT set_config('search_path', NULL, false);
    SHOW search_path;
}
expect {
    
    
    "$user", public
    "$user", public
}

test create-table-follows-search-path {
    CREATE SCHEMA IF NOT EXISTS sp_ct;
    DROP TABLE IF EXISTS sp_ct.t;
    SET search_path TO sp_ct, public;
    CREATE TABLE t (id serial, x int);
    INSERT INTO t (x) VALUES (1);
    SELECT id, x FROM sp_ct.t;
    SELECT count(*) FROM pg_tables WHERE schemaname = 'public' AND tablename = 't';
}
expect {
    1|1
    0
}

test create-table-skips-missing-schema-in-search-path {
    SET search_path TO sp_missing_ct, public;
    CREATE TABLE t (x int);
    INSERT INTO t VALUES (2);
    SELECT x FROM public.t;
}
expect {
    2
}

test create-table-with-no-existing-schema-in-search-path-errors {
    SET search_path TO sp_missing_ct;
    CREATE TABLE t (x int);
}
expect error {
    no schema has been selected to create in
}

test create-index-follows-table-schema-in-search-path {
    CREATE SCHEMA IF NOT EXISTS sp_ci;
    DROP TABLE IF EXISTS sp_ci.t;
    CREATE TABLE sp_ci.t (x int);
    SET search_path TO sp_ci, public;
    CREATE INDEX t_x_idx ON t (x);
    SELECT count(*) FROM pg_indexes WHERE schemaname = 'public' AND indexname = 't_x_idx';
    DROP INDEX sp_ci.t_x_idx;
    CREATE UNIQUE INDEX t_x_idx ON t (x);
    DROP INDEX t_x_idx;
}
expect {
    0
}

test create-index-skips-missing-schema-in-search-path {
    CREATE TABLE t (x int);
    SET search_path TO sp_missing_ci, public;
    CREATE INDEX t_x_idx ON t (x);
    SELECT schemaname, tablename FROM pg_indexes WHERE indexname = 't_x_idx';
}
expect {
    public|t
}

test current-schema-follows-search-path {
    CREATE SCHEMA IF NOT EXISTS sp_cs;
    SELECT current_schema();
    SET search_path TO sp_missing_cs, sp_cs, public;
    SELECT current_schema();
    SET search_path TO public, sp_cs;
    SELECT current_schema();
    SET search_path TO sp_missing_cs;
    SELECT coalesce(current_schema(), 'none');
    SET search_path TO "$user", public;
    SELECT current_schema();
}
expect {
    public
    sp_cs
    public
    none
    public
}

test sequence-functions-follow-search-path {
    CREATE SCHEMA IF NOT EXISTS sp_sq;
    DROP SEQUENCE IF EXISTS sp_sq.s;
    CREATE SEQUENCE sp_sq.s START 10;
    SET search_path TO sp_sq, public;
    SELECT nextval('s');
    SELECT currval('s');
    SELECT setval('s', 20);
    SELECT nextval('s');
    DROP SEQUENCE s;
    CREATE SEQUENCE sp_sq.s START 30;
    SELECT nextval('s');
}
expect {
    10
    10
    20
    21
    30
}

test sequence-first-schema-in-search-path-wins {
    CREATE SCHEMA IF NOT EXISTS sp_sq2;
    DROP SEQUENCE IF EXISTS sp_sq2.s;
    CREATE SEQUENCE sp_sq2.s START 100;
    CREATE SEQUENCE s START 1;
    SET search_path TO sp_sq2, public;
    SELECT nextval('s');
    SET search_path TO public, sp_sq2;
    SELECT nextval('s');
    SET search_path TO sp_missing_sq, public;
    SELECT nextval('s');
}
expect {
    100
    1
    2
}

test drop-sequence-if-exists-under-search-path {
    SET search_path TO sp_missing_sq;
    DROP SEQUENCE IF EXISTS nope;
    SELECT 1;
}
expect {
    1
}

test serial-sequence-reachable-under-search-path {
    CREATE SCHEMA IF NOT EXISTS sp_sq3;
    DROP TABLE IF EXISTS sp_sq3.t;
    SET search_path TO sp_sq3;
    CREATE TABLE t (id serial, x int);
    INSERT INTO t (x) VALUES (1);
    SELECT currval('t_id_seq');
}
expect {
    1
}

test drop-if-exists-missing-object-under-search-path {
    SET search_path TO sp_missing_di;
    DROP TABLE IF EXISTS nope;
    DROP VIEW IF EXISTS nope;
    DROP INDEX IF EXISTS nope;
    DROP SEQUENCE IF EXISTS nope;
    SELECT 1;
}
expect {
    1
}

test drop-if-exists-finds-object-through-search-path {
    CREATE SCHEMA IF NOT EXISTS sp_di;
    DROP TABLE IF EXISTS sp_di.t;
    CREATE TABLE sp_di.t (x int);
    CREATE INDEX t_x_idx ON sp_di.t (x);
    SET search_path TO sp_di;
    DROP INDEX IF EXISTS t_x_idx;
    DROP TABLE IF EXISTS t;
    CREATE TABLE sp_di.t (x int);
    SELECT count(*) FROM t;
}
expect {
    0
}

test create-view-follows-search-path {
    CREATE SCHEMA IF NOT EXISTS sp_cv;
    DROP VIEW IF EXISTS sp_cv.v;
    DROP TABLE IF EXISTS sp_cv.t;
    CREATE TABLE sp_cv.t (x int);
    INSERT INTO sp_cv.t VALUES (7);
    SET search_path TO sp_cv, public;
    CREATE VIEW v AS SELECT x FROM t;
    SELECT x FROM v;
    SELECT x FROM sp_cv.v;
    DROP VIEW v;
    CREATE OR REPLACE VIEW v AS SELECT x + 1 AS x FROM t;
    SELECT x FROM sp_cv.v;
}
expect {
    7
    7
    8
}

test create-view-is-not-in-public-under-search-path {
    CREATE SCHEMA IF NOT EXISTS sp_cv2;
    DROP VIEW IF EXISTS sp_cv2.v;
    DROP TABLE IF EXISTS sp_cv2.t;
    CREATE TABLE sp_cv2.t (x int);
    SET search_path TO sp_cv2, public;
    CREATE VIEW v AS SELECT x FROM t;
    SELECT x FROM public.v;
}
expect error {}

test create-view-with-no-existing-schema-in-search-path-errors {
    SET search_path TO sp_missing_cv;
    CREATE VIEW v AS SELECT 1 AS x;
}
expect error {
    no schema has been selected to create in
}

test create-view-over-public-table-reads-it-under-search-path {
    CREATE SCHEMA IF NOT EXISTS sp_cv3;
    DROP VIEW IF EXISTS sp_cv3.v;
    CREATE TABLE t (x int);
    INSERT INTO t VALUES (9);
    SET search_path TO sp_cv3, public;
    CREATE VIEW v AS SELECT x FROM t;
    SELECT x FROM v;
}
expect {
    9
}

test create-view-over-catalog-under-search-path {
    CREATE SCHEMA IF NOT EXISTS sp_cv5;
    DROP VIEW IF EXISTS sp_cv5.v;
    SET search_path TO sp_cv5, public;
    CREATE VIEW v AS SELECT count(*) AS c FROM pg_class WHERE relname = 'zzz';
    SELECT c FROM v;
}
expect {
    0
}

test create-view-with-nested-cte-named-like-public-table {
    CREATE SCHEMA IF NOT EXISTS sp_cv6;
    DROP VIEW IF EXISTS sp_cv6.v;
    CREATE TABLE t (x int);
    SET search_path TO sp_cv6, public;
    CREATE VIEW v AS SELECT x FROM (WITH t AS (SELECT 2 AS x) SELECT x FROM t) q;
    SELECT x FROM sp_cv6.v;
}
expect {
    2
}

test create-view-follows-its-table-into-a-later-schema {
    CREATE SCHEMA IF NOT EXISTS sp_cv7;
    DROP VIEW IF EXISTS sp_cv7.va;
    DROP TABLE IF EXISTS sp_cv7.t;
    CREATE TABLE sp_cv7.t (x int);
    INSERT INTO sp_cv7.t VALUES (5);
    SET search_path TO public, sp_cv7;
    CREATE VIEW va AS SELECT x FROM t;
    SELECT x FROM va;
}
expect {
    5
}

@skip-if postgres "Turso does not support views that read tables of different schemas"
test create-view-rejects-tables-of-different-schemas {
    CREATE SCHEMA IF NOT EXISTS sp_cv8;
    DROP TABLE IF EXISTS sp_cv8.ta;
    CREATE TABLE sp_cv8.ta (x int);
    CREATE TABLE tb (x int);
    SET search_path TO sp_cv8, public;
    CREATE VIEW v AS SELECT ta.x FROM ta, tb;
}
expect error {
    a view cannot read tables of different schemas: public, sp_cv8
}

test create-view-reads-cte-named-like-table-of-another-schema {
    CREATE SCHEMA IF NOT EXISTS sp_cv4;
    DROP VIEW IF EXISTS sp_cv4.v;
    CREATE TABLE t (x int);
    INSERT INTO t VALUES (1);
    SET search_path TO sp_cv4, public;
    CREATE VIEW v AS WITH t AS (SELECT 2 AS x) SELECT x FROM t;
    SELECT x FROM v;
}
expect {
    2
}

test create-view-over-table-with-a-quote-in-its-name {
    CREATE SCHEMA IF NOT EXISTS sp_cv9;
    DROP VIEW IF EXISTS sp_cv9.v;
    DROP TABLE IF EXISTS sp_cv9."a'b";
    CREATE TABLE sp_cv9."a'b" (x int);
    INSERT INTO sp_cv9."a'b" VALUES (6);
    SET search_path TO sp_cv9, public;
    CREATE VIEW v AS SELECT x FROM "a'b";
    SELECT x FROM v;
}
expect {
    6
}

test create-view-over-table-with-a-dot-in-its-name {
    CREATE SCHEMA IF NOT EXISTS sp_cv10;
    DROP VIEW IF EXISTS sp_cv10.v;
    CREATE TABLE "a.b" (x int);
    INSERT INTO "a.b" VALUES (7);
    SET search_path TO sp_cv10, public;
    CREATE VIEW v AS SELECT x FROM "a.b";
    SELECT x FROM v;
}
expect {
    7
}

test create-view-reads-a-table-beside-a-cte-of-the-same-name {
    CREATE SCHEMA IF NOT EXISTS sp_cv11;
    DROP VIEW IF EXISTS sp_cv11.v;
    CREATE TABLE t (x int);
    INSERT INTO t VALUES (1);
    SET search_path TO sp_cv11, public;
    CREATE VIEW v AS SELECT (WITH t AS (SELECT 2 AS y) SELECT y FROM t) AS b, (SELECT x FROM t) AS a;
    SELECT b, a FROM v;
}
expect {
    2|1
}

test create-view-over-subquery-of-a-table-in-search-path {
    CREATE SCHEMA IF NOT EXISTS sp_cv12;
    DROP VIEW IF EXISTS sp_cv12.w;
    DROP TABLE IF EXISTS sp_cv12.u;
    CREATE TABLE sp_cv12.u (y int);
    INSERT INTO sp_cv12.u VALUES (4);
    SET search_path TO sp_cv12, public;
    CREATE VIEW w AS SELECT y FROM (SELECT y FROM u) s;
    SELECT y FROM sp_cv12.w;
}
expect {
    4
}

test create-table-as-follows-search-path {
    CREATE SCHEMA IF NOT EXISTS sp_ctas;
    DROP TABLE IF EXISTS sp_ctas.u;
    SET search_path TO sp_ctas, public;
    CREATE TABLE u AS SELECT 3 AS x;
    SELECT x FROM sp_ctas.u;
    SELECT count(*) FROM pg_tables WHERE schemaname = 'public' AND tablename = 'u';
}
expect {
    3
    0
}

test create-table-as-with-no-existing-schema-in-search-path-errors {
    SET search_path TO sp_missing_ctas;
    CREATE TABLE u AS SELECT 3 AS x;
}
expect error {
    no schema has been selected to create in
}

test create-sequence-follows-search-path {
    CREATE SCHEMA IF NOT EXISTS sp_cs2;
    DROP SEQUENCE IF EXISTS sp_cs2.s;
    SET search_path TO sp_cs2, public;
    CREATE SEQUENCE s START 40;
    SELECT nextval('sp_cs2.s');
    SELECT nextval('s');
}
expect {
    40
    41
}

test create-sequence-is-not-in-public-under-search-path {
    CREATE SCHEMA IF NOT EXISTS sp_cs3;
    DROP SEQUENCE IF EXISTS sp_cs3.s;
    SET search_path TO sp_cs3, public;
    CREATE SEQUENCE s;
    SET search_path TO public;
    SELECT nextval('s');
}
expect error {}

test create-sequence-with-no-existing-schema-in-search-path-errors {
    SET search_path TO sp_missing_cs;
    CREATE SEQUENCE s;
}
expect error {
    no schema has been selected to create in
}

test select-into-follows-search-path {
    CREATE SCHEMA IF NOT EXISTS sp_si;
    DROP TABLE IF EXISTS sp_si.sel;
    CREATE TABLE base (x int);
    INSERT INTO base VALUES (5);
    SET search_path TO sp_si, public;
    SELECT x INTO sel FROM base;
    SELECT x FROM sp_si.sel;
}
expect {
    5
}

test public-prefix-on-drop-statements {
    CREATE TABLE pp_t (x int);
    CREATE VIEW pp_v AS SELECT x FROM pp_t;
    CREATE INDEX pp_i ON pp_t (x);
    CREATE SEQUENCE pp_s;
    DROP INDEX public.pp_i;
    DROP VIEW public.pp_v;
    DROP SEQUENCE public.pp_s;
    DROP TABLE public.pp_t;
    DROP TABLE IF EXISTS public.pp_t;
    SELECT count(*) FROM pg_tables WHERE tablename = 'pp_t';
}
expect {
    0
}

test public-prefix-on-sequence-functions {
    CREATE SEQUENCE pp_s2 START 7;
    SELECT nextval('public.pp_s2');
    SELECT currval('public.pp_s2');
    SELECT setval('public.pp_s2', 9);
    SELECT nextval('pp_s2');
}
expect {
    7
    7
    9
    10
}

test drop-if-exists-with-missing-schema-does-nothing {
    DROP TABLE IF EXISTS sp_missing_ds.t;
    DROP VIEW IF EXISTS sp_missing_ds.v;
    DROP INDEX IF EXISTS sp_missing_ds.i;
    DROP SEQUENCE IF EXISTS sp_missing_ds.s;
    SET search_path TO sp_missing_ds;
    DROP TABLE IF EXISTS sp_missing_ds.t;
    SELECT 1;
}
expect {
    1
}

test drop-table-stops-at-view-of-the-same-name-in-an-earlier-schema {
    CREATE SCHEMA IF NOT EXISTS sp_dk1;
    CREATE SCHEMA IF NOT EXISTS sp_dk2;
    DROP VIEW IF EXISTS sp_dk1.t;
    DROP TABLE IF EXISTS sp_dk2.t;
    CREATE VIEW sp_dk1.t AS SELECT 1 AS c;
    CREATE TABLE sp_dk2.t (x int);
    SET search_path TO sp_dk1, sp_dk2;
    DROP TABLE IF EXISTS t;
}
expect error {
    "t" is not a table
}

test drop-view-stops-at-table-of-the-same-name-in-an-earlier-schema {
    CREATE SCHEMA IF NOT EXISTS sp_dk3;
    CREATE SCHEMA IF NOT EXISTS sp_dk4;
    DROP TABLE IF EXISTS sp_dk3.v;
    DROP VIEW IF EXISTS sp_dk4.v;
    CREATE TABLE sp_dk3.v (x int);
    CREATE VIEW sp_dk4.v AS SELECT 1 AS c;
    SET search_path TO sp_dk3, sp_dk4;
    DROP VIEW v;
}
expect error {
    "v" is not a view
}

test drop-index-stops-at-table-of-the-same-name-in-an-earlier-schema {
    CREATE SCHEMA IF NOT EXISTS sp_dk5;
    CREATE SCHEMA IF NOT EXISTS sp_dk6;
    DROP TABLE IF EXISTS sp_dk5.i;
    DROP TABLE IF EXISTS sp_dk6.u;
    CREATE TABLE sp_dk5.i (x int);
    CREATE TABLE sp_dk6.u (x int);
    CREATE INDEX i ON sp_dk6.u (x);
    SET search_path TO sp_dk5, sp_dk6;
    DROP INDEX IF EXISTS i;
}
expect error {
    "i" is not an index
}

test drop-if-exists-of-missing-qualified-objects-under-search-path {
    CREATE SCHEMA IF NOT EXISTS sp_dk7;
    SET search_path TO sp_dk7, public;
    DROP TABLE IF EXISTS public.nonexistent;
    DROP VIEW IF EXISTS public.nonexistent;
    DROP INDEX IF EXISTS public.nonexistent;
    DROP SEQUENCE IF EXISTS public.nonexistent;
    DROP TABLE IF EXISTS sp_dk7.nonexistent;
    SELECT 1;
}
expect {
    1
}

test drop-sequence-stops-at-table-of-the-same-name-in-an-earlier-schema {
    CREATE SCHEMA IF NOT EXISTS sp_dk8;
    CREATE SCHEMA IF NOT EXISTS sp_dk9;
    DROP TABLE IF EXISTS sp_dk8.sq;
    DROP SEQUENCE IF EXISTS sp_dk9.sq;
    CREATE TABLE sp_dk8.sq (x int);
    CREATE SEQUENCE sp_dk9.sq;
    SET search_path TO sp_dk8, sp_dk9;
    DROP SEQUENCE sq;
}
expect error {
    "sq" is not a sequence
}

test nextval-stops-at-table-of-the-same-name-in-an-earlier-schema {
    CREATE SCHEMA IF NOT EXISTS sp_dk10;
    CREATE SCHEMA IF NOT EXISTS sp_dk11;
    DROP TABLE IF EXISTS sp_dk10.sq;
    DROP SEQUENCE IF EXISTS sp_dk11.sq;
    CREATE TABLE sp_dk10.sq (x int);
    CREATE SEQUENCE sp_dk11.sq;
    SET search_path TO sp_dk10, sp_dk11;
    SELECT nextval('sq');
}
expect error {
    "sq" is not a sequence
}

@skip-if postgres "Turso drops only the first object of a multi-object DROP"
test drop-if-exists-with-missing-schema-keeps-other-objects {
    CREATE TABLE real_t (x int);
    DROP TABLE IF EXISTS sp_missing_dm.t, real_t;
}
expect error {
    no such database
}

@skip-if postgres "main is the database behind public in Turso, not a schema"
test drop-if-exists-in-the-main-database {
    CREATE TABLE t (x int);
    DROP TABLE IF EXISTS main.t;
    SELECT count(*) FROM pg_tables WHERE tablename = 't';
}
expect {
    0
}
