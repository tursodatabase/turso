# Schemas created with CREATE SCHEMA and the objects in them.

@database :memory:

test create-schema-rejects-names-that-start-with-pg {
    CREATE SCHEMA pg_app;
}
expect error {
    unacceptable schema name "pg_app"
}

test drop-schema-with-objects-errors {
    CREATE SCHEMA IF NOT EXISTS drop_needs_cascade;
    DROP SCHEMA drop_needs_cascade CASCADE;
    CREATE SCHEMA drop_needs_cascade;
    CREATE TABLE drop_needs_cascade.t (x int);
    DROP SCHEMA drop_needs_cascade;
}
expect error {
    because other objects depend on it
}

test drop-schema-public-with-only-views-errors {
    CREATE VIEW v AS SELECT 1 AS x;
    DROP SCHEMA public;
}
expect error {
    because other objects depend on it
}

test drop-schema-cascade-drops-its-objects {
    CREATE SCHEMA IF NOT EXISTS drop_cascade;
    DROP SCHEMA drop_cascade CASCADE;
    CREATE SCHEMA drop_cascade;
    CREATE TABLE drop_cascade.t (x int);
    CREATE VIEW drop_cascade.v AS SELECT x FROM drop_cascade.t;
    CREATE SEQUENCE drop_cascade.s;
    DROP SCHEMA drop_cascade CASCADE;
    CREATE SCHEMA drop_cascade;
    CREATE TABLE drop_cascade.t (x int);
    CREATE VIEW drop_cascade.v AS SELECT x FROM drop_cascade.t;
    CREATE SEQUENCE drop_cascade.s;
    SELECT count(*) FROM drop_cascade.v;
}
expect {
    0
}

test drop-schema-public-cascade-drops-its-objects {
    CREATE TABLE t (x int);
    CREATE VIEW v AS SELECT x FROM t;
    CREATE SEQUENCE s;
    DROP SCHEMA public CASCADE;
    CREATE SCHEMA IF NOT EXISTS public;
    CREATE TABLE t (x int);
    CREATE VIEW v AS SELECT x FROM t;
    CREATE SEQUENCE s;
    SELECT count(*) FROM v;
}
expect {
    0
}

test create-schema-creates-its-elements-in-the-new-schema {
    CREATE SCHEMA IF NOT EXISTS create_elements;
    DROP SCHEMA create_elements CASCADE;
    CREATE SCHEMA create_elements
        CREATE VIEW v AS SELECT a FROM t
        CREATE TABLE t (a int)
        CREATE INDEX t_a ON t (a)
        CREATE SEQUENCE seq;
    INSERT INTO create_elements.t VALUES (nextval('create_elements.seq') + 41);
    SELECT a FROM create_elements.v;
    SHOW search_path;
}
expect {
    42
    "$user", public
}

test create-schema-rejects-elements-in-another-schema {
    CREATE SCHEMA create_elsewhere CREATE TABLE public.t (a int);
}
expect error {
    different from the one being created
}

test tables-of-two-schemas-with-the-same-name {
    CREATE SCHEMA a;
    CREATE SCHEMA b;
    CREATE TABLE a.t (v text);
    CREATE TABLE b.t (v text);
    CREATE TABLE t (v text);
    INSERT INTO a.t VALUES ('a');
    INSERT INTO b.t VALUES ('b');
    INSERT INTO t VALUES ('public');
    SELECT v FROM a.t UNION ALL SELECT v FROM b.t UNION ALL SELECT v FROM public.t;
}
expect {
    a
    b
    public
}

test schema-and-table-qualified-columns {
    CREATE SCHEMA app;
    CREATE TABLE app.items (id int, label text);
    INSERT INTO app.items VALUES (1, 'a'), (2, 'b');
    SELECT app.items.label, items.id FROM app.items ORDER BY id;
}
expect {
    a|1
    b|2
}

test update-and-delete-with-table-qualified-columns {
    CREATE SCHEMA app;
    CREATE TABLE app.t (x int);
    INSERT INTO app.t VALUES (1), (2);
    UPDATE app.t SET x = t.x * 10 WHERE t.x = 1;
    DELETE FROM app.t WHERE t.x = 2;
    SELECT x FROM app.t;
}
expect {
    10
}

test create-table-in-missing-schema-errors {
    CREATE TABLE missing_schema.t (x int);
}
expect error {
    schema "missing_schema" does not exist
}

test index-names-are-per-schema {
    CREATE SCHEMA app;
    CREATE TABLE t (x int);
    CREATE TABLE app.t (x int);
    CREATE INDEX t_x ON t (x);
    CREATE INDEX t_x ON app.t (x);
    DROP INDEX app.t_x;
    DROP INDEX t_x;
    SELECT 1;
}
expect {
    1
}

test rename-table-in-schema {
    CREATE SCHEMA app;
    CREATE TABLE app.t (x int);
    INSERT INTO app.t VALUES (1);
    ALTER TABLE app.t RENAME TO u;
    SELECT x FROM app.u;
}
expect {
    1
}

test sequence-in-schema {
    CREATE SCHEMA app;
    CREATE SEQUENCE app.s;
    CREATE SEQUENCE s START 10;
    SELECT nextval('app.s');
    SELECT nextval('app.s');
    SELECT nextval('s');
    SELECT currval('app.s');
}
expect {
    1
    2
    10
    2
}

test catalogs-report-schema-of-objects {
    CREATE SCHEMA app;
    CREATE TABLE app.t (x int);
    CREATE INDEX t_x ON app.t (x);
    CREATE SEQUENCE app.s;
    SELECT n.nspname, c.relname FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE c.relname IN ('t', 't_x') ORDER BY c.relname;
    SELECT schemaname, tablename FROM pg_tables WHERE tablename = 't';
    SELECT schemaname, tablename, indexname FROM pg_indexes WHERE indexname = 't_x';
    SELECT schemaname, sequencename FROM pg_sequences WHERE sequencename = 's';
}
expect {
    app|t
    app|t_x
    app|t
    app|t|t_x
    app|s
}

test serial-columns-in-schema-and-public {
    CREATE SCHEMA app;
    CREATE TABLE app.t (id serial, label text);
    CREATE TABLE t (id serial, label text);
    INSERT INTO app.t (label) VALUES ('a'), ('b');
    INSERT INTO t (label) VALUES ('c');
    SELECT id, label FROM app.t UNION ALL SELECT id, label FROM t ORDER BY label;
}
expect {
    1|a
    2|b
    1|c
}

test view-in-schema-finds-its-tables-without-a-schema-name {
    CREATE SCHEMA app;
    SET search_path TO app;
    CREATE TABLE t (a int);
    INSERT INTO t VALUES (1);
    CREATE VIEW v AS SELECT a FROM t;
    SET search_path TO public;
    SELECT a FROM app.v;
}
expect {
    1
}

@skip-if postgres "PostgreSQL keeps a public table named app.u apart from the table u of schema app; Turso stores both under the same name"
test public-object-named-under-a-schema-prefix-errors {
    CREATE SCHEMA app;
    CREATE TABLE app.t (x int);
    CREATE TABLE "app.u" (y int);
}
expect error {
    the prefix of app
}

test schema-named-with-a-dot-keeps-its-tables-apart {
    CREATE SCHEMA a;
    CREATE SCHEMA "a.b";
    CREATE TABLE "a.b".t (x int);
    CREATE TABLE a."b.t" (x int);
    INSERT INTO "a.b".t VALUES (1);
    INSERT INTO a."b.t" VALUES (2);
    SELECT schemaname, tablename FROM pg_tables WHERE tablename IN ('t', 'b.t') ORDER BY schemaname;
    SELECT x FROM a."b.t";
    DROP SCHEMA a CASCADE;
    SELECT x FROM "a.b".t;
    SELECT count(*) FROM pg_tables WHERE tablename = 'b.t';
}
expect {
    a|b.t
    a.b|t
    2
    1
    0
}

@skip-if postgres "Turso marks each schema with a table named pg_turso_schema_<schema>; PostgreSQL has no such tables"
test table-named-like-a-schema-marker-errors {
    CREATE TABLE pg_turso_schema_foo (x int);
}
expect error {
    reserved for schema markers
}

@skip-if postgres "Turso marks each schema with a table named pg_turso_schema_<schema>; PostgreSQL has no such tables"
test rename-to-a-schema-marker-name-errors {
    CREATE TABLE t (x int);
    ALTER TABLE t RENAME TO pg_turso_schema_foo;
}
expect error {
    reserved for schema markers
}

@skip-if postgres "Turso marks each schema with a table named pg_turso_schema_<schema>; PostgreSQL has no such tables"
test drop-of-a-schema-marker-table-errors {
    CREATE SCHEMA app;
    DROP TABLE pg_turso_schema_app;
}
expect error {
    reserved for schema markers
}

test column-named-with-its-schema-reads-the-table-of-that-schema {
    CREATE SCHEMA app;
    CREATE TABLE app.t (x int);
    CREATE TABLE t (x int);
    INSERT INTO app.t VALUES (1);
    INSERT INTO t VALUES (2);
    SELECT app.t.x, public.t.x FROM app.t JOIN public.t ON true;
    SELECT public.t.x, app.t.x FROM (app.t JOIN public.t ON true);
}
expect {
    1|2
    2|1
}

test view-reads-a-table-of-another-schema {
    CREATE SCHEMA app;
    CREATE TABLE app.t (x int);
    INSERT INTO app.t VALUES (3);
    CREATE VIEW v AS SELECT x FROM app.t;
    CREATE MATERIALIZED VIEW mv AS SELECT x FROM app.t;
    CREATE VIEW app.v AS SELECT x FROM public.v;
    SELECT * FROM v;
    SELECT * FROM mv;
    SELECT * FROM app.v;
}
expect {
    3
    3
    3
}

test materialized-view-created-in-the-search-path-schema-reads-its-tables {
    CREATE SCHEMA app;
    CREATE TABLE app.t (x int);
    CREATE TABLE t (x int);
    INSERT INTO app.t VALUES (1);
    INSERT INTO t VALUES (100);
    SET search_path TO app;
    CREATE MATERIALIZED VIEW mv AS SELECT sum(x) AS s FROM t;
    SELECT * FROM mv;
    INSERT INTO t VALUES (2);
    INSERT INTO public.t VALUES (200);
    REFRESH MATERIALIZED VIEW mv;
    SELECT * FROM mv;
}
expect {
    1
    3
}

test view-in-schema-binds-a-public-table-through-search-path {
    CREATE SCHEMA app;
    CREATE TABLE t (x int);
    INSERT INTO t VALUES (1);
    CREATE VIEW app.v AS SELECT x FROM t;
    CREATE TABLE app.t (x int);
    INSERT INTO app.t VALUES (2);
    SELECT * FROM app.v;
    SET search_path TO app;
    SELECT * FROM app.v;
}
expect {
    1
    1
}

@skip-if postgres "PostgreSQL keeps a public index named app.i apart from the index i of schema app; Turso stores both under the same name"
test create-schema-errors-when-a-public-index-is-named-under-its-prefix {
    CREATE TABLE t (x int);
    CREATE INDEX "app.i" ON t (x);
    CREATE SCHEMA app;
}
expect error {
    cannot create schema "app"
}

test drop-schema-cascade-drops-the-tables-of-a-schema-named-with-a-dot {
    CREATE SCHEMA "a.b";
    CREATE TABLE "a.b".t (x int);
    CREATE INDEX i ON "a.b".t (x);
    DROP SCHEMA "a.b" CASCADE;
    SELECT count(*) FROM pg_tables WHERE tablename = 't';
}
expect {
    0
}

test sequence-in-a-schema-named-with-a-dot {
    CREATE SCHEMA "a.b";
    CREATE SEQUENCE "a.b".s START WITH 5;
    SELECT nextval('"a.b".s');
    CREATE TABLE "a.b".t (id serial, v int);
    INSERT INTO "a.b".t (v) VALUES (7);
    INSERT INTO "a.b".t (v) VALUES (8);
    SELECT id, v FROM "a.b".t ORDER BY id;
    SELECT schemaname, sequencename FROM pg_sequences WHERE schemaname = 'a.b' ORDER BY sequencename;
    DROP SCHEMA "a.b" CASCADE;
    SELECT count(*) FROM pg_sequences WHERE schemaname = 'a.b';
}
expect {
    5
    1|7
    2|8
    a.b|s
    a.b|t_id_seq
    0
}

@skip-if postgres "PostgreSQL keeps a public table named s.t apart from the table t of schema s; Turso stores both under the same name"
test public-object-named-with-public-under-a-schema-prefix-errors {
    CREATE SCHEMA s;
    CREATE TABLE public."s.t" (x int);
}
expect error {
    cannot create "s.t" in public
}
