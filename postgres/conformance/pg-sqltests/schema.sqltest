# Schemas created with CREATE SCHEMA and the objects in them.

@database :memory:

test create-schema-rejects-names-that-start-with-pg {
    CREATE SCHEMA pg_app;
}
expect error {
    unacceptable schema name "pg_app"
}

test drop-schema-with-objects-errors {
    CREATE SCHEMA IF NOT EXISTS drop_needs_cascade;
    DROP SCHEMA drop_needs_cascade CASCADE;
    CREATE SCHEMA drop_needs_cascade;
    CREATE TABLE drop_needs_cascade.t (x int);
    DROP SCHEMA drop_needs_cascade;
}
expect error {
    because other objects depend on it
}

test drop-schema-public-with-only-views-errors {
    CREATE VIEW v AS SELECT 1 AS x;
    DROP SCHEMA public;
}
expect error {
    because other objects depend on it
}

test drop-schema-cascade-drops-its-objects {
    CREATE SCHEMA IF NOT EXISTS drop_cascade;
    DROP SCHEMA drop_cascade CASCADE;
    CREATE SCHEMA drop_cascade;
    CREATE TABLE drop_cascade.t (x int);
    CREATE VIEW drop_cascade.v AS SELECT x FROM drop_cascade.t;
    CREATE SEQUENCE drop_cascade.s;
    DROP SCHEMA drop_cascade CASCADE;
    CREATE SCHEMA drop_cascade;
    CREATE TABLE drop_cascade.t (x int);
    CREATE VIEW drop_cascade.v AS SELECT x FROM drop_cascade.t;
    CREATE SEQUENCE drop_cascade.s;
    SELECT count(*) FROM drop_cascade.v;
}
expect {
    0
}

test drop-schema-public-cascade-drops-its-objects {
    CREATE TABLE t (x int);
    CREATE VIEW v AS SELECT x FROM t;
    CREATE SEQUENCE s;
    DROP SCHEMA public CASCADE;
    CREATE SCHEMA IF NOT EXISTS public;
    CREATE TABLE t (x int);
    CREATE VIEW v AS SELECT x FROM t;
    CREATE SEQUENCE s;
    SELECT count(*) FROM v;
}
expect {
    0
}

test select-schema-qualified-table-star {
    CREATE SCHEMA IF NOT EXISTS star_s;
    DROP SCHEMA star_s CASCADE;
    CREATE SCHEMA star_s;
    CREATE TABLE star_s.st (a int, b text);
    INSERT INTO star_s.st VALUES (1, 'x'), (2, 'y');
    SELECT star_s.st.* FROM star_s.st ORDER BY a;
}
expect {
    1|x
    2|y
}

test select-schema-qualified-table-star-with-join {
    CREATE SCHEMA IF NOT EXISTS star_j;
    DROP SCHEMA star_j CASCADE;
    CREATE SCHEMA star_j;
    CREATE TABLE star_j.jt (a int, b text);
    CREATE TABLE star_j.ju (a int, c text);
    INSERT INTO star_j.jt VALUES (1, 'x'), (2, 'y');
    INSERT INTO star_j.ju VALUES (1, 'p'), (3, 'q');
    SELECT star_j.ju.*, jt.b FROM star_j.jt JOIN star_j.ju ON jt.a = ju.a;
    SELECT star_j.jt.* FROM star_j.jt, star_j.ju WHERE jt.a = ju.a;
}
expect {
    1|p|x
    1|x
}

test select-public-qualified-table-star {
    CREATE TABLE star_p (a int, b text);
    INSERT INTO star_p VALUES (1, 'x');
    SELECT public.star_p.* FROM star_p;
    SELECT public.star_p.* FROM public.star_p;
}
expect {
    1|x
    1|x
}
