    123
    123
}
test cast-numeric-integer-literal-boundaries {
    SELECT 32767::int2;
    SELECT (-32768)::int2;
    SELECT 2147483647::int4;
    SELECT (-2147483648)::int4;
    SELECT 9223372036854775807::int8;
    SELECT (-9223372036854775808)::int8;
    SELECT int2(32767);
    SELECT int2(-32768);
    SELECT int4(2147483647);
    SELECT int4(-2147483648);
    SELECT int8(9223372036854775807);
    SELECT int8(-9223372036854775808);
}
expect {
    32767
    -32768
    2147483647
    -2147483648
    9223372036854775807
    -9223372036854775808
    32767
    -32768
    2147483647
    -2147483648
    9223372036854775807
    -9223372036854775808
}
test cast-numeric-literal-unary-minus-precedence {
    SELECT (-9223372036854775808)::int8;
}
expect {
    -9223372036854775808
}

