    DROP DOMAIN domain_recreated_integer;
    CREATE DOMAIN domain_recreated_integer AS int8;

    SELECT '2147483648'::domain_recreated_integer;

    DROP DOMAIN domain_recreated_integer;
}
expect {
    123
    40000
    2147483648
}

test domain-cast-recreated-from-wide-to-narrow {
