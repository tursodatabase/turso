test cast-runtime-integer-int8-boundaries {
    CREATE TABLE integer_cast_values (position integer, value bigint);
    INSERT INTO integer_cast_values VALUES
        (1, 9223372036854775807),
        (2, -9223372036854775808);
    SELECT value::int8 FROM integer_cast_values ORDER BY position;
    DROP TABLE integer_cast_values;
}
expect {
    9223372036854775807
    -9223372036854775808
}

test cast-runtime-float-rounding {
    CREATE TABLE integer_cast_values (position integer, value double precision);
    INSERT INTO integer_cast_values VALUES
        (1, 123.4), (2, 123.5), (3, 123.6),
        (4, -123.4), (5, -123.5), (6, -123.6);
    SELECT value::int4 FROM integer_cast_values ORDER BY position;
    DROP TABLE integer_cast_values;
}
expect {
    123
    124
    124
    -123
    -124
    -124
}
