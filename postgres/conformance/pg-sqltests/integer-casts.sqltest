test cast-runtime-text-overflow {
    CREATE TABLE integer_cast_values (value text);
    INSERT INTO integer_cast_values VALUES ('32768');

    SELECT value::int2 FROM integer_cast_values;

    DROP TABLE integer_cast_values;
}
expect error {
}
