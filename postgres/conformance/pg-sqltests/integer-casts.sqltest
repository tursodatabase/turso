test cast-float-literal-rounding {
    SELECT 123.4::int8;
    SELECT 123.5::int8;
    SELECT 123.6::int8;
    SELECT -123.4::int8;
    SELECT -123.5::int8;
    SELECT -123.6::int8;
    SELECT int8(123.4);
    SELECT int8(123.5);
    SELECT int8(123.6);
    SELECT int8(-123.4);
    SELECT int8(-123.5);
    SELECT int8(-123.6);
}
expect {
    123
    124
    124
    -123
    -124
    -124
    123
    124
    124
    -123
    -124
    -124
}
test cast-float-literal-all-widths {
    SELECT 123.5::int2;
    SELECT 123.5::int4;
    SELECT 123.5::int8;
    SELECT int2(123.5);
    SELECT int4(123.5);
    SELECT int8(123.5);
}
expect {
    124
    124
    124
    124
    124
    124
}
test cast-float-literal-int2-overflow {
    SELECT 32768.0::int2;
}
expect error {
}
test cast-float-literal-int4-overflow {
    SELECT 2147483648.0::int4;
}
expect error {
}
test cast-float-literal-int8-positive-overflow {
    SELECT 9223372036854775808.0::int8;
}
expect error {
}
test cast-float-literal-int8-negative-boundary {
    SELECT (-9223372036854775808.0)::int8;
}
expect {
    -9223372036854775808
}

test cast-runtime-integer-values-all-widths {
    CREATE TABLE integer_cast_values (value bigint);
    INSERT INTO integer_cast_values VALUES
        (123), (-123), (32767), (-32768);
    SELECT value::int2 FROM integer_cast_values ORDER BY rowid;
    SELECT value::int4 FROM integer_cast_values ORDER BY rowid;
    SELECT value::int8 FROM integer_cast_values ORDER BY rowid;
    SELECT int2(value) FROM integer_cast_values ORDER BY rowid;
    SELECT int4(value) FROM integer_cast_values ORDER BY rowid;
    SELECT int8(value) FROM integer_cast_values ORDER BY rowid;
    DROP TABLE integer_cast_values;
}
expect {
    123
    -123
    32767
    -32768
    123
    -123
    32767
    -32768
    123
    -123
    32767
    -32768
    123
    -123
    32767
    -32768
    123
    -123
    32767
    -32768
    123
    -123
    32767
    -32768
}
