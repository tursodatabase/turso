    42000
    -42000
    2147483647
}

test domain-cast-recreated-with-different-base-types {
    CREATE DOMAIN domain_recreated_integer AS int2;

    SELECT '123'::domain_recreated_integer;

    DROP DOMAIN domain_recreated_integer;
