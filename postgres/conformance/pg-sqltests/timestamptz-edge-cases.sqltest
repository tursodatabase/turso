# timestamptz values that name the same instant with different offsets
# must behave as one value in keys, grouping, joins and constraints.

@database :memory:

test timestamptz-unique-across-offsets {
    CREATE TABLE t (ts timestamptz UNIQUE);
    INSERT INTO t VALUES ('2026-10-08 12:00:00+00');
    INSERT INTO t VALUES ('2026-10-08 14:00:00+02');
}
expect error {duplicate key value violates unique constraint}

test timestamptz-primary-key-across-offsets {
    CREATE TABLE t (ts timestamptz PRIMARY KEY, n int);
    INSERT INTO t VALUES ('2026-10-08T12:00:00Z', 1);
    INSERT INTO t VALUES ('2026-10-08 07:00:00-05', 2);
}
expect error {duplicate key value violates unique constraint}

test timestamptz-on-conflict-across-offsets {
    CREATE TABLE t (ts timestamptz PRIMARY KEY, n int);
    INSERT INTO t VALUES ('2026-10-08T12:00:00Z', 1);
    INSERT INTO t VALUES ('2026-10-08 13:30:00+01:30', 2) ON CONFLICT (ts) DO UPDATE SET n = excluded.n;
    SELECT ts, n FROM t;
}
expect {
    2026-10-08 12:00:00+00|2
}

test timestamptz-group-by-and-distinct-across-offsets {
    CREATE TABLE t (ts timestamptz);
    INSERT INTO t VALUES ('2026-10-08 12:00:00+00'), ('2026-10-08 14:00:00+02'), ('2026-10-08 12:00:00.000001+00');
    SELECT ts, count(*) FROM t GROUP BY ts ORDER BY ts;
    SELECT count(DISTINCT ts) FROM t;
}
expect {
    2026-10-08 12:00:00+00|2
    2026-10-08 12:00:00.000001+00|1
    2
}

test timestamptz-join-across-offsets {
    CREATE TABLE a (ts timestamptz);
    CREATE TABLE b (ts timestamptz);
    INSERT INTO a VALUES ('2026-10-08 12:00:00+00');
    INSERT INTO b VALUES ('2026-10-08 09:00:00-03');
    SELECT a.ts FROM a JOIN b ON a.ts = b.ts;
}
expect {
    2026-10-08 12:00:00+00
}

test timestamptz-min-max-with-infinity {
    CREATE TABLE t (ts timestamptz);
    INSERT INTO t VALUES ('2026-10-08 12:00:00+00'), ('infinity'), ('-infinity'), ('1999-01-01 00:00:00+00'), (NULL);
    SELECT min(ts), max(ts) FROM t;
    SELECT min(ts), max(ts) FROM t WHERE ts > '-infinity'::timestamptz AND ts < 'infinity'::timestamptz;
}
expect {
    -infinity|infinity
    1999-01-01 00:00:00+00|2026-10-08 12:00:00+00
}

test timestamptz-order-by-microseconds {
    CREATE TABLE t (id int, ts timestamptz);
    INSERT INTO t VALUES (1, '2026-10-08 12:00:00.1+00'), (2, '2026-10-08 12:00:00+00'), (3, '2026-10-08 12:00:00.000001+00'), (4, '2026-10-08 12:00:00.09+00');
    SELECT id FROM t ORDER BY ts;
}
expect {
    2
    3
    4
    1
}

test timestamptz-order-by-years-before-1000 {
    CREATE TABLE t (id int, ts timestamptz);
    INSERT INTO t VALUES (1, '0999-12-31 23:00:00+00'), (2, '1000-01-01 00:00:00+00'), (3, '0001-01-01 00:00:00+00'), (4, '9999-12-31 23:59:59.999999+00');
    SELECT id FROM t ORDER BY ts DESC;
}
expect {
    4
    2
    1
    3
}

test timestamptz-update-with-interval {
    CREATE TABLE t (ts timestamptz);
    INSERT INTO t VALUES ('2026-01-31 12:00:00+00');
    UPDATE t SET ts = ts + interval '1 month';
    SELECT ts FROM t;
}
expect {
    2026-02-28 12:00:00+00
}

test timestamptz-update-with-text {
    CREATE TABLE t (ts timestamptz);
    INSERT INTO t VALUES ('2026-01-31 12:00:00+00');
    UPDATE t SET ts = '2026-10-08 14:00:00+02';
    SELECT ts FROM t;
}
expect {
    2026-10-08 12:00:00+00
}

test timestamptz-default-now {
    CREATE TABLE t (id int, ts timestamptz DEFAULT now());
    INSERT INTO t (id) VALUES (1);
    SELECT CASE WHEN ts::text ~ '^\d{4}-\d\d-\d\d \d\d:\d\d:\d\d(\.\d{1,6})?\+00$' AND ts <= now() THEN 'ok' ELSE ts::text END FROM t;
}
expect {
    ok
}

test timestamptz-insert-select-from-text {
    CREATE TABLE src (s text);
    CREATE TABLE t (ts timestamptz);
    INSERT INTO src VALUES ('2026-10-08 14:00:00+02'), ('epoch');
    INSERT INTO t SELECT s::timestamptz FROM src;
    SELECT ts FROM t ORDER BY ts;
}
expect {
    1970-01-01 00:00:00+00
    2026-10-08 12:00:00+00
}

test timestamptz-index-range-scan {
    CREATE TABLE t (id int, ts timestamptz);
    CREATE INDEX t_ts ON t (ts);
    INSERT INTO t VALUES (1, '2026-10-08 10:00:00+00'), (2, '2026-10-08 11:00:00+00'), (3, '2026-10-08 12:00:00+00'), (4, 'infinity'), (5, '-infinity');
    SELECT id FROM t WHERE ts BETWEEN '2026-10-08 12:00:00+01'::timestamptz AND '2026-10-08 14:00:00+02'::timestamptz ORDER BY id;
    SELECT id FROM t WHERE ts > '2026-10-08 11:00:00+00'::timestamptz ORDER BY ts;
    SELECT id FROM t WHERE ts < '2026-10-08 11:00:00+00'::timestamptz ORDER BY ts;
}
expect {
    2
    3
    3
    4
    5
    1
}

test timestamptz-in-list {
    CREATE TABLE t (id int, ts timestamptz);
    INSERT INTO t VALUES (1, '2026-10-08 12:00:00+00'), (2, '2026-10-08 13:00:00+00');
    SELECT id FROM t WHERE ts IN ('2026-10-08 14:00:00+02'::timestamptz, 'infinity'::timestamptz);
}
expect {
    1
}

test timestamptz-null-handling {
    CREATE TABLE t (ts timestamptz);
    INSERT INTO t VALUES (NULL);
    SELECT coalesce(ts::text, 'null'), coalesce((ts + interval '1 day')::text, 'null'), coalesce(NULL::timestamptz, '2026-10-08 14:00:00+02'::timestamptz) FROM t;
}
expect {
    null|null|2026-10-08 12:00:00+00
}

test timestamptz-case-result {
    SELECT CASE WHEN true THEN '2026-10-08 14:00:00+02'::timestamptz END;
}
expect {
    2026-10-08 12:00:00+00
}

test timestamptz-domain {
    CREATE DOMAIN event_time AS timestamptz;
    CREATE TABLE t (ts event_time);
    INSERT INTO t VALUES ('2026-10-08 14:00:00+02');
    SELECT ts, '2026-10-08 14:00:00+02'::event_time FROM t;
}
expect {
    2026-10-08 12:00:00+00|2026-10-08 12:00:00+00
}

test timestamptz-domain-check {
    CREATE DOMAIN after_2000 AS timestamptz CHECK (VALUE > '2000-01-01 00:00:00+00'::timestamptz);
    SELECT '1999-12-31 23:00:00-02'::after_2000;
}
expect {
    2000-01-01 01:00:00+00
}

test timestamptz-check-constraint {
    CREATE TABLE t (starts timestamptz, ends timestamptz, CHECK (ends > starts));
    INSERT INTO t VALUES ('2026-10-08 12:00:00+00', '2026-10-08 13:00:00+02');
}
expect error {violates check constraint}

test timestamptz-infinity-plus-negative-infinity-interval {
    SELECT 'infinity'::timestamptz + interval '-infinity';
}
expect error {timestamp out of range}

test timestamptz-finite-plus-infinite-interval {
    SELECT '2026-10-08 12:00:00+00'::timestamptz + interval 'infinity', '2026-10-08 12:00:00+00'::timestamptz - interval 'infinity';
}
expect {
    infinity|-infinity
}

test timestamptz-difference-across-offsets {
    SELECT '2026-03-29 03:00:00+02'::timestamptz - '2026-03-29 01:00:00+01'::timestamptz;
}
expect {
    01:00:00
}

test timestamptz-text-comparison-uses-instant {
    SELECT CASE WHEN '2026-10-08 12:00:00.5+00'::timestamptz > '2026-10-08 12:00:00+00'::timestamptz THEN 'later' ELSE 'not later' END;
}
expect {
    later
}

test timestamptz-in-cast-subquery-same-for-every-spelling-and-index {
    CREATE DOMAIN dom_tz AS timestamptz;
    CREATE TABLE p (tz timestamptz, dz dom_tz);
    CREATE TABLE x (tz timestamptz, dz dom_tz);
    CREATE INDEX x_tz ON x (tz);
    CREATE INDEX x_dz ON x (dz);
    INSERT INTO p VALUES ('2026-01-05 03:00+00', '2026-01-05 03:00+00'), ('infinity', 'infinity');
    INSERT INTO x SELECT * FROM p;
    SELECT
        (SELECT count(*) FROM p WHERE dz IN (SELECT CAST('Jan 5 2026 05:30 +2:30' AS timestamptz))),
        (SELECT count(*) FROM x WHERE dz IN (SELECT CAST('20260105T030000Z' AS timestamptz))),
        (SELECT count(*) FROM p WHERE tz IN (SELECT CAST('Infinity' AS timestamptz) UNION ALL SELECT CAST('2026-01-05T05:00:00+02:00' AS timestamptz))),
        (SELECT count(*) FROM x WHERE tz IN (SELECT CAST('+infinity' AS timestamptz) UNION ALL SELECT CAST('2026-01-05 03:00Z' AS timestamptz))),
        (SELECT count(*) FROM x WHERE dz NOT IN (SELECT CAST('2026-01-05T03:00:00Z' AS timestamptz)));
}
expect {
    1|1|2|2|1
}
