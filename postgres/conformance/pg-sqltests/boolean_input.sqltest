# Casting text to boolean. PostgreSQL's boolean input accepts `true`/`false`,
# `t`/`f`, `yes`/`no`, `y`/`n`, `on`/`off` and `1`/`0`, case-insensitively and
# with surrounding whitespace ignored, plus any unambiguous prefix of the
# spelled-out words (`tr`, `fal`, `ye`, `of`). `o` is rejected because it
# could start either `on` or `off`. Anything else is an error.
#
# A cast used to reach the boolean type's integer storage directly, so every
# value came out false — `'true'::boolean` was false and `WHERE flag::boolean`
# matched nothing.
#
# A cast reports boolean on the wire, so these render as t/f like PostgreSQL.
# A boolean expression that is not a cast (`SELECT true`, `SELECT 1 = 1`) still
# renders 1/0, because nothing states its type.

@database :memory:

test cast-true-spellings-are-all-true {
    SELECT 'true'::boolean, 't'::boolean, 'yes'::boolean,
           'y'::boolean, 'on'::boolean, '1'::boolean;
}
expect {
    t|t|t|t|t|t
}

test cast-false-spellings-are-all-false {
    SELECT 'false'::boolean, 'f'::boolean, 'no'::boolean,
           'n'::boolean, 'off'::boolean, '0'::boolean;
}
expect {
    f|f|f|f|f|f
}

test cast-boolean-input-ignores-case-and-space {
    SELECT 'TRUE'::boolean, 'True'::boolean, '  true  '::boolean, ' YES '::boolean;
}
expect {
    t|t|t|t
}

# PostgreSQL accepts any unambiguous prefix of the spelled-out words.
test cast-boolean-accepts-unambiguous-prefixes {
    SELECT 'tr'::boolean, 'tru'::boolean, 'ye'::boolean,
           'fa'::boolean, 'fals'::boolean, 'of'::boolean;
}
expect {
    t|t|t|f|f|f
}

test cast-boolean-rejects-a-word-it-does-not-know {
    SELECT 'bogus'::boolean;
}
expect error {
    ^invalid input syntax for type boolean: "bogus"$
}

# `o` is short for both `on` and `off`, so PostgreSQL rejects it.
test cast-boolean-rejects-an-ambiguous-prefix {
    SELECT 'o'::boolean;
}
expect error {
    ^invalid input syntax for type boolean: "o"$
}

test cast-boolean-of-null-is-null {
    CREATE TABLE t_null (v boolean);
    INSERT INTO t_null VALUES ((NULL)::boolean);
    SELECT count(*), count(v) FROM t_null;
}
expect {
    1|0
}

# The value has to be right, not just its rendering: a broken cast used to
# send every row down the ELSE branch.
test cast-boolean-drives-a-conditional {
    SELECT CASE WHEN 'yes'::boolean THEN 'taken' ELSE 'missed' END;
}
expect {
    taken
}

test cast-boolean-filters-rows {
    CREATE TABLE flags (name text, raw text);
    INSERT INTO flags VALUES ('a', 'true'), ('b', 'off'), ('c', 'YES'), ('d', 'n');
    SELECT name FROM flags WHERE raw::boolean ORDER BY name;
}
expect {
    a
    c
}

# Inserting into a declared boolean column already applied the input
# function; it must accept the same spellings as the cast, and a column is
# where PostgreSQL's t/f rendering does come through.
test declared-boolean-column-accepts-the-same-spellings {
    CREATE TABLE b (v boolean);
    INSERT INTO b VALUES ('y'), ('n'), ('tr'), ('of');
    SELECT v FROM b;
}
expect {
    t
    f
    t
    f
}

test declared-boolean-column-rejects-a-word-it-does-not-know {
    CREATE TABLE b_bad (v boolean);
    INSERT INTO b_bad VALUES ('bogus');
}
expect error {
    ^invalid input syntax for type boolean: "bogus"$
}

# These shapes used to take the whole server down: a cast to a type whose
# input function is a bare call left the comparison hoisted out of the loop,
# reading a cursor that was never opened.
test boolean-cast-compared-against-a-column {
    CREATE TABLE cmp (b boolean);
    INSERT INTO cmp VALUES (true), (false);
    SELECT count(*) FROM cmp WHERE b = 'true'::boolean;
}
expect {
    1
}

test boolean-cast-in-a-group-by {
    CREATE TABLE grp (b boolean);
    INSERT INTO grp VALUES (true), (true);
    SELECT count(*) FROM grp GROUP BY 't'::boolean;
}
expect {
    2
}
