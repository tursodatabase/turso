# ALTER TABLE ... ENABLE/DISABLE ROW LEVEL SECURITY and FORCE/NO FORCE ROW
# LEVEL SECURITY through the PostgreSQL frontend. pg_class.relrowsecurity
# shows which tables have row-level security, and relforcerowsecurity which
# apply it to their owner too.

@database :memory:

test new-table-has-no-row-security {
    CREATE TABLE rls_new (id INT);
    SELECT relname FROM pg_class WHERE relname = 'rls_new' AND NOT relrowsecurity;
}
expect {
    rls_new
}

test enable-row-security-shows-in-pg-class {
    CREATE TABLE rls_enable (id INT);
    ALTER TABLE rls_enable ENABLE ROW LEVEL SECURITY;
    SELECT relname FROM pg_class WHERE relname = 'rls_enable' AND relrowsecurity;
}
expect {
    rls_enable
}

test enable-row-security-of-table-qualified-with-public {
    CREATE TABLE rls_public (id INT);
    ALTER TABLE public.rls_public ENABLE ROW LEVEL SECURITY;
    SELECT relname FROM pg_class WHERE relname = 'rls_public' AND relrowsecurity;
}
expect {
    rls_public
}

test enable-row-security-of-table-with-quoted-mixed-case-name {
    CREATE TABLE "RlsMixed" (id INT);
    ALTER TABLE "RlsMixed" ENABLE ROW LEVEL SECURITY;
    SELECT relname FROM pg_class WHERE relname = 'RlsMixed' AND relrowsecurity;
}
expect {
    RlsMixed
}

test enable-row-security-twice-keeps-it-enabled {
    CREATE TABLE rls_twice (id INT);
    ALTER TABLE rls_twice ENABLE ROW LEVEL SECURITY;
    ALTER TABLE rls_twice ENABLE ROW LEVEL SECURITY;
    SELECT relname FROM pg_class WHERE relname = 'rls_twice' AND relrowsecurity;
}
expect {
    rls_twice
}

test disable-row-security-hides-it-from-pg-class {
    CREATE TABLE rls_disable (id INT);
    ALTER TABLE rls_disable ENABLE ROW LEVEL SECURITY;
    ALTER TABLE rls_disable DISABLE ROW LEVEL SECURITY;
    SELECT relname FROM pg_class WHERE relname = 'rls_disable' AND NOT relrowsecurity;
}
expect {
    rls_disable
}

test disable-row-security-of-table-without-it {
    CREATE TABLE rls_never (id INT);
    ALTER TABLE rls_never DISABLE ROW LEVEL SECURITY;
    SELECT relname FROM pg_class WHERE relname = 'rls_never' AND NOT relrowsecurity;
}
expect {
    rls_never
}

test enable-row-security-affects-only-that-table {
    CREATE TABLE rls_one (id INT);
    CREATE TABLE rls_other (id INT);
    ALTER TABLE rls_one ENABLE ROW LEVEL SECURITY;
    SELECT relname FROM pg_class
    WHERE relname IN ('rls_one', 'rls_other') AND relrowsecurity;
}
expect {
    rls_one
}

test renamed-table-keeps-row-security {
    CREATE TABLE rls_before_rename (id INT);
    ALTER TABLE rls_before_rename ENABLE ROW LEVEL SECURITY;
    ALTER TABLE rls_before_rename RENAME TO rls_after_rename;
    CREATE TABLE rls_before_rename (id INT);
    SELECT relname, relrowsecurity::int FROM pg_class
    WHERE relname IN ('rls_before_rename', 'rls_after_rename')
    ORDER BY relname;
}
expect {
    rls_after_rename|1
    rls_before_rename|0
}

test table-created-with-name-of-dropped-table-has-no-row-security {
    CREATE TABLE rls_dropped (id INT);
    ALTER TABLE rls_dropped ENABLE ROW LEVEL SECURITY;
    DROP TABLE rls_dropped;
    CREATE TABLE rls_dropped (id INT);
    SELECT relname FROM pg_class WHERE relname = 'rls_dropped' AND NOT relrowsecurity;
}
expect {
    rls_dropped
}

test rolled-back-enable-leaves-no-row-security {
    CREATE TABLE rls_rollback (id INT);
    BEGIN;
    ALTER TABLE rls_rollback ENABLE ROW LEVEL SECURITY;
    ROLLBACK;
    SELECT relname FROM pg_class WHERE relname = 'rls_rollback' AND NOT relrowsecurity;
}
expect {
    rls_rollback
}

test enable-row-security-of-table-in-another-schema {
    CREATE SCHEMA rls_schema;
    CREATE TABLE rls_schema.rls_same_name (id INT);
    CREATE TABLE rls_same_name (id INT);
    ALTER TABLE rls_schema.rls_same_name ENABLE ROW LEVEL SECURITY;
    SELECT n.nspname, c.relrowsecurity::int
    FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
    WHERE c.relname = 'rls_same_name'
    ORDER BY n.nspname;
}
expect {
    public|0
    rls_schema|1
}

@skip-if postgres "PostgreSQL says the action cannot be performed on the view"
test enable-on-a-view-is-rejected {
    CREATE TABLE rls_view_table (id INT);
    CREATE VIEW rls_view AS SELECT id FROM rls_view_table;
    ALTER TABLE rls_view ENABLE ROW LEVEL SECURITY;
}
expect error {
    "rls_view" is not a table
}

test new-table-does-not-force-row-security {
    CREATE TABLE rls_force_new (id INT);
    SELECT relforcerowsecurity FROM pg_class WHERE relname = 'rls_force_new';
}
expect {
    f
}

test force-row-security-shows-in-pg-class {
    CREATE TABLE rls_force (id INT);
    ALTER TABLE rls_force FORCE ROW LEVEL SECURITY;
    SELECT relrowsecurity, relforcerowsecurity FROM pg_class WHERE relname = 'rls_force';
}
expect {
    f|t
}

test no-force-row-security-hides-it-from-pg-class {
    CREATE TABLE rls_no_force (id INT);
    ALTER TABLE rls_no_force ENABLE ROW LEVEL SECURITY;
    ALTER TABLE rls_no_force FORCE ROW LEVEL SECURITY;
    ALTER TABLE rls_no_force NO FORCE ROW LEVEL SECURITY;
    SELECT relrowsecurity, relforcerowsecurity FROM pg_class WHERE relname = 'rls_no_force';
}
expect {
    t|f
}

test disable-row-security-keeps-force {
    CREATE TABLE rls_disable_forced (id INT);
    ALTER TABLE rls_disable_forced ENABLE ROW LEVEL SECURITY;
    ALTER TABLE rls_disable_forced FORCE ROW LEVEL SECURITY;
    ALTER TABLE rls_disable_forced DISABLE ROW LEVEL SECURITY;
    SELECT relrowsecurity, relforcerowsecurity FROM pg_class
        WHERE relname = 'rls_disable_forced';
}
expect {
    f|t
}

test renamed-table-keeps-force-row-security {
    CREATE TABLE rls_force_before (id INT);
    ALTER TABLE rls_force_before FORCE ROW LEVEL SECURITY;
    ALTER TABLE rls_force_before RENAME TO rls_force_after;
    SELECT relforcerowsecurity FROM pg_class WHERE relname = 'rls_force_after';
}
expect {
    t
}

test rolled-back-force-leaves-row-security-unforced {
    CREATE TABLE rls_force_rollback (id INT);
    BEGIN;
    ALTER TABLE rls_force_rollback FORCE ROW LEVEL SECURITY;
    ROLLBACK;
    SELECT relforcerowsecurity FROM pg_class WHERE relname = 'rls_force_rollback';
}
expect {
    f
}

# Without policies, row-level security hides every row from the roles it
# applies to. FORCE makes it apply to the table's owner too.

test owner-reads-every-row-without-force {
    CREATE ROLE rls_owner_unforced;
    CREATE TABLE rls_unforced_rows (id INT);
    INSERT INTO rls_unforced_rows VALUES (1), (2);
    ALTER TABLE rls_unforced_rows ENABLE ROW LEVEL SECURITY;
    ALTER TABLE rls_unforced_rows OWNER TO rls_owner_unforced;
    SET ROLE rls_owner_unforced;
    SELECT count(*) FROM rls_unforced_rows;
}
expect {
    2
}

test force-hides-rows-from-the-owner {
    CREATE ROLE rls_owner_forced;
    CREATE TABLE rls_forced_rows (id INT);
    INSERT INTO rls_forced_rows VALUES (1), (2);
    ALTER TABLE rls_forced_rows ENABLE ROW LEVEL SECURITY;
    ALTER TABLE rls_forced_rows FORCE ROW LEVEL SECURITY;
    ALTER TABLE rls_forced_rows OWNER TO rls_owner_forced;
    SET ROLE rls_owner_forced;
    SELECT count(*) FROM rls_forced_rows;
}
expect {
    0
}

test force-refuses-inserts-by-the-owner {
    CREATE ROLE rls_owner_insert;
    CREATE TABLE rls_forced_insert (id INT);
    ALTER TABLE rls_forced_insert ENABLE ROW LEVEL SECURITY;
    ALTER TABLE rls_forced_insert FORCE ROW LEVEL SECURITY;
    ALTER TABLE rls_forced_insert OWNER TO rls_owner_insert;
    SET ROLE rls_owner_insert;
    INSERT INTO rls_forced_insert VALUES (1);
}
@sqlstate 42501
expect error {
    new row violates row-level security policy for table "rls_forced_insert"
}

test force-without-enable-leaves-the-owner-every-row {
    CREATE ROLE rls_owner_force_only;
    CREATE TABLE rls_force_only_rows (id INT);
    INSERT INTO rls_force_only_rows VALUES (1), (2);
    ALTER TABLE rls_force_only_rows FORCE ROW LEVEL SECURITY;
    ALTER TABLE rls_force_only_rows OWNER TO rls_owner_force_only;
    SET ROLE rls_owner_force_only;
    SELECT count(*) FROM rls_force_only_rows;
}
expect {
    2
}

test force-does-not-limit-a-superuser {
    CREATE TABLE rls_forced_superuser (id INT);
    INSERT INTO rls_forced_superuser VALUES (1), (2);
    ALTER TABLE rls_forced_superuser ENABLE ROW LEVEL SECURITY;
    ALTER TABLE rls_forced_superuser FORCE ROW LEVEL SECURITY;
    SELECT count(*) FROM rls_forced_superuser;
}
expect {
    2
}

test owner-forces-row-security-of-its-table {
    CREATE ROLE rls_owner_forcing;
    CREATE TABLE rls_forced_by_owner (id INT);
    ALTER TABLE rls_forced_by_owner OWNER TO rls_owner_forcing;
    SET ROLE rls_owner_forcing;
    ALTER TABLE rls_forced_by_owner FORCE ROW LEVEL SECURITY;
    RESET ROLE;
    SELECT relforcerowsecurity FROM pg_class WHERE relname = 'rls_forced_by_owner';
}
expect {
    t
}

test force-row-security-by-a-role-that-is-not-the-owner-fails {
    CREATE ROLE rls_not_owner;
    CREATE TABLE rls_force_not_theirs (id INT);
    SET ROLE rls_not_owner;
    ALTER TABLE rls_force_not_theirs FORCE ROW LEVEL SECURITY;
}
@sqlstate 42501
expect error {
    must be owner of table rls_force_not_theirs
}

test force-applies-the-policies-to-the-owner {
    CREATE ROLE rls_owner_with_policy;
    CREATE TABLE rls_forced_policy (id INT);
    INSERT INTO rls_forced_policy VALUES (1), (2), (3);
    ALTER TABLE rls_forced_policy ENABLE ROW LEVEL SECURITY;
    ALTER TABLE rls_forced_policy FORCE ROW LEVEL SECURITY;
    CREATE POLICY small_ids ON rls_forced_policy USING (id < 3);
    ALTER TABLE rls_forced_policy OWNER TO rls_owner_with_policy;
    SET ROLE rls_owner_with_policy;
    SELECT id FROM rls_forced_policy ORDER BY id;
}
expect {
    1
    2
}
