# Row-level security through the PostgreSQL frontend: ALTER TABLE ... ROW
# LEVEL SECURITY and SELECT policies. Roles belong to the whole server, not
# to one database, so every test uses its own role names. Superusers bypass
# row-level security, so each test switches to an ordinary role with SET ROLE
# before reading the table.

@database :memory:

test rls-superuser-sees-all-rows {
    DROP TABLE IF EXISTS rls_docs;
    CREATE TABLE rls_docs (id int, owner text);
    INSERT INTO rls_docs VALUES (1, 'rls_alice'), (2, 'rls_bob');
    ALTER TABLE rls_docs ENABLE ROW LEVEL SECURITY;
    SELECT id, owner FROM rls_docs ORDER BY id;
}
expect {
    1|rls_alice
    2|rls_bob
}

test rls-enabled-without-policies-hides-all-rows {
    DROP TABLE IF EXISTS rls_docs;
    CREATE ROLE rls_enabled_without_policies_hides_all_rows_alice;
    CREATE TABLE rls_docs (id int, owner text);
    INSERT INTO rls_docs VALUES (1, 'rls_enabled_without_policies_hides_all_rows_alice'), (2, 'rls_bob');
    GRANT SELECT ON rls_docs TO rls_enabled_without_policies_hides_all_rows_alice;
    ALTER TABLE rls_docs ENABLE ROW LEVEL SECURITY;
    SET ROLE rls_enabled_without_policies_hides_all_rows_alice;
    SELECT count(*) FROM rls_docs;
}
expect {
    0
}

test rls-disabled-ignores-policies {
    DROP TABLE IF EXISTS rls_docs;
    CREATE ROLE rls_disabled_ignores_policies_alice;
    CREATE TABLE rls_docs (id int, owner text);
    INSERT INTO rls_docs VALUES (1, 'rls_disabled_ignores_policies_alice'), (2, 'rls_bob');
    GRANT SELECT ON rls_docs TO rls_disabled_ignores_policies_alice;
    CREATE POLICY own_rows ON rls_docs USING (owner = current_user);
    SET ROLE rls_disabled_ignores_policies_alice;
    SELECT id FROM rls_docs ORDER BY id;
}
expect {
    1
    2
}

test rls-policy-filters-select {
    DROP TABLE IF EXISTS rls_docs;
    CREATE ROLE rls_policy_filters_select_alice;
    CREATE TABLE rls_docs (id int, owner text);
    INSERT INTO rls_docs VALUES (1, 'rls_policy_filters_select_alice'), (2, 'rls_bob'), (3, 'rls_policy_filters_select_alice');
    GRANT SELECT ON rls_docs TO rls_policy_filters_select_alice;
    ALTER TABLE rls_docs ENABLE ROW LEVEL SECURITY;
    CREATE POLICY own_rows ON rls_docs USING (owner = current_user);
    SET ROLE rls_policy_filters_select_alice;
    SELECT id, owner FROM rls_docs ORDER BY id;
}
expect {
    1|rls_policy_filters_select_alice
    3|rls_policy_filters_select_alice
}

test rls-policy-filters-count {
    DROP TABLE IF EXISTS rls_docs;
    CREATE ROLE rls_policy_filters_count_alice;
    CREATE TABLE rls_docs (id int, owner text);
    INSERT INTO rls_docs VALUES (1, 'rls_policy_filters_count_alice'), (2, 'rls_bob'), (3, 'rls_policy_filters_count_alice');
    GRANT SELECT ON rls_docs TO rls_policy_filters_count_alice;
    ALTER TABLE rls_docs ENABLE ROW LEVEL SECURITY;
    CREATE POLICY own_rows ON rls_docs FOR SELECT USING (owner = current_user);
    SET ROLE rls_policy_filters_count_alice;
    SELECT count(*) FROM rls_docs;
}
expect {
    2
}

test rls-policy-combines-with-user-where {
    DROP TABLE IF EXISTS rls_docs;
    CREATE ROLE rls_policy_combines_with_user_where_alice;
    CREATE TABLE rls_docs (id int primary key, owner text);
    INSERT INTO rls_docs VALUES (1, 'rls_policy_combines_with_user_where_alice'), (2, 'rls_bob'), (3, 'rls_policy_combines_with_user_where_alice');
    GRANT SELECT ON rls_docs TO rls_policy_combines_with_user_where_alice;
    ALTER TABLE rls_docs ENABLE ROW LEVEL SECURITY;
    CREATE POLICY own_rows ON rls_docs USING (owner = current_user);
    SET ROLE rls_policy_combines_with_user_where_alice;
    SELECT id FROM rls_docs WHERE id >= 2 ORDER BY id;
}
expect {
    3
}

test rls-policy-hides-row-from-primary-key-lookup {
    DROP TABLE IF EXISTS rls_docs;
    CREATE ROLE rls_policy_hides_row_from_primary_key_lookup_alice;
    CREATE TABLE rls_docs (id int primary key, owner text);
    INSERT INTO rls_docs VALUES (1, 'rls_policy_hides_row_from_primary_key_lookup_alice'), (2, 'rls_bob');
    GRANT SELECT ON rls_docs TO rls_policy_hides_row_from_primary_key_lookup_alice;
    ALTER TABLE rls_docs ENABLE ROW LEVEL SECURITY;
    CREATE POLICY own_rows ON rls_docs USING (owner = current_user);
    SET ROLE rls_policy_hides_row_from_primary_key_lookup_alice;
    SELECT count(*) FROM rls_docs WHERE id = 2;
}
expect {
    0
}

test rls-supabase-select-current-user-form {
    DROP TABLE IF EXISTS rls_docs;
    CREATE ROLE rls_supabase_select_current_user_form_alice;
    CREATE TABLE rls_docs (id int, owner text);
    INSERT INTO rls_docs VALUES (1, 'rls_supabase_select_current_user_form_alice'), (2, 'rls_bob');
    GRANT SELECT ON rls_docs TO rls_supabase_select_current_user_form_alice;
    ALTER TABLE rls_docs ENABLE ROW LEVEL SECURITY;
    CREATE POLICY own_rows ON rls_docs FOR SELECT USING ((SELECT current_user) = owner);
    SET ROLE rls_supabase_select_current_user_form_alice;
    SELECT id FROM rls_docs ORDER BY id;
}
expect {
    1
}

test rls-public-read-policy-shows-all-rows {
    DROP TABLE IF EXISTS rls_docs;
    CREATE ROLE rls_public_read_policy_shows_all_rows_alice;
    CREATE TABLE rls_docs (id int, owner text);
    INSERT INTO rls_docs VALUES (1, 'rls_public_read_policy_shows_all_rows_alice'), (2, 'rls_bob');
    GRANT SELECT ON rls_docs TO rls_public_read_policy_shows_all_rows_alice;
    ALTER TABLE rls_docs ENABLE ROW LEVEL SECURITY;
    CREATE POLICY readable ON rls_docs FOR SELECT USING (true);
    SET ROLE rls_public_read_policy_shows_all_rows_alice;
    SELECT id FROM rls_docs ORDER BY id;
}
expect {
    1
    2
}

test rls-policies-are-ored {
    DROP TABLE IF EXISTS rls_docs;
    CREATE ROLE rls_policies_are_ored_alice;
    CREATE TABLE rls_docs (id int, owner text, editor text);
    INSERT INTO rls_docs VALUES (1, 'rls_policies_are_ored_alice', 'rls_bob'), (2, 'rls_bob', 'rls_policies_are_ored_alice'), (3, 'rls_bob', 'rls_bob');
    GRANT SELECT ON rls_docs TO rls_policies_are_ored_alice;
    ALTER TABLE rls_docs ENABLE ROW LEVEL SECURITY;
    CREATE POLICY own_rows ON rls_docs USING (owner = current_user);
    CREATE POLICY edited_rows ON rls_docs FOR SELECT USING (editor = current_user);
    SET ROLE rls_policies_are_ored_alice;
    SELECT id FROM rls_docs ORDER BY id;
}
expect {
    1
    2
}

test rls-drop-policy-removes-filter {
    DROP TABLE IF EXISTS rls_docs;
    CREATE ROLE rls_drop_policy_removes_filter_alice;
    CREATE TABLE rls_docs (id int, owner text);
    INSERT INTO rls_docs VALUES (1, 'rls_drop_policy_removes_filter_alice'), (2, 'rls_bob');
    GRANT SELECT ON rls_docs TO rls_drop_policy_removes_filter_alice;
    ALTER TABLE rls_docs ENABLE ROW LEVEL SECURITY;
    CREATE POLICY own_rows ON rls_docs USING (owner = current_user);
    CREATE POLICY everything ON rls_docs USING (true);
    DROP POLICY everything ON rls_docs;
    SET ROLE rls_drop_policy_removes_filter_alice;
    SELECT id FROM rls_docs ORDER BY id;
}
expect {
    1
}

test rls-left-join-null-extends-hidden-rows {
    DROP TABLE IF EXISTS rls_docs;
    DROP TABLE IF EXISTS rls_ids;
    CREATE ROLE rls_left_join_null_extends_hidden_rows_alice;
    CREATE TABLE rls_ids (id int);
    INSERT INTO rls_ids VALUES (1), (2);
    CREATE TABLE rls_docs (id int, owner text);
    INSERT INTO rls_docs VALUES (1, 'rls_left_join_null_extends_hidden_rows_alice'), (2, 'rls_bob');
    GRANT SELECT ON rls_ids TO rls_left_join_null_extends_hidden_rows_alice;
    GRANT SELECT ON rls_docs TO rls_left_join_null_extends_hidden_rows_alice;
    ALTER TABLE rls_docs ENABLE ROW LEVEL SECURITY;
    CREATE POLICY own_rows ON rls_docs USING (owner = current_user);
    SET ROLE rls_left_join_null_extends_hidden_rows_alice;
    SELECT i.id, d.owner FROM rls_ids i LEFT JOIN rls_docs d ON d.id = i.id ORDER BY i.id;
}
expect {
    1|rls_left_join_null_extends_hidden_rows_alice
    2|
}

test rls-subquery-is-filtered {
    DROP TABLE IF EXISTS rls_docs;
    CREATE ROLE rls_subquery_is_filtered_alice;
    CREATE TABLE rls_docs (id int, owner text);
    INSERT INTO rls_docs VALUES (1, 'rls_subquery_is_filtered_alice'), (2, 'rls_bob');
    GRANT SELECT ON rls_docs TO rls_subquery_is_filtered_alice;
    ALTER TABLE rls_docs ENABLE ROW LEVEL SECURITY;
    CREATE POLICY own_rows ON rls_docs USING (owner = current_user);
    SET ROLE rls_subquery_is_filtered_alice;
    SELECT (SELECT max(id) FROM rls_docs), (SELECT count(*) FROM rls_docs WHERE owner = 'rls_bob');
}
expect {
    1|0
}
