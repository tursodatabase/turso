# Casts of text to uuid and jsonb, which read the text by the type's rules.

@database :memory:

test cast-text-to-uuid-prints-lowercase-digits-with-hyphens {
    SELECT 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11'::uuid;
    SELECT CAST('a0eebc999c0b4ef8bb6d6bb9bd380a11' AS uuid);
    SELECT ('a0eebc99' || '9c0b4ef8bb6d6bb9bd380a11')::uuid;
}
expect {
    a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
    a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
    a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
}

test cast-text-to-uuid-accepts-braces-and-a-hyphen-after-every-four-digits {
    SELECT '{a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11}'::uuid;
    SELECT 'a0ee-bc99-9c0b-4ef8-bb6d-6bb9-bd38-0a11'::uuid;
    SELECT '{a0eebc999c0b4ef8bb6d6bb9bd380a11}'::uuid;
}
expect {
    a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
    a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
    a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
}

test cast-text-to-uuid-compares-as-a-uuid {
    SELECT count(*) FROM (SELECT 1) AS one
    WHERE 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11'::uuid = 'a0eebc999c0b4ef8bb6d6bb9bd380a11'::uuid;
    SELECT 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11'::uuid::text;
}
expect {
    1
    a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
}

test cast-null-to-uuid-is-null {
    SELECT 5, coalesce(NULL::uuid::text, '<null>'), 6;
    SELECT 5, coalesce(nullif('', '')::uuid::text, '<null>'), 6;
}
expect {
    5|<null>|6
    5|<null>|6
}

test cast-text-that-is-not-a-uuid-errors {
    SELECT 'not-a-uuid'::uuid;
}
@sqlstate 22P02
expect error {
    invalid input syntax for type uuid: "not-a-uuid"
}

test cast-uuid-with-a-leading-space-errors {
    SELECT ' a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'::uuid;
}
@sqlstate 22P02
expect error {
    invalid input syntax for type uuid: " a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"
}

test cast-uuid-with-a-hyphen-after-two-digits-errors {
    SELECT ('a0-eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'::text)::uuid;
}
@sqlstate 22P02
expect error {
    invalid input syntax for type uuid: "a0-eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"
}

test cast-uuid-urn-errors {
    SELECT 'urn:uuid:a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'::uuid;
}
@sqlstate 22P02
expect error {
    invalid input syntax for type uuid: "urn:uuid:a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"
}

test uuid-column-reads-text-as-a-cast-to-uuid-does {
    CREATE TABLE ids (id int, u uuid DEFAULT 'a0ee-bc99-9c0b-4ef8-bb6d-6bb9-bd38-0a11');
    INSERT INTO ids VALUES (1, 'a0ee-bc99-9c0b-4ef8-bb6d-6bb9-bd38-0a11');
    INSERT INTO ids VALUES (2, '{A0EEBC999C0B4EF8BB6D6BB9BD380A11}');
    INSERT INTO ids (id) VALUES (3);
    INSERT INTO ids VALUES (4, NULL);
    UPDATE ids SET u = 'a0eebc99-9c0b-4ef8-bb6d-6bb9-bd38-0a11' WHERE id = 4;
    SELECT id, u FROM ids ORDER BY id;
    SELECT count(*) FROM ids WHERE u = '{a0ee-bc99-9c0b-4ef8-bb6d-6bb9-bd38-0a11}';
}
expect {
    1|a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
    2|a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
    3|a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
    4|a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
    4
}

test uuid-column-refuses-a-urn {
    CREATE TABLE ids (u uuid);
    INSERT INTO ids VALUES ('urn:uuid:a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11');
}
@sqlstate 22P02
expect error {
    invalid input syntax for type uuid: "urn:uuid:a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"
}

test pg-input-is-valid-reads-jsonb-as-a-cast-to-jsonb-does {
    SELECT CASE WHEN pg_input_is_valid('{"a": [1, 2]}', 'jsonb') THEN 'yes' ELSE 'no' END;
    SELECT CASE WHEN pg_input_is_valid('\{"a": 1', 'jsonb') THEN 'yes' ELSE 'no' END;
    SELECT CASE WHEN pg_input_is_valid('"\ud800"', 'jsonb') THEN 'yes' ELSE 'no' END;
    SELECT CASE WHEN pg_input_is_valid('"\u0000"', 'jsonb') THEN 'yes' ELSE 'no' END;
    SELECT CASE WHEN pg_input_is_valid('"\u0000"', 'json') THEN 'yes' ELSE 'no' END;
}
expect {
    yes
    no
    no
    no
    yes
}

test pg-input-error-info-of-jsonb-with-the-nul-escape {
    SELECT message, sql_error_code FROM pg_input_error_info('"\u0000"', 'jsonb');
}
expect {
    unsupported Unicode escape sequence|22P05
}

test pg-input-is-valid-reads-uuid-as-a-cast-to-uuid-does {
    SELECT CASE WHEN pg_input_is_valid('{a0ee-bc99-9c0b-4ef8-bb6d-6bb9-bd38-0a11}', 'uuid') THEN 'yes' ELSE 'no' END;
    SELECT CASE WHEN pg_input_is_valid(' a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', 'uuid') THEN 'yes' ELSE 'no' END;
    SELECT CASE WHEN pg_input_is_valid('a0-eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', 'uuid') THEN 'yes' ELSE 'no' END;
    SELECT CASE WHEN pg_input_is_valid('urn:uuid:a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', 'uuid') THEN 'yes' ELSE 'no' END;
}
expect {
    yes
    no
    no
    no
}

test cast-text-to-jsonb-can-be-read-with-json-operators {
    SELECT '{"role": "authenticated", "app_metadata": {"provider": "email"}}'::jsonb ->> 'role';
    SELECT ('\{"a": ' || '[1, 2]\}')::jsonb -> 'a' ->> 1;
    SELECT 5, coalesce(NULL::jsonb ->> 'a', '<null>'), 6;
}
expect {
    authenticated
    2
    5|<null>|6
}

test cast-text-that-is-not-json-to-jsonb-errors {
    SELECT 'not json'::jsonb;
}
@sqlstate 22P02
expect error {
    invalid input syntax for type json
}

test cast-text-with-half-an-object-to-jsonb-errors {
    SELECT ('\{"a": ' || '1')::jsonb;
}
@sqlstate 22P02
expect error {
    invalid input syntax for type json
}

test cast-json-with-a-lone-surrogate-to-jsonb-errors {
    SELECT '"\ud800"'::jsonb;
}
@sqlstate 22P02
expect error {
    invalid input syntax for type json
}

test cast-json-with-the-nul-escape-to-jsonb-errors {
    SELECT '{"a": "\u0000"}'::jsonb;
}
@sqlstate 22P05
expect error {
    unsupported Unicode escape sequence
}

# The translator calls a function of tursopg in front of a cast to jsonb.
# The text of a default does not show it.
@compat-gap "function:pg_get_expr"
test default-with-a-cast-to-jsonb-in-pg-get-expr {
    CREATE TABLE j (id int, d jsonb DEFAULT '{}'::jsonb);
    SELECT pg_get_expr(adbin, adrelid) FROM pg_attrdef;
}
expect {
    '{}'::jsonb
}
expect @tursopg {
    CAST ('{}' AS TEXT)
}

# A cast to jsonb reads the text with tursopg's jsonb_in, but a value
# written to a column of jsonb is read by core, whose message is
# `malformed JSON`, not PostgreSQL's `invalid input syntax for type json`.
test insert-text-that-is-not-json-into-a-jsonb-column {
    CREATE TABLE j (v jsonb);
    INSERT INTO j VALUES ('nope');
}
@sqlstate 22P02
expect error {}

test cast-boolean-and-text-to-jsonb {
    SELECT 'true'::jsonb, '5'::jsonb;
}
expect {
    true|5
}
