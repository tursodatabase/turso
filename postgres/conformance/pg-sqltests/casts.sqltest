# CAST between PostgreSQL types, as an explicit cast (SELECT 'v'::src::tgt)
# and as an assignment cast (INSERT of a src value into a tgt column).
# The answers come from PostgreSQL 18. Each test with a `@compat-gap` label
# records a case where tursopg gives another answer. Source values that
# tursopg reads differently from PostgreSQL are left out, so these tests
# check casts and not the input of the source type.

@database :memory:

test cast-int2-to-int4-explicit-0 {
    SELECT ('0'::int2::int4);
}
expect {
    0
}

test cast-int2-to-int4-explicit-1 {
    SELECT ('1'::int2::int4);
}
expect {
    1
}

test cast-int2-to-int4-explicit-2 {
    SELECT ('-1'::int2::int4);
}
expect {
    -1
}

test cast-int2-to-int4-explicit-3 {
    SELECT ('32767'::int2::int4);
}
expect {
    32767
}

test cast-int2-to-int4-assign-0 {
    CREATE TABLE t (x int4);
    INSERT INTO t VALUES ('0'::int2);
    SELECT x FROM t;
}
expect {
    0
}

test cast-int2-to-int4-assign-1 {
    CREATE TABLE t (x int4);
    INSERT INTO t VALUES ('1'::int2);
    SELECT x FROM t;
}
expect {
    1
}

