test bytea-of-an-int2-reads-as-an-int4-without-sign-extension {
    SELECT (-1)::int2::bytea::int4, (-1)::int2::bytea::int2, (-32768)::int2::bytea::int8;
}
expect {
    65535|-1|32768
}

test bytea-of-an-int4-reads-as-an-int8-without-sign-extension {
    SELECT (-1)::int4::bytea::int8, (-1)::int4::bytea::int4, (-2)::int8::bytea::int8;
}
expect {
    4294967295|-1|-2
}

test bytea-wider-than-the-integer-is-out-of-range {
    SELECT 70000::int4::bytea::int2;
}
@sqlstate 22003
expect error {}

@compat-gap "cast:float8 -> numeric"
test float-infinity-to-numeric {
    SELECT 'Infinity'::float8::numeric;
}
expect {
    Infinity
}
@sqlstate 0A000
expect @tursopg error {}

@compat-gap "cast:float4 -> numeric"
test float4-negative-infinity-to-numeric {
    SELECT '-Infinity'::float4::numeric;
}
expect {
    -Infinity
}
@sqlstate 0A000
expect @tursopg error {}
