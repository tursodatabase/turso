# The integer types smallint (int2), integer (int4) and bigint (int8) keep
# their values inside their range, and a cast to one of them reads text as
# PostgreSQL does.

@database :memory:

setup t_n {
    CREATE TABLE t (n int);
}

test int-columns-store-the-ends-of-their-range {
    CREATE TABLE t (s smallint, i integer, b bigint);
    INSERT INTO t VALUES
        (-32768, -2147483648, -9223372036854775808),
        (32767, 2147483647, 9223372036854775807);
    SELECT s, i, b FROM t ORDER BY i;
}
expect {
    -32768|-2147483648|-9223372036854775808
    32767|2147483647|9223372036854775807
}

test int2-int4-int8-name-the-same-types {
    CREATE TABLE t (s int2, i int4, j int, b int8);
    INSERT INTO t VALUES (1, 2, 3, 4);
    SELECT s, i, j, b FROM t;
}
expect {
    1|2|3|4
}

test smallint-column-refuses-a-value-above-its-range {
    CREATE TABLE t (n smallint);
    INSERT INTO t VALUES (32768);
}
@sqlstate 22003
expect error {
    smallint out of range
}

test smallint-column-refuses-a-value-below-its-range {
    CREATE TABLE t (n smallint);
    INSERT INTO t VALUES (-32769);
}
@sqlstate 22003
expect error {
    smallint out of range
}

@setup t_n
test integer-column-refuses-a-value-below-its-range {
    INSERT INTO t VALUES (-2147483649);
}
@sqlstate 22003
expect error {
    integer out of range
}

@setup t_n
test integer-column-refuses-an-update-out-of-its-range {
    INSERT INTO t VALUES (1);
    UPDATE t SET n = 2147483648;
}
@sqlstate 22003
expect error {
    integer out of range
}

@setup t_n
test integer-column-refuses-a-sum-out-of-its-range {
    INSERT INTO t VALUES (2147483647);
    UPDATE t SET n = n + 1;
}
@sqlstate 22003
expect error {
    integer out of range
}

@setup t_n
test integer-column-refuses-a-selected-value-out-of-its-range {
    INSERT INTO t SELECT 2147483648;
}
@sqlstate 22003
expect error {
    integer out of range
}

test integer-column-refuses-a-default-out-of-its-range {
    CREATE TABLE t (id int, n int DEFAULT 2147483648);
    INSERT INTO t (id) VALUES (1);
}
@sqlstate 22003
expect error {
    integer out of range
}

test integer-primary-key-refuses-a-value-out-of-its-range {
    CREATE TABLE t (id int PRIMARY KEY, v text);
    INSERT INTO t VALUES (2147483648, 'a');
}
@sqlstate 22003
expect error {
    integer out of range
}

test integer-primary-key-refuses-an-update-out-of-its-range {
    CREATE TABLE t (id int PRIMARY KEY, v text);
    INSERT INTO t VALUES (1, 'a');
    UPDATE t SET id = 2147483648;
}
@sqlstate 22003
expect error {
    integer out of range
}

test integer-primary-key-refuses-an-upsert-out-of-its-range {
    CREATE TABLE t (id int PRIMARY KEY, v text);
    INSERT INTO t VALUES (1, 'a');
    INSERT INTO t VALUES (1, 'b') ON CONFLICT (id) DO UPDATE SET id = 2147483648;
}
@sqlstate 22003
expect error {
    integer out of range
}

test integer-primary-key-stores-the-ends-of-its-range {
    CREATE TABLE t (id int PRIMARY KEY, v text);
    INSERT INTO t VALUES (2147483647, 'max'), (-2147483648, 'min');
    SELECT id, v FROM t WHERE id > 0;
    SELECT id, v FROM t WHERE id < 0;
}
expect {
    2147483647|max
    -2147483648|min
}

test serial-column-refuses-a-value-out-of-its-range {
    CREATE TABLE t (id serial PRIMARY KEY, v text);
    INSERT INTO t (id, v) VALUES (2147483648, 'a');
}
@sqlstate 22003
expect error {
    integer out of range
}

test integer-array-column-refuses-an-element-out-of-its-range {
    CREATE TABLE t (a int[]);
    INSERT INTO t VALUES (ARRAY[1, 2147483648]);
}
@sqlstate 22003
expect error {
    integer out of range
}

test domain-over-integer-refuses-a-value-out-of-its-range {
    CREATE DOMAIN posint AS integer CHECK (VALUE > 0);
    CREATE TABLE t (n posint);
    INSERT INTO t VALUES (2147483648);
}
@sqlstate 22003
expect error {
    integer out of range
}

test smallint-column-added-later-refuses-a-value-out-of-its-range {
    CREATE TABLE t (id int);
    INSERT INTO t VALUES (1);
    ALTER TABLE t ADD COLUMN n smallint;
    UPDATE t SET n = 40000;
}
@sqlstate 22003
expect error {
    smallint out of range
}

test int-columns-of-different-types-compare-and-add {
    CREATE TABLE t (s smallint, i integer, b bigint);
    INSERT INTO t VALUES (1, 2, 3), (4, 4, 4);
    SELECT s + i + b, s < i, i = b FROM t ORDER BY s;
}
expect {
    6|t|f
    12|f|t
}

test int-columns-of-different-types-join {
    CREATE TABLE a (id int PRIMARY KEY, s smallint);
    CREATE TABLE b (id bigint PRIMARY KEY, a_id int);
    INSERT INTO a VALUES (1, 10), (2, 20);
    INSERT INTO b VALUES (100, 1), (200, 2), (300, 2);
    SELECT a.s, count(*) FROM a JOIN b ON b.a_id = a.id GROUP BY a.s ORDER BY a.s;
}
expect {
    10|1
    20|2
}

# A primary key and an index of each integer type.

test smallint-primary-key-finds-and-orders-its-rows {
    CREATE TABLE t (id smallint PRIMARY KEY, v text);
    INSERT INTO t VALUES (300, 'c'), (-32768, 'min'), (32767, 'max'), (5, 'a');
    SELECT v FROM t WHERE id = 300;
    SELECT id FROM t WHERE id > 5 ORDER BY id DESC;
}
expect {
    c
    32767
    300
}

test bigint-primary-key-finds-and-orders-its-rows {
    CREATE TABLE t (id bigint PRIMARY KEY, v text);
    INSERT INTO t VALUES (3000000000, 'c'), (-9223372036854775808, 'min'), (9223372036854775807, 'max'), (5, 'a');
    SELECT v FROM t WHERE id = 3000000000;
    SELECT id FROM t WHERE id > 5 ORDER BY id DESC;
}
expect {
    c
    9223372036854775807
    3000000000
}

test smallint-primary-key-refuses-a-value-out-of-its-range {
    CREATE TABLE t (id smallint PRIMARY KEY, v text);
    INSERT INTO t VALUES (32768, 'a');
}
@sqlstate 22003
expect error {
    smallint out of range
}

test smallint-primary-key-refuses-an-update-out-of-its-range {
    CREATE TABLE t (id smallint PRIMARY KEY, v text);
    INSERT INTO t VALUES (32767, 'a');
    UPDATE t SET id = id + 1;
}
@sqlstate 22003
expect error {
    smallint out of range
}

test integer-primary-key-refuses-a-default-out-of-its-range {
    CREATE TABLE t (id int PRIMARY KEY DEFAULT 3000000000, v text);
    INSERT INTO t (v) VALUES ('a');
}
@sqlstate 22003
expect error {
    integer out of range
}

test smallint-primary-key-refuses-a-default-out-of-its-range-in-default-values {
    CREATE TABLE t (id smallint PRIMARY KEY DEFAULT 40000, v text);
    INSERT INTO t DEFAULT VALUES;
}
@sqlstate 22003
expect error {
    smallint out of range
}

test integer-primary-keys-take-their-default {
    CREATE TABLE t (id smallint PRIMARY KEY DEFAULT 5, v text);
    CREATE TABLE u (id bigint PRIMARY KEY DEFAULT 3000000000, v text);
    INSERT INTO t (v) VALUES ('a');
    INSERT INTO u VALUES (DEFAULT, 'b');
    SELECT id, v FROM t;
    SELECT id, v FROM u;
}
expect {
    5|a
    3000000000|b
}

test smallint-primary-key-refuses-a-duplicate {
    CREATE TABLE t (id smallint PRIMARY KEY, v text);
    INSERT INTO t VALUES (1, 'a');
    INSERT INTO t VALUES (1, 'b');
}
@sqlstate 23505
expect error {}

test bigint-primary-key-refuses-a-duplicate {
    CREATE TABLE t (id bigint PRIMARY KEY, v text);
    INSERT INTO t VALUES (3000000000, 'a');
    INSERT INTO t VALUES (3000000000, 'b');
}
@sqlstate 23505
expect error {}

test integer-primary-keys-refuse-null {
    CREATE TABLE t (id bigint PRIMARY KEY);
    INSERT INTO t VALUES (NULL);
}
@sqlstate 23502
expect error {}

test integer-primary-keys-refuse-an-update-to-null {
    CREATE TABLE s (id smallint PRIMARY KEY, v text);
    CREATE TABLE i (id integer PRIMARY KEY, v text);
    CREATE TABLE b (id bigint PRIMARY KEY, v text);
    INSERT INTO s VALUES (5, 'a');
    INSERT INTO i VALUES (5, 'a');
    INSERT INTO b VALUES (5, 'a');
    UPDATE s SET id = NULL;
}
@sqlstate 23502
expect error {
    null value in column "id" of relation "s" violates not-null constraint
}

test bigint-primary-key-refuses-an-upsert-to-null {
    CREATE TABLE b (id bigint PRIMARY KEY, v text);
    INSERT INTO b VALUES (5, 'a');
    INSERT INTO b VALUES (5, 'b') ON CONFLICT (id) DO UPDATE SET id = NULL;
}
@sqlstate 23502
expect error {}

test bigint-primary-key-upsert-and-update {
    CREATE TABLE t (id bigint PRIMARY KEY, v text);
    INSERT INTO t VALUES (1, 'a'), (2, 'b');
    INSERT INTO t VALUES (1, 'x') ON CONFLICT (id) DO UPDATE SET v = excluded.v;
    UPDATE t SET id = id + 3000000000 WHERE id = 2;
    SELECT id, v FROM t ORDER BY id;
}
expect {
    1|x
    3000000002|b
}

test bigserial-primary-key-takes-values-past-the-range-of-integer {
    CREATE TABLE t (id bigserial PRIMARY KEY, v text);
    INSERT INTO t (v) VALUES ('a'), ('b');
    INSERT INTO t VALUES (3000000000, 'c');
    SELECT id, v FROM t ORDER BY id;
}
expect {
    1|a
    2|b
    3000000000|c
}

test smallserial-column-refuses-a-value-out-of-its-range {
    CREATE TABLE t (id smallserial PRIMARY KEY, v text);
    INSERT INTO t (v) VALUES ('a');
    INSERT INTO t VALUES (40000, 'b');
}
@sqlstate 22003
expect error {
    smallint out of range
}

test primary-key-of-two-integer-types {
    CREATE TABLE t (a smallint, b bigint, v text, PRIMARY KEY (a, b));
    INSERT INTO t VALUES (1, 3000000000, 'x'), (1, 2, 'y'), (2, 2, 'z');
    SELECT v FROM t WHERE a = 1 AND b = 3000000000;
    SELECT a, b FROM t ORDER BY a, b;
}
expect {
    x
    1|2
    1|3000000000
    2|2
}

test primary-key-of-two-integer-types-refuses-a-duplicate {
    CREATE TABLE t (a smallint, b bigint, PRIMARY KEY (a, b));
    INSERT INTO t VALUES (1, 2);
    INSERT INTO t VALUES (1, 2);
}
@sqlstate 23505
expect error {}

test indexes-on-columns-of-each-integer-type {
    CREATE TABLE t (id bigint PRIMARY KEY, s smallint, i integer, b bigint);
    CREATE INDEX t_s ON t (s);
    CREATE INDEX t_i ON t (i);
    CREATE INDEX t_b ON t (b);
    CREATE INDEX t_s_b ON t (s, b);
    INSERT INTO t VALUES (1, 10, 100, 3000000000), (2, 20, 200, 6000000000), (3, 20, 300, 9000000000), (4, -5, NULL, NULL);
    SELECT id FROM t WHERE s = 20 ORDER BY id;
    SELECT id FROM t WHERE i BETWEEN 150 AND 350 ORDER BY i DESC;
    SELECT id FROM t WHERE b > 3000000000 AND s = 20 ORDER BY b;
    SELECT id FROM t WHERE s < 0;
    SELECT id FROM t WHERE i IS NULL;
}
expect {
    2
    3
    3
    2
    2
    3
    4
    4
}

test unique-index-on-a-bigint-column-refuses-a-duplicate {
    CREATE TABLE t (id smallint PRIMARY KEY, b bigint);
    CREATE UNIQUE INDEX t_b ON t (b);
    INSERT INTO t VALUES (1, 3000000000);
    INSERT INTO t VALUES (2, 3000000000);
}
@sqlstate 23505
expect error {}

test index-on-an-integer-column-follows-updates-and-deletes {
    CREATE TABLE t (id smallint PRIMARY KEY, n bigint);
    CREATE INDEX t_n ON t (n);
    INSERT INTO t VALUES (1, 10), (2, 20), (3, 30);
    UPDATE t SET n = n * 10 WHERE id = 2;
    DELETE FROM t WHERE n = 30;
    SELECT id, n FROM t WHERE n >= 10 ORDER BY n;
}
expect {
    1|10
    2|200
}

test foreign-key-columns-of-each-integer-type-join-their-keys {
    CREATE TABLE p (id bigint PRIMARY KEY, name text);
    CREATE TABLE c (id smallint PRIMARY KEY, p_id bigint REFERENCES p (id));
    CREATE INDEX c_p ON c (p_id);
    INSERT INTO p VALUES (3000000000, 'big'), (1, 'one');
    INSERT INTO c VALUES (1, 3000000000), (2, 3000000000), (3, 1);
    SELECT p.name, count(*) FROM p JOIN c ON c.p_id = p.id GROUP BY p.name ORDER BY p.name;
}
expect {
    big|2
    one|1
}

test pg-input-is-valid-reads-integers-as-the-types-do {
    SELECT pg_input_is_valid('0x10', 'integer'), pg_input_is_valid(' 7 ', 'bigint'),
        pg_input_is_valid('1.5', 'integer'), pg_input_is_valid('40000', 'smallint');
}
expect {
    t|t|f|f
}
