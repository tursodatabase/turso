# The lower bound of an array: the subscript of its first element.

@database :memory:

test array-bounds-are-read-and-printed {
    SELECT '[0:1]={a,b}'::text[], '[-2:0]={a,b,c}'::text[], '[5:5]={a}'::text[];
}
expect {
    [0:1]={a,b}|[-2:0]={a,b,c}|[5:5]={a}
}

test array-bounds-of-one-are-not-printed {
    SELECT '[1:2]={a,b}'::text[], '{a,b}'::text[];
}
expect {
    {a,b}|{a,b}
}

test array-bounds-allow-spaces-around-the-bounds {
    SELECT ' [0:1] = {a,b} '::text[];
}
expect {
    [0:1]={a,b}
}

test an-array-bound-of-one-number-is-the-upper-bound {
    SELECT '[2]={a,b}'::text[];
}
expect {
    {a,b}
}

test array-bounds-are-stored-in-a-column {
    CREATE TABLE t (id int, a text[]);
    INSERT INTO t VALUES (1, '[0:1]={a,b}'), (2, '{a,b}'), (3, '[7:8]={a,b}');
    SELECT a FROM t ORDER BY id;
}
expect {
    [0:1]={a,b}
    {a,b}
    [7:8]={a,b}
}

test arrays-with-other-bounds-are-different-values {
    SELECT '[0:1]={a,b}'::text[] = '{a,b}'::text[],
           '[0:1]={a,b}'::text[] <> '{a,b}'::text[],
           '[0:1]={a,b}'::text[] = '[0:1]={a,b}'::text[];
}
expect {
    f|t|t
}

test arrays-with-other-bounds-are-distinct {
    CREATE TABLE t (a text[]);
    INSERT INTO t VALUES ('{a,b}'), ('[0:1]={a,b}'), ('[0:1]={a,b}'), ('[1:2]={a,b}');
    SELECT count(*), count(DISTINCT a) FROM t;
}
expect {
    4|2
}

test array-bounds-are-kept-by-a-cast-of-the-elements {
    SELECT '[0:1]={1,2}'::int[], '[3:4]={1,2}'::bigint[], '[0:1]={1,2}'::smallint[];
}
expect {
    [0:1]={1,2}|[3:4]={1,2}|[0:1]={1,2}
}

test array-bounds-of-an-int-array-are-stored-in-a-column {
    CREATE TABLE t (a int[]);
    INSERT INTO t VALUES ('[0:2]={10,20,30}'), ('{10,20,30}');
    SELECT a FROM t ORDER BY a[1];
}
expect {
    {10,20,30}
    [0:2]={10,20,30}
}

test a-subscript-counts-from-the-lower-bound {
    CREATE TABLE t (a int[]);
    INSERT INTO t VALUES ('[0:2]={10,20,30}');
    SELECT a[-1], a[0], a[1], a[2], a[3] FROM t;
}
expect {
    |10|20|30|
}

test a-subscript-of-an-array-that-starts-at-one {
    CREATE TABLE t (a int[]);
    INSERT INTO t VALUES ('{10,20,30}');
    SELECT a[0], a[1], a[3], a[4] FROM t;
}
expect {
    |10|30|
}

test a-subscript-reads-a-column-with-another-lower-bound {
    CREATE TABLE t (a int[]);
    INSERT INTO t VALUES ('[5:6]={1,2}');
    SELECT a[4], a[5], a[6], a[7] FROM t;
}
expect {
    |1|2|
}

test a-slice-counts-from-the-lower-bound {
    CREATE TABLE t (a int[]);
    INSERT INTO t VALUES ('[0:2]={10,20,30}');
    SELECT a[0:1], a[1:2], a[0:5], a[-4:1], a[3:4] FROM t;
}
expect {
    {10,20}|{20,30}|{10,20,30}|{10,20}|{}
}

test a-slice-starts-at-one {
    CREATE TABLE t (a int[]);
    INSERT INTO t VALUES ('[5:7]={10,20,30}');
    SELECT a[5:6], a[6:9], array_position(a, 30) FROM t;
}
expect {
    {10,20}|{20,30}|7
}

test array-position-is-a-subscript {
    CREATE TABLE t (a int[]);
    INSERT INTO t VALUES ('[0:2]={10,20,30}'), ('{10,20,30}');
    SELECT array_position(a, 10), array_position(a, 20), array_position(a, 99) FROM t ORDER BY a[1];
}
expect {
    1|2|
    0|1|
}
