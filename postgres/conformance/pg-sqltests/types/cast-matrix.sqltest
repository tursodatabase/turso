# A type keeps its identity on the way to a cast, whatever name it is written
# with and whatever it is named.

test enum-named-like-a-built-in-type-is-cast-and-written {
    CREATE TYPE public.tid AS ENUM ('a', 'b');
    CREATE TABLE t (c public.tid);
    INSERT INTO t VALUES ('a'), ('b'::public.tid);
    SELECT c, c::text, 'b'::public.tid FROM t ORDER BY 1;
}
expect {
    a|a|b
    b|b|b
}

test domain-column-is-cast-as-its-base-type {
    CREATE DOMAIN posint AS bigint CHECK (VALUE > 0);
    CREATE TABLE t (c posint);
    INSERT INTO t VALUES (3000000000);
    SELECT c::int8, c::text FROM t;
    SELECT c::int4 FROM t;
}
@sqlstate 22003
expect error {}

test domain-column-over-smallint-has-no-cast-to-boolean {
    CREATE DOMAIN small AS smallint;
    CREATE TABLE t (c small);
    INSERT INTO t VALUES (1);
    SELECT c::boolean FROM t;
}
@sqlstate 42846
expect error {}

test array-of-a-registered-type-is-cast-and-written {
    CREATE TABLE t (b bigint[], u uuid[]);
    INSERT INTO t VALUES (ARRAY[1, 3000000000], ARRAY['a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'::uuid]);
    SELECT b, b::text[], u FROM t;
}
expect {
    {1,3000000000}|{1,3000000000}|{a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11}
}

test registered-column-types-are-cast-by-their-type {
    CREATE TABLE t (b bigint, s smallint, bo boolean, ts timestamp, u uuid);
    INSERT INTO t VALUES (9, 5, true, '2020-01-02 03:04:05', 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11');
    SELECT b::int4, b::int2, s::int8, s::text, bo::int4, bo::text, ts::text, u::text FROM t;
}
expect {
    9|9|5|5|1|true|2020-01-02 03:04:05|a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
}

test bigint-column-out-of-the-range-of-int4 {
    CREATE TABLE t (b bigint);
    INSERT INTO t VALUES (3000000000);
    SELECT b::int4 FROM t;
}
@sqlstate 22003
expect error {}

test smallint-and-bigint-columns-have-no-cast-to-boolean {
    CREATE TABLE t (s smallint);
    INSERT INTO t VALUES (1);
    SELECT s::boolean FROM t;
}
@sqlstate 42846
expect error {}

test boolean-column-has-no-cast-to-bigint {
    CREATE TABLE t (bo boolean);
    INSERT INTO t VALUES (true);
    SELECT bo::int8 FROM t;
}
@sqlstate 42846
expect error {}

test timestamp-column-has-no-cast-to-integer {
    CREATE TABLE t (ts timestamp);
    INSERT INTO t VALUES ('2020-01-02 03:04:05');
    SELECT ts::int4 FROM t;
}
@sqlstate 42846
expect error {}

test registered-columns-written-to-columns-of-other-types {
    CREATE TABLE s (b bigint, sm smallint, bo boolean);
    INSERT INTO s VALUES (9, 5, true);
    CREATE TABLE t (i int, x text, b2 bigint);
    INSERT INTO t SELECT b, bo, sm FROM s;
    SELECT i, x, b2 FROM t;
}
expect {
    9|true|5
}

test boolean-column-written-to-a-bigint-column {
    CREATE TABLE s (bo boolean);
    INSERT INTO s VALUES (true);
    CREATE TABLE t (b bigint);
    INSERT INTO t SELECT bo FROM s;
}
@sqlstate 42804
expect error {}

