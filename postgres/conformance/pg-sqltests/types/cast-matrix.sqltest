# Who decides each cast, and what it decides. A cast between two of the types
# int2, int4, int8, float4, float8, numeric, text, bool, timestamp,
# timestamptz, json and jsonb follows pg_cast. The engine decides the casts of
# date, uuid, bytea, inet, cidr, macaddr, oid, arrays, enums and domains by
# its own rules, and where those differ from PostgreSQL the test is a gap
# test. A cast of any other built-in type fails with 0A000.
#
# A test selects the value the cast gives. A cast to float4 or float8 selects
# the text of the value, because a float prints differently on the wire.

@database :memory:

# A cast written in the statement, between each pair of the types of pg_cast.

test cast-int2-to-int2 {
    SELECT (5::int2)::int2;
}
expect {
    5
}

test cast-int2-to-int4 {
    SELECT (5::int2)::int4;
}
expect {
    5
}

test cast-int2-to-int8 {
    SELECT (5::int2)::int8;
}
expect {
    5
}

test cast-int2-to-float4 {
    SELECT (5::int2)::float4::text;
}
expect {
    5
}

test cast-int2-to-float8 {
    SELECT (5::int2)::float8::text;
}
expect {
    5
}

@compat-gap "cast:int2 -> numeric"
test cast-int2-to-numeric {
    SELECT (5::int2)::numeric;
}
expect {
    5
}
expect @tursopg {
    5.0
}

test cast-int2-to-text {
    SELECT (5::int2)::text;
}
expect {
    5
}

test cast-int2-to-bool {
    SELECT (5::int2)::bool;
}
@sqlstate 42846
expect error {}

test cast-int2-to-timestamp {
    SELECT (5::int2)::timestamp;
}
@sqlstate 42846
expect error {}

test cast-int2-to-timestamptz {
    SELECT (5::int2)::timestamptz;
}
@sqlstate 42846
expect error {}

