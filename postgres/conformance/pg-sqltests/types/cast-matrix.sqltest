# Enums.

test cast-text-literal-to-enum {
    CREATE TYPE mood AS ENUM ('sad', 'happy');
    SELECT 'happy'::mood;
}
expect {
    happy
}

test cast-enum-to-text {
    CREATE TYPE mood AS ENUM ('sad', 'happy');
    SELECT 'happy'::mood::text;
}
expect {
    happy
}

test cast-text-to-enum {
    CREATE TYPE mood AS ENUM ('sad', 'happy');
    SELECT 'happy'::text::mood;
}
expect {
    happy
}

test cast-bad-text-literal-to-enum {
    CREATE TYPE mood AS ENUM ('sad', 'happy');
    SELECT 'nope'::mood;
}
@sqlstate 22P02
expect error {}

