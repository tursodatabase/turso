# A cast written in the statement, from and to the types the engine decides.

test cast-text-literal-to-date {
    SELECT '2020-01-02'::date;
}
expect {
    2020-01-02
}

test cast-date-to-text {
    SELECT '2020-01-02'::date::text;
}
expect {
    2020-01-02
}

test cast-date-to-int4 {
    SELECT '2020-01-02'::date::int4;
}
@sqlstate 42846
expect error {}

@compat-gap "cast:int4 -> date"
test cast-int4-to-date {
    SELECT 5::date;
}
@sqlstate 42846
expect error {}
@sqlstate 22007
expect @tursopg error {}

@compat-gap "cast:bool -> date"
test cast-bool-to-date {
    SELECT true::date;
}
@sqlstate 42846
expect error {}
@sqlstate 22007
expect @tursopg error {}

