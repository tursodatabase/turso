# Domains.

test cast-int4-to-domain {
    CREATE DOMAIN posint AS int CHECK (VALUE > 0);
    SELECT 5::posint;
}
expect {
    5
}

test cast-text-literal-to-domain {
    CREATE DOMAIN posint AS int CHECK (VALUE > 0);
    SELECT '5'::posint;
}
expect {
    5
}

test cast-numeric-to-domain-over-int4 {
    CREATE DOMAIN posint AS int CHECK (VALUE > 0);
    SELECT 2.5::posint;
}
expect {
    3
}

test cast-bool-to-domain-over-int4 {
    CREATE DOMAIN posint AS int CHECK (VALUE > 0);
    SELECT true::posint;
}
expect {
    1
}

test cast-to-domain-checks-its-constraint {
    CREATE DOMAIN posint AS int CHECK (VALUE > 0);
    SELECT (-1)::posint;
}
@sqlstate 23514
expect error {}

test cast-domain-to-text {
    CREATE DOMAIN posint AS int CHECK (VALUE > 0);
    SELECT 5::posint::text;
}
expect {
    5
}

test cast-domain-to-int8 {
    CREATE DOMAIN posint AS int CHECK (VALUE > 0);
    SELECT 5::posint::int8;
}
expect {
    5
}

test cast-domain-over-int4-to-bool {
    CREATE DOMAIN posint AS int CHECK (VALUE > 0);
    SELECT 5::posint::bool;
}
expect {
    t
}

