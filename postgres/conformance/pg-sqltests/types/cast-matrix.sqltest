# A value written to a column of an enum, a domain or an array type.

test assign-text-literal-to-enum-column {
    CREATE TYPE mood AS ENUM ('sad', 'happy');
    CREATE TABLE t (c mood);
    INSERT INTO t VALUES ('happy');
    SELECT c FROM t;
}
expect {
    happy
}

@compat-gap "cast:int4 -> anyenum"
test assign-int4-to-enum-column {
    CREATE TYPE mood AS ENUM ('sad', 'happy');
    CREATE TABLE t (c mood);
    INSERT INTO t VALUES (1);
    SELECT c FROM t;
}
@sqlstate 42804
expect error {}
@sqlstate 22P02
expect @tursopg error {}

test assign-enum-to-text-column {
    CREATE TYPE mood AS ENUM ('sad', 'happy');
    CREATE TABLE t (c text);
    INSERT INTO t VALUES ('happy'::mood);
    SELECT c FROM t;
}
expect {
    happy
}

@compat-gap "cast:anyenum -> int4"
test assign-enum-to-int4-column {
    CREATE TYPE mood AS ENUM ('sad', 'happy');
    CREATE TABLE t (c int);
    INSERT INTO t VALUES ('happy'::mood);
    SELECT c FROM t;
}
@sqlstate 42804
expect error {}
@sqlstate 23000
expect @tursopg error {}

test assign-int4-to-domain-column {
    CREATE DOMAIN posint AS int CHECK (VALUE > 0);
    CREATE TABLE t (c posint);
    INSERT INTO t VALUES (5);
    SELECT c FROM t;
}
expect {
    5
}

test assign-text-literal-to-domain-column {
    CREATE DOMAIN posint AS int CHECK (VALUE > 0);
    CREATE TABLE t (c posint);
    INSERT INTO t VALUES ('7');
    SELECT c FROM t;
}
expect {
    7
}

@compat-gap "cast:bool -> int4"
test assign-bool-to-domain-over-int4-column {
    CREATE DOMAIN posint AS int CHECK (VALUE > 0);
    CREATE TABLE t (c posint);
    INSERT INTO t VALUES (true);
    SELECT c FROM t;
}
@sqlstate 42804
expect error {}
expect @tursopg {
    1
}

test assign-domain-to-int4-column {
    CREATE DOMAIN posint AS int CHECK (VALUE > 0);
    CREATE TABLE t (c int);
    INSERT INTO t VALUES (5::posint);
    SELECT c FROM t;
}
expect {
    5
}

test assign-domain-to-text-column {
    CREATE DOMAIN posint AS int CHECK (VALUE > 0);
    CREATE TABLE t (c text);
    INSERT INTO t VALUES (5::posint);
    SELECT c FROM t;
}
expect {
    5
}

