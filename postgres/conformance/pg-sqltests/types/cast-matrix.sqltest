# A value written to a column, from and to the types the engine decides.

test assign-text-literal-to-date-column {
    CREATE TABLE t (c date);
    INSERT INTO t VALUES ('2020-01-02');
    SELECT c FROM t;
}
expect {
    2020-01-02
}

@compat-gap "cast:int4 -> date"
test assign-int4-to-date-column {
    CREATE TABLE t (c date);
    INSERT INTO t VALUES (5);
    SELECT c FROM t;
}
@sqlstate 42804
expect error {}
@sqlstate 22007
expect @tursopg error {}

@compat-gap "cast:date -> int4"
test assign-date-to-int4-column {
    CREATE TABLE t (c int);
    INSERT INTO t VALUES ('2020-01-02'::date);
    SELECT c FROM t;
}
@sqlstate 42804
expect error {}
@sqlstate 23000
expect @tursopg error {}

test assign-date-to-text-column {
    CREATE TABLE t (c text);
    INSERT INTO t VALUES ('2020-01-02'::date);
    SELECT c FROM t;
}
expect {
    2020-01-02
}

