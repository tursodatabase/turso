# The numeric type keeps exact decimals, rounds to the scale that is written, and fails with PostgreSQL's errors.

@database :memory:

test numeric-column-rounds-half-away-from-zero {
    CREATE TABLE t (n numeric(10,2));
    INSERT INTO t VALUES ('1.005'), ('2.675'), ('-1.005');
    SELECT n FROM t;
}
expect {
    1.01
    2.68
    -1.01
}

test numeric-column-rejects-text-that-is-not-a-number {
    CREATE TABLE t (n numeric(5,2));
    INSERT INTO t VALUES ('abc');
}
@sqlstate 22P02
expect error {}

test numeric-p-s-overflow {
    CREATE TABLE t (n numeric(5,2));
    INSERT INTO t VALUES (12345.678);
}
@sqlstate 22003
expect error {}

test numeric-column-without-precision-keeps-each-value-as-written {
    CREATE TABLE t (n numeric);
    INSERT INTO t VALUES ('123456789012345678901234567890.123'), ('1.50'), ('1e3'), (2);
    SELECT n FROM t;
}
expect {
    123456789012345678901234567890.123
    1.50
    1000
    2
}

test numeric-big-precision {
    SELECT '123456789012345678901234567890.123'::numeric;
}
expect {
    123456789012345678901234567890.123
}

test numeric-exponent-input {
    SELECT '1e3'::numeric, '1.50'::numeric;
}
expect {
    1000|1.50
}

test numeric-10-2-rounding-half-away-from-zero {
    SELECT '1.005'::numeric(10,2), '2.675'::numeric(10,2), '-1.005'::numeric(10,2);
}
expect {
    1.01|2.68|-1.01
}

test numeric-10-0-rounding {
    SELECT '2.5'::numeric(10,0), '3.5'::numeric(10,0);
}
expect {
    3|4
}

test numeric-cast-with-a-precision-only-has-scale-zero {
    SELECT '2.5'::numeric(10), '3.5'::numeric(10);
}
expect {
    3|4
}

test numeric-overflow-on-typmod {
    SELECT '123456.1'::numeric(5,2);
}
@sqlstate 22003
expect error {}

test invalid-numeric {
    SELECT 'abc'::numeric;
}
@sqlstate 22P02
expect error {}

test numeric-addition-is-exact {
    SELECT 0.1::numeric + 0.2::numeric;
}
expect {
    0.3
}

test jsonb-casts-to-numeric {
    CREATE TABLE j (f jsonb);
    INSERT INTO j VALUES ('1.5');
    SELECT f::numeric FROM j;
}
expect {
    1.5
}
