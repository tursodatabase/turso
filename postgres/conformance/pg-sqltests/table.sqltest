# Table DDL and DML through the PostgreSQL frontend: PostgreSQL type names,
# multi-row inserts, updates, deletes, aggregates, and grouping.

@database :memory:

setup users {
    CREATE TABLE users (id serial, name varchar(50), age int, active boolean);
    INSERT INTO users (id, name, age, active) VALUES
        (1, 'alice', 30, true),
        (2, 'bob', 25, false),
        (3, 'carol', 35, true);
}

@setup users
test table-select-all {
    SELECT id, name, age FROM users ORDER BY id;
}
expect {
    1|alice|30
    2|bob|25
    3|carol|35
}

@setup users
test table-where-boolean-column {
    SELECT name FROM users WHERE active ORDER BY name;
}
expect {
    alice
    carol
}

@setup users
test table-update {
    UPDATE users SET age = age + 1 WHERE name = 'bob';
    SELECT age FROM users WHERE name = 'bob';
}
expect {
    26
}

@setup users
test table-delete {
    DELETE FROM users WHERE age > 34;
    SELECT count(*) FROM users;
}
expect {
    2
}

@setup users
test table-aggregates {
    SELECT count(*), min(age), max(age) FROM users;
}
expect {
    3|25|35
}

@setup users
test table-group-by-having {
    SELECT active, count(*) FROM users GROUP BY active HAVING count(*) >= 2 ORDER BY active;
}
expect {
    t|2
}

@setup users
test table-order-by-limit {
    SELECT name FROM users ORDER BY age DESC LIMIT 2;
}
expect {
    carol
    alice
}

test table-insert-null {
    CREATE TABLE t (a int, b text);
    INSERT INTO t VALUES (1, NULL);
    SELECT a, b FROM t;
}
expect {
    1|
}

test table-join {
    CREATE TABLE dept (id int, name text);
    CREATE TABLE emp (id int, dept_id int, name text);
    INSERT INTO dept VALUES (1, 'eng'), (2, 'ops');
    INSERT INTO emp VALUES (1, 1, 'alice'), (2, 1, 'bob'), (3, 2, 'carol');
    SELECT d.name, e.name FROM emp e JOIN dept d ON e.dept_id = d.id ORDER BY e.id;
}
expect {
    eng|alice
    eng|bob
    ops|carol
}

# ---------------------------------------------------------------------------
# CREATE TABLE AS / SELECT INTO
# ---------------------------------------------------------------------------

@setup users
test table-create-table-as {
    CREATE TABLE adults AS SELECT id, name FROM users WHERE age >= 30;
    SELECT id, name FROM adults ORDER BY id;
}
expect {
    1|alice
    3|carol
}

test table-create-table-as-snapshot-not-view {
    CREATE TABLE src (id int);
    INSERT INTO src VALUES (1), (2);
    CREATE TABLE snap AS SELECT * FROM src;
    INSERT INTO src VALUES (3);
    SELECT count(*) FROM snap;
}
expect {
    2
}

test table-create-table-as-with-no-data {
    CREATE TABLE src (id int, name text);
    INSERT INTO src VALUES (1, 'alice'), (2, 'bob');
    CREATE TABLE dst AS SELECT * FROM src WITH NO DATA;
    SELECT count(*) FROM dst;
    INSERT INTO dst VALUES (7, 'new');
    SELECT id, name FROM dst;
}
expect {
    0
    7|new
}

test table-create-table-as-compound {
    CREATE TABLE dst AS SELECT 1 AS x UNION SELECT 2;
    SELECT x FROM dst ORDER BY x;
}
expect {
    1
    2
}

test table-create-table-as-if-not-exists {
    CREATE TABLE src (id int);
    INSERT INTO src VALUES (1);
    CREATE TABLE dst AS SELECT * FROM src;
    CREATE TABLE IF NOT EXISTS dst AS SELECT * FROM src;
    SELECT count(*) FROM dst;
}
expect {
    1
}

test table-select-into {
    CREATE TABLE src (id int, name text);
    INSERT INTO src VALUES (1, 'alice'), (2, 'bob');
    SELECT id, name INTO dst FROM src WHERE id = 2;
    SELECT name FROM dst;
}
expect {
    bob
}

test table-select-into-nested-rejected {
    SELECT * FROM (SELECT 1 INTO dst) sub;
}
@sqlstate 42601
expect error {}

test table-date-arithmetic {
    CREATE TABLE dates (a date, b date);
    INSERT INTO dates VALUES ('2025-01-05', '2025-01-01');
    SELECT a + 1, a - 1, a - b FROM dates;
}
expect {
    2025-01-06|2025-01-04|4
}

test table-indexed-date-column-with-default {
    CREATE TABLE dates (a int, b int, c date DEFAULT '2000-01-01');
    INSERT INTO dates VALUES (1, 2, '2024-05-06');
    CREATE INDEX dates_c ON dates (c);
    SELECT c FROM dates;
    SELECT a, c FROM dates WHERE c = '2024-05-06';
}
expect {
    2024-05-06
    1|2024-05-06
}

test table-cast-timestamp-column-to-date-and-time {
    CREATE TABLE events (ts timestamp);
    INSERT INTO events VALUES ('2024-01-15 10:30:00');
    SELECT ts::date, ts::time FROM events;
}
expect {
    2024-01-15|10:30:00
}

test table-check-on-smallint-column {
    CREATE TABLE t (n smallint DEFAULT 0 CHECK (n >= 0 AND n <= 2));
    INSERT INTO t VALUES (1) RETURNING n;
}
expect {
    1
}

test table-check-on-smallint-column-rejects-value-out-of-range {
    CREATE TABLE t (n smallint DEFAULT 0 CHECK (n >= 0 AND n <= 2));
    INSERT INTO t VALUES (3);
}
@sqlstate 23514
expect error {}

test table-check-compares-integer-types-of-different-sizes {
    CREATE TABLE t (a smallint, b integer, c bigint, CHECK (a < b AND b < c AND c > 0));
    INSERT INTO t VALUES (1, 2, 3);
    SELECT a, b, c FROM t;
}
expect {
    1|2|3
}

test table-delete-row-with-numeric-expression-index {
    CREATE TABLE prices (id int PRIMARY KEY, val numeric(10,2));
    CREATE INDEX prices_doubled ON prices ((val * 2));
    INSERT INTO prices VALUES (1, 1.50);
    DELETE FROM prices WHERE id = 1;
    SELECT count(*) FROM prices;
}
expect {
    0
}

test table-numeric-column-compared-with-expression {
    CREATE TABLE nm (v numeric(10,2));
    INSERT INTO nm VALUES (1.50);
    SELECT count(*) FROM nm WHERE v = 1.5 + 0;
    SELECT count(*) FROM nm WHERE v = (SELECT 1.5);
    SELECT count(*) FROM nm WHERE (SELECT 1.5) = v;
    SELECT count(*) FROM nm WHERE v < 1 + 1;
    SELECT count(*) FROM nm WHERE v <> 1.5 + 0;
    SELECT count(*) FROM nm WHERE v = 1.504 + 0;
}
expect {
    1
    1
    1
    1
    0
    0
}

test table-uuid-column-omitted-from-insert-is-null {
    CREATE TABLE t (id int PRIMARY KEY, u uuid);
    INSERT INTO t (id) VALUES (1);
    SELECT count(*) FROM t WHERE u IS NULL;
}
expect {
    1
}

test table-uuid-column-with-explicit-default-generates-uuid {
    CREATE TABLE t (id int PRIMARY KEY, u uuid DEFAULT gen_random_uuid());
    INSERT INTO t (id) VALUES (1);
    SELECT count(*) FROM t WHERE u IS NOT NULL;
}
expect {
    1
}

@setup users
test table-insert-returning-table-star {
    INSERT INTO users VALUES (4, 'dave', 40, false) RETURNING users.*;
}
expect {
    4|dave|40|f
}

@setup users
test table-update-returning-table-star {
    UPDATE users SET age = age + 1 WHERE name = 'bob' RETURNING users.*;
}
expect {
    2|bob|26|f
}

@setup users
test table-delete-returning-table-star {
    DELETE FROM users WHERE name = 'carol' RETURNING users.*;
}
expect {
    3|carol|35|t
}

@setup users
test table-returning-alias-star {
    INSERT INTO users AS u VALUES (5, 'eve', 20, true) RETURNING u.*;
    UPDATE users AS u SET age = 50 WHERE id = 1 RETURNING u.*;
    DELETE FROM users u WHERE id = 5 RETURNING id, u.*;
}
expect {
    5|eve|20|t
    1|alice|50|t
    5|5|eve|20|t
}

@setup users
test table-returning-schema-qualified-star {
    INSERT INTO public.users VALUES (4, 'dave', 40, false) RETURNING public.users.*;
    UPDATE public.users SET age = 50 WHERE id = 1 RETURNING public.users.*, users.*;
    DELETE FROM public.users WHERE id = 4 RETURNING public.users.*;
}
expect {
    4|dave|40|f
    1|alice|50|t|1|alice|50|t
    4|dave|40|f
}

@setup users
test table-returning-star-with-unknown-middle-name-rejected {
    INSERT INTO users VALUES (4, 'dave', 40, false) RETURNING users.zz.*;
}
@sqlstate 42P01
expect error {}

@setup users
test table-returning-star-with-other-schema-rejected {
    INSERT INTO public.users VALUES (4, 'dave', 40, false) RETURNING pg_catalog.users.*;
}
@sqlstate 42P01
expect error {}

@setup users
test table-returning-table-name-star-after-alias-rejected {
    INSERT INTO users AS u VALUES (4, 'dave', 40, false) RETURNING users.*;
}
@sqlstate 42P01
expect error {}

setup upsert {
    CREATE TABLE upsert_t (a int PRIMARY KEY, k int UNIQUE, b int);
    INSERT INTO upsert_t VALUES (1, 1, 0);
}

@setup upsert
test table-upsert-existing-row-updated-twice-rejected {
    INSERT INTO upsert_t VALUES (1, 10, 1), (1, 11, 5) ON CONFLICT (a) DO UPDATE SET b = excluded.b;
}
@sqlstate 21000
expect error {ON CONFLICT DO UPDATE command cannot affect row a second time}

@setup upsert
test table-upsert-inserted-row-updated-rejected {
    INSERT INTO upsert_t VALUES (2, 2, 1), (2, 3, 5) ON CONFLICT (a) DO UPDATE SET b = excluded.b;
}
@sqlstate 21000
expect error {ON CONFLICT DO UPDATE command cannot affect row a second time}

@setup upsert
test table-upsert-row-updated-twice-through-unique-column-rejected {
    INSERT INTO upsert_t VALUES (2, 1, 1), (3, 1, 5) ON CONFLICT (k) DO UPDATE SET b = excluded.b;
}
@sqlstate 21000
expect error {ON CONFLICT DO UPDATE command cannot affect row a second time}

@setup upsert
test table-upsert-row-with-changed-key-updated-again-rejected {
    INSERT INTO upsert_t VALUES (1, 10, 7), (10, 11, 5) ON CONFLICT (a) DO UPDATE SET a = 10;
}
@sqlstate 21000
expect error {ON CONFLICT DO UPDATE command cannot affect row a second time}

@setup upsert
test table-upsert-inserted-row-with-false-where-rejected {
    INSERT INTO upsert_t VALUES (2, 2, 1), (2, 3, 5) ON CONFLICT (a) DO UPDATE SET b = excluded.b WHERE false;
}
@sqlstate 21000
expect error {ON CONFLICT DO UPDATE command cannot affect row a second time}

@setup upsert
test table-upsert-existing-row-with-false-where-twice {
    INSERT INTO upsert_t VALUES (1, 10, 1), (1, 11, 5) ON CONFLICT (a) DO UPDATE SET b = excluded.b WHERE false;
    SELECT a, k, b FROM upsert_t ORDER BY a;
}
expect {
    1|1|0
}

@setup upsert
test table-upsert-different-rows-each-updated-once {
    INSERT INTO upsert_t VALUES (2, 2, 0);
    INSERT INTO upsert_t VALUES (1, 10, 1), (2, 20, 5), (3, 3, 9) ON CONFLICT (a) DO UPDATE SET b = excluded.b;
    SELECT a, k, b FROM upsert_t ORDER BY a;
}
expect {
    1|1|1
    2|2|5
    3|3|9
}

@setup upsert
test table-upsert-do-nothing-skips-repeated-key {
    INSERT INTO upsert_t VALUES (2, 2, 1), (2, 3, 5) ON CONFLICT (a) DO NOTHING;
    SELECT a, k, b FROM upsert_t ORDER BY a;
}
expect {
    1|1|0
    2|2|1
}

test table-named-with-a-bracket-at-the-start {
    CREATE TABLE "[t" (a int);
    INSERT INTO "[t" VALUES (1);
    SELECT a FROM "[t";
}
expect {
    1
}

test table-column-aliases-that-start-with-a-quote-character {
    CREATE TABLE t (a int);
    INSERT INTO t VALUES (1);
    SELECT a AS "[x", a AS """x" FROM t;
}
expect {
    1|1
}

test table-names-in-brackets-and-without-brackets-are-different-tables {
    CREATE TABLE "[t]" (a int);
    CREATE TABLE t (a int);
    INSERT INTO "[t]" VALUES (1);
    SELECT count(*) FROM t;
}
expect {
    0
}

test table-column-names-keep-their-quote-characters {
    CREATE TABLE t (x int, "'x'" int, "`x`" int, "[x]" int);
    INSERT INTO t VALUES (1, 2, 3, 4);
    SELECT x, "'x'", "`x`", "[x]" FROM t;
}
expect {
    1|2|3|4
}

test table-serial-column-of-a-table-whose-name-has-double-quotes {
    CREATE TABLE """t""" (id serial, v int);
    INSERT INTO """t""" (v) VALUES (5);
    INSERT INTO """t""" (v) VALUES (6);
    SELECT id, v FROM """t""" ORDER BY id;
}
expect {
    1|5
    2|6
}

test table-serial-column-whose-name-has-double-quotes {
    CREATE TABLE t ("""id""" serial, v int);
    INSERT INTO t (v) VALUES (5);
    SELECT """id""", v FROM t;
}
expect {
    1|5
}

test table-serial-column-of-a-table-whose-name-has-a-double-quote-inside {
    CREATE TABLE "a""b" (id serial, v int);
    INSERT INTO "a""b" (v) VALUES (5);
    SELECT id, v FROM "a""b";
}
expect {
    1|5
}

test table-sequence-whose-name-has-double-quotes {
    CREATE SEQUENCE """s""";
    SELECT sequencename FROM pg_sequences;
}
expect {
    "s"
}

test drop-materialized-view-on-a-view-errors {
    CREATE TABLE t (a int);
    CREATE VIEW v AS SELECT * FROM t;
    DROP MATERIALIZED VIEW v;
}
@sqlstate 42809
expect error {
    "v" is not a materialized view
}

test drop-materialized-view-if-exists-on-a-view-errors {
    CREATE TABLE t (a int);
    CREATE VIEW v AS SELECT * FROM t;
    DROP MATERIALIZED VIEW IF EXISTS public.v;
}
@sqlstate 42809
expect error {
    "v" is not a materialized view
}

test drop-view-on-a-table-errors {
    CREATE TABLE t (a int);
    DROP VIEW IF EXISTS t;
}
@sqlstate 42809
expect error {
    "t" is not a view
}

test table-domain-not-null-default-fills-omitted-column {
    CREATE DOMAIN nn_default AS int NOT NULL DEFAULT 3;
    CREATE TABLE t (a nn_default, b int);
    INSERT INTO t(b) VALUES (2);
    SELECT a, b FROM t;
}
expect {
    3|2
}

test table-domain-not-null-default-rejects-explicit-null {
    CREATE DOMAIN nn_default AS int NOT NULL DEFAULT 3;
    CREATE TABLE t (a nn_default, b int);
    INSERT INTO t VALUES (NULL, 2);
}
expect error {}

test table-add-column-function-default-fills-each-existing-row {
    CREATE TABLE t (x int);
    INSERT INTO t VALUES (1), (2);
    ALTER TABLE t ADD COLUMN c uuid DEFAULT gen_random_uuid();
    ALTER TABLE t ADD COLUMN d timestamptz DEFAULT now();
    SELECT count(c), count(DISTINCT c), count(d) FROM t;
}
expect {
    2|2|2
}

test table-add-column-expression-default-fills-existing-rows {
    CREATE TABLE t (x int);
    INSERT INTO t VALUES (1), (2);
    ALTER TABLE t ADD COLUMN e int DEFAULT (5 + 3);
    INSERT INTO t (x) VALUES (3);
    SELECT x, e FROM t ORDER BY x;
}
expect {
    1|8
    2|8
    3|8
}

test table-add-column-default-with-column-reference-errors {
    CREATE TABLE t (x int);
    INSERT INTO t VALUES (5);
    ALTER TABLE t ADD COLUMN c int DEFAULT x * 2;
}
expect error {}

test table-add-column-not-null-default-with-null-inside-fills-existing-rows {
    CREATE TABLE t (x int);
    INSERT INTO t VALUES (1), (2);
    ALTER TABLE t ADD COLUMN c int NOT NULL DEFAULT coalesce(NULL, 7);
    ALTER TABLE t ADD COLUMN d text NOT NULL DEFAULT CASE WHEN 1 < 2 THEN 'y' ELSE NULL END;
    SELECT x, c, d FROM t ORDER BY x;
}
expect {
    1|7|y
    2|7|y
}

test table-add-column-not-null-default-that-is-null-errors {
    CREATE TABLE t (x int);
    INSERT INTO t VALUES (1);
    ALTER TABLE t ADD COLUMN z int NOT NULL DEFAULT nullif(1, 1);
}
expect error {}

test add-column-fills-existing-rows-with-a-function-default {
    CREATE TABLE add_column_fill (id int);
    INSERT INTO add_column_fill VALUES (1), (2);
    ALTER TABLE add_column_fill ADD COLUMN schema_name text DEFAULT current_schema;
    SELECT id, schema_name FROM add_column_fill ORDER BY id;
}
expect {
    1|public
    2|public
}

test fk-orphan-insert-rejected {
    CREATE TABLE fko_p (id int PRIMARY KEY);
    CREATE TABLE fko_c (pid int REFERENCES fko_p (id));
    INSERT INTO fko_p VALUES (1);
    INSERT INTO fko_c VALUES (2);
}
expect error {
    violates foreign key constraint
}

test fk-on-delete-cascade {
    CREATE TABLE fkc_p (id int PRIMARY KEY);
    CREATE TABLE fkc_c (pid int REFERENCES fkc_p (id) ON DELETE CASCADE);
    INSERT INTO fkc_p VALUES (1), (2);
    INSERT INTO fkc_c VALUES (1), (2);
    DELETE FROM fkc_p WHERE id = 1;
    SELECT pid FROM fkc_c;
}
expect {
    2
}

test fk-drop-referenced-table-rejected {
    CREATE TABLE fkd_p (id int PRIMARY KEY);
    CREATE TABLE fkd_c (pid int REFERENCES fkd_p (id) ON DELETE CASCADE);
    DROP TABLE fkd_p;
}
expect error {
    cannot drop table fkd_p because other objects depend on it
}

test fk-drop-referenced-table-in-schema-rejected {
    CREATE SCHEMA fkd_s;
    CREATE TABLE fkd_s.p (id int PRIMARY KEY);
    CREATE TABLE fkd_s.c (pid int REFERENCES fkd_s.p (id));
    DROP TABLE fkd_s.p;
}
expect error {
    cannot drop table fkd_s.p because other objects depend on it
}

test fk-drop-referenced-unique-index-rejected {
    CREATE TABLE fki_p (id int, u int);
    CREATE UNIQUE INDEX fki_pu ON fki_p (u);
    CREATE TABLE fki_c (pid int REFERENCES fki_p (u));
    DROP INDEX fki_pu;
}
expect error {
    cannot drop index fki_pu because other objects depend on it
}

test fk-drop-referenced-unique-index-in-schema-rejected {
    CREATE SCHEMA fki_s;
    CREATE TABLE fki_s.p (id int, u int);
    CREATE UNIQUE INDEX pu ON fki_s.p (u);
    CREATE TABLE fki_s.c (pid int REFERENCES fki_s.p (u));
    DROP INDEX fki_s.pu;
}
expect error {
    cannot drop index fki_s.pu because other objects depend on it
}

test fk-drop-index-not-used-by-foreign-key {
    CREATE TABLE fkin_p (id int PRIMARY KEY, u int);
    CREATE UNIQUE INDEX fkin_pu ON fkin_p (u);
    CREATE TABLE fkin_c (pid int REFERENCES fkin_p (id));
    DROP INDEX fkin_pu;
    INSERT INTO fkin_p VALUES (1, 1);
    INSERT INTO fkin_c VALUES (1);
    SELECT pid FROM fkin_c;
}
expect {
    1
}

test fk-truncate-referenced-table-rejected {
    CREATE TABLE fkt_p (id int PRIMARY KEY);
    CREATE TABLE fkt_c (pid int REFERENCES fkt_p (id) ON DELETE CASCADE);
    INSERT INTO fkt_p VALUES (1);
    INSERT INTO fkt_c VALUES (1);
    TRUNCATE fkt_p;
}
expect error {
    cannot truncate a table referenced in a foreign key constraint
}

test fk-drop-child-then-parent {
    CREATE TABLE fkdc_p (id int PRIMARY KEY);
    CREATE TABLE fkdc_c (pid int REFERENCES fkdc_p (id));
    INSERT INTO fkdc_p VALUES (1);
    INSERT INTO fkdc_c VALUES (1);
    TRUNCATE fkdc_c;
    DROP TABLE fkdc_c;
    DROP TABLE fkdc_p;
    SELECT count(*) FROM pg_tables WHERE tablename LIKE 'fkdc%';
}
expect {
    0
}

test fk-self-referencing-update-delete-truncate-drop {
    CREATE TABLE fks_t (id int PRIMARY KEY, parent int REFERENCES fks_t (id));
    INSERT INTO fks_t VALUES (1, NULL), (2, 1), (3, 2);
    UPDATE fks_t SET id = id + 10, parent = parent + 10;
    SELECT id, coalesce(parent, 0) FROM fks_t ORDER BY id;
    DELETE FROM fks_t;
    SELECT count(*) FROM fks_t;
    INSERT INTO fks_t VALUES (1, NULL), (2, 1);
    TRUNCATE fks_t;
    SELECT count(*) FROM fks_t;
    INSERT INTO fks_t VALUES (1, NULL), (2, 1);
    DROP TABLE fks_t;
    SELECT count(*) FROM pg_tables WHERE tablename = 'fks_t';
}
expect {
    11|0
    12|11
    13|12
    0
    0
    0
}

test fk-self-referencing-update-child-before-parent {
    CREATE TABLE fkcb_t (id int PRIMARY KEY, parent int REFERENCES fkcb_t (id));
    INSERT INTO fkcb_t VALUES (5, NULL), (1, 5);
    UPDATE fkcb_t SET id = id + 10, parent = parent + 10;
    SELECT id, coalesce(parent, 0) FROM fkcb_t ORDER BY id;
}
expect {
    11|15
    15|0
}

# Row 2 moves to id 107 and takes parent 2, a key that no row has once the
# statement ends.
test fk-self-referencing-update-new-parent-is-own-old-key {
    CREATE TABLE fkok_t (id int PRIMARY KEY, parent int REFERENCES fkok_t (id));
    INSERT INTO fkok_t VALUES (1, NULL), (2, 1), (3, 2);
    UPDATE fkok_t SET id = CASE WHEN id = 2 THEN 107 ELSE id END, parent = parent + 1;
}
expect error {
}

# PostgreSQL checks RESTRICT against the rows the statement leaves.
test fk-restrict-self-referencing-delete-and-update {
    CREATE TABLE fkrd_t (id int PRIMARY KEY, parent int REFERENCES fkrd_t (id) ON DELETE RESTRICT);
    INSERT INTO fkrd_t VALUES (1, NULL), (2, 1);
    DELETE FROM fkrd_t;
    SELECT count(*) FROM fkrd_t;
    CREATE TABLE fkru_t (id int PRIMARY KEY, parent int REFERENCES fkru_t (id) ON UPDATE RESTRICT);
    INSERT INTO fkru_t VALUES (1, NULL), (2, 1);
    UPDATE fkru_t SET id = id + 10, parent = parent + 10;
    SELECT id, coalesce(parent, 0) FROM fkru_t ORDER BY id;
}
expect {
    0
    11|0
    12|11
}

# One row frees a referenced key and a later row takes it, so no child is
# left without a parent when the statement ends.
test fk-update-moves-referenced-key-to-another-row {
    CREATE TABLE fkm_p (id int PRIMARY KEY);
    CREATE TABLE fkm_c (pid int REFERENCES fkm_p (id));
    INSERT INTO fkm_p VALUES (1), (2);
    INSERT INTO fkm_c VALUES (1);
    UPDATE fkm_p SET id = CASE id WHEN 1 THEN 3 WHEN 2 THEN 1 END;
    SELECT id FROM fkm_p ORDER BY id;
}
expect {
    1
    3
}

# RESTRICT, unlike NO ACTION, fails even when another row takes the old key.
test fk-restrict-update-key-taken-by-another-row-rejected {
    CREATE TABLE fkrk_p (id int PRIMARY KEY);
    CREATE TABLE fkrk_c (pid int REFERENCES fkrk_p (id) ON UPDATE RESTRICT);
    INSERT INTO fkrk_p VALUES (1), (2);
    INSERT INTO fkrk_c VALUES (1);
    UPDATE fkrk_p SET id = id - 1;
}
expect error {
}

test fk-self-referencing-update-key-and-reference-with-action {
    CREATE TABLE fksn_t (k int PRIMARY KEY, f int REFERENCES fksn_t (k) ON UPDATE SET NULL);
    INSERT INTO fksn_t VALUES (5, NULL), (1, 5);
    UPDATE fksn_t SET k = k + 10, f = f + 10;
    SELECT k, coalesce(f, 0) FROM fksn_t ORDER BY k;
    CREATE TABLE fkuc_t (k int PRIMARY KEY, f int REFERENCES fkuc_t (k) ON UPDATE CASCADE);
    INSERT INTO fkuc_t VALUES (5, NULL), (1, 5);
    UPDATE fkuc_t SET k = k + 10, f = f + 10;
    SELECT k, coalesce(f, 0) FROM fkuc_t ORDER BY k;
}
expect {
    11|15
    15|0
    11|15
    15|0
}

test fk-restrict-delete-referenced-parent-rejected {
    CREATE TABLE fkrp_p (id int PRIMARY KEY);
    CREATE TABLE fkrp_c (pid int REFERENCES fkrp_p (id) ON DELETE RESTRICT);
    INSERT INTO fkrp_p VALUES (1);
    INSERT INTO fkrp_c VALUES (1);
    DELETE FROM fkrp_p;
}
expect error {
}

test fk-unqualified-reference-found-in-other-schema {
    CREATE SCHEMA fkss;
    CREATE TABLE fkss_p (id int PRIMARY KEY);
    SET search_path = fkss, public;
    CREATE TABLE fkss_c (pid int REFERENCES fkss_p (id));
    INSERT INTO fkss_p VALUES (1);
    INSERT INTO fkss_c VALUES (1);
    INSERT INTO fkss_c VALUES (2);
}
expect error {
    violates foreign key constraint
}

test fk-drop-table-referenced-from-other-schema-rejected {
    CREATE SCHEMA fksp;
    CREATE TABLE fksp.p (id int PRIMARY KEY);
    CREATE TABLE fksp_c (pid int REFERENCES fksp.p (id));
    DROP TABLE fksp.p;
}
expect error {
    cannot drop table fksp.p because other objects depend on it
}

test fk-drop-table-referenced-by-same-named-table-in-other-schema-rejected {
    CREATE SCHEMA fkn_a;
    CREATE SCHEMA fkn_b;
    CREATE TABLE fkn_b.t (id int PRIMARY KEY);
    CREATE TABLE fkn_a.t (pid int REFERENCES fkn_b.t (id));
    DROP TABLE fkn_b.t;
}
expect error {
    cannot drop table fkn_b.t because other objects depend on it
}

test fk-unqualified-reference-in-same-schema {
    CREATE SCHEMA fksq;
    SET search_path = fksq, public;
    CREATE TABLE fksq_p (id int PRIMARY KEY);
    CREATE TABLE fksq_c (pid int REFERENCES fksq_p (id));
    INSERT INTO fksq_p VALUES (1);
    INSERT INTO fksq_c VALUES (1);
    SELECT count(*) FROM fksq_c;
}
expect {
    1
}

test fk-create-table-referencing-missing-table-rejected {
    CREATE TABLE fkmt_c (pid int REFERENCES fkmt_nosuch (id));
}
expect error {
    relation "fkmt_nosuch" does not exist
}

test fk-create-table-referencing-missing-column-rejected {
    CREATE TABLE fkmc_p (id int PRIMARY KEY);
    CREATE TABLE fkmc_c (pid int REFERENCES fkmc_p (nosuch));
}
expect error {
    column "nosuch" referenced in foreign key constraint does not exist
}

test fk-create-table-referencing-non-unique-column-rejected {
    CREATE TABLE fknu_p (id int PRIMARY KEY, v int);
    CREATE TABLE fknu_c (pv int REFERENCES fknu_p (v));
}
expect error {
    there is no unique constraint matching given keys for referenced table "fknu_p"
}

# PostgreSQL finds a unique key with the same columns in any order.
@skip-if postgres "PostgreSQL accepts a foreign key listing the key columns in another order"
test fk-create-table-composite-key-in-other-order-rejected {
    CREATE TABLE fkro_p (a int, b int, PRIMARY KEY (a, b));
    CREATE TABLE fkro_c (x int, y int, FOREIGN KEY (x, y) REFERENCES fkro_p (b, a));
}
expect error {
    there is no unique constraint matching given keys for referenced table "fkro_p"
}
