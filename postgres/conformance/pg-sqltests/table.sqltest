# Table DDL and DML through the PostgreSQL frontend: PostgreSQL type names,
# multi-row inserts, updates, deletes, aggregates, and grouping.

@database :memory:

setup users {
    CREATE TABLE users (id serial, name varchar(50), age int, active boolean);
    INSERT INTO users (id, name, age, active) VALUES
        (1, 'alice', 30, true),
        (2, 'bob', 25, false),
        (3, 'carol', 35, true);
}

@setup users
test table-select-all {
    SELECT id, name, age FROM users ORDER BY id;
}
expect {
    1|alice|30
    2|bob|25
    3|carol|35
}

@setup users
test table-where-boolean-column {
    SELECT name FROM users WHERE active ORDER BY name;
}
expect {
    alice
    carol
}

@setup users
test table-update {
    UPDATE users SET age = age + 1 WHERE name = 'bob';
    SELECT age FROM users WHERE name = 'bob';
}
expect {
    26
}

@setup users
test table-delete {
    DELETE FROM users WHERE age > 34;
    SELECT count(*) FROM users;
}
expect {
    2
}

test table-delete-using-empty-source {
    CREATE TABLE target (id int);
    CREATE TABLE source (id int);
    INSERT INTO target VALUES (1), (2);
    DELETE FROM target USING source;
    SELECT id FROM target ORDER BY id;
}
expect {
    1
    2
}

test table-delete-using-matches {
    CREATE TABLE target (id int, name text);
    CREATE TABLE source (target_id int);
    INSERT INTO target VALUES (1, 'keep'), (2, 'delete'), (3, 'keep');
    INSERT INTO source VALUES (2), (2), (NULL);
    DELETE FROM target AS t USING source AS s WHERE t.id = s.target_id RETURNING id, name;
    SELECT id FROM target ORDER BY id;
}
expect {
    2|delete
    1
    3
}

test table-delete-using-self-join {
    CREATE TABLE target (id int, parent_id int);
    INSERT INTO target VALUES (1, NULL), (2, 1), (3, 2);
    DELETE FROM target AS child USING target AS parent WHERE child.parent_id = parent.id;
    SELECT id FROM target ORDER BY id;
}
expect {
    1
}

test table-delete-using-without-where {
    CREATE TABLE target (id int);
    CREATE TABLE source (id int);
    INSERT INTO target VALUES (1), (2);
    INSERT INTO source VALUES (9), (10);
    DELETE FROM target USING source;
    SELECT count(*) FROM target;
    SELECT count(*) FROM source;
}
expect {
    0
    2
}

test table-delete-using-multiple-tables {
    CREATE TABLE target (id int);
    CREATE TABLE first_source (first_id int);
    CREATE TABLE second_source (second_id int);
    INSERT INTO target VALUES (1), (2), (3);
    INSERT INTO first_source VALUES (1), (2);
    INSERT INTO second_source VALUES (2), (3);
    DELETE FROM target USING first_source, second_source
        WHERE id = first_id AND first_id = second_id;
    SELECT id FROM target ORDER BY id;
}
expect {
    1
    3
}

test table-delete-using-join {
    CREATE TABLE target (id int);
    CREATE TABLE first_source (first_id int, second_id int);
    CREATE TABLE second_source (id int);
    INSERT INTO target VALUES (1), (2), (3);
    INSERT INTO first_source VALUES (1, 8), (2, 9);
    INSERT INTO second_source VALUES (9);
    DELETE FROM target AS t
        USING first_source AS a JOIN second_source AS b ON a.second_id = b.id
        WHERE t.id = a.first_id;
    SELECT id FROM target ORDER BY id;
}
expect {
    1
    3
}

test table-delete-using-outer-join {
    CREATE TABLE target (id int);
    CREATE TABLE first_source (id int);
    CREATE TABLE second_source (id int);
    INSERT INTO target VALUES (1), (2), (3);
    INSERT INTO first_source VALUES (1), (2);
    INSERT INTO second_source VALUES (2), (3);
    DELETE FROM target AS t
        USING first_source AS a FULL JOIN second_source AS b ON a.id = b.id
        WHERE t.id = coalesce(a.id, b.id);
    SELECT count(*) FROM target;
}
expect {
    0
}

test table-delete-using-cte {
    CREATE TABLE target (id int);
    INSERT INTO target VALUES (1), (2), (3);
    WITH source AS (SELECT id FROM target WHERE id >= 2)
    DELETE FROM target USING source WHERE target.id = source.id;
    SELECT id FROM target ORDER BY id;
}
expect {
    1
}

test table-delete-using-subquery {
    CREATE TABLE target (id int);
    INSERT INTO target VALUES (1), (2), (3);
    DELETE FROM target AS t USING (SELECT 2 AS id) AS s
        WHERE t.id = s.id AND EXISTS (SELECT 1 WHERE s.id = t.id);
    SELECT id FROM target ORDER BY id;
}
expect {
    1
    3
}

test table-delete-using-shadowed-rowid {
    CREATE TABLE target (rowid int, _rowid_ int, oid int, id int);
    CREATE TABLE source (id int);
    INSERT INTO target VALUES (7, 7, 7, 1), (7, 7, 7, 2);
    INSERT INTO source VALUES (2);
    DELETE FROM target USING source WHERE target.id = source.id RETURNING *;
    SELECT id FROM target;
}
expect {
    7|7|7|2|2
    1
}

test table-delete-using-returning-source {
    CREATE TABLE target (id int, name text);
    CREATE TABLE source (target_id int, reason text);
    INSERT INTO target VALUES (1, 'keep'), (2, 'delete');
    INSERT INTO source VALUES (2, 'expired'), (2, 'expired');
    DELETE FROM target AS t USING source AS s WHERE t.id = s.target_id
        RETURNING t.*, s.*, t.name || ':' || s.reason, (SELECT s.reason);
    SELECT id FROM target;
}
expect {
    2|delete|2|expired|delete:expired|expired
    1
}

test table-delete-using-returning-selected-source-columns {
    CREATE TABLE target (id int);
    CREATE TABLE first_source (id int, unused text, label text);
    CREATE TABLE second_source (id int, unused text, reason text);
    INSERT INTO target VALUES (1), (2);
    INSERT INTO first_source VALUES (2, 'skip first', 'selected');
    INSERT INTO second_source VALUES (2, 'skip second', 'expired');
    DELETE FROM target USING first_source AS a, second_source AS b
        WHERE target.id = a.id AND a.id = b.id
        RETURNING a.label, (SELECT b.reason WHERE b.id = target.id), a.label;
    SELECT id FROM target;
}
expect {
    selected|expired|selected
    1
}

test table-delete-using-returning-target-only {
    CREATE TABLE target (id int);
    CREATE TABLE source (target_id int, unused text);
    INSERT INTO target VALUES (1), (2);
    INSERT INTO source VALUES (2, 'first'), (2, 'second');
    DELETE FROM target USING source WHERE target.id = source.target_id
        RETURNING target.*, (SELECT target.id);
    SELECT id FROM target;
}
expect {
    2|2
    1
}

test table-delete-using-returning-self-join {
    CREATE TABLE target (id int, parent_id int);
    INSERT INTO target VALUES (1, NULL), (2, 1), (3, 2);
    DELETE FROM target AS child USING target AS parent
        WHERE child.parent_id = parent.id AND child.id = 3
        RETURNING child.id, parent.id, (SELECT parent.id + child.id);
}
expect {
    3|2|5
}

test table-delete-using-returning-once {
    CREATE SEQUENCE returned;
    CREATE TABLE target (id int);
    CREATE TABLE source (target_id int);
    INSERT INTO target VALUES (1);
    INSERT INTO source VALUES (1), (1), (1);
    DELETE FROM target USING source WHERE id = target_id RETURNING nextval('returned');
    SELECT currval('returned');
}
expect {
    1
    1
}

test table-delete-using-returning-source-types {
    CREATE TABLE target (id int);
    CREATE TABLE source (target_id int, active boolean, tags int[], token uuid);
    INSERT INTO target VALUES (1);
    INSERT INTO source VALUES (1, true, ARRAY[2, 3], '12345678-1234-1234-1234-123456789abc');
    DELETE FROM target USING source WHERE id = target_id
        RETURNING active, array_length(tags, 1), token::text;
}
expect {
    t|2|12345678-1234-1234-1234-123456789abc
}

test table-delete-using-returning-source-array-expressions {
    CREATE TABLE target (id int);
    CREATE TABLE source (id int, tags int[]);
    INSERT INTO target VALUES (1), (3);
    INSERT INTO source VALUES (1, ARRAY[2, 3]), (3, NULL);
    DELETE FROM target USING source AS s WHERE target.id = s.id
        RETURNING target.id, s.tags[1], (s.tags = ARRAY[2, 3])::int, s.tags, array_length(s.tags, 1);
}
expect unordered {
    1|2|1|{2,3}|2
    3||||
}

test table-delete-using-returning-source-array-subqueries {
    CREATE TABLE target (id int);
    CREATE TABLE source (id int, tags int[]);
    INSERT INTO target VALUES (1);
    INSERT INTO source VALUES (1, ARRAY[2, 3]);
    DELETE FROM target USING source AS s WHERE target.id = s.id
        RETURNING (SELECT s.tags[1]), (SELECT (s.tags = ARRAY[2, 3])::int), s.tags;
}
expect {
    2|1|{2,3}
}

test table-delete-using-returning-deleted-source {
    CREATE TABLE target (id int, parent_id int);
    INSERT INTO target VALUES (1, NULL), (2, 1), (3, 2), (4, 3);
    DELETE FROM target AS child USING target AS parent
        WHERE child.parent_id = parent.id RETURNING child.id, parent.id;
}
expect unordered {
    2|1
    3|2
    4|3
}

test table-delete-using-returning-qualified-star {
    CREATE TABLE target (target_id int);
    CREATE TABLE first_source (id int, label text);
    CREATE TABLE second_source (id int, reason text);
    INSERT INTO target VALUES (1);
    INSERT INTO first_source VALUES (1, 'left');
    INSERT INTO second_source VALUES (1, 'right');
    DELETE FROM target USING first_source AS a JOIN second_source AS b USING (id)
        WHERE target_id = a.id RETURNING b.*;
}
expect {
    1|right
}

test table-delete-using-indexed-primary-key {
    CREATE TABLE target (id integer PRIMARY KEY, name text UNIQUE);
    CREATE TABLE source (id integer PRIMARY KEY);
    INSERT INTO target VALUES (1, 'keep'), (2, 'delete');
    INSERT INTO source VALUES (2);
    DELETE FROM target AS t USING source AS s WHERE t.id = s.id RETURNING t.id, s.id;
    INSERT INTO target VALUES (2, 'delete');
    SELECT id, name FROM target ORDER BY id;
}
expect {
    2|2
    1|keep
    2|delete
}

test table-delete-using-attached-schema {
    CREATE SCHEMA delete_using_target_schema;
    DROP TABLE IF EXISTS delete_using_target_schema.target;
    CREATE TABLE delete_using_target_schema.target (id int);
    CREATE TABLE source (target_id int);
    INSERT INTO delete_using_target_schema.target VALUES (1), (2);
    INSERT INTO source VALUES (2);
    DELETE FROM delete_using_target_schema.target AS t USING source AS s WHERE t.id = s.target_id
        RETURNING t.id, s.target_id;
    SELECT id FROM delete_using_target_schema.target;
}
expect {
    2|2
    1
}

test table-delete-using-right-join {
    CREATE TABLE target (target_id int);
    CREATE TABLE first_source (first_id int);
    CREATE TABLE second_source (second_id int);
    INSERT INTO target VALUES (2);
    INSERT INTO first_source VALUES (1);
    INSERT INTO second_source VALUES (2);
    DELETE FROM target USING first_source RIGHT JOIN second_source ON first_id = second_id
        WHERE target_id = second_id RETURNING *;
}
expect {
    2||2
}

test table-delete-using-same-name-in-different-schemas {
    CREATE SCHEMA delete_using_first_schema;
    CREATE SCHEMA delete_using_second_schema;
    DROP TABLE IF EXISTS delete_using_first_schema.target;
    CREATE TABLE delete_using_first_schema.target (id int);
    DROP TABLE IF EXISTS delete_using_second_schema.target;
    CREATE TABLE delete_using_second_schema.target (id int);
    INSERT INTO delete_using_first_schema.target VALUES (1), (2);
    INSERT INTO delete_using_second_schema.target VALUES (2);
    DELETE FROM delete_using_first_schema.target USING delete_using_second_schema.target
        WHERE delete_using_first_schema.target.id = delete_using_second_schema.target.id;
    SELECT id FROM delete_using_first_schema.target;
}
expect {
    1
}

test table-delete-using-schema-alias-conflict {
    CREATE SCHEMA delete_using_conflict_first;
    CREATE SCHEMA delete_using_conflict_second;
    DROP TABLE IF EXISTS delete_using_conflict_first.target;
    CREATE TABLE delete_using_conflict_first.target (id int);
    DROP TABLE IF EXISTS delete_using_conflict_second.target;
    CREATE TABLE delete_using_conflict_second.target (id int);
    DELETE FROM delete_using_conflict_first.target USING delete_using_conflict_second.target AS target;
}
expect error {}

test table-delete-using-returning-schema-qualified-source {
    CREATE SCHEMA delete_using_returning_source;
    DROP TABLE IF EXISTS delete_using_returning_source.source;
    CREATE TABLE delete_using_returning_source.source (id int, reason text);
    CREATE TABLE target (id int);
    INSERT INTO target VALUES (1), (2), (3);
    INSERT INTO delete_using_returning_source.source VALUES (2, 'two'), (3, 'three');
    DELETE FROM target USING delete_using_returning_source.source
        WHERE target.id = delete_using_returning_source.source.id
        RETURNING delete_using_returning_source.source.reason, source.reason, target.id;
    SELECT id FROM target;
}
expect unordered {
    two|two|2
    three|three|3
    1
}

test table-delete-using-returning-schema-qualified-subquery {
    CREATE SCHEMA delete_using_returning_subquery;
    DROP TABLE IF EXISTS delete_using_returning_subquery.source;
    CREATE TABLE delete_using_returning_subquery.source (id int, reason text);
    CREATE TABLE target (id int);
    INSERT INTO target VALUES (1), (2), (3);
    INSERT INTO delete_using_returning_subquery.source VALUES (2, 'two'), (3, 'three');
    DELETE FROM target USING delete_using_returning_subquery.source
        WHERE target.id = delete_using_returning_subquery.source.id
        RETURNING (SELECT delete_using_returning_subquery.source.reason),
            (SELECT source.reason WHERE delete_using_returning_subquery.source.id = target.id),
            target.id;
    SELECT id FROM target;
}
expect unordered {
    two|two|2
    three|three|3
    1
}

test table-delete-using-returning-ambiguous-star {
    CREATE SCHEMA delete_using_ambiguous_star;
    DROP TABLE IF EXISTS delete_using_ambiguous_star.target;
    CREATE TABLE delete_using_ambiguous_star.target (id int);
    CREATE TABLE target (id int);
    INSERT INTO target VALUES (1);
    INSERT INTO delete_using_ambiguous_star.target VALUES (1);
    DELETE FROM target USING delete_using_ambiguous_star.target
        RETURNING target.*;
}
expect error {
    ambiguous
}

test table-delete-using-returning-source-rowid {
    CREATE TABLE target (id int);
    CREATE TABLE source (id int);
    INSERT INTO target VALUES (1);
    INSERT INTO source VALUES (1);
    DELETE FROM target USING source AS s WHERE target.id = s.id RETURNING s.rowid;
}
expect error {
    rowid
}

test table-delete-using-returning-source-rowid-column {
    CREATE TABLE target (id int);
    CREATE TABLE source (id int, rowid int);
    INSERT INTO target VALUES (1);
    INSERT INTO source VALUES (1, 42);
    DELETE FROM target USING source AS s WHERE target.id = s.id
        RETURNING s.rowid, (SELECT s.rowid);
}
expect {
    42|42
}

test table-delete-using-returning-source-rowid-subquery {
    CREATE TABLE target (id int);
    CREATE TABLE source (id int);
    INSERT INTO target VALUES (1);
    INSERT INTO source VALUES (1);
    DELETE FROM target USING source AS s WHERE target.id = s.id
        RETURNING (SELECT (SELECT s.rowid));
}
expect error {
    rowid
}

test table-delete-using-ambiguous-column {
    CREATE TABLE target (id int);
    CREATE TABLE source (id int);
    DELETE FROM target USING source WHERE id = 1;
}
expect error {}

test table-delete-using-ambiguous-returning {
    CREATE TABLE target (id int);
    CREATE TABLE source (id int);
    DELETE FROM target USING source WHERE target.id = source.id RETURNING id;
}
expect error {}

test table-delete-using-duplicate-alias {
    CREATE TABLE target (id int);
    CREATE TABLE source (id int);
    DELETE FROM target AS t USING source AS t WHERE t.id = 1;
}
expect error {}

test table-delete-using-duplicate-source-alias {
    CREATE TABLE target (id int);
    CREATE TABLE source (id int);
    DELETE FROM target USING source AS s, source AS s;
}
expect error {}

test table-delete-using-hidden-target-name {
    CREATE TABLE target (id int);
    CREATE TABLE source (id int);
    DELETE FROM target AS t USING source WHERE target.id = source.id;
}
expect error {}

test table-delete-using-target-in-source-subquery {
    CREATE TABLE target (id int);
    DELETE FROM target AS t USING (SELECT t.id) AS s WHERE t.id = s.id;
}
expect error {}

test table-delete-using-target-in-join-condition {
    CREATE TABLE target (id int);
    CREATE TABLE source (id int);
    DELETE FROM target AS t USING source AS a JOIN source AS b ON b.id = t.id;
}
expect error {}

@setup users
test table-aggregates {
    SELECT count(*), min(age), max(age) FROM users;
}
expect {
    3|25|35
}

@setup users
test table-group-by-having {
    SELECT active, count(*) FROM users GROUP BY active HAVING count(*) >= 2 ORDER BY active;
}
expect {
    t|2
}

@setup users
test table-order-by-limit {
    SELECT name FROM users ORDER BY age DESC LIMIT 2;
}
expect {
    carol
    alice
}

test table-insert-null {
    CREATE TABLE t (a int, b text);
    INSERT INTO t VALUES (1, NULL);
    SELECT a, b FROM t;
}
expect {
    1|
}

test table-join {
    CREATE TABLE dept (id int, name text);
    CREATE TABLE emp (id int, dept_id int, name text);
    INSERT INTO dept VALUES (1, 'eng'), (2, 'ops');
    INSERT INTO emp VALUES (1, 1, 'alice'), (2, 1, 'bob'), (3, 2, 'carol');
    SELECT d.name, e.name FROM emp e JOIN dept d ON e.dept_id = d.id ORDER BY e.id;
}
expect {
    eng|alice
    eng|bob
    ops|carol
}

# ---------------------------------------------------------------------------
# CREATE TABLE AS / SELECT INTO
# ---------------------------------------------------------------------------

@setup users
test table-create-table-as {
    CREATE TABLE adults AS SELECT id, name FROM users WHERE age >= 30;
    SELECT id, name FROM adults ORDER BY id;
}
expect {
    1|alice
    3|carol
}

test table-create-table-as-snapshot-not-view {
    CREATE TABLE src (id int);
    INSERT INTO src VALUES (1), (2);
    CREATE TABLE snap AS SELECT * FROM src;
    INSERT INTO src VALUES (3);
    SELECT count(*) FROM snap;
}
expect {
    2
}

test table-create-table-as-with-no-data {
    CREATE TABLE src (id int, name text);
    INSERT INTO src VALUES (1, 'alice'), (2, 'bob');
    CREATE TABLE dst AS SELECT * FROM src WITH NO DATA;
    SELECT count(*) FROM dst;
    INSERT INTO dst VALUES (7, 'new');
    SELECT id, name FROM dst;
}
expect {
    0
    7|new
}

test table-create-table-as-compound {
    CREATE TABLE dst AS SELECT 1 AS x UNION SELECT 2;
    SELECT x FROM dst ORDER BY x;
}
expect {
    1
    2
}

test table-create-table-as-if-not-exists {
    CREATE TABLE src (id int);
    INSERT INTO src VALUES (1);
    CREATE TABLE dst AS SELECT * FROM src;
    CREATE TABLE IF NOT EXISTS dst AS SELECT * FROM src;
    SELECT count(*) FROM dst;
}
expect {
    1
}

test table-select-into {
    CREATE TABLE src (id int, name text);
    INSERT INTO src VALUES (1, 'alice'), (2, 'bob');
    SELECT id, name INTO dst FROM src WHERE id = 2;
    SELECT name FROM dst;
}
expect {
    bob
}

test table-select-into-nested-rejected {
    SELECT * FROM (SELECT 1 INTO dst) sub;
}
expect error {}
