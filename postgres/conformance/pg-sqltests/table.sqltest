# Table DDL and DML through the PostgreSQL frontend: PostgreSQL type names,
# multi-row inserts, updates, deletes, aggregates, and grouping.

@database :memory:

setup users {
    CREATE TABLE users (id serial, name varchar(50), age int, active boolean);
    INSERT INTO users (id, name, age, active) VALUES
        (1, 'alice', 30, true),
        (2, 'bob', 25, false),
        (3, 'carol', 35, true);
}

@setup users
test table-select-all {
    SELECT id, name, age FROM users ORDER BY id;
}
expect {
    1|alice|30
    2|bob|25
    3|carol|35
}

@setup users
test table-where-boolean-column {
    SELECT name FROM users WHERE active ORDER BY name;
}
expect {
    alice
    carol
}

@setup users
test table-update {
    UPDATE users SET age = age + 1 WHERE name = 'bob';
    SELECT age FROM users WHERE name = 'bob';
}
expect {
    26
}

@setup users
test table-delete {
    DELETE FROM users WHERE age > 34;
    SELECT count(*) FROM users;
}
expect {
    2
}

@setup users
test table-aggregates {
    SELECT count(*), min(age), max(age) FROM users;
}
expect {
    3|25|35
}

@setup users
test table-group-by-having {
    SELECT active, count(*) FROM users GROUP BY active HAVING count(*) >= 2 ORDER BY active;
}
expect {
    t|2
}

@setup users
test table-order-by-limit {
    SELECT name FROM users ORDER BY age DESC LIMIT 2;
}
expect {
    carol
    alice
}

test table-insert-null {
    CREATE TABLE t (a int, b text);
    INSERT INTO t VALUES (1, NULL);
    SELECT a, b FROM t;
}
expect {
    1|
}

test table-join {
    CREATE TABLE dept (id int, name text);
    CREATE TABLE emp (id int, dept_id int, name text);
    INSERT INTO dept VALUES (1, 'eng'), (2, 'ops');
    INSERT INTO emp VALUES (1, 1, 'alice'), (2, 1, 'bob'), (3, 2, 'carol');
    SELECT d.name, e.name FROM emp e JOIN dept d ON e.dept_id = d.id ORDER BY e.id;
}
expect {
    eng|alice
    eng|bob
    ops|carol
}

# ---------------------------------------------------------------------------
# CREATE TABLE AS / SELECT INTO
# ---------------------------------------------------------------------------

@setup users
test table-create-table-as {
    CREATE TABLE adults AS SELECT id, name FROM users WHERE age >= 30;
    SELECT id, name FROM adults ORDER BY id;
}
expect {
    1|alice
    3|carol
}

test table-create-table-as-snapshot-not-view {
    CREATE TABLE src (id int);
    INSERT INTO src VALUES (1), (2);
    CREATE TABLE snap AS SELECT * FROM src;
    INSERT INTO src VALUES (3);
    SELECT count(*) FROM snap;
}
expect {
    2
}

test table-create-table-as-with-no-data {
    CREATE TABLE src (id int, name text);
    INSERT INTO src VALUES (1, 'alice'), (2, 'bob');
    CREATE TABLE dst AS SELECT * FROM src WITH NO DATA;
    SELECT count(*) FROM dst;
    INSERT INTO dst VALUES (7, 'new');
    SELECT id, name FROM dst;
}
expect {
    0
    7|new
}

test table-create-table-as-compound {
    CREATE TABLE dst AS SELECT 1 AS x UNION SELECT 2;
    SELECT x FROM dst ORDER BY x;
}
expect {
    1
    2
}

test table-create-table-as-if-not-exists {
    CREATE TABLE src (id int);
    INSERT INTO src VALUES (1);
    CREATE TABLE dst AS SELECT * FROM src;
    CREATE TABLE IF NOT EXISTS dst AS SELECT * FROM src;
    SELECT count(*) FROM dst;
}
expect {
    1
}

test table-select-into {
    CREATE TABLE src (id int, name text);
    INSERT INTO src VALUES (1, 'alice'), (2, 'bob');
    SELECT id, name INTO dst FROM src WHERE id = 2;
    SELECT name FROM dst;
}
expect {
    bob
}

test table-select-into-nested-rejected {
    SELECT * FROM (SELECT 1 INTO dst) sub;
}
expect error {}

test table-date-arithmetic {
    CREATE TABLE dates (a date, b date);
    INSERT INTO dates VALUES ('2025-01-05', '2025-01-01');
    SELECT a + 1, a - 1, a - b FROM dates;
}
expect {
    2025-01-06|2025-01-04|4
}

test table-indexed-date-column-with-default {
    CREATE TABLE dates (a int, b int, c date DEFAULT '2000-01-01');
    INSERT INTO dates VALUES (1, 2, '2024-05-06');
    CREATE INDEX dates_c ON dates (c);
    SELECT c FROM dates;
    SELECT a, c FROM dates WHERE c = '2024-05-06';
}
expect {
    2024-05-06
    1|2024-05-06
}

test table-cast-timestamp-column-to-date-and-time {
    CREATE TABLE events (ts timestamp);
    INSERT INTO events VALUES ('2024-01-15 10:30:00');
    SELECT ts::date, ts::time FROM events;
}
expect {
    2024-01-15|10:30:00
}

test table-real-column-rounds-to-single-precision {
    CREATE TABLE t (a real, b float4, c double precision);
    INSERT INTO t VALUES (1.0/3, 0.1, 1.0/3);
    SELECT a, b, c FROM t;
}
expect {
    0.33333334|0.1|0.3333333333333333
}

test table-real-cast-rounds-to-single-precision {
    SELECT (1.0/3)::real, CAST(1.0/3 AS float4), float4(1.0/3), 0.1::real;
}
expect {
    0.33333334|0.33333334|0.33333334|0.1
}

test table-real-cast-out-of-range {
    SELECT 1e300::real;
}
expect error {}

test table-real-cast-rejects-text-that-is-not-a-number {
    SELECT '1.5abc'::real;
}
expect error {}

test table-real-expressions-print-as-single-precision {
    CREATE TABLE t (a real);
    INSERT INTO t VALUES (0.1), (1.0/3);
    SELECT max(a), min(a), coalesce(min(a), 0) FROM t;
}
expect {
    0.33333334|0.1|0.1
}

test table-real-subquery-column-prints-as-single-precision {
    CREATE TABLE t (a real);
    INSERT INTO t VALUES (1.0/3);
    WITH c AS (SELECT a FROM t) SELECT s.a, c.a FROM (SELECT a FROM t) s, c;
}
expect {
    0.33333334|0.33333334
}

test table-coalesce-of-real-and-double-prints-as-double {
    CREATE TABLE t (a real, f double precision);
    INSERT INTO t VALUES (NULL, 1.0/3);
    SELECT coalesce(a, f), coalesce(f, a) FROM t;
}
expect {
    0.3333333333333333|0.3333333333333333
}

test table-custom-type-array-column-with-where-filter {
    CREATE TABLE t (a int, b real[], c smallint[]);
    INSERT INTO t VALUES (1, ARRAY[0.5], ARRAY[2]);
    SELECT b, c FROM t WHERE a < 5;
}
expect {
    {0.5}|{2}
}

test table-real-to-numeric-keeps-single-precision-text {
    CREATE TABLE t (a real);
    INSERT INTO t VALUES (0.1);
    SELECT a::numeric FROM t;
}
expect {
    0.1
}

test table-real-converts-to-double-the-same-way-everywhere {
    CREATE TABLE t (a real);
    INSERT INTO t VALUES (0.1);
    SELECT count(*) FROM t
     WHERE a::float8 = (SELECT a FROM t)::float8
       AND a * 3 = a::float8 * 3
       AND (-a)::float8 = -(a::float8);
}
expect {
    1
}

test table-real-expressions-print-like-postgres {
    CREATE TABLE t (a real);
    INSERT INTO t VALUES (0.1);
    SELECT a * 2, a + 0, CASE WHEN true THEN a END, greatest(a, a), (SELECT a FROM t) FROM t;
}
expect {
    0.2|0.1|0.1|0.1|0.1
}

test table-real-to-text-prints-as-single-precision {
    CREATE TABLE t (a real);
    INSERT INTO t VALUES (0.1), (1.0/3);
    SELECT a::text, a || '', concat(a, ''), format('%s', a) FROM t;
}
expect {
    0.1|0.1|0.1|0.1
    0.33333334|0.33333334|0.33333334|0.33333334
}

test table-real-array-prints-as-single-precision {
    CREATE TABLE t (a real[]);
    INSERT INTO t VALUES (ARRAY[0.1, 1.0/3]);
    SELECT a, a[1] FROM t;
}
expect {
    {0.1,0.33333334}|0.1
}

test table-create-table-as-of-real-column-prints-as-single-precision {
    CREATE TABLE t (a real);
    INSERT INTO t VALUES (0.1), (1.0/3);
    CREATE TABLE u AS SELECT a FROM t;
    SELECT a FROM u;
}
expect {
    0.1
    0.33333334
}

test table-real-union-double-prints-as-double {
    CREATE TABLE t (a real, f double precision);
    INSERT INTO t VALUES (0.5, 1.0/3);
    SELECT a FROM t UNION ALL SELECT f FROM t;
}
expect {
    0.5
    0.3333333333333333
}

test table-real-union-double-expression-prints-as-double {
    CREATE TABLE t (a real, f double precision);
    INSERT INTO t VALUES (0.5, 1.0/3);
    SELECT a FROM t UNION ALL SELECT abs(f) FROM t;
}
expect {
    0.5
    0.3333333333333333
}

test table-real-union-real-prints-as-real {
    CREATE TABLE t (a real, b real);
    INSERT INTO t VALUES (1.0/3, 0.1);
    SELECT a FROM t UNION ALL SELECT b FROM t;
}
expect {
    0.33333334
    0.1
}

test table-boolean-union-literals-prints-as-boolean {
    CREATE TABLE t (b boolean);
    INSERT INTO t VALUES (true);
    SELECT b FROM t UNION ALL SELECT NULL UNION ALL SELECT false;
}
expect {
    t

    f
}

test table-real-union-literal-out-of-range {
    CREATE TABLE t (a real);
    INSERT INTO t VALUES (0.5);
    SELECT a FROM t UNION ALL SELECT 1e300;
}
expect error {}

test table-real-coalesce-literal-out-of-range {
    CREATE TABLE t (a real);
    INSERT INTO t VALUES (NULL);
    SELECT coalesce(a, 1e300) FROM t;
}
expect error {}

test table-real-union-literal-underflow {
    CREATE TABLE t (a real);
    INSERT INTO t VALUES (0.5);
    SELECT a FROM t UNION ALL SELECT 1e-50;
}
expect error {}
