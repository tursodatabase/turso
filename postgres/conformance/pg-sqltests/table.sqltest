test serial-primary-key-on-conflict-do-update {
    DROP TABLE IF EXISTS sk_u;
    CREATE TABLE sk_u (id serial PRIMARY KEY, v text);
    INSERT INTO sk_u (v) VALUES ('a');
    INSERT INTO sk_u (id, v) VALUES (1, 'b') ON CONFLICT (id) DO UPDATE SET v = excluded.v;
    INSERT INTO sk_u (v) VALUES ('c');
    SELECT id, v FROM sk_u ORDER BY id;
}
expect {
    1|b
    2|c
}

