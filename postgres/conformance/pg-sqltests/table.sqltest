}
@sqlstate 23502
expect error {}

test integer-primary-key-uses-column-default {
    DROP TABLE IF EXISTS sk_d;
    CREATE TABLE sk_d (id integer PRIMARY KEY DEFAULT 7, v text);
    INSERT INTO sk_d (v) VALUES ('x');
    SELECT id, v FROM sk_d;
}
expect {
    7|x
}

