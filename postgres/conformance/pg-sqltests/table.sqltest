# Table DDL and DML through the PostgreSQL frontend: PostgreSQL type names,
# multi-row inserts, updates, deletes, aggregates, and grouping.

@database :memory:

setup users {
    CREATE TABLE users (id serial, name varchar(50), age int, active boolean);
    INSERT INTO users (id, name, age, active) VALUES
        (1, 'alice', 30, true),
        (2, 'bob', 25, false),
        (3, 'carol', 35, true);
}

@setup users
test table-select-all {
    SELECT id, name, age FROM users ORDER BY id;
}
expect {
    1|alice|30
    2|bob|25
    3|carol|35
}

@setup users
test table-where-boolean-column {
    SELECT name FROM users WHERE active ORDER BY name;
}
expect {
    alice
    carol
}

@setup users
test table-update {
    UPDATE users SET age = age + 1 WHERE name = 'bob';
    SELECT age FROM users WHERE name = 'bob';
}
expect {
    26
}

@setup users
test table-update-column-list-from-row {
    UPDATE users SET (name, age) = ('bobby', 26) WHERE id = 2;
    UPDATE users SET active = true, (name, age) = ROW('caroline', 36) WHERE id = 3;
    UPDATE users SET (age) = ROW(31) WHERE id = 1;
    SELECT name, age, active FROM users ORDER BY id;
}
expect {
    alice|31|t
    bobby|26|f
    caroline|36|t
}

@setup users
test table-update-column-list-from-subquery {
    UPDATE users SET (name, age) = (SELECT name, age FROM users WHERE id = 3) WHERE id = 1;
    SELECT name, age FROM users ORDER BY id;
}
expect {
    carol|35
    bob|25
    carol|35
}

@setup users
test table-update-column-list-from-a-plain-value-errors {
    UPDATE users SET (age) = (31);
}
@sqlstate 0A000
expect error {source for a multiple-column UPDATE item must be a sub-SELECT or ROW}

@setup users
test table-delete {
    DELETE FROM users WHERE age > 34;
    SELECT count(*) FROM users;
}
expect {
    2
}

@setup users
test table-aggregates {
    SELECT count(*), min(age), max(age) FROM users;
}
expect {
    3|25|35
}

@setup users
test table-group-by-having {
    SELECT active, count(*) FROM users GROUP BY active HAVING count(*) >= 2 ORDER BY active;
}
expect {
    t|2
}

@setup users
test table-order-by-limit {
    SELECT name FROM users ORDER BY age DESC LIMIT 2;
}
expect {
    carol
    alice
}

test table-insert-null {
    CREATE TABLE t (a int, b text);
    INSERT INTO t VALUES (1, NULL);
    SELECT a, b FROM t;
}
expect {
    1|
}

test table-join {
    CREATE TABLE dept (id int, name text);
    CREATE TABLE emp (id int, dept_id int, name text);
    INSERT INTO dept VALUES (1, 'eng'), (2, 'ops');
    INSERT INTO emp VALUES (1, 1, 'alice'), (2, 1, 'bob'), (3, 2, 'carol');
    SELECT d.name, e.name FROM emp e JOIN dept d ON e.dept_id = d.id ORDER BY e.id;
}
expect {
    eng|alice
    eng|bob
    ops|carol
}

@skip-if tursopg "a cast from integer to numeric(10,2) is not supported yet"
test table-numeric-equal-across-scales {
    CREATE TABLE a (x numeric(10,2));
    CREATE TABLE b (y numeric(10,3));
    INSERT INTO a VALUES (1), (2);
    INSERT INTO b VALUES (1);
    SELECT count(*) FROM a JOIN b ON a.x = b.y;
    SELECT count(*) FROM a WHERE x IN (SELECT y FROM b);
    SELECT x, (SELECT count(*) FROM b WHERE b.y = a.x) FROM a ORDER BY x;
}
expect {
    1
    1
    1.00|1
    2.00|0
}

@skip-if tursopg "a cast from integer to numeric(10,2) is not supported yet"
test table-numeric-equal-through-view-and-subquery {
    CREATE TABLE a (x numeric(10,2));
    CREATE TABLE b (y numeric(10,3));
    INSERT INTO a VALUES (1), (2);
    INSERT INTO b VALUES (1);
    CREATE VIEW v AS SELECT y FROM b;
    SELECT count(*) FROM a JOIN v ON a.x = v.y;
    SELECT count(*) FROM a WHERE x IN (SELECT y FROM v);
    SELECT x, (SELECT count(*) FROM v WHERE v.y = a.x) FROM a ORDER BY x;
    SELECT count(*) FROM a JOIN (SELECT y FROM b) s ON a.x = s.y;
}
expect {
    1
    1
    1.00|1
    2.00|0
    1
}

@skip-if tursopg "a cast from numeric to numeric(10,2) is not supported yet"
test table-numeric-join-keeps-other-scale {
    CREATE TABLE a (x numeric(10,2));
    CREATE TABLE b (y numeric(10,1));
    INSERT INTO a VALUES (1.20), (1.25);
    INSERT INTO b VALUES (1.2);
    SELECT count(*) FROM a JOIN b ON a.x = b.y;
    SELECT count(*) FROM a JOIN b ON b.y < a.x;
    SELECT count(*) FROM a JOIN b ON b.y >= a.x;
    SELECT count(*) FROM a WHERE EXISTS (SELECT 1 FROM b WHERE b.y = a.x);
}
expect {
    1
    1
    1
    1
}

# ---------------------------------------------------------------------------
# CREATE TABLE AS / SELECT INTO
# ---------------------------------------------------------------------------

@setup users
test table-create-table-as {
    CREATE TABLE adults AS SELECT id, name FROM users WHERE age >= 30;
    SELECT id, name FROM adults ORDER BY id;
}
expect {
    1|alice
    3|carol
}

test table-create-table-as-snapshot-not-view {
    CREATE TABLE src (id int);
    INSERT INTO src VALUES (1), (2);
    CREATE TABLE snap AS SELECT * FROM src;
    INSERT INTO src VALUES (3);
    SELECT count(*) FROM snap;
}
expect {
    2
}

test table-create-table-as-with-no-data {
    CREATE TABLE src (id int, name text);
    INSERT INTO src VALUES (1, 'alice'), (2, 'bob');
    CREATE TABLE dst AS SELECT * FROM src WITH NO DATA;
    SELECT count(*) FROM dst;
    INSERT INTO dst VALUES (7, 'new');
    SELECT id, name FROM dst;
}
expect {
    0
    7|new
}

test table-create-table-as-compound {
    CREATE TABLE dst AS SELECT 1 AS x UNION SELECT 2;
    SELECT x FROM dst ORDER BY x;
}
expect {
    1
    2
}

test table-create-table-as-if-not-exists {
    CREATE TABLE src (id int);
    INSERT INTO src VALUES (1);
    CREATE TABLE dst AS SELECT * FROM src;
    CREATE TABLE IF NOT EXISTS dst AS SELECT * FROM src;
    SELECT count(*) FROM dst;
}
expect {
    1
}

test table-select-into {
    CREATE TABLE src (id int, name text);
    INSERT INTO src VALUES (1, 'alice'), (2, 'bob');
    SELECT id, name INTO dst FROM src WHERE id = 2;
    SELECT name FROM dst;
}
expect {
    bob
}

test table-select-into-nested-rejected {
    SELECT * FROM (SELECT 1 INTO dst) sub;
}
@sqlstate 42601
expect error {}

@skip-if tursopg "a cast from unknown to date is not supported yet"
test table-date-arithmetic {
    CREATE TABLE dates (a date, b date);
    INSERT INTO dates VALUES ('2025-01-05', '2025-01-01');
    SELECT a + 1, a - 1, a - b FROM dates;
}
expect {
    2025-01-06|2025-01-04|4
}

@skip-if tursopg "a cast from unknown to date is not supported yet"
test table-indexed-date-column-with-default {
    CREATE TABLE dates (a int, b int, c date DEFAULT '2000-01-01');
    INSERT INTO dates VALUES (1, 2, '2024-05-06');
    CREATE INDEX dates_c ON dates (c);
    SELECT c FROM dates;
    SELECT a, c FROM dates WHERE c = '2024-05-06';
}
expect {
    2024-05-06
    1|2024-05-06
}

@skip-if tursopg "a cast from unknown to timestamp is not supported yet"
test table-cast-timestamp-column-to-date-and-time {
    CREATE TABLE events (ts timestamp);
    INSERT INTO events VALUES ('2024-01-15 10:30:00');
    SELECT ts::date, ts::time FROM events;
}
expect {
    2024-01-15|10:30:00
}

test table-check-on-smallint-column {
    CREATE TABLE t (n smallint DEFAULT 0 CHECK (n >= 0 AND n <= 2));
    INSERT INTO t VALUES (1) RETURNING n;
}
expect {
    1
}

test table-check-on-smallint-column-rejects-value-out-of-range {
    CREATE TABLE t (n smallint DEFAULT 0 CHECK (n >= 0 AND n <= 2));
    INSERT INTO t VALUES (3);
}
@sqlstate 23514
expect error {}

test table-check-compares-integer-types-of-different-sizes {
    CREATE TABLE t (a smallint, b integer, c bigint, CHECK (a < b AND b < c AND c > 0));
    INSERT INTO t VALUES (1, 2, 3);
    SELECT a, b, c FROM t;
}
expect {
    1|2|3
}

@skip-if tursopg "the operator * for types numeric(10,2) and integer is not supported yet"
test table-delete-row-with-numeric-expression-index {
    CREATE TABLE prices (id int PRIMARY KEY, val numeric(10,2));
    CREATE INDEX prices_doubled ON prices ((val * 2));
    INSERT INTO prices VALUES (1, 1.50);
    DELETE FROM prices WHERE id = 1;
    SELECT count(*) FROM prices;
}
expect {
    0
}

test table-expression-index-with-qualified-column {
    CREATE TABLE qual (a int, b int);
    CREATE INDEX qual_a_plus_one ON qual ((qual.a + 1));
    CREATE INDEX qual_a ON qual ((public.qual.a));
    INSERT INTO qual VALUES (1, 2), (5, 6);
    SELECT b FROM qual WHERE a + 1 = 6;
}
expect {
    6
}

@skip-if tursopg "a cast from numeric to numeric(10,2) is not supported yet"
test table-numeric-column-compared-with-expression {
    CREATE TABLE nm (v numeric(10,2));
    INSERT INTO nm VALUES (1.50);
    SELECT count(*) FROM nm WHERE v = 1.5 + 0;
    SELECT count(*) FROM nm WHERE v = (SELECT 1.5);
    SELECT count(*) FROM nm WHERE (SELECT 1.5) = v;
    SELECT count(*) FROM nm WHERE v < 1 + 1;
    SELECT count(*) FROM nm WHERE v <> 1.5 + 0;
    SELECT count(*) FROM nm WHERE v = 1.504 + 0;
}
expect {
    1
    1
    1
    1
    0
    0
}

@skip-if tursopg "a cast from numeric to numeric(10,2) is not supported yet"
test table-numeric-column-modulo-keeps-scale {
    CREATE TABLE nm (id int PRIMARY KEY, v numeric(10,2), w numeric(10,3));
    INSERT INTO nm VALUES (1, 1.5, 0.4), (2, -7.25, 2), (3, NULL, 1);
    SELECT v % 1, v % w, v % 0.3, 5 % v FROM nm ORDER BY id;
}
expect {
    0.50|0.300|0.00|0.50
    -0.25|-1.250|-0.05|5.00
    |||
}

@skip-if tursopg "a cast from numeric to numeric(10,2) is not supported yet"
test table-numeric-column-negation-keeps-scale {
    CREATE TABLE nm (id int PRIMARY KEY, v numeric(10,2), w numeric(10,3));
    INSERT INTO nm VALUES (1, 1.5, 0.4), (2, -7.25, 2), (3, NULL, 1);
    SELECT -v, -w FROM nm ORDER BY id;
}
expect {
    -1.50|-0.400
    7.25|-2.000
    |-1.000
}

@skip-if tursopg "a cast from integer to numeric(10,2) is not supported yet"
test table-numeric-negation-and-modulo-compare-as-numbers {
    CREATE TABLE nm (id int PRIMARY KEY, v numeric(10,2));
    INSERT INTO nm VALUES (1, 9), (2, 10), (3, -1.5), (4, 1.5);
    SELECT id FROM nm WHERE -v < -5 ORDER BY -v;
    SELECT id FROM nm WHERE v % 1 > 0.1;
    SELECT max(-v) FROM nm;
}
expect {
    2
    1
    4
    1.50
}

@skip-if tursopg "a cast from numeric to numeric(10,2) is not supported yet"
test table-numeric-column-compared-with-literal-not-rounded {
    CREATE TABLE nm (v numeric(10,2));
    INSERT INTO nm VALUES (1.50);
    SELECT count(*) FROM nm WHERE v = 1.501;
    SELECT count(*) FROM nm WHERE 1.501 = v;
    SELECT count(*) FROM nm WHERE v < 1.501;
    SELECT count(*) FROM nm WHERE v >= 1.501;
    SELECT count(*) FROM nm WHERE v <> 1.501;
    SELECT count(*) FROM nm WHERE v = 123456789012.5;
    CREATE INDEX nm_v ON nm (v);
    SELECT count(*) FROM nm WHERE v = 1.501;
    SELECT count(*) FROM nm WHERE v = 1.50;
    SELECT count(*) FROM nm WHERE v = 1.5;
}
expect {
    0
    0
    1
    0
    1
    0
    0
    1
    1
}

@skip-if tursopg "a cast from numeric to numeric(10,2) is not supported yet"
test table-numeric-column-rounds-extra-digits {
    CREATE TABLE prices (id int PRIMARY KEY, val numeric(10,2));
    INSERT INTO prices VALUES (1, 0.019), (2, 0.015), (3, -0.015), (4, '1.999');
    SELECT id, val FROM prices ORDER BY id;
}
expect {
    1|0.02
    2|0.02
    3|-0.02
    4|2.00
}

test table-uuid-column-omitted-from-insert-is-null {
    CREATE TABLE t (id int PRIMARY KEY, u uuid);
    INSERT INTO t (id) VALUES (1);
    SELECT count(*) FROM t WHERE u IS NULL;
}
expect {
    1
}

@skip-if tursopg "the type of the function gen_random_uuid is not known yet"
test table-uuid-column-with-explicit-default-generates-uuid {
    CREATE TABLE t (id int PRIMARY KEY, u uuid DEFAULT gen_random_uuid());
    INSERT INTO t (id) VALUES (1);
    SELECT count(*) FROM t WHERE u IS NOT NULL;
}
expect {
    1
}

@setup users
test table-insert-returning-table-star {
    INSERT INTO users VALUES (4, 'dave', 40, false) RETURNING users.*;
}
expect {
    4|dave|40|f
}

@setup users
test table-update-returning-table-star {
    UPDATE users SET age = age + 1 WHERE name = 'bob' RETURNING users.*;
}
expect {
    2|bob|26|f
}

@setup users
test table-delete-returning-table-star {
    DELETE FROM users WHERE name = 'carol' RETURNING users.*;
}
expect {
    3|carol|35|t
}

@setup users
test table-returning-alias-star {
    INSERT INTO users AS u VALUES (5, 'eve', 20, true) RETURNING u.*;
    UPDATE users AS u SET age = 50 WHERE id = 1 RETURNING u.*;
    DELETE FROM users u WHERE id = 5 RETURNING id, u.*;
}
expect {
    5|eve|20|t
    1|alice|50|t
    5|5|eve|20|t
}

@setup users
test table-returning-schema-qualified-star {
    INSERT INTO public.users VALUES (4, 'dave', 40, false) RETURNING public.users.*;
    UPDATE public.users SET age = 50 WHERE id = 1 RETURNING public.users.*, users.*;
    DELETE FROM public.users WHERE id = 4 RETURNING public.users.*;
}
expect {
    4|dave|40|f
    1|alice|50|t|1|alice|50|t
    4|dave|40|f
}

@setup users
test table-returning-star-with-unknown-middle-name-rejected {
    INSERT INTO users VALUES (4, 'dave', 40, false) RETURNING users.zz.*;
}
@sqlstate 42P01
expect error {}

@setup users
test table-returning-star-with-other-schema-rejected {
    INSERT INTO public.users VALUES (4, 'dave', 40, false) RETURNING pg_catalog.users.*;
}
@sqlstate 42P01
expect error {}

@setup users
test table-returning-table-name-star-after-alias-rejected {
    INSERT INTO users AS u VALUES (4, 'dave', 40, false) RETURNING users.*;
}
@sqlstate 42P01
expect error {}

setup upsert {
    CREATE TABLE upsert_t (a int PRIMARY KEY, k int UNIQUE, b int);
    INSERT INTO upsert_t VALUES (1, 1, 0);
}

@setup upsert
test table-upsert-updates-column-list-from-row {
    INSERT INTO upsert_t VALUES (1, 5, 7) ON CONFLICT (a) DO UPDATE SET (k, b) = (excluded.k + 1, excluded.b);
    SELECT a, k, b FROM upsert_t;
}
expect {
    1|6|7
}

@setup upsert
test table-upsert-existing-row-updated-twice-rejected {
    INSERT INTO upsert_t VALUES (1, 10, 1), (1, 11, 5) ON CONFLICT (a) DO UPDATE SET b = excluded.b;
}
@sqlstate 21000
expect error {ON CONFLICT DO UPDATE command cannot affect row a second time}

@setup upsert
test table-upsert-inserted-row-updated-rejected {
    INSERT INTO upsert_t VALUES (2, 2, 1), (2, 3, 5) ON CONFLICT (a) DO UPDATE SET b = excluded.b;
}
@sqlstate 21000
expect error {ON CONFLICT DO UPDATE command cannot affect row a second time}

@setup upsert
test table-upsert-row-updated-twice-through-unique-column-rejected {
    INSERT INTO upsert_t VALUES (2, 1, 1), (3, 1, 5) ON CONFLICT (k) DO UPDATE SET b = excluded.b;
}
@sqlstate 21000
expect error {ON CONFLICT DO UPDATE command cannot affect row a second time}

@setup upsert
test table-upsert-row-with-changed-key-updated-again-rejected {
    INSERT INTO upsert_t VALUES (1, 10, 7), (10, 11, 5) ON CONFLICT (a) DO UPDATE SET a = 10;
}
@sqlstate 21000
expect error {ON CONFLICT DO UPDATE command cannot affect row a second time}

@setup upsert
test table-upsert-inserted-row-with-false-where-rejected {
    INSERT INTO upsert_t VALUES (2, 2, 1), (2, 3, 5) ON CONFLICT (a) DO UPDATE SET b = excluded.b WHERE false;
}
@sqlstate 21000
expect error {ON CONFLICT DO UPDATE command cannot affect row a second time}

@setup upsert
test table-upsert-existing-row-with-false-where-twice {
    INSERT INTO upsert_t VALUES (1, 10, 1), (1, 11, 5) ON CONFLICT (a) DO UPDATE SET b = excluded.b WHERE false;
    SELECT a, k, b FROM upsert_t ORDER BY a;
}
expect {
    1|1|0
}

@setup upsert
test table-upsert-different-rows-each-updated-once {
    INSERT INTO upsert_t VALUES (2, 2, 0);
    INSERT INTO upsert_t VALUES (1, 10, 1), (2, 20, 5), (3, 3, 9) ON CONFLICT (a) DO UPDATE SET b = excluded.b;
    SELECT a, k, b FROM upsert_t ORDER BY a;
}
expect {
    1|1|1
    2|2|5
    3|3|9
}

@setup upsert
test table-upsert-do-nothing-skips-repeated-key {
    INSERT INTO upsert_t VALUES (2, 2, 1), (2, 3, 5) ON CONFLICT (a) DO NOTHING;
    SELECT a, k, b FROM upsert_t ORDER BY a;
}
expect {
    1|1|0
    2|2|1
}

test table-named-with-a-bracket-at-the-start {
    CREATE TABLE "[t" (a int);
    INSERT INTO "[t" VALUES (1);
    SELECT a FROM "[t";
}
expect {
    1
}

test table-column-aliases-that-start-with-a-quote-character {
    CREATE TABLE t (a int);
    INSERT INTO t VALUES (1);
    SELECT a AS "[x", a AS """x" FROM t;
}
expect {
    1|1
}

test table-names-in-brackets-and-without-brackets-are-different-tables {
    CREATE TABLE "[t]" (a int);
    CREATE TABLE t (a int);
    INSERT INTO "[t]" VALUES (1);
    SELECT count(*) FROM t;
}
expect {
    0
}

test table-column-names-keep-their-quote-characters {
    CREATE TABLE t (x int, "'x'" int, "`x`" int, "[x]" int);
    INSERT INTO t VALUES (1, 2, 3, 4);
    SELECT x, "'x'", "`x`", "[x]" FROM t;
}
expect {
    1|2|3|4
}

test table-serial-column-of-a-table-whose-name-has-double-quotes {
    CREATE TABLE """t""" (id serial, v int);
    INSERT INTO """t""" (v) VALUES (5);
    INSERT INTO """t""" (v) VALUES (6);
    SELECT id, v FROM """t""" ORDER BY id;
}
expect {
    1|5
    2|6
}

test table-serial-column-whose-name-has-double-quotes {
    CREATE TABLE t ("""id""" serial, v int);
    INSERT INTO t (v) VALUES (5);
    SELECT """id""", v FROM t;
}
expect {
    1|5
}

test table-serial-column-of-a-table-whose-name-has-a-double-quote-inside {
    CREATE TABLE "a""b" (id serial, v int);
    INSERT INTO "a""b" (v) VALUES (5);
    SELECT id, v FROM "a""b";
}
expect {
    1|5
}

test table-sequence-whose-name-has-double-quotes {
    CREATE SEQUENCE """s""";
    SELECT sequencename FROM pg_sequences;
}
expect {
    "s"
}

test table-serial-sequence-takes-the-first-free-name {
    CREATE TABLE zz_free_id_seq (a int);
    CREATE SEQUENCE zz_free_id_seq1;
    CREATE TABLE zz_free (id serial, b int);
    SELECT relname, relkind FROM pg_class WHERE relname LIKE 'zz_free_id_seq%' ORDER BY relname;
}
expect {
    zz_free_id_seq|r
    zz_free_id_seq1|S
    zz_free_id_seq2|S
}

test table-serial-column-draws-from-its-own-sequence-when-another-has-its-name {
    CREATE SEQUENCE zz_busy_id_seq START 100;
    CREATE TABLE zz_busy (id serial, b int);
    INSERT INTO zz_busy (b) VALUES (10), (20);
    SELECT id, b FROM zz_busy ORDER BY id;
}
expect {
    1|10
    2|20
}

test table-serial-sequence-of-a-schema-whose-name-has-a-quote-takes-a-free-name {
    CREATE SCHEMA "zz_o'k";
    CREATE TABLE "zz_o'k".t_id_seq (a int);
    CREATE TABLE "zz_o'k".t (id serial, b int);
    INSERT INTO "zz_o'k".t (b) VALUES (1);
    SELECT id, b FROM "zz_o'k".t;
}
expect {
    1|1
}

test table-serial-sequence-of-a-schema-whose-name-has-a-dot-takes-a-free-name {
    CREATE SCHEMA "zz_a.b";
    CREATE TABLE "zz_a.b".t_id_seq (a int);
    CREATE TABLE "zz_a.b".t (id serial, b int);
    INSERT INTO "zz_a.b".t (b) VALUES (1);
    SELECT id, b FROM "zz_a.b".t;
}
expect {
    1|1
}

test table-serial-sequence-of-a-table-whose-name-has-a-quote-takes-a-free-name {
    CREATE TABLE "zz_q'_id_seq" (a int);
    CREATE TABLE "zz_q'" (id serial, b int);
    INSERT INTO "zz_q'" (b) VALUES (1);
    SELECT id, b FROM "zz_q'";
}
expect {
    1|1
}

test drop-materialized-view-on-a-view-errors {
    CREATE TABLE t (a int);
    CREATE VIEW v AS SELECT * FROM t;
    DROP MATERIALIZED VIEW v;
}
@sqlstate 42809
expect error {
    "v" is not a materialized view
}

test drop-materialized-view-if-exists-on-a-view-errors {
    CREATE TABLE t (a int);
    CREATE VIEW v AS SELECT * FROM t;
    DROP MATERIALIZED VIEW IF EXISTS public.v;
}
@sqlstate 42809
expect error {
    "v" is not a materialized view
}

test drop-view-on-a-table-errors {
    CREATE TABLE t (a int);
    DROP VIEW IF EXISTS t;
}
@sqlstate 42809
expect error {
    "t" is not a view
}

test table-domain-not-null-default-fills-omitted-column {
    CREATE DOMAIN nn_default AS int NOT NULL DEFAULT 3;
    CREATE TABLE t (a nn_default, b int);
    INSERT INTO t(b) VALUES (2);
    SELECT a, b FROM t;
}
expect {
    3|2
}

test table-domain-not-null-default-rejects-explicit-null {
    CREATE DOMAIN nn_default AS int NOT NULL DEFAULT 3;
    CREATE TABLE t (a nn_default, b int);
    INSERT INTO t VALUES (NULL, 2);
}
expect error {}

@skip-if tursopg "the type of the function gen_random_uuid is not known yet"
test table-add-column-function-default-fills-each-existing-row {
    CREATE TABLE t (x int);
    INSERT INTO t VALUES (1), (2);
    ALTER TABLE t ADD COLUMN c uuid DEFAULT gen_random_uuid();
    ALTER TABLE t ADD COLUMN d timestamptz DEFAULT now();
    SELECT count(c), count(DISTINCT c), count(d) FROM t;
}
expect {
    2|2|2
}

test table-add-column-expression-default-fills-existing-rows {
    CREATE TABLE t (x int);
    INSERT INTO t VALUES (1), (2);
    ALTER TABLE t ADD COLUMN e int DEFAULT (5 + 3);
    INSERT INTO t (x) VALUES (3);
    SELECT x, e FROM t ORDER BY x;
}
expect {
    1|8
    2|8
    3|8
}

test table-add-column-default-with-column-reference-errors {
    CREATE TABLE t (x int);
    INSERT INTO t VALUES (5);
    ALTER TABLE t ADD COLUMN c int DEFAULT x * 2;
}
expect error {}

test table-add-column-not-null-default-with-null-inside-fills-existing-rows {
    CREATE TABLE t (x int);
    INSERT INTO t VALUES (1), (2);
    ALTER TABLE t ADD COLUMN c int NOT NULL DEFAULT coalesce(NULL, 7);
    ALTER TABLE t ADD COLUMN d text NOT NULL DEFAULT CASE WHEN 1 < 2 THEN 'y' ELSE NULL END;
    SELECT x, c, d FROM t ORDER BY x;
}
expect {
    1|7|y
    2|7|y
}

test table-add-column-not-null-default-that-is-null-errors {
    CREATE TABLE t (x int);
    INSERT INTO t VALUES (1);
    ALTER TABLE t ADD COLUMN z int NOT NULL DEFAULT nullif(1, 1);
}
expect error {}

test add-column-fills-existing-rows-with-a-function-default {
    CREATE TABLE add_column_fill (id int);
    INSERT INTO add_column_fill VALUES (1), (2);
    ALTER TABLE add_column_fill ADD COLUMN schema_name text DEFAULT current_schema;
    SELECT id, schema_name FROM add_column_fill ORDER BY id;
}
expect {
    1|public
    2|public
}

@skip-if tursopg "a cast from unknown to uuid is not supported yet"
test array-columns-hold-element-values {
    -- tursopg prints a boolean result as 1, PostgreSQL as t, so every
    -- boolean is cast to int.
    CREATE TABLE array_values (
        id int PRIMARY KEY,
        u uuid, us uuid[],
        d date, ds date[],
        b boolean, bs boolean[]
    );
    INSERT INTO array_values VALUES
        (1, 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', NULL, '2024-01-02', NULL, true, NULL);
    UPDATE array_values SET us = ARRAY[u], ds = ARRAY[d], bs = ARRAY[b, false];
    SELECT (us = ARRAY[u])::int, (ds = ARRAY[d])::int, (bs = ARRAY[b, false])::int,
        (us[1] = u)::int, (ds[1] = d)::int, (bs[1] = b)::int, bs[1]::int, bs[2]::int
    FROM array_values;
    SELECT us, ds FROM array_values;
}
expect {
    1|1|1|1|1|1|1|0
    {a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11}|{2024-01-02}
}

@skip-if tursopg "the type of a subscript or field selection is not known yet"
test array-of-booleans-from-literal-and-aggregate {
    CREATE TABLE bool_values (id int PRIMARY KEY, b boolean);
    INSERT INTO bool_values VALUES (1, true), (2, false);
    SELECT (ARRAY[true, false])[1]::int, (ARRAY[true, false])[2]::int;
    SELECT (array_agg(b ORDER BY id) = ARRAY[true, false])::int FROM bool_values;
}
expect {
    1|0
    1
}


setup assign {
    CREATE TABLE assign (a integer, b text, c double precision, d boolean, e bigint, ts timestamp, v varchar(5));
}

setup assign_upsert {
    CREATE TABLE upserts (k integer PRIMARY KEY, a integer, b text);
    INSERT INTO upserts VALUES (1, 1, 'x');
}

@setup assign
test assign-insert-string-literal-into-integer {
    INSERT INTO assign (a) VALUES ('5');
    INSERT INTO assign (a) VALUES (' 7 ');
    SELECT a FROM assign ORDER BY a;
}
expect {
    5
    7
}

@setup assign
test assign-insert-string-literal-that-is-not-a-number {
    INSERT INTO assign (a) VALUES ('x');
}
@sqlstate 22P02
expect error {
    invalid input syntax for type integer: "x"
}

@setup assign
test assign-insert-numeric-into-integer-rounds {
    INSERT INTO assign (a) VALUES (1.6);
    INSERT INTO assign (a) VALUES (1.4);
    SELECT a FROM assign ORDER BY a;
}
expect {
    1
    2
}

@setup assign
test assign-insert-integer-into-text {
    INSERT INTO assign (b) VALUES (42);
    SELECT b || 'x' FROM assign;
}
expect {
    42x
}

@setup assign
test assign-insert-integer-into-double-precision-and-bigint {
    INSERT INTO assign (c, e) VALUES (5, 7);
    SELECT count(*) FROM assign WHERE c = 5 AND e = 7;
}
expect {
    1
}

@setup assign
test assign-insert-string-literal-into-boolean {
    INSERT INTO assign (d) VALUES ('true'), ('f');
    SELECT d FROM assign ORDER BY d;
}
expect {
    f
    t
}

@setup assign
test assign-insert-text-column-into-integer-column {
    INSERT INTO assign (b) VALUES ('7');
    INSERT INTO assign (a) SELECT b FROM assign;
}
@sqlstate 42804
expect error {
    column "a" is of type integer but expression is of type text
}

@setup assign
test assign-insert-boolean-into-integer-column {
    INSERT INTO assign (a) VALUES (true);
}
@sqlstate 42804
expect error {
    column "a" is of type integer but expression is of type boolean
}

@setup assign
test assign-insert-integer-into-boolean-column {
    INSERT INTO assign (d) VALUES (1);
}
@sqlstate 42804
expect error {
    column "d" is of type boolean but expression is of type integer
}

@setup assign
test assign-insert-null-into-every-column {
    INSERT INTO assign VALUES (NULL, NULL, NULL, NULL, NULL, NULL, NULL);
    INSERT INTO assign (a, b, c, d, e, ts, v) VALUES (NULL, NULL, NULL, NULL, NULL, NULL, NULL);
    SELECT count(*) FROM assign WHERE a IS NULL AND b IS NULL AND c IS NULL AND d IS NULL
        AND e IS NULL AND ts IS NULL AND v IS NULL;
}
expect {
    2
}

@setup assign
test assign-insert-without-column-list-converts-each-value {
    INSERT INTO assign VALUES ('1', 2, 3, 'true', '5', NULL, NULL);
    SELECT a, b, d, e FROM assign WHERE c = 3;
}
expect {
    1|2|t|5
}

@setup assign
test assign-insert-several-rows-converts-each-value {
    INSERT INTO assign (a) VALUES ('1'), (2), ('3');
    SELECT sum(a) FROM assign;
}
expect {
    6
}

@skip-if postgres "PostgreSQL reads the string as a timestamp; tursopg rejects a cast from unknown to timestamp"
@setup assign
test assign-insert-string-literal-into-timestamp-is-not-supported {
    INSERT INTO assign (ts) VALUES ('2024-01-01 10:00:00');
}
@sqlstate 0A000
expect error {
    a cast from unknown to timestamp is not supported
}

@setup assign
test assign-insert-string-literal-into-varchar {
    INSERT INTO assign (v) VALUES ('abc');
    SELECT v FROM assign;
}
expect {
    abc
}

@setup assign
test assign-update-string-literal-into-integer {
    INSERT INTO assign (a) VALUES (1);
    UPDATE assign SET a = '5';
    SELECT a FROM assign;
}
expect {
    5
}

@setup assign
test assign-update-string-literal-that-is-not-a-number {
    INSERT INTO assign (a) VALUES (1);
    UPDATE assign SET a = 'x';
}
@sqlstate 22P02
expect error {
    invalid input syntax for type integer: "x"
}

@setup assign
test assign-update-numeric-into-integer-rounds {
    INSERT INTO assign (a) VALUES (1);
    UPDATE assign SET a = 2.6;
    SELECT a FROM assign;
}
expect {
    3
}

@setup assign
test assign-update-integer-into-text {
    INSERT INTO assign (b) VALUES ('x');
    UPDATE assign SET b = 7;
    SELECT b || 'y' FROM assign;
}
expect {
    7y
}

@setup assign
test assign-update-text-column-into-integer-column {
    INSERT INTO assign (a, b) VALUES (1, 'x');
    UPDATE assign SET a = b;
}
@sqlstate 42804
expect error {
    column "a" is of type integer but expression is of type text
}

@setup assign
test assign-update-boolean-into-integer-column {
    INSERT INTO assign (a) VALUES (1);
    UPDATE assign SET a = true;
}
@sqlstate 42804
expect error {
    column "a" is of type integer but expression is of type boolean
}

@setup assign
test assign-update-to-null {
    INSERT INTO assign (a, b) VALUES (1, 'x');
    UPDATE assign SET a = NULL, b = NULL;
    SELECT count(*) FROM assign WHERE a IS NULL AND b IS NULL;
}
expect {
    1
}

@skip-if postgres "PostgreSQL reads the string as a timestamp; tursopg rejects a cast from unknown to timestamp"
@setup assign
test assign-update-string-literal-into-timestamp-is-not-supported {
    INSERT INTO assign (a) VALUES (1);
    UPDATE assign SET ts = '2024-01-01 10:00:00';
}
@sqlstate 0A000
expect error {
    a cast from unknown to timestamp is not supported
}

@setup assign_upsert
test assign-on-conflict-update-string-literal-into-integer {
    INSERT INTO upserts VALUES (1, 2, 'y') ON CONFLICT (k) DO UPDATE SET a = '9';
    SELECT a FROM upserts;
}
expect {
    9
}

@setup assign_upsert
test assign-on-conflict-update-integer-into-text {
    INSERT INTO upserts VALUES (1, 2, 'y') ON CONFLICT (k) DO UPDATE SET b = excluded.a;
    SELECT b || 'z' FROM upserts;
}
expect {
    2z
}

@setup assign_upsert
test assign-on-conflict-update-text-into-integer-column {
    INSERT INTO upserts VALUES (1, 2, 'y') ON CONFLICT (k) DO UPDATE SET a = excluded.b;
}
@sqlstate 42804
expect error {
    column "a" is of type integer but expression is of type text
}

@setup assign_upsert
test assign-on-conflict-update-string-literal-that-is-not-a-number {
    INSERT INTO upserts VALUES (1, 2, 'y') ON CONFLICT (k) DO UPDATE SET a = 'x';
}
@sqlstate 22P02
expect error {
    invalid input syntax for type integer: "x"
}

test assign-column-default-string-literal-into-integer {
    CREATE TABLE defaulted (x integer DEFAULT '7');
    INSERT INTO defaulted (x) VALUES (DEFAULT);
    SELECT x FROM defaulted;
}
expect {
    7
}

test assign-column-default-string-literal-that-is-not-a-number {
    CREATE TABLE defaulted (x integer DEFAULT 'x');
}
@sqlstate 22P02
expect error {
    invalid input syntax for type integer: "x"
}

test assign-column-default-integer-into-text {
    CREATE TABLE defaulted (x text DEFAULT 5);
    INSERT INTO defaulted (x) VALUES (DEFAULT);
    SELECT x || 'y' FROM defaulted;
}
expect {
    5y
}

test assign-column-default-boolean-into-integer {
    CREATE TABLE defaulted (x integer DEFAULT true);
}
@sqlstate 42804
expect error {
    column "x" is of type integer but
}

test assign-add-column-default-string-literal-into-integer {
    CREATE TABLE altered (id integer);
    INSERT INTO altered VALUES (1);
    ALTER TABLE altered ADD COLUMN x integer DEFAULT '7';
    SELECT x FROM altered;
}
expect {
    7
}

test assign-add-column-default-string-literal-that-is-not-a-number {
    CREATE TABLE altered (id integer);
    ALTER TABLE altered ADD COLUMN x integer DEFAULT 'x';
}
@sqlstate 22P02
expect error {
    invalid input syntax for type integer: "x"
}

test varchar-column-takes-a-string-literal-a-text-value-and-a-longer-column {
    CREATE TABLE zz_v1 (a varchar(5), b text, c varchar(10));
    INSERT INTO zz_v1 VALUES ('abc', 'defgh', 'ijklmnop');
    INSERT INTO zz_v1 (a) SELECT b FROM zz_v1;
    INSERT INTO zz_v1 (a) SELECT 'xy'::text;
    UPDATE zz_v1 SET a = 'q' WHERE a = 'abc';
    SELECT a FROM zz_v1 ORDER BY a;
}
expect {
    defgh
    q
    xy
}

test varchar-column-rejects-a-string-literal-that-is-too-long {
    CREATE TABLE zz_v2 (a varchar(5));
    INSERT INTO zz_v2 VALUES ('abcdef');
}
@sqlstate 22001
expect error {
    value too long for
}

test varchar-column-rejects-a-text-value-that-is-too-long {
    CREATE TABLE zz_v3 (a varchar(5));
    INSERT INTO zz_v3 SELECT 'abcdef'::text;
}
@sqlstate 22001
expect error {
    value too long for
}

test varchar-column-rejects-an-update-that-is-too-long {
    CREATE TABLE zz_v4 (a varchar(3));
    INSERT INTO zz_v4 VALUES ('abc');
    UPDATE zz_v4 SET a = 'abcd';
}
@sqlstate 22001
expect error {
    value too long for
}

test varchar-column-takes-an-integer-that-fits {
    CREATE TABLE zz_v5 (a varchar(5));
    INSERT INTO zz_v5 VALUES (12345), (7::int8), (8::smallint);
    SELECT a FROM zz_v5 ORDER BY a;
}
expect {
    12345
    7
    8
}

test varchar-column-rejects-an-integer-that-is-too-long {
    CREATE TABLE zz_v6 (a varchar(5));
    INSERT INTO zz_v6 VALUES (123456);
}
@sqlstate 22001
expect error {
    value too long for
}

test varchar-column-without-a-length-takes-any-text {
    CREATE TABLE zz_v7 (a varchar);
    INSERT INTO zz_v7 VALUES ('a long enough string for the column'), (5);
    SELECT a FROM zz_v7 ORDER BY a;
}
expect {
    5
    a long enough string for the column
}

test cast-to-varchar-without-a-length {
    SELECT 'abc'::varchar, 5::varchar, 'x'::text::varchar, 'y'::character varying, NULL::varchar;
}
expect {
    abc|5|x|y|
}

@skip-if tursopg "a type modifier in a cast is not supported yet"
test cast-to-varchar-with-a-length-cuts-the-value {
    SELECT 'abcdef'::varchar(5);
}
expect {
    abcde
}

test varchar-and-text-compare-and-concatenate {
    CREATE TABLE zz_v8 (v varchar(10), t text);
    INSERT INTO zz_v8 VALUES ('a', 'a');
    SELECT (v = t)::int, (t = v)::int, (v = 'a')::int, (v < t)::int, v || t, v || v, COALESCE(v, t), (v LIKE 'a%')::int, (t LIKE v)::int, (v IN ('a', 'b'))::int FROM zz_v8;
}
expect {
    1|1|1|0|aa|aa|a|1|1|1
}

test varchar-and-text-in-case-union-and-values {
    CREATE TABLE zz_v9 (v varchar(10), t text);
    INSERT INTO zz_v9 VALUES ('a', 'b');
    SELECT CASE WHEN true THEN v ELSE t END, CASE WHEN false THEN t ELSE v END FROM zz_v9;
    SELECT v FROM zz_v9 UNION ALL SELECT t FROM zz_v9;
}
expect {
    a|a
    a
    b
}

test varchar-does-not-compare-with-an-integer {
    CREATE TABLE zz_v10 (v varchar(10));
    SELECT v = 1 FROM zz_v10;
}
@sqlstate 42883
expect error {
    operator does not exist: character varying = integer
}

test varchar-has-no-arithmetic {
    CREATE TABLE zz_v11 (v varchar(10));
    SELECT v + 1 FROM zz_v11;
}
@sqlstate 42883
expect error {
    operator does not exist: character varying \+ integer
}

@skip-if tursopg "a cast from boolean to character varying is not supported yet"
test varchar-column-takes-a-boolean {
    CREATE TABLE zz_v12 (v varchar(10));
    INSERT INTO zz_v12 VALUES (true);
    SELECT v FROM zz_v12;
}
expect {
    true
}

test varchar-functions-take-varchar-columns {
    CREATE TABLE zz_v13 (v varchar(10));
    INSERT INTO zz_v13 VALUES ('Abc');
    SELECT lower(v), upper(v), length(v) FROM zz_v13;
}
expect {
    abc|ABC|3
}

@skip-if postgres "PostgreSQL has the bpchar type"
test bpchar-is-not-supported {
    SELECT 'a'::bpchar;
}
@sqlstate 0A000
expect error {
    a cast from unknown to bpchar is not supported
}
