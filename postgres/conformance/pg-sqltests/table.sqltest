test update-set-default-uses-column-default {
    DROP TABLE IF EXISTS defaults_t;
    CREATE TABLE defaults_t (a int DEFAULT 7, b text);
    INSERT INTO defaults_t (a, b) VALUES (1, 'x');
    UPDATE defaults_t SET a = DEFAULT;
    SELECT a, b FROM defaults_t;
}
expect {
    7|x
}

test update-set-default-without-column-default-sets-null {
    DROP TABLE IF EXISTS defaults_t;
    CREATE TABLE defaults_t (a int, b text);
    INSERT INTO defaults_t (a, b) VALUES (1, 'x');
    UPDATE defaults_t SET a = DEFAULT;
    SELECT CASE WHEN a IS NULL THEN 1 ELSE 0 END, b FROM defaults_t;
}
expect {
    1|x
}

test serial-primary-key-counts-apart-from-explicit-keys {
    DROP TABLE IF EXISTS sk_a;
    CREATE TABLE sk_a (id serial PRIMARY KEY, v text);
    INSERT INTO sk_a (v) VALUES ('a');
    INSERT INTO sk_a (id, v) VALUES (100, 'b');
    INSERT INTO sk_a (v) VALUES ('c');
    SELECT id, v FROM sk_a ORDER BY v;
}
expect {
    1|a
    100|b
    2|c
}

test serial-primary-key-rejects-null {
    DROP TABLE IF EXISTS sk_n;
    CREATE TABLE sk_n (id serial PRIMARY KEY, v text);
    INSERT INTO sk_n (id, v) VALUES (NULL, 'x');
}
@sqlstate 23502
expect error {}

test serial-primary-key-default-collides-with-explicit-key {
    DROP TABLE IF EXISTS sk_c;
    CREATE TABLE sk_c (id serial PRIMARY KEY, v text);
    INSERT INTO sk_c (id, v) VALUES (1, 'x');
    INSERT INTO sk_c (v) VALUES ('y');
}
@sqlstate 23505
expect error {}

test bigserial-and-smallserial-primary-keys-use-sequence {
    DROP TABLE IF EXISTS sk_b;
    DROP TABLE IF EXISTS sk_s;
    CREATE TABLE sk_b (id bigserial PRIMARY KEY, v text);
    CREATE TABLE sk_s (id smallserial PRIMARY KEY, v text);
    INSERT INTO sk_b (v) VALUES ('a');
    INSERT INTO sk_b (id, v) VALUES (50, 'b');
    INSERT INTO sk_b (v) VALUES ('c');
    INSERT INTO sk_s (v) VALUES ('a');
    INSERT INTO sk_s (id, v) VALUES (50, 'b');
    INSERT INTO sk_s (v) VALUES ('c');
    SELECT id FROM sk_b UNION ALL SELECT id + 1000 FROM sk_s ORDER BY 1;
}
expect {
    1
    2
    50
    1001
    1002
    1050
}

