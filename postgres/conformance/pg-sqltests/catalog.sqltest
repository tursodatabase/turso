test pg-primary-key-dump-catalogs {
    CREATE TABLE items (id INTEGER PRIMARY KEY, name TEXT UNIQUE);
    CREATE SEQUENCE after_indexes;
    SELECT t.relname, c.conname, i.indkey,
           CASE WHEN t.relhasindex AND i.indisprimary AND i.indisunique THEN 1 ELSE 0 END,
           x.relkind, pg_get_constraintdef(c.oid), pg_get_indexdef(i.indexrelid)
    FROM pg_constraint c JOIN pg_class t ON t.oid = c.conrelid
    JOIN pg_index i ON i.indexrelid = c.conindid
    JOIN pg_class x ON x.oid = i.indexrelid
    WHERE t.relname = 'items' AND c.contype = 'p';
    SELECT count(*) FROM pg_depend d
    JOIN pg_constraint c ON d.refobjid = c.oid AND d.refclassid = 2606
    WHERE c.conname = 'items_pkey' AND d.classid = 1259
      AND d.objid = c.conindid AND d.deptype = 'i';
    SELECT CASE WHEN count(*) = count(DISTINCT oid) THEN 1 ELSE 0 END FROM pg_class;
}
expect {
    items|items_pkey|1|1|i|PRIMARY KEY (id)|CREATE UNIQUE INDEX items_pkey ON public.items USING btree (id)
    1
    1
}

expect @tursopg {
    items|items_pkey|1|1|i|PRIMARY KEY (id)|CREATE UNIQUE INDEX __turso_internal_pk_index_items ON public.items USING btree (id)
    1
    1
}

