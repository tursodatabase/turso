    SELECT tableoid FROM pg_catalog.pg_index LIMIT 1;
    SELECT tableoid FROM pg_catalog.pg_constraint LIMIT 1;
    SELECT tableoid FROM pg_catalog.pg_attrdef LIMIT 1;
    SELECT tableoid FROM pg_catalog.pg_depend LIMIT 1;
    CREATE TABLE refresh_schema (value TEXT);
    SELECT tableoid FROM pg_namespace LIMIT 1;
}
