    CREATE INDEX idx ON public.indexed USING btree (first DESC, second, third DESC)
}

# A relation's oid is stable: it comes from a stored catalog row, not from
# the relation's position among sorted names. Raw oid values differ between
# engines, so the tests compare through joins.

test pg-class-oid-survives-an-earlier-sorting-table-appearing {
    CREATE TABLE zz_stable (x int);
    CREATE TABLE zz_oid_memo (memo oid);
    INSERT INTO zz_oid_memo SELECT oid FROM pg_class WHERE relname = 'zz_stable';
    CREATE TABLE aa_sorts_first (x int);
    SELECT count(*) FROM pg_class c JOIN zz_oid_memo m ON c.oid = m.memo
    WHERE c.relname = 'zz_stable';
}
expect {
    1
}

test pg-attribute-keeps-joining-to-pg-class-after-an-earlier-table-appears {
    CREATE TABLE zz_attrs (id int PRIMARY KEY, v text UNIQUE);
    CREATE TABLE zz_attrs_memo (memo oid);
    INSERT INTO zz_attrs_memo SELECT oid FROM pg_class WHERE relname = 'zz_attrs';
    CREATE TABLE aa_appears (x int);
    SELECT a.attname FROM pg_attribute a JOIN zz_attrs_memo m ON a.attrelid = m.memo
    WHERE a.attnum > 0 ORDER BY a.attnum;
}
expect {
    id
    v
}

test pg-index-keeps-joining-to-pg-class-after-an-earlier-table-appears {
    CREATE TABLE zz_indexed (id int PRIMARY KEY, v text UNIQUE);
    CREATE TABLE zz_indexed_memo (memo oid);
    INSERT INTO zz_indexed_memo SELECT oid FROM pg_class WHERE relname = 'zz_indexed';
    CREATE TABLE aa_appears2 (x int);
    SELECT count(*) FROM pg_index i JOIN zz_indexed_memo m ON i.indrelid = m.memo;
}
expect {
    2
}

test pg-constraint-keeps-joining-to-pg-class-after-an-earlier-table-appears {
    CREATE TABLE zz_constrained (id int PRIMARY KEY, v text UNIQUE);
    CREATE TABLE zz_constrained_memo (memo oid);
    INSERT INTO zz_constrained_memo SELECT oid FROM pg_class WHERE relname = 'zz_constrained';
    CREATE TABLE aa_appears3 (x int);
    SELECT count(*) FROM pg_constraint con JOIN zz_constrained_memo m ON con.conrelid = m.memo
    WHERE con.contype IN ('p', 'u');
}
expect {
    2
}

test rename-keeps-the-oid {
    CREATE TABLE zz_before_rename (x int);
