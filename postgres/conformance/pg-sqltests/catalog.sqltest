test pg-attribute-default-storage {
    CREATE TABLE storage_types (
        id INTEGER PRIMARY KEY, body TEXT, label VARCHAR(40), data BYTEA,
        amount NUMERIC(10,2), enabled BOOLEAN, identifier UUID, document JSONB,
        numbers INTEGER[]
    );
    SELECT a.attname, a.attstorage
    FROM pg_attribute a JOIN pg_class c ON c.oid = a.attrelid
    WHERE c.relname = 'storage_types' AND a.attnum > 0 ORDER BY a.attnum;
}
expect {
    id|p
    body|x
    label|x
    data|x
    amount|m
    enabled|p
    identifier|p
    document|x
    numbers|x
}

test pg-attribute-domain-storage {
    CREATE DOMAIN text_value AS TEXT;
    CREATE DOMAIN nested_text_value AS text_value;
    CREATE DOMAIN number_value AS INTEGER;
    CREATE TYPE mood_storage AS ENUM ('happy', 'sad');
    CREATE TABLE domain_storage (a text_value, b nested_text_value, c number_value, d mood_storage);
    SELECT a.attname, a.attstorage, t.typstorage
    FROM pg_attribute a JOIN pg_class c ON c.oid = a.attrelid
    JOIN pg_type t ON t.oid = a.atttypid
    WHERE c.relname = 'domain_storage' AND a.attnum > 0 ORDER BY a.attnum;
}
expect {
    a|x|x
    b|x|x
    c|p|p
    d|p|p
}

test pg-dump-mixed-case-primary-key-and-reference {
    CREATE TABLE "Parent" ("Mixed Key" TEXT PRIMARY KEY);
    CREATE TABLE child ("Child Key" TEXT CONSTRAINT "Fk X" REFERENCES "Parent" ON UPDATE CASCADE ON DELETE SET NULL,
                        "Code" INTEGER CONSTRAINT "U q" UNIQUE);
    SELECT conname FROM pg_constraint JOIN pg_class ON conrelid = pg_class.oid
    WHERE contype = 'p' AND relname = 'Parent';
    SELECT substr(pg_get_indexdef(indexrelid), strpos(pg_get_indexdef(indexrelid), ' ON ') + 4) FROM pg_index JOIN pg_class ON indrelid = pg_class.oid
    WHERE indisprimary AND relname = 'Parent';
    SELECT relname FROM pg_class JOIN pg_constraint ON confrelid = pg_class.oid
    WHERE contype = 'f';
    SELECT conname, pg_get_constraintdef(c.oid) FROM pg_constraint c JOIN pg_class r ON c.conrelid = r.oid
    WHERE r.relname = 'child' AND contype IN ('f', 'u') ORDER BY conname;
    SET search_path TO '';
    SELECT pg_get_constraintdef(oid) FROM pg_constraint WHERE contype = 'f';
}
expect {
    Parent_pkey
    public."Parent" USING btree ("Mixed Key")
    Parent
    Fk X|FOREIGN KEY ("Child Key") REFERENCES "Parent"("Mixed Key") ON UPDATE CASCADE ON DELETE SET NULL
    U q|UNIQUE ("Code")
    FOREIGN KEY ("Child Key") REFERENCES public."Parent"("Mixed Key") ON UPDATE CASCADE ON DELETE SET NULL
}

test pg-get-constraintdef-check-constraints {
    CREATE TABLE checked (
        id int, owner text, code varchar(10), price numeric(10, 2), done boolean,
        CONSTRAINT a_positive CHECK (id > 0),
        CONSTRAINT b_like CHECK (owner LIKE 'a%'),
        CONSTRAINT c_text CHECK (code <> 'x'),
        CONSTRAINT d_in CHECK (id IN (1, 2)),
        CONSTRAINT e_numeric CHECK (price > 0),
        CONSTRAINT f_and CHECK (id > 0 AND id < 10),
        CONSTRAINT g_flag CHECK (done)
    );
    SELECT pg_get_constraintdef(oid) FROM pg_constraint WHERE contype = 'c' AND conrelid <> 0 ORDER BY conname;
}
expect {
    CHECK ((id > 0))
    CHECK ((owner ~~ 'a%'::text))
    CHECK (((code)::text <> 'x'::text))
    CHECK ((id = ANY (ARRAY[1, 2])))
    CHECK ((price > (0)::numeric))
    CHECK (((id > 0) AND (id < 10)))
    CHECK (done)
}

test pg-get-constraintdef-check-constraint-with-lowest-number {
    CREATE TABLE checked (
        id int, big bigint,
        CONSTRAINT a_integer CHECK (id > -2147483648),
        CONSTRAINT b_bigint CHECK (big > -9223372036854775808)
    );
    SELECT pg_get_constraintdef(oid) FROM pg_constraint WHERE contype = 'c' AND conrelid <> 0 ORDER BY conname;
}
expect {
    CHECK ((id > '-2147483648'::integer))
    CHECK ((big > '-9223372036854775808'::bigint))
}

# tursopg compiles COLLATE "default" to nothing, as it leaves the collation
# as it is, so the condition is shown without it.
@compat-gap "function:pg_get_constraintdef"
test pg-get-constraintdef-check-constraint-with-collate {
    CREATE TABLE checked (
        owner text, code varchar(10),
        CONSTRAINT a_literal CHECK (owner < 'a' COLLATE "C"),
        CONSTRAINT b_column CHECK (owner COLLATE "C" > 'b'),
        CONSTRAINT c_varchar CHECK (code COLLATE "C" <> 'x'),
        CONSTRAINT d_default CHECK (owner COLLATE "default" <> 'd')
    );
    SELECT pg_get_constraintdef(oid) FROM pg_constraint WHERE contype = 'c' AND conrelid <> 0 ORDER BY conname;
}
expect {
    CHECK ((owner < ('a'::text COLLATE "C")))
    CHECK (((owner COLLATE "C") > 'b'::text))
    CHECK ((((code)::text COLLATE "C") <> 'x'::text))
    CHECK (((owner COLLATE "default") <> 'd'::text))
}
expect @tursopg {
    CHECK ((owner < ('a'::text COLLATE "C")))
    CHECK (((owner COLLATE "C") > 'b'::text))
    CHECK ((((code)::text COLLATE "C") <> 'x'::text))
    CHECK ((owner <> 'd'::text))
}

test pg-attrdef-default-with-collate {
    CREATE TABLE defaulted (owner text DEFAULT ('x' COLLATE "C"));
    SELECT pg_get_expr(adbin, adrelid) FROM pg_attrdef;
}
expect {
    ('x'::text COLLATE "C")
}

# tursopg does not print the casts of the || operator and shows the condition
# as the engine stores it.
@compat-gap "function:pg_get_constraintdef"
test pg-get-constraintdef-check-constraint-with-concatenation {
    CREATE TABLE checked (owner text CHECK (owner || 'x' <> 'ax'));
    SELECT pg_get_constraintdef(oid) FROM pg_constraint WHERE contype = 'c' AND conrelid <> 0;
}
expect {
    CHECK (((owner || 'x'::text) <> 'ax'::text))
}
expect @tursopg {
    CHECK ((owner || 'x') != 'ax')
}

test pg-mixed-case-names-in-separate-schemas {
    CREATE SCHEMA other;
    CREATE TABLE public."Mixed Table" ("Mixed Id" INTEGER CONSTRAINT "Inline PK" PRIMARY KEY);
    CREATE TABLE other."Mixed Table" ("Mixed Key" TEXT, CONSTRAINT "Table PK" PRIMARY KEY ("Mixed Key"));
    CREATE TABLE child (key TEXT REFERENCES other."Mixed Table" ("Mixed Key"));
    SELECT schemaname, tablename FROM pg_tables WHERE tablename = 'Mixed Table' ORDER BY schemaname;
    SELECT n.nspname, r.relname, c.conname, pg_get_constraintdef(c.oid)
    FROM pg_constraint c JOIN pg_class r ON r.oid = c.conrelid
    JOIN pg_namespace n ON n.oid = r.relnamespace
    WHERE c.contype = 'p' AND r.relname = 'Mixed Table' ORDER BY n.nspname;
    SELECT n.nspname, r.relname FROM pg_class r JOIN pg_constraint c ON c.confrelid = r.oid
    JOIN pg_namespace n ON n.oid = r.relnamespace WHERE c.contype = 'f';
    SELECT pg_get_constraintdef(oid) FROM pg_constraint WHERE contype = 'f';
    SET search_path TO other, public;
    SELECT pg_get_constraintdef(oid) FROM pg_constraint WHERE contype = 'f';
    SET search_path TO public, other;
    SELECT pg_get_constraintdef(oid) FROM pg_constraint WHERE contype = 'f';
    CREATE SCHEMA shadow;
    CREATE SEQUENCE shadow."Mixed Table";
    SET search_path TO shadow, other;
    SELECT pg_get_constraintdef(oid) FROM pg_constraint WHERE contype = 'f';
    DROP SEQUENCE shadow."Mixed Table";
    CREATE TABLE shadow.holder(id INTEGER);
    CREATE INDEX "Mixed Table" ON shadow.holder(id);
    SELECT pg_get_constraintdef(oid) FROM pg_constraint WHERE contype = 'f';
}
expect {
    other|Mixed Table
    public|Mixed Table
    other|Mixed Table|Table PK|PRIMARY KEY ("Mixed Key")
    public|Mixed Table|Inline PK|PRIMARY KEY ("Mixed Id")
    other|Mixed Table
    FOREIGN KEY (key) REFERENCES other."Mixed Table"("Mixed Key")
    FOREIGN KEY (key) REFERENCES "Mixed Table"("Mixed Key")
    FOREIGN KEY (key) REFERENCES other."Mixed Table"("Mixed Key")
    FOREIGN KEY (key) REFERENCES other."Mixed Table"("Mixed Key")
    FOREIGN KEY (key) REFERENCES other."Mixed Table"("Mixed Key")
}

test pg-dump-descending-index-keys {
    CREATE TABLE indexed (first INTEGER, second BIGINT, third TEXT);
    CREATE INDEX idx ON indexed (first DESC, second ASC, third DESC);
