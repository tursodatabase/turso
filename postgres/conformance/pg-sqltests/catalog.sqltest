setup catalog_sequences {
    CREATE SEQUENCE catalog_explicit_seq;
    CREATE SEQUENCE "catalog quoted seq";
    CREATE TABLE catalog_serial (id SERIAL, value TEXT);
    CREATE INDEX catalog_serial_value_idx ON catalog_serial(value);
}

@setup catalog_sequences
test pg-class-lists-sequences {
    SELECT c.relname, c.relkind, n.nspname, c.relnatts, c.relam,
           c.relpersistence, c.relreplident, c.tableoid,
           CASE WHEN c.relhasindex THEN 1 ELSE 0 END
    FROM pg_catalog.pg_class c
    JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
    WHERE c.relkind = 'S' AND n.nspname = 'public'
    ORDER BY c.relname;
}
expect {
    catalog quoted seq|S|public|3|0|p|n|1259|0
    catalog_explicit_seq|S|public|3|0|p|n|1259|0
    catalog_serial_id_seq|S|public|3|0|p|n|1259|0
}

@setup catalog_sequences
test pg-class-sequence-oids-do-not-collide {
    SELECT COUNT(*), COUNT(DISTINCT c.oid)
    FROM pg_catalog.pg_class c
    JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
    WHERE n.nspname = 'public' AND c.relkind IN ('r', 'i', 'S');
}
expect {
    5|5
}

@setup catalog_sequences
test pg-class-removes-dropped-sequences {
    DROP SEQUENCE catalog_explicit_seq;
    SELECT relname FROM pg_catalog.pg_class
    WHERE relkind = 'S' AND relnamespace = 2200 ORDER BY relname;
}
expect {
    catalog quoted seq
    catalog_serial_id_seq
}

test pg-sequence-empty-pgdump-query {
    SELECT seqrelid, format_type(seqtypid, NULL), seqstart, seqincrement,
           seqmax, seqmin, seqcache, seqcycle, NULL, 'f'
    FROM pg_catalog.pg_sequence ORDER BY seqrelid;
}
expect {}

test pg-sequence-metadata-matches-pg-class {
    CREATE TABLE seq_items (id bigint PRIMARY KEY, label text);
    CREATE INDEX seq_items_label ON seq_items (label);
    CREATE SEQUENCE ascending_seq START 7 INCREMENT 3 MINVALUE 1 MAXVALUE 100 CYCLE;
    CREATE SEQUENCE descending_seq START -5 INCREMENT -2 MINVALUE -99 MAXVALUE -1;
    SELECT c.relname, format_type(s.seqtypid, NULL), s.seqstart,
           s.seqincrement, s.seqmax, s.seqmin, s.seqcache, s.seqcycle
    FROM pg_catalog.pg_sequence AS s
    JOIN pg_catalog.pg_class AS c ON c.oid = s.seqrelid
    WHERE c.relkind = 'S' ORDER BY c.relname;
}
expect {
    ascending_seq|bigint|7|3|100|1|1|t
    descending_seq|bigint|-5|-2|-1|-99|1|f
}

test pg-sequence-reflects-drop {
    CREATE SEQUENCE removed_seq;
    CREATE SEQUENCE kept_seq;
    DROP SEQUENCE removed_seq;
    SELECT c.relname FROM pg_sequence AS s
    JOIN pg_class AS c ON c.oid = s.seqrelid ORDER BY c.relname;
}
expect {
    kept_seq
}

test pg-primary-key-dump-catalogs {
    CREATE TABLE items (id INTEGER PRIMARY KEY, name TEXT UNIQUE);
    CREATE SEQUENCE after_indexes;
    SELECT t.relname, c.conname, i.indkey,
           CASE WHEN t.relhasindex AND i.indisprimary AND i.indisunique THEN 1 ELSE 0 END,
           x.relkind, pg_get_constraintdef(c.oid), pg_get_indexdef(i.indexrelid)
    FROM pg_constraint c JOIN pg_class t ON t.oid = c.conrelid
    JOIN pg_index i ON i.indexrelid = c.conindid
    JOIN pg_class x ON x.oid = i.indexrelid
    WHERE t.relname = 'items' AND c.contype = 'p';
    SELECT count(*) FROM pg_depend d
    JOIN pg_constraint c ON d.refobjid = c.oid AND d.refclassid = 2606
    WHERE c.conname = 'items_pkey' AND d.classid = 1259
      AND d.objid = c.conindid AND d.deptype = 'i';
    SELECT CASE WHEN count(*) = count(DISTINCT oid) THEN 1 ELSE 0 END FROM pg_class;
}
expect {
    items|items_pkey|1|1|i|PRIMARY KEY (id)|CREATE UNIQUE INDEX items_pkey ON public.items USING btree (id)
    1
    1
}

test pg-primary-key-with-other-unique-constraint {
    CREATE TABLE keys (a TEXT UNIQUE, b TEXT, c TEXT, PRIMARY KEY (b, c));
    SELECT c.contype, i.indkey, CASE WHEN i.indisprimary THEN 1 ELSE 0 END,
           pg_get_constraintdef(c.oid)
    FROM pg_constraint c JOIN pg_class t ON t.oid = c.conrelid
    JOIN pg_index i ON i.indexrelid = c.conindid
    WHERE t.relname = 'keys' ORDER BY c.contype;
}
expect {
    p|2 3|1|PRIMARY KEY (b, c)
    u|1|0|UNIQUE (a)
}

test pg-primary-key-named-and-quoted {
    CREATE TABLE "quoted table" (payload TEXT, "key column" INTEGER CONSTRAINT "custom key" PRIMARY KEY);
    SELECT c.conname, i.indkey, pg_get_constraintdef(c.oid), pg_get_indexdef(c.conindid)
    FROM pg_constraint c JOIN pg_class t ON t.oid = c.conrelid
    JOIN pg_index i ON i.indexrelid = c.conindid
    WHERE t.relname = 'quoted table' AND c.contype = 'p';
    SELECT indexname, indexdef FROM pg_indexes WHERE tablename = 'quoted table';
}
expect {
    custom key|2|PRIMARY KEY ("key column")|CREATE UNIQUE INDEX "custom key" ON public."quoted table" USING btree ("key column")
    custom key|CREATE UNIQUE INDEX "custom key" ON public."quoted table" USING btree ("key column")
}

test pg-primary-key-after-identical-unique {
    CREATE TABLE t(a TEXT, UNIQUE(a), PRIMARY KEY(a));
    CREATE TABLE composite(a TEXT, b TEXT, UNIQUE(a, b), CONSTRAINT named_pk PRIMARY KEY(a, b));
    SELECT t.relname, c.conname, c.contype, pg_get_constraintdef(c.oid),
           CASE WHEN i.indisprimary THEN 1 ELSE 0 END
    FROM pg_constraint c JOIN pg_class t ON t.oid = c.conrelid
    JOIN pg_index i ON i.indexrelid = c.conindid
    WHERE t.relname IN ('t', 'composite') ORDER BY t.relname;
}
expect {
    composite|named_pk|p|PRIMARY KEY (a, b)|1
    t|t_pkey|p|PRIMARY KEY (a)|1
}

test pg-primary-key-index-name-collisions {
    CREATE TABLE t_pkey(x INTEGER);
    CREATE INDEX t_pkey1 ON t_pkey(x);
    CREATE SEQUENCE t_pkey2;
    CREATE TABLE t(id INTEGER PRIMARY KEY);
    SELECT c.conname, x.relname, pg_get_indexdef(c.conindid)
    FROM pg_constraint c JOIN pg_class t ON t.oid = c.conrelid
    JOIN pg_class x ON x.oid = c.conindid WHERE t.relname = 't';
    SELECT CASE WHEN count(*) = count(DISTINCT relname) THEN 1 ELSE 0 END
    FROM pg_class WHERE relnamespace = 2200;
    DROP TABLE t_pkey;
    DROP SEQUENCE t_pkey2;
    SELECT c.conname, x.relname FROM pg_constraint c
    JOIN pg_class t ON t.oid = c.conrelid JOIN pg_class x ON x.oid = c.conindid
    WHERE t.relname = 't';
}
expect {
    t_pkey3|t_pkey3|CREATE UNIQUE INDEX t_pkey3 ON public.t USING btree (id)
    1
    t_pkey3|t_pkey3
}

test pg-attribute-not-null-dump {
    CREATE TABLE dump_nulls (id INTEGER PRIMARY KEY, required TEXT NOT NULL, optional TEXT);
    SELECT a.attname, a.attnotnull,
           CASE WHEN a.attislocal THEN true
                WHEN a.attnotnull AND NOT a.attislocal THEN true
                ELSE false END AS notnull_islocal
    FROM pg_attribute a JOIN pg_class c ON c.oid = a.attrelid
    WHERE c.relname = 'dump_nulls' AND a.attnum > 0 ORDER BY a.attnum;
}
expect {
    id|t|t
    required|t|t
    optional|f|t
}

test pg-boolean-case-results {
    SELECT true, false, CASE WHEN true THEN true ELSE false END,
           CASE WHEN false THEN true ELSE false END,
           CASE WHEN false THEN true END,
           CASE WHEN true THEN 1 ELSE 0 END;
    CREATE TABLE bools (value BOOLEAN);
    INSERT INTO bools VALUES (true), (false);
    SELECT CASE WHEN true THEN value ELSE false END FROM bools ORDER BY value;
    SELECT CASE WHEN true THEN (CASE WHEN false THEN false ELSE true END) ELSE NULL END,
           CASE WHEN true THEN NULL ELSE NULL END,
           CASE WHEN true THEN 1 ELSE NULL END;
}
expect {
    t|f|t|f||1
    f
    t
    t||1
}

test pg-public-schema-owner-and-acl {
    SELECT n.nspowner, r.rolname, pg_get_userbyid(n.nspowner), n.nspacl::text,
           acldefault('n', n.nspowner)::text
    FROM pg_namespace n JOIN pg_roles r ON r.oid = n.nspowner
    WHERE n.nspname = 'public';
    SELECT oid, rolname, CAST(rolsuper AS INTEGER), CAST(rolinherit AS INTEGER),
           CAST(rolcreaterole AS INTEGER), CAST(rolcreatedb AS INTEGER),
           CAST(rolcanlogin AS INTEGER), CAST(rolreplication AS INTEGER),
           rolconnlimit, CAST(rolbypassrls AS INTEGER)
    FROM pg_roles WHERE rolname = 'pg_database_owner';
}
expect {
    6171|pg_database_owner|pg_database_owner|{pg_database_owner=UC/pg_database_owner,=U/pg_database_owner}|{pg_database_owner=UC/pg_database_owner}
    6171|pg_database_owner|0|1|0|0|0|0|-1|0
}

test pg-description-public-schema-default {
    SELECT d.objoid, d.classoid, d.objsubid, d.description
    FROM pg_catalog.pg_description d
    JOIN pg_catalog.pg_namespace n ON n.oid = d.objoid
    WHERE n.nspname = 'public' AND d.classoid = 2615 AND d.objsubid = 0;
}
expect {
    2200|2615|0|standard public schema
}

test obj-description-reads-the-comment-of-the-public-schema {
    SELECT obj_description(oid, 'pg_namespace'), obj_description(oid, 'pg_class')
    FROM pg_namespace WHERE nspname = 'public';
}
expect {
    standard public schema|
}

test obj-description-of-a-subquery-with-an-aggregate {
    SELECT obj_description((SELECT max(oid) FROM pg_namespace WHERE nspname = 'public'), 'pg_namespace');
}
expect {
    standard public schema
}

@skip-if postgres "PostgreSQL looks up the comment of an aggregate"
test obj-description-of-an-aggregate-is-not-supported {
    SELECT obj_description(max(oid), 'pg_namespace') FROM pg_namespace WHERE nspname = 'public';
}
@sqlstate 0A000
expect error {
    obj_description of an aggregate or window function is not supported
}

@skip-if postgres "PostgreSQL looks up the comment of a window function"
test col-description-of-a-window-function-is-not-supported {
    SELECT col_description(oid, row_number() OVER ()) FROM pg_namespace WHERE nspname = 'public';
}
@sqlstate 0A000
expect error {
    col_description of an aggregate or window function is not supported
}

@skip-if postgres "PostgreSQL accepts obj_description in a column default"
test obj-description-in-a-column-default-is-not-supported {
    CREATE TABLE description_default (x int, y text DEFAULT obj_description(1, 'pg_class'));
}
@sqlstate 0A000
expect error {
    obj_description in a table definition is not supported
}

@skip-if postgres "PostgreSQL accepts col_description in a CHECK constraint"
test col-description-in-a-check-constraint-is-not-supported {
    CREATE TABLE description_check (x int, CHECK (col_description(x, 1) IS NULL));
}
@sqlstate 0A000
expect error {
    col_description in a table definition is not supported
}

@skip-if postgres "PostgreSQL accepts obj_description in the default of an added column"
test obj-description-in-the-default-of-an-added-column-is-not-supported {
    CREATE TABLE description_added (x int);
    ALTER TABLE description_added ADD COLUMN y text DEFAULT obj_description(1, 'pg_class');
}
@sqlstate 0A000
expect error {
    obj_description in a table definition is not supported
}

@skip-if postgres "PostgreSQL refuses it as not immutable"
test obj-description-in-an-index-is-not-supported {
    CREATE TABLE description_indexed (x int);
    CREATE INDEX description_index ON description_indexed ((obj_description(x, 'pg_class')));
}
@sqlstate 0A000
expect error {
    obj_description in an index is not supported
}

test obj-description-in-create-table-as {
    CREATE TABLE description_copy AS
        SELECT obj_description(oid, 'pg_namespace') AS d FROM pg_namespace WHERE nspname = 'public';
    SELECT d FROM description_copy;
}
expect {
    standard public schema
}

test comment-on-table-is-stored-and-replaced {
    CREATE TABLE commented_table (a int);
    COMMENT ON TABLE commented_table IS 'first';
    SELECT obj_description(c.oid, 'pg_class'), obj_description(c.oid)
    FROM pg_class c WHERE c.relname = 'commented_table';
    COMMENT ON TABLE commented_table IS 'it''s the second';
    SELECT obj_description(oid, 'pg_class') FROM pg_class WHERE relname = 'commented_table';
    SELECT count(*) FROM pg_description d JOIN pg_class c ON c.oid = d.objoid
    WHERE c.relname = 'commented_table' AND d.classoid = 1259;
}
expect {
    first|first
    it's the second
    1
}

test comment-on-table-is-removed-by-null-and-by-empty-text {
    CREATE TABLE uncommented_table (a int);
    CREATE TABLE emptied_table (a int);
    COMMENT ON TABLE uncommented_table IS 'x';
    COMMENT ON TABLE emptied_table IS 'x';
    COMMENT ON TABLE uncommented_table IS NULL;
    COMMENT ON TABLE emptied_table IS '';
    SELECT relname, coalesce(obj_description(oid, 'pg_class'), 'no comment') FROM pg_class
    WHERE relname IN ('uncommented_table', 'emptied_table') ORDER BY relname;
    SELECT count(*) FROM pg_description d JOIN pg_class c ON c.oid = d.objoid
    WHERE c.relname IN ('uncommented_table', 'emptied_table');
}
expect {
    emptied_table|no comment
    uncommented_table|no comment
    0
}

test comment-on-column-is-read-by-col-description {
    CREATE TABLE commented_columns (a int, b int, c int);
    COMMENT ON COLUMN commented_columns.a IS 'the a';
    COMMENT ON COLUMN public.commented_columns.c IS 'the c';
    SELECT a.attname, col_description(a.attrelid, a.attnum)
    FROM pg_attribute a JOIN pg_class c ON c.oid = a.attrelid
    WHERE c.relname = 'commented_columns' AND a.attnum > 0 ORDER BY a.attnum;
    SELECT obj_description(oid, 'pg_class') FROM pg_class WHERE relname = 'commented_columns';
}
expect {
    a|the a
    b|
    c|the c
    
}

test comment-on-index-is-stored {
    CREATE TABLE commented_indexed (a int);
    CREATE INDEX commented_index ON commented_indexed (a);
    COMMENT ON INDEX commented_index IS 'an index';
    SELECT relname, obj_description(oid, 'pg_class') FROM pg_class
    WHERE relname IN ('commented_indexed', 'commented_index') ORDER BY relname;
}
expect {
    commented_index|an index
    commented_indexed|
}

test comment-on-sequence-is-stored {
    CREATE SEQUENCE commented_sequence;
    COMMENT ON SEQUENCE commented_sequence IS 'a sequence';
    SELECT obj_description(oid, 'pg_class') FROM pg_class WHERE relname = 'commented_sequence';
}
expect {
    a sequence
}

test comment-on-schema-is-stored {
    CREATE SCHEMA commented_schema;
    COMMENT ON SCHEMA commented_schema IS 'a schema';
    SELECT obj_description(oid, 'pg_namespace') FROM pg_namespace
    WHERE nspname = 'commented_schema';
}
expect {
    a schema
}

test comment-on-quoted-names-with-capital-letters {
    CREATE SCHEMA "CommentUp";
    CREATE TABLE "CommentUp"."MixT" ("ColA" int, b int);
    COMMENT ON SCHEMA "CommentUp" IS 'mixed schema';
    COMMENT ON TABLE "CommentUp"."MixT" IS 'mixed table';
    COMMENT ON COLUMN "CommentUp"."MixT"."ColA" IS 'mixed column';
    SELECT objsubid, description FROM pg_description
    WHERE description LIKE 'mixed %' ORDER BY description;
}
expect {
    1|mixed column
    0|mixed schema
    0|mixed table
}

test comment-on-view-is-stored-and-dropped-with-the-view {
    CREATE TABLE commented_view_base (a int);
    CREATE VIEW commented_view AS SELECT a FROM commented_view_base;
    COMMENT ON VIEW commented_view IS 'a commented view';
    SELECT objsubid, description FROM pg_description WHERE description = 'a commented view';
    DROP VIEW commented_view;
    SELECT count(*) FROM pg_description WHERE description = 'a commented view';
}
expect {
    0|a commented view
    0
}

test comment-is-rolled-back-with-its-transaction {
    CREATE TABLE comment_rolled_back (a int);
    COMMENT ON TABLE comment_rolled_back IS 'kept';
    BEGIN;
    COMMENT ON TABLE comment_rolled_back IS 'undone';
    COMMENT ON COLUMN comment_rolled_back.a IS 'undone';
    ROLLBACK;
    SELECT obj_description(oid, 'pg_class'), col_description(oid, 1) FROM pg_class
    WHERE relname = 'comment_rolled_back';
}
expect {
    kept|
}

test dropping-a-relation-deletes-its-comments {
    CREATE TABLE comment_dropped (a int, b int);
    CREATE INDEX comment_dropped_index ON comment_dropped (b);
    CREATE TABLE comment_kept (a int);
    CREATE SEQUENCE comment_dropped_sequence;
    COMMENT ON TABLE comment_dropped IS 'table';
    COMMENT ON COLUMN comment_dropped.a IS 'column';
    COMMENT ON INDEX comment_dropped_index IS 'index';
    COMMENT ON SEQUENCE comment_dropped_sequence IS 'sequence';
    COMMENT ON TABLE comment_kept IS 'kept';
    DROP TABLE comment_dropped;
    DROP SEQUENCE comment_dropped_sequence;
    SELECT description FROM pg_description
    WHERE description IN ('table', 'column', 'index', 'sequence', 'kept');
}
expect {
    kept
}

test dropping-a-schema-deletes-its-comment {
    CREATE SCHEMA comment_dropped_schema;
    COMMENT ON SCHEMA comment_dropped_schema IS 'dropped schema';
    DROP SCHEMA comment_dropped_schema;
    SELECT count(*) FROM pg_description WHERE description = 'dropped schema';
}
expect {
    0
}

@skip-if postgres "PostgreSQL keeps the number of a column when a column before it is dropped"
test dropping-a-column-deletes-its-comment-and-keeps-the-others {
    CREATE TABLE comment_column_dropped (a int, b int, c int);
    COMMENT ON TABLE comment_column_dropped IS 'the table';
    COMMENT ON COLUMN comment_column_dropped.a IS 'the a';
    COMMENT ON COLUMN comment_column_dropped.b IS 'the b';
    COMMENT ON COLUMN comment_column_dropped.c IS 'the c';
    ALTER TABLE comment_column_dropped DROP COLUMN b;
    SELECT a.attname, col_description(a.attrelid, a.attnum)
    FROM pg_attribute a JOIN pg_class c ON c.oid = a.attrelid
    WHERE c.relname = 'comment_column_dropped' ORDER BY a.attnum;
    SELECT obj_description(oid, 'pg_class') FROM pg_class
    WHERE relname = 'comment_column_dropped';
    SELECT count(*) FROM pg_description WHERE description = 'the b';
}
expect {
    a|the a
    c|the c
    the table
    0
}

test dropping-a-column-is-rolled-back-with-its-comments {
    CREATE TABLE comment_drop_undone (a int, b int);
    COMMENT ON COLUMN comment_drop_undone.a IS 'undone a';
    COMMENT ON COLUMN comment_drop_undone.b IS 'undone b';
    BEGIN;
    ALTER TABLE comment_drop_undone DROP COLUMN a;
    ROLLBACK;
    SELECT a.attname, col_description(a.attrelid, a.attnum)
    FROM pg_attribute a JOIN pg_class c ON c.oid = a.attrelid
    WHERE c.relname = 'comment_drop_undone' AND a.attnum > 0 ORDER BY a.attnum;
}
expect {
    a|undone a
    b|undone b
}

test dropping-a-column-of-a-quoted-table-keeps-the-other-comments {
    CREATE TABLE "MixDrop" ("ColA" int, "ColB" int);
    COMMENT ON COLUMN "MixDrop"."ColA" IS 'mixdrop a';
    COMMENT ON COLUMN "MixDrop"."ColB" IS 'mixdrop b';
    ALTER TABLE "MixDrop" DROP COLUMN "ColA";
    SELECT a.attname, col_description(a.attrelid, a.attnum)
    FROM pg_attribute a JOIN pg_class c ON c.oid = a.attrelid
    WHERE c.relname = 'MixDrop' AND a.attnum > 0 AND NOT a.attisdropped ORDER BY a.attnum;
    SELECT count(*) FROM pg_description WHERE description = 'mixdrop a';
}
expect {
    ColB|mixdrop b
    0
}

