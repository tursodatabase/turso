    ALTER TABLE zz_identity_depend_alter ADD COLUMN f int;
    SELECT s.relname, d.refobjsubid, d.deptype
    FROM pg_depend d
    JOIN pg_class s ON s.oid = d.objid
    JOIN pg_class t ON t.oid = d.refobjid
    WHERE d.deptype = 'i' AND s.relkind = 'S' AND t.relname = 'zz_identity_depend_alter'
    ORDER BY d.refobjsubid;
}
expect {
    zz_identity_depend_alter_a_seq|1|i
}

test pg-depend-serial-and-owned-sequences-depend-automatically {
    CREATE TABLE zz_serial_depend (a serial, b text, c bigserial);
    CREATE SEQUENCE zz_serial_depend_owned_seq;
    ALTER SEQUENCE zz_serial_depend_owned_seq OWNED BY zz_serial_depend.b;
    SELECT s.relname, d.refobjsubid, d.deptype
    FROM pg_depend d
    JOIN pg_class s ON s.oid = d.objid
    JOIN pg_class t ON t.oid = d.refobjid
    WHERE d.deptype IN ('a', 'i') AND s.relkind = 'S' AND t.relname = 'zz_serial_depend'
    ORDER BY d.refobjsubid;
}
expect {
    zz_serial_depend_a_seq|1|a
    zz_serial_depend_owned_seq|2|a
    zz_serial_depend_c_seq|3|a
}

test pg-description-rejects-ddl {
    DROP TABLE pg_description;
}
@sqlstate 42501
expect error {
    permission denied: "pg_description" is a system catalog
}

test system-catalog-rejects-policies {
    CREATE POLICY p ON pg_description USING (true);
}
@sqlstate 42501
expect error {
    permission denied: "pg_description" is a system catalog
}

test pg-depend-has-the-relations-that-a-view-reads {
    CREATE TABLE dep_base (a int);
    CREATE TABLE dep_other (a int);
    CREATE TABLE dep_unread (a int);
    CREATE VIEW dep_inner AS SELECT a FROM dep_base;
    CREATE VIEW dep_outer AS
        SELECT a FROM dep_inner WHERE EXISTS (SELECT 1 FROM dep_other);
    SELECT DISTINCT t.relname, d.deptype
    FROM pg_depend d JOIN pg_class t ON t.oid = d.refobjid
    WHERE d.classid = 2618 AND d.refclassid = 1259
      AND t.relname IN ('dep_base', 'dep_other', 'dep_unread')
    ORDER BY 1;
}
expect {
    dep_base|n
    dep_other|n
}
