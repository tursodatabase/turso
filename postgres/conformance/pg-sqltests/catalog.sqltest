test pg-depend-identity-sequence-belongs-to-its-column {
    CREATE TABLE zz_identity_depend (
        a int GENERATED ALWAYS AS IDENTITY,
        b text,
        c bigint GENERATED BY DEFAULT AS IDENTITY
    );
    SELECT s.relname, d.refobjsubid, d.deptype
    FROM pg_depend d
    JOIN pg_class s ON s.oid = d.objid
    JOIN pg_class t ON t.oid = d.refobjid
    WHERE d.deptype = 'i' AND s.relkind = 'S' AND t.relname = 'zz_identity_depend'
    ORDER BY d.refobjsubid;
}
expect {
    zz_identity_depend_a_seq|1|i
    zz_identity_depend_c_seq|3|i
}

test pg-depend-identity-sequence-survives-add-column {
