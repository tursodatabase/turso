# PostgreSQL catalog views queried through the PostgreSQL frontend.

@database :memory:

test pg-collation-pgdump-columns {
    SELECT tableoid, oid, collname, collnamespace, collowner, collencoding
    FROM pg_catalog.pg_collation
    WHERE oid >= 16384;
}
expect {}

setup indexed_tables {
    CREATE TABLE items (id int, name text, price int);
    CREATE INDEX items_name_idx ON items (name);
    CREATE UNIQUE INDEX items_price_idx ON items (price);
    CREATE TABLE orders (id int, item_id int);
    CREATE INDEX orders_item_idx ON orders (item_id);
}

@setup indexed_tables
test pg-indexes-lists-user-indexes {
    SELECT schemaname, tablename, indexname
    FROM pg_indexes
    WHERE schemaname = 'public'
    ORDER BY indexname;
}
expect {
    public|items|items_name_idx
    public|items|items_price_idx
    public|orders|orders_item_idx
}

@setup indexed_tables
test pg-indexes-join-pg-namespace {
    SELECT tablename, indexname
    FROM pg_indexes
    JOIN pg_namespace ON (schemaname = nspname)
    WHERE schemaname = 'public'
    ORDER BY pg_namespace.oid, indexname;
}
expect {
    items|items_name_idx
    items|items_price_idx
    orders|orders_item_idx
}

test pg-indexes-lists-names-chosen-for-unnamed-indexes {
    CREATE TABLE t (a int, b int, c text);
    CREATE INDEX ON t (a);
    CREATE INDEX ON t (b);
    CREATE INDEX ON t (a);
    CREATE INDEX ON t (a) WHERE b > 0;
    CREATE INDEX ON t (a, b);
    CREATE UNIQUE INDEX ON t (a, b);
    CREATE INDEX ON t (a, a);
    CREATE INDEX ON t ((a + b));
    CREATE INDEX ON t (lower(c));
    CREATE INDEX ON t ((c::text));
    CREATE TABLE u_b_idx (x int);
    CREATE SEQUENCE u_b_idx1;
    CREATE TABLE u (b int);
    CREATE INDEX ON u (b);
    CREATE TABLE v (c text, arr int[]);
    CREATE INDEX ON v ((lower(c) COLLATE "C"));
    CREATE INDEX ON v ((c::text COLLATE "C"));
    CREATE INDEX ON v (((c || 'x') COLLATE "C"));
    CREATE INDEX ON v ((arr[1]));
    CREATE INDEX ON v ((ARRAY[c]));
    CREATE TABLE w (abcdefghijabcdefghijabcdefghijabcdefghij int, klmnopqrstklmnopqrstklmnopqrstklmnopqrst int);
    CREATE INDEX ON w (abcdefghijabcdefghijabcdefghijabcdefghij, klmnopqrstklmnopqrstklmnopqrstklmnopqrst);
    CREATE INDEX ON w (abcdefghijabcdefghijabcdefghijabcdefghij, klmnopqrstklmnopqrstklmnopqrstklmnopqrst);
    DROP INDEX w_abcdefghijabcdefghijabcdefghijabcdefghij_klmnopqrstklmnop_idx;
    CREATE INDEX ON w (abcdefghijabcdefghijabcdefghijabcdefghij, klmnopqrstklmnopqrstklmnopqrstklmnopqrst);
    SELECT tablename, indexname
    FROM pg_indexes
    WHERE schemaname = 'public'
    ORDER BY tablename, indexname;
}
expect {
    t|t_a_a1_idx
    t|t_a_b_idx
    t|t_a_b_idx1
    t|t_a_idx
    t|t_a_idx1
    t|t_a_idx2
    t|t_b_idx
    t|t_c_idx
    t|t_expr_idx
    t|t_lower_idx
    u|u_b_idx2
    v|v_arr_idx
    v|v_array_idx
    v|v_c_idx
    v|v_expr_idx
    v|v_lower_idx
    w|w_abcdefghijabcdefghijabcdefghijabcdefghij_klmnopqrstklmno_idx1
    w|w_abcdefghijabcdefghijabcdefghijabcdefghij_klmnopqrstklmnop_idx
}

test catalog-pg-type-enum-and-domain {
    CREATE TYPE catalog_mood AS ENUM ('sad', 'happy');
    CREATE DOMAIN catalog_posint AS integer;
    SELECT typname, typtype, typbasetype, typnamespace
    FROM pg_type
    WHERE typname IN ('catalog_mood', 'catalog_posint')
    ORDER BY typname;
}
expect {
    catalog_mood|e|0|2200
    catalog_posint|d|23|2200
}

test catalog-pg-attribute-enum-and-domain-columns {
    CREATE TYPE catalog_color AS ENUM ('red', 'blue');
    CREATE DOMAIN catalog_age AS integer;
    CREATE TABLE catalog_t (c catalog_color, a catalog_age);
    SELECT a.attname, ty.typname
    FROM pg_attribute a
    JOIN pg_class c ON c.oid = a.attrelid
    JOIN pg_type ty ON ty.oid = a.atttypid
    WHERE c.relname = 'catalog_t' AND a.attnum > 0
    ORDER BY a.attnum;
}
expect {
    c|catalog_color
    a|catalog_age
}

test pg-attribute-default-compression {
    CREATE TABLE compression_columns (id integer NOT NULL, body text, amount integer DEFAULT 7);
    SELECT a.attname, quote_literal(a.attcompression::text), a.attnotnull, a.atthasdef,
           a.attidentity, a.attgenerated, a.attisdropped, a.attislocal, a.attinhcount
    FROM pg_catalog.pg_attribute a
    JOIN pg_catalog.pg_class c ON c.oid = a.attrelid
    WHERE c.relname = 'compression_columns' AND a.attnum > 0
    ORDER BY a.attnum;
}
expect {
    id|''|t|f|||f|t|0
    body|''|f|f|||f|t|0
    amount|''|f|t|||f|t|0
}

test pg-index-nulls-are-distinct {
    CREATE TABLE nullable_index_columns (a integer, b text);
    CREATE INDEX nullable_plain_idx ON nullable_index_columns (a);
    CREATE UNIQUE INDEX nullable_unique_idx ON nullable_index_columns (a, b);
    INSERT INTO nullable_index_columns VALUES (NULL, 'same'), (NULL, 'same'), (1, NULL), (1, NULL);
    SELECT c.relname, i.indisunique, i.indnullsnotdistinct, i.indisprimary,
           i.indimmediate, i.indisvalid, i.indisready, i.indkey
    FROM pg_catalog.pg_index i
    JOIN pg_catalog.pg_class c ON c.oid = i.indexrelid
    WHERE c.relname IN ('nullable_plain_idx', 'nullable_unique_idx')
    ORDER BY c.relname;
    SELECT count(*) FROM nullable_index_columns;
}
expect {
    nullable_plain_idx|f|f|f|t|t|t|1
    nullable_unique_idx|t|f|f|t|t|t|1 2
    4
}

test pg-settings-default-search-path {
    SELECT setting, source, boot_val, reset_val, context, vartype,
           unit, min_val, max_val, enumvals, sourcefile, sourceline, pending_restart
    FROM pg_catalog.pg_settings WHERE name = 'search_path';
}
expect {
    "$user", public|default|"$user", public|"$user", public|user|string|||||||f
}

test pg-settings-search-path-preserves-setting-text {
    SELECT quote_literal(set_config('search_path', ' "My,Schema", PUBLIC ', false));
    SELECT quote_literal(setting), source
    FROM pg_settings WHERE name = 'search_path';
}
expect {
    ' "My,Schema", PUBLIC '
    ' "My,Schema", PUBLIC '|session
}

test pg-settings-empty-search-path {
    SELECT quote_literal(set_config('search_path', '', false));
    SELECT quote_literal(setting), source
    FROM pg_settings WHERE name = 'search_path';
}
expect {
    ''
    ''|session
}

test pg-settings-set-search-path {
    SET search_path TO public;
    SELECT setting, source FROM pg_settings WHERE name = 'search_path';
}
expect {
    public|session
}

test pg-settings-reset-search-path {
    SET search_path TO public;
    SELECT set_config('search_path', NULL, false);
    SELECT setting, source, reset_val
    FROM pg_settings WHERE name = 'search_path';
}
expect {
    "$user", public
    "$user", public|default|"$user", public
}

test pg-settings-delete-errors {
    DELETE FROM pg_catalog.pg_settings;
}
@sqlstate 55000
expect error {}

test information-schema-schemata-lists-schemas {
    CREATE SCHEMA catalog_schemata_extra;
    SELECT schema_name
    FROM information_schema.schemata
    WHERE schema_name IN ('pg_catalog', 'public', 'information_schema', 'catalog_schemata_extra')
    ORDER BY schema_name;
}
expect {
    catalog_schemata_extra
    information_schema
    pg_catalog
    public
}

test information-schema-schemata-qualified-column {
    SELECT schemata.schema_name
    FROM information_schema.schemata
    WHERE schemata.schema_name = 'public';
}
expect {
    public
}

test user-table-named-schemata-is-not-the-catalog {
    CREATE TABLE schemata (id int, label text);
    INSERT INTO schemata VALUES (1, 'mine');
    UPDATE schemata SET label = 'updated' WHERE id = 1;
    SELECT id, label FROM schemata;
}
expect {
    1|updated
}

@skip-if postgres "PostgreSQL fills pg_init_privs and pg_cast"
test pg-function-support-catalogs-are-empty {
    SET search_path TO '';
    SELECT * FROM pg_init_privs;
    SELECT * FROM pg_catalog.pg_init_privs;
    SELECT objoid, classoid, objsubid, privtype, initprivs, tableoid FROM pg_init_privs;
    SELECT objoid, classoid, objsubid, privtype, initprivs, tableoid FROM pg_catalog.pg_init_privs;
    SELECT * FROM pg_cast;
    SELECT * FROM pg_catalog.pg_cast;
    SELECT oid, castsource, casttarget, castfunc, castcontext, castmethod, tableoid FROM pg_cast;
    SELECT oid, castsource, casttarget, castfunc, castcontext, castmethod, tableoid FROM pg_catalog.pg_cast;
    SELECT * FROM pg_transform;
    SELECT * FROM pg_catalog.pg_transform;
    SELECT oid, trftype, trflang, trffromsql, trftosql, tableoid FROM pg_transform;
    SELECT oid, trftype, trflang, trffromsql, trftosql, tableoid FROM pg_catalog.pg_transform;
}
expect {}

