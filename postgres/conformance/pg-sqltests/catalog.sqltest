# PostgreSQL catalog views queried through the PostgreSQL frontend.

@database :memory:

test pg-collation-pgdump-columns {
    SELECT tableoid, oid, collname, collnamespace, collowner, collencoding
    FROM pg_catalog.pg_collation
    WHERE oid >= 16384;
}
expect {}

setup indexed_tables {
    CREATE TABLE items (id int, name text, price int);
    CREATE INDEX items_name_idx ON items (name);
    CREATE UNIQUE INDEX items_price_idx ON items (price);
    CREATE TABLE orders (id int, item_id int);
    CREATE INDEX orders_item_idx ON orders (item_id);
}

@setup indexed_tables
test pg-indexes-lists-user-indexes {
    SELECT schemaname, tablename, indexname
    FROM pg_indexes
    WHERE schemaname = 'public'
    ORDER BY indexname;
}
expect {
    public|items|items_name_idx
    public|items|items_price_idx
    public|orders|orders_item_idx
}

@setup indexed_tables
test pg-indexes-join-pg-namespace {
    SELECT tablename, indexname
    FROM pg_indexes
    JOIN pg_namespace ON (schemaname = nspname)
    WHERE schemaname = 'public'
    ORDER BY pg_namespace.oid, indexname;
}
expect {
    items|items_name_idx
    items|items_price_idx
    orders|orders_item_idx
}

test pg-indexes-lists-names-chosen-for-unnamed-indexes {
    CREATE TABLE t (a int, b int, c text);
    CREATE INDEX ON t (a);
    CREATE INDEX ON t (b);
    CREATE INDEX ON t (a);
    CREATE INDEX ON t (a) WHERE b > 0;
    CREATE INDEX ON t (a, b);
    CREATE UNIQUE INDEX ON t (a, b);
    CREATE INDEX ON t (a, a);
    CREATE INDEX ON t ((a + b));
    CREATE INDEX ON t (lower(c));
    CREATE INDEX ON t ((c::text));
    CREATE TABLE u_b_idx (x int);
    CREATE SEQUENCE u_b_idx1;
    CREATE TABLE u (b int);
    CREATE INDEX ON u (b);
    CREATE TABLE v (c text, arr int[]);
    CREATE INDEX ON v ((lower(c) COLLATE "C"));
    CREATE INDEX ON v ((c::text COLLATE "C"));
    CREATE INDEX ON v (((c || 'x') COLLATE "C"));
    CREATE INDEX ON v ((arr[1]));
    CREATE INDEX ON v ((ARRAY[c]));
    CREATE TABLE w (abcdefghijabcdefghijabcdefghijabcdefghij int, klmnopqrstklmnopqrstklmnopqrstklmnopqrst int);
    CREATE INDEX ON w (abcdefghijabcdefghijabcdefghijabcdefghij, klmnopqrstklmnopqrstklmnopqrstklmnopqrst);
    CREATE INDEX ON w (abcdefghijabcdefghijabcdefghijabcdefghij, klmnopqrstklmnopqrstklmnopqrstklmnopqrst);
    DROP INDEX w_abcdefghijabcdefghijabcdefghijabcdefghij_klmnopqrstklmnop_idx;
    CREATE INDEX ON w (abcdefghijabcdefghijabcdefghijabcdefghij, klmnopqrstklmnopqrstklmnopqrstklmnopqrst);
    SELECT tablename, indexname
    FROM pg_indexes
    WHERE schemaname = 'public'
    ORDER BY tablename, indexname;
}
expect {
    t|t_a_a1_idx
    t|t_a_b_idx
    t|t_a_b_idx1
    t|t_a_idx
    t|t_a_idx1
    t|t_a_idx2
    t|t_b_idx
    t|t_c_idx
    t|t_expr_idx
    t|t_lower_idx
    u|u_b_idx2
    v|v_arr_idx
    v|v_array_idx
    v|v_c_idx
    v|v_expr_idx
    v|v_lower_idx
    w|w_abcdefghijabcdefghijabcdefghijabcdefghij_klmnopqrstklmno_idx1
    w|w_abcdefghijabcdefghijabcdefghijabcdefghij_klmnopqrstklmnop_idx
}

test catalog-pg-type-enum-and-domain {
    CREATE TYPE catalog_mood AS ENUM ('sad', 'happy');
    CREATE DOMAIN catalog_posint AS integer;
    SELECT typname, typtype, typbasetype, typnamespace
    FROM pg_type
    WHERE typname IN ('catalog_mood', 'catalog_posint')
    ORDER BY typname;
}
expect {
    catalog_mood|e|0|2200
    catalog_posint|d|23|2200
}

test catalog-pg-attribute-enum-and-domain-columns {
    CREATE TYPE catalog_color AS ENUM ('red', 'blue');
    CREATE DOMAIN catalog_age AS integer;
    CREATE TABLE catalog_t (c catalog_color, a catalog_age);
    SELECT a.attname, ty.typname
    FROM pg_attribute a
    JOIN pg_class c ON c.oid = a.attrelid
    JOIN pg_type ty ON ty.oid = a.atttypid
    WHERE c.relname = 'catalog_t' AND a.attnum > 0
    ORDER BY a.attnum;
}
expect {
    c|catalog_color
    a|catalog_age
}

test pg-attribute-default-compression {
    CREATE TABLE compression_columns (id integer NOT NULL, body text, amount integer DEFAULT 7);
    SELECT a.attname, quote_literal(a.attcompression::text), a.attnotnull, a.atthasdef,
           a.attidentity, a.attgenerated, a.attisdropped, a.attislocal, a.attinhcount
    FROM pg_catalog.pg_attribute a
    JOIN pg_catalog.pg_class c ON c.oid = a.attrelid
    WHERE c.relname = 'compression_columns' AND a.attnum > 0
    ORDER BY a.attnum;
}
expect {
    id|''|t|f|||f|t|0
    body|''|f|f|||f|t|0
    amount|''|f|t|||f|t|0
}

test pg-index-nulls-are-distinct {
    CREATE TABLE nullable_index_columns (a integer, b text);
    CREATE INDEX nullable_plain_idx ON nullable_index_columns (a);
    CREATE UNIQUE INDEX nullable_unique_idx ON nullable_index_columns (a, b);
    INSERT INTO nullable_index_columns VALUES (NULL, 'same'), (NULL, 'same'), (1, NULL), (1, NULL);
    SELECT c.relname, i.indisunique, i.indnullsnotdistinct, i.indisprimary,
           i.indimmediate, i.indisvalid, i.indisready, i.indkey
    FROM pg_catalog.pg_index i
    JOIN pg_catalog.pg_class c ON c.oid = i.indexrelid
    WHERE c.relname IN ('nullable_plain_idx', 'nullable_unique_idx')
    ORDER BY c.relname;
    SELECT count(*) FROM nullable_index_columns;
}
expect {
    nullable_plain_idx|f|f|f|t|t|t|1
    nullable_unique_idx|t|f|f|t|t|t|1 2
    4
}

test pg-settings-default-search-path {
    SELECT setting, source, boot_val, reset_val, context, vartype,
           unit, min_val, max_val, enumvals, sourcefile, sourceline, pending_restart
    FROM pg_catalog.pg_settings WHERE name = 'search_path';
}
expect {
    "$user", public|default|"$user", public|"$user", public|user|string|||||||f
}

test pg-settings-search-path-preserves-setting-text {
    SELECT quote_literal(set_config('search_path', ' "My,Schema", PUBLIC ', false));
    SELECT quote_literal(setting), source
    FROM pg_settings WHERE name = 'search_path';
}
expect {
    ' "My,Schema", PUBLIC '
    ' "My,Schema", PUBLIC '|session
}

test pg-settings-empty-search-path {
    SELECT quote_literal(set_config('search_path', '', false));
    SELECT quote_literal(setting), source
    FROM pg_settings WHERE name = 'search_path';
}
expect {
    ''
    ''|session
}

test pg-settings-set-search-path {
    SET search_path TO public;
    SELECT setting, source FROM pg_settings WHERE name = 'search_path';
}
expect {
    public|session
}

test pg-settings-reset-search-path {
    SET search_path TO public;
    SELECT set_config('search_path', NULL, false);
    SELECT setting, source, reset_val
    FROM pg_settings WHERE name = 'search_path';
}
expect {
    "$user", public
    "$user", public|default|"$user", public
}

test pg-settings-delete-errors {
    DELETE FROM pg_catalog.pg_settings;
}
@sqlstate 55000
expect error {}

test information-schema-schemata-lists-schemas {
    CREATE SCHEMA catalog_schemata_extra;
    SELECT schema_name
    FROM information_schema.schemata
    WHERE schema_name IN ('pg_catalog', 'public', 'information_schema', 'catalog_schemata_extra')
    ORDER BY schema_name;
}
expect {
    catalog_schemata_extra
    information_schema
    pg_catalog
    public
}

test information-schema-schemata-qualified-column {
    SELECT schemata.schema_name
    FROM information_schema.schemata
    WHERE schemata.schema_name = 'public';
}
expect {
    public
}

test user-table-named-schemata-is-not-the-catalog {
    CREATE TABLE schemata (id int, label text);
    INSERT INTO schemata VALUES (1, 'mine');
    UPDATE schemata SET label = 'updated' WHERE id = 1;
    SELECT id, label FROM schemata;
}
expect {
    1|updated
}

@skip-if postgres "PostgreSQL fills pg_init_privs"
test pg-function-support-catalogs-are-empty {
    SET search_path TO '';
    SELECT * FROM pg_init_privs;
    SELECT * FROM pg_catalog.pg_init_privs;
    SELECT objoid, classoid, objsubid, privtype, initprivs, tableoid FROM pg_init_privs;
    SELECT objoid, classoid, objsubid, privtype, initprivs, tableoid FROM pg_catalog.pg_init_privs;
    SELECT * FROM pg_transform;
    SELECT * FROM pg_catalog.pg_transform;
    SELECT oid, trftype, trflang, trffromsql, trftosql, tableoid FROM pg_transform;
    SELECT oid, trftype, trflang, trffromsql, trftosql, tableoid FROM pg_catalog.pg_transform;
}
expect {}

test pg-init-privs-is-read-only {
    CREATE ROLE reader_of_init_privs_is_read_only_role;
    SET ROLE reader_of_init_privs_is_read_only_role;
    DELETE FROM pg_init_privs;
}
@sqlstate 42501
expect error {permission denied for table pg_init_privs}
@sqlstate 42501
expect @tursopg error {cannot delete from pg_catalog table "pg_init_privs"}

test pg-cast-lists-the-casts-among-the-number-text-boolean-and-timestamp-types {
    SELECT s.typname, t.typname, c.castcontext, c.castmethod
    FROM pg_cast c
    JOIN pg_type s ON s.oid = c.castsource
    JOIN pg_type t ON t.oid = c.casttarget
    WHERE s.typname IN ('int2', 'int4', 'int8', 'float4', 'float8', 'numeric', 'text', 'bool', 'timestamp', 'timestamptz')
      AND t.typname IN ('int2', 'int4', 'int8', 'float4', 'float8', 'numeric', 'text', 'bool', 'timestamp', 'timestamptz')
      AND s.typname <> t.typname
    ORDER BY 1, 2;
}
expect {
    bool|int4|e|f
    bool|text|a|f
    float4|float8|i|f
    float4|int2|a|f
    float4|int4|a|f
    float4|int8|a|f
    float4|numeric|a|f
    float8|float4|a|f
    float8|int2|a|f
    float8|int4|a|f
    float8|int8|a|f
    float8|numeric|a|f
    int2|float4|i|f
    int2|float8|i|f
    int2|int4|i|f
    int2|int8|i|f
    int2|numeric|i|f
    int4|bool|e|f
    int4|float4|i|f
    int4|float8|i|f
    int4|int2|a|f
    int4|int8|i|f
    int4|numeric|i|f
    int8|float4|i|f
    int8|float8|i|f
    int8|int2|a|f
    int8|int4|a|f
    int8|numeric|i|f
    numeric|float4|i|f
    numeric|float8|i|f
    numeric|int2|a|f
    numeric|int4|a|f
    numeric|int8|a|f
    timestamp|timestamptz|i|f
    timestamptz|timestamp|a|f
}

test pg-cast-is-read-only {
    CREATE ROLE reader_of_cast_is_read_only_role;
    SET ROLE reader_of_cast_is_read_only_role;
    DELETE FROM pg_cast;
}
@sqlstate 42501
expect error {permission denied for table pg_cast}
@sqlstate 42501
expect @tursopg error {cannot delete from pg_catalog table "pg_cast"}

test pg-transform-is-read-only {
    CREATE ROLE reader_of_transform_is_read_only_role;
    SET ROLE reader_of_transform_is_read_only_role;
    DELETE FROM pg_transform;
}
@sqlstate 42501
expect error {permission denied for table pg_transform}
@sqlstate 42501
expect @tursopg error {cannot delete from pg_catalog table "pg_transform"}

test pg-dump-builtins-belong-to-pg-catalog {
    SET search_path TO '';
    SELECT DISTINCT p.proname, n.nspname FROM pg_proc p
    JOIN pg_namespace n ON p.pronamespace = n.oid
    WHERE p.proname IN ('abs', 'pg_is_in_recovery') ORDER BY p.proname;
}
expect {
    abs|pg_catalog
    pg_is_in_recovery|pg_catalog
}

@skip-if postgres "PostgreSQL also finds the functions of information_schema"
test pg-dump-function-discovery-excludes-builtins {
    SET search_path TO '';
    SELECT p.tableoid, p.oid, p.proname, p.prolang, p.pronargs, p.proargtypes,
           p.prorettype, p.proacl, acldefault('f', p.proowner) AS acldefault,
           p.pronamespace, p.proowner
    FROM pg_proc p LEFT JOIN pg_init_privs pip
      ON (p.oid = pip.objoid AND pip.classoid = 'pg_proc'::regclass AND pip.objsubid = 0)
    WHERE p.prokind <> 'a'
      AND NOT EXISTS (SELECT 1 FROM pg_depend
          WHERE classid = 'pg_proc'::regclass AND objid = p.oid AND deptype = 'i')
      AND (pronamespace != (SELECT oid FROM pg_namespace WHERE nspname = 'pg_catalog')
           OR EXISTS (SELECT 1 FROM pg_cast
               WHERE pg_cast.oid > 16383 AND p.oid = pg_cast.castfunc)
           OR EXISTS (SELECT 1 FROM pg_transform
               WHERE pg_transform.oid > 16383
                 AND (p.oid = pg_transform.trffromsql OR p.oid = pg_transform.trftosql))
           OR p.proacl IS DISTINCT FROM pip.initprivs);
}
expect {}

test pg-object-native-function-languages {
    SET search_path TO '';
    SELECT DISTINCT p.proname, l.lanname, CASE WHEN l.lanispl THEN 1 ELSE 0 END, l.tableoid
    FROM pg_proc p JOIN pg_language l ON l.oid = p.prolang
    WHERE p.proname IN ('abs', 'pg_is_in_recovery') ORDER BY p.proname;
}
expect {
    abs|internal|0|2612
    pg_is_in_recovery|internal|0|2612
}

@skip-if postgres "PostgreSQL has the plpgsql language"
test pg-object-dump-language-discovery-is-empty {
    SET search_path TO '';
    SELECT tableoid, oid, lanname, lanpltrusted, lanplcallfoid, laninline,
           lanvalidator, lanacl, acldefault('l', lanowner) AS acldefault, lanowner
    FROM pg_language WHERE lanispl ORDER BY oid;
}
expect {}

@skip-if postgres "PostgreSQL fills these catalogs, and only a superuser can read pg_subscription"
test pg-object-unsupported-catalogs-are-empty {
    SET search_path TO '';
    SELECT tableoid FROM pg_opclass;
    SELECT tableoid FROM pg_catalog.pg_opclass;
    SELECT tableoid FROM pg_opfamily;
    SELECT tableoid FROM pg_catalog.pg_opfamily;
    SELECT tableoid FROM pg_ts_parser;
    SELECT tableoid FROM pg_catalog.pg_ts_parser;
    SELECT tableoid FROM pg_ts_template;
    SELECT tableoid FROM pg_catalog.pg_ts_template;
    SELECT tableoid FROM pg_ts_dict;
    SELECT tableoid FROM pg_catalog.pg_ts_dict;
    SELECT tableoid FROM pg_ts_config;
    SELECT tableoid FROM pg_catalog.pg_ts_config;
    SELECT tableoid FROM pg_foreign_data_wrapper;
    SELECT tableoid FROM pg_catalog.pg_foreign_data_wrapper;
    SELECT tableoid FROM pg_foreign_server;
    SELECT tableoid FROM pg_catalog.pg_foreign_server;
    SELECT tableoid FROM pg_default_acl;
    SELECT tableoid FROM pg_catalog.pg_default_acl;
    SELECT tableoid FROM pg_conversion;
    SELECT tableoid FROM pg_catalog.pg_conversion;
    SELECT tableoid FROM pg_range;
    SELECT tableoid FROM pg_catalog.pg_range;
    SELECT tableoid FROM pg_event_trigger;
    SELECT tableoid FROM pg_catalog.pg_event_trigger;
    SELECT tableoid FROM pg_subscription;
    SELECT tableoid FROM pg_catalog.pg_subscription;
    SELECT tableoid FROM pg_largeobject_metadata;
    SELECT tableoid FROM pg_catalog.pg_largeobject_metadata;
    SELECT tableoid FROM pg_amop;
    SELECT tableoid FROM pg_catalog.pg_amop;
    SELECT tableoid FROM pg_amproc;
    SELECT tableoid FROM pg_catalog.pg_amproc;

    SELECT tableoid, oid, opcmethod, opcname, opcnamespace, opcowner FROM pg_opclass;
    SELECT tableoid, oid, opfmethod, opfname, opfnamespace, opfowner FROM pg_opfamily;
    SELECT tableoid, oid, prsname, prsnamespace, prsstart::oid, prstoken::oid,
           prsend::oid, prsheadline::oid, prslextype::oid FROM pg_ts_parser;
    SELECT tableoid, oid, tmplname, tmplnamespace, tmplinit::oid, tmpllexize::oid
    FROM pg_ts_template;
    SELECT tableoid, oid, dictname, dictnamespace, dictowner, dicttemplate,
           dictinitoption FROM pg_ts_dict;
    SELECT tableoid, oid, cfgname, cfgnamespace, cfgowner, cfgparser FROM pg_ts_config;
    SELECT oid, tableoid, defaclrole, defaclnamespace, defaclobjtype, defaclacl,
           CASE WHEN defaclnamespace = 0 THEN acldefault(
             CASE WHEN defaclobjtype = 'S' THEN 's'::"char" ELSE defaclobjtype END,
             defaclrole) ELSE '{}' END AS acldefault FROM pg_default_acl;
    SELECT tableoid, oid, conname, connamespace, conowner FROM pg_conversion;
    SELECT s.tableoid, s.oid, s.subname, s.subowner, s.subconninfo, s.subslotname,
           s.subsynccommit, s.subpublications, s.subbinary, s.substream,
           s.subtwophasestate, s.subdisableonerr, s.subpasswordrequired,
           s.subrunasowner, s.suborigin
    FROM pg_subscription s WHERE s.subdbid = (
      SELECT oid FROM pg_database WHERE datname = current_database());
    SELECT oid, lomowner, lomacl, acldefault('L', lomowner) AS acldefault
    FROM pg_largeobject_metadata;
}
expect {}

# pg_operator has the rows of PostgreSQL for the comparison, arithmetic, bit,
# regular expression and concatenation operators of boolean, the number
# types, text, date, timestamp, timestamptz and uuid. It leaves out the
# comparisons of two different date and time types, which tursopg refuses.
test pg-operator-lists-the-operators-of-the-frontend {
    SELECT oid, oprname, oprnamespace, oprowner, oprkind, oprcanmerge, oprcanhash,
           oprleft, oprright, oprresult, oprcom, oprnegate
    FROM pg_operator
    WHERE oprname IN ('=', '<>', '<', '<=', '>', '>=', '+', '-', '*', '/', '%',
                      '&', '|', '<<', '>>', '~', '!~', '~*', '!~*', '||')
      AND oprleft IN (0, 16, 20, 21, 23, 25, 700, 701, 1082, 1114, 1184, 1700, 2950)
      AND oprright IN (16, 20, 21, 23, 25, 700, 701, 1082, 1114, 1184, 1700, 2950)
      AND oprresult IN (16, 20, 21, 23, 25, 700, 701, 1082, 1114, 1184, 1700, 2950)
      AND (oprleft = oprright
           OR oprleft NOT IN (1082, 1114, 1184)
           OR oprright NOT IN (1082, 1114, 1184))
    ORDER BY oid;
}
expect {
    15|=|11|10|b|t|t|23|20|16|416|36
    36|<>|11|10|b|f|f|23|20|16|417|15
    37|<|11|10|b|f|f|23|20|16|419|82
    58|<|11|10|b|f|f|16|16|16|59|1695
    59|>|11|10|b|f|f|16|16|16|58|1694
