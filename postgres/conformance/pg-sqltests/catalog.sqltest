# PostgreSQL catalog views queried through the PostgreSQL frontend.

@database :memory:

setup indexed_tables {
    CREATE TABLE items (id int, name text, price int);
    CREATE INDEX items_name_idx ON items (name);
    CREATE UNIQUE INDEX items_price_idx ON items (price);
    CREATE TABLE orders (id int, item_id int);
    CREATE INDEX orders_item_idx ON orders (item_id);
}

@setup indexed_tables
test pg-indexes-lists-user-indexes {
    SELECT schemaname, tablename, indexname
    FROM pg_indexes
    WHERE schemaname = 'public'
    ORDER BY indexname;
}
expect {
    public|items|items_name_idx
    public|items|items_price_idx
    public|orders|orders_item_idx
}

@setup indexed_tables
test pg-indexes-join-pg-namespace {
    SELECT tablename, indexname
    FROM pg_indexes
    JOIN pg_namespace ON (schemaname = nspname)
    WHERE schemaname = 'public'
    ORDER BY pg_namespace.oid, indexname;
}
expect {
    items|items_name_idx
    items|items_price_idx
    orders|orders_item_idx
}

test catalog-pg-type-enum-and-domain {
    CREATE TYPE catalog_mood AS ENUM ('sad', 'happy');
    CREATE DOMAIN catalog_posint AS integer;
    SELECT typname, typtype, typbasetype, typnamespace
    FROM pg_type
    WHERE typname IN ('catalog_mood', 'catalog_posint')
    ORDER BY typname;
}
expect {
    catalog_mood|e|0|2200
    catalog_posint|d|23|2200
}

test catalog-pg-attribute-enum-and-domain-columns {
    CREATE TYPE catalog_color AS ENUM ('red', 'blue');
    CREATE DOMAIN catalog_age AS integer;
    CREATE TABLE catalog_t (c catalog_color, a catalog_age);
    SELECT a.attname, ty.typname
    FROM pg_attribute a
    JOIN pg_class c ON c.oid = a.attrelid
    JOIN pg_type ty ON ty.oid = a.atttypid
    WHERE c.relname = 'catalog_t' AND a.attnum > 0
    ORDER BY a.attnum;
}
expect {
    c|catalog_color
    a|catalog_age
}

test pg-settings-default-search-path {
    SELECT setting, source, boot_val, reset_val, context, vartype,
           unit, min_val, max_val, enumvals, sourcefile, sourceline, pending_restart
    FROM pg_catalog.pg_settings WHERE name = 'search_path';
}
expect {
    "$user", public|default|"$user", public|"$user", public|user|string|||||||f
}

test pg-settings-search-path-preserves-setting-text {
    SELECT quote_literal(set_config('search_path', ' "My,Schema", PUBLIC ', false));
    SELECT quote_literal(setting), source
    FROM pg_settings WHERE name = 'search_path';
}
expect {
    ' "My,Schema", PUBLIC '
    ' "My,Schema", PUBLIC '|session
}

test pg-settings-empty-search-path {
    SELECT quote_literal(set_config('search_path', '', false));
    SELECT quote_literal(setting), source
    FROM pg_settings WHERE name = 'search_path';
}
expect {
    ''
    ''|session
}

test pg-settings-set-search-path {
    SET search_path TO public;
    SELECT setting, source FROM pg_settings WHERE name = 'search_path';
}
expect {
    public|session
}

test pg-settings-reset-search-path {
    SET search_path TO public;
    SELECT set_config('search_path', NULL, false);
    SELECT setting, source, reset_val
    FROM pg_settings WHERE name = 'search_path';
}
expect {
    "$user", public
    "$user", public|default|"$user", public
}

test pg-settings-delete-errors {
    DELETE FROM pg_catalog.pg_settings;
}
expect error {}

test information-schema-schemata-lists-schemas {
    CREATE SCHEMA catalog_schemata_extra;
    SELECT schema_name
    FROM information_schema.schemata
    WHERE schema_name IN ('pg_catalog', 'public', 'information_schema', 'catalog_schemata_extra')
    ORDER BY schema_name;
}
expect {
    catalog_schemata_extra
    information_schema
    pg_catalog
    public
}

test information-schema-schemata-qualified-column {
    SELECT schemata.schema_name
    FROM information_schema.schemata
    WHERE schemata.schema_name = 'public';
}
expect {
    public
}

test user-table-named-schemata-is-not-the-catalog {
    CREATE TABLE schemata (id int, label text);
    INSERT INTO schemata VALUES (1, 'mine');
    UPDATE schemata SET label = 'updated' WHERE id = 1;
    SELECT id, label FROM schemata;
}
expect {
    1|updated
}

test pg-depend-tracks-live-objects {
    CREATE TABLE dep_parent (id TEXT UNIQUE);
    CREATE TABLE dep_child (parent_id TEXT REFERENCES dep_parent(id), qty INTEGER DEFAULT 17);
    CREATE INDEX dep_child_qty ON dep_child(qty);
    CREATE INDEX dep_parent_id ON dep_parent(id);
    CREATE UNIQUE INDEX dep_parent_unique_id ON dep_parent(id);

    SELECT c.relname, n.nspname, d.deptype FROM pg_depend d
    JOIN pg_class c ON d.classid = 1259 AND c.oid = d.objid
    JOIN pg_namespace n ON d.refclassid = 2615 AND n.oid = d.refobjid
    WHERE c.relname IN ('dep_parent', 'dep_child') ORDER BY c.relname;

    SELECT r.relname, d.refobjsubid, d.deptype FROM pg_depend d
    JOIN pg_constraint c ON d.classid = 2606 AND c.oid = d.objid
    JOIN pg_class r ON d.refclassid = 1259 AND r.oid = d.refobjid
    WHERE c.conname = 'dep_child_parent_id_fkey' AND r.relkind = 'r'
    ORDER BY r.relname;

    SELECT r.relname, a.adnum, d.refobjsubid, d.deptype FROM pg_depend d
    JOIN pg_attrdef a ON d.classid = 2604 AND a.oid = d.objid
    JOIN pg_class r ON d.refclassid = 1259 AND r.oid = d.refobjid
    WHERE r.relname = 'dep_child';

    SELECT d.refobjsubid, d.deptype FROM pg_depend d
    JOIN pg_class i ON d.classid = 1259 AND i.oid = d.objid AND i.relkind = 'i'
    JOIN pg_class r ON d.refclassid = 1259 AND r.oid = d.refobjid
    WHERE r.relname = 'dep_child';

    SELECT i.relname, d.refobjsubid, d.deptype FROM pg_depend d
    JOIN pg_class i ON d.classid = 1259 AND i.oid = d.objid
    JOIN pg_class r ON d.refclassid = 1259 AND r.oid = d.refobjid
    WHERE i.relname IN ('dep_parent_id', 'dep_parent_unique_id')
      AND r.relname = 'dep_parent' ORDER BY i.relname;

    SELECT c.conname, d.deptype FROM pg_depend d
    JOIN pg_class i ON d.classid = 1259 AND i.oid = d.objid AND i.relkind = 'i'
    JOIN pg_constraint c ON d.refclassid = 2606 AND c.oid = d.refobjid
    WHERE c.conname = 'dep_parent_id_key';

    SELECT CASE WHEN EXISTS (SELECT 1 FROM pg_catalog.pg_depend) THEN 1 ELSE 0 END;
    SET search_path TO '';
    SELECT tableoid FROM pg_depend LIMIT 1;
}
expect {
    dep_child|public|n
    dep_parent|public|n
    dep_child|1|a
    dep_parent|1|n
    dep_child|2|2|a
    2|a
    dep_parent_id|1|a
    dep_parent_unique_id|1|a
    dep_parent_id_key|i
    1
    2608
}

test pg-depend-for-dump-table-query {
    CREATE TABLE dump_indexed (id INTEGER PRIMARY KEY, value TEXT UNIQUE);
    CREATE TABLE dump_plain (value TEXT);
    SET search_path TO '';
    SELECT tableoid, relname, CASE WHEN relhasindex THEN 1 ELSE 0 END,
           replace(acldefault::text, pg_get_userbyid(relowner), 'owner'),
           reltablespace, reloptions, checkoption, amname
    FROM (
        SELECT c.tableoid, c.oid, c.relname, c.relnamespace, c.relkind, c.reltype,
               c.relowner, c.relchecks, c.relhasindex, c.relhasrules, c.relpages,
               c.relhastriggers, c.relpersistence, c.reloftype, c.relacl,
               acldefault(CASE WHEN c.relkind = 'S' THEN 's'::"char" ELSE 'r'::"char" END,
                          c.relowner) AS acldefault,
               CASE WHEN c.relkind = 'f' THEN (SELECT ftserver FROM pg_catalog.pg_foreign_table
                    WHERE ftrelid = c.oid) ELSE 0 END AS foreignserver,
               c.relfrozenxid, tc.relfrozenxid AS tfrozenxid, tc.oid AS toid,
               tc.relpages AS toastpages, tc.reloptions AS toast_reloptions,
               d.refobjid AS owning_tab, d.refobjsubid AS owning_col,
               tsp.spcname AS reltablespace, false AS relhasoids, c.relispopulated,
               c.relreplident, c.relrowsecurity, c.relforcerowsecurity, c.relminmxid,
               tc.relminmxid AS tminmxid,
               array_remove(array_remove(c.reloptions,'check_option=local'),
                            'check_option=cascaded') AS reloptions,
               CASE WHEN 'check_option=local' = ANY(c.reloptions) THEN 'LOCAL'::text
                    WHEN 'check_option=cascaded' = ANY(c.reloptions) THEN 'CASCADED'::text
                    ELSE NULL END AS checkoption,
               am.amname, (d.deptype = 'i') IS TRUE AS is_identity_sequence,
               c.relispartition AS ispartition
        FROM pg_class c
        LEFT JOIN pg_depend d ON (c.relkind = 'S' AND d.classid = 'pg_class'::regclass
            AND d.objid = c.oid AND d.objsubid = 0
            AND d.refclassid = 'pg_class'::regclass AND d.deptype IN ('a', 'i'))
        LEFT JOIN pg_tablespace tsp ON (tsp.oid = c.reltablespace)
        LEFT JOIN pg_am am ON (c.relam = am.oid)
        LEFT JOIN pg_class tc ON (c.reltoastrelid = tc.oid AND tc.relkind = 't'
                                 AND c.relkind <> 'p')
        WHERE c.relkind IN ('r', 'S', 'v', 'c', 'm', 'f', 'p')
          AND c.relname IN ('dump_indexed', 'dump_plain')
    ) AS dump
    ORDER BY relname;
}
expect {
    1259|dump_indexed|1|{owner=arwdDxt/owner}||||heap
    1259|dump_plain|0|{owner=arwdDxt/owner}||||heap
}
