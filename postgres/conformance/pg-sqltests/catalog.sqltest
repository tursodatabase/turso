test pg-operator-lists-the-comparisons-of-oid {
    SELECT oid, oprname, oprkind, oprcanmerge, oprcanhash, oprleft, oprright,
           oprresult, oprcom, oprnegate
    FROM pg_operator
    WHERE oprleft = 26 OR oprright = 26
    ORDER BY oid;
}
expect {
    607|=|b|t|t|26|26|16|607|608
    608|<>|b|f|f|26|26|16|608|607
    609|<|b|f|f|26|26|16|610|612
    610|>|b|f|f|26|26|16|609|611
    611|<=|b|f|f|26|26|16|612|610
    612|>=|b|f|f|26|26|16|611|609
}

test pg-operator-joins-pg-type-on-the-operand-types {
    SET search_path TO '';
    SELECT o.tableoid, o.oprname, l.typname, r.typname, t.typname
    FROM pg_catalog.pg_operator o
    JOIN pg_catalog.pg_type l ON l.oid = o.oprleft
    JOIN pg_catalog.pg_type r ON r.oid = o.oprright
    JOIN pg_catalog.pg_type t ON t.oid = o.oprresult
    WHERE l.typname = 'date' AND r.typname = 'int4'
    ORDER BY o.oid;
}
expect {
    2617|+|date|int4|date
    2617|-|date|int4|date
}

test pg-operator-prefix-operators-have-no-left-type {
    SELECT oprname, oprkind, oprleft, oprright, oprresult
    FROM pg_operator
    WHERE oprright = 1700 AND oprkind = 'l' AND oprname IN ('+', '-')
    ORDER BY oid;
}
expect {
    -|l|0|1700|1700
    +|l|0|1700|1700
}

# tursopg lists only the operators of the test above.
@compat-gap "syntax:catalog"
test pg-operator-lists-every-operator {
    SELECT count(*) FROM pg_operator;
}
expect {
    799
}
expect @tursopg {
    222
}

# pg_proc of tursopg does not have the functions of PostgreSQL under their
# oids, so an operator names no function.
@compat-gap "syntax:catalog"
test pg-operator-names-the-function-of-an-operator {
    SELECT oprcode::oid, oprrest::oid, oprjoin::oid FROM pg_operator WHERE oid = 96;
}
expect {
    65|101|105
}
expect @tursopg {
    0|0|0
}

test pg-object-operator-is-read-only {
    CREATE ROLE reader_of_object_operator_is_read_only_role;
    SET ROLE reader_of_object_operator_is_read_only_role;
    DELETE FROM pg_operator;
}
@sqlstate 42501
expect error {permission denied for table pg_operator}
@sqlstate 42501
expect @tursopg error {cannot delete from pg_catalog table "pg_operator"}

# pg_proc has the rows of PostgreSQL for the functions of the frontend: the
# aggregates count, sum, avg, min, max, stddev and string_agg over the number,
# text, bytea, date and timestamp types, and a few scalar functions.
test pg-proc-lists-the-functions-of-the-frontend {
    SELECT oid, proname, pronamespace, proowner, prolang, procost::int, prorows::int, provariadic,
           prokind, prosecdef, proleakproof, proisstrict, proretset, provolatile, proparallel,
           pronargs, pronargdefaults, prorettype, proargtypes::text
    FROM pg_proc
    WHERE proname IN ('abs', 'avg', 'count', 'format_type', 'max', 'min', 'now', 'pg_get_constraintdef',
                      'pg_is_in_recovery', 'quote_ident', 'stddev', 'string_agg', 'sum')
      AND proargtypes::text IN ('', '17', '17 17', '20', '21', '23', '25', '25 25', '26', '26 16',
                                '26 23', '700', '701', '1082', '1114', '1184', '1700', '2276')
    ORDER BY oid;
}
expect {
    1081|format_type|11|10|12|1|0|0|f|f|f|f|f|s|s|2|0|25|26 23
    1282|quote_ident|11|10|12|1|0|0|f|f|f|t|f|i|s|1|0|25|25
    1299|now|11|10|12|1|0|0|f|f|f|t|f|s|s|0|0|1184|
    1387|pg_get_constraintdef|11|10|12|1|0|0|f|f|f|t|f|s|s|1|0|25|26
    1394|abs|11|10|12|1|0|0|f|f|f|t|f|i|s|1|0|700|700
    1395|abs|11|10|12|1|0|0|f|f|f|t|f|i|s|1|0|701|701
    1396|abs|11|10|12|1|0|0|f|f|f|t|f|i|s|1|0|20|20
    1397|abs|11|10|12|1|0|0|f|f|f|t|f|i|s|1|0|23|23
    1398|abs|11|10|12|1|0|0|f|f|f|t|f|i|s|1|0|21|21
    1705|abs|11|10|12|1|0|0|f|f|f|t|f|i|s|1|0|1700|1700
    2100|avg|11|10|12|1|0|0|a|f|f|f|f|i|s|1|0|1700|20
    2101|avg|11|10|12|1|0|0|a|f|f|f|f|i|s|1|0|1700|23
