        d int
    );
    SELECT a.attname, a.attnotnull, a.atthasdef, a.attidentity
    FROM pg_attribute a
    JOIN pg_class c ON c.oid = a.attrelid
    WHERE c.relname = 'zz_identity_attrs' AND a.attnum > 0
    ORDER BY a.attnum;
}
