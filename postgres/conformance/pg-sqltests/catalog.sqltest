test pg-get-constraintdef {
    CREATE TABLE parent (id INTEGER PRIMARY KEY, name TEXT UNIQUE);
    CREATE TABLE child (id INTEGER PRIMARY KEY,
                       parent_id INTEGER REFERENCES parent(id) ON DELETE CASCADE,
                       age INTEGER CHECK(age > 0));
    SELECT c.relname, con.contype,
           CASE WHEN length(pg_get_constraintdef(con.oid)) > 0 THEN 1 ELSE 0 END,
           CASE WHEN con.contype = 'p' THEN
                     CASE WHEN pg_get_constraintdef(con.oid) LIKE 'PRIMARY KEY%'
                          THEN 1 ELSE 0 END
                WHEN con.contype = 'f' THEN
                     CASE WHEN pg_get_constraintdef(con.oid) LIKE '%FOREIGN KEY%REFERENCES%'
                          THEN 1 ELSE 0 END
                ELSE 1 END
    FROM pg_constraint con JOIN pg_class c ON c.oid = con.conrelid
    WHERE c.relname IN ('parent', 'child') AND con.contype <> 'n'
    ORDER BY c.relname, con.contype;
}
expect {
    child|c|1|1
    child|f|1|1
    child|p|1|1
    parent|p|1|1
    parent|u|1|1
}

test pg-get-indexdef {
    CREATE TABLE items (id INTEGER PRIMARY KEY, name TEXT, price REAL);
    CREATE INDEX idx_items_name ON items(name);
    CREATE UNIQUE INDEX idx_items_price ON items(price);
    SELECT relname, replace(pg_get_indexdef(oid), 'public.', '')
    FROM pg_class WHERE relkind = 'i'
      AND relname IN ('idx_items_name', 'idx_items_price') ORDER BY relname;
}
expect {
    idx_items_name|CREATE INDEX idx_items_name ON items USING btree (name)
    idx_items_price|CREATE UNIQUE INDEX idx_items_price ON items USING btree (price)
}

test pg-attrdef-default-columns {
    CREATE TABLE defaults_test (id INTEGER PRIMARY KEY, name TEXT DEFAULT 'unnamed',
                               score INTEGER DEFAULT 0);
    SELECT adnum FROM pg_attrdef JOIN pg_class c ON c.oid = adrelid
    WHERE c.relname = 'defaults_test' ORDER BY adnum;
}
expect {
    2
    3
}

test pg-attribute-created-table-columns {
    CREATE TABLE products (id INT PRIMARY KEY, name TEXT, price INT);
    SELECT a.attname, t.typname FROM pg_attribute a
    JOIN pg_class c ON a.attrelid = c.oid
    JOIN pg_type t ON a.atttypid = t.oid
    WHERE c.relname = 'products' AND a.attnum > 0 AND NOT a.attisdropped
    ORDER BY a.attnum;
}
expect {
    id|int4
    name|text
    price|int4
}

test pg-create-table-insert-and-select {
    CREATE TABLE kv (k TEXT, v INT);
    INSERT INTO kv VALUES ('hello', 42);
    SELECT k, v FROM kv;
}
expect {
    hello|42
}

test pg-database-is-not-empty {
    SELECT CASE WHEN EXISTS (SELECT datname FROM pg_database) THEN 1 ELSE 0 END;
}
expect {
    1
}

test catalog-schema-qualified-column-references {
    SELECT pg_catalog.pg_namespace.nspname
    FROM pg_catalog.pg_namespace
    WHERE pg_catalog.pg_namespace.nspname = 'pg_catalog';
    SELECT information_schema.schemata.schema_name
    FROM information_schema.schemata
    WHERE information_schema.schemata.schema_name = 'public';
}
expect {
    pg_catalog
    public
}

test pg-statistic-ext-dump-discovery-is-empty {
    SET search_path TO '';
    SELECT tableoid, oid, stxname, stxnamespace, stxowner, stxrelid, stxstattarget
    FROM pg_catalog.pg_statistic_ext;
}
expect {}

test pg-trigger-parent-discovery-is-empty {
    SET search_path TO '';
    SELECT t.tgrelid, t.tgname, t.tgenabled, t.oid,
           t.tgparentid <> 0 AS tgispartition
    FROM unnest('{}'::pg_catalog.oid[]) AS src(tbloid)
    JOIN pg_catalog.pg_trigger t ON src.tbloid = t.tgrelid
    LEFT JOIN pg_catalog.pg_trigger u ON u.oid = t.tgparentid
    WHERE (NOT t.tgisinternal AND t.tgparentid = 0)
       OR t.tgenabled != u.tgenabled
    ORDER BY t.tgrelid, t.tgname;
}
expect {}

test pg-trigger-tableoid-discovery-is-empty {
    SET search_path TO '';
    SELECT t.tableoid, t.oid, t.tgrelid, t.tgname, t.tgenabled,
           t.tgparentid <> 0 AS tgispartition
    FROM unnest('{}'::pg_catalog.oid[]) AS src(tbloid)
    JOIN pg_catalog.pg_trigger t ON src.tbloid = t.tgrelid
    LEFT JOIN pg_catalog.pg_trigger u ON u.oid = t.tgparentid
    WHERE (NOT t.tgisinternal AND t.tgparentid = 0)
       OR t.tgenabled != u.tgenabled
    ORDER BY t.tgrelid, t.tgname;
}
expect {}

test pg-get-triggerdef-missing-trigger {
    SET search_path TO '';
    SELECT CASE WHEN pg_catalog.pg_get_triggerdef(0) IS NULL THEN 1 ELSE 0 END,
           CASE WHEN pg_catalog.pg_get_triggerdef(0, false) IS NULL THEN 1 ELSE 0 END,
           CASE WHEN pg_catalog.pg_get_triggerdef(0, true) IS NULL THEN 1 ELSE 0 END,
           CASE WHEN pg_catalog.pg_get_triggerdef(NULL) IS NULL THEN 1 ELSE 0 END,
           CASE WHEN pg_catalog.pg_get_triggerdef(0, NULL) IS NULL THEN 1 ELSE 0 END;
}
expect {1|1|1|1|1}

test pg-trigger-dump-discovery-is-empty {
    SET search_path TO '';
    SELECT t.tgrelid, t.tgname, pg_catalog.pg_get_triggerdef(t.oid, false) AS tgdef,
           t.tgenabled, t.tableoid, t.oid, t.tgparentid <> 0 AS tgispartition
    FROM unnest('{}'::pg_catalog.oid[]) AS src(tbloid)
    JOIN pg_catalog.pg_trigger t ON src.tbloid = t.tgrelid
    LEFT JOIN pg_catalog.pg_trigger u ON u.oid = t.tgparentid
    WHERE (NOT t.tgisinternal AND t.tgparentid = 0)
       OR t.tgenabled != u.tgenabled
    ORDER BY t.tgrelid, t.tgname;
}
expect {}

test pg-rewrite-dump-discovery-is-empty {
    SET search_path TO '';
    SELECT tableoid, oid, rulename, ev_class AS ruletable, ev_type, is_instead, ev_enabled
    FROM pg_rewrite
    WHERE ev_class IN (
        SELECT oid FROM pg_class
        WHERE relnamespace = (SELECT oid FROM pg_namespace WHERE nspname = 'public')
    )
    ORDER BY oid;
}
expect {}

test pg-policy-dump-discovery-is-empty {
    SET search_path TO '';
    SELECT pol.oid, pol.tableoid, pol.polrelid, pol.polname, pol.polcmd, pol.polpermissive,
           CASE WHEN pol.polroles = '{0}' THEN NULL ELSE
               pg_catalog.array_to_string(ARRAY(SELECT pg_catalog.quote_ident(rolname)
                   FROM pg_catalog.pg_roles WHERE oid = ANY(pol.polroles)), ', ')
           END AS polroles,
           pg_catalog.pg_get_expr(pol.polqual, pol.polrelid) AS polqual,
           pg_catalog.pg_get_expr(pol.polwithcheck, pol.polrelid) AS polwithcheck
    FROM unnest('{16384,16385}'::pg_catalog.oid[]) AS src(tbloid)
    JOIN pg_catalog.pg_policy pol ON src.tbloid = pol.polrelid;
}
expect {}

