test pg-get-constraintdef {
    CREATE TABLE parent (id INTEGER PRIMARY KEY, name TEXT UNIQUE);
    CREATE TABLE child (id INTEGER PRIMARY KEY,
                       parent_id INTEGER REFERENCES parent(id) ON DELETE CASCADE,
                       age INTEGER CHECK(age > 0));
    SELECT c.relname, con.contype,
           CASE WHEN length(pg_get_constraintdef(con.oid)) > 0 THEN 1 ELSE 0 END,
           CASE WHEN con.contype = 'p' THEN
                     CASE WHEN pg_get_constraintdef(con.oid) LIKE 'PRIMARY KEY%'
                          THEN 1 ELSE 0 END
                WHEN con.contype = 'f' THEN
                     CASE WHEN pg_get_constraintdef(con.oid) LIKE '%FOREIGN KEY%REFERENCES%'
                          THEN 1 ELSE 0 END
                ELSE 1 END
    FROM pg_constraint con JOIN pg_class c ON c.oid = con.conrelid
    WHERE c.relname IN ('parent', 'child') ORDER BY c.relname, con.contype;
}
expect {
    child|c|1|1
    child|f|1|1
    child|p|1|1
    parent|p|1|1
    parent|u|1|1
}

