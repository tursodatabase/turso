@compat-gap "syntax:drop-function"
test drop-function-cascade-that-a-default-calls {
    CREATE FUNCTION k() RETURNS int LANGUAGE sql AS 'SELECT 7';
    CREATE TABLE td (id int, v int DEFAULT k());
    DROP FUNCTION k() CASCADE;
    INSERT INTO td (id) VALUES (1);
    SELECT v IS NULL FROM td;
}
expect {
    t
