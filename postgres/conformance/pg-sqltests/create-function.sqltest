# The body of a function is a query of its own

test function-body-does-not-read-a-with-query-of-the-calling-statement {
    CREATE TABLE settings (name text PRIMARY KEY, value int);
    INSERT INTO settings VALUES ('limit', 10);
    CREATE FUNCTION row_limit() RETURNS int LANGUAGE sql STABLE AS $$ SELECT (SELECT value FROM settings WHERE name = 'limit') $$;
    WITH settings AS (SELECT 'limit' AS name, 99 AS value) SELECT row_limit(), (SELECT value FROM settings);
}
expect {
    10|99
}

test function-body-with-exists-and-in-does-not-read-a-with-query-of-the-calling-statement {
    CREATE TABLE members (id int PRIMARY KEY);
    INSERT INTO members VALUES (1);
    CREATE FUNCTION has_members() RETURNS boolean LANGUAGE sql STABLE AS $$ SELECT EXISTS (SELECT 1 FROM members) $$;
    CREATE FUNCTION one_is_member() RETURNS boolean LANGUAGE sql STABLE AS $$ SELECT 1 IN (SELECT id FROM members) $$;
    WITH members AS (SELECT 2 AS id WHERE false) SELECT has_members(), one_is_member(), (SELECT count(*) FROM members);
}
expect {
    t|t|0
}

# A subquery that the caller writes as an argument belongs to the calling
# statement: it reads the caller's tables and WITH queries.
test argument-that-is-a-correlated-subquery {
    CREATE TABLE t (a int);
    CREATE TABLE u (k int, b int);
    INSERT INTO t VALUES (1), (2);
    INSERT INTO u VALUES (1, 10), (1, 20), (2, 5);
    CREATE FUNCTION add1(x int) RETURNS int LANGUAGE sql AS 'SELECT x + 1';
    SELECT a, add1((SELECT max(b) FROM u WHERE u.k = t.a)) FROM t ORDER BY a;
}
expect {
    1|21
    2|6
}

test argument-that-is-a-subquery-of-a-with-query {
    CREATE TABLE settings (v int);
    INSERT INTO settings VALUES (7);
    CREATE FUNCTION add1(x int) RETURNS int LANGUAGE sql AS 'SELECT x + 1';
    CREATE FUNCTION setting() RETURNS int LANGUAGE sql AS 'SELECT (SELECT max(v) FROM settings)';
    WITH settings AS (SELECT 100 AS v)
    SELECT setting(), add1(setting()), add1((SELECT v FROM settings));
}
expect {
    7|8|101
}

test function-body-does-not-read-a-column-of-the-calling-statement {
    CREATE TABLE settings (name text PRIMARY KEY, value int);
    INSERT INTO settings VALUES ('limit', 10);
    CREATE FUNCTION max_value() RETURNS int LANGUAGE sql STABLE AS $$ SELECT (SELECT max(value) FROM settings) $$;
    CREATE TABLE items (id int PRIMARY KEY, value int);
    INSERT INTO items VALUES (1, 100), (2, 200);
    ALTER TABLE settings RENAME COLUMN value TO val;
    SELECT id, max_value() FROM items ORDER BY id;
}
@sqlstate 42703
expect error {
    column "value" does not exist
}
@sqlstate 42703
expect @tursopg error {
    no such column: value
}

# A stored expression keeps its function

test default-check-and-view-keep-their-function-when-the-search-path-changes {
    CREATE SCHEMA a;
    CREATE SCHEMA b;
    CREATE FUNCTION a.f() RETURNS int LANGUAGE sql AS 'SELECT 1';
    CREATE FUNCTION b.f() RETURNS int LANGUAGE sql AS 'SELECT 2';
    SET search_path = a, public;
    CREATE TABLE public.t (id int, v int DEFAULT f(), w int CHECK (w <> f()));
    ALTER TABLE public.t ADD COLUMN u int DEFAULT f();
    CREATE VIEW public.vw AS SELECT f() AS x;
    SET search_path = b, public;
    INSERT INTO public.t (id, w) VALUES (1, 2);
    SELECT v, w, u FROM public.t;
    SELECT x FROM public.vw;
    SET search_path = public;
    SELECT x FROM public.vw;
}
expect {
    1|2|1
    1
    1
}

test drop-function-that-a-default-calls-errors {
    CREATE FUNCTION k() RETURNS int LANGUAGE sql AS 'SELECT 7';
    CREATE TABLE td (id int, v int DEFAULT k());
    DROP FUNCTION k();
}
@sqlstate 2BP01
