@sqlstate 0A000
expect @tursopg error {
    DROP FUNCTION ... CASCADE when an object depends on the function
}

@compat-gap "syntax:drop-schema"
test drop-schema-cascade-with-a-function-that-a-default-of-another-schema-calls {
    CREATE SCHEMA app;
    CREATE FUNCTION app.z() RETURNS int LANGUAGE sql AS 'SELECT 1';
    CREATE TABLE tz (id int, v int DEFAULT app.z());
    DROP SCHEMA app CASCADE;
    INSERT INTO tz (id) VALUES (1);
    SELECT v IS NULL FROM tz;
}
expect {
    t
}
@sqlstate 0A000
expect @tursopg error {
    DROP SCHEMA "app" CASCADE is not supported when an object of another schema depends on an object of the schema
}

test drop-function-after-the-objects-that-call-it {
    CREATE FUNCTION k() RETURNS int LANGUAGE sql AS 'SELECT 7';
    CREATE TABLE td (id int, v int DEFAULT k());
    CREATE VIEW kv AS SELECT k() AS x;
    DROP VIEW kv;
    DROP TABLE td;
    DROP FUNCTION k();
    SELECT count(*) FROM pg_proc WHERE proname = 'k';
}
expect {
    0
}

test drop-function-that-the-body-of-another-function-calls {
    CREATE FUNCTION k() RETURNS int LANGUAGE sql AS 'SELECT 7';
    CREATE FUNCTION k2() RETURNS int LANGUAGE sql AS 'SELECT k() + 1';
    DROP FUNCTION k();
    SELECT count(*) FROM pg_proc WHERE proname = 'k';
}
expect {
    0
}

test drop-function-named-twice-drops-it-once {
    CREATE FUNCTION h() RETURNS int LANGUAGE sql AS 'SELECT 1';
    DROP FUNCTION h(), h();
    SELECT count(*) FROM pg_proc WHERE proname = 'h';
}
expect {
    0
}

test parameter-name-used-more-than-once {
    CREATE FUNCTION f(a int, a int) RETURNS int AS $$ SELECT 1 $$ LANGUAGE sql;
}
@sqlstate 42P13
expect error {
    parameter name "a" used more than once
}

# What tursopg does not support in a call

# The body of each function is nested 40 levels deep, so the expression
# that a call of f2 stands for is too deep for tursopg. Without the limit,
# the server ran out of stack at f5.
@compat-gap "syntax:create-function"
test functions-whose-bodies-nest-deeply-call-each-other {
    CREATE FUNCTION f1(x bigint) RETURNS bigint LANGUAGE sql IMMUTABLE AS 'SELECT -(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(x))))))))))))))))))))))))))))))))))))))))';
    CREATE FUNCTION f2(x bigint) RETURNS bigint LANGUAGE sql IMMUTABLE AS 'SELECT -(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(f1(x)))))))))))))))))))))))))))))))))))))))))';
    CREATE FUNCTION f3(x bigint) RETURNS bigint LANGUAGE sql IMMUTABLE AS 'SELECT -(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(f2(x)))))))))))))))))))))))))))))))))))))))))';
    CREATE FUNCTION f4(x bigint) RETURNS bigint LANGUAGE sql IMMUTABLE AS 'SELECT -(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(f3(x)))))))))))))))))))))))))))))))))))))))))';
    CREATE FUNCTION f5(x bigint) RETURNS bigint LANGUAGE sql IMMUTABLE AS 'SELECT -(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(f4(x)))))))))))))))))))))))))))))))))))))))))';
    CREATE FUNCTION f6(x bigint) RETURNS bigint LANGUAGE sql IMMUTABLE AS 'SELECT -(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(f5(x)))))))))))))))))))))))))))))))))))))))))';
    SELECT f6(1);
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    function f2 stands for an expression that is nested more than 128 levels deep, which is not supported
}

@compat-gap "syntax:create-function"
test call-with-an-argument-that-has-no-implicit-cast-to-the-parameter {
    CREATE FUNCTION add_one(x int) RETURNS int LANGUAGE sql AS 'SELECT x + 1';
    SELECT add_one(1.5);
}
@sqlstate 42883
expect error {
    function add_one\(numeric\) does not exist
}
expect @tursopg {
    3
}

@compat-gap "syntax:create-function"
test call-with-a-text-argument-for-an-integer-parameter {
    CREATE FUNCTION add_one(x int) RETURNS int LANGUAGE sql AS 'SELECT x + 1';
    SELECT add_one('7'::text);
}
@sqlstate 42883
expect error {
    function add_one\(text\) does not exist
}
expect @tursopg {
    8
}

test policy-that-calls-a-sql-function {
    CREATE TABLE docs (id int PRIMARY KEY, owner int);
    CREATE FUNCTION me() RETURNS int LANGUAGE sql STABLE AS $$ SELECT 2 $$;
    ALTER TABLE docs ENABLE ROW LEVEL SECURITY;
    CREATE POLICY p ON docs USING (owner = me());
    SELECT polname FROM pg_policy;
}
expect {
    p
}

# The body of a function that a policy calls is computed for each row, and
# tursopg compiles a policy without planning subqueries.
@compat-gap "syntax:create-policy"
test policy-that-calls-a-sql-function-whose-body-has-a-subquery {
    CREATE TABLE owners (id int);
    INSERT INTO owners VALUES (2);
    CREATE FUNCTION me() RETURNS int LANGUAGE sql STABLE AS $$ SELECT (SELECT max(id) FROM owners) $$;
    CREATE TABLE docs (id int PRIMARY KEY, owner int);
    ALTER TABLE docs ENABLE ROW LEVEL SECURITY;
    CREATE POLICY p ON docs USING (owner = me());
    SELECT polname FROM pg_policy;
}
expect {
    p
}
@sqlstate 0A000
expect @tursopg error {
    a call of function public.me, whose body has a subquery, is not supported in a policy
}

# A policy keeps its call, so replacing the function changes the policy, also
# when the policy calls the function in a subquery.
@compat-gap "syntax:create-policy"
test policy-whose-function-gets-a-body-with-a-subquery {
    CREATE TABLE owners (id int);
    INSERT INTO owners VALUES (2);
    CREATE FUNCTION me() RETURNS int LANGUAGE sql STABLE AS $$ SELECT 2 $$;
    CREATE TABLE docs (id int PRIMARY KEY, owner int);
    INSERT INTO docs VALUES (1, 1), (2, 2);
    ALTER TABLE docs ENABLE ROW LEVEL SECURITY;
    CREATE POLICY p ON docs USING (owner = (SELECT me()));
    CREATE ROLE replaced_function_reader;
    GRANT SELECT ON docs, owners TO replaced_function_reader;
    CREATE OR REPLACE FUNCTION me() RETURNS int LANGUAGE sql STABLE AS $$ SELECT (SELECT max(id) FROM owners) $$;
    SET ROLE replaced_function_reader;
    SELECT id FROM docs;
}
expect {
    2
}
@sqlstate 0A000
expect @tursopg error {
    a call of function public.me, whose body has a subquery, is not supported in a policy
}

test drop-function-that-a-policy-calls-errors {
    CREATE TABLE docs (id int PRIMARY KEY, owner int);
    CREATE FUNCTION me() RETURNS int LANGUAGE sql STABLE AS $$ SELECT 2 $$;
    CREATE POLICY p ON docs USING (owner = me());
    DROP FUNCTION me();
}
@sqlstate 2BP01
expect error {
    cannot drop function me\(\) because other objects depend on it
}

# CREATE POLICY accepts auth.uid() while it is tursopg's built-in function.
# A function created later with that name is compiled into the policy, and
# its body may not have a subquery, which could read the policy's table
# again.
@skip-if postgres "PostgreSQL has no built-in auth.uid()"
test policy-whose-built-in-function-a-sql-function-replaces-errors {
    CREATE TABLE p (a uuid);
    ALTER TABLE p ENABLE ROW LEVEL SECURITY;
    CREATE POLICY p0 ON p USING (a = auth.uid());
    CREATE ROLE r;
    GRANT SELECT ON p TO r;
    CREATE SCHEMA auth;
    CREATE FUNCTION auth.uid() RETURNS uuid LANGUAGE sql STABLE
        AS $$ SELECT (SELECT a FROM p LIMIT 1) $$;
    SET ROLE r;
    SELECT * FROM p;
}
@sqlstate 0A000
expect error {
    a call of function auth.uid, whose body has a subquery, is not supported in a policy
}

# tursopg compiles a call as the body with the arguments in place of the
# parameters, so an argument for a parameter that the body does not read
# would not be compiled at all.
@compat-gap "syntax:create-function"
test argument-that-is-not-a-literal-for-a-parameter-that-the-body-does-not-read {
    CREATE TABLE t (a int);
    INSERT INTO t VALUES (1), (2), (3);
    CREATE FUNCTION zero(x bigint) RETURNS int LANGUAGE sql IMMUTABLE AS 'SELECT 1';
    SELECT zero(count(*)) FROM t;
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    an argument of function zero that is not a literal for parameter 1, which its body does not read
}

test literal-arguments-for-parameters-that-the-body-does-not-read {
    CREATE FUNCTION zero(x int) RETURNS int LANGUAGE sql IMMUTABLE AS 'SELECT 1';
    CREATE FUNCTION first(int, int) RETURNS int LANGUAGE sql AS 'SELECT $1';
    SELECT zero(5), zero(-5), zero(NULL), first(1, 2);
}
expect {
    1|1|1|1
}

test pg-proc-joins-pg-language-for-a-sql-function {
    CREATE FUNCTION g(x bigint) RETURNS bigint LANGUAGE sql AS $$ SELECT x $$;
    SELECT p.proname, l.lanname, l.lanpltrusted
    FROM pg_proc p JOIN pg_language l ON l.oid = p.prolang
    WHERE p.proname = 'g';
}
expect {
    g|sql|t
}

test drop-function-error-names-the-parameter-types-as-format-type-does {
    CREATE FUNCTION s4(x int, y bigint) RETURNS int LANGUAGE sql AS 'SELECT x + y::int';
    CREATE TABLE d (a int DEFAULT s4(1, 2));
    DROP FUNCTION s4(int, bigint);
}
@sqlstate 2BP01
expect error {
    cannot drop function s4\(integer,bigint\) because other objects depend on it
}

# More checks of CREATE FUNCTION and DROP FUNCTION

test drop-function-with-other-argument-types-errors {
    CREATE FUNCTION add1(x int) RETURNS int LANGUAGE sql AS 'SELECT x + 1';
    DROP FUNCTION add1(text);
}
@sqlstate 42883
expect error {
    function add1\(text\) does not exist
}

test drop-function-with-argument-types-written-another-way {
    CREATE FUNCTION add1(x integer, y varchar) RETURNS int LANGUAGE sql AS 'SELECT x + 1';
    DROP FUNCTION add1(int, character varying);
    SELECT count(*) FROM pg_proc WHERE proname = 'add1';
}
expect {
    0
}

test comment-on-function-with-other-argument-types-errors {
    CREATE FUNCTION add1(x int) RETURNS int LANGUAGE sql AS 'SELECT x + 1';
    COMMENT ON FUNCTION add1(text) IS 'x';
}
@sqlstate 42883
expect error {
    function add1\(text\) does not exist
}

test replace-function-with-another-parameter-name-errors {
    CREATE FUNCTION p(x text) RETURNS text LANGUAGE sql AS 'SELECT x';
    CREATE OR REPLACE FUNCTION p(y text) RETURNS text LANGUAGE sql AS 'SELECT y';
}
@sqlstate 42P13
expect error {
    cannot change name of input parameter "x"
}

test replace-function-can-name-a-parameter-that-had-no-name {
    CREATE FUNCTION p(text) RETURNS text LANGUAGE sql AS 'SELECT $1';
    CREATE OR REPLACE FUNCTION p(y text) RETURNS text LANGUAGE sql AS 'SELECT y';
    SELECT p('a');
}
expect {
    a
}

test parameter-in-a-subquery-of-a-function-without-parameters-errors {
    CREATE FUNCTION g() RETURNS int LANGUAGE sql AS 'SELECT (SELECT $1)';
}
@sqlstate 42P02
expect error {
    there is no parameter \$1
}

test catalog-qualified-call-does-not-find-a-function-of-public {
    CREATE FUNCTION nx(a int, b int) RETURNS int LANGUAGE sql AS 'SELECT a - b';
    SELECT pg_catalog.nx(3, 1);
}
@sqlstate 42883
expect error {
    function pg_catalog\.nx
}

test view-keeps-the-function-of-its-subqueries-when-the-search-path-changes {
    CREATE SCHEMA s2;
    CREATE FUNCTION f() RETURNS int LANGUAGE sql AS 'SELECT 1';
    CREATE FUNCTION s2.f() RETURNS int LANGUAGE sql AS 'SELECT 2';
    CREATE VIEW v AS SELECT f() AS top, (SELECT f()) AS sub, EXISTS (SELECT 1 WHERE f() = 1) AS e, 1 IN (SELECT f()) AS i;
    SET search_path = s2, public;
    SELECT * FROM public.v;
}
expect {
    1|1|t|t
}

test drop-function-that-a-subquery-of-a-view-calls-errors {
    CREATE FUNCTION k() RETURNS int LANGUAGE sql AS 'SELECT 7';
    CREATE VIEW kv AS SELECT (SELECT k()) AS x;
    DROP FUNCTION k();
}
@sqlstate 2BP01
expect error {
    cannot drop function k\(\) because other objects depend on it
}

# The body of each function is a subquery that tursopg compiles where the
# call is.

test function-with-a-subquery-in-insert-values-returning-and-upsert {
    CREATE TABLE src (a int);
    INSERT INTO src VALUES (1), (2), (3);
    CREATE FUNCTION cnt() RETURNS bigint LANGUAGE sql AS 'SELECT (SELECT count(*) FROM src)';
    CREATE TABLE s (v bigint PRIMARY KEY, w bigint);
    INSERT INTO s VALUES (cnt(), 0);
    INSERT INTO s VALUES (cnt(), 5) ON CONFLICT (v) DO UPDATE SET w = cnt() + 10 RETURNING v, w, cnt();
    INSERT INTO s VALUES (7, cnt()) RETURNING w;
}
expect {
    3|13|3
    3
}

@compat-gap "syntax:create-function"
test function-with-a-subquery-in-a-check-constraint {
    CREATE TABLE src (a int);
    INSERT INTO src VALUES (1), (2), (3);
    CREATE FUNCTION cnt() RETURNS bigint LANGUAGE sql AS 'SELECT (SELECT count(*) FROM src)';
    CREATE TABLE c (v int CHECK (v < cnt()));
    INSERT INTO c VALUES (1);
    SELECT v FROM c;
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    a call of function public.cnt, whose body has a subquery, is not supported in a CHECK constraint
}

@compat-gap "syntax:create-function"
test function-with-a-subquery-in-a-column-default {
    CREATE TABLE src (a int);
    INSERT INTO src VALUES (1), (2), (3);
    CREATE FUNCTION cnt() RETURNS bigint LANGUAGE sql AS 'SELECT (SELECT count(*) FROM src)';
    CREATE TABLE d (id int, v bigint DEFAULT cnt());
    INSERT INTO d (id) VALUES (1);
    SELECT v FROM d;
}
expect {
    3
}
@sqlstate 0A000
expect @tursopg error {
    a call of function public.cnt, whose body has a subquery, is not supported in a column default
}

# A domain whose CHECK calls a function, and a function that casts to the
# domain, used to call each other until tursopg ran out of stack.
@compat-gap "syntax:create-domain"
test domain-check-that-calls-a-sql-function {
    CREATE FUNCTION f() RETURNS int LANGUAGE sql AS 'SELECT 1';
    CREATE DOMAIN dm AS int CHECK (VALUE > f());
    SELECT 5::dm;
}
expect {
    5
}
@sqlstate 0A000
expect @tursopg error {
    function f is not supported in domain CHECK expressions
}

@compat-gap "syntax:create-function"
test function-body-of-another-type-than-the-return-type {
    CREATE FUNCTION bad() RETURNS int LANGUAGE sql AS $$ SELECT 'abc'::text $$;
}
@sqlstate 42P13
expect error {
    return type mismatch in function declared to return integer
}
expect @tursopg {
}
