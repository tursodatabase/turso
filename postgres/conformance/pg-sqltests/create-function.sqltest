test comment-on-function {
    CREATE FUNCTION answer() RETURNS int LANGUAGE sql AS 'SELECT 42';
    COMMENT ON FUNCTION answer() IS 'the answer';
    SELECT obj_description(oid, 'pg_proc') FROM pg_proc WHERE proname = 'answer';
    COMMENT ON FUNCTION answer IS NULL;
    SELECT coalesce(obj_description(oid, 'pg_proc'), '<none>') FROM pg_proc WHERE proname = 'answer';
}
expect {
    the answer
    <none>
}

test drop-function-deletes-its-comment {
    CREATE FUNCTION answer() RETURNS int LANGUAGE sql AS 'SELECT 42';
    COMMENT ON FUNCTION answer() IS 'goes with the function';
    DROP FUNCTION answer();
    SELECT count(*) FROM pg_description WHERE description = 'goes with the function';
}
expect {
    0
}

test drop-schema-cascade-deletes-the-comments-of-its-functions {
    CREATE SCHEMA app;
    CREATE FUNCTION app.answer() RETURNS int LANGUAGE sql AS 'SELECT 42';
    COMMENT ON FUNCTION app.answer() IS 'goes with the schema';
    DROP SCHEMA app CASCADE;
    SELECT count(*) FROM pg_description WHERE description = 'goes with the schema';
    SELECT count(*) FROM pg_proc WHERE proname = 'answer';
}
expect {
    0
    0
}

