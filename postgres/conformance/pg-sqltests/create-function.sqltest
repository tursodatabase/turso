# CREATE FUNCTION, CREATE PROCEDURE and the statements around them.
#
# tursopg does not support functions yet. When PostgreSQL rejects a
# statement, tursopg gives the same error. Otherwise tursopg names the first
# feature it does not support. Each test shows what PostgreSQL does, so a
# feature is supported once its `expect @tursopg error` block is removed.

@database :memory:

# A plain SQL function, which is the first kind of function tursopg will
# support.
test sql-function {
    CREATE FUNCTION one() RETURNS int AS $$ SELECT 1 $$ LANGUAGE sql;
    SELECT one();
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    CREATE FUNCTION is not supported
}

test sql-function-with-parameter {
    CREATE FUNCTION add_one(int) RETURNS int AS $$ SELECT $1 + 1 $$ LANGUAGE sql;
    SELECT add_one(41);
}
expect {
    42
}
@sqlstate 0A000
expect @tursopg error {
    CREATE FUNCTION is not supported
}

test sql-function-in-public-schema {
    CREATE FUNCTION public.one() RETURNS int AS $$ SELECT 1 $$ LANGUAGE sql;
    SELECT public.one();
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    CREATE FUNCTION is not supported
}

test sql-function-in-other-schema {
    CREATE SCHEMA app;
    CREATE FUNCTION app.one() RETURNS int AS $$ SELECT 1 $$ LANGUAGE sql;
    SELECT app.one();
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    a schema-qualified function name is not supported
}

test sql-function-in-missing-schema {
    CREATE FUNCTION nosuch.one() RETURNS int AS $$ SELECT 1 $$ LANGUAGE sql;
}
@sqlstate 3F000
expect error {
    schema "nosuch" does not exist
}

test create-or-replace-function {
    CREATE OR REPLACE FUNCTION one() RETURNS int AS $$ SELECT 1 $$ LANGUAGE sql;
    SELECT one();
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    CREATE OR REPLACE FUNCTION is not supported
}

test create-procedure {
    CREATE PROCEDURE noop() AS $$ SELECT 1 $$ LANGUAGE sql;
    CALL noop();
}
expect {
}
@sqlstate 0A000
expect @tursopg error {
    CREATE PROCEDURE is not supported
}

# Languages

test plpgsql-function {
    CREATE FUNCTION one() RETURNS int AS $$ BEGIN RETURN 1; END $$ LANGUAGE plpgsql;
    SELECT one();
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    LANGUAGE plpgsql is not supported
}

test internal-function {
    CREATE FUNCTION my_abs(int) RETURNS int AS 'int4abs' LANGUAGE internal;
    SELECT my_abs(-3);
}
expect {
    3
}
@sqlstate 0A000
expect @tursopg error {
    LANGUAGE internal is not supported
}

test function-in-missing-language {
    CREATE FUNCTION one() RETURNS int AS $$ SELECT 1 $$ LANGUAGE nosuch;
}
@sqlstate 42704
expect error {
    language "nosuch" does not exist
}

test function-without-language {
    CREATE FUNCTION one() RETURNS int AS $$ SELECT 1 $$;
}
@sqlstate 42P13
expect error {
    no language specified
}

# Function bodies

test single-quoted-function-body {
    CREATE FUNCTION one() RETURNS int AS 'SELECT 1' LANGUAGE sql;
    SELECT one();
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    a function body that is not dollar-quoted is not supported
}

test return-function-body {
    CREATE FUNCTION one() RETURNS int RETURN 1;
    SELECT one();
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    a RETURN function body is not supported
}

test begin-atomic-function-body {
    CREATE FUNCTION one() RETURNS int LANGUAGE sql BEGIN ATOMIC SELECT 1; END;
    SELECT one();
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    a BEGIN ATOMIC function body is not supported
}

test function-without-body {
    CREATE FUNCTION one() RETURNS int LANGUAGE sql;
}
@sqlstate 42P13
expect error {
    no function body specified
}

test function-with-two-bodies {
    CREATE FUNCTION one() RETURNS int LANGUAGE sql AS $$ SELECT 1 $$ RETURN 1;
}
@sqlstate 42P13
expect error {
    duplicate function body specified
}

test sql-function-with-two-as-items {
    CREATE FUNCTION one() RETURNS int AS 'a', 'b' LANGUAGE sql;
}
@sqlstate 42P13
expect error {
    only one AS item needed for language "sql"
}

test function-body-with-syntax-error {
    CREATE FUNCTION one() RETURNS int AS $$ SELEC 1 $$ LANGUAGE sql;
}
@sqlstate 42601
expect error {
    syntax error at or near "SELEC"
}

test multi-statement-function {
    CREATE FUNCTION two() RETURNS int AS $$ SELECT 1; SELECT 2 $$ LANGUAGE sql;
    SELECT two();
}
expect {
    2
}
@sqlstate 0A000
expect @tursopg error {
    a function body with several statements is not supported
}

test ddl-in-function {
    CREATE FUNCTION make_table() RETURNS void AS $$ CREATE TABLE made (a int) $$ LANGUAGE sql;
    SELECT make_table();
    SELECT count(*) FROM made;
}
expect {

    0
}
@sqlstate 0A000
expect @tursopg error {
    CREATE TABLE in a function body is not supported
}

test select-into-in-function {
    CREATE FUNCTION make_table() RETURNS void AS $$ SELECT 1 AS a INTO made $$ LANGUAGE sql;
    SELECT make_table();
    SELECT a FROM made;
}
expect {

    1
}
@sqlstate 0A000
expect @tursopg error {
    SELECT INTO in a function body is not supported
}

test utility-statement-in-function {
    CREATE FUNCTION notify() RETURNS void AS $$ NOTIFY channel $$ LANGUAGE sql;
    SELECT notify();
}
expect {

}
@sqlstate 0A000
expect @tursopg error {
    a utility statement in a function body is not supported
}

test data-modifying-function {
    CREATE TABLE t (a int);
    INSERT INTO t VALUES (1);
    CREATE FUNCTION bump() RETURNS void AS $$ UPDATE t SET a = a + 1 $$ LANGUAGE sql;
    SELECT bump();
    SELECT a FROM t;
}
expect {

    2
}
@sqlstate 0A000
expect @tursopg error {
    a data-modifying statement in a function body is not supported
}

# Parameters

test polymorphic-function {
    CREATE FUNCTION same(anyelement) RETURNS anyelement AS $$ SELECT $1 $$ LANGUAGE sql;
    SELECT same(1), same('a'::text);
}
expect {
    1|a
}
@sqlstate 0A000
expect @tursopg error {
    a function parameter of polymorphic type anyelement is not supported
}

test polymorphic-result-without-polymorphic-parameter {
    CREATE FUNCTION same(int) RETURNS anyelement AS $$ SELECT $1 $$ LANGUAGE sql;
}
@sqlstate 42P13
expect error {
    cannot determine result data type
}

test named-parameter {
    CREATE FUNCTION add_one(x int) RETURNS int AS $$ SELECT x + 1 $$ LANGUAGE sql;
    SELECT add_one(41);
}
expect {
    42
}
@sqlstate 0A000
expect @tursopg error {
    a named function parameter is not supported
}

test parameter-default {
    CREATE FUNCTION add(int, int DEFAULT 1) RETURNS int AS $$ SELECT $1 + $2 $$ LANGUAGE sql;
    SELECT add(41);
}
expect {
    42
}
@sqlstate 0A000
expect @tursopg error {
    a function parameter with a DEFAULT is not supported
}

test out-parameter {
    CREATE FUNCTION one(OUT int) AS $$ SELECT 1 $$ LANGUAGE sql;
    SELECT one();
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    an OUT parameter is not supported
}

test inout-parameter {
    CREATE FUNCTION add_one(INOUT int) AS $$ SELECT $1 + 1 $$ LANGUAGE sql;
    SELECT add_one(41);
}
expect {
    42
}
@sqlstate 0A000
expect @tursopg error {
    an INOUT parameter is not supported
}

test variadic-parameter {
    CREATE FUNCTION first(VARIADIC int[]) RETURNS int AS $$ SELECT $1[1] $$ LANGUAGE sql;
    SELECT first(4, 5);
}
expect {
    4
}
@sqlstate 0A000
expect @tursopg error {
    a VARIADIC parameter is not supported
}

test array-parameter {
    CREATE FUNCTION first(int[]) RETURNS int AS $$ SELECT $1[1] $$ LANGUAGE sql;
    SELECT first(ARRAY[4, 5]);
}
expect {
    4
}
@sqlstate 0A000
expect @tursopg error {
    a function parameter of array type pg_catalog\.int4\[\] is not supported
}

test column-type-parameter {
    CREATE TABLE t (a int);
    CREATE FUNCTION add_one(t.a%TYPE) RETURNS int AS $$ SELECT $1 + 1 $$ LANGUAGE sql;
    SELECT add_one(41);
}
expect {
    42
}
@sqlstate 0A000
expect @tursopg error {
    %TYPE in a function parameter type is not supported
}

test table-row-parameter {
    CREATE TABLE emp (name text);
    CREATE FUNCTION name_of(emp) RETURNS text AS $$ SELECT $1.name $$ LANGUAGE sql;
    INSERT INTO emp VALUES ('ann');
    SELECT name_of(emp) FROM emp;
}
expect {
    ann
}
@sqlstate 0A000
expect @tursopg error {
    a function parameter of type emp is not supported
}

test enum-parameter {
    CREATE TYPE mood AS ENUM ('sad', 'happy');
    CREATE FUNCTION is_happy(mood) RETURNS bool AS $$ SELECT $1 = 'happy' $$ LANGUAGE sql;
    SELECT is_happy('happy');
}
expect {
    t
}
@sqlstate 0A000
expect @tursopg error {
    a function parameter of type mood is not supported
}

test missing-parameter-type {
    CREATE FUNCTION f(nosuch) RETURNS int AS $$ SELECT 1 $$ LANGUAGE sql;
}
@sqlstate 42704
expect error {
    type nosuch does not exist
}

test range-parameter {
    CREATE FUNCTION f(int4range) RETURNS int AS $$ SELECT 1 $$ LANGUAGE sql;
}
expect {
}
@sqlstate 0A000
expect @tursopg error {
    CREATE FUNCTION is not supported
}

test pg-lsn-result {
    CREATE FUNCTION f() RETURNS pg_lsn AS $$ SELECT '0/0'::pg_lsn $$ LANGUAGE sql;
}
expect {
}
@sqlstate 0A000
expect @tursopg error {
