}

test numeric-column-plus-round-and-mod-of-exact-numbers-is-exact {
    -- round() and mod() of exact numbers give exact numbers, so the sums keep
    -- the column's scale and are not floating-point.
    CREATE TABLE prices (amount numeric(10,2));
    INSERT INTO prices VALUES (0.1);
    SELECT amount + round(0.2, 1), amount + mod(10, 4) FROM prices;
}
expect {
    0.30|2.10
}

test check-constraint-compares-a-timestamptz-column-with-now {
    CREATE TABLE past_events (at timestamptz CHECK (at <= now()));
    INSERT INTO past_events VALUES ('2000-01-01 00:00:00+00:00');
    SELECT count(*) FROM past_events;
}
expect {
    1
}

# booleq() returns boolean, not integer, so it cannot be added to a number.
test booleq-plus-an-integer-errors {
    SELECT booleq(true, true) + 1;
}
expect error {
    operator does not exist: boolean \+ integer
}

# booleq() returns boolean, so the client sees t and f, not 1 and 0.
test booleq-prints-as-a-boolean {
    SELECT booleq(true, true), booleq(true, false);
}
expect {
    t|f
}

# random() returns a double precision number from 0 up to but not including 1,
# so the value is usually not a whole number.
test random-is-a-fraction-between-zero-and-one {
    SELECT CASE WHEN r >= 0 AND r < 1 AND r <> floor(r) THEN 'ok' END FROM (SELECT random() AS r) AS t;
}
expect {
    ok
}

# random() is double precision, so dividing by it is not an integer division.
test random-divisor-is-not-an-integer {
    SELECT CASE WHEN 1 / random() > 1 THEN 'ok' END;
}
expect {
    ok
}

test array-to-json-of-integers-texts-and-nulls {
    SELECT array_to_json(ARRAY[1, 5, 99]),
           array_to_json(ARRAY['a', 'b "c"', NULL]),
           array_to_json(string_to_array('public', '')::name[]),
           array_to_json(ARRAY[]::int[]),
           coalesce(array_to_json(NULL::int[])::text, 'none');
}
expect {
    [1,5,99]|["a","b \"c\"",null]|["public"]|[]|none
}

test array-to-json-pretty-puts-line-feeds-between-elements {
    SELECT replace(array_to_json(ARRAY[1, 2, 3], true)::text, chr(10), '|'),
           replace(array_to_json(ARRAY[1, 2, 3], false)::text, chr(10), '|');
}
expect {
    [1,| 2,| 3]|[1,2,3]
}

test array-to-json-with-null-pretty-is-null {
    SELECT coalesce(array_to_json(ARRAY[1, 2], NULL)::text, 'none');
}
expect {
    none
}

test array-to-json-pretty-can-be-a-boolean-literal-string {
    SELECT replace(array_to_json(ARRAY[1, 2], 'true')::text, chr(10), '|'),
           array_to_json(ARRAY[1, 2], 'off');
}
expect {
    [1,| 2]|[1,2]
}

test array-to-json-pretty-must-be-a-boolean {
    SELECT array_to_json(ARRAY[1, 2], 'maybe');
}
expect error {
    invalid input syntax for type boolean: "maybe"
}

test array-to-json-pretty-puts-line-feeds-only-between-outer-elements {
    SELECT replace(array_to_json(ARRAY[[1, 2], [3, 4]], true)::text, chr(10), '|');
}
expect {
    [[1,2],| [3,4]]
}

test array-to-json-writes-booleans-as-true-and-false {
    SELECT array_to_json(ARRAY[true, false, NULL]),
           array_to_json(ARRAY[[true], [false]]);
}
expect {
    [true,false,null]|[[true],[false]]
}

test array-to-json-writes-floats-like-float8-output {
    SELECT array_to_json(ARRAY[1.0::float8, 1e20::float8, 0.1::float8 + 0.2::float8,
                               1.5e-5::float8]);
}
expect {
    [1,1e+20,0.30000000000000004,1.5e-05]
}

test array-to-json-writes-bytea-as-hex-strings {
    SELECT array_to_json(ARRAY['abc'::bytea, NULL]);
}
expect {
    ["\\\\x616263",null]
}

test array-to-json-writes-dates-and-timestamps-in-iso-format {
    SELECT array_to_json(ARRAY['2024-01-02'::date]),
           array_to_json(ARRAY['2024-01-02 03:04:05.5'::timestamp]),
           array_to_json(ARRAY['2024-01-02 03:04:05'::timestamptz]);
}
expect {
    ["2024-01-02"]|["2024-01-02T03:04:05.5"]|["2024-01-02T03:04:05+00:00"]
}

test array-to-json-embeds-json-and-jsonb-values {
    CREATE TABLE array_to_json_documents (id int, j json, jb jsonb);
    INSERT INTO array_to_json_documents VALUES (1, '{"a":1}', '[1]'), (2, '"x"', 'null');
    SELECT array_to_json(array_agg(j ORDER BY id)),
           array_to_json(array_agg(jb ORDER BY id))
    FROM array_to_json_documents;
}
expect {
    [{"a":1},"x"]|[[1],null]
}

