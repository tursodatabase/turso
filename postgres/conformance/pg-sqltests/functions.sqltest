test text-functions-accept-string-typed-arguments {
    CREATE TABLE text_args (t text, v varchar, n name);
    CREATE DOMAIN text_arg_domain AS text;
    CREATE TABLE domain_args (d text_arg_domain);
    INSERT INTO text_args VALUES ('A', '12', 'int4');
    INSERT INTO domain_args VALUES ('999');
    SELECT quote_ident(t), quote_ident(v), quote_ident(n) FROM text_args;
    SELECT pg_input_is_valid(v, n) FROM text_args;
    SELECT '[' || to_char(7, d) || ']' FROM domain_args;
    SELECT quote_ident(12::text);
}
expect {
    "A"|"12"|int4
    t
    [   7]
    "12"
}

test text-functions-accept-values-columns {
    SELECT quote_ident(x) FROM (VALUES ('a')) v(x);
    SELECT quote_ident(x) FROM (VALUES ('a'::text)) v(x);
    WITH c(x) AS (VALUES ('b')) SELECT quote_ident(x) FROM c;
    SELECT '[' || to_char(5, f) || ']' FROM (VALUES ('999')) v(f);
}
expect {
    a
    a
    b
    [   5]
}

test text-functions-accept-null-in-values-columns {
    SELECT coalesce(quote_ident(x), 'null') FROM (VALUES ('a'), (NULL)) v(x);
    SELECT coalesce(quote_ident(x), 'null') FROM (VALUES (NULL::text)) v(x);
    WITH c(x) AS (VALUES ('b'), (NULL)) SELECT coalesce(quote_ident(x), 'null') FROM c;
    SELECT coalesce('[' || to_char(5, f) || ']', 'null') FROM (VALUES ('999'), (NULL)) v(f);
    SELECT CASE WHEN pg_input_is_valid(x, 'int4') IS NULL THEN 'null' ELSE 'not null' END
    FROM (VALUES ('1'), (NULL)) v(x);
    SELECT CASE WHEN pg_input_is_valid('1', t) IS NULL THEN 'null' ELSE 'not null' END
    FROM (VALUES ('int4'), (NULL)) v(t);
}
expect {
    a
    null
    null
    b
    null
    [   5]
    null
    not null
    null
    not null
    null
}

