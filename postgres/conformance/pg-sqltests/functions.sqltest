# Scalar function behavior through the PostgreSQL frontend.
#
# Coverage here asserts behavior that real PostgreSQL also exhibits, so the
# corpus is valid for differential runs against a stock server.
# Server-specific outputs (version(), current_database(), pg_backend_pid())
# are covered in postgres/tests/integration instead.

@database :memory:

test quote-ident-plain-lowercase {
    SELECT quote_ident('abc');
}
expect {
    abc
}

test quote-ident-underscore-and-digits {
    SELECT quote_ident('a_1');
}
expect {
    a_1
}

test quote-ident-mixed-case {
    SELECT quote_ident('Abc');
}
expect {
    "Abc"
}

test quote-ident-embedded-space {
    SELECT quote_ident('a b');
}
expect {
    "a b"
}

test quote-ident-embedded-quote-doubled {
    SELECT quote_ident('a"b');
}
expect {
    "a""b"
}

test quote-ident-reserved-keyword {
    SELECT quote_ident('select');
}
expect {
    "select"
}

test quote-ident-unreserved-keyword-unquoted {
    SELECT quote_ident('commit');
}
expect {
    commit
}

test quote-ident-col-name-keyword {
    SELECT quote_ident('between');
}
expect {
    "between"
}

test quote-ident-type-func-name-keyword {
    SELECT quote_ident('binary');
}
expect {
    "binary"
}

test quote-ident-empty-string {
    SELECT quote_ident('');
}
expect {
    ""
}

test quote-ident-leading-digit {
    SELECT quote_ident('1a');
}
expect {
    "1a"
}

test quote-ident-null-is-null {
    SELECT quote_ident(NULL);
}
expect {
}

test quote-literal-plain {
    SELECT quote_literal('abc');
}
expect {
    'abc'
}

test quote-literal-embedded-quote {
    SELECT quote_literal('O''Reilly');
}
expect {
    'O''Reilly'
}

test quote-literal-integer {
    SELECT quote_literal(42);
}
expect {
    '42'
}

test quote-literal-null-is-null {
    SELECT quote_literal(NULL);
}
expect {
}

# The sqltest lexer collapses \\ to \, so the expected E'a\\b' is written
# with doubled backslashes here.
test quote-literal-backslash-uses-escape-string {
    SELECT quote_literal('a\b');
}
expect {
    E'a\\\\b'
}

test current-schema-default {
    SELECT current_schema();
}
expect {
    public
}

test current-schema-bare-keyword {
    SELECT current_schema;
}
expect {
    public
}

test current-schema-in-from-position {
    SELECT * FROM current_schema();
}
expect {
    public
}

test obj-description-unknown-oid-is-null {
    SELECT obj_description(0, 'pg_class');
}
expect {
}

test col-description-unknown-oid-is-null {
    SELECT col_description(0, 1);
}
expect {
}

test version-wrong-arity-errors {
    SELECT version(1);
}
expect error {}

test quote-ident-wrong-arity-errors {
    SELECT quote_ident();
}
expect error {}

test pg-get-expr-default-two-args {
    CREATE TABLE demo (id int DEFAULT 7, label text);
    SELECT pg_get_expr(adbin, adrelid) FROM pg_attrdef;
}
expect {
    7
}

test pg-get-expr-default-three-args {
    CREATE TABLE demo (id int DEFAULT 7, label text);
    SELECT pg_get_expr(adbin, adrelid, true) FROM pg_attrdef;
}
expect {
    7
}

test pg-get-expr-null-oid-is-null {
    CREATE TABLE demo (id int DEFAULT 7, label text);
    SELECT pg_get_expr(adbin, NULL, true) FROM pg_attrdef;
}
expect {
}

test pg-get-expr-non-text-expression-errors {
    CREATE TABLE demo (id int DEFAULT 7, label text);
    SELECT pg_get_expr(42, 1::oid) FROM pg_attrdef;
}
expect error {}

test pg-get-expr-null-oid-does-not-hide-invalid-expression {
    SELECT pg_get_expr(42, NULL::oid);
}
expect error {}

@skip-if postgres "PostgreSQL prints (val > 0), and also lists the CHECK constraints of the information_schema domains"
test pg-get-expr-check-constraint {
    CREATE TABLE checked (val int CHECK (val > 0));
    SELECT pg_get_expr(conbin, conrelid) FROM pg_constraint WHERE contype = 'c';
}
expect {
    val > 0
}

test percentile-cont-within-group {
    CREATE TABLE demo (value int);
    INSERT INTO demo (value) VALUES (1), (2);
    SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY value) FROM demo;
}
expect {
    1.5
}

test mode-within-group {
    CREATE TABLE demo (value int);
    INSERT INTO demo VALUES (2), (2), (1), (1);
    SELECT mode() WITHIN GROUP (ORDER BY value) FROM demo;
}
expect {
    1
}

@skip-if postgres "Turso has the ACLs of PostgreSQL 16, without the MAINTAIN privilege (m) of PostgreSQL 17"
test acldefault-object-kinds {
    SELECT pg_catalog.acldefault('c', 4294967294);
    SELECT acldefault('r', 4294967294);
    SELECT acldefault('s', 4294967294);
    SELECT acldefault('d', 4294967294);
    SELECT acldefault('f', 4294967294);
    SELECT acldefault('l', 4294967294);
    SELECT acldefault('L', 4294967294);
    SELECT acldefault('n', 4294967294);
    SELECT acldefault('p', 4294967294);
    SELECT acldefault('t', 4294967294);
    SELECT acldefault('F', 4294967294);
    SELECT acldefault('S', 4294967294);
    SELECT acldefault('T', 4294967294);
}
expect {
    {}
    {4294967294=arwdDxt/4294967294}
    {4294967294=rwU/4294967294}
    {=Tc/4294967294,4294967294=CTc/4294967294}
    {=X/4294967294,4294967294=X/4294967294}
    {=U/4294967294,4294967294=U/4294967294}
    {4294967294=rw/4294967294}
    {4294967294=UC/4294967294}
    {4294967294=sA/4294967294}
    {4294967294=C/4294967294}
    {4294967294=U/4294967294}
    {4294967294=U/4294967294}
    {=U/4294967294,4294967294=U/4294967294}
}

test acldefault-catalog-owner {
    SET search_path TO '';
    SELECT n.tableoid, n.oid, n.nspname,
           replace(acldefault('n', n.nspowner)::text,
                   pg_get_userbyid(n.nspowner), 'owner')
    FROM pg_namespace n WHERE n.nspname = 'public';
}
expect {
    2615|2200|public|{owner=UC/owner}
}

@skip-if postgres "Turso has the ACLs of PostgreSQL 16, without the MAINTAIN privilege (m) of PostgreSQL 17"
test acldefault-first-byte-selects-object-kind {
    SELECT acldefault('rr', 4294967294);
    SELECT acldefault('r ', 4294967294);
    SELECT acldefault('Table', 4294967294);
    SELECT acldefault('ré', 4294967294);
}
expect {
    {4294967294=arwdDxt/4294967294}
    {4294967294=arwdDxt/4294967294}
    {=U/4294967294,4294967294=U/4294967294}
    {4294967294=arwdDxt/4294967294}
}

test acldefault-null-arguments {
    SELECT acldefault(NULL, 4294967294), acldefault('r', NULL);
}
expect {
    |
}

test acldefault-unknown-object-kind-errors {
    SELECT acldefault('?', 4294967294);
}
expect error {}

test acldefault-empty-object-kind-errors {
    SELECT acldefault('', 4294967294);
}
expect error {}

test acldefault-leading-space-object-kind-errors {
    SELECT acldefault(' r', 4294967294);
}
expect error {}

test acldefault-uppercase-object-kind-errors {
    SELECT acldefault('R', 4294967294);
}
expect error {}

test acldefault-non-ascii-object-kind-errors {
    SELECT acldefault('é', 4294967294);
}
expect error {}

test format-type-expanded {
    SELECT format_type(16, -1);
    SELECT format_type(23, -1);
    SELECT format_type(25, -1);
    SELECT format_type(114, -1);
    SELECT format_type(3802, -1);
    SELECT format_type(2950, -1);
    SELECT format_type(1082, -1);
    SELECT format_type(1114, -1);
    SELECT format_type(1184, -1);
    SELECT format_type(1186, -1);
    SELECT format_type(2278, -1);
    SELECT format_type(2205, -1);
    SELECT format_type(2206, -1);
    SELECT format_type(1000, -1);
    SELECT format_type(1007, -1);
    SELECT format_type(1009, -1);
    SELECT format_type(1043, 54);
}
expect {
    boolean
    integer
    text
    json
    jsonb
    uuid
    date
    timestamp without time zone
    timestamp with time zone
    interval
    void
    regclass
    regtype
    boolean[]
    integer[]
    text[]
    character varying(50)
}

test pg-type-is-visible {
    SELECT CASE WHEN pg_type_is_visible(23) THEN 1 ELSE 0 END;
}
expect {
    1
}

test lpad-rpad {
    SELECT quote_literal(lpad('hi', 5, '*'));
    SELECT quote_literal(rpad('hi', 5, '-'));
    SELECT quote_literal(lpad('hi', 5));
    SELECT quote_literal(lpad('hello world', 5));
}
expect {
    '***hi'
    'hi---'
    '   hi'
    'hello'
}

test pg-options-to-table-values {
    SELECT option_name, COALESCE(option_value, 'NULL')
    FROM pg_catalog.pg_options_to_table(ARRAY['a=b=c', 'flag', '', '=x', 'x=', 'é=olá', 'a=again']);
}
expect {
    a|b=c
    flag|NULL
    |NULL
    |x
    x|
    é|olá
    a|again
}

test pg-options-to-table-empty {
    SELECT count(*) FROM pg_options_to_table(NULL);
    SELECT count(*) FROM pg_options_to_table('{}'::text[]);
}
expect {
    0
    0
}

test pg-options-to-table-text-array {
    SELECT option_name, COALESCE(option_value, 'NULL') FROM pg_options_to_table('{"name=hello, world","flag","empty="}'::text[]);
}
expect {
    name|hello, world
    flag|NULL
    empty|
}

test pg-options-to-table-nested {
    SELECT * FROM pg_options_to_table(ARRAY[['a=b', 'c=d'], ['e=f', 'g=h']]);
}
expect {
    a|b
    c|d
    e|f
    g|h
}

test pg-options-to-table-null-element {
    SELECT * FROM pg_options_to_table(ARRAY['a=b', NULL]);
}
expect error {
    null array element not allowed in this context
}

test pg-options-to-table-correlated {
    CREATE TABLE option_arrays (id int, options text[]);
    INSERT INTO option_arrays VALUES (1, ARRAY['b=two', 'a=one']), (2, ARRAY['c=three']), (3, NULL);
    SELECT id, ARRAY(SELECT option_name || '=' || option_value FROM pg_options_to_table(options) ORDER BY option_name)
    FROM option_arrays ORDER BY id;
}
expect {
    1|{a=one,b=two}
    2|{c=three}
    3|{}
}

test pg-options-to-table-empty-search-path {
    SET search_path = '';
    SELECT option_name, option_value FROM pg_options_to_table(ARRAY['a=b']);
    SELECT option_name, option_value FROM pg_catalog.pg_options_to_table(ARRAY['c=d']);
}
expect {
    a|b
    c|d
}

test unnest-array-elements {
    SELECT unnest FROM unnest(ARRAY[3, 1, 3]);
    SELECT COALESCE(x, '<null>') FROM pg_catalog.unnest(ARRAY['a,b', NULL, 'NULL', '']) AS t(x);
    SELECT * FROM unnest(ARRAY[[1, 2], [3, 4]]);
    SELECT count(*) FROM unnest(NULL::int[]);
    SELECT count(*) FROM unnest('{}'::text[]);
}
expect {
    3
    1
    3
    a,b
    <null>
    NULL

    1
    2
    3
    4
    0
    0
}

test unnest-pgdump-correlated {
    CREATE TABLE unnest_tags (id int, tags text[]);
    INSERT INTO unnest_tags VALUES (1, ARRAY['a', 'b']), (2, ARRAY['c']), (3, NULL);
    SELECT id, array_to_string(ARRAY(SELECT quote_literal(x) FROM unnest(tags) AS t(x)), ', ')
    FROM unnest_tags ORDER BY id;
}
expect {
    1|'a', 'b'
    2|'c'
    3|
}

test unnest-join-left {
    CREATE TABLE unnest_ids (id int);
    INSERT INTO unnest_ids VALUES (1), (2);
    SELECT src.id FROM unnest('{2,3}'::oid[]) AS src(id)
    JOIN unnest_ids AS t ON src.id = t.id;
}
expect {
    2
}

test unnest-join-right {
    CREATE TABLE unnest_inputs (id int, vals int[]);
    INSERT INTO unnest_inputs VALUES (1, ARRAY[2,3]), (2, NULL);
    SELECT t.id, COALESCE(src.val, -1) FROM unnest_inputs AS t
    LEFT JOIN unnest(t.vals) AS src(val) ON true ORDER BY t.id, src.val;
}
expect {
    1|2
    1|3
    2|-1
}

test json-to-record-columns {
    SELECT * FROM json_to_record('{"a":1,"b":"foo","c":"bar"}') AS x(a int, b text, d text);
    SELECT x.b, x.a FROM json_to_record('{"a":2,"b":"baz"}') AS x(a int, b text);
    SELECT json_to_record.a FROM json_to_record('{"a":3}') AS (a int);
    SELECT a FROM pg_catalog.json_to_record('{"a":4}') AS x(a int);
    SELECT a, b FROM jsonb_to_record('{"a":5,"b":"qux"}') AS x(a int, b text);
}
expect {
    1|foo|
    baz|2
    3
    4
    5|qux
}

test json-to-record-null-and-missing-values {
    SELECT coalesce(a::text, '<null>'), coalesce(b, '<null>'), coalesce(c::text, '<null>'), coalesce(d::text, '<null>')
    FROM json_to_record('{"a":null,"b":null,"c":null}') AS x(a int, b text, c json, d int);
    SELECT count(*), count(a) FROM json_to_record(NULL) AS x(a int);
    SELECT count(*), count(a), count(b) FROM json_to_record('{}') AS x(a int, b text);
}
expect {
    <null>|<null>|<null>|<null>
    1|0
    1|0|0
}

test json-to-record-text-columns-get-the-json-text {
    SELECT * FROM json_to_record('{"a":true,"b":false,"c":1.50,"d":1e2,"e":{"k":[1,2]},"f":"s\"q"}')
    AS x(a text, b text, c text, d text, e text, f text);
}
expect {
    true|false|1.50|1e2|{"k":[1,2]}|s"q
}

test json-to-record-json-columns-keep-the-json-value {
    SELECT * FROM json_to_record('{"a":{"k":1},"b":[1,"x"],"c":"s","d":2}') AS x(a json, b json, c json, d jsonb);
}
expect {
    {"k":1}|[1,"x"]|"s"|2
}

test json-to-record-boolean-columns {
    SELECT CASE WHEN a THEN 'yes' ELSE 'no' END, CASE WHEN b THEN 'yes' ELSE 'no' END,
        CASE WHEN c THEN 'yes' ELSE 'no' END, CASE WHEN d THEN 'yes' ELSE 'no' END
    FROM json_to_record('{"a":true,"b":false,"c":"on","d":"f"}') AS x(a boolean, b boolean, c boolean, d bool);
}
expect {
    yes|no|yes|no
}

test json-to-record-boolean-column-rejects-other-text {
    SELECT * FROM json_to_record('{"a":"maybe"}') AS x(a boolean);
}
expect error {
    invalid input (syntax )?for type boolean
}

test json-to-record-number-and-date-columns {
    SELECT * FROM json_to_record('{"a":"12","b":9007199254740993,"c":1.5,"d":"2024-01-02","e":"2024-01-02 03:04:05"}')
    AS x(a int, b bigint, c float8, d date, e timestamp);
}
expect {
    12|9007199254740993|1.5|2024-01-02|2024-01-02 03:04:05
}

test json-to-record-keys-match-column-names-exactly {
    SELECT * FROM json_to_record('{"a.b":1,"a":{"b":2},"q\"r":3,"A":4,"$":5,"it''s":6}')
    AS x("a.b" int, "q""r" int, "A" int, "$" int, "it's" int);
    SELECT coalesce(a::text, '<null>') FROM json_to_record('{"A":1}') AS x(A int);
}
expect {
    1|3|4|5|6
    <null>
}

test json-to-record-lateral-reference {
    CREATE TABLE json_record_docs (id int, doc json);
    INSERT INTO json_record_docs VALUES (1, '{"a":10,"b":"x"}'), (2, '{"a":20}'), (3, NULL);
    SELECT t.id, x.a, x.b FROM json_record_docs AS t, json_to_record(t.doc) AS x(a int, b text) ORDER BY t.id;
    SELECT t.id, x.a FROM json_record_docs AS t, LATERAL json_to_record(t.doc) AS x(a int) WHERE x.a > 10;
    SELECT t.id, coalesce(x.a, -1) FROM json_record_docs AS t
    LEFT JOIN json_to_record(t.doc) AS x(a int) ON x.a = 10 ORDER BY t.id;
}
expect {
    1|10|x
    2|20|
    3||
    2|20
    1|10
    2|-1
    3|-1
}

test json-to-record-names-of-the-rewrite-do-not-hide-user-names {
    CREATE TABLE json_record_names (value json, type json);
    INSERT INTO json_record_names VALUES ('[{"a":1}]', '{"a":2}');
    SELECT x.a FROM json_record_names, json_to_recordset(value) AS x(a int);
    SELECT x.a FROM json_record_names, json_to_record(type) AS x(a int);
    SELECT x.a FROM json_record_names AS json_input, json_to_record(json_input.type) AS x(a int);
    SELECT x.a FROM json_record_names AS json_element, json_to_recordset(json_element.value) AS x(a int);
    SELECT json_input.a FROM json_to_record('{"a":3}') AS json_input(a int);
    SELECT json_element.a FROM json_to_recordset('[{"a":4}]') AS json_element(a int);
}
expect {
    1
    2
    2
    1
    3
    4
}

test json-to-recordset-rows {
    SELECT * FROM json_to_recordset('[{"a":1,"b":"foo","d":false},{"a":2,"b":"bar","c":true}]')
    AS x(a int, b text, c text) ORDER BY a;
    SELECT sum(a) FROM jsonb_to_recordset('[{"a":1},{"a":2},{"a":3}]') AS x(a int) WHERE a > 1;
    SELECT count(*) FROM json_to_recordset('[]') AS x(a int);
    SELECT count(*) FROM json_to_recordset(NULL) AS x(a int);
}
expect {
    1|foo|
    2|bar|true
    5
    0
    0
}

test json-to-recordset-lateral-reference {
    CREATE TABLE json_recordset_docs (id int, doc json);
    INSERT INTO json_recordset_docs VALUES (1, '[{"a":1},{"a":2}]'), (2, '[]'), (3, NULL);
    SELECT t.id, x.a FROM json_recordset_docs AS t, json_to_recordset(t.doc) AS x(a int) ORDER BY t.id, x.a;
    SELECT t.id, coalesce(x.a, -1) FROM json_recordset_docs AS t
    LEFT JOIN json_to_recordset(t.doc) AS x(a int) ON true ORDER BY t.id, x.a;
}
expect {
    1|1
    1|2
    1|1
    1|2
    2|-1
    3|-1
}

test json-to-recordset-join-and-insert {
    CREATE TABLE json_recordset_items (id int, name text);
    INSERT INTO json_recordset_items VALUES (1, 'one'), (2, 'two'), (3, 'three');
    SELECT i.name, x.qty FROM json_to_recordset('[{"id":3,"qty":30},{"id":1,"qty":10}]') AS x(id int, qty int)
    JOIN json_recordset_items AS i ON i.id = x.id ORDER BY i.id;
    CREATE TABLE json_recordset_target (a int, b text);
    INSERT INTO json_recordset_target SELECT * FROM json_to_recordset('[{"a":1,"b":"x"},{"a":2}]') AS x(a int, b text);
    SELECT a, coalesce(b, '<null>') FROM json_recordset_target ORDER BY a;
}
expect {
    one|10
    three|30
    1|x
    2|<null>
}

test json-to-record-requires-column-definition-list {
    SELECT * FROM json_to_record('{"a":1}') AS x(a);
}
expect error {
    a column definition list is required for functions returning "record"
}

test json-to-record-without-alias-requires-column-definition-list {
    SELECT * FROM json_to_recordset('[{"a":1}]');
}
expect error {
    a column definition list is required for functions returning "record"
}

test json-to-record-rejects-array {
    SELECT * FROM json_to_record('[1]') AS x(a int);
}
expect error {
    cannot call populate_composite on an array
}

test json-to-record-rejects-scalar {
    SELECT * FROM json_to_record('5') AS x(a int);
}
expect error {
    cannot call populate_composite on a scalar
}

test json-to-record-rejects-json-null {
    SELECT * FROM json_to_record('null') AS x(a int);
}
expect error {
    cannot call populate_composite on a scalar
}

test json-to-record-rejects-array-without-reading-columns {
    SELECT count(*) FROM json_to_record('[1]') AS x(a int);
}
expect error {
    cannot call populate_composite on an array
}

test jsonb-to-record-rejects-array {
    SELECT * FROM jsonb_to_record('[1]') AS x(a int);
}
expect error {
    cannot call populate_composite on an array
}

test json-to-record-rejects-invalid-json {
    SELECT * FROM json_to_record('nope') AS x(a int);
}
expect error {}

test json-to-recordset-rejects-object {
    SELECT * FROM json_to_recordset('{"a":1}') AS x(a int);
}
expect error {
    cannot call json_to_recordset on an object
}

test json-to-recordset-rejects-empty-object {
    SELECT * FROM json_to_recordset('{}') AS x(a int);
}
expect error {
    cannot call json_to_recordset on an object
}

test json-to-recordset-rejects-scalar {
    SELECT * FROM json_to_recordset('5') AS x(a int);
}
expect error {
    cannot call json_to_recordset on a scalar
}

test json-to-recordset-rejects-element-that-is-not-an-object {
    SELECT * FROM json_to_recordset('[{"a":1},2]') AS x(a int);
}
expect error {
    argument of json_to_recordset must be an array of objects
}

test json-to-recordset-rejects-null-element {
    SELECT * FROM json_to_recordset('[{"a":1},null]') AS x(a int);
}
expect error {
    argument of json_to_recordset must be an array of objects
}

test jsonb-to-recordset-rejects-object {
    SELECT * FROM jsonb_to_recordset('{"a":1}') AS x(a int);
}
expect error {
    cannot call jsonb_to_recordset on a non-array
}

test jsonb-to-recordset-rejects-element-that-is-not-an-object {
    SELECT * FROM jsonb_to_recordset('[[{"a":1}]]') AS x(a int);
}
expect error {
    argument of jsonb_to_recordset must be an array of objects
}

test json-to-record-rejects-duplicate-column-name {
    SELECT * FROM json_to_record('{"a":1}') AS x(a int, a text);
}
expect error {
    column name "a" specified more than once
}

test json-to-recordset-rejects-with-ordinality {
    SELECT * FROM json_to_recordset('[{"a":5}]') WITH ORDINALITY AS x(a int);
}
expect error {
    WITH ORDINALITY cannot be used with a column definition list
}

test json-to-record-rejects-two-arguments {
    SELECT * FROM json_to_record('{"a":1}', 1) AS x(a int);
}
expect error {}

@skip-if postgres "PostgreSQL converts JSON arrays to array columns"
test json-to-record-rejects-array-column-type {
    SELECT * FROM json_to_record('{"a":[1,2]}') AS x(a int[]);
}
expect error {
    json_to_record does not support the column type int4\[\]
}

@skip-if postgres "PostgreSQL converts JSON objects to composite columns"
test json-to-record-rejects-unknown-column-type {
    CREATE TABLE json_record_row (a int);
    SELECT * FROM json_to_record('{"r":{"a":1}}') AS x(r json_record_row);
}
expect error {
    json_to_record does not support the column type json_record_row
}

@skip-if postgres "PostgreSQL supports ROWS FROM"
test json-to-record-rejects-rows-from {
    SELECT * FROM ROWS FROM (json_to_record('{"a":1}') AS (a int)) AS x;
}
expect error {
    ROWS FROM is not supported with json_to_record
}
