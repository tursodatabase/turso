test pg-get-expr-number-default {
    CREATE TABLE demo (
        a int DEFAULT 7, b bigint DEFAULT 7, c int DEFAULT -1, d numeric(10, 2) DEFAULT 1.5,
        e bigint DEFAULT 3000000000, f numeric(10, 2) DEFAULT -1.5, g int DEFAULT 1 + 2
    );
