test pg-options-to-table-correlated {
    CREATE TABLE option_arrays (id int, options text[]);
    INSERT INTO option_arrays VALUES (1, ARRAY['b=two', 'a=one']), (2, ARRAY['c=three']), (3, NULL);
    SELECT id, ARRAY(SELECT option_name || '=' || option_value FROM pg_options_to_table(options) ORDER BY option_name)
    FROM option_arrays ORDER BY id;
}
expect {
    1|{a=one,b=two}
    2|{c=three}
    3|{}
}

test pg-options-to-table-empty-search-path {
    SET search_path = '';
    SELECT option_name, option_value FROM pg_options_to_table(ARRAY['a=b']);
    SELECT option_name, option_value FROM pg_catalog.pg_options_to_table(ARRAY['c=d']);
}
expect {
    a|b
    c|d
}

test unnest-array-elements {
    SELECT unnest FROM unnest(ARRAY[3, 1, 3]);
    SELECT COALESCE(x, '<null>') FROM pg_catalog.unnest(ARRAY['a,b', NULL, 'NULL', '']) AS t(x);
    SELECT * FROM unnest(ARRAY[[1, 2], [3, 4]]);
    SELECT count(*) FROM unnest(NULL::int[]);
    SELECT count(*) FROM unnest('{}'::text[]);
}
expect {
    3
    1
    3
    a,b
    <null>
    NULL

    1
    2
    3
    4
    0
    0
}

test unnest-argument-is-a-table-column-with-the-name-of-a-column-of-unnest {
    CREATE TABLE unnest_names (input int[], unnest int[]);
    INSERT INTO unnest_names VALUES ('{1,2}', '{7}');
    SELECT u FROM unnest_names, unnest(input) AS u;
    SELECT u FROM unnest_names, unnest(unnest) AS u;
}
expect {
    1
    2
    7
}

test unnest-pgdump-correlated {
    CREATE TABLE unnest_tags (id int, tags text[]);
    INSERT INTO unnest_tags VALUES (1, ARRAY['a', 'b']), (2, ARRAY['c']), (3, NULL);
    SELECT id, array_to_string(ARRAY(SELECT quote_literal(x) FROM unnest(tags) AS t(x)), ', ')
    FROM unnest_tags ORDER BY id;
}
expect {
    1|'a', 'b'
    2|'c'
    3|
}

test unnest-join-left {
    CREATE TABLE unnest_ids (id int);
    INSERT INTO unnest_ids VALUES (1), (2);
    SELECT src.id FROM unnest('{2,3}'::oid[]) AS src(id)
    JOIN unnest_ids AS t ON src.id = t.id;
}
expect {
    2
}

test unnest-join-right {
    CREATE TABLE unnest_inputs (id int, vals int[]);
    INSERT INTO unnest_inputs VALUES (1, ARRAY[2,3]), (2, NULL);
    SELECT t.id, COALESCE(src.val, -1) FROM unnest_inputs AS t
    LEFT JOIN unnest(t.vals) AS src(val) ON true ORDER BY t.id, src.val;
}
expect {
    1|2
    1|3
    2|-1
}

test unnest-several-arrays-pads-the-shorter-ones-with-null {
    SELECT * FROM unnest(ARRAY[1, 2, 3], ARRAY['a', 'b']) AS t(a, b);
    SELECT * FROM unnest(ARRAY['a', 'b'], ARRAY[1, 2, 3]) AS t(a, b);
    SELECT * FROM unnest(ARRAY[1.5, 2], ARRAY['x', 'y', 'z'], ARRAY[10, 20, 30, 40]) AS t(a, b, c);
}
expect {
    1|a
    2|b
    3|
    a|1
    b|2
    |3
    1.5|x|10
    2|y|20
    |z|30
    ||40
}

test unnest-several-arrays-keeps-null-elements {
    SELECT * FROM unnest(ARRAY[1, NULL, 3], ARRAY[NULL, 'x']) AS t(a, b);
}
expect {
    1|
    |x
    3|
}

test unnest-several-arrays-reads-arrays-of-more-dimensions-element-by-element {
    SELECT * FROM unnest(ARRAY[[1, 2], [3, 4]], ARRAY['a', 'b', 'c', 'd', 'e']) AS t(a, b);
    SELECT * FROM unnest(ARRAY[[[1], [2]], [[3], [4]]], ARRAY[[10, 20], [30, 40]], ARRAY[100]) AS t(a, b, c);
    SELECT * FROM unnest(ARRAY[ARRAY[1, 2]], ARRAY[10]) AS t(a, b);
}
expect {
    1|a
    2|b
    3|c
    4|d
    |e
    1|10|100
    2|20|
    3|30|
    4|40|
    1|10
    2|
}

test unnest-several-arrays-null-and-empty-arrays-have-no-elements {
    SELECT * FROM unnest(ARRAY[1, 2], NULL::int[], '{}'::text[]) AS t(a, b, c);
    SELECT count(*) FROM unnest(NULL::int[], NULL::int[]) AS t(a, b);
    SELECT count(*) FROM unnest('{}'::int[], '{}'::int[]) AS t(a, b);
    SELECT v.k, u.* FROM (VALUES (1)) v(k) LEFT JOIN unnest(NULL::int[], NULL::int[]) AS u(x, y) ON true;
}
expect {
    1||
    2||
    0
    0
    1||
}

test unnest-several-arrays-with-ordinality {
    SELECT * FROM unnest(ARRAY[1, 2, 3], ARRAY['a', 'b']) WITH ORDINALITY AS t(a, b, n);
    SELECT * FROM unnest(ARRAY[1, 2], ARRAY['a']) WITH ORDINALITY AS t(a, b);
}
expect {
    1|a|1
    2|b|2
    3||3
    1|a|1
    2||2
}

test unnest-several-arrays-column-names {
    SELECT x, unnest FROM unnest(ARRAY[1, 2], ARRAY['a']) AS t(x);
    SELECT t.b, t.a FROM unnest(ARRAY[1, 2], ARRAY['a']) AS t(a, b) WHERE b IS NULL;
    SELECT * FROM unnest(ARRAY['x'], ARRAY['y']) AS unnest(a);
    SELECT * FROM ROWS FROM (unnest(ARRAY[1, 2], ARRAY[3])) AS t(a, b);
}
expect {
    1|a
    2|
    |2
    x|y
    1|3
    2|
}

test unnest-several-arrays-of-table-columns {
    CREATE TABLE unnest_several (id int, a int[], b text[], c int[][]);
    INSERT INTO unnest_several VALUES
        (1, ARRAY[1, 2, 3], ARRAY['x', 'y'], ARRAY[[1, 2], [3, 4]]),
        (2, NULL, ARRAY['only'], NULL),
        (3, '{}', '{}', ARRAY[[9]]),
        (4, ARRAY[7], NULL, ARRAY[[5, 6]]);
    SELECT id, u.* FROM unnest_several, unnest(a, b) AS u(x, y) ORDER BY id, x, y;
    SELECT id, u.* FROM unnest_several LEFT JOIN LATERAL unnest(a, b, c) AS u(x, y, z) ON true ORDER BY id, x, y, z;
    SELECT id, count(u.x), count(u.y) FROM unnest_several LEFT JOIN unnest(a, b) AS u(x, y) ON true GROUP BY id ORDER BY id;
}
expect {
    1|1|x
    1|2|y
    1|3|
    2||only
    4|7|
    1|1|x|1
    1|2|y|2
    1|3||3
    1|||4
    2||only|
    3|||9
    4|7||5
    4|||6
    1|3|2
    2|0|1
    3|0|0
    4|1|0
}

test unnest-several-arrays-in-a-view {
    CREATE TABLE unnest_view_source (id int, a int[], b text[]);
    INSERT INTO unnest_view_source VALUES (1, ARRAY[1, 2], ARRAY['x']), (2, ARRAY[3], ARRAY['y', 'z']);
    CREATE VIEW unnest_view AS SELECT id, x, y FROM unnest_view_source, unnest(a, b) AS u(x, y);
    SELECT * FROM unnest_view ORDER BY id, x, y;
}
expect {
    1|1|x
    1|2|
    2|3|y
    2||z
}

test unnest-several-arrays-joined-to-each-other {
    SELECT * FROM unnest(ARRAY[1, 2], ARRAY[3, 4]) AS x(a, b) JOIN unnest(ARRAY[2, 1], ARRAY['two', 'one']) AS y(a, n) USING (a) ORDER BY a;
    SELECT a, b FROM unnest(ARRAY[3, 1, 2], ARRAY['c', 'a', 'b']) AS t(a, b) ORDER BY b DESC LIMIT 2;
}
expect {
    1|3|one
    2|4|two
    3|c
    2|b
}

