test text-functions-read-json-numbers-as-text {
    SELECT pg_input_is_valid('{"a":12}'::json->>'a', 'int4');
    SELECT pg_input_is_valid('{"a":true}'::jsonb->>'a', 'bool');
    SELECT quote_ident('{"a":12}'::json->>'a');
    SELECT '[' || to_char(5, '{"f":9}'::json->>'f') || ']';
}
expect {
    t
    t
    "12"
    [ 5]
}

