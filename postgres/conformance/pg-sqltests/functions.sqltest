@compat-gap "function:age"
test age-converts-a-zone-in-untyped-text-to-utc {
    SELECT age('2026-10-08', '2025-01-01 01:02:03+00:00'),
           age('2026-10-08', '2025-01-01 01:02:03+02:00'),
           age('2026-10-08', '2025-01-01 01:02 -01:30'),
           age('2026-10-08', '2025-01-01 01:02:03Z');
}
expect {
    1 year 9 mons 6 days 22:57:57|1 year 9 mons 7 days 00:57:57|1 year 9 mons 6 days 21:28:00|1 year 9 mons 6 days 22:57:57
}
@sqlstate 0A000
expect @tursopg error {
    type "interval" is not supported, except in a timestamp plus or minus an interval literal, such as now\(\) - interval '7 days'
