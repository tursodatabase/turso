# A NULL argument is not checked against its declared type, because a column
# of a VALUES list is declared integer whatever it holds.
@compat-gap "function:quote_ident"
test quote-ident-integer-null-errors {
    SELECT coalesce(quote_ident(NULL::integer), 'null');
}
@sqlstate 42883
expect error {
    function quote_ident\(integer\) does not exist
}
expect @tursopg {
    null
}

