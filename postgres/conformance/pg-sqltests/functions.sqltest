test check-constraint-calls-a-text-function {
    CREATE TABLE check_schema (s text CHECK (s = current_schema));
    INSERT INTO check_schema VALUES ('public');
    SELECT s FROM check_schema;
}
expect {
    public
}

test check-constraint-calls-an-integer-function {
    CREATE TABLE check_pid (pid int CHECK (pid = pg_backend_pid()));
    INSERT INTO check_pid VALUES (pg_backend_pid());
    SELECT count(*) FROM check_pid;
}
expect {
    1
}

test timestamptz-column-compares-with-now {
    CREATE TABLE events (at timestamptz);
    INSERT INTO events VALUES ('2000-01-01 00:00:00+00:00');
    SELECT count(*) FROM events WHERE at < now();
}
expect {
    1
}

