test pg-get-expr-check-constraint {
    CREATE TABLE checked (val int CHECK (val > 0));
    SELECT pg_get_expr(conbin, conrelid) FROM pg_constraint WHERE contype = 'c' AND conrelid <> 0;
}
expect {
    (val > 0)
}

test pg-get-expr-check-constraint-with-like {
    CREATE TABLE checked (owner text CHECK (owner LIKE 'a%'), code varchar(10) CHECK (code NOT LIKE 'x_'));
    SELECT pg_get_expr(conbin, conrelid) FROM pg_constraint WHERE contype = 'c' AND conrelid <> 0 ORDER BY conname;
}
expect {
    ((code)::text !~~ 'x_'::text)
    (owner ~~ 'a%'::text)
}

test pg-get-expr-check-constraint-with-text-literal {
    CREATE TABLE checked (owner text CHECK (owner <> 'it''s'), code varchar(10) CHECK (code = 'x'));
    SELECT pg_get_expr(conbin, conrelid) FROM pg_constraint WHERE contype = 'c' AND conrelid <> 0 ORDER BY conname;
}
expect {
    ((code)::text = 'x'::text)
    (owner <> 'it''s'::text)
}

test pg-get-expr-check-constraint-with-in-list {
    CREATE TABLE checked (id int CHECK (id IN (1, 2)), owner text CHECK (owner NOT IN ('a', 'b')));
    SELECT pg_get_expr(conbin, conrelid) FROM pg_constraint WHERE contype = 'c' AND conrelid <> 0 ORDER BY conname;
}
expect {
    (id = ANY (ARRAY[1, 2]))
    (owner <> ALL (ARRAY['a'::text, 'b'::text]))
}

test pg-get-expr-check-constraint-on-numeric-column {
    CREATE TABLE checked (price numeric(10, 2) CHECK (price > 0), rate numeric(4, 2) CHECK (rate <= 1.5));
    SELECT pg_get_expr(conbin, conrelid) FROM pg_constraint WHERE contype = 'c' AND conrelid <> 0 ORDER BY conname;
}
expect {
    (price > (0)::numeric)
    (rate <= 1.5)
}

test pg-get-expr-check-constraint-with-lowest-number {
    CREATE TABLE checked (
        id int, big bigint,
        CONSTRAINT a_integer CHECK (id > -2147483648),
        CONSTRAINT b_bigint CHECK (big > -2147483649),
        CONSTRAINT c_lowest_bigint CHECK (big > -9223372036854775808),
        CONSTRAINT d_zero CHECK (id > -0)
    );
    SELECT pg_get_expr(conbin, conrelid) FROM pg_constraint WHERE contype = 'c' AND conrelid <> 0 ORDER BY conname;
}
expect {
    (id > '-2147483648'::integer)
    (big > '-2147483649'::bigint)
    (big > '-9223372036854775808'::bigint)
    (id > 0)
}

test pg-get-expr-check-constraint-with-negative-zero-decimal {
    CREATE TABLE checked (
        price numeric(10, 2),
        CONSTRAINT a_zero CHECK (price > -0.0),
        CONSTRAINT b_two_places CHECK (price > -0.00),
        CONSTRAINT c_not_zero CHECK (price > -0.10)
    );
    SELECT pg_get_expr(conbin, conrelid) FROM pg_constraint WHERE contype = 'c' AND conrelid <> 0 ORDER BY conname;
}
expect {
    (price > 0.0)
    (price > 0.00)
    (price > '-0.10'::numeric)
}

test pg-get-expr-check-constraint-on-several-columns {
    CREATE TABLE checked (
        low int, high int, done boolean, note text,
        CONSTRAINT a_range CHECK (low >= 0 AND low < high),
        CONSTRAINT b_between CHECK (high BETWEEN 1 AND 100),
        CONSTRAINT c_flag CHECK (done),
        CONSTRAINT d_note CHECK (note IS NOT NULL OR NOT done)
    );
    SELECT pg_get_expr(conbin, conrelid) FROM pg_constraint WHERE contype = 'c' AND conrelid <> 0 ORDER BY conname;
}
expect {
    ((low >= 0) AND (low < high))
    ((high >= 1) AND (high <= 100))
    done
    ((note IS NOT NULL) OR (NOT done))
}

# tursopg does not print the casts of the || operator and shows the condition
# as the engine stores it.
@compat-gap "function:pg_get_expr"
test pg-get-expr-check-constraint-with-concatenation {
    CREATE TABLE checked (owner text CHECK (owner || 'x' <> 'ax'));
    SELECT pg_get_expr(conbin, conrelid) FROM pg_constraint WHERE contype = 'c' AND conrelid <> 0;
}
expect {
    ((owner || 'x'::text) <> 'ax'::text)
}
expect @tursopg {
    (owner || 'x') != 'ax'
}

test percentile-cont-within-group {
    CREATE TABLE demo (value int);
    INSERT INTO demo (value) VALUES (1), (2);
    SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY value) FROM demo;
}
expect {
    1.5
}

test mode-within-group {
    CREATE TABLE demo (value int);
    INSERT INTO demo VALUES (2), (2), (1), (1);
    SELECT mode() WITHIN GROUP (ORDER BY value) FROM demo;
}
expect {
    1
}

test within-group-skips-nulls-with-any-null-order {
    CREATE TABLE demo (value int);
    INSERT INTO demo VALUES (1), (NULL), (2), (2);
    SELECT percentile_cont(0.25) WITHIN GROUP (ORDER BY value) FROM demo;
    SELECT percentile_disc(0) WITHIN GROUP (ORDER BY value NULLS FIRST) FROM demo;
    SELECT mode() WITHIN GROUP (ORDER BY value NULLS LAST) FROM demo;
}
expect {
    1.5
    1
    2
}

# PostgreSQL has no oid column on user tables; tursopg reads oid as the rowid.
# Both must reject a fraction that reads it, without stopping the server.
test percentile-disc-fraction-reads-oid {
    CREATE TABLE demo (value int);
    INSERT INTO demo VALUES (1);
    SELECT percentile_disc(oid) WITHIN GROUP (ORDER BY value) FROM demo;
}
expect error {}

test percentile-cont-fraction-reads-oid {
    CREATE TABLE demo (value int);
    INSERT INTO demo VALUES (1);
    SELECT percentile_cont(oid) WITHIN GROUP (ORDER BY value) FROM demo;
}
expect error {}

test percentile-disc-fraction-reads-rowid {
    CREATE TABLE demo (value int);
    INSERT INTO demo VALUES (1);
    SELECT percentile_disc(rowid) WITHIN GROUP (ORDER BY value) FROM demo;
}
expect error {}

test percentile-disc-fraction-reads-qualified-oid-of-empty-table {
    CREATE TABLE demo (value int);
    SELECT percentile_disc(demo.oid) WITHIN GROUP (ORDER BY value) FROM demo;
}
expect error {}

test percentile-disc-fraction-compares-oid-in-insert-select {
    CREATE TABLE demo (value int);
    CREATE TABLE result (x float8);
    INSERT INTO demo VALUES (1);
    INSERT INTO result SELECT percentile_disc(oid = 1) WITHIN GROUP (ORDER BY value) FROM demo;
}
expect error {}

test acldefault-object-kinds {
    SELECT pg_catalog.acldefault('c', 4294967294);
    SELECT acldefault('r', 4294967294);
    SELECT acldefault('s', 4294967294);
    SELECT acldefault('d', 4294967294);
    SELECT acldefault('f', 4294967294);
    SELECT acldefault('l', 4294967294);
    SELECT acldefault('L', 4294967294);
    SELECT acldefault('n', 4294967294);
    SELECT acldefault('p', 4294967294);
    SELECT acldefault('t', 4294967294);
    SELECT acldefault('F', 4294967294);
    SELECT acldefault('S', 4294967294);
    SELECT acldefault('T', 4294967294);
}
expect {
    {}
    {4294967294=arwdDxtm/4294967294}
    {4294967294=rwU/4294967294}
    {=Tc/4294967294,4294967294=CTc/4294967294}
    {=X/4294967294,4294967294=X/4294967294}
    {=U/4294967294,4294967294=U/4294967294}
    {4294967294=rw/4294967294}
    {4294967294=UC/4294967294}
    {4294967294=sA/4294967294}
    {4294967294=C/4294967294}
    {4294967294=U/4294967294}
    {4294967294=U/4294967294}
    {=U/4294967294,4294967294=U/4294967294}
}

test acldefault-catalog-owner {
    SET search_path TO '';
    SELECT n.tableoid, n.oid, n.nspname,
           replace(acldefault('n', n.nspowner)::text,
                   pg_get_userbyid(n.nspowner), 'owner')
    FROM pg_namespace n WHERE n.nspname = 'public';
}
expect {
    2615|2200|public|{owner=UC/owner}
}

test acldefault-first-byte-selects-object-kind {
