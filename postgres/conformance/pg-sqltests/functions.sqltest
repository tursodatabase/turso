# Scalar function behavior through the PostgreSQL frontend.
#
# Coverage here asserts behavior that real PostgreSQL also exhibits, so the
# corpus is valid for differential runs against a stock server.
# Server-specific outputs (version(), current_database(), pg_backend_pid())
# are covered in postgres/tests/integration instead.

@database :memory:

test quote-ident-plain-lowercase {
    SELECT quote_ident('abc');
}
expect {
    abc
}

test quote-ident-underscore-and-digits {
    SELECT quote_ident('a_1');
}
expect {
    a_1
}

test quote-ident-mixed-case {
    SELECT quote_ident('Abc');
}
expect {
    "Abc"
}

test quote-ident-embedded-space {
    SELECT quote_ident('a b');
}
expect {
    "a b"
}

test quote-ident-embedded-quote-doubled {
    SELECT quote_ident('a"b');
}
expect {
    "a""b"
}

test quote-ident-reserved-keyword {
    SELECT quote_ident('select');
}
expect {
    "select"
}

test quote-ident-unreserved-keyword-unquoted {
    SELECT quote_ident('commit');
}
expect {
    commit
}

test quote-ident-col-name-keyword {
    SELECT quote_ident('between');
}
expect {
    "between"
}

test quote-ident-type-func-name-keyword {
    SELECT quote_ident('binary');
}
expect {
    "binary"
}

test quote-ident-empty-string {
    SELECT quote_ident('');
}
expect {
    ""
}

test quote-ident-leading-digit {
    SELECT quote_ident('1a');
}
expect {
    "1a"
}

test quote-ident-null-is-null {
    SELECT quote_ident(NULL);
}
expect {
}

test quote-literal-plain {
    SELECT quote_literal('abc');
}
expect {
    'abc'
}

test quote-literal-embedded-quote {
    SELECT quote_literal('O''Reilly');
}
expect {
    'O''Reilly'
}

test quote-literal-integer {
    SELECT quote_literal(42);
}
expect {
    '42'
}

test quote-literal-null-is-null {
    SELECT quote_literal(NULL);
}
expect {
}

# The sqltest lexer collapses \\ to \, so the expected E'a\\b' is written
# with doubled backslashes here.
test quote-literal-backslash-uses-escape-string {
    SELECT quote_literal('a\b');
}
expect {
    E'a\\\\b'
}

test current-schema-default {
    SELECT current_schema();
}
expect {
    public
}

test current-schema-bare-keyword {
    SELECT current_schema;
}
expect {
    public
}

test current-schema-in-from-position {
    SELECT * FROM current_schema();
}
expect {
    public
}

test obj-description-unknown-oid-is-null {
    SELECT obj_description(0, 'pg_class');
}
expect {
}

test col-description-unknown-oid-is-null {
    SELECT col_description(0, 1);
}
expect {
}

test version-wrong-arity-errors {
    SELECT version(1);
}
expect error {}

test quote-ident-wrong-arity-errors {
    SELECT quote_ident();
}
expect error {}

test md5-text {
    SELECT md5('abc');
}
expect {
    900150983cd24fb0d6963f7d28e17f72
}

test md5-empty-string {
    SELECT md5('');
}
expect {
    d41d8cd98f00b204e9800998ecf8427e
}

test split-part-basic {
    SELECT split_part('abc~@~def~@~ghi', '~@~', 2);
}
expect {
    def
}

test split-part-negative-counts-from-end {
    SELECT split_part('abc,def,ghi', ',', -1);
}
expect {
    ghi
}

test split-part-out-of-range-is-empty {
    SELECT split_part('abc,def', ',', 5);
}
expect {
}

test split-part-zero-position-errors {
    SELECT split_part('abc,def', ',', 0);
}
expect error {
    field position must not be zero
}

test initcap-mixed-case-words {
    SELECT initcap('hi THOMAS');
}
expect {
    Hi Thomas
}

test initcap-word-boundary-is-non-alphanumeric {
    SELECT initcap('foo-bar_baz 2nd');
}
expect {
    Foo-Bar_Baz 2nd
}

test left-and-right-positive {
    SELECT left('abcde', 2), right('abcde', 2);
}
expect {
    ab|de
}

test left-and-right-negative-drop-from-other-end {
    SELECT left('abcde', -2), right('abcde', -2);
}
expect {
    abc|cde
}

test left-count-past-length-keeps-all {
    SELECT left('ab', 5), right('ab', 5);
}
expect {
    ab|ab
}

test regexp-replace-first-match-only-by-default {
    SELECT regexp_replace('foobarbaz', 'b..', 'X');
}
expect {
    fooXbaz
}

test regexp-replace-global-flag {
    SELECT regexp_replace('foobarbaz', 'b..', 'X', 'g');
}
expect {
    fooXX
}

test regexp-replace-backreference {
    SELECT regexp_replace('foobarbaz', 'b(..)', 'X\1Y', 'g');
}
expect {
    fooXarYXazY
}

test regexp-replace-case-insensitive-flag {
    SELECT regexp_replace('ABC', 'a', 'x', 'i');
}
expect {
    xBC
}

test regexp-replace-invalid-pattern-errors {
    SELECT regexp_replace('x', '(', 'y');
}
expect error {
    invalid regular expression
}

test regexp-replace-invalid-flag-errors {
    SELECT regexp_replace('x', 'x', 'y', 'z');
}
expect error {
    invalid regular expression option
}

test pg-typeof-integer-and-text {
    SELECT pg_typeof(1), pg_typeof('x'::text);
}
expect {
    integer|text
}

test encode-hex {
    SELECT encode('abc', 'hex');
}
expect {
    616263
}

test encode-base64 {
    SELECT encode('abc', 'base64');
}
expect {
    YWJj
}

test encode-decode-hex-roundtrip {
    SELECT encode(decode('616263', 'hex'), 'hex');
}
expect {
    616263
}

test encode-decode-base64-roundtrip {
    SELECT encode(decode('YWJj', 'base64'), 'hex');
}
expect {
    616263
}

test encode-unknown-format-errors {
    SELECT encode('abc', 'bogus');
}
expect error {
    unrecognized encoding
}

test decode-invalid-hex-errors {
    SELECT decode('61626', 'hex');
}
expect error {}

test scalar-functions-are-strict {
    SELECT coalesce(md5(NULL), 'null'), coalesce(left(NULL, 1), 'null'),
           coalesce(split_part(NULL, ',', 1), 'null'), coalesce(regexp_replace(NULL, 'x', 'y'), 'null');
}
expect {
    null|null|null|null
}

test regexp-match-whole-match-when-no-groups {
    SELECT regexp_match('foobarbequebaz', 'bar.*que');
}
expect {
    {barbeque}
}

test regexp-match-returns-capture-groups {
    SELECT regexp_match('foobarbequebaz', '(b[^b]+)(b[^b]+)');
}
expect {
    {bar,beque}
}

test regexp-match-no-match-is-null {
    SELECT coalesce(regexp_match('foo', 'z')::text, 'null');
}
expect {
    null
}

test regexp-match-case-insensitive-flag {
    SELECT regexp_match('FOO', 'o+', 'i');
}
expect {
    {OO}
}

test regexp-match-global-flag-errors {
    SELECT regexp_match('foo', 'o', 'g');
}
expect error {
    does not support the "global" option
}

test regexp-split-to-array-basic {
    SELECT regexp_split_to_array('hello world foo', '\s+');
}
expect {
    {hello,world,foo}
}

test regexp-split-to-array-no-match-keeps-whole {
    SELECT regexp_split_to_array('abc', ',');
}
expect {
    {abc}
}

test regexp-split-to-array-element-access {
    SELECT (regexp_split_to_array('a,b,c', ','))[2];
}
expect {
    b
}

test regexp-split-to-array-case-insensitive {
    SELECT regexp_split_to_array('aXbxc', 'x', 'i');
}
expect {
    {a,b,c}
}

test regexp-match-invalid-pattern-errors {
    SELECT regexp_match('x', '(');
}
expect error {
    invalid regular expression
}

# bool_and/bool_or results are cast to int because bare boolean output
# rendering (t/f) is not implemented yet; the int form matches PostgreSQL.
test bool-and-bool-or-per-group {
    CREATE TABLE boolagg (g int, x boolean);
    INSERT INTO boolagg VALUES (1, true), (1, true), (2, true), (2, false), (3, NULL);
    SELECT g, bool_and(x)::int, bool_or(x)::int FROM boolagg GROUP BY g ORDER BY g;
}
expect {
    1|1|1
    2|0|1
    3||
}

test every-is-bool-and {
    CREATE TABLE boolagg (g int, x boolean);
    INSERT INTO boolagg VALUES (2, true), (2, false);
    SELECT every(x)::int FROM boolagg WHERE g = 2;
}
expect {
    0
}

test bool-and-skips-nulls {
    CREATE TABLE boolagg (g int, x boolean);
    INSERT INTO boolagg VALUES (4, true), (4, NULL);
    SELECT bool_and(x)::int, bool_or(x)::int FROM boolagg WHERE g = 4;
}
expect {
    1|1
}

test bool-and-empty-input-is-null {
    CREATE TABLE boolagg (g int, x boolean);
    SELECT coalesce(bool_and(x)::int::text, 'null') FROM boolagg WHERE g = 99;
}
expect {
    null
}

test bool-and-as-window-function {
    CREATE TABLE boolagg (g int, x boolean);
    INSERT INTO boolagg VALUES (1, true), (1, true), (2, true), (2, false);
    SELECT g, bool_and(x) OVER (PARTITION BY g)::int FROM boolagg ORDER BY g, x;
}
expect {
    1|1
    1|1
    2|0
    2|0
}

test bool-and-wrong-arity-errors {
    CREATE TABLE boolagg (g int, x boolean);
    SELECT bool_and(x, x) FROM boolagg;
}
expect error {}

# Variance/stddev tests pick inputs with terminating-decimal answers so the
# expectations do not depend on float formatting width, which still differs
# from PostgreSQL (extra_float_digits handling is a separate work item).
test var-samp-and-var-pop {
    CREATE TABLE vartab (x float8);
    INSERT INTO vartab VALUES (1), (2);
    SELECT var_samp(x), var_pop(x), stddev_pop(x) FROM vartab;
}
expect {
    0.5|0.25|0.5
}

test stddev-samp-rounded {
    CREATE TABLE vartab (x float8);
    INSERT INTO vartab VALUES (1), (2);
    SELECT round(stddev_samp(x) * 1000)::int FROM vartab;
}
expect {
    707
}

test variance-and-stddev-are-sample-aliases {
    CREATE TABLE vartab (x float8);
    INSERT INTO vartab VALUES (3), (5), (9);
    SELECT (variance(x) = var_samp(x))::int, (stddev(x) = stddev_samp(x))::int FROM vartab;
}
expect {
    1|1
}

test var-samp-single-row-is-null-var-pop-zero {
    CREATE TABLE vartab (x float8);
    INSERT INTO vartab VALUES (7);
    SELECT coalesce(var_samp(x)::text, 'null'), var_pop(x)::int FROM vartab;
}
expect {
    null|0
}

test variance-empty-input-is-null {
    CREATE TABLE vartab (x float8);
    SELECT coalesce(variance(x)::text, 'null') FROM vartab;
}
expect {
    null
}

test variance-skips-nulls {
    CREATE TABLE vartab (x float8);
    INSERT INTO vartab VALUES (1), (2), (NULL);
    SELECT var_samp(x), var_pop(x) FROM vartab;
}
expect {
    0.5|0.25
}

test stddev-pop-as-window-function {
    CREATE TABLE vartab (g int, x float8);
    INSERT INTO vartab VALUES (1, 1), (1, 2), (2, 5);
    SELECT g, stddev_pop(x) OVER (PARTITION BY g) FROM vartab ORDER BY g, x;
}
expect {
    1|0.5
    1|0.5
    2|0
}

test random-is-a-unit-interval-double {
    SELECT (random() >= 0 AND random() < 1)::int, floor(random())::int, pg_typeof(random());
}
expect {
    1|0|double precision
}

test random-draws-independently-per-call {
    SELECT (random() <> random())::int;
}
expect {
    1
}

test random-draws-per-row {
    CREATE TABLE rnd (i int);
    INSERT INTO rnd VALUES (1), (2), (3);
    SELECT count(DISTINCT random()) FROM rnd;
}
expect {
    3
}

test setseed-accepts-unit-range {
    SELECT setseed(0.5);
}
expect {
}

test setseed-out-of-range-errors {
    SELECT setseed(1.5);
}
expect error {
    out of allowed range
}
