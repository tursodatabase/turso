# Scalar function behavior through the PostgreSQL frontend.
#
# Coverage here asserts behavior that real PostgreSQL also exhibits, so the
# corpus is valid for differential runs against a stock server.
# Server-specific outputs (version(), current_database(), pg_backend_pid())
# are covered in postgres/tests/integration instead.

@database :memory:

test quote-ident-plain-lowercase {
    SELECT quote_ident('abc');
}
expect {
    abc
}

test quote-ident-underscore-and-digits {
    SELECT quote_ident('a_1');
}
expect {
    a_1
}

test quote-ident-mixed-case {
    SELECT quote_ident('Abc');
}
expect {
    "Abc"
}

test quote-ident-embedded-space {
    SELECT quote_ident('a b');
}
expect {
    "a b"
}

test quote-ident-embedded-quote-doubled {
    SELECT quote_ident('a"b');
}
expect {
    "a""b"
}

test quote-ident-reserved-keyword {
    SELECT quote_ident('select');
}
expect {
    "select"
}

test quote-ident-unreserved-keyword-unquoted {
    SELECT quote_ident('commit');
}
expect {
    commit
}

test quote-ident-col-name-keyword {
    SELECT quote_ident('between');
}
expect {
    "between"
}

test quote-ident-type-func-name-keyword {
    SELECT quote_ident('binary');
}
expect {
    "binary"
}

test quote-ident-empty-string {
    SELECT quote_ident('');
}
expect {
    ""
}

test quote-ident-leading-digit {
    SELECT quote_ident('1a');
}
expect {
    "1a"
}

test quote-ident-null-is-null {
    SELECT quote_ident(NULL);
}
expect {
}

test quote-literal-plain {
    SELECT quote_literal('abc');
}
expect {
    'abc'
}

test quote-literal-embedded-quote {
    SELECT quote_literal('O''Reilly');
}
expect {
    'O''Reilly'
}

test quote-literal-integer {
    SELECT quote_literal(42);
}
expect {
    '42'
}

test quote-literal-null-is-null {
    SELECT quote_literal(NULL);
}
expect {
}

# The sqltest lexer collapses \\ to \, so the expected E'a\\b' is written
# with doubled backslashes here.
test quote-literal-backslash-uses-escape-string {
    SELECT quote_literal('a\b');
}
expect {
    E'a\\\\b'
}

test current-schema-default {
    SELECT current_schema();
}
expect {
    public
}

test current-schema-bare-keyword {
    SELECT current_schema;
}
expect {
    public
}

test current-schema-in-from-position {
    SELECT * FROM current_schema();
}
expect {
    public
}

test current-setting-default-search-path {
    SELECT current_setting('search_path');
    SELECT pg_catalog.current_setting('SEARCH_PATH');
    SELECT current_setting('Search_Path', false);
    SELECT current_setting('search_path', true);
}
expect {
    "$user", public
    "$user", public
    "$user", public
    "$user", public
}

test current-setting-reads-set-config {
    SELECT quote_literal(set_config('search_path', ' "My,Schema", PUBLIC ', false));
    SELECT quote_literal(current_setting('search_path'));
    SELECT quote_literal(set_config('search_path', '', false));
    SELECT quote_literal(current_setting('search_path'));
    SELECT set_config('search_path', NULL, false);
    SELECT current_setting('search_path');
}
expect {
    ' "My,Schema", PUBLIC '
    ' "My,Schema", PUBLIC '
    ''
    ''
    "$user", public
    "$user", public
}

test current-setting-reads-set {
    SET search_path TO "My,Schema", PUBLIC;
    SELECT current_setting('search_path');
    SET search_path TO '';
    SELECT current_setting('search_path');
}
expect {
    "My,Schema", public
    ""
}

test current-setting-sees-set-config-of-the-same-row {
    CREATE TABLE setting_rows (x int);
    INSERT INTO setting_rows VALUES (1), (2), (3);
    SELECT set_config('search_path', 'v' || x, false), current_setting('search_path')
    FROM setting_rows;
    SELECT current_setting('search_path'), set_config('search_path', 'last', false);
    SELECT current_setting('search_path');
}
expect {
    v1|v1
    v2|v2
    v3|v3
    v3|last
    last
}

test current-setting-matches-pg-settings {
    SET search_path TO public;
    SELECT s.name, current_setting(s.name), s.setting
    FROM pg_catalog.pg_settings s WHERE s.name = 'search_path';
}
expect {
    search_path|public|public
}

test current-setting-takes-arguments-from-rows {
    CREATE TABLE setting_names (id int, name text, missing_ok boolean);
    INSERT INTO setting_names VALUES
        (1, 'search_path', false), (2, 'no_such_setting', true),
        (3, NULL, false), (4, 'search_path', NULL);
    SELECT id, coalesce(current_setting(name, missing_ok), '<null>')
    FROM setting_names ORDER BY id;
}
expect {
    1|"$user", public
    2|<null>
    3|<null>
    4|<null>
}

test current-setting-null-arguments-return-null {
    SELECT coalesce(current_setting(NULL), '<null>');
    SELECT coalesce(current_setting(NULL, true), '<null>');
    SELECT coalesce(current_setting('search_path', NULL), '<null>');
    SELECT coalesce(current_setting('no_such_setting', NULL), '<null>');
}
expect {
    <null>
    <null>
    <null>
    <null>
}

test current-setting-missing-ok-returns-null-for-unknown-parameters {
    SELECT coalesce(current_setting('no_such_setting', true), '<null>');
    SELECT coalesce(current_setting('nosuch.setting', true), '<null>');
    SELECT coalesce(current_setting('', true), '<null>');
}
expect {
    <null>
    <null>
    <null>
}

test current-setting-unknown-parameter-errors {
    SELECT current_setting('no_such_setting');
}
@sqlstate 42704
expect error {
    unrecognized configuration parameter "no_such_setting"
}

test current-setting-unknown-parameter-without-missing-ok-errors {
    SELECT current_setting('no_such_setting', false);
}
@sqlstate 42704
expect error {
    unrecognized configuration parameter "no_such_setting"
}

test current-setting-does-not-trim-the-parameter-name {
    SELECT current_setting('search_path ');
}
@sqlstate 42704
expect error {
    unrecognized configuration parameter "search_path "
}

test current-setting-integer-parameter-name-errors {
    SELECT current_setting(5);
}
@sqlstate 42883
expect error {}

test current-setting-text-missing-ok-errors {
    SELECT current_setting('search_path', 'x');
}
@sqlstate 22P02
expect error {}

test current-setting-missing-ok-accepts-boolean-text {
    SELECT coalesce(current_setting('no_such_setting', 'yes'), '<null>');
    SELECT coalesce(current_setting('no_such_setting', ' TRUE '), '<null>');
}
expect {
    <null>
    <null>
}

test current-setting-missing-ok-false-text-errors {
    SELECT current_setting('no_such_setting', ' Off ');
}
@sqlstate 42704
expect error {
    unrecognized configuration parameter "no_such_setting"
}

test current-setting-numeric-parameter-name-errors {
    SELECT current_setting(5.5);
}
@sqlstate 42883
expect error {
    function current_setting\(numeric\) does not exist
}

test current-setting-without-arguments-errors {
    SELECT current_setting();
}
@sqlstate 42883
expect error {}

test current-setting-with-three-arguments-errors {
    SELECT current_setting('search_path', true, true);
}
@sqlstate 42883
expect error {}

test set-config-custom-parameter {
    SELECT set_config('app.user_id', '42', false);
    SELECT current_setting('app.user_id');
    SELECT current_setting('APP.User_Id');
    SELECT current_setting('app.user_id', true);
}
expect {
    42
    42
    42
    42
}

test set-config-custom-parameter-names {
    SELECT set_config('a.b.c', 'three parts', false);
    SELECT set_config('_a._b', 'underscores', false);
    SELECT set_config('app.x1$', 'digit and dollar', false);
    SELECT set_config('é.ü', 'not ASCII', false);
    SELECT current_setting('A.B.C'), current_setting('_A._B'), current_setting('APP.X1$'), current_setting('é.ü');
}
expect {
    three parts
    underscores
    digit and dollar
    not ASCII
    three parts|underscores|digit and dollar|not ASCII
}

test set-config-custom-parameter-name-is-not-case-sensitive-when-set {
    SELECT set_config('APP.Mixed_Case', 'v', false);
    SELECT current_setting('app.mixed_case');
}
expect {
    v
    v
}

test custom-parameter-name-ignores-only-the-case-of-ascii-letters {
    SELECT set_config('app.é', 'lower', false);
    SELECT current_setting('APP.é');
    SELECT coalesce(current_setting('app.É', true), '<null>');
}
expect {
    lower
    lower
    <null>
}

test current-setting-undefined-custom-parameter-errors {
    SELECT current_setting('app.never_set');
}
@sqlstate 42704
expect error {
    unrecognized configuration parameter "app\.never_set"
}

test set-config-custom-parameter-null-value-resets-it {
    SELECT set_config('app.reset_me', 'v', false);
    SELECT quote_literal(set_config('app.reset_me', NULL, false));
    SELECT quote_literal(current_setting('app.reset_me'));
    SELECT quote_literal(current_setting('app.reset_me', true));
}
expect {
    v
    ''
    ''
    ''
}

test set-config-custom-parameter-name-with-an-empty-part-errors {
    SELECT set_config('app..user_id', 'v', false);
}
@sqlstate 42602
expect error {
    invalid configuration parameter name "app\.\.user_id"
}

test set-config-custom-parameter-name-with-a-trailing-dot-errors {
    SELECT set_config('app.', 'v', false);
}
@sqlstate 42602
expect error {
    invalid configuration parameter name "app\."
}

test set-config-custom-parameter-name-with-a-leading-digit-errors {
    SELECT set_config('app.1user', 'v', false);
}
@sqlstate 42602
expect error {
    invalid configuration parameter name "app\.1user"
}

test set-config-custom-parameter-name-with-a-space-errors {
    SELECT set_config('app.user id', 'v', false);
}
@sqlstate 42602
expect error {
    invalid configuration parameter name "app\.user id"
}

test set-config-unknown-parameter-without-a-dot-errors {
    SELECT set_config('no_such_setting', 'v', false);
}
@sqlstate 42704
expect error {
    unrecognized configuration parameter "no_such_setting"
}

test set-config-local-custom-parameter-in-one-statement {
    SELECT set_config('app.tx_value', 'local', true), current_setting('app.tx_value');
}
expect {
    local|local
}

test set-config-local-custom-parameter-ends-with-its-statement-outside-a-transaction {
    SELECT set_config('app.autocommit_local', 'local', true);
    SELECT quote_literal(current_setting('app.autocommit_local'));
}
expect {
    local
    ''
}

test set-config-local-custom-parameter-ends-at-commit {
    BEGIN;
    SELECT set_config('app.tx_value', 'local', true);
    SELECT current_setting('app.tx_value');
    COMMIT;
    SELECT quote_literal(current_setting('app.tx_value'));
    SELECT quote_literal(current_setting('app.tx_value', true));
}
expect {
    local
    local
    ''
    ''
}

test set-config-local-custom-parameter-ends-at-rollback {
    BEGIN;
    SELECT set_config('app.tx_value', 'local', true);
    ROLLBACK;
    SELECT quote_literal(current_setting('app.tx_value'));
}
expect {
    local
    ''
}

test set-config-local-custom-parameter-hides-the-session-value {
    BEGIN;
    SELECT set_config('app.mode', 'session', false);
    COMMIT;
    BEGIN;
    SELECT set_config('app.mode', 'local', true);
    SELECT current_setting('app.mode');
    COMMIT;
    SELECT current_setting('app.mode');
    BEGIN;
    SELECT set_config('app.mode', 'local', true);
    ROLLBACK;
    SELECT current_setting('app.mode');
}
expect {
    session
    local
    local
    session
    local
    session
}

test set-config-session-value-stays-after-a-later-local-value-ends {
    BEGIN;
    SELECT set_config('app.mode', 'session', false);
    SELECT set_config('app.mode', 'local', true);
    SELECT current_setting('app.mode');
    COMMIT;
    SELECT current_setting('app.mode');
}
expect {
    session
    local
    local
    session
}

test set-config-session-value-replaces-a-local-value {
    BEGIN;
    SELECT set_config('app.mode', 'local', true);
    SELECT set_config('app.mode', 'session', false);
    COMMIT;
    SELECT current_setting('app.mode');
}
expect {
    local
    session
    session
}

test set-config-rollback-undoes-a-session-value {
    BEGIN;
    SELECT set_config('app.rb_value', 'before', false);
    COMMIT;
    BEGIN;
    SELECT set_config('app.rb_value', 'in transaction', false);
    ROLLBACK;
    SELECT current_setting('app.rb_value');
}
expect {
    before
    in transaction
    before
}

test set-config-custom-parameter-stays-defined-after-rollback {
    BEGIN;
    SELECT set_config('app.rb_new', 'x', false);
    ROLLBACK;
    SELECT quote_literal(current_setting('app.rb_new'));
}
expect {
    x
    ''
}

test set-config-rollback-to-savepoint-undoes-later-values {
    BEGIN;
    SELECT set_config('app.sp_value', 'before savepoint', false);
    SAVEPOINT s;
    SELECT set_config('app.sp_value', 'after savepoint', false);
    SELECT set_config('app.sp_local', 'local', true);
    ROLLBACK TO SAVEPOINT s;
    SELECT current_setting('app.sp_value'), quote_literal(current_setting('app.sp_local'));
    COMMIT;
    SELECT current_setting('app.sp_value');
}
expect {
    before savepoint
    after savepoint
    local
    before savepoint|''
    before savepoint
}

test set-config-release-savepoint-keeps-values {
    BEGIN;
    SAVEPOINT s;
    SELECT set_config('app.rel_session', 'session', false);
    SELECT set_config('app.rel_local', 'local', true);
    RELEASE SAVEPOINT s;
    SELECT current_setting('app.rel_session'), current_setting('app.rel_local');
    COMMIT;
    SELECT current_setting('app.rel_session'), quote_literal(current_setting('app.rel_local'));
}
expect {
    session
    local
    session|local
    session|''
}

test set-config-rollback-undoes-values-of-a-released-savepoint {
    BEGIN;
    SAVEPOINT s;
    SELECT set_config('app.rel_rb', 'released', false);
    RELEASE SAVEPOINT s;
    ROLLBACK;
    SELECT quote_literal(current_setting('app.rel_rb'));
}
expect {
    released
    ''
}

test set-config-rollback-to-an-outer-savepoint {
    BEGIN;
    SELECT set_config('app.nested', 'outer', false);
    SAVEPOINT a;
    SELECT set_config('app.nested', 'a', false);
    SAVEPOINT b;
    SELECT set_config('app.nested', 'b', true);
    ROLLBACK TO SAVEPOINT a;
    SELECT current_setting('app.nested');
    COMMIT;
    SELECT current_setting('app.nested');
}
expect {
    outer
    a
    b
    outer
    outer
}

