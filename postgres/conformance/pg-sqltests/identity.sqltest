# Identity columns (GENERATED BY DEFAULT / GENERATED ALWAYS AS IDENTITY).

@database :memory:

test by-default-identity-gets-sequence-value {
    DROP TABLE IF EXISTS orders;
    CREATE TABLE orders (id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, label text);
    INSERT INTO orders (label) VALUES ('first');
    INSERT INTO orders (label) VALUES ('second');
    SELECT id, label FROM orders ORDER BY id;
}
expect {
    1|first
    2|second
}

test by-default-identity-allows-explicit-value {
    DROP TABLE IF EXISTS orders;
    CREATE TABLE orders (id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, label text);
    INSERT INTO orders (id, label) VALUES (100, 'explicit');
    SELECT id, label FROM orders;
}
expect {
    100|explicit
}

test always-identity-rejects-explicit-value {
    DROP TABLE IF EXISTS orders;
    CREATE TABLE orders (id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY);
    INSERT INTO orders (id) VALUES (1);
}
expect error {
    cannot insert a non-DEFAULT value into column "id"
}

test always-identity-gets-sequence-value {
    DROP TABLE IF EXISTS orders;
    CREATE TABLE orders (id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY, label text);
    INSERT INTO orders (label) VALUES ('a');
    INSERT INTO orders (label) VALUES ('b');
    SELECT id, label FROM orders ORDER BY id;
}
expect {
    1|a
    2|b
}

test supabase-default-pk-pattern {
    DROP TABLE IF EXISTS profiles;
    CREATE TABLE profiles (id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, name text);
    INSERT INTO profiles (name) VALUES ('Alice');
    INSERT INTO profiles (name) VALUES ('Bob');
    SELECT id, name FROM profiles ORDER BY id;
}
expect {
    1|Alice
    2|Bob
}

test always-identity-rejects-explicit-value-after-add-column {
    DROP TABLE IF EXISTS orders;
    CREATE TABLE orders (id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY, label text);
    ALTER TABLE orders ADD COLUMN note text;
    INSERT INTO orders (id, label) VALUES (1, 'x');
}
expect error {
    cannot insert a non-DEFAULT value into column "id"
}

test always-identity-rejects-explicit-value-after-rename-column {
    DROP TABLE IF EXISTS orders;
    CREATE TABLE orders (id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY, label text);
    ALTER TABLE orders RENAME COLUMN label TO title;
    INSERT INTO orders (id, title) VALUES (1, 'x');
}
expect error {
    cannot insert a non-DEFAULT value into column "id"
}

test always-identity-accepts-default-keyword-in-insert {
    DROP TABLE IF EXISTS orders;
    CREATE TABLE orders (id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY, label text);
    INSERT INTO orders (id, label) VALUES (DEFAULT, 'x');
    SELECT id, label FROM orders;
}
expect {
    1|x
}

test always-identity-rejects-explicit-value-in-update {
    DROP TABLE IF EXISTS orders;
    CREATE TABLE orders (id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY, label text);
    UPDATE orders SET id = 5;
}
expect error {
    column "id" can only be updated to DEFAULT
}

test always-identity-accepts-default-keyword-in-update {
    DROP TABLE IF EXISTS orders;
    CREATE TABLE orders (id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY, label text);
    INSERT INTO orders (label) VALUES ('a'), ('b'), ('c');
    UPDATE orders SET id = DEFAULT WHERE label = 'a';
    UPDATE orders SET id = DEFAULT, label = 'd' WHERE label = 'b';
    SELECT id, label FROM orders ORDER BY id;
}
expect {
    3|c
    4|a
    5|d
}

test always-identity-rejects-explicit-value-after-fk-referenced-column-rename {
    DROP TABLE IF EXISTS child;
    DROP TABLE IF EXISTS parent;
    CREATE TABLE parent (id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY, label text);
    CREATE TABLE child (pid bigint REFERENCES parent(id));
    ALTER TABLE parent RENAME COLUMN id TO key;
    INSERT INTO parent (key, label) VALUES (1, 'x');
}
expect error {
    cannot insert a non-DEFAULT value into column "key"
}

test always-identity-accepts-default-keyword-in-on-conflict-update {
    DROP TABLE IF EXISTS orders;
    CREATE TABLE orders (id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY, label text UNIQUE);
    INSERT INTO orders (label) VALUES ('x');
    INSERT INTO orders (label) VALUES ('x') ON CONFLICT (label) DO UPDATE SET id = DEFAULT;
    SELECT id, label FROM orders;
}
expect {
    3|x
}

test always-identity-rejects-explicit-value-in-on-conflict-update {
    DROP TABLE IF EXISTS orders;
    CREATE TABLE orders (id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY, label text UNIQUE);
    INSERT INTO orders (label) VALUES ('x');
    INSERT INTO orders (label) VALUES ('x') ON CONFLICT (label) DO UPDATE SET id = 5;
}
expect error {
    column "id" can only be updated to DEFAULT
}

test always-identity-explicit-insert-sqlstate {
    DROP TABLE IF EXISTS sq_ia;
    CREATE TABLE sq_ia (id bigint GENERATED ALWAYS AS IDENTITY, v text);
    INSERT INTO sq_ia (id, v) VALUES (1, 'x');
}
@sqlstate 428C9
expect error {}

test always-identity-explicit-null-insert-sqlstate {
    DROP TABLE IF EXISTS sq_ian;
    CREATE TABLE sq_ian (id bigint GENERATED ALWAYS AS IDENTITY, v text);
    INSERT INTO sq_ian (id, v) VALUES (NULL, 'x');
}
@sqlstate 428C9
expect error {}

test always-identity-rejects-positional-values {
    DROP TABLE IF EXISTS sq_ipv;
    CREATE TABLE sq_ipv (id bigint GENERATED ALWAYS AS IDENTITY, v text);
    INSERT INTO sq_ipv VALUES (42, 'x');
}
@sqlstate 428C9
expect error {}

test always-identity-rejects-positional-select {
    DROP TABLE IF EXISTS sq_ips;
    CREATE TABLE sq_ips (id bigint GENERATED ALWAYS AS IDENTITY, v text);
    INSERT INTO sq_ips SELECT 43, 'x';
}
@sqlstate 428C9
expect error {}

test always-identity-rejects-named-select {
    DROP TABLE IF EXISTS sq_ins;
    CREATE TABLE sq_ins (id bigint GENERATED ALWAYS AS IDENTITY, v text);
    INSERT INTO sq_ins (id, v) SELECT 43, 'x';
}
@sqlstate 428C9
expect error {}

test always-identity-rejects-one-explicit-row {
    DROP TABLE IF EXISTS sq_ier;
    CREATE TABLE sq_ier (id bigint GENERATED ALWAYS AS IDENTITY, v text);
    INSERT INTO sq_ier (id, v) VALUES (DEFAULT, 'a'), (5, 'b');
}
@sqlstate 428C9
expect error {}

test always-identity-positional-default {
    DROP TABLE IF EXISTS sq_ipd;
    CREATE TABLE sq_ipd (id bigint GENERATED ALWAYS AS IDENTITY, v text DEFAULT 'd');
    INSERT INTO sq_ipd VALUES (DEFAULT, 'x');
    INSERT INTO sq_ipd VALUES (DEFAULT, DEFAULT);
    SELECT id, v FROM sq_ipd ORDER BY id;
}
expect {
    1|x
    2|d
}

test by-default-identity-accepts-positional-values {
    DROP TABLE IF EXISTS sq_bpv;
    CREATE TABLE sq_bpv (id bigint GENERATED BY DEFAULT AS IDENTITY, v text);
    INSERT INTO sq_bpv VALUES (42, 'x');
    INSERT INTO sq_bpv SELECT 43, 'y';
    SELECT id, v FROM sq_bpv ORDER BY id;
}
expect {
    42|x
    43|y
}

test always-identity-explicit-update-sqlstate {
    DROP TABLE IF EXISTS sq_iu;
    CREATE TABLE sq_iu (id bigint GENERATED ALWAYS AS IDENTITY, v text);
    INSERT INTO sq_iu (v) VALUES ('x');
    UPDATE sq_iu SET id = 7;
}
@sqlstate 428C9
expect error {}

test always-identity-explicit-on-conflict-update-sqlstate {
    DROP TABLE IF EXISTS sq_ic;
    CREATE TABLE sq_ic (id bigint GENERATED ALWAYS AS IDENTITY, v text UNIQUE);
    INSERT INTO sq_ic (v) VALUES ('x');
    INSERT INTO sq_ic (v) VALUES ('x') ON CONFLICT (v) DO UPDATE SET id = 7;
}
@sqlstate 428C9
expect error {}

test identity-on-text-column-is-rejected {
    DROP TABLE IF EXISTS sq_it;
    CREATE TABLE sq_it (id text GENERATED ALWAYS AS IDENTITY);
}
@sqlstate 22023
expect error {}

test identity-with-default-is-rejected {
    DROP TABLE IF EXISTS sq_id;
    CREATE TABLE sq_id (id bigint GENERATED ALWAYS AS IDENTITY DEFAULT 1);
}
@sqlstate 42601
expect error {}

test identity-with-zero-increment-is-rejected {
    DROP TABLE IF EXISTS sq_iz;
    CREATE TABLE sq_iz (id bigint GENERATED ALWAYS AS IDENTITY (INCREMENT BY 0));
}
@sqlstate 22023
expect error {}

test identity-with-minvalue-above-maxvalue-is-rejected {
    DROP TABLE IF EXISTS sq_imm;
    CREATE TABLE sq_imm (id bigint GENERATED ALWAYS AS IDENTITY (MINVALUE 10 MAXVALUE 1));
}
@sqlstate 22023
expect error {}

test identity-sequence-options-apply {
    DROP TABLE IF EXISTS sq_iso;
    CREATE TABLE sq_iso (id bigint GENERATED BY DEFAULT AS IDENTITY (START WITH 10 INCREMENT BY 5), v text);
    INSERT INTO sq_iso (v) VALUES ('a'), ('b');
    SELECT id, v FROM sq_iso ORDER BY id;
}
expect {
    10|a
    15|b
}

test identity-sequence-cycles {
    DROP TABLE IF EXISTS sq_icy;
    CREATE TABLE sq_icy (id int GENERATED ALWAYS AS IDENTITY (MAXVALUE 2 CYCLE), v text);
    INSERT INTO sq_icy (v) VALUES ('a'), ('b'), ('c');
    SELECT id, v FROM sq_icy ORDER BY v;
}
expect {
    1|a
    2|b
    1|c
}

test identity-sequence-exhausted-sqlstate {
    DROP TABLE IF EXISTS sq_iex;
    CREATE TABLE sq_iex (id int GENERATED ALWAYS AS IDENTITY (MAXVALUE 2), v text);
    INSERT INTO sq_iex (v) VALUES ('a'), ('b'), ('c');
}
@sqlstate 2200H
expect error {}

test identity-sequence-exhausted-across-inserts-sqlstate {
    DROP TABLE IF EXISTS sq_iex2;
    CREATE TABLE sq_iex2 (id int GENERATED BY DEFAULT AS IDENTITY (MAXVALUE 2), v text);
    INSERT INTO sq_iex2 (v) VALUES ('a');
    INSERT INTO sq_iex2 (v) VALUES ('b');
    INSERT INTO sq_iex2 (v) VALUES ('c');
}
@sqlstate 2200H
expect error {}

test smallint-identity-cycles-at-type-bound {
    DROP TABLE IF EXISTS sq_isc;
    CREATE TABLE sq_isc (id smallint GENERATED BY DEFAULT AS IDENTITY (START WITH 32767 CYCLE), v text);
    INSERT INTO sq_isc (v) VALUES ('a');
    INSERT INTO sq_isc (v) VALUES ('b');
    SELECT id, v FROM sq_isc ORDER BY v;
}
expect {
    32767|a
    1|b
}

test integer-identity-descending-cycles-at-type-bound {
    DROP TABLE IF EXISTS sq_iid;
    CREATE TABLE sq_iid (id integer GENERATED ALWAYS AS IDENTITY (INCREMENT BY -1 START WITH -2147483648 CYCLE), v text);
    INSERT INTO sq_iid (v) VALUES ('a');
    INSERT INTO sq_iid (v) VALUES ('b');
    SELECT id, v FROM sq_iid ORDER BY v;
}
expect {
    -2147483648|a
    -1|b
}

test smallint-identity-maxvalue-out-of-range {
    DROP TABLE IF EXISTS sq_ism;
    CREATE TABLE sq_ism (id smallint GENERATED BY DEFAULT AS IDENTITY (MAXVALUE 40000));
}
@sqlstate 22023
expect error {
    MAXVALUE \(40000\) is out of range for sequence data type smallint
}

test integer-identity-minvalue-out-of-range {
    DROP TABLE IF EXISTS sq_iim;
    CREATE TABLE sq_iim (id integer GENERATED BY DEFAULT AS IDENTITY (MINVALUE -3000000000));
}
@sqlstate 22023
expect error {
    MINVALUE \(-3000000000\) is out of range for sequence data type integer
}

test smallint-identity-exhausted {
    DROP TABLE IF EXISTS sq_ise;
    CREATE TABLE sq_ise (id smallint GENERATED BY DEFAULT AS IDENTITY (START WITH 32767), v text);
    INSERT INTO sq_ise (v) VALUES ('a');
    INSERT INTO sq_ise (v) VALUES ('b');
}
@sqlstate 2200H
expect error {}

test int-identity-primary-key-uses-sequence-options {
    DROP TABLE IF EXISTS sq_ipk;
    CREATE TABLE sq_ipk (id int GENERATED BY DEFAULT AS IDENTITY (START WITH 10 INCREMENT BY 5) PRIMARY KEY, v text);
    INSERT INTO sq_ipk (v) VALUES ('a'), ('b');
    SELECT id, v FROM sq_ipk ORDER BY id;
}
expect {
    10|a
    15|b
}

test integer-identity-table-primary-key-uses-sequence-options {
    DROP TABLE IF EXISTS sq_itpk;
    CREATE TABLE sq_itpk (id integer GENERATED ALWAYS AS IDENTITY (START WITH 10), v text, PRIMARY KEY (id));
    INSERT INTO sq_itpk (v) VALUES ('a');
    SELECT id, v FROM sq_itpk;
}
expect {
    10|a
}

test int-identity-primary-key-rejects-null {
    DROP TABLE IF EXISTS sq_ipkn;
    CREATE TABLE sq_ipkn (id int GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, v text);
    INSERT INTO sq_ipkn (id, v) VALUES (NULL, 'x');
}
@sqlstate 23502
expect error {}

test int-identity-primary-key-default-collides-with-explicit-key {
    DROP TABLE IF EXISTS sq_ipkc;
    CREATE TABLE sq_ipkc (id int GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, v text);
    INSERT INTO sq_ipkc (id, v) VALUES (1, 'x');
    INSERT INTO sq_ipkc (v) VALUES ('y');
}
@sqlstate 23505
expect error {}

test identity-rejects-multiple-identity-clauses {
    CREATE TABLE sq_imi (id int GENERATED ALWAYS AS IDENTITY (START 10) GENERATED BY DEFAULT AS IDENTITY (START 100));
}
@sqlstate 42601
expect error {}

test identity-rejects-null-clause-after-identity {
    CREATE TABLE sq_inu (id integer GENERATED ALWAYS AS IDENTITY NULL);
}
@sqlstate 42601
expect error {}

test identity-rejects-null-clause-before-identity {
    CREATE TABLE sq_inb (id integer NULL GENERATED ALWAYS AS IDENTITY);
}
@sqlstate 42601
expect error {}

test overriding-system-value-writes-an-always-identity-column {
    DROP TABLE IF EXISTS orders;
    CREATE TABLE orders (id bigint GENERATED ALWAYS AS IDENTITY, label text);
    INSERT INTO orders OVERRIDING SYSTEM VALUE VALUES (42, 'a');
    INSERT INTO orders (id, label) OVERRIDING SYSTEM VALUE VALUES (43, 'b');
    SELECT id, label FROM orders ORDER BY id;
}
expect {
    42|a
    43|b
}

test overriding-system-value-still-uses-default-keyword {
    DROP TABLE IF EXISTS orders;
    CREATE TABLE orders (id bigint GENERATED ALWAYS AS IDENTITY, label text);
    INSERT INTO orders OVERRIDING SYSTEM VALUE VALUES (42, 'a'), (DEFAULT, 'b');
    SELECT id, label FROM orders ORDER BY label;
}
expect {
    42|a
    1|b
}

test overriding-system-value-with-insert-select {
    DROP TABLE IF EXISTS orders;
    CREATE TABLE orders (id bigint GENERATED ALWAYS AS IDENTITY, label text);
    INSERT INTO orders OVERRIDING SYSTEM VALUE SELECT 7, 'a';
    SELECT id, label FROM orders;
}
expect {
    7|a
}

test overriding-system-value-on-by-default-identity {
    DROP TABLE IF EXISTS orders;
    CREATE TABLE orders (id bigint GENERATED BY DEFAULT AS IDENTITY, label text);
    INSERT INTO orders OVERRIDING SYSTEM VALUE VALUES (9, 'a');
    SELECT id, label FROM orders;
}
expect {
    9|a
}

test overriding-system-value-does-not-allow-the-next-insert {
    DROP TABLE IF EXISTS orders;
    CREATE TABLE orders (id bigint GENERATED ALWAYS AS IDENTITY, label text);
    INSERT INTO orders OVERRIDING SYSTEM VALUE VALUES (42, 'a');
    INSERT INTO orders VALUES (43, 'b');
}
@sqlstate 428C9
expect error {}

@skip-if postgres "tursopg does not accept OVERRIDING USER VALUE"
test overriding-user-value-is-not-supported {
    DROP TABLE IF EXISTS orders;
    CREATE TABLE orders (id bigint GENERATED ALWAYS AS IDENTITY, label text);
    INSERT INTO orders OVERRIDING USER VALUE VALUES (5, 'a');
}
@sqlstate 0A000
expect error {
    INSERT ... OVERRIDING USER VALUE is not supported
}

test drop-table-drops-its-identity-sequence {
    CREATE TABLE zz_drop_identity (id int GENERATED ALWAYS AS IDENTITY, label text);
    DROP TABLE zz_drop_identity;
    SELECT count(*) FROM pg_class WHERE relname = 'zz_drop_identity_id_seq';
}
expect {
    0
}

test drop-table-drops-its-serial-sequence {
    CREATE TABLE zz_drop_serial (id serial, label text);
    DROP TABLE zz_drop_serial;
    SELECT count(*) FROM pg_class WHERE relname = 'zz_drop_serial_id_seq';
}
expect {
    0
}

test recreated-table-gets-the-first-identity-sequence-name {
    CREATE TABLE zz_recreate (id int GENERATED ALWAYS AS IDENTITY);
    DROP TABLE zz_recreate;
    CREATE TABLE zz_recreate (id int GENERATED ALWAYS AS IDENTITY);
    SELECT relname FROM pg_class WHERE relname LIKE 'zz_recreate%' AND relkind = 'S';
}
expect {
    zz_recreate_id_seq
}

test rolled-back-drop-table-keeps-its-identity-sequence {
    CREATE TABLE zz_rollback_drop (id int GENERATED ALWAYS AS IDENTITY, label text);
    INSERT INTO zz_rollback_drop (label) VALUES ('a');
    BEGIN;
    DROP TABLE zz_rollback_drop;
    ROLLBACK;
    INSERT INTO zz_rollback_drop (label) VALUES ('b');
    SELECT id, label FROM zz_rollback_drop ORDER BY id;
}
expect {
    1|a
    2|b
}

test drop-table-keeps-a-sequence-it-does-not-own {
    CREATE SEQUENCE zz_keep_seq;
    CREATE TABLE zz_keep_owner (id int GENERATED ALWAYS AS IDENTITY, n bigint DEFAULT nextval('zz_keep_seq'));
    DROP TABLE zz_keep_owner;
    SELECT relname FROM pg_class WHERE relname LIKE 'zz_keep%' AND relkind = 'S';
}
expect {
    zz_keep_seq
}

test drop-column-drops-its-identity-sequence {
    CREATE TABLE zz_dropcol_identity (id int GENERATED ALWAYS AS IDENTITY, label text);
    ALTER TABLE zz_dropcol_identity DROP COLUMN id;
    SELECT count(*) FROM pg_class WHERE relname = 'zz_dropcol_identity_id_seq';
}
expect {
    0
}

test drop-column-drops-its-serial-sequence {
    CREATE TABLE zz_dropcol_serial (id serial, label text);
    ALTER TABLE zz_dropcol_serial DROP COLUMN id;
    SELECT count(*) FROM pg_class WHERE relname = 'zz_dropcol_serial_id_seq';
}
expect {
    0
}

test drop-column-keeps-the-sequences-of-other-columns {
    CREATE TABLE zz_dropcol_two (
        a int GENERATED ALWAYS AS IDENTITY,
        b int GENERATED BY DEFAULT AS IDENTITY,
        label text
    );
    ALTER TABLE zz_dropcol_two DROP COLUMN b;
    INSERT INTO zz_dropcol_two (label) VALUES ('x');
    SELECT relname FROM pg_class WHERE relname LIKE 'zz_dropcol_two%' AND relkind = 'S';
}
expect {
    zz_dropcol_two_a_seq
}

test drop-column-keeps-a-sequence-it-does-not-own {
    CREATE SEQUENCE zz_dropcol_shared;
    CREATE TABLE zz_dropcol_user (n bigint DEFAULT nextval('zz_dropcol_shared'), label text);
    ALTER TABLE zz_dropcol_user DROP COLUMN n;
    SELECT relname FROM pg_class WHERE relname LIKE 'zz_dropcol_shared%' AND relkind = 'S';
}
expect {
    zz_dropcol_shared
}

test rolled-back-drop-column-keeps-its-identity-sequence {
    CREATE TABLE zz_dropcol_rollback (id int GENERATED ALWAYS AS IDENTITY, label text);
    INSERT INTO zz_dropcol_rollback (label) VALUES ('a');
    BEGIN;
    ALTER TABLE zz_dropcol_rollback DROP COLUMN id;
    ROLLBACK;
    INSERT INTO zz_dropcol_rollback (label) VALUES ('b');
    SELECT id, label FROM zz_dropcol_rollback ORDER BY id;
}
expect {
    1|a
    2|b
}

test drop-table-refuses-when-another-default-uses-its-sequence {
    DROP TABLE IF EXISTS zz_dep_user;
    DROP TABLE IF EXISTS zz_dep_owner;
    CREATE TABLE zz_dep_owner (id int GENERATED ALWAYS AS IDENTITY, label text);
    CREATE TABLE zz_dep_user (n bigint DEFAULT nextval('zz_dep_owner_id_seq'));
    DROP TABLE zz_dep_owner;
}
@sqlstate 2BP01
expect error {
    cannot drop table zz_dep_owner because other objects depend on it
}

test drop-table-works-once-the-other-default-is-gone {
    DROP TABLE IF EXISTS zz_dep_user2;
    DROP TABLE IF EXISTS zz_dep_owner2;
    CREATE TABLE zz_dep_owner2 (id int GENERATED ALWAYS AS IDENTITY, label text);
    CREATE TABLE zz_dep_user2 (n bigint DEFAULT nextval('zz_dep_owner2_id_seq'));
    DROP TABLE zz_dep_user2;
    DROP TABLE zz_dep_owner2;
    SELECT count(*) FROM pg_class WHERE relname = 'zz_dep_owner2_id_seq';
}
expect {
    0
}

test drop-column-refuses-when-another-default-uses-its-sequence {
    DROP TABLE IF EXISTS zz_depcol_user;
    DROP TABLE IF EXISTS zz_depcol_owner;
    CREATE TABLE zz_depcol_owner (id int GENERATED ALWAYS AS IDENTITY, label text);
    CREATE TABLE zz_depcol_user (n bigint DEFAULT nextval('zz_depcol_owner_id_seq'));
    ALTER TABLE zz_depcol_owner DROP COLUMN id;
}
@sqlstate 2BP01
expect error {
    cannot drop column id of table zz_depcol_owner because other objects depend on it
}

test drop-column-refuses-when-a-column-of-the-same-table-uses-its-sequence {
    DROP TABLE IF EXISTS zz_depsame;
    CREATE TABLE zz_depsame (id int GENERATED ALWAYS AS IDENTITY, copy bigint DEFAULT nextval('zz_depsame_id_seq'));
    ALTER TABLE zz_depsame DROP COLUMN id;
}
@sqlstate 2BP01
expect error {
    cannot drop column id of table zz_depsame because other objects depend on it
}

test drop-sequence-refuses-when-a-default-uses-it {
    DROP TABLE IF EXISTS zz_dropseq_user;
    DROP SEQUENCE IF EXISTS zz_dropseq;
    CREATE SEQUENCE zz_dropseq;
    CREATE TABLE zz_dropseq_user (n bigint DEFAULT nextval('zz_dropseq'));
    DROP SEQUENCE zz_dropseq;
}
@sqlstate 2BP01
expect error {
    cannot drop sequence zz_dropseq because other objects depend on it
}

test drop-sequence-refuses-when-a-view-uses-it {
    DROP VIEW IF EXISTS zz_dropseq_view;
    DROP SEQUENCE IF EXISTS zz_dropseq2;
    CREATE SEQUENCE zz_dropseq2;
    CREATE VIEW zz_dropseq_view AS SELECT nextval('zz_dropseq2') AS n;
    DROP SEQUENCE zz_dropseq2;
}
@sqlstate 2BP01
expect error {
    cannot drop sequence zz_dropseq2 because other objects depend on it
}

test drop-sequence-works-once-nothing-uses-it {
    DROP TABLE IF EXISTS zz_dropseq_user3;
    DROP SEQUENCE IF EXISTS zz_dropseq3;
    CREATE SEQUENCE zz_dropseq3;
    CREATE TABLE zz_dropseq_user3 (n bigint DEFAULT nextval('zz_dropseq3'));
    DROP TABLE zz_dropseq_user3;
    DROP SEQUENCE zz_dropseq3;
    SELECT count(*) FROM pg_class WHERE relname = 'zz_dropseq3';
}
expect {
    0
}

test drop-table-refuses-when-a-view-uses-its-serial-sequence {
    DROP VIEW IF EXISTS zz_serialview_view;
    DROP TABLE IF EXISTS zz_serialview;
    CREATE TABLE zz_serialview (id serial);
    CREATE VIEW zz_serialview_view AS SELECT nextval('zz_serialview_id_seq') AS n;
    DROP TABLE zz_serialview;
}
@sqlstate 2BP01
expect error {
    cannot drop table zz_serialview because other objects depend on it
}

test drop-sequence-refuses-when-a-default-calls-it-inside-an-expression {
    DROP TABLE IF EXISTS zz_dropseq_expr_user;
    DROP SEQUENCE IF EXISTS zz_dropseq_expr;
    CREATE SEQUENCE zz_dropseq_expr;
    CREATE TABLE zz_dropseq_expr_user (n bigint DEFAULT nextval('zz_dropseq_expr') + 1);
    DROP SEQUENCE zz_dropseq_expr;
}
@sqlstate 2BP01
expect error {
    cannot drop sequence zz_dropseq_expr because other objects depend on it
}
