# CREATE ROLE through the PostgreSQL frontend.
# PostgreSQL roles belong to the whole server, not to one database, so every
# test uses its own role names.

@database :memory:

test bootstrap-superuser-is-postgres {
    SELECT rolname FROM pg_roles WHERE oid = 10 AND rolsuper;
}
expect {
    postgres
}

test pg-roles-does-not-list-public {
    SELECT count(*) FROM pg_roles WHERE rolname = 'public';
}
expect {
    0
}

test pg-get-userbyid-of-public-oid-is-unknown {
    SELECT pg_get_userbyid(0);
}
expect {
    unknown (OID=0)
}

test pg-get-userbyid-accepts-quoted-oid {
    SELECT pg_get_userbyid('10');
}
expect {
    postgres
}

test bootstrap-superuser-bypasses-row-level-security {
    SELECT count(*) FROM pg_roles WHERE oid = 10 AND rolbypassrls;
}
expect {
    1
}

test create-role-does-not-bypass-row-level-security {
    CREATE ROLE cr_no_bypassrls;
    SELECT count(*) FROM pg_roles WHERE rolname = 'cr_no_bypassrls' AND NOT rolbypassrls;
}
expect {
    1
}

test pg-get-expr-shows-role-defaults-as-keywords {
    CREATE TABLE cu_role_defaults (owner TEXT DEFAULT current_user, creator TEXT DEFAULT session_user);
    SELECT pg_get_expr(d.adbin, d.adrelid)
    FROM pg_attrdef d JOIN pg_class c ON c.oid = d.adrelid
    WHERE c.relname = 'cu_role_defaults'
    ORDER BY d.adnum;
}
expect {
    CURRENT_USER
    SESSION_USER
}

test pg-get-expr-shows-each-role-keyword-as-written {
    CREATE TABLE cu_role_keywords (a TEXT DEFAULT current_user, b TEXT DEFAULT current_role, c TEXT DEFAULT user, d TEXT DEFAULT session_user);
    SELECT pg_get_expr(d.adbin, d.adrelid)
    FROM pg_attrdef d JOIN pg_class c ON c.oid = d.adrelid
    WHERE c.relname = 'cu_role_keywords'
    ORDER BY d.adnum;
}
expect {
    CURRENT_USER
    CURRENT_ROLE
    USER
    SESSION_USER
}

test role-keywords-name-the-superuser {
    SELECT current_user, current_role, user, session_user;
}
expect {
    postgres|postgres|postgres|postgres
}

test check-constraint-calls-current-user {
    CREATE TABLE cu_check (owner TEXT CHECK (owner = current_user));
    INSERT INTO cu_check VALUES ('postgres');
    SELECT owner FROM cu_check;
}
expect {
    postgres
}

test add-column-fills-existing-rows-with-current-user {
    CREATE TABLE cu_add_column (x int);
    INSERT INTO cu_add_column VALUES (1);
    ALTER TABLE cu_add_column ADD COLUMN owner TEXT DEFAULT current_user;
    SELECT x, owner FROM cu_add_column;
}
expect {
    1|postgres
}

test check-constraint-definitions-show-role-functions-as-keywords {
    CREATE TABLE cu_role_checks (owner TEXT CHECK (owner = current_user), creator TEXT CHECK (creator = session_user));
    SELECT CASE WHEN position('CURRENT_USER' in pg_get_constraintdef(con.oid)) > 0 THEN 'CURRENT_USER'
                WHEN position('SESSION_USER' in pg_get_constraintdef(con.oid)) > 0 THEN 'SESSION_USER' END,
           CASE WHEN position('CURRENT_USER' in pg_get_expr(con.conbin, con.conrelid)) > 0 THEN 'CURRENT_USER'
                WHEN position('SESSION_USER' in pg_get_expr(con.conbin, con.conrelid)) > 0 THEN 'SESSION_USER' END
    FROM pg_constraint con JOIN pg_class c ON c.oid = con.conrelid
    WHERE c.relname = 'cu_role_checks' AND con.contype = 'c'
    ORDER BY 1;
}
expect {
    CURRENT_USER|CURRENT_USER
    SESSION_USER|SESSION_USER
}

test create-role-named-postgres-fails {
    CREATE ROLE postgres;
}
expect error {
    role "postgres" already exists
}

test create-role-is-listed-in-pg-roles {
    CREATE ROLE cr_listed;
    SELECT rolname FROM pg_roles WHERE rolname = 'cr_listed';
}
expect {
    cr_listed
}

test acldefault-names-the-owner-by-role-name {
    CREATE ROLE cr_owner;
    SELECT acldefault('n', oid) FROM pg_roles WHERE rolname = 'cr_owner';
}
expect {
    {cr_owner=UC/cr_owner}
}

test acldefault-quotes-role-names-that-are-not-plain-identifiers {
    CREATE ROLE "cr acl,owner";
    CREATE ROLE "cr""acl";
    SELECT acldefault('n', oid) FROM pg_roles WHERE rolname = 'cr acl,owner';
    SELECT acldefault('n', oid) FROM pg_roles WHERE rolname = 'cr"acl';
}
expect {
    {"\"cr acl,owner\"=UC/\"cr acl,owner\""}
    {"\"cr\"\"acl\"=UC/\"cr\"\"acl\""}
}

test create-role-is-not-superuser-and-cannot-log-in {
    CREATE ROLE cr_defaults;
    SELECT count(*) FROM pg_roles
    WHERE rolname = 'cr_defaults' AND NOT rolsuper AND NOT rolcanlogin;
}
expect {
    1
}

test create-role-lowercases-unquoted-name {
    CREATE ROLE CR_Unquoted;
    SELECT rolname FROM pg_roles WHERE rolname = 'cr_unquoted';
}
expect {
    cr_unquoted
}

test create-role-keeps-case-of-quoted-name {
    CREATE ROLE "CR_Quoted";
    SELECT rolname FROM pg_roles WHERE rolname = 'CR_Quoted';
}
expect {
    CR_Quoted
}

test create-role-names-differing-only-in-case-are-different-roles {
    CREATE ROLE "cr_case";
    CREATE ROLE "CR_CASE";
    SELECT rolname FROM pg_roles WHERE lower(rolname) = 'cr_case' ORDER BY rolname;
}
expect {
    CR_CASE
    cr_case
}

test create-role-twice-fails {
    CREATE ROLE cr_twice;
    CREATE ROLE cr_twice;
}
expect error {
    role "cr_twice" already exists
}

test create-role-with-pg-prefix-fails {
    CREATE ROLE pg_cr_reserved;
}
expect error {
    role name "pg_cr_reserved" is reserved
}

test create-role-named-public-fails {
    CREATE ROLE public;
}
expect error {
    role name "public" is reserved
}

test create-role-rolled-back-is-not-listed {
    BEGIN;
    CREATE ROLE cr_rolled_back;
    ROLLBACK;
    SELECT count(*) FROM pg_roles WHERE rolname = 'cr_rolled_back';
}
expect {
    0
}

test create-role-committed-is-listed {
    BEGIN;
    CREATE ROLE cr_committed;
    COMMIT;
    SELECT rolname FROM pg_roles WHERE rolname = 'cr_committed';
}
expect {
    cr_committed
}

test set-role-changes-current-user {
    CREATE ROLE sr_current;
    SET ROLE sr_current;
    SELECT current_user;
}
expect {
    sr_current
}

test set-role-keeps-session-user {
    CREATE ROLE sr_session;
    SET ROLE sr_session;
    SELECT CASE WHEN session_user = 'sr_session' THEN 'changed' ELSE 'kept' END;
}
expect {
    kept
}

test reset-role-returns-to-session-user {
    CREATE ROLE sr_reset;
    SET ROLE sr_reset;
    RESET ROLE;
    SELECT CASE WHEN current_user = session_user THEN 'session user' ELSE 'other' END;
}
expect {
    session user
}

test set-role-none-returns-to-session-user {
    CREATE ROLE sr_none;
    SET ROLE sr_none;
    SET ROLE NONE;
    SELECT CASE WHEN current_user = session_user THEN 'session user' ELSE 'other' END;
}
expect {
    session user
}

test set-role-with-quoted-uppercase-setting-name-changes-current-user {
    CREATE ROLE sr_quoted_name;
    SET "ROLE" TO sr_quoted_name;
    SELECT current_user;
}
expect {
    sr_quoted_name
}

test reset-role-with-quoted-uppercase-setting-name-returns-to-session-user {
    CREATE ROLE sr_quoted_reset;
    SET ROLE sr_quoted_reset;
    RESET "ROLE";
    SELECT CASE WHEN current_user = session_user THEN 'session user' ELSE 'other' END;
}
expect {
    session user
}

test discard-all-returns-to-session-user {
    CREATE ROLE sr_discard;
    SET ROLE sr_discard;
    DISCARD ALL;
    SELECT CASE WHEN current_user = session_user THEN 'session user' ELSE 'other' END;
}
expect {
    session user
}

test set-role-in-rolled-back-transaction-is-undone {
    CREATE ROLE sr_rolled_back;
    BEGIN;
    SET ROLE sr_rolled_back;
    SELECT current_user;
    ROLLBACK;
    SELECT CASE WHEN current_user = session_user THEN 'session user' ELSE 'other' END;
}
expect {
    sr_rolled_back
    session user
}

test set-role-in-committed-transaction-is-kept {
    CREATE ROLE sr_committed;
    BEGIN;
    SET ROLE sr_committed;
    COMMIT;
    SELECT current_user;
}
expect {
    sr_committed
}

test set-role-to-role-created-in-rolled-back-transaction-is-undone {
    BEGIN;
    CREATE ROLE sr_created_and_rolled_back;
    SET ROLE sr_created_and_rolled_back;
    ROLLBACK;
    SELECT CASE WHEN current_user = session_user THEN 'session user' ELSE 'other' END;
}
expect {
    session user
}

test set-local-role-ends-at-commit {
    CREATE ROLE sr_local;
    BEGIN;
    SET LOCAL ROLE sr_local;
    SELECT current_user;
    COMMIT;
    SELECT CASE WHEN current_user = session_user THEN 'session user' ELSE 'other' END;
}
expect {
    sr_local
    session user
}

test set-local-role-outside-a-transaction-ends-with-its-statement {
    CREATE ROLE sr_local_outside;
    SET LOCAL ROLE sr_local_outside;
    SELECT CASE WHEN current_user = session_user THEN 'session user' ELSE 'other' END;
}
expect {
    session user
}

test rollback-to-savepoint-restores-the-role {
    CREATE ROLE sr_savepoint;
    BEGIN;
    SAVEPOINT s;
    SET ROLE sr_savepoint;
    SELECT current_user;
    ROLLBACK TO SAVEPOINT s;
    SELECT CASE WHEN current_user = session_user THEN 'session user' ELSE 'other' END;
    COMMIT;
}
expect {
    sr_savepoint
    session user
}

test show-role-names-the-role-set-with-set-role {
    CREATE ROLE sr_show;
    SHOW role;
    SET ROLE sr_show;
    SHOW role;
    SELECT current_setting('role');
}
expect {
    none
    sr_show
    sr_show
}

test set-config-sets-the-role {
    CREATE ROLE sr_set_config;
    SELECT set_config('role', 'sr_set_config', false);
    SELECT current_user;
}
expect {
    sr_set_config
    sr_set_config
}

test reset-all-keeps-the-role {
    CREATE ROLE sr_reset_all;
    SET ROLE sr_reset_all;
    RESET ALL;
    SELECT current_user;
}
expect {
    sr_reset_all
}

test set-role-to-missing-role-fails {
    SET ROLE sr_missing;
}
expect error {
    role "sr_missing" does not exist
}

test set-role-public-fails {
    SET ROLE public;
}
expect error {
    role "public" does not exist
}

test role-without-privileges-can-select-without-tables {
    CREATE ROLE sr_no_tables;
    SET ROLE sr_no_tables;
    SELECT 1 + 1, upper('x');
}
expect {
    2|X
}

test role-without-privileges-cannot-create-table {
    CREATE ROLE sr_creator;
    SET ROLE sr_creator;
    CREATE TABLE sr_created (x int);
}
expect error {
    permission denied for schema public
}

test role-without-privileges-cannot-insert-rows {
    CREATE TABLE rw_insert (x int);
    INSERT INTO rw_insert VALUES (1);
    CREATE ROLE rw_inserter;
    SET ROLE rw_inserter;
    INSERT INTO rw_insert VALUES (1);
}
expect error {
    permission denied for table rw_insert
}

test role-without-privileges-cannot-update-rows {
    CREATE TABLE rw_update (x int);
    INSERT INTO rw_update VALUES (1);
    CREATE ROLE rw_updateer;
    SET ROLE rw_updateer;
    UPDATE rw_update SET x = 2;
}
expect error {
    permission denied for table rw_update
}

test role-without-privileges-cannot-delete-rows {
    CREATE TABLE rw_delete (x int);
    INSERT INTO rw_delete VALUES (1);
    CREATE ROLE rw_deleteer;
    SET ROLE rw_deleteer;
    DELETE FROM rw_delete;
}
expect error {
    permission denied for table rw_delete
}

test role-without-privileges-cannot-truncate-rows {
    CREATE TABLE rw_truncate (x int);
    INSERT INTO rw_truncate VALUES (1);
    CREATE ROLE rw_truncateer;
    SET ROLE rw_truncateer;
    TRUNCATE rw_truncate;
}
expect error {
    permission denied for table rw_truncate
}

test role-without-privileges-cannot-call-nextval {
    CREATE SEQUENCE rw_nextval_seq;
    CREATE ROLE rw_nextval_caller;
    SET ROLE rw_nextval_caller;
    SELECT nextval('rw_nextval_seq');
}
expect error {
    permission denied for sequence rw_nextval_seq
}

test role-without-privileges-cannot-call-setval {
    CREATE SEQUENCE rw_setval_seq;
    CREATE ROLE rw_setval_caller;
    SET ROLE rw_setval_caller;
    SELECT setval('rw_setval_seq', 5);
}
expect error {
    permission denied for sequence rw_setval_seq
}

test role-without-privileges-cannot-drop-table {
    CREATE TABLE sr_drop (x int);
    CREATE ROLE sr_dropper;
    SET ROLE sr_dropper;
    DROP TABLE sr_drop;
}
expect error {
    must be owner of table sr_drop
}

test role-without-privileges-cannot-comment-on-table {
    CREATE TABLE sr_commented (x int);
    CREATE ROLE sr_commenter;
    SET ROLE sr_commenter;
    COMMENT ON TABLE sr_commented IS 'x';
}
expect error {
    must be owner of table sr_commented
}

test role-without-privileges-cannot-comment-on-column {
    CREATE TABLE sr_column_commented (x int);
    CREATE ROLE sr_column_commenter;
    SET ROLE sr_column_commenter;
    COMMENT ON COLUMN sr_column_commented.x IS 'x';
}
expect error {
    must be owner of relation sr_column_commented
}

test role-without-privileges-cannot-create-role {
    CREATE ROLE sr_role_creator;
    SET ROLE sr_role_creator;
    CREATE ROLE sr_role_created;
}
expect error {
    permission denied to create role
}

test reset-role-restores-superuser-privileges {
    CREATE TABLE sr_restore (x int);
    INSERT INTO sr_restore VALUES (1);
    CREATE ROLE sr_restorer;
    SET ROLE sr_restorer;
    RESET ROLE;
    SELECT x FROM sr_restore;
}
expect {
    1
}

test pg-tables-does-not-list-the-roles-table {
    CREATE ROLE pt_role;
    SELECT count(*) FROM pg_tables WHERE tablename LIKE '%roles%';
}
expect {
    0
}

test pg-get-indexdef-finds-index-after-create-role {
    CREATE TABLE gi_table (x int);
    CREATE INDEX gi_index ON gi_table (x);
    CREATE ROLE gi_role;
    SELECT CASE
        WHEN pg_get_indexdef(i.indexrelid) LIKE 'CREATE INDEX gi_index ON %' THEN 'found'
        ELSE 'missing'
    END
    FROM pg_index i JOIN pg_class c ON c.oid = i.indexrelid
    WHERE c.relname = 'gi_index';
}
expect {
    found
}

test pg-get-constraintdef-finds-constraint-after-create-role {
    CREATE TABLE gc_table (x int PRIMARY KEY);
    CREATE ROLE gc_role;
    SELECT pg_get_constraintdef(oid) FROM pg_constraint WHERE conname = 'gc_table_pkey';
}
expect {
    PRIMARY KEY (x)
}

test role-without-privileges-can-read-catalogs {
    CREATE TABLE rc_table (x int);
    CREATE ROLE rc_reader;
    SET ROLE rc_reader;
    SELECT CASE WHEN count(*) > 0 THEN 'readable' ELSE 'empty' END FROM pg_roles;
    SELECT CASE WHEN count(*) > 0 THEN 'readable' ELSE 'empty' END FROM pg_class;
}
expect {
    readable
    readable
}

# Relation ownership: pg_class.relowner stores the owning role, ALTER ...
# OWNER TO changes it, and the owner may drop and alter the relation.

test relowner-is-the-creating-role {
    CREATE TABLE ro_created (x int);
    SELECT pg_get_userbyid(relowner) FROM pg_class WHERE relname = 'ro_created';
}
expect {
    postgres
}

test owner-to-stores-the-owner-for-pg-get-userbyid {
    CREATE ROLE ro_alice;
    CREATE TABLE ro_owned (x int);
    ALTER TABLE ro_owned OWNER TO ro_alice;
    SELECT pg_get_userbyid(relowner) FROM pg_class WHERE relname = 'ro_owned';
}
expect {
    ro_alice
}

test owner-may-drop-the-table {
    CREATE ROLE ro_dropper;
    CREATE TABLE ro_to_drop (x int);
    ALTER TABLE ro_to_drop OWNER TO ro_dropper;
    SET ROLE ro_dropper;
    DROP TABLE ro_to_drop;
    SET ROLE postgres;
    SELECT count(*) FROM pg_class WHERE relname = 'ro_to_drop';
}
expect {
    0
}

# PostgreSQL also demands CREATE on the schema to rename, which Turso does
# not have yet, so the rename runs as the superuser here; the owner-driven
# rename is covered by the Rust integration tests.
test rename-keeps-the-owner {
    CREATE ROLE ro_renamer;
    CREATE TABLE ro_to_rename (x int);
    ALTER TABLE ro_to_rename OWNER TO ro_renamer;
    ALTER TABLE ro_to_rename RENAME TO ro_renamed;
    SELECT pg_get_userbyid(relowner) FROM pg_class WHERE relname = 'ro_renamed';
}
expect {
    ro_renamer
}

test non-owner-may-not-drop-the-table {
    CREATE ROLE ro_owner1;
    CREATE ROLE ro_other1;
    CREATE TABLE ro_guarded (x int);
    ALTER TABLE ro_guarded OWNER TO ro_owner1;
    SET ROLE ro_other1;
    DROP TABLE ro_guarded;
}
@sqlstate 42501
expect error {
    must be owner of table ro_guarded
}

test non-owner-may-not-alter-the-table {
    CREATE ROLE ro_owner2;
    CREATE ROLE ro_other2;
    CREATE TABLE ro_guarded2 (x int);
    ALTER TABLE ro_guarded2 OWNER TO ro_owner2;
    SET ROLE ro_other2;
    ALTER TABLE ro_guarded2 RENAME TO ro_stolen;
}
@sqlstate 42501
expect error {
    must be owner of table ro_guarded2
}

test owner-may-not-transfer-ownership-yet {
    CREATE ROLE ro_owner3;
    CREATE ROLE ro_other3;
    CREATE TABLE ro_guarded3 (x int);
    ALTER TABLE ro_guarded3 OWNER TO ro_owner3;
    SET ROLE ro_owner3;
    ALTER TABLE ro_guarded3 OWNER TO ro_other3;
}
@sqlstate 42501
expect error {}

test owner-to-a-missing-role-fails {
    CREATE TABLE ro_no_role (x int);
    ALTER TABLE ro_no_role OWNER TO ro_missing_role;
}
@sqlstate 42704
expect error {
    role "ro_missing_role" does not exist
}

test owner-to-on-a-missing-table-fails {
    ALTER TABLE ro_missing_table OWNER TO postgres;
}
@sqlstate 42P01
expect error {
    relation "ro_missing_table" does not exist
}

test owner-to-if-exists-tolerates-a-missing-table {
    ALTER TABLE IF EXISTS ro_missing_table2 OWNER TO postgres;
    SELECT 1;
}
expect {
    1
}

# ALTER INDEX ... OWNER TO changes nothing, as in PostgreSQL, so the count
# checks only the sequence.
test owner-to-works-on-views-and-sequences {
    CREATE ROLE ro_kinds;
    CREATE TABLE ro_base (x int);
    CREATE VIEW ro_view AS SELECT x FROM ro_base;
    CREATE SEQUENCE ro_seq;
    CREATE INDEX ro_idx ON ro_base (x);
    ALTER VIEW ro_view OWNER TO ro_kinds;
    ALTER SEQUENCE ro_seq OWNER TO ro_kinds;
    ALTER INDEX ro_idx OWNER TO ro_kinds;
    SET ROLE ro_kinds;
    DROP VIEW ro_view;
    SET ROLE postgres;
    SELECT count(*) FROM pg_class WHERE relname = 'ro_seq'
    AND pg_get_userbyid(relowner) = 'ro_kinds';
}
expect {
    1
}

test pg-tables-and-pg-sequences-report-the-owner {
    CREATE ROLE ro_reporter;
    CREATE TABLE ro_reported (x int);
    CREATE SEQUENCE ro_reported_seq;
    ALTER TABLE ro_reported OWNER TO ro_reporter;
    ALTER SEQUENCE ro_reported_seq OWNER TO ro_reporter;
    SELECT tableowner FROM pg_tables WHERE tablename = 'ro_reported';
    SELECT sequenceowner FROM pg_sequences WHERE sequencename = 'ro_reported_seq';
}
expect {
    ro_reporter
    ro_reporter
}

test owner-may-not-index-another-schemas-table-of-the-same-name {
    CREATE ROLE ro_indexer;
    CREATE SCHEMA ro_other_schema;
    CREATE TABLE ro_same_name (x int);
    CREATE TABLE ro_other_schema.ro_same_name (x int);
    ALTER TABLE ro_same_name OWNER TO ro_indexer;
    SET ROLE ro_indexer;
    CREATE INDEX ro_sneaky ON ro_other_schema.ro_same_name (x);
}
@sqlstate 42501
expect error {}

test owner-to-on-a-table-moves-its-indexes-and-serial-sequences {
    CREATE ROLE ro_bob;
    CREATE TABLE ro_moved (id serial, x int UNIQUE);
    CREATE INDEX ro_moved_i ON ro_moved (x);
    ALTER TABLE ro_moved OWNER TO ro_bob;
    SET ROLE ro_bob;
    DROP INDEX ro_moved_i;
    SET ROLE postgres;
    SELECT count(*) FROM pg_class
    WHERE relname IN ('ro_moved', 'ro_moved_id_seq')
    AND pg_get_userbyid(relowner) = 'ro_bob';
}
expect {
    2
}

test alter-index-owner-to-keeps-the-tables-owner {
    CREATE ROLE ro_index_role;
    CREATE TABLE ro_index_t (x int);
    CREATE INDEX ro_index_i ON ro_index_t (x);
    ALTER INDEX ro_index_i OWNER TO ro_index_role;
    SELECT pg_get_userbyid(relowner) FROM pg_class WHERE relname = 'ro_index_i';
}
expect {
    postgres
}

test alter-sequence-owner-to-refuses-a-table {
    CREATE ROLE ro_kind_role;
    CREATE TABLE ro_not_a_seq (x int);
    ALTER SEQUENCE ro_not_a_seq OWNER TO ro_kind_role;
}
@sqlstate 42809
expect error {
    "ro_not_a_seq" is not a sequence
}

test alter-view-owner-to-refuses-a-table {
    CREATE ROLE ro_kind_role2;
    CREATE TABLE ro_not_a_view (x int);
    ALTER VIEW ro_not_a_view OWNER TO ro_kind_role2;
}
@sqlstate 42809
expect error {
    "ro_not_a_view" is not a view
}

test an-index-a-superuser-creates-belongs-to-the-tables-owner {
    CREATE ROLE ro_table_owner;
    CREATE TABLE ro_owned_table (id int);
    ALTER TABLE ro_owned_table OWNER TO ro_table_owner;
    CREATE INDEX ro_owned_table_i ON ro_owned_table (id);
    SET ROLE ro_table_owner;
    DROP INDEX ro_owned_table_i;
    SET ROLE postgres;
    SELECT count(*) FROM pg_class WHERE relname = 'ro_owned_table_i';
}
expect {
    0
}

test owner-may-not-rename-without-create-on-the-schema {
    CREATE ROLE ro_renamer2;
    CREATE TABLE ro_owned_rename (x int);
    ALTER TABLE ro_owned_rename OWNER TO ro_renamer2;
    SET ROLE ro_renamer2;
    ALTER TABLE ro_owned_rename RENAME TO ro_owned_renamed;
}
@sqlstate 42501
expect error {
    permission denied for schema public
}

test owner-may-not-index-without-create-on-the-schema {
    CREATE ROLE ro_indexer2;
    CREATE TABLE ro_owned_index (x int);
    ALTER TABLE ro_owned_index OWNER TO ro_indexer2;
    SET ROLE ro_indexer2;
    CREATE INDEX ro_owned_index_i ON ro_owned_index (x);
}
@sqlstate 42501
expect error {
    permission denied for schema public
}

test alter-sequence-owner-to-refuses-a-serial-sequence {
    CREATE ROLE ro_serial_role;
    CREATE TABLE ro_serial (id serial);
    ALTER SEQUENCE ro_serial_id_seq OWNER TO ro_serial_role;
}
@sqlstate 0A000
expect error {
    cannot change owner of sequence "ro_serial_id_seq"
}

test a-sequence-a-default-draws-from-is-not-the-tables {
    CREATE ROLE ro_seq_owner;
    CREATE ROLE ro_table_owner2;
    CREATE SEQUENCE ro_standalone_seq;
    CREATE TABLE ro_draws (a int DEFAULT nextval('ro_standalone_seq'));
    ALTER SEQUENCE ro_standalone_seq OWNER TO ro_seq_owner;
    ALTER TABLE ro_draws OWNER TO ro_table_owner2;
    SELECT pg_get_userbyid(relowner) FROM pg_class WHERE relname = 'ro_standalone_seq';
}
expect {
    ro_seq_owner
}

test owner-to-after-renames-still-moves-the-serial-sequence {
    CREATE ROLE ro_after_rename;
    CREATE TABLE ro_st (id serial);
    ALTER TABLE ro_st RENAME TO ro_su;
    ALTER TABLE ro_su RENAME COLUMN id TO ident;
    ALTER TABLE ro_su OWNER TO ro_after_rename;
    SELECT pg_get_userbyid(relowner) FROM pg_class WHERE relname = 'ro_st_id_seq';
}
expect {
    ro_after_rename
}

test a-serial-sequence-keeps-refusing-its-own-owner-to-after-a-rename {
    CREATE ROLE ro_after_rename2;
    CREATE TABLE ro_st2 (id serial);
    ALTER TABLE ro_st2 RENAME TO ro_su2;
    ALTER SEQUENCE ro_st2_id_seq OWNER TO ro_after_rename2;
}
@sqlstate 0A000
expect error {
    cannot change owner of sequence "ro_st2_id_seq"
}

test a-sequence-named-like-a-serial-one-is-not-the-tables {
    CREATE ROLE ro_named_like;
    CREATE SEQUENCE ro_nl_a_seq;
    CREATE TABLE ro_nl (a int DEFAULT nextval('ro_nl_a_seq'));
    ALTER SEQUENCE ro_nl_a_seq OWNER TO ro_named_like;
    SELECT pg_get_userbyid(relowner) FROM pg_class WHERE relname = 'ro_nl_a_seq';
}
expect {
    ro_named_like
}

test owned-by-links-a-sequence-to-a-table {
    CREATE ROLE ro_linked;
    CREATE SEQUENCE ro_link_seq;
    CREATE TABLE ro_link_t (a int);
    ALTER SEQUENCE ro_link_seq OWNED BY ro_link_t.a;
    ALTER TABLE ro_link_t OWNER TO ro_linked;
    SELECT pg_get_userbyid(relowner) FROM pg_class WHERE relname = 'ro_link_seq';
}
expect {
    ro_linked
}

test owned-by-none-frees-a-serial-sequence {
    CREATE ROLE ro_freed;
    CREATE TABLE ro_free_t (id serial);
    ALTER SEQUENCE ro_free_t_id_seq OWNED BY NONE;
    ALTER SEQUENCE ro_free_t_id_seq OWNER TO ro_freed;
    SELECT pg_get_userbyid(relowner) FROM pg_class WHERE relname = 'ro_free_t_id_seq';
}
expect {
    ro_freed
}

test owned-by-refuses-a-table-of-another-owner {
    CREATE ROLE ro_other_owner;
    CREATE SEQUENCE ro_mismatch_seq;
    CREATE TABLE ro_mismatch_t (a int);
    ALTER TABLE ro_mismatch_t OWNER TO ro_other_owner;
    ALTER SEQUENCE ro_mismatch_seq OWNED BY ro_mismatch_t.a;
}
@sqlstate 55000
expect error {
    sequence must have same owner as table it is linked to
}

test owned-by-a-missing-table-is-an-error {
    CREATE SEQUENCE ro_orphan_seq;
    ALTER SEQUENCE ro_orphan_seq OWNED BY ro_no_such_table.a;
}
@sqlstate 42P01
expect error {
    relation "ro_no_such_table" does not exist
}

test owned-by-a-missing-column-is-an-error {
    CREATE SEQUENCE ro_orphan_seq2;
    CREATE TABLE ro_has_no_b (a int);
    ALTER SEQUENCE ro_orphan_seq2 OWNED BY ro_has_no_b.b;
}
@sqlstate 42703
expect error {
    column "b" of relation "ro_has_no_b" does not exist
}

test a-sequence-named-like-an-engine-table-is-a-relation-of-its-own {
    CREATE ROLE ro_sqlite_named;
    CREATE SEQUENCE sqlite_ro_seq;
    ALTER SEQUENCE sqlite_ro_seq OWNER TO ro_sqlite_named;
    SELECT relkind, pg_get_userbyid(relowner) FROM pg_class WHERE relname = 'sqlite_ro_seq';
}
expect {
    S|ro_sqlite_named
}

test owner-to-the-owner-a-serial-sequence-has-changes-nothing {
    CREATE TABLE ro_same_owner (id serial);
    ALTER SEQUENCE ro_same_owner_id_seq OWNER TO postgres;
    SELECT pg_get_userbyid(relowner) FROM pg_class WHERE relname = 'ro_same_owner_id_seq';
}
expect {
    postgres
}

test alter-index-owner-to-a-missing-role-is-an-error {
    CREATE TABLE ro_index_role (x int);
    CREATE INDEX ro_index_role_i ON ro_index_role (x);
    ALTER INDEX ro_index_role_i OWNER TO ro_no_such_role;
}
@sqlstate 42704
expect error {
    role "ro_no_such_role" does not exist
}

test the-owner-may-give-its-table-to-itself {
    CREATE ROLE ro_self;
    CREATE TABLE ro_self_t (x int);
    ALTER TABLE ro_self_t OWNER TO ro_self;
    SET ROLE ro_self;
    ALTER TABLE ro_self_t OWNER TO CURRENT_USER;
    SELECT pg_get_userbyid(relowner) FROM pg_class WHERE relname = 'ro_self_t';
}
expect {
    ro_self
}

test owner-to-public-is-an-error {
    CREATE TABLE ro_public_t (x int);
    ALTER TABLE ro_public_t OWNER TO public;
}
@sqlstate 42704
expect error {
    role "public" does not exist
}
