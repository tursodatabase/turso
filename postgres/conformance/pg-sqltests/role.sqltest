# CREATE ROLE through the PostgreSQL frontend.
# PostgreSQL roles belong to the whole server, not to one database, so every
# test uses its own role names.

@database :memory:

test bootstrap-superuser-is-postgres {
    SELECT rolname FROM pg_roles WHERE oid = 10 AND rolsuper;
}
expect {
    postgres
}

test pg-roles-does-not-list-public {
    SELECT count(*) FROM pg_roles WHERE rolname = 'public';
}
expect {
    0
}

test pg-get-userbyid-of-public-oid-is-unknown {
    SELECT pg_get_userbyid(0);
}
expect {
    unknown (OID=0)
}

test pg-get-userbyid-accepts-quoted-oid {
    SELECT pg_get_userbyid('10');
}
expect {
    postgres
}

test bootstrap-superuser-bypasses-row-level-security {
    SELECT count(*) FROM pg_roles WHERE oid = 10 AND rolbypassrls;
}
expect {
    1
}

test create-role-does-not-bypass-row-level-security {
    CREATE ROLE cr_no_bypassrls;
    SELECT count(*) FROM pg_roles WHERE rolname = 'cr_no_bypassrls' AND NOT rolbypassrls;
}
expect {
    1
}

test pg-get-expr-shows-role-defaults-as-keywords {
    CREATE TABLE cu_role_defaults (owner TEXT DEFAULT current_user, creator TEXT DEFAULT session_user);
    SELECT pg_get_expr(d.adbin, d.adrelid)
    FROM pg_attrdef d JOIN pg_class c ON c.oid = d.adrelid
    WHERE c.relname = 'cu_role_defaults'
    ORDER BY d.adnum;
}
expect {
    CURRENT_USER
    SESSION_USER
}

test pg-get-expr-shows-each-role-keyword-as-written {
    CREATE TABLE cu_role_keywords (a TEXT DEFAULT current_user, b TEXT DEFAULT current_role, c TEXT DEFAULT user, d TEXT DEFAULT session_user);
    SELECT pg_get_expr(d.adbin, d.adrelid)
    FROM pg_attrdef d JOIN pg_class c ON c.oid = d.adrelid
    WHERE c.relname = 'cu_role_keywords'
    ORDER BY d.adnum;
}
expect {
    CURRENT_USER
    CURRENT_ROLE
    USER
    SESSION_USER
}

test role-keywords-name-the-superuser {
    SELECT current_user, current_role, user, session_user;
}
expect {
    postgres|postgres|postgres|postgres
}

test check-constraint-calls-current-user {
    CREATE TABLE cu_check (owner TEXT CHECK (owner = current_user));
    INSERT INTO cu_check VALUES ('postgres');
    SELECT owner FROM cu_check;
}
expect {
    postgres
}

test add-column-fills-existing-rows-with-current-user {
    CREATE TABLE cu_add_column (x int);
    INSERT INTO cu_add_column VALUES (1);
    ALTER TABLE cu_add_column ADD COLUMN owner TEXT DEFAULT current_user;
    SELECT x, owner FROM cu_add_column;
}
expect {
    1|postgres
}

test check-constraint-definitions-show-role-functions-as-keywords {
    CREATE TABLE cu_role_checks (owner TEXT CHECK (owner = current_user), creator TEXT CHECK (creator = session_user));
    SELECT CASE WHEN position('CURRENT_USER' in pg_get_constraintdef(con.oid)) > 0 THEN 'CURRENT_USER'
                WHEN position('SESSION_USER' in pg_get_constraintdef(con.oid)) > 0 THEN 'SESSION_USER' END,
           CASE WHEN position('CURRENT_USER' in pg_get_expr(con.conbin, con.conrelid)) > 0 THEN 'CURRENT_USER'
                WHEN position('SESSION_USER' in pg_get_expr(con.conbin, con.conrelid)) > 0 THEN 'SESSION_USER' END
    FROM pg_constraint con JOIN pg_class c ON c.oid = con.conrelid
    WHERE c.relname = 'cu_role_checks' AND con.contype = 'c'
    ORDER BY 1;
}
expect {
    CURRENT_USER|CURRENT_USER
    SESSION_USER|SESSION_USER
}

test create-role-named-postgres-fails {
    CREATE ROLE postgres;
}
expect error {
    role "postgres" already exists
}

test create-role-is-listed-in-pg-roles {
    CREATE ROLE cr_listed;
    SELECT rolname FROM pg_roles WHERE rolname = 'cr_listed';
}
expect {
    cr_listed
}

test acldefault-names-the-owner-by-role-name {
    CREATE ROLE cr_owner;
    SELECT acldefault('n', oid) FROM pg_roles WHERE rolname = 'cr_owner';
}
expect {
    {cr_owner=UC/cr_owner}
}

test acldefault-quotes-role-names-that-are-not-plain-identifiers {
    CREATE ROLE "cr acl,owner";
    CREATE ROLE "cr""acl";
    SELECT acldefault('n', oid) FROM pg_roles WHERE rolname = 'cr acl,owner';
    SELECT acldefault('n', oid) FROM pg_roles WHERE rolname = 'cr"acl';
}
expect {
    {"\"cr acl,owner\"=UC/\"cr acl,owner\""}
    {"\"cr\"\"acl\"=UC/\"cr\"\"acl\""}
}

test create-role-is-not-superuser-and-cannot-log-in {
    CREATE ROLE cr_defaults;
    SELECT count(*) FROM pg_roles
    WHERE rolname = 'cr_defaults' AND NOT rolsuper AND NOT rolcanlogin;
}
expect {
    1
}

test create-role-lowercases-unquoted-name {
    CREATE ROLE CR_Unquoted;
    SELECT rolname FROM pg_roles WHERE rolname = 'cr_unquoted';
}
expect {
    cr_unquoted
}

test create-role-keeps-case-of-quoted-name {
    CREATE ROLE "CR_Quoted";
    SELECT rolname FROM pg_roles WHERE rolname = 'CR_Quoted';
}
expect {
    CR_Quoted
}

test create-role-names-differing-only-in-case-are-different-roles {
    CREATE ROLE "cr_case";
    CREATE ROLE "CR_CASE";
    SELECT rolname FROM pg_roles WHERE lower(rolname) = 'cr_case' ORDER BY rolname;
}
expect {
    CR_CASE
    cr_case
}

test create-role-twice-fails {
    CREATE ROLE cr_twice;
    CREATE ROLE cr_twice;
}
expect error {
    role "cr_twice" already exists
}

test create-role-with-pg-prefix-fails {
    CREATE ROLE pg_cr_reserved;
}
expect error {
    role name "pg_cr_reserved" is reserved
}

test create-role-named-public-fails {
    CREATE ROLE public;
}
expect error {
    role name "public" is reserved
}

test create-role-rolled-back-is-not-listed {
    BEGIN;
    CREATE ROLE cr_rolled_back;
    ROLLBACK;
    SELECT count(*) FROM pg_roles WHERE rolname = 'cr_rolled_back';
}
expect {
    0
}

test create-role-committed-is-listed {
    BEGIN;
    CREATE ROLE cr_committed;
    COMMIT;
    SELECT rolname FROM pg_roles WHERE rolname = 'cr_committed';
}
expect {
    cr_committed
}

test set-role-changes-current-user {
    CREATE ROLE sr_current;
    SET ROLE sr_current;
    SELECT current_user;
}
expect {
    sr_current
}

test set-role-keeps-session-user {
    CREATE ROLE sr_session;
    SET ROLE sr_session;
    SELECT CASE WHEN session_user = 'sr_session' THEN 'changed' ELSE 'kept' END;
}
expect {
    kept
}

test reset-role-returns-to-session-user {
    CREATE ROLE sr_reset;
    SET ROLE sr_reset;
    RESET ROLE;
    SELECT CASE WHEN current_user = session_user THEN 'session user' ELSE 'other' END;
}
expect {
    session user
}

test set-role-none-returns-to-session-user {
    CREATE ROLE sr_none;
    SET ROLE sr_none;
    SET ROLE NONE;
    SELECT CASE WHEN current_user = session_user THEN 'session user' ELSE 'other' END;
}
expect {
    session user
}

test set-role-with-quoted-uppercase-setting-name-changes-current-user {
    CREATE ROLE sr_quoted_name;
    SET "ROLE" TO sr_quoted_name;
    SELECT current_user;
}
expect {
    sr_quoted_name
}

test reset-role-with-quoted-uppercase-setting-name-returns-to-session-user {
    CREATE ROLE sr_quoted_reset;
    SET ROLE sr_quoted_reset;
    RESET "ROLE";
    SELECT CASE WHEN current_user = session_user THEN 'session user' ELSE 'other' END;
}
expect {
    session user
}

test discard-all-returns-to-session-user {
    CREATE ROLE sr_discard;
    SET ROLE sr_discard;
    DISCARD ALL;
    SELECT CASE WHEN current_user = session_user THEN 'session user' ELSE 'other' END;
}
expect {
    session user
}

test set-role-in-rolled-back-transaction-is-undone {
    CREATE ROLE sr_rolled_back;
    BEGIN;
    SET ROLE sr_rolled_back;
    SELECT current_user;
    ROLLBACK;
    SELECT CASE WHEN current_user = session_user THEN 'session user' ELSE 'other' END;
}
expect {
    sr_rolled_back
    session user
}

test set-role-in-committed-transaction-is-kept {
    CREATE ROLE sr_committed;
    BEGIN;
    SET ROLE sr_committed;
    COMMIT;
    SELECT current_user;
}
expect {
    sr_committed
}

test set-role-to-role-created-in-rolled-back-transaction-is-undone {
    BEGIN;
    CREATE ROLE sr_created_and_rolled_back;
    SET ROLE sr_created_and_rolled_back;
    ROLLBACK;
    SELECT CASE WHEN current_user = session_user THEN 'session user' ELSE 'other' END;
}
expect {
    session user
}

test set-local-role-ends-at-commit {
    CREATE ROLE sr_local;
    BEGIN;
    SET LOCAL ROLE sr_local;
    SELECT current_user;
    COMMIT;
    SELECT CASE WHEN current_user = session_user THEN 'session user' ELSE 'other' END;
}
expect {
    sr_local
    session user
}

test set-local-role-outside-a-transaction-ends-with-its-statement {
    CREATE ROLE sr_local_outside;
    SET LOCAL ROLE sr_local_outside;
    SELECT CASE WHEN current_user = session_user THEN 'session user' ELSE 'other' END;
}
expect {
    session user
}

test rollback-to-savepoint-restores-the-role {
    CREATE ROLE sr_savepoint;
    BEGIN;
    SAVEPOINT s;
    SET ROLE sr_savepoint;
    SELECT current_user;
    ROLLBACK TO SAVEPOINT s;
    SELECT CASE WHEN current_user = session_user THEN 'session user' ELSE 'other' END;
    COMMIT;
}
expect {
    sr_savepoint
    session user
}

test show-role-names-the-role-set-with-set-role {
    CREATE ROLE sr_show;
    SHOW role;
    SET ROLE sr_show;
    SHOW role;
    SELECT current_setting('role');
}
expect {
    none
    sr_show
    sr_show
}

test set-config-sets-the-role {
    CREATE ROLE sr_set_config;
    SELECT set_config('role', 'sr_set_config', false);
    SELECT current_user;
}
expect {
    sr_set_config
    sr_set_config
}

test reset-all-keeps-the-role {
    CREATE ROLE sr_reset_all;
    SET ROLE sr_reset_all;
    RESET ALL;
    SELECT current_user;
}
expect {
    sr_reset_all
}

test set-role-to-missing-role-fails {
    SET ROLE sr_missing;
}
expect error {
    role "sr_missing" does not exist
}

test set-role-public-fails {
    SET ROLE public;
}
expect error {
    role "public" does not exist
}

test role-without-privileges-can-select-without-tables {
    CREATE ROLE sr_no_tables;
    SET ROLE sr_no_tables;
    SELECT 1 + 1, upper('x');
}
expect {
    2|X
}

test role-without-privileges-cannot-create-table {
    CREATE ROLE sr_creator;
    SET ROLE sr_creator;
    CREATE TABLE sr_created (x int);
}
expect error {
    permission denied for schema public
}

test role-without-privileges-cannot-insert-rows {
    CREATE TABLE rw_insert (x int);
    INSERT INTO rw_insert VALUES (1);
    CREATE ROLE rw_inserter;
    SET ROLE rw_inserter;
    INSERT INTO rw_insert VALUES (1);
}
expect error {
    permission denied for table rw_insert
}

test role-without-privileges-cannot-update-rows {
    CREATE TABLE rw_update (x int);
    INSERT INTO rw_update VALUES (1);
    CREATE ROLE rw_updateer;
    SET ROLE rw_updateer;
    UPDATE rw_update SET x = 2;
}
expect error {
    permission denied for table rw_update
}

test role-without-privileges-cannot-delete-rows {
    CREATE TABLE rw_delete (x int);
    INSERT INTO rw_delete VALUES (1);
    CREATE ROLE rw_deleteer;
    SET ROLE rw_deleteer;
    DELETE FROM rw_delete;
}
expect error {
    permission denied for table rw_delete
}

test role-without-privileges-cannot-truncate-rows {
    CREATE TABLE rw_truncate (x int);
    INSERT INTO rw_truncate VALUES (1);
    CREATE ROLE rw_truncateer;
    SET ROLE rw_truncateer;
    TRUNCATE rw_truncate;
}
expect error {
    permission denied for table rw_truncate
}

test role-without-privileges-cannot-call-nextval {
    CREATE SEQUENCE rw_nextval_seq;
    CREATE ROLE rw_nextval_caller;
    SET ROLE rw_nextval_caller;
    SELECT nextval('rw_nextval_seq');
}
expect error {
    permission denied for sequence rw_nextval_seq
}

test role-without-privileges-cannot-call-setval {
    CREATE SEQUENCE rw_setval_seq;
    CREATE ROLE rw_setval_caller;
    SET ROLE rw_setval_caller;
    SELECT setval('rw_setval_seq', 5);
}
expect error {
    permission denied for sequence rw_setval_seq
}

test role-without-privileges-cannot-drop-table {
    CREATE TABLE sr_drop (x int);
    CREATE ROLE sr_dropper;
    SET ROLE sr_dropper;
    DROP TABLE sr_drop;
}
expect error {
    must be owner of table sr_drop
}

test role-without-privileges-cannot-comment-on-table {
    CREATE TABLE sr_commented (x int);
    CREATE ROLE sr_commenter;
    SET ROLE sr_commenter;
    COMMENT ON TABLE sr_commented IS 'x';
}
expect error {
    must be owner of table sr_commented
}

test role-without-privileges-cannot-comment-on-column {
    CREATE TABLE sr_column_commented (x int);
    CREATE ROLE sr_column_commenter;
    SET ROLE sr_column_commenter;
    COMMENT ON COLUMN sr_column_commented.x IS 'x';
}
expect error {
    must be owner of relation sr_column_commented
}

test role-without-privileges-cannot-create-role {
    CREATE ROLE sr_role_creator;
    SET ROLE sr_role_creator;
    CREATE ROLE sr_role_created;
}
expect error {
    permission denied to create role
}

test reset-role-restores-superuser-privileges {
    CREATE TABLE sr_restore (x int);
    INSERT INTO sr_restore VALUES (1);
    CREATE ROLE sr_restorer;
    SET ROLE sr_restorer;
    RESET ROLE;
    SELECT x FROM sr_restore;
}
expect {
    1
}

test pg-tables-does-not-list-the-roles-table {
    CREATE ROLE pt_role;
    SELECT count(*) FROM pg_tables WHERE tablename LIKE '%roles%';
}
expect {
    0
}

test pg-get-indexdef-finds-index-after-create-role {
    CREATE TABLE gi_table (x int);
    CREATE INDEX gi_index ON gi_table (x);
    CREATE ROLE gi_role;
    SELECT CASE
        WHEN pg_get_indexdef(i.indexrelid) LIKE 'CREATE INDEX gi_index ON %' THEN 'found'
        ELSE 'missing'
    END
    FROM pg_index i JOIN pg_class c ON c.oid = i.indexrelid
    WHERE c.relname = 'gi_index';
}
expect {
    found
}

test pg-get-constraintdef-finds-constraint-after-create-role {
    CREATE TABLE gc_table (x int PRIMARY KEY);
    CREATE ROLE gc_role;
    SELECT pg_get_constraintdef(oid) FROM pg_constraint WHERE conname = 'gc_table_pkey';
}
expect {
    PRIMARY KEY (x)
}

test role-without-privileges-can-read-catalogs {
    CREATE TABLE rc_table (x int);
    CREATE ROLE rc_reader;
    SET ROLE rc_reader;
    SELECT CASE WHEN count(*) > 0 THEN 'readable' ELSE 'empty' END FROM pg_roles;
    SELECT CASE WHEN count(*) > 0 THEN 'readable' ELSE 'empty' END FROM pg_class;
}
expect {
    readable
    readable
}
