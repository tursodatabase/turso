# Which catalog tables a role that is not a superuser may read through the
# PostgreSQL frontend.
# PostgreSQL roles belong to the whole server, not to one database, so every
# test uses its own role names.

@database :memory:

test role-without-privileges-can-read-catalogs {
    CREATE TABLE rc_table (x int);
    CREATE ROLE rc_reader;
    SET ROLE rc_reader;
    SELECT CASE WHEN count(*) > 0 THEN 'readable' ELSE 'empty' END FROM pg_roles;
    SELECT CASE WHEN count(*) > 0 THEN 'readable' ELSE 'empty' END FROM pg_class;
}
expect {
    readable
    readable
}

test role-reads-the-privileges-of-a-table-in-relacl {
    CREATE ROLE ca_relacl_reader;
    CREATE TABLE ca_relacl (id INT);
    GRANT SELECT ON ca_relacl TO ca_relacl_reader;
    SET ROLE ca_relacl_reader;
    SELECT relacl FROM pg_class WHERE relname = 'ca_relacl';
}
expect {
    {postgres=arwdDxtm/postgres,ca_relacl_reader=r/postgres}
}

# The engine keeps its catalogs, such as the roles and the privileges of
# each table, in __turso_internal_* tables, which only a superuser uses.
@skip-if postgres "PostgreSQL has no __turso_internal_* tables"
test role-cannot-read-the-engine-catalog-tables {
    CREATE ROLE gs_catalog_reader;
    SET ROLE gs_catalog_reader;
    SELECT * FROM pg_catalog.__turso_internal_classes;
}
@sqlstate 42501
expect error {
    permission denied for table __turso_internal_classes
}

@skip-if postgres "PostgreSQL has no __turso_internal_* tables"
test superuser-reads-the-engine-catalog-tables {
    CREATE ROLE gs_catalog_listed;
    SELECT rolname FROM pg_catalog.__turso_internal_authid WHERE rolname = 'gs_catalog_listed';
}
expect {
    gs_catalog_listed
}

@skip-if postgres "PostgreSQL has no sqlite_sequence table"
test role-cannot-read-sqlite-sequence {
    CREATE ROLE gs_sequence_reader;
    SET ROLE gs_sequence_reader;
    SELECT * FROM pg_catalog.sqlite_sequence;
}
@sqlstate 42501
expect error {
    permission denied for table sqlite_sequence
}
