# What the privileges on a schema let a role do through the PostgreSQL
# frontend. Creating, renaming or indexing a table needs CREATE on its schema.
# PostgreSQL roles belong to the whole server, not to one database, so every
# test uses its own role names.

@database :memory:

test role-without-privileges-cannot-create-table {
    CREATE ROLE sr_creator;
    SET ROLE sr_creator;
    CREATE TABLE sr_created (x int);
}
expect error {
    permission denied for schema public
}

test role-without-privileges-cannot-create-view {
    CREATE ROLE sc_view_creator;
    SET ROLE sc_view_creator;
    CREATE VIEW sc_created_view AS SELECT 1;
}
@sqlstate 42501
expect error {
    permission denied for schema public
}

test role-without-privileges-cannot-create-sequence {
    CREATE ROLE sc_sequence_creator;
    SET ROLE sc_sequence_creator;
    CREATE SEQUENCE sc_created_sequence;
}
@sqlstate 42501
expect error {
    permission denied for schema public
}

test owner-may-not-rename-without-create-on-the-schema {
    CREATE ROLE ro_renamer2;
    CREATE TABLE ro_owned_rename (x int);
    ALTER TABLE ro_owned_rename OWNER TO ro_renamer2;
    SET ROLE ro_renamer2;
    ALTER TABLE ro_owned_rename RENAME TO ro_owned_renamed;
}
@sqlstate 42501
expect error {
    permission denied for schema public
}

test owner-may-not-index-without-create-on-the-schema {
    CREATE ROLE ro_indexer2;
    CREATE TABLE ro_owned_index (x int);
    ALTER TABLE ro_owned_index OWNER TO ro_indexer2;
    SET ROLE ro_indexer2;
    CREATE INDEX ro_owned_index_i ON ro_owned_index (x);
}
@sqlstate 42501
expect error {
    permission denied for schema public
}
