    1
}

@setup oid_paths
test oid-equals-any-of-integers {
    SELECT count(*) FROM t WHERE o = ANY (ARRAY[-1]);
}
expect {
    1
}

@compat-gap "operator:oid = int4"
@setup oid_paths
test oid-in-subquery-of-integer-column {
    SELECT count(*) FROM t WHERE o IN (SELECT i FROM t);
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type oid with type int4
}

