@database :memory:

# An operator runs only when pg_operator has a row for the types of its
# operands. PostgreSQL fails with 42883 otherwise.

setup operands {
    CREATE TABLE operands (
        i integer, i2 smallint, i8 bigint, n numeric, f double precision,
        s text, v varchar(20), b boolean, d date, ts timestamp,
        tz timestamptz, u uuid
    );
    INSERT INTO operands VALUES (
        1, 2, 3, 4.5, 5.5, '1', '1', true, '2024-01-05', '2024-01-05 10:00:00',
        '2024-01-05 10:00:00+00', 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'
    );
}

@setup operands
test text-equals-integer-errors {
    SELECT s = 1 FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: text = integer
}

@setup operands
test integer-less-than-text-errors {
    SELECT i < s FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: integer < text
}

@setup operands
test bigint-equals-text-errors {
    SELECT i8 = s FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: bigint = text
}

@setup operands
test varchar-equals-integer-errors {
    SELECT v = 1 FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: character varying = integer
}

test boolean-equals-integer-errors {
    SELECT true = 1;
}
@sqlstate 42883
expect error {
    operator does not exist: boolean = integer
}

@setup operands
test integer-greater-than-boolean-errors {
    SELECT i > b FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: integer > boolean
}

@setup operands
test timestamptz-greater-than-integer-errors {
    SELECT tz > 5 FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: timestamp with time zone > integer
}

@setup operands
test timestamp-equals-text-errors {
    SELECT ts = s FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: timestamp without time zone = text
}

@setup operands
test date-not-equal-to-boolean-errors {
    SELECT d <> b FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: date <> boolean
}

@setup operands
test uuid-equals-integer-errors {
    SELECT u = 1 FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: uuid = integer
}

@setup operands
test uuid-less-than-varchar-errors {
    SELECT u < v FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: uuid < character varying
}

# BETWEEN compares with >= and then <=.
@setup operands
test text-between-integers-errors {
    SELECT s BETWEEN 1 AND 2 FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: text >= integer
}

# IN compares with = for each value.
@setup operands
test text-in-a-list-of-integers-errors {
    SELECT s IN (1, 2) FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: text = integer
}

# The operator is refused when the statement is planned, so a condition that
# no row reaches fails too.
@setup operands
test operator-that-no-row-reaches-errors {
    SELECT i FROM operands WHERE false AND s = 1;
}
@sqlstate 42883
expect error {
    operator does not exist: text = integer
}

@setup operands
test join-on-text-and-integer-errors {
    SELECT 1 FROM operands a JOIN operands b ON a.s = b.i;
}
@sqlstate 42883
expect error {
    operator does not exist: text = integer
}

@setup operands
test update-where-text-equals-integer-errors {
    UPDATE operands SET i = 2 WHERE s = 1;
}
@sqlstate 42883
expect error {
    operator does not exist: text = integer
}

@setup operands
test varchar-plus-integer-errors {
    SELECT v + 1 FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: character varying \+ integer
}

@setup operands
test boolean-plus-integer-errors {
    SELECT b + 1 FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: boolean \+ integer
}

@setup operands
test boolean-plus-string-literal-errors {
    SELECT b + '1' FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: boolean \+ unknown
}

@setup operands
test date-plus-date-errors {
    SELECT d + d FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: date \+ date
}

@setup operands
test timestamp-times-integer-errors {
    SELECT ts * 2 FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: timestamp without time zone \* integer
}

@setup operands
test integer-bitwise-and-boolean-errors {
    SELECT i & b FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: integer & boolean
}

@setup operands
test negated-date-errors {
    SELECT -d FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: - date
}

@setup operands
test bitwise-not-of-boolean-errors {
    SELECT ~b FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: ~ boolean
}

# Number types are compared and computed with each other.
@setup operands
test number-types-have-operators-with-each-other {
    SELECT i = i8, i2 < i, i8 > n, n < f, i + i2, i8 * i, i2 - i8, n + i, f > i
    FROM operands;
}
expect {
    f|f|f|t|3|3|-1|5.5|t
}

@setup operands
test text-and-varchar-are-compared {
    SELECT s = v, v < s, v = 'x' FROM operands;
}
expect {
    t|f|f
}

@setup operands
test uuid-is-compared-with-a-uuid {
    SELECT u = 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'::uuid,
           u = CAST('b0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11' AS uuid),
           u = gen_random_uuid(),
           u IN (gen_random_uuid())
    FROM operands;
}
expect {
    t|f|f|f
}

@setup operands
test date-has-arithmetic-with-integers {
    SELECT d + 1, d - 1, d - '2024-01-01'::date, 1 + d FROM operands;
}
expect {
    2024-01-06|2024-01-04|4|2024-01-06
}

@setup operands
test boolean-is-compared-with-a-condition {
    SELECT b = (i < 2), b > (i > 2), b <> false FROM operands;
}
expect {
    t|t|t
}

@setup operands
test timestamps-are-compared-with-their-own-type {
    SELECT tz = now(), ts < localtimestamp, d <= current_date, tz BETWEEN tz AND now()
    FROM operands;
}
expect {
    f|t|t|t
}

# tursopg does not check an operand that is a subquery, or that reads a
# column of a subquery or of a catalog table.
@compat-gap "operator:text = int4"
@setup operands
test text-equals-integer-subquery-errors {
    SELECT s = (SELECT 1) FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: text = integer
}
expect @tursopg {
    t
}

# The catalog tables of tursopg declare some columns with another type than
# PostgreSQL, so their operators are not checked.
test catalog-columns-are-compared-with-values-of-their-type {
    SELECT count(*) FROM pg_attribute
    WHERE attnotnull = true AND attisdropped = false AND attnum = 0;
}
expect {
    0
}

@setup operands
test unary-minus-of-boolean-errors {
    SELECT -b FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: - boolean
}

@setup operands
test case-with-a-base-refuses-text-and-integer {
    SELECT CASE s WHEN 1 THEN 'one' ELSE 'other' END FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: text = integer
}

@setup operands
test nullif-refuses-text-and-integer {
    SELECT NULLIF(s, 1) FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: text = integer
}

@setup operands
test row-values-compare-each-pair {
    SELECT (i, s) = ('1', '1'), (i, i8) < ('2', '1') FROM operands;
}
expect {
    t|t
}

@setup operands
test row-values-refuse-a-pair-that-is-text-and-integer {
    SELECT (i, s) = (1, 1) FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: text = integer
}

@setup operands
test in-subquery-compares-integer-and-smallint {
    SELECT i IN (SELECT i2 FROM operands) FROM operands;
}
expect {
    f
}

@setup operands
test in-subquery-refuses-integer-and-selected-text {
    SELECT i IN (SELECT 'a') FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: integer = text
}

@setup operands
test in-subquery-refuses-text-and-integer {
    SELECT s IN (SELECT i FROM operands) FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: text = integer
}

# Core's operator signatures decide the arithmetic and bit operators of a
# date and of a numeric with a precision. pg_operator decides every comparison.

setup registered {
    CREATE TABLE registered (d date, n numeric(10, 2), f double precision, i integer, u uuid);
}

@setup registered
test date-plus-uuid-errors {
    SELECT d + u FROM registered;
}
@sqlstate 42883
expect error {
    operator does not exist: date \+ uuid
}

@setup registered
test numeric-bit-and-errors {
    SELECT n & 1 FROM registered;
}
@sqlstate 42883
expect error {
    operator does not exist: numeric & integer
}

@setup registered
test date-less-than-integer-errors {
    SELECT d < 1 FROM registered;
}
@sqlstate 42883
expect error {
    operator does not exist: date < integer
}

@setup registered
test numeric-modulo-double-precision-errors {
    SELECT n % f FROM registered;
}
@sqlstate 42883
expect error {
    operator does not exist: numeric % double precision
}
@sqlstate 42883
expect @tursopg error {
    operator does not exist: numeric % real
}

# tursopg gives the type text to a jsonb or inet value that a cast returns.
# Those types have a `+` or a `-`, so tursopg does not refuse the arithmetic
# of text.
@compat-gap "operator:text + int4"
@setup operands
test text-plus-integer-errors {
    SELECT s + 1 FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: text \+ integer
}
expect @tursopg {
    2
}

# tursopg does not know the implicit casts of PostgreSQL, so it runs an
# operator on two number types when pg_operator has it for any number types.
@compat-gap "operator:float8 % int4"
@setup operands
test double-precision-modulo-integer-errors {
    SELECT f % 2 FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: double precision % integer
}
expect @tursopg {
    1.0
}

# tursopg gives the type text to a uuid that a cast returns, so it compares a
# uuid with text.
@compat-gap "operator:uuid = text"
@setup operands
test uuid-equals-text-errors {
    SELECT u = s FROM operands;
}
@sqlstate 42883
expect error {
    operator does not exist: uuid = text
}
expect @tursopg {
    f
}

