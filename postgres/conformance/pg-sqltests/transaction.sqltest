# Transaction control through the PostgreSQL frontend.

@database :memory:

setup counter {
    CREATE TABLE counter (n int);
    INSERT INTO counter VALUES (0);
}

@setup counter
test txn-commit-persists {
    BEGIN;
    UPDATE counter SET n = 1;
    COMMIT;
    SELECT n FROM counter;
}
expect {
    1
}

@setup counter
test txn-rollback-discards {
    BEGIN;
    UPDATE counter SET n = 1;
    ROLLBACK;
    SELECT n FROM counter;
}
expect {
    0
}

@setup counter
test txn-rollback-insert {
    BEGIN;
    INSERT INTO counter VALUES (99);
    ROLLBACK;
    SELECT count(*) FROM counter;
}
expect {
    1
}

@setup counter
test txn-set-transaction-options-rollback {
    BEGIN;
    SET TRANSACTION ISOLATION LEVEL REPEATABLE READ, READ ONLY;
    SET TRANSACTION READ WRITE;
    SET TRANSACTION ISOLATION LEVEL SERIALIZABLE, NOT DEFERRABLE;
    SELECT 17;
    UPDATE counter SET n = 23;
    ROLLBACK;
    SELECT n FROM counter;
}
expect {
    17
    0
}

@setup counter
test txn-set-transaction-read-write-keeps-earlier-changes {
    BEGIN;
    UPDATE counter SET n = 29;
    SET TRANSACTION READ WRITE;
    COMMIT;
    SELECT n FROM counter;
}
expect {
    29
}

test txn-set-transaction-lowercase-and-newline {
    BEGIN;
      set
    transaction read only;
    SELECT 17;
    ROLLBACK;
}
expect {
    17
}

@setup counter
test txn-access-share-lock-preserves-transaction {
    CREATE TABLE t2 (a int);
    BEGIN;
    UPDATE counter SET n = 29;
    LOCK TABLE public.counter, ONLY public.t2 IN ACCESS SHARE MODE;
    SELECT n FROM counter;
    ROLLBACK;
    SELECT n FROM counter;
}
expect {
    29
    0
}

setup times {
    CREATE TABLE times (a timestamptz, b timestamptz);
}

@setup times
test now-is-the-same-for-every-row-of-a-statement {
    INSERT INTO times SELECT now(), now() FROM (VALUES (1), (2), (3)) AS v;
    SELECT count(*) FROM times WHERE a = b;
    SELECT count(DISTINCT a) FROM times;
}
expect {
    3
    1
}

@setup times
test now-is-the-start-of-the-transaction-block {
    BEGIN;
    INSERT INTO times VALUES (now(), transaction_timestamp());
    INSERT INTO times VALUES (now(), now());
    SELECT count(*) FROM times WHERE a = now() AND b = now();
    COMMIT;
    SELECT count(DISTINCT a) FROM times;
}
expect {
    2
    1
}
