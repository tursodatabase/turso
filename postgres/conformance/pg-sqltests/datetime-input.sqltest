# The new column would have no type, so it could not be compared as a timestamptz.
test datetime-create-table-as-of-cast-literal {
    CREATE TABLE s AS SELECT '2020-01-01 00:00:00+00'::timestamptz AS z;
    SELECT count(*) FROM s;
}
expect {
    1
}

test datetime-create-table-as-of-now {
    CREATE TABLE s AS SELECT now() AS n;
    SELECT count(*) FROM s;
}
expect {
    1
}

test datetime-create-table-as-of-timestamptz-column {
    CREATE TABLE events (id int, created_at timestamptz);
    INSERT INTO events VALUES (1, '2024-01-05 10:00+00');
    CREATE TABLE s AS SELECT created_at FROM events;
    SELECT count(*) FROM s;
}
expect {
    1
}

test datetime-create-table-as-of-star-with-timestamp-column {
    CREATE TABLE events (id int, created_at timestamp);
    INSERT INTO events VALUES (1, '2024-01-05 10:00');
    CREATE TABLE s AS SELECT * FROM events;
    SELECT count(*) FROM s;
}
expect {
    1
}

test datetime-create-table-as-of-union-with-timestamptz {
    CREATE TABLE events (id int, created_at timestamptz);
    CREATE TABLE s AS SELECT NULL UNION ALL SELECT created_at FROM events;
    SELECT count(*) FROM s;
}
expect {
    1
}

# PostgreSQL reads these, so Turso refuses them with 0A000, not 22007.
test datetime-input-special-values-are-not-supported {
    SELECT 'infinity'::timestamptz, 'epoch'::timestamptz;
}
expect {
    infinity|1970-01-01 00:00:00+00
}
@sqlstate 0A000
expect @tursopg error {
    the timestamp with time zone value "infinity" is not supported
}

test datetime-input-time-zone-name-is-not-supported {
    SELECT '2024-01-05 10:00 America/New_York'::timestamptz;
}
expect {
    2024-01-05 15:00:00+00
}
@sqlstate 0A000
expect @tursopg error {
    invalid or unsupported input for type timestamp with time zone: "2024-01-05 10:00 America/New_York"
}

test datetime-input-time-zone-abbreviation-is-not-supported {
    SELECT '2024-01-05 10:00 EST'::timestamptz;
}
expect {
    2024-01-05 15:00:00+00
}
@sqlstate 0A000
expect @tursopg error {
    invalid or unsupported input for type timestamp with time zone: "2024-01-05 10:00 EST"
}

test datetime-input-day-name-is-not-supported {
    SELECT 'Fri Jan 5 2024'::timestamp;
}
expect {
    2024-01-05 00:00:00
}
@sqlstate 0A000
expect @tursopg error {
    invalid or unsupported input for type timestamp: "Fri Jan 5 2024"
}

test datetime-input-month-day-year-is-not-supported {
    SELECT '01/05/2024'::timestamp;
}
expect {
    2024-01-05 00:00:00
}
@sqlstate 0A000
expect @tursopg error {
    invalid or unsupported input for type timestamp: "01/05/2024"
}

test datetime-input-bc-is-not-supported {
    SELECT '2024-01-05 10:00 BC'::timestamp;
}
expect {
    2024-01-05 10:00:00 BC
}
@sqlstate 0A000
expect @tursopg error {
    BC dates are not supported for type timestamp: "2024-01-05 10:00 BC"
}

test datetime-input-year-after-9999-is-not-supported {
    SELECT '10000-01-05'::timestamp;
}
expect {
    10000-01-05 00:00:00
}
@sqlstate 0A000
expect @tursopg error {
    years must be written with 4 digits, from 0001 to 9999: "10000-01-05"
}

test datetime-input-offset-into-year-0-is-not-supported {
    SELECT '0001-01-01 00:00+01'::timestamptz;
}
expect {
    0001-12-31 23:00:00+00 BC
}
@sqlstate 0A000
expect @tursopg error {
    timestamp with time zone values must be between years 0001 and 9999
}

test datetime-input-offset-into-year-10000-is-not-supported {
    SELECT '9999-12-31 23:00-02'::timestamptz;
}
expect {
    10000-01-01 01:00:00+00
}
@sqlstate 0A000
expect @tursopg error {
    timestamp with time zone values must be between years 0001 and 9999
}

test datetime-input-minutes-and-seconds-are-not-supported {
    SELECT '2024-01-05 10:00.5'::timestamp;
}
expect {
    2024-01-05 00:10:00.5
}
@sqlstate 0A000
expect @tursopg error {
    invalid or unsupported input for type timestamp: "2024-01-05 10:00.5"
}

test datetime-input-pg-input-is-valid-of-special-value-is-not-supported {
    SELECT pg_input_is_valid('infinity', 'timestamptz');
}
expect {
    t
}
@sqlstate 0A000
expect @tursopg error {
    the timestamp with time zone value "infinity" is not supported
}

# PostgreSQL rejects these too, so Turso gives the same SQLSTATE.
test datetime-input-two-dates-are-invalid {
    SELECT '2024-01-05 2024-01-06'::timestamp;
}
@sqlstate 22007
expect error {
    invalid input syntax for type timestamp: "2024-01-05 2024-01-06"
}

test datetime-input-year-0-is-out-of-range {
    SELECT '0000-01-05'::timestamp;
}
@sqlstate 22008
expect error {
    date/time field value out of range: "0000-01-05"
}

# PostgreSQL compares a timestamp with a timestamptz after converting the
# timestamp to a timestamptz in the session time zone, UTC here.
test datetime-input-timestamp-equals-timestamptz {
    CREATE TABLE a (ts timestamp);
    CREATE TABLE b (tz timestamptz);
    INSERT INTO a VALUES ('2024-01-05 10:00');
    INSERT INTO b VALUES ('2024-01-05 10:00+00'), ('2024-01-05 09:00+00'), ('2024-01-05 11:00+00');
    SELECT
        (SELECT count(*) FROM a WHERE ts = (SELECT tz FROM b WHERE tz = '2024-01-05 10:00+00')),
        (SELECT count(*) FROM a, b WHERE a.ts = b.tz),
        (SELECT count(*) FROM a JOIN b ON b.tz < a.ts),
        (SELECT count(*) FROM a JOIN b ON b.tz >= a.ts),
        (SELECT count(*) FROM a WHERE ts IN (SELECT tz FROM b)),
        (SELECT count(*) FROM a JOIN b ON b.tz BETWEEN a.ts AND '2024-01-05 12:00');
}
expect {
    1|1|1|2|1|2
}

test datetime-input-timestamp-literal-compares-with-timestamptz-literal {
    SELECT ('2024-01-05 10:00'::timestamp = '2024-01-05 10:00'::timestamptz)::int,
           ('2024-01-05 10:00'::timestamp < '2024-01-05 10:00'::timestamptz)::int,
           ('2024-01-05 10:00'::timestamp < '2024-01-05 10:00:00.5'::timestamptz)::int;
}
expect {
    1|0|1
}

test datetime-input-union-of-timestamp-and-timestamptz {
    CREATE TABLE a (ts timestamp);
    CREATE TABLE b (tz timestamptz);
    INSERT INTO a VALUES ('2024-01-05 10:00');
    INSERT INTO b VALUES ('2024-01-05 10:00+00'), ('2024-01-05 11:00+00');
    SELECT ts FROM a UNION SELECT tz FROM b ORDER BY 1;
}
expect {
    2024-01-05 10:00:00+00
    2024-01-05 11:00:00+00
}

test datetime-input-untyped-literal-in-timestamptz-array {
    SELECT array_to_json(ARRAY['2024-01-05'::timestamptz, '2024-01-06']),
           ARRAY['2024-01-05'::timestamp, '2024-01-06'];
}
expect {
    ["2024-01-05T00:00:00+00:00","2024-01-06T00:00:00+00:00"]|{"2024-01-05 00:00:00","2024-01-06 00:00:00"}
}
