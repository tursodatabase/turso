test datetime-input-rejects-fraction-past-midnight-timestamptz-23-59-60-5 {
    CREATE TABLE t(tz timestamptz);
    INSERT INTO t VALUES ('2024-01-05 23:59:60.5');
}
expect error {
    date/time field value out of range: "2024-01-05 23:59:60.5"
}

test datetime-input-rejects-fraction-past-midnight-timestamp-23-59-60-000001 {
    CREATE TABLE t(ts timestamp);
    INSERT INTO t VALUES ('2024-01-05 23:59:60.000001');
}
expect error {
    date/time field value out of range: "2024-01-05 23:59:60.000001"
}

test datetime-input-rejects-fraction-past-midnight-timestamp-24-00-00-1 {
    CREATE TABLE t(ts timestamp);
    INSERT INTO t VALUES ('2024-01-05 24:00:00.1');
}
expect error {
    date/time field value out of range: "2024-01-05 24:00:00.1"
}

test datetime-time-input-accepts-iso-date-before-time {
    CREATE TABLE t(id INTEGER PRIMARY KEY, tm time);
    INSERT INTO t VALUES (1, '2024-01-05 10:00');
    INSERT INTO t VALUES (2, '2024-1-5 10:00');
    INSERT INTO t VALUES (3, '2024-01-05 10:00:00+02');
    INSERT INTO t VALUES (4, '10:00');
    SELECT * FROM t ORDER BY id;
}
expect {
    1|10:00:00
    2|10:00:00
    3|10:00:00
    4|10:00:00
}
@sqlstate 0A000
expect @tursopg error {
    type "time" is not supported
}

test datetime-time-input-rejects-date-form-1 {
    CREATE TABLE t(tm time);
    INSERT INTO t VALUES ('Jan 5 2024 10:00');
}
expect error {
    invalid input syntax for type time: "Jan 5 2024 10:00"
}
@sqlstate 0A000
expect @tursopg error {
    type "time" is not supported
}

test datetime-time-input-rejects-date-form-2 {
    CREATE TABLE t(tm time);
    INSERT INTO t VALUES ('10:00 Jan 5 2024');
}
expect error {
    invalid input syntax for type time: "10:00 Jan 5 2024"
}
@sqlstate 0A000
expect @tursopg error {
    type "time" is not supported
}

