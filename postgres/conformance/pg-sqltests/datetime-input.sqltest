    CREATE TABLE t(d date);
    INSERT INTO t VALUES ('10:00 2024-01-05');
}
expect error {
    invalid input syntax for type date: "10:00 2024-01-05"
}
@sqlstate 0A000
expect @tursopg error {
    type "date" is not supported
