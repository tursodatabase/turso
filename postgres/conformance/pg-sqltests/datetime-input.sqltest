# Input forms of date, time, timestamp and timestamptz. The session time zone
# is UTC on both servers.

@database :memory:

test datetime-input-postgresql-forms {
    CREATE TABLE t (id int, d date, tm time, ts timestamp, tz timestamptz);
    INSERT INTO t VALUES (1, '2024-1-5', '9:30', '2024-1-5 10:00', '2024-1-5 10:00+00');
    INSERT INTO t VALUES (2, 'Jan 5 2024', '10:00 PM', 'Jan 5 2024 10:00', '2024-01-05T10:00:00+02');
    INSERT INTO t VALUES (3, '20240105', '12:00 AM', '2024-01-05T10:00', '2024-01-05 10:00:00+0530');
    INSERT INTO t VALUES (4, '5 January, 2024', 'allballs', '2024/01/05 10:00:00Z', '2024-01-05 10:00:00-05:00');
    SELECT * FROM t ORDER BY id;
}
expect {
    1|2024-01-05|09:30:00|2024-01-05 10:00:00|2024-01-05 10:00:00+00
    2|2024-01-05|22:00:00|2024-01-05 10:00:00|2024-01-05 08:00:00+00
    3|2024-01-05|00:00:00|2024-01-05 10:00:00|2024-01-05 04:30:00+00
    4|2024-01-05|00:00:00|2024-01-05 10:00:00|2024-01-05 15:00:00+00
}

test datetime-input-cast {
    SELECT '2024-1-5'::date, '9:30'::time, '2024-1-5 10:00'::timestamp;
}
expect {
    2024-01-05|09:30:00|2024-01-05 10:00:00
}

test datetime-input-keeps-microseconds {
    CREATE TABLE t (id int, tm time, ts timestamp, tz timestamptz);
    INSERT INTO t VALUES (1, '10:00:00.123456', '2024-01-05 10:00:00.123456', '2024-01-05 10:00:00.123456+00:00');
    INSERT INTO t VALUES (2, '10:00:00.0005', '2024-01-05 10:00:00.0005', '2024-01-05 10:00:00.500+00');
    INSERT INTO t VALUES (3, '10:00:00.0000025', '2024-01-05 10:00:00.1234575', '2024-01-05 23:59:59.9999995+00');
    SELECT * FROM t ORDER BY id;
}
expect {
    1|10:00:00.123456|2024-01-05 10:00:00.123456|2024-01-05 10:00:00.123456+00
    2|10:00:00.0005|2024-01-05 10:00:00.0005|2024-01-05 10:00:00.5+00
    3|10:00:00.000002|2024-01-05 10:00:00.123458|2024-01-06 00:00:00+00
}

test datetime-input-unique-microseconds {
    CREATE TABLE u (id int, tm time UNIQUE, ts timestamp UNIQUE);
    INSERT INTO u VALUES (1, '10:00:00', '2024-01-05 10:00:00');
    INSERT INTO u VALUES (2, '10:00:00.0001', '2024-01-05 10:00:00.0001');
    SELECT count(*) FROM u;
}
expect {
    2
}

test datetime-input-offsets {
    CREATE TABLE t (id int, tm time, ts timestamp, tz timestamptz);
    INSERT INTO t VALUES (1, '10:00:00+02:00', '2024-01-05 10:00:00+02:00', '2024-01-05 10:00:00+02:00');
    INSERT INTO t VALUES (2, '10:00:00-05', '2024-01-05 01:00:00+02', '2024-01-05 01:00:00+02');
    SELECT * FROM t ORDER BY id;
}
expect {
    1|10:00:00|2024-01-05 10:00:00|2024-01-05 08:00:00+00
    2|10:00:00|2024-01-05 01:00:00|2024-01-04 23:00:00+00
}

test datetime-input-midnight-and-leap-second-carry {
    CREATE TABLE t (id int, tm time, ts timestamp);
    INSERT INTO t VALUES (1, '24:00:00', '2024-01-05 24:00:00');
    INSERT INTO t VALUES (2, '23:59:60', '2024-12-31 23:59:60');
    INSERT INTO t VALUES (3, '10:00:60', '2024-01-05 10:00:60');
    SELECT * FROM t ORDER BY id;
}
expect {
    1|24:00:00|2024-01-06 00:00:00
    2|24:00:00|2025-01-01 00:00:00
    3|10:01:00|2024-01-05 10:01:00
}

test datetime-input-rejects-feb-30 {
    CREATE TABLE t (d date);
    INSERT INTO t VALUES ('2024-02-30');
}
expect error {
    date/time field value out of range: "2024-02-30"
}

test datetime-input-rejects-feb-29-in-non-leap-year {
    CREATE TABLE t (ts timestamp);
    INSERT INTO t VALUES ('2023-02-29 00:00:00');
}
expect error {
    date/time field value out of range: "2023-02-29 00:00:00"
}

test datetime-input-rejects-24-00-01 {
    CREATE TABLE t (ts timestamp);
    INSERT INTO t VALUES ('2024-01-05 24:00:01');
}
expect error {
    date/time field value out of range: "2024-01-05 24:00:01"
}

test datetime-input-accepts-second-60-as-next-day {
    CREATE TABLE t(id INTEGER PRIMARY KEY, d date, ts timestamp, tz timestamptz);
    INSERT INTO t VALUES (1, '2024-01-05 23:59:60', '2024-01-05 23:59:60', '2024-01-05 23:59:60');
    SELECT * FROM t;
}
expect {
    1|2024-01-05|2024-01-06 00:00:00|2024-01-06 00:00:00+00
}

test datetime-input-rejects-fraction-past-midnight-timestamp-23-59-60-5 {
    CREATE TABLE t(ts timestamp);
    INSERT INTO t VALUES ('2024-01-05 23:59:60.5');
}
expect error {
    date/time field value out of range: "2024-01-05 23:59:60.5"
}

test datetime-input-rejects-fraction-past-midnight-date-23-59-60-5 {
    CREATE TABLE t(d date);
    INSERT INTO t VALUES ('2024-01-05 23:59:60.5');
}
expect error {
    date/time field value out of range: "2024-01-05 23:59:60.5"
}

test datetime-input-rejects-fraction-past-midnight-timestamptz-23-59-60-5 {
    CREATE TABLE t(tz timestamptz);
    INSERT INTO t VALUES ('2024-01-05 23:59:60.5');
}
expect error {
    date/time field value out of range: "2024-01-05 23:59:60.5"
