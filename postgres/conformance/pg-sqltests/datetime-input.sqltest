# The first SELECT of a recursive CTE gives a column its type, and NULL there
# is text.
@setup datetime-uses
test datetime-timestamptz-after-null-in-recursive-cte-is-refused {
    WITH RECURSIVE c(x, n) AS (SELECT NULL, 1 UNION ALL SELECT tz, n + 1 FROM r, c WHERE n < 2 AND r.id = 1) SELECT x FROM c;
}
@sqlstate 42804
expect error {
    recursive query "c" column 1 has type text in non-recursive term but type timestamp with time zone overall
}
@sqlstate 0A000
expect @tursopg error {
    comparing type timestamptz with type text is not supported
}

@setup datetime-uses
test datetime-timestamptz-in-recursive-cte {
    WITH RECURSIVE c(x, n) AS (SELECT tz, 1 FROM r WHERE id = 1 UNION ALL SELECT x, n + 1 FROM c WHERE n < 3) SELECT x, n FROM c ORDER BY n;
}
expect {
    2024-01-05 08:00:00+00|1
    2024-01-05 08:00:00+00|2
    2024-01-05 08:00:00+00|3
}

# A string literal in the recursive query is not converted to the type of the
# column, as in an arm of a compound SELECT.
@setup datetime-uses
test datetime-literal-in-recursive-query-of-timestamptz-cte-is-refused {
    WITH RECURSIVE c(x, n) AS (SELECT tz, 1 FROM r WHERE id = 1 UNION ALL SELECT '2024-01-01', n + 1 FROM c WHERE n < 2) SELECT x, n FROM c ORDER BY n;
}
expect {
    2024-01-05 08:00:00+00|1
    2024-01-01 00:00:00+00|2
}
@sqlstate 0A000
expect @tursopg error {
    comparing type timestamptz with type text is not supported
}

