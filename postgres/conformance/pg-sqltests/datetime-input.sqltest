@compat-gap "operator:date >= timestamp"
@setup datetime-compare-date-no-index
test datetime-compare-date-between-timestamps-scan {
    SELECT id FROM d WHERE d BETWEEN CAST('2024-01-04 12:00:00' AS timestamp) AND CAST('2024-01-06 00:00:00' AS timestamp) ORDER BY id;
}
expect {
    2
    3
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type date with type timestamp
