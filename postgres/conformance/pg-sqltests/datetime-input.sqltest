    CREATE TABLE t(d date);
    INSERT INTO t VALUES ('10:00 2024-01-05');
}
@sqlstate 22007
expect error {
    invalid input syntax for type date: "10:00 2024-01-05"
}

@compat-gap "type:time"
test datetime-input-rejects-order-time-after-am-pm-and-date {
    CREATE TABLE t(tm time);
    INSERT INTO t VALUES ('2024-01-05 PM 10:00');
}
@sqlstate 22007
expect error {
    invalid input syntax for type time: "2024-01-05 PM 10:00"
}
@sqlstate 0A000
expect @tursopg error {
    type "time" is not supported
}

# A timestamp compared with a timestamptz works in tursopg only because the
# session time zone is always UTC, so both store the same UTC text (a
# hard-coded exception, see timestamp_compared_with_timestamptz in
# core/translate/collate.rs). A UNION or JOIN USING of the two is still refused.

setup datetime-compare-ts-tz {
    CREATE TABLE a (id int, ts timestamp);
    CREATE TABLE b (id int, tz timestamptz);
    INSERT INTO a VALUES (1, '2024-01-05 09:00:00'), (2, '2024-01-05 10:00:00'), (3, '2024-01-05 11:00:00');
    INSERT INTO b VALUES (1, '2024-01-05 10:00:00+00'), (2, '2024-01-05 12:00:00+02');
}

@setup datetime-compare-ts-tz
test datetime-compare-timestamp-eq-timestamptz-scan {
    SELECT a.id, b.id FROM a, b WHERE a.ts = b.tz ORDER BY a.id, b.id;
}
expect {
    2|1
    2|2
}

# The index on b.tz makes the join a seek, and the IN forms compare the two
# types through an ephemeral index.
@setup datetime-compare-ts-tz
test datetime-compare-timestamp-timestamptz-seek-and-in {
    CREATE INDEX b_tz ON b (tz);
    SELECT a.id, b.id FROM a, b WHERE a.ts = b.tz ORDER BY a.id, b.id;
    SELECT id FROM a WHERE ts IN (SELECT tz FROM b);
    SELECT id FROM b WHERE tz IN (SELECT ts FROM a);
    SELECT a.id, b.id FROM a, b WHERE a.ts IN (b.tz, b.tz) ORDER BY a.id, b.id;
}
expect {
    2|1
    2|2
    2
    1
    2
    2|1
    2|2
}

# PostgreSQL refuses the comparison of a timestamp with a timestamptz in a
# generated column, an index expression and a partial index predicate, because
# its comparison functions are STABLE and these must be IMMUTABLE. A CHECK
# constraint allows it. (FIXME(pg-catalog): HACK, see
# refuse_timestamp_timestamptz_comparison_in_schema_expr in
# core/translate/collate.rs.)

test datetime-compare-ts-tz-generated-column-is-an-error {
    CREATE TABLE gc (ts timestamp, f boolean GENERATED ALWAYS AS (ts > '2026-01-01+00'::timestamptz) STORED);
}
@sqlstate 42P17
expect error {
    generation expression is not immutable
}

test datetime-compare-ts-tz-alter-add-generated-column-is-an-error {
    CREATE TABLE ga (ts timestamp);
    ALTER TABLE ga ADD COLUMN f boolean GENERATED ALWAYS AS (ts > '2026-01-01+00'::timestamptz) STORED;
}
@sqlstate 42P17
expect error {
    generation expression is not immutable
}

test datetime-compare-ts-tz-index-expression-is-an-error {
    CREATE TABLE ie (ts timestamp);
    CREATE INDEX ie_i ON ie ((ts > '2026-01-01+00'::timestamptz));
}
@sqlstate 42P17
expect error {
    functions in index expression must be marked IMMUTABLE
}

test datetime-compare-ts-tz-partial-index-is-an-error {
    CREATE TABLE ip (ts timestamp);
    CREATE INDEX ip_i ON ip (ts) WHERE ts > '2026-01-01+00'::timestamptz;
}
@sqlstate 42P17
expect error {
    functions in index predicate must be marked IMMUTABLE
}

test datetime-compare-ts-tz-index-expression-case-operand-is-an-error {
    CREATE TABLE ic (ts timestamp);
    CREATE INDEX ic_i ON ic ((CASE ts WHEN '2026-01-01+00'::timestamptz THEN 1 END));
}
@sqlstate 42P17
expect error {
    functions in index expression must be marked IMMUTABLE
}

test datetime-compare-ts-tz-partial-index-row-value-is-an-error {
    CREATE TABLE ir (ts timestamp, tz timestamptz);
    CREATE INDEX ir_i ON ir (ts) WHERE (ts, 1) = (tz, 1);
}
@sqlstate 42P17
expect error {
    functions in index predicate must be marked IMMUTABLE
}

test datetime-compare-ts-tz-check-constraint-is-allowed {
    CREATE TABLE ck (ts timestamp, CHECK (ts > '2026-01-01+00'::timestamptz));
    INSERT INTO ck VALUES ('2026-02-01 00:00:00');
    SELECT ts FROM ck;
}
expect {
    2026-02-01 00:00:00
}

@compat-gap "operator:timestamp UNION timestamptz"
@setup datetime-compare-ts-tz
test datetime-result-union {
    SELECT ts FROM a UNION SELECT tz FROM b ORDER BY 1;
}
expect {
    2024-01-05 09:00:00+00
    2024-01-05 10:00:00+00
    2024-01-05 11:00:00+00
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type timestamp with type timestamptz
}

@compat-gap "operator:timestamp JOIN USING timestamptz"
@setup datetime-compare-ts-tz
test datetime-result-join-using {
    CREATE TABLE u1 (k timestamp, v int);
    CREATE TABLE u2 (k timestamptz, w int);
    INSERT INTO u1 VALUES ('2024-01-05 10:00:00', 1);
    INSERT INTO u2 VALUES ('2024-01-05 10:00:00+00', 10);
    SELECT k FROM u1 JOIN u2 USING (k);
}
expect {
    2024-01-05 10:00:00+00
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type timestamp with type timestamptz
}

# PostgreSQL has no operator that compares a timestamptz with a varchar.
test datetime-compare-timestamptz-eq-varchar-is-an-error {
    CREATE TABLE tv (tz timestamptz, v varchar(40));
    INSERT INTO tv VALUES ('2024-01-05 02:00:00+02', '2024-01-05 02:00:00+02');
    SELECT tz = v FROM tv;
}
@sqlstate 42883
expect error {
    operator does not exist
}

# lag's result is one type in PostgreSQL: the timestamp rows convert to
# timestamptz, in the session time zone (UTC). tursopg refuses a result column
# that mixes the two types.
@compat-gap "function:lag"
test datetime-lag-timestamp-with-timestamptz-default {
    CREATE TABLE lg (i int, ts timestamp, tz timestamptz);
    INSERT INTO lg VALUES (1, '2024-01-01 00:00:00', '2024-06-01 00:00:00+00');
    INSERT INTO lg VALUES (2, '2024-01-02 00:00:00', '2024-06-02 00:00:00+00');
    SELECT lag(ts, 1, tz) OVER (ORDER BY i) FROM lg ORDER BY i;
}
expect {
    2024-06-01 00:00:00+00
    2024-01-01 00:00:00+00
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type timestamp with type timestamptz
}

# lead's result is one type in PostgreSQL: the timestamp rows convert to
# timestamptz, in the session time zone (UTC). tursopg refuses a result column
# that mixes the two types.
@compat-gap "function:lead"
test datetime-lead-timestamp-with-timestamptz-default {
    CREATE TABLE ld (i int, ts timestamp, tz timestamptz);
    INSERT INTO ld VALUES (1, '2024-01-01 00:00:00', '2024-06-01 00:00:00+00');
    INSERT INTO ld VALUES (2, '2024-01-02 00:00:00', '2024-06-02 00:00:00+00');
    SELECT lead(ts, 1, tz) OVER (ORDER BY i) FROM ld ORDER BY i;
}
expect {
    2024-01-02 00:00:00+00
    2024-06-02 00:00:00+00
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type timestamp with type timestamptz
}

# PostgreSQL has no casts between date or time types and numbers: the text of a
# date is not read as a number, which would give 2020.
test cast-date-to-integer-errors {
    SELECT date '2020-01-01'::int;
}
@sqlstate 42846
expect error {
    cannot cast
}

test cast-timestamptz-to-float8-errors {
    SELECT timestamptz '2020-01-01 00:00:00+00'::float8;
}
@sqlstate 42846
expect error {
    cannot cast
}

# PostgreSQL casts jsonb to numbers, unlike the types above.
test cast-jsonb-to-numbers {
    CREATE TABLE j (i jsonb, f jsonb);
    INSERT INTO j VALUES ('1', '1.5');
    SELECT i::int, i::bigint, f::numeric, f::float8 FROM j;
}
expect {
    1|1|1.5|1.5
}

test timestamptz-equality-across-offsets {
    SELECT '2026-10-08 14:00:00+02'::timestamptz = '2026-10-08 12:00:00Z'::timestamptz;
}
expect {
    t
}
