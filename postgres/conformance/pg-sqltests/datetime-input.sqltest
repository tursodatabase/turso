test datetime-input-rejects-order-2024-01-05-t-t10-00 {
    CREATE TABLE t(ts timestamp);
    INSERT INTO t VALUES ('2024-01-05 T T10:00');
}
expect error {
    invalid input syntax for type timestamp: "2024-01-05 T T10:00"
