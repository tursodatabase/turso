# A timestamp compared with a timestamptz fails in tursopg, where PostgreSQL
# reads the timestamp as a timestamptz in the session time zone. Stored
# timestamps and timestamptz values are different texts, so comparing them
# as stored would give wrong rows, with or without an index on either column;
# no rule says how one converts into the other, so the comparison is refused
# whichever way the query is run.

setup datetime-compare-ts-tz-no-index {
    CREATE TABLE a (id int, ts timestamp);
    CREATE TABLE b (id int, tz timestamptz);
    INSERT INTO a VALUES (1, '2024-01-05 09:00:00'), (2, '2024-01-05 10:00:00'), (3, '2024-01-05 11:00:00');
    INSERT INTO b VALUES (1, '2024-01-05 10:00:00+00'), (2, '2024-01-05 12:00:00+02');
}

setup datetime-compare-ts-tz-index {
    CREATE TABLE a (id int, ts timestamp);
    CREATE TABLE b (id int, tz timestamptz);
    CREATE INDEX a_ts ON a (ts);
    CREATE INDEX b_tz ON b (tz);
    INSERT INTO a VALUES (1, '2024-01-05 09:00:00'), (2, '2024-01-05 10:00:00'), (3, '2024-01-05 11:00:00');
    INSERT INTO b VALUES (1, '2024-01-05 10:00:00+00'), (2, '2024-01-05 12:00:00+02');
}

@compat-gap "operator:timestamp = timestamptz"
@setup datetime-compare-ts-tz-no-index
test datetime-compare-timestamp-eq-timestamptz-scan {
    SELECT a.id, b.id FROM a, b WHERE a.ts = b.tz ORDER BY a.id, b.id;
}
expect {
    2|1
    2|2
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type timestamp with type timestamptz
}

@compat-gap "operator:timestamp <> timestamptz"
@setup datetime-compare-ts-tz-no-index
test datetime-compare-timestamp-ne-timestamptz-scan {
    SELECT a.id, b.id FROM a, b WHERE a.ts <> b.tz ORDER BY a.id, b.id;
}
expect {
    1|1
    1|2
    3|1
    3|2
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type timestamp with type timestamptz
}

@compat-gap "operator:timestamp < timestamptz"
@setup datetime-compare-ts-tz-no-index
test datetime-compare-timestamp-lt-timestamptz-scan {
    SELECT a.id, b.id FROM a, b WHERE a.ts < b.tz ORDER BY a.id, b.id;
}
expect {
    1|1
    1|2
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type timestamp with type timestamptz
}

@compat-gap "operator:timestamp <= timestamptz"
@setup datetime-compare-ts-tz-no-index
test datetime-compare-timestamp-le-timestamptz-scan {
    SELECT a.id, b.id FROM a, b WHERE a.ts <= b.tz ORDER BY a.id, b.id;
}
expect {
    1|1
    1|2
    2|1
    2|2
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type timestamp with type timestamptz
}

@compat-gap "operator:timestamp > timestamptz"
@setup datetime-compare-ts-tz-no-index
test datetime-compare-timestamp-gt-timestamptz-scan {
    SELECT a.id, b.id FROM a, b WHERE a.ts > b.tz ORDER BY a.id, b.id;
}
expect {
    3|1
    3|2
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type timestamp with type timestamptz
}

@compat-gap "operator:timestamp >= timestamptz"
@setup datetime-compare-ts-tz-no-index
test datetime-compare-timestamp-ge-timestamptz-scan {
    SELECT a.id, b.id FROM a, b WHERE a.ts >= b.tz ORDER BY a.id, b.id;
}
expect {
    2|1
    2|2
    3|1
    3|2
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type timestamp with type timestamptz
}

