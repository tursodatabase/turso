# PostgreSQL has no operator that compares a timestamptz with a varchar.
# tursopg does not know which type pairs PostgreSQL compares, so it refuses
# every comparison of two different custom types with 0A000.
@compat-gap "operator:timestamptz = varchar"
test datetime-compare-timestamptz-eq-varchar-is-an-error {
    CREATE TABLE tv (tz timestamptz, v varchar(40));
    INSERT INTO tv VALUES ('2024-01-05 02:00:00+02', '2024-01-05 02:00:00+02');
    SELECT tz = v FROM tv;
}
@sqlstate 42883
expect error {
    operator does not exist
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type timestamptz with type varchar
}

@compat-gap "operator:timestamptz > varchar"
test datetime-compare-timestamptz-gt-varchar-is-an-error {
    CREATE TABLE tv (tz timestamptz, v varchar(40));
    INSERT INTO tv VALUES ('2024-01-05 02:00:00+02', '2024-01-05 02:00:00+02');
    SELECT tz > v FROM tv;
}
@sqlstate 42883
expect error {
    operator does not exist
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type timestamptz with type varchar
}

# lag's result is one type in PostgreSQL: the timestamp rows convert to
# timestamptz, in the session time zone (UTC).
@compat-gap "function:lag"
test datetime-lag-timestamp-with-timestamptz-default {
    CREATE TABLE lg (i int, ts timestamp, tz timestamptz);
    INSERT INTO lg VALUES (1, '2024-01-01 00:00:00', '2024-06-01 00:00:00+00');
    INSERT INTO lg VALUES (2, '2024-01-02 00:00:00', '2024-06-02 00:00:00+00');
    SELECT lag(ts, 1, tz) OVER (ORDER BY i) FROM lg ORDER BY i;
}
expect {
    2024-06-01 00:00:00+00
    2024-01-01 00:00:00+00
}
expect @tursopg {
    2024-06-01 00:00:00
    2024-01-01 00:00:00
}

# lead's result is one type in PostgreSQL: the timestamp rows convert to
# timestamptz, in the session time zone (UTC).
@compat-gap "function:lead"
test datetime-lead-timestamp-with-timestamptz-default {
    CREATE TABLE ld (i int, ts timestamp, tz timestamptz);
    INSERT INTO ld VALUES (1, '2024-01-01 00:00:00', '2024-06-01 00:00:00+00');
    INSERT INTO ld VALUES (2, '2024-01-02 00:00:00', '2024-06-02 00:00:00+00');
    SELECT lead(ts, 1, tz) OVER (ORDER BY i) FROM ld ORDER BY i;
}
expect {
    2024-01-02 00:00:00+00
    2024-06-02 00:00:00+00
}
expect @tursopg {
    2024-01-02 00:00:00
    2024-06-02 00:00:00
}
