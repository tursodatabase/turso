@sqlstate 0A000
expect @tursopg error {}

test datetime-input-rejects-order-10-00-2024-01-05 {
    CREATE TABLE t(ts timestamp);
    INSERT INTO t VALUES ('10:00 2024-01-05');
}
expect error {
    invalid input syntax for type timestamp: "10:00 2024-01-05"
