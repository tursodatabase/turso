test datetime-time-input-rejects-date-form-5 {
    CREATE TABLE t(tm time);
    INSERT INTO t VALUES ('20240105 10:00');
}
expect error {
    invalid input syntax for type time: "20240105 10:00"
}

# PostgreSQL accepts the values below. Turso stores these types as text that
# must sort in time order, which these values would not, so it rejects them.

@skip-if postgres "PostgreSQL accepts BC dates"
test datetime-input-rejects-bc {
    CREATE TABLE t (d date);
    INSERT INTO t VALUES ('0044-03-15 BC');
}
expect error {
    BC dates are not supported for type date
}

@skip-if postgres "PostgreSQL accepts years past 9999"
test datetime-input-rejects-year-past-9999 {
    CREATE TABLE t (ts timestamp);
    INSERT INTO t VALUES ('10000-01-01 00:00:00');
}
expect error {
    years must be written with 4 digits
}

@skip-if postgres "PostgreSQL accepts infinity"
test datetime-input-rejects-infinity {
    CREATE TABLE t (ts timestamp);
    INSERT INTO t VALUES ('infinity');
}
expect error {
    the timestamp value "infinity" is not supported
}

# PostgreSQL reads `z10` as a POSIX time zone 10 hours behind UTC, so this is
# midnight in that zone: 2024-01-05 00:00:00 as a timestamp. Time zones are not
# supported yet; reading `z` as UTC followed by 10:00 would give 10:00:00.

@skip-if postgres "PostgreSQL reads z10 as a time zone"
test datetime-input-rejects-posix-time-zone {
    CREATE TABLE t (ts timestamp);
    INSERT INTO t VALUES ('2024-01-05 z10:00');
}
expect error {
    invalid input syntax for type timestamp: "2024-01-05 z10:00"
}

# A string compared with a date or time column is read as a value of the
# column's type, in any input form, whether the query scans the table or
# seeks an index.

setup datetime-compare-no-index {
    CREATE TABLE c (id int, d date, ts timestamp, tz timestamptz);
    INSERT INTO c VALUES (1, '2024-01-05', '2024-01-05 10:00:00', '2024-01-05 10:00:00');
}

setup datetime-compare-index {
    CREATE TABLE c (id int, d date, ts timestamp, tz timestamptz);
    CREATE INDEX c_d ON c (d);
    CREATE INDEX c_ts ON c (ts);
    CREATE INDEX c_tz ON c (tz);
    INSERT INTO c VALUES (1, '2024-01-05', '2024-01-05 10:00:00', '2024-01-05 10:00:00');
}

@setup datetime-compare-no-index
test datetime-compare-timestamptz-eq-scan {
    SELECT id FROM c WHERE tz = '2024-01-05 10:00:00';
}
expect {
    1
}

@setup datetime-compare-index
test datetime-compare-timestamptz-eq-index {
    SELECT id FROM c WHERE tz = '2024-01-05 10:00:00';
}
expect {
    1
}

@setup datetime-compare-no-index
test datetime-compare-timestamptz-gt-scan {
    SELECT count(*) FROM c WHERE tz > '2024-01-05 10:00:00';
}
expect {
    0
}

@setup datetime-compare-index
test datetime-compare-timestamptz-gt-index {
    SELECT count(*) FROM c WHERE tz > '2024-01-05 10:00:00';
}
expect {
    0
}

@setup datetime-compare-no-index
test datetime-compare-timestamptz-between-scan {
    SELECT id FROM c WHERE tz BETWEEN '2024-01-05 09:00:00' AND '2024-01-05 10:00:00';
}
expect {
    1
}

@setup datetime-compare-index
test datetime-compare-timestamptz-between-index {
    SELECT id FROM c WHERE tz BETWEEN '2024-01-05 09:00:00' AND '2024-01-05 10:00:00';
}
expect {
    1
}

@setup datetime-compare-no-index
test datetime-compare-timestamp-t-form-scan {
    SELECT id FROM c WHERE ts > '2024-01-05T09:00';
}
expect {
    1
}

@setup datetime-compare-index
test datetime-compare-timestamp-t-form-index {
    SELECT id FROM c WHERE ts > '2024-01-05T09:00';
}
expect {
    1
}

@setup datetime-compare-no-index
test datetime-compare-date-month-name-scan {
    SELECT id FROM c WHERE d >= 'Jan 5 2024';
}
expect {
    1
}

@setup datetime-compare-index
test datetime-compare-date-month-name-index {
    SELECT id FROM c WHERE d >= 'Jan 5 2024';
}
expect {
    1
}

# With the session time zone UTC, a timestamp equals the timestamptz of the
# same wall-clock time.
@requires strict "uses STRICT tables"
test datetime-timestamp-equals-timestamptz {
    CREATE TABLE t(id INTEGER, ts timestamp, tz timestamptz) STRICT;
    INSERT INTO t VALUES (1, '2024-01-05 10:00:00', '2024-01-05 10:00:00');
    INSERT INTO t VALUES (2, '2024-01-05 10:00:00', '2024-01-05 10:00:00+02');
    SELECT id FROM t WHERE ts = tz;
}
expect {
    1
}

# The order of the fields matters: `T` needs a date before it and a time after it,
# it and a time after it, a date cannot follow a time, and the order of a
# date's numbers and month name is limited.
test datetime-input-field-order-accepted {
    CREATE TABLE t(id int, ts timestamp);
    INSERT INTO t VALUES (1, '2024-01-05T10:00');
    INSERT INTO t VALUES (2, '2024-01-05 T10:00');
    INSERT INTO t VALUES (3, '2024-01-05 T 10:00');
    INSERT INTO t VALUES (4, '2024-01-05 10:00 PM');
    INSERT INTO t VALUES (5, '5 Jan 2024');
    INSERT INTO t VALUES (6, '2024 Jan 5');
    INSERT INTO t VALUES (7, 'Jan 2024 5');
    INSERT INTO t VALUES (8, '2024 5 Jan');
    INSERT INTO t VALUES (9, '10:00 Jan 5 2024');
    INSERT INTO t VALUES (10, '2024-01-05 PM');
    INSERT INTO t VALUES (11, '2024-01-05 T PM 10:00');
    SELECT * FROM t ORDER BY id;
}
expect {
    1|2024-01-05 10:00:00
    2|2024-01-05 10:00:00
    3|2024-01-05 10:00:00
    4|2024-01-05 22:00:00
    5|2024-01-05 00:00:00
    6|2024-01-05 00:00:00
    7|2024-01-05 00:00:00
    8|2024-01-05 00:00:00
    9|2024-01-05 10:00:00
    10|2024-01-05 12:00:00
    11|2024-01-05 22:00:00
}

test datetime-input-time-with-t {
    CREATE TABLE t(id int, tm time);
    INSERT INTO t VALUES (1, 'T 10:00'), (2, 'T10:00 PM'), (3, '2024-01-05 10:00');
    SELECT * FROM t ORDER BY id;
}
expect {
    1|10:00:00
    2|22:00:00
    3|10:00:00
}

