test datetime-input-rejects-fraction-past-midnight-timestamp-24-00-00-1 {
    CREATE TABLE t(ts timestamp);
    INSERT INTO t VALUES ('2024-01-05 24:00:00.1');
}
expect error {
    date/time field value out of range: "2024-01-05 24:00:00.1"
