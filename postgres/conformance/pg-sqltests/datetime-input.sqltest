test datetime-input-rejects-fraction-past-midnight-timestamp-23-59-60-000001 {
    CREATE TABLE t(ts timestamp);
    INSERT INTO t VALUES ('2024-01-05 23:59:60.000001');
}
expect error {
    date/time field value out of range: "2024-01-05 23:59:60.000001"
