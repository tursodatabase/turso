@compat-gap "operator:timestamp > date"
@setup datetime-compare-date-no-index
test datetime-compare-timestamp-gt-date-scan {
    SELECT ts.id, d.id FROM d, ts WHERE ts.ts > d.d ORDER BY ts.id, d.id;
}
expect {
    1|1
    2|1
    2|2
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type timestamp with type date
}

@compat-gap "operator:timestamptz = date"
@setup datetime-compare-date-no-index
test datetime-compare-date-literal-in-timestamptz-scan {
    SELECT id FROM ts WHERE tz IN (CAST('2024-01-05' AS date), CAST('2024-01-06' AS date));
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type timestamptz with type date
