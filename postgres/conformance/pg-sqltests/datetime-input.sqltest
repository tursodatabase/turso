# A column of a VALUES list has one type. A string literal in it is read as a
# timestamptz when another row is one.
@setup datetime-uses
test datetime-timestamptz-values-column-reads-literals-as-timestamptz {
    SELECT x FROM (VALUES ('2024-01-01 10:00:00+02'::timestamptz), ('2024-01-02'), (NULL)) v(x) ORDER BY x;
    INSERT INTO r VALUES (3, '2024-01-02', now()), (4, now(), '2024-01-02 03:00:00+02');
    SELECT id, tz FROM r WHERE id = 4;
}
expect {
    2024-01-01 08:00:00+00
    2024-01-02 00:00:00+00

    4|2024-01-02 01:00:00+00
}

# The rows of INSERT ... VALUES don't share a type: each value is converted to
# the type of its target column, so a literal next to a timestamptz in a text
# column stays text.
test datetime-insert-values-rows-keep-their-own-types {
    CREATE TABLE w (id int, s text);
    INSERT INTO w VALUES (1, now()), (2, '2024-01-01'), (3, 'abc');
    SELECT id, s FROM w WHERE id > 1 ORDER BY id;
}
expect {
    2|2024-01-01
    3|abc
}

# A VALUES list used as a value or as the right side of IN has the type of its
# column, so a string literal next to it is read as a timestamptz.
test datetime-timestamptz-values-list-as-subquery {
    CREATE TABLE ev (id int, at timestamptz);
    INSERT INTO ev VALUES (1, '2024-01-05 10:00:00+00'), (2, '2024-01-01 00:00:00+00');
    SELECT x FROM (VALUES ('2024-01-01'), ((VALUES ('2024-01-05 10:00:00+00'::timestamptz)))) v(x) ORDER BY x;
    SELECT id FROM ev WHERE at IN (VALUES ('2024-01-05 12:00:00+02'::timestamptz)) ORDER BY id;
    SELECT id FROM ev WHERE at IN (VALUES ('2024-01-05 10:00:00+00'::timestamptz), ('2024-01-01')) ORDER BY id;
    SELECT 'found' WHERE '2024-01-05 12:00:00+02' IN (VALUES ('2024-01-05 10:00:00+00'::timestamptz));
    SELECT 'found' WHERE '2024-01-01 02:00:00+02' IN (VALUES ((SELECT at FROM ev WHERE id = 1)), ('2024-01-01'));
}
expect {
    2024-01-01 00:00:00+00
    2024-01-05 10:00:00+00
    1
    1
    2
    found
    found
}

