    CREATE TABLE t(ts timestamp);
    INSERT INTO t VALUES ('T 2024-01-05 10:00');
}
expect error {
    invalid input syntax for type timestamp: "T 2024-01-05 10:00"
}

test datetime-input-rejects-order-t-2024-01-05 {
    CREATE TABLE t(ts timestamp);
    INSERT INTO t VALUES ('t 2024-01-05');
}
expect error {
