    2|2
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type timestamp with type date
}

@compat-gap "operator:timestamptz = date"
@setup datetime-compare-date-index
test datetime-compare-date-literal-in-timestamptz-index {
    SELECT id FROM ts WHERE tz IN (CAST('2024-01-05' AS date), CAST('2024-01-06' AS date));
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type timestamptz with type date
}

@compat-gap "operator:date >= timestamp"
@setup datetime-compare-date-index
test datetime-compare-date-between-timestamps-index {
    SELECT id FROM d WHERE d BETWEEN CAST('2024-01-04 12:00:00' AS timestamp) AND CAST('2024-01-06 00:00:00' AS timestamp) ORDER BY id;
}
expect {
    2
    3
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type date with type timestamp
}

@compat-gap "type:time"
test datetime-compare-date-with-time-is-an-error {
    CREATE TABLE d (d date);
    SELECT * FROM d WHERE d = CAST('10:00' AS time);
}
@sqlstate 42883
expect error {
    operator does not exist: date = time without time zone
}
@sqlstate 0A000
expect @tursopg error {
    type "time" is not supported
}

# The order of the fields matters: `T` needs a date before it and a time after it,
# it and a time after it, a date cannot follow a time, and the order of a
# date's numbers and month name is limited.
test datetime-input-field-order-accepted {
    CREATE TABLE t(id int, ts timestamp);
    INSERT INTO t VALUES (1, '2024-01-05T10:00');
    INSERT INTO t VALUES (2, '2024-01-05 T10:00');
    INSERT INTO t VALUES (3, '2024-01-05 T 10:00');
    INSERT INTO t VALUES (4, '2024-01-05 10:00 PM');
    INSERT INTO t VALUES (5, '5 Jan 2024');
    INSERT INTO t VALUES (6, '2024 Jan 5');
    INSERT INTO t VALUES (7, 'Jan 2024 5');
    INSERT INTO t VALUES (8, '2024 5 Jan');
    INSERT INTO t VALUES (9, '10:00 Jan 5 2024');
    INSERT INTO t VALUES (10, '2024-01-05 PM');
    INSERT INTO t VALUES (11, '2024-01-05 T PM 10:00');
    SELECT * FROM t ORDER BY id;
}
expect {
    1|2024-01-05 10:00:00
    2|2024-01-05 10:00:00
    3|2024-01-05 10:00:00
    4|2024-01-05 22:00:00
    5|2024-01-05 00:00:00
    6|2024-01-05 00:00:00
    7|2024-01-05 00:00:00
    8|2024-01-05 00:00:00
    9|2024-01-05 10:00:00
    10|2024-01-05 12:00:00
    11|2024-01-05 22:00:00
}

@compat-gap "type:time"
test datetime-input-time-with-t {
    CREATE TABLE t(id int, tm time);
    INSERT INTO t VALUES (1, 'T 10:00'), (2, 'T10:00 PM'), (3, '2024-01-05 10:00');
    SELECT * FROM t ORDER BY id;
}
expect {
    1|10:00:00
    2|22:00:00
    3|10:00:00
}
@sqlstate 0A000
expect @tursopg error {
    type "time" is not supported
}

test datetime-input-rejects-order-2024-01-05t {
    CREATE TABLE t(ts timestamp);
    INSERT INTO t VALUES ('2024-01-05T');
}
expect error {
    invalid input syntax for type timestamp: "2024-01-05T"
}

test datetime-input-rejects-order-2024-01-05-10-00-t {
    CREATE TABLE t(ts timestamp);
    INSERT INTO t VALUES ('2024-01-05 10:00 T');
}
expect error {
    invalid input syntax for type timestamp: "2024-01-05 10:00 T"
}

