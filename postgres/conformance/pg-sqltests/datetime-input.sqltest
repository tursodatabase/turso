# PostgreSQL accepts the values below. Turso stores these types as text that
# must sort in time order, which these values would not, so it rejects them.

@compat-gap "type:date"
test datetime-input-rejects-bc {
    CREATE TABLE t (d date);
    INSERT INTO t VALUES ('0044-03-15 BC');
}
expect {
}
@sqlstate 22007
expect @tursopg error {
    BC dates are not supported for type date
}

@skip-if postgres "PostgreSQL accepts years past 9999"
test datetime-input-rejects-year-past-9999 {
    CREATE TABLE t (ts timestamp);
    INSERT INTO t VALUES ('10000-01-01 00:00:00');
}
expect error {
    years must be written with 4 digits
}

@skip-if postgres "PostgreSQL accepts infinity"
test datetime-input-rejects-infinity {
    CREATE TABLE t (ts timestamp);
    INSERT INTO t VALUES ('infinity');
}
expect error {
    the timestamp value "infinity" is not supported
}

# PostgreSQL reads `z10` as a POSIX time zone 10 hours behind UTC, so this is
# midnight in that zone: 2024-01-05 00:00:00 as a timestamp. Time zones are not
# supported yet; reading `z` as UTC followed by 10:00 would give 10:00:00.

@skip-if postgres "PostgreSQL reads z10 as a time zone"
test datetime-input-rejects-posix-time-zone {
    CREATE TABLE t (ts timestamp);
    INSERT INTO t VALUES ('2024-01-05 z10:00');
}
expect error {
    invalid input syntax for type timestamp: "2024-01-05 z10:00"
}

# A string compared with a date or time column is read as a value of the
# column's type, in any input form, whether the query scans the table or
# seeks an index.

setup datetime-compare-no-index {
    CREATE TABLE c (id int, ts timestamp, tz timestamptz);
    INSERT INTO c VALUES (1, '2024-01-05 10:00:00', '2024-01-05 10:00:00');
}

setup datetime-compare-index {
    CREATE TABLE c (id int, ts timestamp, tz timestamptz);
    CREATE INDEX c_ts ON c (ts);
    CREATE INDEX c_tz ON c (tz);
    INSERT INTO c VALUES (1, '2024-01-05 10:00:00', '2024-01-05 10:00:00');
}

@setup datetime-compare-no-index
test datetime-compare-timestamptz-eq-scan {
    SELECT id FROM c WHERE tz = '2024-01-05 10:00:00';
}
expect {
    1
}

@setup datetime-compare-index
test datetime-compare-timestamptz-eq-index {
    SELECT id FROM c WHERE tz = '2024-01-05 10:00:00';
}
expect {
    1
}

@setup datetime-compare-no-index
test datetime-compare-timestamptz-gt-scan {
    SELECT count(*) FROM c WHERE tz > '2024-01-05 10:00:00';
}
expect {
    0
}

@setup datetime-compare-index
test datetime-compare-timestamptz-gt-index {
    SELECT count(*) FROM c WHERE tz > '2024-01-05 10:00:00';
}
expect {
    0
}

@setup datetime-compare-no-index
test datetime-compare-timestamptz-between-scan {
    SELECT id FROM c WHERE tz BETWEEN '2024-01-05 09:00:00' AND '2024-01-05 10:00:00';
}
expect {
    1
}

@setup datetime-compare-index
test datetime-compare-timestamptz-between-index {
    SELECT id FROM c WHERE tz BETWEEN '2024-01-05 09:00:00' AND '2024-01-05 10:00:00';
}
expect {
    1
}

@setup datetime-compare-no-index
test datetime-compare-timestamp-t-form-scan {
    SELECT id FROM c WHERE ts > '2024-01-05T09:00';
}
expect {
    1
}

@setup datetime-compare-index
test datetime-compare-timestamp-t-form-index {
    SELECT id FROM c WHERE ts > '2024-01-05T09:00';
}
expect {
    1
}

test datetime-compare-date-month-name-scan {
    CREATE TABLE c (id int, d date);
    INSERT INTO c VALUES (1, '2024-01-05');
    SELECT id FROM c WHERE d >= 'Jan 5 2024';
}
expect {
    1
}

test datetime-compare-date-month-name-index {
    CREATE TABLE c (id int, d date);
    CREATE INDEX c_d ON c (d);
    INSERT INTO c VALUES (1, '2024-01-05');
    SELECT id FROM c WHERE d >= 'Jan 5 2024';
}
expect {
    1
}

# With the session time zone UTC, a timestamp equals the timestamptz of the
# same wall-clock time.
@requires strict "uses STRICT tables"
test datetime-timestamp-equals-timestamptz {
    CREATE TABLE t(id INTEGER, ts timestamp, tz timestamptz) STRICT;
    INSERT INTO t VALUES (1, '2024-01-05 10:00:00', '2024-01-05 10:00:00');
    INSERT INTO t VALUES (2, '2024-01-05 10:00:00', '2024-01-05 10:00:00+02');
    SELECT id FROM t WHERE ts = tz;
}
expect {
    1
}

# PostgreSQL has no = operator for timestamp[] with timestamptz[], so tursopg
# keeps refusing it although it allows the scalar comparison.
@compat-gap "operator:timestamp[] = timestamptz[]"
test datetime-compare-timestamp-array-eq-timestamptz-array {
    SELECT ARRAY['2024-01-05 10:00:00'::timestamp] = ARRAY['2024-01-05 10:00:00+00'::timestamptz];
}
@sqlstate 42883
expect error {
    operator does not exist: timestamp without time zone\[\] = timestamp with time zone\[\]
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type timestamp\[\] with type timestamptz\[\]
}

# A date compared with a timestamp or a timestamptz fails in tursopg, where
# PostgreSQL reads the date as midnight of that day in the other type. A date
# and a timestamp are stored as different texts, and no rule says how one
# converts into the other, so the comparison is refused whether the query
# scans the table or seeks an index on either column.

setup datetime-compare-date-no-index {
    CREATE TABLE d (id int, d date);
    CREATE TABLE ts (id int, ts timestamp, tz timestamptz);
    INSERT INTO d VALUES (1, '2024-01-04'), (2, '2024-01-05'), (3, '2024-01-06');
    INSERT INTO ts VALUES (1, '2024-01-05 00:00:00', '2024-01-05 00:00:00+00'), (2, '2024-01-05 12:00:00', '2024-01-05 14:00:00+02');
}

setup datetime-compare-date-index {
    CREATE TABLE d (id int, d date);
    CREATE TABLE ts (id int, ts timestamp, tz timestamptz);
    CREATE INDEX d_d ON d (d);
    CREATE INDEX ts_ts ON ts (ts);
    CREATE INDEX ts_tz ON ts (tz);
    INSERT INTO d VALUES (1, '2024-01-04'), (2, '2024-01-05'), (3, '2024-01-06');
    INSERT INTO ts VALUES (1, '2024-01-05 00:00:00', '2024-01-05 00:00:00+00'), (2, '2024-01-05 12:00:00', '2024-01-05 14:00:00+02');
}

@compat-gap "operator:date = timestamp"
@setup datetime-compare-date-no-index
test datetime-compare-date-eq-timestamp-scan {
    SELECT d.id, ts.id FROM d, ts WHERE d.d = ts.ts ORDER BY d.id, ts.id;
}
expect {
    2|1
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type date with type timestamp
}

@compat-gap "operator:date < timestamp"
@setup datetime-compare-date-no-index
test datetime-compare-date-lt-timestamp-scan {
    SELECT d.id, ts.id FROM d, ts WHERE d.d < ts.ts ORDER BY d.id, ts.id;
}
expect {
    1|1
    1|2
    2|2
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type date with type timestamp
}

@compat-gap "operator:date >= timestamp"
@setup datetime-compare-date-no-index
test datetime-compare-date-ge-timestamp-scan {
    SELECT d.id, ts.id FROM d, ts WHERE d.d >= ts.ts ORDER BY d.id, ts.id;
}
expect {
    2|1
    3|1
    3|2
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type date with type timestamp
}

@compat-gap "operator:date = timestamptz"
@setup datetime-compare-date-no-index
test datetime-compare-date-eq-timestamptz-scan {
    SELECT d.id, ts.id FROM d, ts WHERE d.d = ts.tz ORDER BY d.id, ts.id;
}
expect {
    2|1
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type date with type timestamptz
}

@compat-gap "operator:date <> timestamptz"
@setup datetime-compare-date-no-index
test datetime-compare-date-ne-timestamptz-scan {
    SELECT d.id, ts.id FROM d, ts WHERE d.d <> ts.tz ORDER BY d.id, ts.id;
}
expect {
    1|1
    1|2
    2|2
    3|1
    3|2
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type date with type timestamptz
}

@compat-gap "operator:date <= timestamptz"
@setup datetime-compare-date-no-index
test datetime-compare-date-le-timestamptz-scan {
    SELECT d.id, ts.id FROM d, ts WHERE d.d <= ts.tz ORDER BY d.id, ts.id;
}
expect {
    1|1
    1|2
    2|1
    2|2
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type date with type timestamptz
}

@compat-gap "operator:date > timestamptz"
@setup datetime-compare-date-no-index
test datetime-compare-date-gt-timestamptz-scan {
    SELECT d.id, ts.id FROM d, ts WHERE d.d > ts.tz ORDER BY d.id, ts.id;
}
expect {
    3|1
    3|2
}
@sqlstate 0A000
expect @tursopg error {
    cannot compare type date with type timestamptz
