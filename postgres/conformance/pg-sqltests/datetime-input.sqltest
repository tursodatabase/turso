test datetime-time-input-rejects-date-form-5 {
    CREATE TABLE t(tm time);
    INSERT INTO t VALUES ('20240105 10:00');
}
expect error {
    invalid input syntax for type time: "20240105 10:00"
}
@sqlstate 0A000
expect @tursopg error {
    type "time" is not supported
}

# PostgreSQL accepts the values below. Turso compares these types by their
# text, which must sort in time order. The text of these values would not, so
# it rejects them.

@skip-if postgres "PostgreSQL accepts BC dates"
test datetime-input-rejects-bc {
    CREATE TABLE t (d date);
    INSERT INTO t VALUES ('0044-03-15 BC');
}
expect error {
    BC dates are not supported for type date
}
@sqlstate 0A000
expect @tursopg error {
    type "date" is not supported
}

@skip-if postgres "PostgreSQL accepts years past 9999"
test datetime-input-rejects-year-past-9999 {
    CREATE TABLE t (ts timestamp);
    INSERT INTO t VALUES ('10000-01-01 00:00:00');
}
expect error {
    years must be written with 4 digits
}

@skip-if postgres "PostgreSQL accepts infinity"
test datetime-input-rejects-infinity {
    CREATE TABLE t (ts timestamp);
    INSERT INTO t VALUES ('infinity');
}
expect error {
    the timestamp value "infinity" is not supported
}

# PostgreSQL reads `z10` as a POSIX time zone 10 hours behind UTC, so this is
# midnight in that zone: 2024-01-05 00:00:00 as a timestamp. Time zones are not
# supported yet; reading `z` as UTC followed by 10:00 would give 10:00:00.

@skip-if postgres "PostgreSQL reads z10 as a time zone"
test datetime-input-rejects-posix-time-zone {
    CREATE TABLE t (ts timestamp);
    INSERT INTO t VALUES ('2024-01-05 z10:00');
}
expect error {
    invalid input syntax for type timestamp: "2024-01-05 z10:00"
}

# A string compared with a date or time column is read as a value of the
# column's type, in any input form, whether the query scans the table or
# seeks an index.

setup datetime-compare-no-index {
    CREATE TABLE c (id int, ts timestamp, tz timestamptz);
    INSERT INTO c VALUES (1, '2024-01-05 10:00:00', '2024-01-05 10:00:00'),
        (2, NULL, '2024-01-05 13:30:00.000001+05:30');
}

setup datetime-compare-index {
    CREATE TABLE c (id int, ts timestamp, tz timestamptz);
    CREATE INDEX c_ts ON c (ts);
    CREATE INDEX c_tz ON c (tz, id);
    INSERT INTO c VALUES (1, '2024-01-05 10:00:00', '2024-01-05 10:00:00'),
        (2, NULL, '2024-01-05 13:30:00.000001+05:30');
}

@setup datetime-compare-no-index
test datetime-compare-timestamptz-eq-scan {
    SELECT id FROM c WHERE tz = '2024-01-05 10:00:00';
}
expect {
    1
}

@setup datetime-compare-index
test datetime-compare-timestamptz-eq-index {
    SELECT id FROM c WHERE tz = '2024-01-05 10:00:00';
}
expect {
    1
}

@setup datetime-compare-no-index
test datetime-compare-timestamptz-gt-scan {
    SELECT count(*) FROM c WHERE tz > '2024-01-05 10:00:00';
}
expect {
    0
}

@setup datetime-compare-index
test datetime-compare-timestamptz-gt-index {
    SELECT count(*) FROM c WHERE tz > '2024-01-05 10:00:00';
}
expect {
    0
}

@setup datetime-compare-no-index
test datetime-compare-timestamptz-between-scan {
    SELECT id FROM c WHERE tz BETWEEN '2024-01-05 09:00:00' AND '2024-01-05 10:00:00';
}
expect {
    1
}

@setup datetime-compare-index
test datetime-compare-timestamptz-between-index {
    SELECT id FROM c WHERE tz BETWEEN '2024-01-05 09:00:00' AND '2024-01-05 10:00:00';
}
expect {
    1
}

@setup datetime-compare-no-index
test datetime-compare-timestamptz-forms-scan {
    SELECT id FROM c WHERE tz = '2024-01-05T08:00:00.000001Z';
    SELECT id FROM c WHERE tz IN ('2024-01-05 12:00:00+02', '2024-01-06', NULL);
    SELECT id FROM c WHERE tz BETWEEN '2024-01-05' AND '2024-01-05 08:00:00.000001';
    SELECT id FROM c WHERE tz < '2024-01-05 08:00:00.000002';
    SELECT id FROM c WHERE tz = CAST('2024-01-05 08:00:00.000001' AS timestamptz) AND id < 5;
    SELECT id FROM c WHERE tz = (SELECT max(tz) FROM c);
}
expect {
    2
    1
    2
    2
    2
    1
}

@setup datetime-compare-index
test datetime-compare-timestamptz-forms-index {
    SELECT id FROM c WHERE tz = '2024-01-05T08:00:00.000001Z';
    SELECT id FROM c WHERE tz IN ('2024-01-05 12:00:00+02', '2024-01-06', NULL);
    SELECT id FROM c WHERE tz BETWEEN '2024-01-05' AND '2024-01-05 08:00:00.000001';
    SELECT id FROM c WHERE tz < '2024-01-05 08:00:00.000002';
    SELECT id FROM c WHERE tz = CAST('2024-01-05 08:00:00.000001' AS timestamptz) AND id < 5;
    SELECT id FROM c WHERE tz = (SELECT max(tz) FROM c);
}
expect {
    2
    1
    2
    2
    2
    1
}

@setup datetime-compare-no-index
test datetime-compare-timestamp-t-form-scan {
    SELECT id FROM c WHERE ts > '2024-01-05T09:00';
}
expect {
    1
}

@setup datetime-compare-index
test datetime-compare-timestamp-t-form-index {
    SELECT id FROM c WHERE ts > '2024-01-05T09:00';
}
expect {
    1
}

test datetime-compare-date-month-name-scan {
    CREATE TABLE c (id int, d date);
    INSERT INTO c VALUES (1, '2024-01-05');
    SELECT id FROM c WHERE d >= 'Jan 5 2024';
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    type "date" is not supported
}

test datetime-compare-date-month-name-index {
    CREATE TABLE c (id int, d date);
    CREATE INDEX c_d ON c (d);
    INSERT INTO c VALUES (1, '2024-01-05');
    SELECT id FROM c WHERE d >= 'Jan 5 2024';
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    type "date" is not supported
}

# A timestamptz orders by its instant, whatever offset it was written with.
test datetime-timestamptz-order {
    CREATE TABLE o (id int, tz timestamptz);
    INSERT INTO o VALUES (1, '2024-01-05 10:00:00+02'), (2, '2024-01-05 08:00:00.000001Z'),
        (3, '2024-01-05 13:29:59.999999+05:30'), (4, '0001-01-01'), (5, '9999-12-31 23:59:59.999999');
    SELECT id FROM o ORDER BY tz;
    SELECT min(tz)::text, max(tz) FROM o;
}
expect {
    4
    3
    1
    2
    5
    0001-01-01 00:00:00+00|9999-12-31 23:59:59.999999+00
}

test datetime-timestamptz-copied-between-columns {
    CREATE TABLE a (tz timestamptz, tz2 timestamptz);
    INSERT INTO a VALUES ('2024-01-05 10:00:00.5+02', NULL);
    UPDATE a SET tz2 = tz;
    INSERT INTO a SELECT tz2, tz FROM a;
    SELECT tz, tz2 FROM a;
}
expect {
    2024-01-05 08:00:00.5+00|2024-01-05 08:00:00.5+00
    2024-01-05 08:00:00.5+00|2024-01-05 08:00:00.5+00
}

# CURRENT_TIMESTAMP is a timestamptz, as now() is.
test datetime-timestamptz-default-now {
    CREATE TABLE n (id int, tz timestamptz DEFAULT now());
    INSERT INTO n (id) VALUES (1);
    SELECT id FROM n WHERE tz <= CURRENT_TIMESTAMP AND tz > '2024-01-01' AND CURRENT_TIMESTAMP::text LIKE '%+00';
}
expect {
    1
}

setup datetime-uses {
    CREATE TABLE r (id int, ts timestamp, tz timestamptz);
    INSERT INTO r VALUES (1, '2024-01-05 10:00:00.5', '2024-01-05 10:00:00+02'), (2, NULL, NULL);
}

# A timestamptz prints with the offset of the session's time zone, which is
# UTC, and a timestamp prints without an offset.
@setup datetime-uses
test datetime-timestamp-and-timestamptz-as-text {
    SELECT id, ts::text, tz::text FROM r ORDER BY id;
    SELECT CAST(ts AS text), CAST(tz AS text) FROM r WHERE id = 1;
}
expect {
    1|2024-01-05 10:00:00.5|2024-01-05 08:00:00+00
    2||
    2024-01-05 10:00:00.5|2024-01-05 08:00:00+00
}

@setup datetime-uses
test datetime-timestamp-compared-with-columns-and-null {
    SELECT id FROM r WHERE ts = (SELECT ts FROM r WHERE id = 1);
    SELECT id FROM r WHERE tz IN (SELECT tz FROM r WHERE id = 1);
    SELECT id FROM r WHERE ts IS NULL;
    SELECT id FROM r WHERE tz IS NOT NULL;
    SELECT id FROM r WHERE ts BETWEEN '2024-01-05' AND '2024-01-06' AND tz IN ('2024-01-05 08:00:00+00', NULL);
    SELECT count(DISTINCT tz) FROM r;
    SELECT tz, count(*) FROM r GROUP BY tz ORDER BY tz;
}
expect {
    1
    1
    2
    1
    1
    1
    2024-01-05 08:00:00+00|1
    |1
}

# Turso supports a timestamp or timestamptz only where it is stored or
# compared with a value of its own type. Everything else fails with 0A000.
@setup datetime-uses
test datetime-timestamptz-in-coalesce-is-refused {
    SELECT coalesce(tz, '2024-01-01') FROM r ORDER BY id;
}
expect {
    2024-01-05 08:00:00+00
    2024-01-01 00:00:00+00
}
@sqlstate 0A000
expect @tursopg error {
    using type timestamptz in function COALESCE\(\) is not supported
}

@setup datetime-uses
test datetime-timestamp-in-case-is-refused {
    SELECT 'a', CASE WHEN id = 1 THEN ts END FROM r ORDER BY id;
}
expect {
    a|2024-01-05 10:00:00.5
    a|
}
@sqlstate 0A000
expect @tursopg error {
    using type timestamp in CASE is not supported
}

@setup datetime-uses
test datetime-timestamp-concatenated-is-refused {
    SELECT ts || 'x' FROM r WHERE id = 1;
}
expect {
    2024-01-05 10:00:00.5x
}
@sqlstate 0A000
expect @tursopg error {
    using type timestamp in operator \|\| is not supported
}

@setup datetime-uses
test datetime-timestamptz-plus-integer-is-refused {
    SELECT tz + 1 FROM r;
}
@sqlstate 42883
expect error {
    operator does not exist: timestamp with time zone \+ integer
}
@sqlstate 0A000
expect @tursopg error {
    using type timestamptz in operator \+ is not supported
}

@setup datetime-uses
test datetime-timestamp-compared-with-integer-is-refused {
    SELECT id FROM r WHERE ts = 1;
}
@sqlstate 42883
expect error {
    operator does not exist: timestamp without time zone = integer
}
@sqlstate 0A000
expect @tursopg error {
    comparing type timestamp with type integer is not supported
}

@setup datetime-uses
test datetime-timestamp-compared-with-text-is-refused {
    SELECT id FROM r WHERE ts = '2024-01-05 10:00:00.5'::text;
}
@sqlstate 42883
expect error {
    operator does not exist: timestamp without time zone = text
}
@sqlstate 0A000
expect @tursopg error {
    comparing type timestamp with type text is not supported
}

# A string literal is read as a timestamp only when it is itself compared with
# one. In a subquery or a UNION it is text.
@setup datetime-uses
test datetime-timestamp-compared-with-subquery-literal-is-refused {
    SELECT id FROM r WHERE ts = (SELECT '2024-01-05 10:00:00.5');
}
@sqlstate 42883
expect error {
    operator does not exist: timestamp without time zone = text
}
@sqlstate 0A000
expect @tursopg error {
    comparing type timestamp with type text is not supported
}

@setup datetime-uses
test datetime-timestamp-in-union-of-literals-is-refused {
    SELECT id FROM r WHERE ts IN (SELECT '2024-01-05 10:00:00.5' UNION SELECT '2024-01-06');
}
