# PostgreSQL accepts the values below. Turso compares these types by their
# text, which must sort in time order. The text of these values would not, so
# it rejects them.

@skip-if postgres "PostgreSQL accepts BC dates"
test datetime-input-rejects-bc {
    CREATE TABLE t (d date);
    INSERT INTO t VALUES ('0044-03-15 BC');
}
expect error {
    BC dates are not supported for type date
}
@sqlstate 0A000
expect @tursopg error {
    type "date" is not supported
}

@skip-if postgres "PostgreSQL accepts years past 9999"
test datetime-input-rejects-year-past-9999 {
    CREATE TABLE t (ts timestamp);
    INSERT INTO t VALUES ('10000-01-01 00:00:00');
}
expect error {
    years must be written with 4 digits
}

@skip-if postgres "PostgreSQL accepts infinity"
test datetime-input-rejects-infinity {
    CREATE TABLE t (ts timestamp);
    INSERT INTO t VALUES ('infinity');
}
expect error {
    the timestamp value "infinity" is not supported
}

# PostgreSQL reads `z10` as a POSIX time zone 10 hours behind UTC, so this is
# midnight in that zone: 2024-01-05 00:00:00 as a timestamp. Time zones are not
# supported yet; reading `z` as UTC followed by 10:00 would give 10:00:00.

@skip-if postgres "PostgreSQL reads z10 as a time zone"
test datetime-input-rejects-posix-time-zone {
    CREATE TABLE t (ts timestamp);
    INSERT INTO t VALUES ('2024-01-05 z10:00');
}
expect error {
    invalid input syntax for type timestamp: "2024-01-05 z10:00"
}
@sqlstate 0A000
expect @tursopg error {}

# A string compared with a date or time column is read as a value of the
# column's type, in any input form, whether the query scans the table or
# seeks an index.

setup datetime-compare-no-index {
    CREATE TABLE c (id int, ts timestamp, tz timestamptz);
    INSERT INTO c VALUES (1, '2024-01-05 10:00:00', '2024-01-05 10:00:00'),
        (2, NULL, '2024-01-05 13:30:00.000001+05:30');
}

setup datetime-compare-index {
    CREATE TABLE c (id int, ts timestamp, tz timestamptz);
    CREATE INDEX c_ts ON c (ts);
    CREATE INDEX c_tz ON c (tz, id);
    INSERT INTO c VALUES (1, '2024-01-05 10:00:00', '2024-01-05 10:00:00'),
        (2, NULL, '2024-01-05 13:30:00.000001+05:30');
}

@setup datetime-compare-no-index
test datetime-compare-timestamptz-eq-scan {
    SELECT id FROM c WHERE tz = '2024-01-05 10:00:00';
}
expect {
    1
}

@setup datetime-compare-index
test datetime-compare-timestamptz-eq-index {
    SELECT id FROM c WHERE tz = '2024-01-05 10:00:00';
}
expect {
    1
}

@setup datetime-compare-no-index
test datetime-compare-timestamptz-gt-scan {
    SELECT count(*) FROM c WHERE tz > '2024-01-05 10:00:00';
}
expect {
    0
}

@setup datetime-compare-index
test datetime-compare-timestamptz-gt-index {
    SELECT count(*) FROM c WHERE tz > '2024-01-05 10:00:00';
}
expect {
    0
}

@setup datetime-compare-no-index
test datetime-compare-timestamptz-between-scan {
    SELECT id FROM c WHERE tz BETWEEN '2024-01-05 09:00:00' AND '2024-01-05 10:00:00';
}
expect {
    1
}

@setup datetime-compare-index
test datetime-compare-timestamptz-between-index {
    SELECT id FROM c WHERE tz BETWEEN '2024-01-05 09:00:00' AND '2024-01-05 10:00:00';
}
expect {
    1
}

@setup datetime-compare-no-index
test datetime-compare-timestamptz-forms-scan {
    SELECT id FROM c WHERE tz = '2024-01-05T08:00:00.000001Z';
    SELECT id FROM c WHERE tz IN ('2024-01-05 12:00:00+02', '2024-01-06', NULL);
    SELECT id FROM c WHERE tz BETWEEN '2024-01-05' AND '2024-01-05 08:00:00.000001';
    SELECT id FROM c WHERE tz < '2024-01-05 08:00:00.000002';
    SELECT id FROM c WHERE tz = CAST('2024-01-05 08:00:00.000001' AS timestamptz) AND id < 5;
    SELECT id FROM c WHERE tz = (SELECT max(tz) FROM c);
}
expect {
    2
    1
    2
    2
    2
    1
}

@setup datetime-compare-index
test datetime-compare-timestamptz-forms-index {
    SELECT id FROM c WHERE tz = '2024-01-05T08:00:00.000001Z';
    SELECT id FROM c WHERE tz IN ('2024-01-05 12:00:00+02', '2024-01-06', NULL);
    SELECT id FROM c WHERE tz BETWEEN '2024-01-05' AND '2024-01-05 08:00:00.000001';
    SELECT id FROM c WHERE tz < '2024-01-05 08:00:00.000002';
    SELECT id FROM c WHERE tz = CAST('2024-01-05 08:00:00.000001' AS timestamptz) AND id < 5;
    SELECT id FROM c WHERE tz = (SELECT max(tz) FROM c);
}
expect {
    2
    1
    2
    2
    2
    1
}

@setup datetime-compare-no-index
test datetime-compare-timestamp-t-form-scan {
    SELECT id FROM c WHERE ts > '2024-01-05T09:00';
}
expect {
    1
}

@setup datetime-compare-index
test datetime-compare-timestamp-t-form-index {
    SELECT id FROM c WHERE ts > '2024-01-05T09:00';
}
expect {
    1
}

test datetime-compare-date-month-name-scan {
    CREATE TABLE c (id int, d date);
    INSERT INTO c VALUES (1, '2024-01-05');
    SELECT id FROM c WHERE d >= 'Jan 5 2024';
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    type "date" is not supported
}

test datetime-compare-date-month-name-index {
    CREATE TABLE c (id int, d date);
    CREATE INDEX c_d ON c (d);
    INSERT INTO c VALUES (1, '2024-01-05');
    SELECT id FROM c WHERE d >= 'Jan 5 2024';
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    type "date" is not supported
}

# A timestamptz orders by its instant, whatever offset it was written with.
test datetime-timestamptz-order {
    CREATE TABLE o (id int, tz timestamptz);
    INSERT INTO o VALUES (1, '2024-01-05 10:00:00+02'), (2, '2024-01-05 08:00:00.000001Z'),
        (3, '2024-01-05 13:29:59.999999+05:30'), (4, '0001-01-01'), (5, '9999-12-31 23:59:59.999999');
    SELECT id FROM o ORDER BY tz;
    SELECT min(tz)::text, max(tz) FROM o;
}
expect {
    4
    3
    1
    2
    5
    0001-01-01 00:00:00+00|9999-12-31 23:59:59.999999+00
}

test datetime-timestamptz-copied-between-columns {
    CREATE TABLE a (tz timestamptz, tz2 timestamptz);
    INSERT INTO a VALUES ('2024-01-05 10:00:00.5+02', NULL);
    UPDATE a SET tz2 = tz;
    INSERT INTO a SELECT tz2, tz FROM a;
    SELECT tz, tz2 FROM a;
}
expect {
    2024-01-05 08:00:00.5+00|2024-01-05 08:00:00.5+00
    2024-01-05 08:00:00.5+00|2024-01-05 08:00:00.5+00
}

# CURRENT_TIMESTAMP is a timestamptz, as now() is.
test datetime-timestamptz-default-now {
    CREATE TABLE n (id int, tz timestamptz DEFAULT now());
    INSERT INTO n (id) VALUES (1);
    SELECT id FROM n WHERE tz <= CURRENT_TIMESTAMP AND tz > '2024-01-01' AND CURRENT_TIMESTAMP::text LIKE '%+00';
}
expect {
    1
}

setup datetime-uses {
    CREATE TABLE r (id int, ts timestamp, tz timestamptz);
    INSERT INTO r VALUES (1, '2024-01-05 10:00:00.5', '2024-01-05 10:00:00+02'), (2, NULL, NULL);
}

# A timestamptz prints with the offset of the session's time zone, which is
# UTC, and a timestamp prints without an offset.
@setup datetime-uses
test datetime-timestamp-and-timestamptz-as-text {
    SELECT id, ts::text, tz::text FROM r ORDER BY id;
    SELECT CAST(ts AS text), CAST(tz AS text) FROM r WHERE id = 1;
}
expect {
    1|2024-01-05 10:00:00.5|2024-01-05 08:00:00+00
    2||
    2024-01-05 10:00:00.5|2024-01-05 08:00:00+00
}

@setup datetime-uses
test datetime-timestamp-compared-with-columns-and-null {
    SELECT id FROM r WHERE ts = (SELECT ts FROM r WHERE id = 1);
    SELECT id FROM r WHERE tz IN (SELECT tz FROM r WHERE id = 1);
    SELECT id FROM r WHERE ts IS NULL;
    SELECT id FROM r WHERE tz IS NOT NULL;
    SELECT id FROM r WHERE ts BETWEEN '2024-01-05' AND '2024-01-06' AND tz IN ('2024-01-05 08:00:00+00', NULL);
    SELECT count(DISTINCT tz) FROM r;
    SELECT tz, count(*) FROM r GROUP BY tz ORDER BY tz;
}
expect {
    1
    1
    2
    1
    1
    1
    2024-01-05 08:00:00+00|1
    |1
}

@setup datetime-uses
test datetime-timestamptz-in-coalesce {
    SELECT coalesce(tz, '2024-01-01') FROM r ORDER BY id;
}
expect {
    2024-01-05 08:00:00+00
    2024-01-01 00:00:00+00
}

@setup datetime-uses
test datetime-timestamp-in-case {
    SELECT 'a', CASE WHEN id = 1 THEN ts END FROM r ORDER BY id;
}
expect {
    a|2024-01-05 10:00:00.5
    a|
}

@setup datetime-uses
test datetime-timestamp-concatenated {
    SELECT ts || 'x' FROM r WHERE id = 1;
}
expect {
    2024-01-05 10:00:00.5x
}

# A string literal is read as a timestamp only when it is itself compared with
# one. In a subquery or a UNION it is text.
# PostgreSQL types ARRAY['a', 'b'] as text[], unlike the literals of IN ('a',
# 'b'), which are read as the type they are compared with.
# One element of a known type makes the literals that type.
@setup datetime-uses
test datetime-timestamptz-equals-any-of-typed-and-literal-elements {
    SELECT id FROM r WHERE tz = ANY(ARRAY['2024-01-05 08:00:00+00'::timestamptz, '2024-01-07']);
    SELECT id FROM r WHERE ts = ANY(ARRAY['2024-01-05 10:00:00.5', ts]);
}
expect {
    1
    1
}

@setup datetime-uses
test datetime-timestamptz-cast-to-date-is-refused {
    SELECT tz::date FROM r WHERE id = 1;
}
expect {
    2024-01-05
}
@sqlstate 0A000
expect @tursopg error {
    type "date" is not supported
}

# PostgreSQL converts the timestamp to timestamptz in the session's time zone.
@setup datetime-uses
test datetime-timestamp-compared-with-timestamptz {
    SELECT count(*) FROM r WHERE ts = tz;
}
expect {
    0
}

@setup datetime-uses
test datetime-timestamptz-in-sqlite-date-function-is-refused {
    SELECT date(tz) FROM r WHERE id = 1;
}
expect {
    2024-01-05
}
@sqlstate 0A000
expect @tursopg error {
    type "date" is not supported
}

test datetime-timestamptz-in-array {
    SELECT ARRAY['2024-01-01 10:00:00+02'::timestamptz];
}
expect {
    {"2024-01-01 08:00:00+00"}
}

@setup datetime-uses
test datetime-timestamp-in-array {
    SELECT ARRAY[ts] FROM r WHERE id = 1;
}
expect {
    {"2024-01-05 10:00:00.5"}
}

@setup datetime-uses
test datetime-timestamptz-in-array-agg {
    SELECT array_agg(tz) FROM r WHERE id = 1;
}
expect {
    {"2024-01-05 08:00:00+00"}
}

@setup datetime-uses
test datetime-timestamp-in-array-agg {
    SELECT array_agg(ts) FROM r WHERE id = 1;
}
expect {
    {"2024-01-05 10:00:00.5"}
}

# A column of a VALUES list has one type. A string literal in it is read as a
# timestamptz when another row is one.
# The rows of INSERT ... VALUES don't share a type: each value is converted to
# the type of its target column, so a literal next to a timestamptz in a text
# column stays text.
test datetime-insert-values-rows-keep-their-own-types {
    CREATE TABLE w (id int, s text);
    INSERT INTO w VALUES (1, now()), (2, '2024-01-01'), (3, 'abc');
    SELECT id, s FROM w WHERE id > 1 ORDER BY id;
}
expect {
    2|2024-01-01
    3|abc
}

# A VALUES list used as a value or as the right side of IN has the type of its
# column, so a string literal next to it is read as a timestamptz.
# The first SELECT of a recursive CTE gives a column its type, and NULL there
# is text.
@setup datetime-uses
test datetime-timestamptz-in-recursive-cte {
    WITH RECURSIVE c(x, n) AS (SELECT tz, 1 FROM r WHERE id = 1 UNION ALL SELECT x, n + 1 FROM c WHERE n < 3) SELECT x, n FROM c ORDER BY n;
}
expect {
    2024-01-05 08:00:00+00|1
    2024-01-05 08:00:00+00|2
    2024-01-05 08:00:00+00|3
}

# A string literal in the recursive query is not converted to the type of the
# column, as in an arm of a compound SELECT.
test datetime-to-timestamp-is-refused {
    SELECT to_timestamp(0);
}
expect {
    1970-01-01 00:00:00+00
}
@sqlstate 0A000
expect @tursopg error {
    to_timestamp\(\) and make_timestamp\(\) are not supported
}

test datetime-make-timestamp-is-refused {
    SELECT make_timestamp(2024, 1, 5, 8, 0, 1.5);
}
expect {
    2024-01-05 08:00:01.5
}
@sqlstate 0A000
expect @tursopg error {
    to_timestamp\(\) and make_timestamp\(\) are not supported
}

test datetime-localtimestamp {
    SELECT 1 WHERE LOCALTIMESTAMP > '2024-01-01';
}
expect {
    1
}

test datetime-current-timestamp-with-precision {
    SELECT 1 WHERE CURRENT_TIMESTAMP(0) > '2024-01-01';
}
expect {
    1
}
@sqlstate 0A000
expect @tursopg error {
    a fractional-second precision on CURRENT_TIME/CURRENT_TIMESTAMP/LOCALTIME/LOCALTIMESTAMP is not supported
}

test datetime-foreign-key-on-timestamptz {
    CREATE TABLE fk_parent (k timestamptz PRIMARY KEY);
    CREATE TABLE fk_child (k timestamptz REFERENCES fk_parent (k));
    INSERT INTO fk_parent VALUES ('2024-01-01 00:00+00');
    INSERT INTO fk_child VALUES ('2024-01-01 00:00+00');
    SELECT count(*) FROM fk_child;
}
expect {
    1
}

# The order of the fields matters: `T` needs a date before it and a time after it,
# it and a time after it, a date cannot follow a time, and the order of a
# date's numbers and month name is limited.
test datetime-input-field-order-accepted {
    CREATE TABLE t(id int, ts timestamp);
    INSERT INTO t VALUES (1, '2024-01-05T10:00');
    INSERT INTO t VALUES (2, '2024-01-05 T10:00');
    INSERT INTO t VALUES (3, '2024-01-05 T 10:00');
    INSERT INTO t VALUES (4, '2024-01-05 10:00 PM');
    INSERT INTO t VALUES (5, '5 Jan 2024');
    INSERT INTO t VALUES (6, '2024 Jan 5');
    INSERT INTO t VALUES (7, 'Jan 2024 5');
    INSERT INTO t VALUES (8, '2024 5 Jan');
    INSERT INTO t VALUES (9, '10:00 Jan 5 2024');
    INSERT INTO t VALUES (10, '2024-01-05 PM');
    INSERT INTO t VALUES (11, '2024-01-05 T PM 10:00');
    SELECT * FROM t ORDER BY id;
}
expect {
    1|2024-01-05 10:00:00
    2|2024-01-05 10:00:00
    3|2024-01-05 10:00:00
    4|2024-01-05 22:00:00
    5|2024-01-05 00:00:00
    6|2024-01-05 00:00:00
    7|2024-01-05 00:00:00
    8|2024-01-05 00:00:00
    9|2024-01-05 10:00:00
    10|2024-01-05 12:00:00
    11|2024-01-05 22:00:00
}

test datetime-input-time-with-t {
    CREATE TABLE t(id int, tm time);
    INSERT INTO t VALUES (1, 'T 10:00'), (2, 'T10:00 PM'), (3, '2024-01-05 10:00');
    SELECT * FROM t ORDER BY id;
}
expect {
    1|10:00:00
    2|22:00:00
    3|10:00:00
}
@sqlstate 0A000
expect @tursopg error {
    type "time" is not supported
}

test datetime-input-rejects-order-2024-01-05t {
    CREATE TABLE t(ts timestamp);
    INSERT INTO t VALUES ('2024-01-05T');
}
expect error {
    invalid input syntax for type timestamp: "2024-01-05T"
}

test datetime-input-rejects-order-2024-01-05-10-00-t {
    CREATE TABLE t(ts timestamp);
    INSERT INTO t VALUES ('2024-01-05 10:00 T');
}
expect error {
    invalid input syntax for type timestamp: "2024-01-05 10:00 T"
}

