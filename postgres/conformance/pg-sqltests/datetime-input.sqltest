test datetime-time-input-accepts-iso-date-before-time {
    CREATE TABLE t(id INTEGER PRIMARY KEY, tm time);
    INSERT INTO t VALUES (1, '2024-01-05 10:00');
    INSERT INTO t VALUES (2, '2024-1-5 10:00');
    INSERT INTO t VALUES (3, '2024-01-05 10:00:00+02');
    INSERT INTO t VALUES (4, '10:00');
    SELECT * FROM t ORDER BY id;
}
expect {
    1|10:00:00
    2|10:00:00
    3|10:00:00
    4|10:00:00
}

test datetime-time-input-rejects-date-form-1 {
    CREATE TABLE t(tm time);
    INSERT INTO t VALUES ('Jan 5 2024 10:00');
}
expect error {
    invalid input syntax for type time: "Jan 5 2024 10:00"
}

test datetime-time-input-rejects-date-form-2 {
    CREATE TABLE t(tm time);
    INSERT INTO t VALUES ('10:00 Jan 5 2024');
}
expect error {
    invalid input syntax for type time: "10:00 Jan 5 2024"
}

test datetime-time-input-rejects-date-form-3 {
    CREATE TABLE t(tm time);
    INSERT INTO t VALUES ('2024-01-05T10:00');
}
expect error {
    invalid input syntax for type time: "2024-01-05T10:00"
}

test datetime-time-input-rejects-date-form-4 {
    CREATE TABLE t(tm time);
    INSERT INTO t VALUES ('10:00 2024-01-05');
}
expect error {
    invalid input syntax for type time: "10:00 2024-01-05"
