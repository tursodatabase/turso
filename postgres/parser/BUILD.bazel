load("//tools/bazel:rust.bzl", "turso_rust_library", "turso_rust_test")

PARSER_FEATURES = ["validate_psql"]

turso_rust_library(
    name = "turso_pg_parser",
    srcs = glob(["*.rs"]),
    crate_features = PARSER_FEATURES,
    crate_root = "lib.rs",
    tags = ["no-rustfmt"],
    visibility = ["//visibility:public"],
    deps = [
        "//sqlite/parser:turso_parser",
    ],
)

turso_rust_test(
    name = "turso_pg_parser_test",
    cargo_proc_macro_deps = [],
    crate = ":turso_pg_parser",
    crate_features = PARSER_FEATURES,
    tags = ["no-rustfmt"],
)

turso_rust_test(
    name = "parse_valid_test",
    srcs = ["tests/parse_valid.rs"],
    cargo_proc_macro_deps = [],
    cargo_target = "test:parse_valid",
    crate_features = PARSER_FEATURES,
    crate_root = "tests/parse_valid.rs",
    tags = ["no-rustfmt"],
    deps = [
        ":turso_pg_parser",
    ],
)

turso_rust_test(
    name = "parse_invalid_test",
    srcs = ["tests/parse_invalid.rs"],
    cargo_proc_macro_deps = [],
    cargo_target = "test:parse_invalid",
    crate_features = PARSER_FEATURES,
    crate_root = "tests/parse_invalid.rs",
    tags = ["no-rustfmt"],
    deps = [
        ":turso_pg_parser",
    ],
)
