+                        .get_values()
+                        .cloned()
+                        .collect::<Vec<_>>(),
+                );
+            }
+            StepResult::Done => break,
+            StepResult::IO | StepResult::Yield => io.step().unwrap(),
+            other => panic!("unexpected reader step after checkpoint: {other:?}"),
+        }
+    }
+    reader.execute("COMMIT").unwrap();
+    assert_eq!(
+        read,
