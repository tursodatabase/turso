@database :memory:

# In a trigger body, a FROM subquery that selects NEW.x or OLD.x names its
# column x, as a subquery that selects t.x does.

setup schema {
    CREATE TABLE t(id INTEGER PRIMARY KEY, x);
    CREATE TABLE u(y);
}

@setup schema
test trigger-insert-new-column-subquery-name {
    CREATE TRIGGER tr AFTER INSERT ON t BEGIN
      INSERT INTO u SELECT x FROM (SELECT new.x);
    END;
    INSERT INTO t VALUES(1, 7);
    SELECT * FROM u;
}
expect {
    7
}

@setup schema
test trigger-delete-old-column-subquery-name {
    INSERT INTO t VALUES(1, 3);
    CREATE TRIGGER tr AFTER DELETE ON t BEGIN
      INSERT INTO u SELECT x FROM (SELECT old.x);
    END;
    DELETE FROM t;
    SELECT * FROM u;
}
expect {
    3
}

@setup schema
test trigger-update-new-and-old-column-subquery-name {
    INSERT INTO t VALUES(1, 3);
    CREATE TRIGGER tr AFTER UPDATE ON t BEGIN
      INSERT INTO u SELECT x FROM (SELECT new.x);
      INSERT INTO u SELECT x FROM (SELECT old.x);
    END;
    UPDATE t SET x = 5;
    SELECT * FROM u;
}
expect {
    5
    3
}

@setup schema
test trigger-new-column-qualified-subquery-name {
    CREATE TRIGGER tr AFTER INSERT ON t BEGIN
      INSERT INTO u SELECT s.x FROM (SELECT new.x) AS s;
    END;
    INSERT INTO t VALUES(1, 7);
    SELECT * FROM u;
}
expect {
    7
}

# A reference names the column as it is written: new.id, where id is the
# rowid alias, names it id, and new.rowid names it rowid.
@setup schema
test trigger-new-rowid-subquery-name {
    CREATE TABLE r(x);
    CREATE TRIGGER tr AFTER INSERT ON t BEGIN
      INSERT INTO u SELECT id FROM (SELECT new.id);
      INSERT INTO u SELECT x FROM (SELECT new."X");
    END;
    CREATE TRIGGER tr2 AFTER INSERT ON r BEGIN
      INSERT INTO u SELECT rowid FROM (SELECT new.rowid);
    END;
    INSERT INTO t VALUES(4, 7);
    INSERT INTO r VALUES(9);
    SELECT * FROM u;
}
expect {
    4
    7
    1
}

@setup schema
test trigger-new-column-cte-and-compound-name {
    CREATE TRIGGER tr AFTER INSERT ON t BEGIN
      INSERT INTO u WITH c AS (SELECT new.x) SELECT x FROM c;
      INSERT INTO u SELECT x FROM (SELECT new.x UNION ALL SELECT 8);
      INSERT INTO u SELECT x FROM (SELECT new.x) JOIN (SELECT new.x) USING (x);
    END;
    INSERT INTO t VALUES(1, 7);
    SELECT * FROM u;
}
expect {
    7
    7
    8
    7
}

@setup schema
test trigger-new-column-alias-names-subquery-column {
    CREATE TRIGGER tr AFTER INSERT ON t BEGIN
      INSERT INTO u SELECT x FROM (SELECT new.x AS z);
    END;
    INSERT INTO t VALUES(1, 7);
}
expect error {
    no such column: x
}

# An ORDER BY term of a compound SELECT does not match new.x by the name x.
@setup schema
test trigger-compound-order-by-does-not-match-new-column-name {
    CREATE TRIGGER tr AFTER INSERT ON t BEGIN
      INSERT INTO u SELECT new.x UNION SELECT 8 ORDER BY x;
    END;
    INSERT INTO t VALUES(1, 7);
}
expect error {
    1st ORDER BY term does not match any column in the result set
}

# An ORDER BY term of a compound SELECT matches the same NEW column however
# the reference spells it.
@setup schema
test trigger-compound-order-by-matches-new-column-spellings {
    CREATE TRIGGER tr AFTER INSERT ON t BEGIN
      INSERT INTO u SELECT new.x UNION SELECT 8 ORDER BY NEW.X DESC;
      INSERT INTO u SELECT new.rowid UNION SELECT 8 ORDER BY new.oid DESC;
      INSERT INTO u SELECT new.id UNION SELECT 8 ORDER BY new.rowid;
    END;
    INSERT INTO t VALUES(4, 7);
    SELECT * FROM u;
}
expect {
    8
    7
    8
    4
    4
    8
}

# Parentheses and COLLATE around NEW.x or OLD.x keep the name x.
@setup schema
test trigger-new-old-column-in-parentheses-or-collate-subquery-name {
    INSERT INTO t VALUES(1, 3);
    CREATE TRIGGER tr AFTER UPDATE ON t BEGIN
      INSERT INTO u SELECT x FROM (SELECT (new.x));
      INSERT INTO u SELECT x FROM (SELECT ((old.x)));
      INSERT INTO u SELECT x FROM (SELECT new.x COLLATE nocase);
      INSERT INTO u SELECT s.x FROM (SELECT (old.x COLLATE nocase)) AS s;
    END;
    UPDATE t SET x = 5;
    SELECT * FROM u;
}
expect {
    5
    3
    5
    3
}

# A WHEN clause reads NEW.x and OLD.x from registers of the statement that
# fires the trigger; a FROM subquery there names their columns x too.

@setup schema
test trigger-when-new-column-subquery-name {
    CREATE TRIGGER tr AFTER INSERT ON t
      WHEN (SELECT x FROM (SELECT new.x)) > 5
    BEGIN
      INSERT INTO u VALUES(new.x);
    END;
    INSERT INTO t VALUES(1, 7);
    INSERT INTO t VALUES(2, 3);
    SELECT * FROM u;
}
expect {
    7
}

@setup schema
test trigger-when-old-column-and-rowid-subquery-name {
    INSERT INTO t VALUES(1, 3);
    INSERT INTO t VALUES(2, 4);
    CREATE TRIGGER tr AFTER DELETE ON t
      WHEN (SELECT s.x + s.id FROM (SELECT old.x, (old.id) COLLATE nocase) AS s) = 6
    BEGIN
      INSERT INTO u VALUES(old.x);
    END;
    DELETE FROM t;
    SELECT * FROM u;
}
expect {
    4
}

@setup schema
test trigger-when-update-new-column-cte-name {
    INSERT INTO t VALUES(1, 3);
    CREATE TRIGGER tr AFTER UPDATE ON t
      WHEN (WITH c AS (SELECT new.X, old.x AS o) SELECT x - o FROM c) = 2
    BEGIN
      INSERT INTO u VALUES(new.x);
    END;
    UPDATE t SET x = 4;
    UPDATE t SET x = 6;
    SELECT * FROM u;
}
expect {
    6
}

@setup schema
test trigger-when-compound-order-by-matches-new-column-spellings {
    CREATE TRIGGER tr AFTER INSERT ON t
      WHEN (SELECT x FROM (SELECT new.x UNION SELECT 9 ORDER BY NEW.X LIMIT 1)) = 7
    BEGIN
      INSERT INTO u VALUES(new.x);
    END;
    INSERT INTO t VALUES(1, 7);
    SELECT * FROM u;
}
expect {
    7
}

# new.rowid, new.oid and new._rowid_ name the column rowid, oid and _rowid_,
# also when the table has a rowid alias, and not by the name of that alias.
@setup schema
test trigger-new-rowid-spellings-subquery-name-with-rowid-alias {
    CREATE TRIGGER tr AFTER INSERT ON t BEGIN
      INSERT INTO u SELECT rowid FROM (SELECT new.rowid);
      INSERT INTO u SELECT oid FROM (SELECT new.oid);
      INSERT INTO u SELECT s._rowid_ FROM (SELECT new._rowid_) AS s;
      INSERT INTO u SELECT r + id FROM (SELECT new.ROWID AS r, new.id);
    END;
    INSERT INTO t VALUES(5, 7);
    SELECT * FROM u;
}
expect {
    5
    5
    5
    10
}

@setup schema
test trigger-new-rowid-subquery-not-named-by-rowid-alias {
    CREATE TRIGGER tr AFTER INSERT ON t BEGIN
      INSERT INTO u SELECT id FROM (SELECT new.rowid);
    END;
    INSERT INTO t VALUES(5, 7);
}
expect error {
    no such column: id
}

@setup schema
test trigger-old-oid-subquery-name-without-rowid-alias {
    CREATE TABLE r(x);
    INSERT INTO r VALUES(3);
    CREATE TRIGGER tr AFTER DELETE ON r BEGIN
      INSERT INTO u SELECT oid FROM (SELECT old.oid);
      INSERT INTO u SELECT _rowid_ FROM (SELECT old._rowid_);
    END;
    DELETE FROM r;
    SELECT * FROM u;
}
expect {
    1
    1
}

@setup schema
test trigger-when-new-rowid-spellings-subquery-name {
    CREATE TRIGGER tr AFTER INSERT ON t
      WHEN (SELECT oid + rowid + id FROM (SELECT new.oid, new.rowid, new.id)) = 15
    BEGIN
      INSERT INTO u VALUES(new.x);
    END;
    INSERT INTO t VALUES(5, 7);
    INSERT INTO t VALUES(6, 8);
    SELECT * FROM u;
}
expect {
    7
}
