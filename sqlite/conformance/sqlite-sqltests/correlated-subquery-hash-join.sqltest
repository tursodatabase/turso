@database :memory:

# Regression tests for #5543: Correlated subquery with explicit JOIN
# returns wrong results after first row when hash join is used.

setup schema {
    CREATE TABLE t1(id INT);
    CREATE TABLE t2(id INT, val INT);
    CREATE TABLE t3(val INT, label TEXT);
    INSERT INTO t1 VALUES (1),(2),(3);
    INSERT INTO t2 VALUES (1,10),(2,20),(3,30);
    INSERT INTO t3 VALUES (10,'ten'),(20,'twenty'),(30,'thirty');
}

# Exact reproducer from issue #5543
@setup schema
test correlated-subquery-with-join-basic {
    SELECT t1.id,
      (SELECT t3.label FROM t2 JOIN t3 ON t2.val = t3.val WHERE t2.id = t1.id) as label
    FROM t1 ORDER BY t1.id;
}
expect {
    1|ten
    2|twenty
    3|thirty
}

# Same query without ORDER BY
@setup schema
test correlated-subquery-with-join-no-order {
    SELECT t1.id,
      (SELECT t3.label FROM t2 JOIN t3 ON t2.val = t3.val WHERE t2.id = t1.id) as label
    FROM t1;
}
expect unordered {
    1|ten
    2|twenty
    3|thirty
}

# Outer row has no match in inner tables
setup schema-with-gaps {
    CREATE TABLE t1(id INT);
    CREATE TABLE t2(id INT, val INT);
    CREATE TABLE t3(val INT, label TEXT);
    INSERT INTO t1 VALUES (1),(2),(3),(4);
    INSERT INTO t2 VALUES (1,10),(3,30);
    INSERT INTO t3 VALUES (10,'ten'),(20,'twenty'),(30,'thirty');
}

@setup schema-with-gaps
test correlated-subquery-with-join-missing-rows {
    SELECT t1.id,
      (SELECT t3.label FROM t2 JOIN t3 ON t2.val = t3.val WHERE t2.id = t1.id) as label
    FROM t1 ORDER BY t1.id;
}
expect {
    1|ten
    2|
    3|thirty
    4|
}

# Reversed join order: t3 JOIN t2 instead of t2 JOIN t3
@setup schema
test correlated-subquery-reversed-join {
    SELECT t1.id,
      (SELECT t3.label FROM t3 JOIN t2 ON t2.val = t3.val WHERE t2.id = t1.id) as label
    FROM t1 ORDER BY t1.id;
}
expect {
    1|ten
    2|twenty
    3|thirty
}

# Multiple correlated subqueries in the same SELECT
@setup schema
test correlated-subquery-with-join-multiple-cols {
    SELECT t1.id,
      (SELECT t2.val FROM t2 JOIN t3 ON t2.val = t3.val WHERE t2.id = t1.id) as val,
      (SELECT t3.label FROM t2 JOIN t3 ON t2.val = t3.val WHERE t2.id = t1.id) as label
    FROM t1 ORDER BY t1.id;
}
expect {
    1|10|ten
    2|20|twenty
    3|30|thirty
}

# Single outer row that is not the first id (edge case)
setup schema-single-row {
    CREATE TABLE t1(id INT);
    CREATE TABLE t2(id INT, val INT);
    CREATE TABLE t3(val INT, label TEXT);
    INSERT INTO t1 VALUES (2);
    INSERT INTO t2 VALUES (1,10),(2,20),(3,30);
    INSERT INTO t3 VALUES (10,'ten'),(20,'twenty'),(30,'thirty');
}

@setup schema-single-row
test correlated-subquery-single-outer-row {
    SELECT t1.id,
      (SELECT t3.label FROM t2 JOIN t3 ON t2.val = t3.val WHERE t2.id = t1.id) as label
    FROM t1;
}
expect {
    2|twenty
}

setup outer-column-in-join-condition {
    CREATE TABLE oc_outer(id INTEGER PRIMARY KEY, x INT);
    CREATE TABLE oc_items(id INTEGER PRIMARY KEY, b INT);
    INSERT INTO oc_outer VALUES (1, 1), (2, 2), (3, 2);
    INSERT INTO oc_items VALUES (1, 1), (2, 2);
}

@setup outer-column-in-join-condition
test correlated-subquery-join-condition-reads-the-outer-row {
    SELECT r.id,
      (SELECT count(*)
       FROM oc_outer AS m JOIN oc_items AS n ON r.id = m.x
       WHERE n.b < (SELECT max(w.b) FROM oc_items AS w WHERE r.x > 0))
    FROM oc_outer AS r
    ORDER BY r.id;
}
expect {
    1|1
    2|2
    3|0
}

# The main plan has no loop for t3, a table of the materialized hash build
# input. The probe of the hash join reads the columns of t3 from the hash
# payload. A subquery that reads t3 must run in the probe loop and read the
# payload, not before the loops with the old row of the t3 cursor.
setup materialized-build-input-with-subquery-schema {
    CREATE TABLE t0(id INTEGER PRIMARY KEY, a INTEGER, b INTEGER, c INTEGER);
    CREATE TABLE t2(a INTEGER, b INTEGER, c INTEGER);
    CREATE INDEX t2_c ON t2(c);
    CREATE TABLE t3(a INTEGER, b INTEGER, c INTEGER);
    INSERT INTO t3 VALUES (2, 3, NULL);
    ANALYZE;
    INSERT INTO t2 VALUES (1, 5, NULL), (2, 6, NULL);
    INSERT INTO t0 VALUES (1, 5, 3, 7);
}

@setup materialized-build-input-with-subquery-schema
test exists-in-left-join-on-term-reads-table-of-materialized-build-input {
    SELECT t3.a, t2.b, t0.id FROM t3
    CROSS JOIN t2
    LEFT JOIN t0 ON t0.a = t2.b AND EXISTS (SELECT 1 FROM t0 AS q WHERE q.b = t3.b)
    WHERE t2.c IS NULL;
}
expect unordered {
    2|5|1
    2|6|
}

@setup materialized-build-input-with-subquery-schema
test result-column-subquery-reads-table-of-materialized-build-input {
    SELECT t3.a, t2.b, t0.id, (SELECT count(*) FROM t0 AS q WHERE q.b = t3.b) FROM t3
    CROSS JOIN t2
    JOIN t0 ON t0.a = t2.b
    WHERE t2.c IS NULL;
}
expect {
    2|5|1|1
}

# The optimizer can choose a later table for an EXISTS, to cut its calls. Here
# it chose t6, the probe table of the hash join. The plan of the materialized
# hash build input has no loop for t6, so the subquery runs at its earliest
# loop in that plan.
test exists-with-later-table-outside-plan-of-materialized-build-input {
    CREATE TABLE t0(a INTEGER, b INTEGER, c INTEGER);
    CREATE TABLE t1(a INTEGER, b INTEGER, c INTEGER);
    CREATE TABLE t2(a INTEGER, b INTEGER, c INTEGER);
    CREATE TABLE t3(a INTEGER, b INTEGER, c INTEGER);
    INSERT INTO t3 VALUES (2, 1, 1);
    CREATE TABLE t4(a INTEGER, b INTEGER, c INTEGER);
    CREATE TABLE t5(a INTEGER, b INTEGER, c INTEGER);
    INSERT INTO t5 VALUES (2, 1, NULL);
    CREATE TABLE t6(a INTEGER, b INTEGER, c INTEGER);
    INSERT INTO t6 VALUES (NULL, 2, NULL);
    CREATE TABLE t7(a INTEGER, b INTEGER, c INTEGER);
    INSERT INTO t7 VALUES (NULL, 2, 1);
    CREATE TABLE t8(a INTEGER, b INTEGER, c INTEGER);
    CREATE TABLE t9(a INTEGER, b INTEGER, c INTEGER);
    CREATE TABLE t10(a INTEGER, b INTEGER, c INTEGER);
    CREATE TABLE t11(a INTEGER, b INTEGER, c INTEGER);
    CREATE INDEX t11_a ON t11(a);
    CREATE TABLE t12(a INTEGER, b INTEGER, c INTEGER);
    CREATE TABLE t13(a INTEGER, b INTEGER, c INTEGER);
    CREATE TABLE t14(a INTEGER, b INTEGER, c INTEGER);
    ANALYZE;
    SELECT * FROM t0
      JOIN t1 ON t1.a = t0.b
      JOIN t2 ON t2.b = t0.b
      JOIN t3 ON t1.c = 3
      JOIN t4 ON t4.b = t1.b
      JOIN t5 ON t5.b = t4.b
      JOIN t6 ON t6.c = t5.a
      JOIN t7 ON t7.a = t5.a
      JOIN t8 ON t8.c = t5.c
      JOIN t11 ON t11.b = t3.c
      JOIN t12
      JOIN t13 ON t13.a IS t11.b
      JOIN t14
     WHERE t11.c IS t7.b AND t11.a = 1
       AND EXISTS (SELECT 1 FROM t9 WHERE t9.a = t7.c)
       AND EXISTS (SELECT 1 FROM t10 WHERE t10.b = t3.c AND t10.c IS NULL);
}
expect {
}

# A correlated subquery in WHERE reads a table that is not part of the
# materialized hash build input, so it must not run while building that input.
setup materialized-build-input-schema {
    CREATE TABLE t1(a, b);
    CREATE TABLE t2(a, b);
    CREATE TABLE t4(a, c);
    CREATE INDEX t4_c ON t4(c);
    INSERT INTO t1 VALUES (1, 2);
    INSERT INTO t2 VALUES (3, 2);
    INSERT INTO t4 VALUES (3, 10);
}

@setup materialized-build-input-schema
test correlated-exists-reads-table-outside-materialized-build-input {
    SELECT 1 FROM t1 AS s, t2, t4
    WHERE s.b = t2.b AND t2.a = t4.a AND EXISTS (SELECT 1 FROM t1 AS x WHERE x.a = s.a) AND t4.c = 10
    LIMIT 1;
}
expect {
    1
}

@setup materialized-build-input-schema
test correlated-exists-reads-from-subquery-outside-materialized-build-input {
    SELECT 1 FROM (SELECT a, b FROM t1) AS s, t2, t4
    WHERE s.b = t2.b AND t2.a = t4.a AND EXISTS (SELECT 1 FROM t1 AS x WHERE x.a = s.a) AND t4.c = 10
    LIMIT 1;
}
expect {
    1
}

@setup materialized-build-input-schema
test correlated-not-exists-reads-table-outside-materialized-build-input {
    SELECT 1 FROM t1 AS s, t2, t4
    WHERE s.b = t2.b AND t2.a = t4.a AND NOT EXISTS (SELECT 1 FROM t1 AS x WHERE x.a = s.a) AND t4.c = 10
    LIMIT 1;
}
expect {
}

@setup materialized-build-input-schema
test correlated-scalar-subquery-reads-table-outside-materialized-build-input {
    SELECT 1 FROM t1 AS s, t2, t4
    WHERE s.b = t2.b AND t2.a = t4.a AND (SELECT count(*) FROM t1 AS x WHERE x.a = s.a) > 0 AND t4.c = 10
    LIMIT 1;
}
expect {
    1
}

setup large-tables {
    CREATE TABLE o(id INTEGER PRIMARY KEY, a INT);
    CREATE TABLE p(id INTEGER PRIMARY KEY, x INT, y INT);
    CREATE TABLE q(id INTEGER PRIMARY KEY, x INT, z INT);
    CREATE INDEX p_x ON p(x);
    CREATE INDEX q_x ON q(x);
    CREATE INDEX q_z ON q(z);
    WITH RECURSIVE c(n) AS (VALUES(1) UNION ALL SELECT n + 1 FROM c WHERE n < 300)
    INSERT INTO p SELECT n, n % 10, (n * 7) % 31 FROM c;
    WITH RECURSIVE c(n) AS (VALUES(1) UNION ALL SELECT n + 1 FROM c WHERE n < 300)
    INSERT INTO q SELECT n, (n * 3) % 10, (n * 11) % 31 FROM c;
    INSERT INTO o VALUES (1, 1), (2, 2), (3, 3), (4, NULL);
}

@setup large-tables
test correlated-subquery-hash-join-build-filter-reads-the-outer-row {
    SELECT o.id, (SELECT count(*) FROM p JOIN q ON p.y = q.z WHERE q.x IN (SELECT o.a))
    FROM o
    ORDER BY o.id;
}
expect {
    1|290
    2|291
    3|290
    4|0
}

@setup large-tables
@skip-if sqlite "SQLite does not use hash joins"
test correlated-subquery-hash-join-build-filter-reads-the-outer-row-uses-a-hash-join {
    EXPLAIN QUERY PLAN
    SELECT o.id, (SELECT count(*) FROM p JOIN q ON p.y = q.z WHERE q.x IN (SELECT o.a))
    FROM o
    ORDER BY o.id;
}
expect pattern {
    (?s)CORRELATED SCALAR SUBQUERY.*HASH JOIN p
}

@setup large-tables
test correlated-subquery-materialized-hash-build-reads-the-outer-row {
    SELECT o.id, (SELECT c FROM (SELECT count(*) AS c FROM p JOIN q ON p.y = q.z WHERE q.x = o.a) LIMIT 1)
    FROM o
    ORDER BY o.id;
}
expect {
    1|290
    2|291
    3|290
    4|0
}

@setup large-tables
@skip-if sqlite "SQLite does not use hash joins"
test correlated-subquery-materialized-hash-build-reads-the-outer-row-uses-no-hash-join {
    EXPLAIN QUERY PLAN
    SELECT o.id, (SELECT c FROM (SELECT count(*) AS c FROM p JOIN q ON p.y = q.z WHERE q.x = o.a) LIMIT 1)
    FROM o
    ORDER BY o.id;
}
expect {
    1|0|0|SCAN o
    4|0|0|CORRELATED SCALAR SUBQUERY 1
    7|4|0|SCAN (subquery-0)
    9|7|0|SEARCH q USING INDEX q_x (x=?)
    10|7|0|SEARCH p USING COVERING INDEX ephemeral_p_t3 (y=?)
}
