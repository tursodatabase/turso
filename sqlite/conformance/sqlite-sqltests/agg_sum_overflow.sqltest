@database :memory:

# sum() integer-overflow semantics (sumStep/sumFinalize, func.c): an
# integer add that overflows switches the accumulator to the approximate
# Kahan-Babuška path and remembers the overflow; the error surfaces at
# finalize only if every input was an integer. Any float input makes the
# result a float approximation and forgives the overflow — per the
# documented contract, "integer overflow" applies to all-integer sums
# only.

setup ints {
    CREATE TABLE t(v INT);
    INSERT INTO t VALUES (9223372036854775807),(1);
}

@setup ints
test sum-all-int-overflow-errors {
    SELECT sum(v) FROM t;
}
expect error {
}

setup int_overflow_then_float {
    CREATE TABLE t(v);
    INSERT INTO t VALUES (9223372036854775807),(1),(1.5);
}

# The overflow happens on the second value, the float arrives after —
# the result must be approximate, not an error.
@setup int_overflow_then_float
test sum-overflow-forgiven-by-later-float {
    SELECT typeof(sum(v)), printf('%.6e', sum(v)) FROM t;
}
expect {
    real|9.223372e+18
}

setup float_then_int_overflow {
    CREATE TABLE t(v);
    INSERT INTO t VALUES (1.5),(9223372036854775807),(9223372036854775807);
}

# With a float first the sum is approximate from the start; huge integer
# steps never touch the exact path, so no error either.
@setup float_then_int_overflow
test sum-float-first-never-int-overflows {
    SELECT typeof(sum(v)), printf('%.6e', sum(v)) FROM t;
}
expect {
    real|1.844674e+19
}

# total() never raises integer overflow regardless of input mix.
@setup ints
test total-never-errors-on-overflow {
    SELECT typeof(total(v)), printf('%.6e', total(v)) FROM t;
}
expect {
    real|9.223372e+18
}

# avg() shares sum's accumulator but never raises the overflow error
# either (avgFinalize, func.c).
@setup ints
test avg-never-errors-on-overflow {
    SELECT typeof(avg(v)), printf('%.6e', avg(v)) FROM t;
}
expect {
    real|4.611686e+18
}

test sum-text-overflow-cleared-by-later-decimal {
    WITH t(a) AS (VALUES('9223372036854775807'),('1'),('0.5'))
    SELECT typeof(sum(a)), sum(a) = 9223372036854775808.0 FROM t;
}
expect {
    real|1
}

test sum-text-overflow-cleared-by-later-non-number {
    WITH t(a) AS (VALUES('9223372036854775807'),('1'),('abc'))
    SELECT typeof(sum(a)), sum(a) = 9223372036854775808.0 FROM t;
}
expect {
    real|1
}

test sum-text-overflow-cleared-by-later-decimal-with-trailing-text {
    WITH t(a) AS (VALUES('9223372036854775807'),('1'),('0.5abc'))
    SELECT typeof(sum(a)), sum(a) = 9223372036854775808.0 FROM t;
}
expect {
    real|1
}

test sum-text-overflow-cleared-by-later-integer-with-trailing-text {
    WITH t(a) AS (VALUES('9223372036854775807'),('1'),('1abc'))
    SELECT typeof(sum(a)), sum(a) = 9223372036854775808.0 FROM t;
}
expect {
    real|1
}

test sum-text-overflow-cleared-by-later-blob {
    WITH t(a) AS (VALUES('9223372036854775807'),('1'),(x'31'))
    SELECT typeof(sum(a)), sum(a) = 9223372036854775808.0 FROM t;
}
expect {
    real|1
}

# The total keeps the low bits of the integers added before the overflow.
test sum-text-overflow-keeps-low-bits {
    WITH t(a) AS (VALUES('9223372036854775807'),('1'),('0.5'),('-9223372036854775807'))
    SELECT sum(a) = 1.5 FROM t;
}
expect {
    1
}

test sum-text-then-decimal-or-non-number-keeps-low-bits {
    WITH t(a) AS (VALUES('9223372036854775807'),('0.5'),('-9223372036854775807'))
    SELECT sum(a) = 0.5 FROM t;
    WITH t(a) AS (VALUES('9223372036854775807'),('abc'),('-9223372036854775807'))
    SELECT sum(a) = 0.0 FROM t;
}
expect {
    1
    1
}

# Text that only starts with a number, and a BLOB, are added as doubles.
test sum-text-overflow-then-integer-with-trailing-text-adds-a-double {
    WITH t(a) AS (VALUES('9223372036854775807'),('1'),('-9223372036854775807abc'))
    SELECT typeof(sum(a)), sum(a) = 0.0 FROM t;
}
expect {
    real|1
}

test sum-text-overflow-then-blob-adds-a-double {
    WITH t(a) AS (VALUES('9223372036854775807'),('1'),(CAST('-9223372036854775807' AS BLOB)))
    SELECT typeof(sum(a)), sum(a) = 0.0 FROM t;
}
expect {
    real|1
}

test sum-integer-then-integer-with-trailing-text-adds-a-double {
    WITH t(a) AS (VALUES('9223372036854775807'),('-9223372036854775807abc'))
    SELECT typeof(sum(a)), sum(a) = -1.0 FROM t;
}
expect {
    real|1
}

test sum-text-overflow-still-errors {
    WITH t(a) AS (VALUES('9223372036854775807'),('1'))
    SELECT sum(a) FROM t;
}
expect error {
    integer overflow
}

test sum-text-overflow-still-errors-for-zero-followed-by-nul {
    WITH t(a) AS (VALUES('9223372036854775807'),('1'),('0' || char(0) || 'abc'))
    SELECT sum(a) FROM t;
}
expect error {
    integer overflow
}

test sum-overflow-with-null-still-errors {
    WITH t(a) AS (VALUES(9223372036854775807),(1),(NULL))
    SELECT sum(a) FROM t;
}
expect error {
    integer overflow
}
