@database :memory:

# A grouped row keeps only the columns read after grouping: GROUP BY keys,
# aggregate arguments and filters, and the other columns outputs, HAVING,
# ORDER BY, windows and correlated subqueries read. Columns only a join or
# WHERE reads are not kept.

setup grouped-schema {
    CREATE TABLE a(id INTEGER PRIMARY KEY, k INT, v INT, t TEXT, w REAL);
    CREATE TABLE b(id INTEGER PRIMARY KEY, a_id INT, x INT, s TEXT);
    INSERT INTO a VALUES (1,1,10,'p',1.5),(2,1,20,'q',2.5),(3,2,30,'p',NULL),(4,NULL,40,'r',4.0),(5,2,50,NULL,5.5),(6,3,60,'q',6.0);
    INSERT INTO b VALUES (1,1,5,'u'),(2,1,6,'v'),(3,2,7,'u'),(4,3,8,NULL),(5,5,9,'w'),(6,6,1,'v'),(7,9,2,'x');
}

@setup grouped-schema
test grouped-join-key {
    SELECT a.k, count(*), sum(b.x) FROM a JOIN b ON b.a_id = a.id GROUP BY a.k ORDER BY a.k;
}
expect {
    1|3|18
    2|2|17
    3|1|1
}

@setup grouped-schema
test grouped-having-reads-other-column {
    SELECT a.k, sum(a.v) FROM a GROUP BY a.k HAVING max(a.w) > 2 ORDER BY a.k;
}
expect {
    |40
    1|30
    2|80
    3|60
}

@setup grouped-schema
test grouped-having-reads-alias {
    SELECT a.k, sum(a.v) AS s FROM a GROUP BY a.k HAVING s > 20 ORDER BY s;
}
expect {
    1|30
    |40
    3|60
    2|80
}

@setup grouped-schema
test grouped-expression-key {
    SELECT a.k + 1, count(*) FROM a GROUP BY a.k + 1 ORDER BY a.k + 1 DESC;
}
expect {
    4|1
    3|2
    2|2
    |1
}

@setup grouped-schema
test grouped-subquery-reads-key {
    SELECT a.k, (SELECT count(*) FROM b WHERE b.a_id = a.k) FROM a GROUP BY a.k ORDER BY a.k;
}
expect {
    |0
    1|2
    2|1
    3|1
}

@setup grouped-schema
test grouped-aggregate-filters {
    SELECT a.k, count(*) FILTER (WHERE a.v > 15), sum(a.v) FILTER (WHERE a.t = 'p') FROM a GROUP BY a.k ORDER BY a.k;
}
expect {
    |1|
    1|1|10
    2|2|30
    3|1|
}

@setup grouped-schema
test grouped-window-over-groups {
    SELECT a.k, sum(a.v), rank() OVER (ORDER BY sum(a.v)) FROM a GROUP BY a.k ORDER BY a.k;
}
expect {
    |40|2
    1|30|1
    2|80|4
    3|60|3
}

@setup grouped-schema
test grouped-distinct-aggregate-over-left-join {
    SELECT a.t, count(DISTINCT b.s) FROM a LEFT JOIN b ON b.a_id = a.id GROUP BY a.t ORDER BY a.t;
}
expect {
    |1
    p|2
    q|2
    r|0
}

@setup grouped-schema
test grouped-expression-over-bare-column {
    SELECT a.k, a.v * 2, min(a.v) FROM a GROUP BY a.k ORDER BY a.k;
}
expect {
    |80|40
    1|20|10
    2|60|30
    3|120|60
}

@setup grouped-schema
test grouped-where-only-column {
    SELECT a.k, sum(a.v) FROM a WHERE a.w > 1 GROUP BY a.k ORDER BY a.k NULLS LAST;
}
expect {
    1|30
    2|50
    3|60
    |40
}

@setup grouped-schema
test grouped-order-by-aggregate-of-join-column {
    SELECT b.s, sum(a.v + b.x) FROM a, b WHERE a.id = b.a_id GROUP BY b.s ORDER BY sum(a.w) DESC, b.s;
}
expect {
    v|77
    w|59
    u|42
    |38
}

@setup grouped-schema
test grouped-two-keys-from-two-tables {
    SELECT a.k, b.s, count(*) FROM a JOIN b ON b.a_id = a.id GROUP BY a.k, b.s ORDER BY a.k, b.s;
}
expect {
    1|u|2
    1|v|1
    2||1
    2|w|1
    3|v|1
}

@setup grouped-schema
test grouped-bare-rowid {
    SELECT a.k, a.id FROM a GROUP BY a.k ORDER BY a.k;
}
expect {
    |4
    1|1
    2|3
    3|6
}

@setup grouped-schema
test grouped-order-by-aggregate-then-key {
    SELECT a.k, sum(a.v) FROM a GROUP BY a.k ORDER BY count(a.t), a.k;
}
expect {
    |40
    2|80
    3|60
    1|30
}

@setup grouped-schema
test grouped-function-key {
    SELECT upper(a.t), count(*) FROM a GROUP BY upper(a.t) ORDER BY upper(a.t);
}
expect {
    |1
    P|2
    Q|2
    R|1
}

@setup grouped-schema
test grouped-nested-subquery-reads-key {
    SELECT a.k, (SELECT group_concat(b.s) FROM b WHERE b.a_id IN (SELECT id FROM a a2 WHERE a2.k = a.k)) FROM a GROUP BY a.k ORDER BY a.k;
}
expect {
    |
    1|u,v,u
    2|w
    3|v
}


# A HAVING aggregate over an output alias reads the columns of that output.
test grouped-having-aggregate-of-alias {
    CREATE TABLE g(c);
    INSERT INTO g VALUES (1), (1), (-2), (3);
    SELECT c FROM g GROUP BY c HAVING sum(c) < 1;
    SELECT c FROM g GROUP BY 1, 1, c HAVING avg(c) > 0 ORDER BY c;
    SELECT c AS k FROM g GROUP BY k HAVING count(k) > 1;
}
expect {
    -2
    1
    3
    1
}
