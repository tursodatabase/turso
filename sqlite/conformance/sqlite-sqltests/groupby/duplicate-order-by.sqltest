@database :memory:

@cross-check-integrity
test duplicate_order_by_with_group_by {
    CREATE TABLE t(a);
    INSERT INTO t VALUES (3), (1), (2);
    SELECT a FROM t GROUP BY a ORDER BY a, a;
}
expect {
    1
    2
    3
}

@cross-check-integrity
test duplicate_order_by_desc_with_group_by {
    CREATE TABLE t2(a);
    INSERT INTO t2 VALUES (3), (1), (2);
    SELECT a FROM t2 GROUP BY a ORDER BY a DESC, a DESC;
}
expect {
    3
    2
    1
}

@cross-check-integrity
test triple_duplicate_order_by_with_group_by {
    CREATE TABLE t3(a);
    INSERT INTO t3 VALUES (3), (1), (2);
    SELECT a FROM t3 GROUP BY a ORDER BY a, a, a;
}
expect {
    1
    2
    3
}

# When every ORDER BY term is a GROUP BY key, groups already come out in
# ORDER BY order and need no second sort. Other ORDER BY terms, collations
# and directions must still sort correctly.

setup group-order-schema {
    CREATE TABLE t(a, b TEXT, c TEXT COLLATE NOCASE, n INT);
    INSERT INTO t VALUES (1,'x','A',1),(2,'X','a',2),(NULL,'y','b',3),(1,'Y','B',4),(3,NULL,NULL,5),(2,'x','c',6),(NULL,NULL,'A',7),('1','x','a',8);
}

@setup group-order-schema
test order-by-group-key-key-asc {
    SELECT a, count(*) FROM t GROUP BY a ORDER BY a;
}
expect {
    |2
    1|2
    2|2
    3|1
    1|1
}

@setup group-order-schema
test order-by-group-key-key-desc {
    SELECT a, count(*) FROM t GROUP BY a ORDER BY a DESC;
}
expect {
    1|1
    3|1
    2|2
    1|2
    |2
}

@setup group-order-schema
test order-by-group-key-key-nulls-last {
    SELECT a, count(*) FROM t GROUP BY a ORDER BY a NULLS LAST;
}
expect {
    1|2
    2|2
    3|1
    1|1
    |2
}

@setup group-order-schema
test order-by-group-key-key-desc-nulls-first {
    SELECT a, count(*) FROM t GROUP BY a ORDER BY a DESC NULLS FIRST;
}
expect {
    |2
    1|1
    3|1
    2|2
    1|2
}

@setup group-order-schema
test order-by-group-key-two-keys {
    SELECT a, b, sum(n) FROM t GROUP BY a, b ORDER BY a, b;
}
expect {
    ||7
    |y|3
    1|Y|4
    1|x|1
    2|X|2
    2|x|6
    3||5
    1|x|8
}

@setup group-order-schema
test order-by-group-key-two-keys-first-desc {
    SELECT a, b, sum(n) FROM t GROUP BY a, b ORDER BY a DESC, b;
}
expect {
    1|x|8
    3||5
    2|X|2
    2|x|6
    1|Y|4
    1|x|1
    ||7
    |y|3
}

@setup group-order-schema
test order-by-group-key-first-key-only {
    SELECT a, b, sum(n) FROM t GROUP BY a, b ORDER BY a;
}
expect {
    ||7
    |y|3
    1|Y|4
    1|x|1
    2|X|2
    2|x|6
    3||5
    1|x|8
}

@setup group-order-schema
test order-by-group-key-second-key-only {
    SELECT a, b, sum(n) FROM t GROUP BY a, b ORDER BY b;
}
expect {
    ||7
    3||5
    2|X|2
    1|Y|4
    1|x|1
    2|x|6
    1|x|8
    |y|3
}

@setup group-order-schema
test order-by-group-key-nocase-key {
    SELECT c, count(*) FROM t GROUP BY c ORDER BY c;
}
expect {
    |1
    A|4
    b|2
    c|1
}

@setup group-order-schema
test order-by-group-key-other-collation-then-count {
    SELECT b, count(*) FROM t GROUP BY b ORDER BY b COLLATE NOCASE, count(*);
}
expect {
    |2
    X|1
    x|3
    Y|1
    y|1
}

@setup group-order-schema
test order-by-group-key-binary-order-of-nocase-key {
    SELECT c, count(*) FROM t GROUP BY c ORDER BY c COLLATE BINARY;
}
expect {
    |1
    A|4
    b|2
    c|1
}

@setup group-order-schema
test order-by-group-key-expression-key-by-alias {
    SELECT a + 1 AS k, count(*) FROM t GROUP BY a + 1 ORDER BY k DESC;
}
expect {
    4|1
    3|2
    2|3
    |2
}

@setup group-order-schema
test order-by-group-key-aggregate {
    SELECT a, count(*) FROM t GROUP BY a ORDER BY count(*), a;
}
expect {
    3|1
    1|1
    |2
    1|2
    2|2
}

@setup group-order-schema
test order-by-group-key-having-and-limit {
    SELECT a, count(*) FROM t GROUP BY a HAVING count(*) > 1 ORDER BY a DESC LIMIT 1;
}
expect {
    2|2
}

@setup group-order-schema
test order-by-group-key-two-keys-desc {
    SELECT b, a, sum(n) FROM t GROUP BY b, a ORDER BY b DESC, a DESC;
}
expect {
    y||3
    x|1|8
    x|2|6
    x|1|1
    Y|1|4
    X|2|2
    |3|5
    ||7
}

@setup group-order-schema
test order-by-group-key-second-key-desc-then-first {
    SELECT a, b, sum(n) FROM t GROUP BY a, b ORDER BY b DESC, a;
}
expect {
    |y|3
    1|x|1
    2|x|6
    1|x|8
    1|Y|4
    2|X|2
    ||7
    3||5
}

@setup group-order-schema
test order-by-group-key-reordered-keys-with-having {
    SELECT c, a, count(*) FROM t GROUP BY a, c HAVING count(*) >= 1 ORDER BY c, a DESC;
}
expect {
    |3|1
    a|1|1
    a|2|1
    A|1|1
    A||1
    B|1|1
    b||1
    c|2|1
}

@setup group-order-schema
test order-by-group-key-repeated-term {
    SELECT a, b FROM t GROUP BY a, b ORDER BY b, b DESC, a;
}
expect {
    |
    3|
    2|X
    1|Y
    1|x
    2|x
    1|x
    |y
}

