@database :memory:

# A subquery in HAVING, in ORDER BY, or that reads an aggregate of the outer
# query runs once per group, after the outer table scan has moved on. It must
# read the outer columns saved for the group, not the scan's current row. With
# a sorter the scan has ended, so the column read NULL. Without a sorter the
# scan is on the first row of the next group, so the column read that group's
# value.

setup tables {
    CREATE TABLE s(b TEXT, i INTEGER);
    INSERT INTO s VALUES ('1',1),('2',2),('3',3);
    CREATE TABLE t(k INTEGER PRIMARY KEY, g TEXT, v INTEGER);
    INSERT INTO t VALUES (1,'a',10),(2,'b',20),(3,'c',30);
    CREATE INDEX t_g ON t(g);
    CREATE TABLE u(g TEXT, w INTEGER);
    INSERT INTO u VALUES ('a',20),('b',20),('b',21),('c',1);
}

@setup tables
test having-subquery-reads-column-not-in-group-by {
    SELECT s.b FROM s GROUP BY s.b HAVING (SELECT s.i) = 2;
}
expect {
    2
}

@setup tables
test having-subquery-reads-group-by-column {
    SELECT (SELECT s.b) FROM s GROUP BY s.b HAVING (SELECT s.b) = '2';
}
expect {
    2
}

@setup tables
test having-subquery-reads-expression-of-outer-column {
    SELECT s.b FROM s GROUP BY s.b HAVING (SELECT s.i + 1) = 3;
}
expect {
    2
}

@setup tables
test having-reads-select-list-subquery-through-alias {
    SELECT s.b, (SELECT s.i) AS x FROM s GROUP BY s.b HAVING x = 2;
}
expect {
    2|2
}

@setup tables
test having-subquery-with-aggregate-in-select-list {
    SELECT count(*) FROM s GROUP BY s.b HAVING (SELECT s.i) = 2;
}
expect {
    1
}

@setup tables
test having-subquery-inside-case {
    SELECT b FROM s GROUP BY b HAVING CASE WHEN (SELECT s.i) = 2 THEN 1 ELSE 0 END;
}
expect {
    2
}

@setup tables
test having-exists-reads-outer-column {
    SELECT s.b FROM s GROUP BY s.b HAVING EXISTS (SELECT 1 WHERE s.i = 2);
}
expect {
    2
}

@setup tables
test having-in-with-outer-column-on-the-left {
    SELECT s.b FROM s GROUP BY s.b HAVING s.i IN (SELECT 2);
}
expect {
    2
}

@setup tables
test having-in-with-outer-column-in-the-subquery {
    SELECT s.b FROM s GROUP BY s.b HAVING 2 IN (SELECT s.i);
}
expect {
    2
}

@setup tables
test having-not-in-with-aggregate-on-the-left {
    SELECT b, sum(i) FROM s GROUP BY b HAVING sum(i) NOT IN (SELECT s.i + 1) ORDER BY b;
}
expect {
    1|1
    2|2
    3|3
}

@setup tables
test order-by-subquery-reads-outer-column {
    SELECT s.b FROM s GROUP BY s.b ORDER BY (SELECT s.i) DESC;
}
expect {
    3
    2
    1
}

@setup tables
test order-by-subquery-reads-aggregate-and-outer-column {
    SELECT b, count(*) FROM s GROUP BY b ORDER BY (SELECT s.i + count(*)) DESC;
}
expect {
    3|1
    2|1
    1|1
}

@setup tables
test having-subquery-without-a-sorter {
    SELECT g FROM t INDEXED BY t_g GROUP BY g HAVING (SELECT t.v) = 20;
}
expect {
    b
}

@setup tables
test order-by-subquery-without-a-sorter {
    SELECT g FROM t INDEXED BY t_g GROUP BY g ORDER BY (SELECT t.v) DESC;
}
expect {
    c
    b
    a
}

@setup tables
test having-subquery-column-missing-from-the-index-scanned {
    CREATE INDEX s_b ON s(b);
    SELECT b FROM s GROUP BY b HAVING (SELECT s.i) = 2;
}
expect {
    2
}

@setup tables
test having-subquery-reads-rowid-alias {
    SELECT g FROM t GROUP BY g HAVING (SELECT t.k) = 2;
}
expect {
    b
}

@setup tables
test having-subquery-reads-rowid {
    SELECT b FROM s GROUP BY b HAVING (SELECT s.rowid) = 2;
}
expect {
    2
}

@setup tables
test having-nested-subquery-reads-rowid {
    SELECT b FROM s GROUP BY b HAVING (SELECT (SELECT s.rowid)) = 2;
}
expect {
    2
}

@setup tables
test having-nested-subquery-reads-column {
    SELECT b FROM s GROUP BY b HAVING (SELECT (SELECT s.i)) = 2;
}
expect {
    2
}

@setup tables
test having-from-clause-subquery-reads-outer-column {
    SELECT b FROM s GROUP BY b HAVING (SELECT x FROM (SELECT s.i AS x)) = 2;
}
expect {
    2
}

@setup tables
test having-subquery-scans-a-table {
    SELECT t.g FROM t GROUP BY t.g HAVING (SELECT count(*) FROM u WHERE u.w = t.v) = 2;
}
expect {
    b
}

@setup tables
test having-subquery-over-a-join {
    SELECT t.g FROM t JOIN u ON t.g = u.g GROUP BY t.g HAVING (SELECT t.v) = 20;
}
expect {
    b
}

@setup tables
test having-subquery-reads-column-of-unmatched-left-join-row {
    SELECT t.g FROM t LEFT JOIN u ON u.g = t.g AND u.w > 100
    GROUP BY t.g HAVING (SELECT u.w) IS NULL ORDER BY t.g;
}
expect {
    a
    b
    c
}

@setup tables
test having-subquery-reads-column-of-a-group-by-expression {
    SELECT lower(g) FROM t GROUP BY lower(g) HAVING (SELECT t.g) = 'b';
}
expect {
    b
}

@setup tables
test having-subquery-reads-column-of-a-from-clause-subquery {
    SELECT d.x FROM (SELECT b AS x, i AS y FROM s) d GROUP BY d.x HAVING (SELECT d.y) = 2;
}
expect {
    2
}

@setup tables
test having-subquery-with-distinct {
    SELECT DISTINCT b FROM s GROUP BY b HAVING (SELECT s.i) > 1 ORDER BY b;
}
expect {
    2
    3
}

@setup tables
test having-subquery-with-limit {
    SELECT b FROM s GROUP BY b HAVING (SELECT s.i) > 1 ORDER BY b LIMIT 1;
}
expect {
    2
}

@setup tables
test having-subquery-with-window-function {
    SELECT b, sum(1) OVER () FROM s GROUP BY b HAVING (SELECT s.i) > 1 ORDER BY b;
}
expect {
    2|2
    3|2
}

@setup tables
test having-subquery-in-a-correlated-subquery {
    SELECT t.g FROM t
    WHERE (SELECT count(*) FROM s GROUP BY s.b HAVING (SELECT s.i) = t.k) = 1
    ORDER BY t.g;
}
expect {
    a
    b
    c
}

@setup tables
test having-subquery-reads-aggregate-and-outer-column {
    SELECT g FROM t GROUP BY g HAVING (SELECT sum(t.v) + t.k) = 22;
}
expect {
    b
}

@setup tables
test select-list-subquery-reads-aggregate-and-outer-column {
    SELECT g, (SELECT sum(t.v) + t.k) FROM t GROUP BY g ORDER BY g;
}
expect {
    a|11
    b|22
    c|33
}
