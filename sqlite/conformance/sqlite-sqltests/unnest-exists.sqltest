    one
    one
    two
}

@setup schema_logical_duplicates
test exists-after-merging-an-inner-join-filter {
    SELECT a.tag, b.tag FROM outer_rows a JOIN outer_rows b ON a.k = b.k
    WHERE a.k > 0 AND EXISTS (
        SELECT 1 FROM inner_rows i WHERE i.k > a.k OR i.alternate IS b.k
    )
    ORDER BY a.tag, b.tag;
