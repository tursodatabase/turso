setup joined_input_types {
    CREATE TABLE outer_types(k, tag TEXT);
    INSERT INTO outer_types VALUES
        (1, 'integer'), (1.0, 'real'), ('01', 'zero'), ('A', 'upper'),
        ('a', 'lower'), (NULL, 'null'), (X'41', 'blob');
    CREATE TABLE inner_types(k TEXT COLLATE NOCASE);
    INSERT INTO inner_types VALUES ('1'), ('A'), (NULL);
    CREATE TABLE copies(n INTEGER);
    INSERT INTO copies VALUES (1), (1), (NULL);
}

@setup joined_input_types
test joined-inner-input-preserves-text-affinity-and-nocase {
    SELECT tag FROM outer_types o WHERE EXISTS (
        SELECT 1 FROM inner_types i JOIN copies c ON c.n = 1
        WHERE i.k = o.k
    ) ORDER BY tag;
}
expect {
    lower
    upper
}

@setup joined_input_types
test joined-anti-input-preserves-text-affinity-and-nocase {
    SELECT tag FROM outer_types o WHERE NOT EXISTS (
        SELECT 1 FROM inner_types i JOIN copies c ON c.n = 1
        WHERE i.k = o.k
    ) ORDER BY tag;
}
expect {
    blob
    integer
    null
    real
    zero
}

