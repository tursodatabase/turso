@setup schema_logical_duplicates
test distinct-after-a-correlated-filter-removes-duplicate-rows {
    SELECT k, tag FROM (
        SELECT DISTINCT o.k, o.tag FROM outer_rows o
        WHERE EXISTS (
            SELECT 1 FROM inner_rows i WHERE i.k IS o.k OR i.alternate IS o.k
        )
    ) ORDER BY k;
}
expect {
    |null
    1|one
    2|two
}

@setup schema_logical_duplicates
test distinct-precedes-limit-and-offset-after-a-correlated-filter {
    SELECT count(*) FROM (
        SELECT DISTINCT o.k FROM outer_rows o
        WHERE EXISTS (
            SELECT 1 FROM inner_rows i WHERE i.k IS o.k OR i.alternate IS o.k
        ) LIMIT 2 OFFSET 1
    );
}
expect {
    2
}

@setup schema_logical_duplicates
test distinct-correlated-filter-orders-projected-expressions-before-limit {
    SELECT DISTINCT o.k + 1 AS next_value FROM outer_rows o
    WHERE EXISTS (
        SELECT 1 FROM inner_rows i WHERE i.k IS o.k OR i.alternate IS o.k
    ) ORDER BY next_value DESC LIMIT 2;
}
expect {
    3
    2
}

@setup schema_logical_duplicates
test distinct-correlated-filter-orders-an-expression-of-projected-columns {
    SELECT DISTINCT o.k, o.k + 1 FROM outer_rows o
    WHERE EXISTS (
        SELECT 1 FROM inner_rows i WHERE i.k IS o.k OR i.alternate IS o.k
    ) ORDER BY -o.k;
}
