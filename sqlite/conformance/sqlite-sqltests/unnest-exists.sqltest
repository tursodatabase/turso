test not-exists-with-a-joined-inner-input {
    SELECT tag FROM outer_rows o
    WHERE NOT EXISTS (
        SELECT 1 FROM inner_rows i JOIN inner_rows j ON i.k IS j.k
        WHERE i.k > o.k OR j.alternate IS o.k
    ) ORDER BY tag;
