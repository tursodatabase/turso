    WHERE EXISTS (SELECT 1 FROM t2 WHERE t2.x = t1.a)
    AND NOT EXISTS (SELECT 1 FROM t3 WHERE t3.y = t1.a)
    AND NOT EXISTS (SELECT 1 FROM t4 WHERE t4.z = t1.a)
