@setup schema_join_exists
test exists-no-matching-outer-rows {
    SELECT c.name FROM customers c
    WHERE c.region = 99
    AND EXISTS (SELECT 1 FROM orders o WHERE o.cust_id = c.id)
    ORDER BY c.name;
}
