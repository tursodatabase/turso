setup schema_logical_duplicates {
    CREATE TABLE outer_rows(k INTEGER, tag TEXT);
    CREATE TABLE inner_rows(k INTEGER, alternate INTEGER);
    INSERT INTO outer_rows VALUES (NULL, 'null'), (1, 'one'), (1, 'one'), (2, 'two'), (4, 'four');
    INSERT INTO inner_rows VALUES (NULL, NULL), (1, 2), (1, 2), (3, 1);
}

@setup schema_logical_duplicates
test exists-disjunction-keeps-outer-multiplicity {
    SELECT tag FROM outer_rows o
    WHERE EXISTS (SELECT 1 FROM inner_rows i WHERE i.k > o.k OR i.alternate = o.k)
    ORDER BY tag;
}
expect {
    one
    one
    two
}

@setup schema_logical_duplicates
test not-exists-disjunction-keeps-null-outer-row {
    SELECT tag FROM outer_rows o
    WHERE NOT EXISTS (SELECT 1 FROM inner_rows i WHERE i.k > o.k OR i.alternate = o.k)
    ORDER BY tag;
}
expect {
    four
    null
}

@setup schema_logical_duplicates
test exists-is-matches-null-without-duplicating-rows {
    SELECT tag FROM outer_rows o
    WHERE EXISTS (SELECT 1 FROM inner_rows i WHERE i.k IS o.k)
    ORDER BY tag;
}
expect {
    null
    one
    one
}

@setup schema_logical_duplicates
test not-exists-outer-only-disjunction {
    SELECT tag FROM outer_rows o
    WHERE NOT EXISTS (SELECT 1 FROM inner_rows i WHERE i.k > o.k OR o.k = 4)
    ORDER BY tag;
}
expect {
    null
}

@setup schema_logical_duplicates
test exists-short-circuit-keeps-error-unreached {
    SELECT tag FROM outer_rows o
    WHERE o.k = 4 AND EXISTS (
        SELECT 1 FROM inner_rows i
        WHERE CASE WHEN i.k > o.k THEN abs(-9223372036854775808) ELSE 0 END
    )
    ORDER BY tag;
}
expect {
}

@setup schema_logical_duplicates
test exists-over-two-materialized-cte-references {
    WITH shared AS MATERIALIZED (SELECT k, tag FROM outer_rows)
    SELECT a.tag, b.tag FROM shared a JOIN shared b ON a.k = b.k
    WHERE EXISTS (SELECT 1 FROM inner_rows i WHERE i.k > a.k)
    ORDER BY a.tag, b.tag;
}
expect {
    one|one
    one|one
    one|one
    one|one
    two|two
}

@setup schema_logical_duplicates
test exists-over-a-rewritten-shared-producer {
    WITH eligible AS MATERIALIZED (
        SELECT i.k FROM inner_rows i
        WHERE EXISTS (SELECT 1 FROM inner_rows j WHERE j.k > i.k)
    )
    SELECT tag FROM outer_rows o
    WHERE EXISTS (
        SELECT 1 FROM eligible a JOIN eligible b ON a.k IS b.k WHERE a.k IS o.k
    ) ORDER BY tag;
}
expect {
    one
    one
}

@setup schema_logical_duplicates
test exists-over-nested-rewritten-shared-producers {
    WITH first_shared AS MATERIALIZED (
        SELECT o.k, o.tag FROM outer_rows o
        WHERE EXISTS (SELECT 1 FROM inner_rows i WHERE i.k > o.k)
    ), second_shared AS MATERIALIZED (
        SELECT a.k, a.tag FROM first_shared a
        WHERE NOT EXISTS (SELECT 1 FROM inner_rows i WHERE i.k = a.k)
    )
    SELECT a.tag, b.tag FROM second_shared a JOIN second_shared b ON a.k IS b.k
    WHERE EXISTS (SELECT 1 FROM inner_rows i WHERE i.k > a.k)
    ORDER BY a.tag, b.tag;
}
expect {
    two|two
}

@setup schema_logical_duplicates
test not-exists-over-an-empty-rewritten-shared-producer {
    DELETE FROM inner_rows;
    WITH eligible AS MATERIALIZED (
        SELECT i.k FROM inner_rows i
        WHERE EXISTS (SELECT 1 FROM inner_rows j WHERE j.k > i.k)
    )
    SELECT tag FROM outer_rows o
    WHERE NOT EXISTS (SELECT 1 FROM eligible a WHERE a.k IS o.k)
    ORDER BY tag;
}
expect {
    four
    null
    one
    one
    two
}

@setup schema_logical_duplicates
test exists-over-an-independent-materialized-cte {
    WITH shared AS MATERIALIZED (SELECT k FROM inner_rows)
    SELECT tag FROM outer_rows o
    WHERE EXISTS (SELECT 1 FROM shared s WHERE s.k > o.k)
    ORDER BY tag;
}
expect {
    one
    one
    two
}

@setup schema_logical_duplicates
test not-exists-over-an-independent-materialized-cte {
    WITH shared AS MATERIALIZED (SELECT k FROM inner_rows)
    SELECT tag FROM outer_rows o
    WHERE NOT EXISTS (SELECT 1 FROM shared s WHERE s.k > o.k OR s.k IS o.k)
    ORDER BY tag;
}
expect {
    four
}

@setup schema_logical_duplicates
test exists-over-a-shared-input-also-read-by-the-outer-query {
    WITH shared AS MATERIALIZED (SELECT k, tag FROM outer_rows)
    SELECT a.tag, b.tag FROM shared a JOIN shared b ON a.k IS b.k
    WHERE EXISTS (SELECT 1 FROM shared c WHERE c.k > a.k)
    ORDER BY a.tag, b.tag;
}
expect {
    one|one
    one|one
    one|one
    one|one
    two|two
}

