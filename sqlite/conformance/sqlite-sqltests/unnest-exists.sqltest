@setup schema_logical_duplicates
test aggregate-shared-producer-keeps-one-result-per-group {
    WITH shared AS MATERIALIZED (
        SELECT o.k, count(*) AS n FROM outer_rows o
        WHERE EXISTS (SELECT 1 FROM inner_rows i WHERE i.k IS o.k OR i.alternate IS o.k)
        GROUP BY o.k
    ) SELECT a.k, a.n, b.n FROM shared a JOIN shared b ON a.k IS b.k ORDER BY a.k;
}
expect {
    |1|1
    1|2|2
    2|1|1
}

@setup schema_logical_duplicates
test aggregate-overflow-is-preserved-after-a-correlated-filter {
    CREATE TABLE aggregate_values(k INTEGER, v INTEGER);
    INSERT INTO aggregate_values VALUES (1, 9223372036854775807), (1, 1);
    SELECT sum(o.v) FROM aggregate_values o
    WHERE EXISTS (SELECT 1 FROM inner_rows i WHERE i.k IS o.k OR i.alternate IS o.k);
}
expect error {
    integer overflow
}

@setup schema_logical_duplicates
test aggregate-empty-group-does-not-evaluate-an-excluded-overflow {
    CREATE TABLE aggregate_values(k INTEGER, v INTEGER);
    INSERT INTO aggregate_values VALUES (1, 9223372036854775807), (1, 1);
    SELECT count(*), sum(o.v) FROM aggregate_values o
    WHERE EXISTS (SELECT 1 FROM inner_rows i WHERE i.k > o.k AND i.k > 10);
}
expect {
    0|
}

@setup schema_logical_duplicates
test aggregate-derived-input-keeps-descending-groups-with-limit {
    SELECT d.k, d.n FROM (
        SELECT o.k, count(*) AS n FROM outer_rows o
        WHERE EXISTS (SELECT 1 FROM inner_rows i WHERE i.k IS o.k OR i.alternate IS o.k)
        GROUP BY o.k ORDER BY o.k DESC NULLS FIRST LIMIT 2
    ) d ORDER BY d.k;
}
expect {
    |1
    2|1
}

@setup schema_logical_duplicates
test distinct-aggregate-results-are-deduplicated-before-limit {
    SELECT DISTINCT count(*) AS n FROM outer_rows o
    WHERE EXISTS (SELECT 1 FROM inner_rows i WHERE i.k IS o.k OR i.alternate IS o.k)
    GROUP BY o.k ORDER BY n DESC LIMIT 1 OFFSET 1;
}
expect {
    1
}

@setup schema_logical_duplicates
test distinct-aggregate-keeps-the-empty-input-row {
    SELECT DISTINCT count(*), sum(o.k) FROM outer_rows o
    WHERE EXISTS (SELECT 1 FROM inner_rows i WHERE i.k > o.k AND i.k > 10);
    SELECT DISTINCT count(*), sum(o.k) FROM outer_rows o
    WHERE EXISTS (SELECT 1 FROM inner_rows i WHERE i.k > o.k AND i.k > 10)
    LIMIT 1 OFFSET 1;
}
expect {
    0|
}

@setup schema_logical_duplicates
test distinct-aggregate-results-use-the-output-collation {
    CREATE TABLE grouped_values(k INTEGER, tag TEXT);
    INSERT INTO grouped_values VALUES (7, 'A'), (7, 'A'), (8, 'a'), (9, NULL), (10, NULL);
    SELECT count(*) FROM (
        SELECT DISTINCT min(o.tag) COLLATE NOCASE AS label FROM grouped_values o
        WHERE EXISTS (SELECT 1 FROM inner_rows i WHERE i.k IS NOT o.k)
        GROUP BY o.k
    );
}
expect {
    2
}

@setup schema_logical_duplicates
test distinct-aggregate-shared-producer-removes-duplicate-group-results {
    WITH shared AS MATERIALIZED (
        SELECT DISTINCT count(*) AS n FROM outer_rows o
        WHERE EXISTS (SELECT 1 FROM inner_rows i WHERE i.k IS o.k OR i.alternate IS o.k)
        GROUP BY o.k
    ) SELECT a.n, b.n FROM shared a JOIN shared b ON a.n = b.n ORDER BY a.n;
}
expect {
    1|1
    2|2
}

@setup schema_logical_duplicates
test exists-aggregate-keeps-a-row-when-its-filter-has-no-matches {
    SELECT o.tag FROM outer_rows o WHERE EXISTS (
        SELECT count(*) FROM inner_rows i WHERE i.k IS o.k
        AND EXISTS (SELECT 1 FROM inner_rows j WHERE j.k > i.k)
    ) ORDER BY o.tag;
    SELECT o.tag FROM outer_rows o WHERE NOT EXISTS (
        SELECT count(*) FROM inner_rows i WHERE i.k IS o.k
        AND EXISTS (SELECT 1 FROM inner_rows j WHERE j.k > i.k)
    ) ORDER BY o.tag;
}
expect {
    four
    null
    one
    one
    two
}

@setup schema_logical_duplicates
test exists-aggregate-having-can-keep-or-remove-an-empty-input-row {
    SELECT o.tag FROM outer_rows o WHERE EXISTS (
        SELECT count(*) FROM inner_rows i WHERE i.k IS o.k
        AND EXISTS (SELECT 1 FROM inner_rows j WHERE j.k > i.k)
        HAVING count(*) = 0
    ) ORDER BY o.tag;
    SELECT o.tag FROM outer_rows o WHERE EXISTS (
        SELECT count(*) FROM inner_rows i WHERE i.k IS o.k
        AND EXISTS (SELECT 1 FROM inner_rows j WHERE j.k > i.k)
        GROUP BY i.k HAVING count(*) > 1
    ) ORDER BY o.tag;
}
expect {
    four
    null
    two
    one
    one
}

@setup schema_logical_duplicates
test exists-aggregate-offset-counts-groups {
    SELECT o.tag FROM outer_rows o WHERE EXISTS (
        SELECT count(*) FROM inner_rows i WHERE i.k IS NOT o.k
        AND EXISTS (SELECT 1 FROM inner_rows j WHERE j.k IS NOT i.k)
        GROUP BY i.k LIMIT 1 OFFSET 2
    ) ORDER BY o.tag;
    SELECT o.tag FROM outer_rows o WHERE EXISTS (
        SELECT count(*) FROM inner_rows i WHERE i.k IS o.k
        AND EXISTS (SELECT 1 FROM inner_rows j WHERE j.k > i.k)
        LIMIT 1 OFFSET 1
    ) ORDER BY o.tag;
}
expect {
    four
    two
}

@setup schema_logical_duplicates
test exists-aggregate-does-not-evaluate-an-ignored-result-expression {
    SELECT count(*) FROM outer_rows o WHERE EXISTS (
        SELECT count(*) + abs(-9223372036854775808) FROM inner_rows i WHERE i.k IS o.k
        AND EXISTS (SELECT 1 FROM inner_rows j WHERE j.k > i.k)
    );
}
expect {
    5
}

@setup schema_logical_duplicates
test exists-aggregate-preserves-distinct-arguments-and-filters-in-having {
    SELECT o.tag FROM outer_rows o WHERE EXISTS (
        SELECT min(i.k) FROM inner_rows i WHERE i.k IS o.k
        AND EXISTS (SELECT 1 FROM inner_rows j WHERE j.k > i.k)
        GROUP BY i.k HAVING count(DISTINCT i.k) = 1
          AND sum(i.alternate) FILTER (WHERE i.alternate > 1) > 3
    ) ORDER BY o.tag;
}
expect {
    one
    one
}

@setup schema_logical_duplicates
test exists-aggregate-still-evaluates-an-ignored-aggregate-argument {
    CREATE TABLE aggregate_values(k INTEGER, v INTEGER);
    INSERT INTO aggregate_values VALUES (1, 9223372036854775807), (1, 1);
    SELECT o.tag FROM outer_rows o WHERE EXISTS (
        SELECT sum(i.v) FROM aggregate_values i WHERE i.k IS o.k
        AND EXISTS (SELECT 1 FROM inner_rows j WHERE j.k > i.k)
    );
}
expect error {
    integer overflow
}

@setup schema
test exists-compound-shared-union-all {
    WITH shared AS MATERIALIZED (
        SELECT a FROM t1 WHERE EXISTS (SELECT 1 FROM t2 WHERE t2.x > t1.a)
        UNION ALL SELECT a FROM t1 WHERE a >= 2
    ) SELECT a.a, b.a FROM shared a JOIN shared b ON a.a IS b.a
    WHERE EXISTS (SELECT 1 FROM t2 WHERE t2.x > a.a)
    ORDER BY a.a, b.a;
}
expect {
    1|1
    2|2
    2|2
    2|2
    2|2
}

@setup schema
test exists-compound-shared-union {
    WITH shared AS MATERIALIZED (
        SELECT a FROM t1 WHERE EXISTS (SELECT 1 FROM t2 WHERE t2.x > t1.a)
        UNION SELECT a FROM t1 WHERE a >= 2
    ) SELECT a.a, b.a FROM shared a JOIN shared b ON a.a IS b.a
    WHERE EXISTS (SELECT 1 FROM t2 WHERE t2.x > a.a)
    ORDER BY a.a, b.a;
}
expect {
    1|1
    2|2
}

@setup schema
test exists-compound-shared-intersect {
    WITH shared AS MATERIALIZED (
        SELECT a FROM t1 WHERE EXISTS (SELECT 1 FROM t2 WHERE t2.x > t1.a)
        INTERSECT SELECT a FROM t1 WHERE a >= 2
    ) SELECT a.a, b.a FROM shared a JOIN shared b ON a.a IS b.a
    WHERE EXISTS (SELECT 1 FROM t2 WHERE t2.x > a.a)
    ORDER BY a.a, b.a;
}
expect {
    2|2
}

@setup schema
test exists-compound-shared-except {
    WITH shared AS MATERIALIZED (
        SELECT a FROM t1 WHERE EXISTS (SELECT 1 FROM t2 WHERE t2.x > t1.a)
        EXCEPT SELECT a FROM t1 WHERE a >= 2
    ) SELECT a.a, b.a FROM shared a JOIN shared b ON a.a IS b.a
    WHERE EXISTS (SELECT 1 FROM t2 WHERE t2.x > a.a)
    ORDER BY a.a, b.a;
}
expect {
    1|1
}

@setup schema
test exists-compound-shared-order-limit-offset {
    WITH shared AS MATERIALIZED (
        SELECT a FROM t1 WHERE EXISTS (SELECT 1 FROM t2 WHERE t2.x > t1.a)
        UNION ALL SELECT a FROM t1 WHERE a >= 2
        ORDER BY 1 DESC LIMIT 3 OFFSET 1
    ) SELECT a FROM t1 WHERE EXISTS (SELECT 1 FROM shared WHERE shared.a = t1.a)
    ORDER BY a;
}
expect {
    2
    3
}

@setup schema
test exists-compound-derived-mixed-operators {
    SELECT q.a FROM (
        SELECT a FROM t1 WHERE EXISTS (SELECT 1 FROM t2 WHERE t2.x > t1.a)
        UNION ALL SELECT a FROM t1 WHERE a = 4
        EXCEPT SELECT a FROM t1 WHERE a = 2
        UNION ALL SELECT a FROM t1 WHERE a = 1
    ) q WHERE EXISTS (SELECT 1 FROM t2 WHERE t2.x > q.a)
    ORDER BY q.a;
}
expect {
    1
    1
}

@setup schema
test exists-compound-shared-null-and-storage-classes {
    WITH shared AS MATERIALIZED (
        SELECT NULL AS value FROM t1
        WHERE EXISTS (SELECT 1 FROM t2 WHERE t2.x > t1.a)
        UNION SELECT '2'
        UNION SELECT 2
        UNION SELECT 2.0
        UNION SELECT x'32'
    ) SELECT typeof(a.value), typeof(b.value), count(*)
    FROM shared a JOIN shared b ON a.value IS b.value
    WHERE EXISTS (SELECT 1 FROM t2 WHERE t2.x > a.value OR a.value IS NULL)
    GROUP BY typeof(a.value), typeof(b.value)
    ORDER BY 1, 2;
}
expect {
    null|null|1
    real|real|1
    text|text|1
}

@setup schema
test exists-compound-empty-aggregate-input {
    WITH shared AS MATERIALIZED (
        SELECT count(*) AS n FROM t1
        WHERE EXISTS (SELECT 1 FROM t2 WHERE t2.x > t1.a AND t2.x > 99)
        UNION ALL SELECT count(*) FROM t1 WHERE a > 99
    ) SELECT a.n, b.n FROM shared a JOIN shared b ON a.n = b.n
    WHERE EXISTS (SELECT 1 FROM t2 WHERE t2.x > a.n)
    ORDER BY a.n, b.n;
}
expect {
    0|0
    0|0
    0|0
    0|0
}

@setup schema
test exists-compound-limit-zero-skips-failing-input {
    WITH shared AS MATERIALIZED (
        SELECT abs(-9223372036854775808) AS a FROM t1
        WHERE EXISTS (SELECT 1 FROM t2 WHERE t2.x > t1.a)
        UNION ALL SELECT a FROM t1
        LIMIT 0
    ) SELECT a FROM t1 WHERE NOT EXISTS (SELECT 1 FROM shared WHERE shared.a = t1.a)
    ORDER BY a;
}
expect {
    1
    2
    3
    4
}

@setup schema
test exists-values-shared-preserves-duplicate-and-null-rows {
    WITH shared(value) AS MATERIALIZED (VALUES (1), (1), (2), (NULL))
    SELECT coalesce(a.value, -1), count(*) FROM shared a JOIN shared b ON a.value IS b.value
    WHERE EXISTS (SELECT 1 FROM t2 WHERE t2.x >= a.value OR a.value IS NULL)
    GROUP BY a.value ORDER BY a.value;
}
expect {
    -1|1
    1|4
    2|1
}

@setup schema
test exists-values-derived-preserves-storage-classes {
    SELECT column1, typeof(column1) FROM (VALUES (1), ('1'), (NULL), (x'31')) v
    WHERE EXISTS (SELECT 1 FROM t2 WHERE t2.x = v.column1)
    ORDER BY column1;
}
expect {
    1|integer
    1|text
}

@setup schema
test exists-values-right-input {
    SELECT a FROM t1
    WHERE EXISTS (SELECT 1 FROM (VALUES (1), (2), (2), (NULL)) v WHERE v.column1 = t1.a)
    ORDER BY a;
}
expect {
    1
    2
}

@setup schema
test not-exists-values-right-input {
    SELECT a FROM t1
    WHERE NOT EXISTS (SELECT 1 FROM (VALUES (1), (2), (2), (NULL)) v WHERE v.column1 = t1.a)
    ORDER BY a;
}
expect {
    3
    4
}

@setup schema
test exists-values-compound-shared-input {
    WITH shared(a) AS MATERIALIZED (
        SELECT a FROM t1 WHERE EXISTS (SELECT 1 FROM t2 WHERE t2.x > t1.a)
        UNION ALL VALUES (2), (NULL)
    ) SELECT a.a, count(*) FROM shared a JOIN shared b ON a.a IS b.a
    WHERE EXISTS (SELECT 1 FROM t2 WHERE t2.x > a.a)
    GROUP BY a.a ORDER BY a.a;
}
expect {
    1|1
    2|4
}

@setup schema
test exists-values-first-compound-input {
    WITH shared(a) AS MATERIALIZED (
        VALUES (2), (2), (NULL)
        UNION ALL SELECT a FROM t1 WHERE EXISTS (SELECT 1 FROM t2 WHERE t2.x > t1.a)
        ORDER BY 1 LIMIT 3 OFFSET 1
    ) SELECT a FROM shared WHERE EXISTS (SELECT 1 FROM t2 WHERE t2.x > shared.a)
    ORDER BY a;
}
expect {
    1
    2
    2
}

@setup schema
test exists-values-no-matching-right-input {
    SELECT a FROM t1 WHERE EXISTS (
        SELECT 1 FROM (VALUES (NULL), (99)) v WHERE v.column1 = t1.a
    ) ORDER BY a;
}
expect {
}
