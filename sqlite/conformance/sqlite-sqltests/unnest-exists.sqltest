}

@setup schema_logical_duplicates
test distinct-correlated-filter-preserves-value-type-keys {
    CREATE TABLE values_to_match(v);
    INSERT INTO values_to_match VALUES(1), (1.0), ('1'), (x'31'), (NULL), (NULL);
    SELECT count(*) FROM (
        SELECT DISTINCT v, typeof(v) FROM values_to_match o
        WHERE EXISTS (SELECT 1 FROM inner_rows i WHERE i.k IS NOT o.v)
    );
}
expect {
    5
}

@setup schema_logical_duplicates
test distinct-correlated-filter-preserves-column-collation {
    CREATE TABLE values_to_match(v TEXT COLLATE NOCASE);
    INSERT INTO values_to_match VALUES('a'), ('A'), ('b'), (NULL), (NULL);
    SELECT count(*) FROM (
        SELECT DISTINCT v FROM values_to_match o
        WHERE EXISTS (SELECT 1 FROM inner_rows i WHERE i.k IS NOT o.v)
    );
    SELECT count(*) FROM (
        SELECT DISTINCT v COLLATE BINARY FROM values_to_match o
        WHERE EXISTS (SELECT 1 FROM inner_rows i WHERE i.k IS NOT o.v)
    );
}
expect {
    3
    4
}

