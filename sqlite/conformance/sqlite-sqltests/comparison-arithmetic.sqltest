# A comparison is 1, 0 or NULL in SQLite, so it can take part in arithmetic.

@database :memory:

test comparison-plus-integer {
    SELECT (1 = 1) + 1, (1 = 2) + 1;
}
expect {
    2|1
}

test comparison-negated {
    SELECT -(2 > 1), -(2 < 1);
}
expect {
    -1|0
}

test comparison-times-integer {
    SELECT (3 = 4) * 5, (3 = 3) * 5;
}
expect {
    0|5
}

test comparison-bitwise {
    SELECT (1 = 1) & 3, ~(1 = 1), (1 = 1) << 2;
}
expect {
    1|-2|4
}

test in-and-between-in-arithmetic {
    SELECT (1 IN (1, 2)) + 1, (1 BETWEEN 0 AND 2) - 1;
}
expect {
    2|0
}

test sum-of-comparisons-counts-the-rows {
    CREATE TABLE t (a INTEGER, b INTEGER);
    INSERT INTO t VALUES (1, 1), (1, 2), (2, 2);
    SELECT sum(a = b) FROM t;
}
expect {
    2
}

test comparison-column-plus-integer {
    CREATE TABLE t (a INTEGER, b INTEGER);
    INSERT INTO t VALUES (1, 1);
    SELECT (a = b) + 1 FROM t;
}
expect {
    2
}
