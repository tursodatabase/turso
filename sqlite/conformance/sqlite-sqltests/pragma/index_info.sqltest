@database :memory:

@cross-check-integrity
test pragma-index-info-single-column {
    CREATE TABLE t1(a, b, c);
    CREATE INDEX idx1 ON t1(b);
    PRAGMA index_info('idx1');
}
expect {
    0|1|b
}

@cross-check-integrity
test pragma-index-info-equals-syntax {
    CREATE TABLE t1(a, b, c);
    CREATE INDEX idx1 ON t1(b);
    PRAGMA index_info=idx1;
}
expect {
    0|1|b
}

@cross-check-integrity
test pragma-index-info-multi-column {
    CREATE TABLE t1(a, b, c);
    CREATE INDEX idx1 ON t1(b, c);
    PRAGMA index_info('idx1');
}
expect {
    0|1|b
    1|2|c
}

@cross-check-integrity
test pragma-index-info-unique-index {
    CREATE TABLE t1(a, b, c);
    CREATE UNIQUE INDEX idx1 ON t1(a, c);
    PRAGMA index_info('idx1');
}
expect {
    0|0|a
    1|2|c
}

@cross-check-integrity
test pragma-index-info-autoindex {
    CREATE TABLE t1(a PRIMARY KEY, b, c);
    PRAGMA index_info('sqlite_autoindex_t1_1');
}
expect {
    0|0|a
}

test pragma-index-info-nonexistent {
    PRAGMA index_info('nonexistent');
}
expect {
}

@cross-check-integrity
test pragma-index-info-function-syntax {
    CREATE TABLE t1(a, b, c);
    CREATE INDEX idx1 ON t1(a);
    SELECT * FROM pragma_index_info('idx1');
}
expect {
    0|0|a
}

@skip-if mvcc "WITHOUT ROWID tables are not supported in MVCC mode"
@cross-check-integrity
test pragma-index-info-without-rowid-primary-key {
    CREATE TABLE w(x, PRIMARY KEY(x)) WITHOUT ROWID;
    CREATE TABLE w2(a, b, c COLLATE NOCASE, d, PRIMARY KEY(c DESC, a)) WITHOUT ROWID;
    SELECT 'info', * FROM pragma_index_info('sqlite_autoindex_w_1');
    PRAGMA index_info(sqlite_autoindex_w2_1);
    PRAGMA index_info(w2);
}
expect {
    info|0|0|x
    0|2|c
    1|0|a
    0|2|c
    1|0|a
}

@skip-if mvcc "WITHOUT ROWID tables are not supported in MVCC mode"
@cross-check-integrity
test pragma-index-info-without-rowid-primary-key-in-temp {
    CREATE TEMP TABLE tw(x, y, PRIMARY KEY(y)) WITHOUT ROWID;
    SELECT 'info', * FROM pragma_index_info('sqlite_autoindex_tw_1');
    SELECT 'xinfo', * FROM pragma_index_xinfo('tw');
}
expect {
    info|0|1|y
    xinfo|0|1|y|0|BINARY|1
    xinfo|1|0|x|0|BINARY|0
}

@skip-if mvcc "WITHOUT ROWID tables are not supported in MVCC mode"
@cross-check-integrity
test pragma-index-info-index-name-wins-over-without-rowid-table-name {
    CREATE TABLE r(x, y);
    CREATE INDEX foo ON r(y);
    CREATE TEMP TABLE foo(z PRIMARY KEY) WITHOUT ROWID;
    SELECT 'index', * FROM pragma_index_info('foo');
    SELECT 'pk', * FROM pragma_index_info('sqlite_autoindex_foo_1');
    PRAGMA temp.index_info(foo);
}
expect {
    index|0|1|y
    pk|0|0|z
    0|0|z
}

@cross-check-integrity
test pragma-index-info-expression-column {
    CREATE TABLE t(a, b, c, d);
    CREATE INDEX i_expr ON t(substr(b,1,1), a);
    SELECT seqno, cid, quote(name) FROM pragma_index_info('i_expr');
    ALTER TABLE t DROP COLUMN d;
    ALTER TABLE t RENAME COLUMN a TO z;
    PRAGMA index_info('i_expr');
}
expect {
    0|-2|NULL
    1|0|'a'
    0|-2|
    1|0|z
}

@cross-check-integrity
test pragma-index-info-virtual-generated-column {
    CREATE TABLE t(a, b, g AS (a*2));
    CREATE INDEX i ON t(g);
    PRAGMA index_info('i');
}
expect {
    0|2|g
}
