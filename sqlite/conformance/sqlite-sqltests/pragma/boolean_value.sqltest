    PRAGMA query_only = 0x00;
    PRAGMA query_only;
    PRAGMA query_only = 0x1;
    PRAGMA query_only;
    PRAGMA query_only = 0x10;
    PRAGMA query_only;
    PRAGMA query_only = 0xff;
    PRAGMA query_only;
    PRAGMA query_only = 0xFF;
    PRAGMA query_only;
    PRAGMA query_only = 0x100;
    PRAGMA query_only;
    PRAGMA query_only = 0x1FF;
    PRAGMA query_only;
    PRAGMA query_only = 0X10;
    PRAGMA query_only;
    PRAGMA query_only = 0x80000000;
    PRAGMA query_only;
    PRAGMA query_only = 0xFFFFFFFF;
    PRAGMA query_only;
    PRAGMA query_only = 0x123456789;
    PRAGMA query_only;
}
