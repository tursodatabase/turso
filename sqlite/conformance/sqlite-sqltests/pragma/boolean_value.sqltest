@database :memory:

test pragma-boolean-words {
    PRAGMA query_only = on;
    PRAGMA query_only;
    PRAGMA query_only = ON;
    PRAGMA query_only;
    PRAGMA query_only = On;
    PRAGMA query_only;
    PRAGMA query_only = off;
    PRAGMA query_only;
    PRAGMA query_only = OFF;
    PRAGMA query_only;
    PRAGMA query_only = Off;
    PRAGMA query_only;
    PRAGMA query_only = yes;
    PRAGMA query_only;
    PRAGMA query_only = YES;
    PRAGMA query_only;
    PRAGMA query_only = no;
    PRAGMA query_only;
    PRAGMA query_only = NO;
    PRAGMA query_only;
    PRAGMA query_only = true;
    PRAGMA query_only;
    PRAGMA query_only = TRUE;
    PRAGMA query_only;
    PRAGMA query_only = TrUe;
    PRAGMA query_only;
    PRAGMA query_only = false;
    PRAGMA query_only;
    PRAGMA query_only = FALSE;
    PRAGMA query_only;
}
expect {
    1
    1
    1
    0
    0
    0
    1
    1
    0
    0
    1
    1
    1
    0
    0
}

test pragma-boolean-other-words-are-false {
    PRAGMA query_only = bogus;
    PRAGMA query_only;
    PRAGMA query_only = delete;
    PRAGMA query_only;
    PRAGMA query_only = default;
    PRAGMA query_only;
    PRAGMA query_only = extra;
    PRAGMA query_only;
    PRAGMA query_only = full;
    PRAGMA query_only;
}
expect {
    0
    0
    0
    0
    0
}

test pragma-boolean-quoted-values {
    PRAGMA query_only = 'on';
    PRAGMA query_only;
    PRAGMA query_only = 'off';
    PRAGMA query_only;
    PRAGMA query_only = 'true';
    PRAGMA query_only;
    PRAGMA query_only = 'yes';
    PRAGMA query_only;
    PRAGMA query_only = '1';
    PRAGMA query_only;
    PRAGMA query_only = '0';
    PRAGMA query_only;
    PRAGMA query_only = '';
    PRAGMA query_only;
    PRAGMA query_only = "on";
    PRAGMA query_only;
}
expect {
    1
    0
    1
    1
    1
    0
    0
    1
}

test pragma-boolean-plain-numbers {
    PRAGMA query_only = 0;
    PRAGMA query_only;
    PRAGMA query_only = 1;
    PRAGMA query_only;
    PRAGMA query_only = 2;
    PRAGMA query_only;
    PRAGMA query_only = 9;
    PRAGMA query_only;
    PRAGMA query_only = 00;
    PRAGMA query_only;
    PRAGMA query_only = 000;
    PRAGMA query_only;
    PRAGMA query_only = 0001;
    PRAGMA query_only;
}
expect {
    0
    1
    1
    1
    0
    0
    1
}

test pragma-boolean-numbers-with-a-fraction-or-exponent {
    PRAGMA query_only = 0.0;
    PRAGMA query_only;
    PRAGMA query_only = 0.5;
    PRAGMA query_only;
    PRAGMA query_only = 0.9999;
    PRAGMA query_only;
    PRAGMA query_only = 1.0;
    PRAGMA query_only;
    PRAGMA query_only = 1.5;
    PRAGMA query_only;
    PRAGMA query_only = 2.5;
    PRAGMA query_only;
    PRAGMA query_only = 1e0;
    PRAGMA query_only;
    PRAGMA query_only = 1e3;
    PRAGMA query_only;
}
expect {
    0
    0
    0
    1
    1
    1
    1
    1
}

test pragma-boolean-numbers-keep-only-the-lowest-byte {
    PRAGMA query_only = 255;
    PRAGMA query_only;
    PRAGMA query_only = 256;
    PRAGMA query_only;
    PRAGMA query_only = 257;
    PRAGMA query_only;
    PRAGMA query_only = 511;
    PRAGMA query_only;
    PRAGMA query_only = 512;
    PRAGMA query_only;
    PRAGMA query_only = 1024;
    PRAGMA query_only;
    PRAGMA query_only = 0777;
    PRAGMA query_only;
}
expect {
    1
    0
    1
    1
    0
    0
    1
}

test pragma-boolean-numbers-that-do-not-fit-in-32-bits {
    PRAGMA query_only = 2147483647;
    PRAGMA query_only;
    PRAGMA query_only = 2147483648;
    PRAGMA query_only;
    PRAGMA query_only = 4294967296;
    PRAGMA query_only;
    PRAGMA query_only = 99999999999;
    PRAGMA query_only;
}
expect {
    1
    0
    0
    0
}

