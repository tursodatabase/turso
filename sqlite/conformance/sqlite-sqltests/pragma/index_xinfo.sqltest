@database :memory:

@cross-check-integrity
test pragma-index-xinfo-single-column {
    CREATE TABLE t1(a, b, c);
    CREATE INDEX idx1 ON t1(a);
    PRAGMA index_xinfo('idx1');
}
expect {
    0|0|a|0|BINARY|1
    1|-1||0|BINARY|0
}

@cross-check-integrity
test pragma-index-xinfo-equals-syntax {
    CREATE TABLE t1(a, b, c);
    CREATE INDEX idx1 ON t1(a);
    PRAGMA index_xinfo=idx1;
}
expect {
    0|0|a|0|BINARY|1
    1|-1||0|BINARY|0
}

@cross-check-integrity
test pragma-index-xinfo-multi-column {
    CREATE TABLE t1(a, b, c);
    CREATE UNIQUE INDEX idx1 ON t1(b, c);
    PRAGMA index_xinfo('idx1');
}
expect {
    0|1|b|0|BINARY|1
    1|2|c|0|BINARY|1
    2|-1||0|BINARY|0
}

@cross-check-integrity
test pragma-index-xinfo-desc-column {
    CREATE TABLE t1(a, b, c);
    CREATE INDEX idx1 ON t1(a DESC, b);
    PRAGMA index_xinfo('idx1');
}
expect {
    0|0|a|1|BINARY|1
    1|1|b|0|BINARY|1
    2|-1||0|BINARY|0
}

@cross-check-integrity
test pragma-index-xinfo-collation {
    CREATE TABLE t1(a, b COLLATE NOCASE, c);
    CREATE INDEX idx1 ON t1(b);
    PRAGMA index_xinfo('idx1');
}
expect {
    0|1|b|0|NOCASE|1
    1|-1||0|BINARY|0
}

@cross-check-integrity
test pragma-index-xinfo-autoindex {
    CREATE TABLE t1(a PRIMARY KEY, b, c);
    PRAGMA index_xinfo('sqlite_autoindex_t1_1');
}
expect {
    0|0|a|0|BINARY|1
    1|-1||0|BINARY|0
}

test pragma-index-xinfo-nonexistent {
    PRAGMA index_xinfo('nonexistent');
}
expect {
}

@cross-check-integrity
test pragma-index-xinfo-function-syntax {
    CREATE TABLE t1(a, b, c);
    CREATE INDEX idx1 ON t1(a);
    SELECT * FROM pragma_index_xinfo('idx1');
}
expect {
    0|0|a|0|BINARY|1
    1|-1||0|BINARY|0
}

@skip-if mvcc "WITHOUT ROWID tables are not supported in MVCC mode"
@cross-check-integrity
test pragma-index-xinfo-without-rowid-primary-key {
    CREATE TABLE w(x, PRIMARY KEY(x)) WITHOUT ROWID;
    CREATE TABLE w2(a, b, c COLLATE NOCASE, d, PRIMARY KEY(c DESC, a)) WITHOUT ROWID;
    SELECT 'xinfo', * FROM pragma_index_xinfo('sqlite_autoindex_w_1');
    PRAGMA index_xinfo(sqlite_autoindex_w2_1);
    PRAGMA index_xinfo(w2);
}
expect {
    xinfo|0|0|x|0|BINARY|1
    0|2|c|1|NOCASE|1
    1|0|a|0|BINARY|1
    2|1|b|0|BINARY|0
    3|3|d|0|BINARY|0
    0|2|c|1|NOCASE|1
    1|0|a|0|BINARY|1
    2|1|b|0|BINARY|0
    3|3|d|0|BINARY|0
}

@skip-if mvcc "WITHOUT ROWID tables are not supported in MVCC mode"
@cross-check-integrity
test pragma-index-xinfo-without-rowid-skips-virtual-columns {
    CREATE TABLE w(id INTEGER PRIMARY KEY, v TEXT, g AS (v || 'x')) WITHOUT ROWID;
    PRAGMA index_xinfo(w);
}
expect {
    0|0|id|0|BINARY|1
    1|1|v|0|BINARY|0
}

@cross-check-integrity
test pragma-index-xinfo-expression-column {
    CREATE TABLE t(a, b, c, d);
    CREATE INDEX i_expr ON t(substr(b,1,1), a);
    SELECT seqno, cid, quote(name), key FROM pragma_index_xinfo('i_expr');
    ALTER TABLE t DROP COLUMN d;
    SELECT seqno, cid, quote(name), key FROM pragma_index_xinfo('i_expr');
    ALTER TABLE t RENAME COLUMN a TO z;
    PRAGMA index_xinfo('i_expr');
}
expect {
    0|-2|NULL|1
    1|0|'a'|1
    2|-1|NULL|0
    0|-2|NULL|1
    1|0|'a'|1
    2|-1|NULL|0
    0|-2||0|BINARY|1
    1|0|z|0|BINARY|1
    2|-1||0|BINARY|0
}

@cross-check-integrity
test pragma-index-xinfo-virtual-generated-column {
    CREATE TABLE t(a, b, g AS (a*2));
    CREATE INDEX i ON t(g COLLATE NOCASE DESC, g*2);
    SELECT seqno, cid, quote(name), desc, coll, key FROM pragma_index_xinfo('i');
}
expect {
    0|2|'g'|1|NOCASE|1
    1|-2|NULL|0|BINARY|1
    2|-1|NULL|0|BINARY|0
}
