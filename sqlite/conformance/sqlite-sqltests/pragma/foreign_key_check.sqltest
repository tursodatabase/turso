@database :memory:

test pragma-foreign-key-check-rowid-parent {
    CREATE TABLE parent(id INTEGER PRIMARY KEY);
    CREATE TABLE child(a REFERENCES parent(id));
    INSERT INTO parent VALUES (1);
    INSERT INTO child VALUES (1), (2), (NULL), (3);
    PRAGMA foreign_key_check;
}
expect {
    child|2|parent|0
    child|4|parent|0
}

test pragma-foreign-key-check-unique-parent {
    CREATE TABLE parent(code UNIQUE);
    CREATE TABLE child(a REFERENCES parent(code));
    INSERT INTO parent VALUES ('x');
    INSERT INTO child VALUES ('x'), ('y'), (NULL);
    PRAGMA foreign_key_check(child);
}
expect {
    child|2|parent|0
}

test pragma-foreign-key-check-implicit-parent-key {
    CREATE TABLE parent(code TEXT PRIMARY KEY);
    CREATE TABLE child(a REFERENCES parent);
    INSERT INTO parent VALUES ('a');
    INSERT INTO child VALUES ('a'), ('b');
    PRAGMA foreign_key_check;
}
expect {
    child|2|parent|0
}

test pragma-foreign-key-check-composite-key-null-skips-pair {
    CREATE TABLE parent(a, b, UNIQUE(a, b));
    CREATE TABLE child(x, y, FOREIGN KEY(x, y) REFERENCES parent(a, b));
    INSERT INTO parent VALUES (1, 2);
    INSERT INTO child VALUES (1, 2), (1, 3), (NULL, 2), (1, NULL), (5, 6);
    PRAGMA foreign_key_check;
}
expect {
    child|2|parent|0
    child|5|parent|0
}

test pragma-foreign-key-check-two-foreign-keys-one-row {
    CREATE TABLE p1(id INTEGER PRIMARY KEY);
    CREATE TABLE p2(id INTEGER PRIMARY KEY);
    CREATE TABLE child(a REFERENCES p1, b REFERENCES p2);
    INSERT INTO child VALUES (1, 1), (2, NULL), (NULL, 3);
    PRAGMA foreign_key_check;
}
expect {
    child|1|p2|0
    child|1|p1|1
    child|2|p1|1
    child|3|p2|0
}

test pragma-foreign-key-check-rows-in-rowid-order {
    CREATE TABLE parent(id INTEGER PRIMARY KEY);
    CREATE TABLE child(a REFERENCES parent);
    INSERT INTO child(rowid, a) VALUES (10, 1), (5, 2), (7, 3);
    PRAGMA foreign_key_check;
}
expect {
    child|5|parent|0
    child|7|parent|0
    child|10|parent|0
}

test pragma-foreign-key-check-self-reference {
    CREATE TABLE emp(id INTEGER PRIMARY KEY, boss REFERENCES emp(id));
    INSERT INTO emp VALUES (1, 1), (2, 1), (3, 9);
    PRAGMA foreign_key_check;
}
expect {
    emp|3|emp|0
}

test pragma-foreign-key-check-text-matches-integer-parent {
    CREATE TABLE parent(id INTEGER PRIMARY KEY);
    CREATE TABLE child(a REFERENCES parent);
    INSERT INTO parent VALUES (1);
    INSERT INTO child VALUES ('1'), (1.0), ('abc'), (x'01'), (1.5);
    PRAGMA foreign_key_check;
}
expect {
    child|3|parent|0
    child|4|parent|0
    child|5|parent|0
}

test pragma-foreign-key-check-text-child-integer-unique-parent {
    CREATE TABLE parent(u INTEGER UNIQUE);
    CREATE TABLE child(a TEXT REFERENCES parent(u));
    INSERT INTO parent VALUES (1);
    INSERT INTO child VALUES ('1'), ('2');
    PRAGMA foreign_key_check;
}
expect {
    child|2|parent|0
}

test pragma-foreign-key-check-nocase-parent {
    CREATE TABLE parent(u TEXT COLLATE NOCASE UNIQUE);
    CREATE TABLE child(a REFERENCES parent(u));
    INSERT INTO parent VALUES ('a');
    INSERT INTO child VALUES ('A'), ('b');
    PRAGMA foreign_key_check;
}
expect {
    child|2|parent|0
}

test pragma-foreign-key-check-missing-parent-table {
    CREATE TABLE child(a REFERENCES ghost(id));
    INSERT INTO child VALUES (1), (NULL), (2);
    PRAGMA foreign_key_check;
}
expect {
    child|1|ghost|0
    child|3|ghost|0
}

test pragma-foreign-key-check-schema-qualified {
    CREATE TABLE parent(id INTEGER PRIMARY KEY);
    CREATE TABLE child(a REFERENCES parent);
    INSERT INTO child VALUES (4);
    PRAGMA main.foreign_key_check;
    PRAGMA main.foreign_key_check(child);
}
expect {
    child|1|parent|0
    child|1|parent|0
}

test pragma-foreign-key-check-table-without-foreign-keys {
    CREATE TABLE parent(id INTEGER PRIMARY KEY);
    CREATE TABLE child(a REFERENCES parent);
    CREATE TABLE t(a);
    INSERT INTO child VALUES (1);
    INSERT INTO t VALUES (1);
    PRAGMA foreign_key_check(t);
    PRAGMA foreign_key_check(child);
}
expect {
    child|1|parent|0
}

test pragma-foreign-key-check-view {
    CREATE TABLE parent(id INTEGER PRIMARY KEY);
    CREATE TABLE child(a REFERENCES parent);
    CREATE VIEW v AS SELECT * FROM child;
    INSERT INTO child VALUES (1);
    PRAGMA foreign_key_check(v);
    PRAGMA foreign_key_check(child);
}
expect {
    child|1|parent|0
}

test pragma-foreign-key-check-unknown-table {
    PRAGMA foreign_key_check(nope);
}
expect error {
    no such table: nope
}

test pragma-foreign-key-check-parent-key-not-unique {
    CREATE TABLE parent(x);
    CREATE TABLE child(a REFERENCES parent(x));
    INSERT INTO child VALUES (1);
    PRAGMA foreign_key_check(child);
}
expect error {
    foreign key mismatch - "child" referencing "parent"
}

test pragma-foreign-key-check-partial-unique-index-parent {
    CREATE TABLE parent(x);
    CREATE UNIQUE INDEX parent_x ON parent(x) WHERE x > 0;
    CREATE TABLE child(a REFERENCES parent(x));
    PRAGMA foreign_key_check(child);
}
expect error {
    foreign key mismatch - "child" referencing "parent"
}

test pragma-foreign-key-check-parent-without-primary-key {
    CREATE TABLE parent(x);
    CREATE TABLE child(a REFERENCES parent);
    PRAGMA foreign_key_check(child);
}
expect error {
    foreign key mismatch - "child" referencing "parent"
}

test pragma-foreign-key-check-mismatch-in-other-table-fails-all {
    CREATE TABLE parent(x);
    CREATE TABLE bad(a REFERENCES parent(x));
    CREATE TABLE good_parent(id INTEGER PRIMARY KEY);
    CREATE TABLE good(a REFERENCES good_parent);
    INSERT INTO good VALUES (9);
    PRAGMA foreign_key_check;
}
expect error {
    foreign key mismatch - "bad" referencing "parent"
}

test pragma-foreign-key-check-mismatch-in-other-table-ignored-by-name {
    CREATE TABLE parent(x);
    CREATE TABLE bad(a REFERENCES parent(x));
    CREATE TABLE good_parent(id INTEGER PRIMARY KEY);
    CREATE TABLE good(a REFERENCES good_parent);
    INSERT INTO good VALUES (9);
    PRAGMA foreign_key_check(good);
}
expect {
    good|1|good_parent|0
}

test pragma-foreign-key-check-view-as-parent {
    CREATE TABLE t(id INTEGER PRIMARY KEY);
    CREATE VIEW pv AS SELECT * FROM t;
    CREATE TABLE child(a REFERENCES pv(id));
    INSERT INTO child VALUES (1);
    PRAGMA foreign_key_check;
}
expect error {
    foreign key mismatch - "child" referencing "pv"
}

test pragma-foreign-key-check-number-argument {
    CREATE TABLE parent(id INTEGER PRIMARY KEY);
    CREATE TABLE child(a REFERENCES parent);
    INSERT INTO child VALUES (1);
    PRAGMA foreign_key_check(1);
}
expect error {
    no such table: 1
}
