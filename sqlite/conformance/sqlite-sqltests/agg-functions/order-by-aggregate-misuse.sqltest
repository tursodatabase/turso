@database :memory:

# Aggregate functions in ORDER BY should be rejected when the query
# is not already an aggregate query (no GROUP BY and no aggregates
# in SELECT/HAVING).  SQLite returns "misuse of aggregate: min()".

test order-by-min-misuse {
    CREATE TABLE test1(f1 int, f2 int);
    INSERT INTO test1 VALUES(11,22);
    INSERT INTO test1 VALUES(33,44);
    SELECT f1 FROM test1 ORDER BY min(f1);
}
expect error {
    misuse of aggregate: min()
}

test order-by-max-misuse {
    CREATE TABLE test2(f1 int, f2 int);
    INSERT INTO test2 VALUES(11,22);
    INSERT INTO test2 VALUES(33,44);
    SELECT f1 FROM test2 ORDER BY max(f1);
}
expect error {
    misuse of aggregate: max()
}

test order-by-sum-misuse {
    CREATE TABLE test3(f1 int, f2 int);
    INSERT INTO test3 VALUES(11,22);
    INSERT INTO test3 VALUES(33,44);
    SELECT f1 FROM test3 ORDER BY sum(f1);
}
expect error {
    misuse of aggregate: sum()
}

test order-by-count-misuse {
    CREATE TABLE test4(f1 int, f2 int);
    INSERT INTO test4 VALUES(11,22);
    INSERT INTO test4 VALUES(33,44);
    SELECT f1 FROM test4 ORDER BY count(f1);
}
expect error {
    misuse of aggregate: count()
}

# Two-arg min() is the scalar function, not an aggregate — should succeed.
test order-by-scalar-min-ok {
    CREATE TABLE test5(f1 int, f2 int);
    INSERT INTO test5 VALUES(11,22);
    INSERT INTO test5 VALUES(33,44);
    SELECT f1 FROM test5 ORDER BY min(f1, f2);
}
expect {
    11
    33
}

# Aggregate in ORDER BY is fine when the query has GROUP BY.
test order-by-agg-with-group-by-ok {
    CREATE TABLE test6(f1 int, f2 int);
    INSERT INTO test6 VALUES(11,22);
    INSERT INTO test6 VALUES(11,44);
    INSERT INTO test6 VALUES(33,55);
    SELECT f1, count(*) FROM test6 GROUP BY f1 ORDER BY min(f2);
}
expect {
    11|2
    33|1
}

# Aggregate in ORDER BY is fine when there are already aggregates in SELECT.
test order-by-agg-with-select-agg-ok {
    CREATE TABLE test7(f1 int, f2 int);
    INSERT INTO test7 VALUES(11,22);
    INSERT INTO test7 VALUES(33,44);
    SELECT count(*) FROM test7 ORDER BY min(f1);
}
expect {
    2
}

test scalar-aggregate-order-error-names-function {
    SELECT abs(-1 ORDER BY 1);
}
expect error {
    ORDER BY may not be used with non-aggregate abs()
}

test ordered-window-error-names-function {
    SELECT group_concat(1 ORDER BY 1) OVER ();
}
expect error {
    ORDER BY may not be used with non-aggregate group_concat()
}

test scalar-order-by-where {
    CREATE TABLE t(a,b);
    INSERT INTO t VALUES(-1,2);
    SELECT 1 FROM t WHERE abs(a ORDER BY b)=1;
}
expect error {
    ORDER BY may not be used with non-aggregate abs()
}

test scalar-order-by-group-by {
    CREATE TABLE t(a,b);
    INSERT INTO t VALUES(-1,2);
    SELECT count(*) FROM t GROUP BY abs(a ORDER BY b);
}
expect error {
    ORDER BY may not be used with non-aggregate abs()
}

test scalar-order-by-update-set {
    CREATE TABLE t(a,b);
    INSERT INTO t VALUES(-1,2);
    UPDATE t SET a=abs(a ORDER BY b);
}
expect error {
    ORDER BY may not be used with non-aggregate abs()
}

test scalar-order-by-update-where {
    CREATE TABLE t(a,b);
    INSERT INTO t VALUES(-1,2);
    UPDATE t SET a=1 WHERE abs(a ORDER BY b)=1;
}
expect error {
    ORDER BY may not be used with non-aggregate abs()
}

test scalar-order-by-delete {
    CREATE TABLE t(a,b);
    INSERT INTO t VALUES(-1,2);
    DELETE FROM t WHERE abs(a ORDER BY b)=1;
}
expect error {
    ORDER BY may not be used with non-aggregate abs()
}

test scalar-order-by-insert {
    CREATE TABLE t(a,b);
    INSERT INTO t VALUES(-1,2);
    INSERT INTO t VALUES(abs(-1 ORDER BY 1),2);
}
expect error {
    ORDER BY may not be used with non-aggregate abs()
}

test scalar-order-by-returning {
    CREATE TABLE t(a,b);
    INSERT INTO t VALUES(-1,2);
    DELETE FROM t RETURNING abs(a ORDER BY b);
}
expect error {
    ORDER BY may not be used with non-aggregate abs()
}

test scalar-order-by-check {
    CREATE TABLE t(a,b);
    INSERT INTO t VALUES(-1,2);
    CREATE TABLE checked(a,b,CHECK(abs(a ORDER BY b)=1));
}
expect error {
    ORDER BY may not be used with non-aggregate abs()
}

test scalar-order-by-index {
    CREATE TABLE t(a,b);
    INSERT INTO t VALUES(-1,2);
    CREATE INDEX bad ON t(abs(a ORDER BY b));
}
expect error {
    ORDER BY may not be used with non-aggregate abs()
}

test correlated-nested-aggregate-order-misuse {
    CREATE TABLE nested_order_t(g,a);
    INSERT INTO nested_order_t VALUES(1,3),(1,1),(2,2);
    CREATE TABLE nested_order_u(g,x);
    INSERT INTO nested_order_u VALUES(1,'p'),(5,'q');
    SELECT g, (SELECT group_concat(x ORDER BY sum(t.a)) FROM nested_order_u)
    FROM nested_order_t AS t;
}
expect error {
    misuse of aggregate function sum()
}

test correlated-nested-aggregate-argument-misuse {
    CREATE TABLE nested_arg_t(g,a);
    INSERT INTO nested_arg_t VALUES(1,3),(1,1),(2,2);
    CREATE TABLE nested_arg_u(g,x);
    INSERT INTO nested_arg_u VALUES(1,'p'),(5,'q');
    SELECT g, (SELECT group_concat(x, sum(t.a)) FROM nested_arg_u)
    FROM nested_arg_t AS t;
}
expect error {
    misuse of aggregate function sum()
}

test correlated-nested-aggregate-filter-misuse {
    CREATE TABLE nested_filter_t(g,a);
    INSERT INTO nested_filter_t VALUES(1,3),(1,1),(2,2);
    CREATE TABLE nested_filter_u(g,x);
    INSERT INTO nested_filter_u VALUES(1,'p'),(5,'q');
    SELECT g, (SELECT group_concat(x) FILTER (WHERE sum(t.a)>0) FROM nested_filter_u)
    FROM nested_filter_t AS t;
}
expect error {
    misuse of aggregate function sum()
}

test aggregate-input-subquery-allows-separate-aggregate {
    CREATE TABLE separate_agg_t(a);
    INSERT INTO separate_agg_t VALUES(1),(2);
    CREATE TABLE separate_agg_u(x);
    INSERT INTO separate_agg_u VALUES(3),(4);
    SELECT sum(a + (SELECT sum(x) FROM separate_agg_u)) FROM separate_agg_t;
}
expect {
    17
}
