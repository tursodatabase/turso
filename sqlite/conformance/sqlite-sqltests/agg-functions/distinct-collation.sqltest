@database :memory:

test distinct-aggregate-expression-collation {
    CREATE TABLE collated_values(g INTEGER, v TEXT COLLATE nocase);
    INSERT INTO collated_values VALUES (1,'x'),(1,'X'),(1,'z'),(1,'Z');
    SELECT count(DISTINCT v), count(DISTINCT (v || '')), count(DISTINCT upper(v)),
           count(DISTINCT +v), count(DISTINCT CAST(v AS TEXT)),
           count(DISTINCT ((v || '') COLLATE nocase)),
           count(DISTINCT ((v COLLATE nocase) || '')) FROM collated_values;
    SELECT g, count(DISTINCT (v || '')) FROM collated_values GROUP BY g;
    SELECT count(DISTINCT (v || '') ORDER BY v) FROM collated_values;
}
expect {
    2|4|2|2|2|2|2
    1|4
    4
}
