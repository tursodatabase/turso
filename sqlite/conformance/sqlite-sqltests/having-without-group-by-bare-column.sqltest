@database :memory:

# HAVING without GROUP BY makes the whole table one group. A column used
# outside an aggregate, in HAVING or in the result columns, takes its value
# from the first row of the group, as in a query without HAVING. With min() or
# max(), it comes from another row: see aggregate-bare-column-min-max.sqltest.

setup five-rows {
    CREATE TABLE t(a, b);
    INSERT INTO t VALUES (1, 10), (2, 20), (3, 30), (4, 40), (5, 50);
}

@setup five-rows
test having-bare-column {
    SELECT count(*) FROM t HAVING a != 400;
}
expect {
    5
}

@setup five-rows
test having-bare-column-reads-first-row {
    SELECT count(*) FROM t HAVING a = 1;
}
expect {
    5
}

@setup five-rows
test having-bare-column-not-last-row {
    SELECT count(*) FROM t HAVING a = 5;
}
expect {
}

@setup five-rows
test having-bare-column-with-aggregate {
    SELECT count(*) FROM t HAVING a + count(*) = 6;
}
expect {
    5
}

@setup five-rows
test having-bare-rowid {
    SELECT count(*) FROM t HAVING rowid = 1;
}
expect {
    5
}

@setup five-rows
test having-result-column-bare-column {
    SELECT count(*), a IS NULL, b FROM t HAVING sum(a) > 0;
}
expect {
    5|0|10
}

@setup five-rows
test having-bare-column-in-aggregate-result-column {
    SELECT sum(a) + b FROM t HAVING b = 10;
}
expect {
    25
}

@setup five-rows
test having-bare-column-with-where {
    SELECT count(*), b FROM t WHERE a > 2 HAVING a > 2;
}
expect {
    3|30
}

@setup five-rows
test having-bare-column-no-rows {
    SELECT count(*), b FROM t WHERE a > 100 HAVING a IS NULL;
}
expect {
    0|
}

@setup five-rows
test having-bare-column-of-second-join-table {
    SELECT count(*) FROM t t1 JOIN t t2 ON t1.a = t2.a HAVING t2.b = 10;
}
expect {
    5
}

@setup five-rows
test aggregate-result-column-bare-column-reads-first-row {
    SELECT sum(a) + a FROM t;
}
expect {
    16
}

# A correlated subquery outside aggregates runs once, after the loop, and reads
# the bare column of the same row.
@setup five-rows
test aggregate-result-column-subquery-bare-column-reads-first-row {
    SELECT count(*) + (SELECT t.b), sum(a) + (SELECT t.b) FROM t;
}
expect {
    15|25
}

@setup five-rows
test having-subquery-bare-column-reads-first-row {
    SELECT count(*) FROM t HAVING (SELECT t.b) = 10;
}
expect {
    5
}

@setup five-rows
test having-subquery-bare-column-not-last-row {
    SELECT count(*) FROM t HAVING (SELECT t.b) = 50;
}
expect {
}

@setup five-rows
test having-exists-subquery-bare-column {
    SELECT count(*) FROM t HAVING EXISTS (SELECT 1 FROM t AS t2 WHERE t2.a = t.a + 4);
}
expect {
    5
}

@setup five-rows
test having-subquery-bare-column-no-rows {
    SELECT count(*) FROM t WHERE a > 10 HAVING (SELECT coalesce(t.b, 7)) = 7;
}
expect {
    0
}

# The bare column must not depend on the plan: a covering index seek and a
# rowid lookup give the same value as a table scan.
setup indexed {
    CREATE TABLE t(a INTEGER PRIMARY KEY, b);
    INSERT INTO t VALUES (0, 7);
    CREATE INDEX ti ON t(a, b);
}

@setup indexed
test having-bare-column-index-seek {
    SELECT count(*), b IS NULL, b FROM t WHERE a = 0 HAVING count(*) >= 1;
}
expect {
    1|0|7
}

@setup indexed
test having-bare-column-rowid-lookup {
    SELECT count(*) FROM t WHERE rowid = 0 HAVING b = 7;
}
expect {
    1
}

# An expression index gives the whole expression `a + 1`, so it is read on the
# first row like a bare column.
setup expression-index {
    CREATE TABLE t(a, b);
    INSERT INTO t VALUES (1, 10), (2, 20), (3, 30), (4, 40), (5, 50);
    CREATE INDEX te ON t(a + 1);
}

@setup expression-index
test having-bare-expression-from-expression-index {
    SELECT count(*) FROM t WHERE a + 1 > 2 HAVING a + 1 = 3;
}
expect {
    4
}

@setup expression-index
test aggregate-result-column-bare-expression-from-expression-index {
    SELECT sum(b) + (a + 1) FROM t WHERE a + 1 > 2;
}
expect {
    143
}

# The cursor of `a` is never opened when `b` is empty. HAVING must read NULL
# for a.x instead of reading the unopened cursor.
setup empty-join {
    CREATE TABLE a(x INT);
    CREATE TABLE b(y INT);
}

@setup empty-join
test having-bare-column-empty-join {
    SELECT count(*) FROM a, b WHERE x = 1 HAVING count(*) >= a.x;
}
expect {
}

@setup empty-join
test having-bare-column-empty-join-is-null {
    SELECT count(*) FROM a, b WHERE x = 1 HAVING a.x IS NULL;
}
expect {
    0
}

@setup empty-join
test having-subquery-bare-column-empty-join {
    SELECT count(*) FROM a, b WHERE x = 1 HAVING (SELECT a.x) IS NULL;
}
expect {
    0
}

setup empty-join-left-row {
    CREATE TABLE a(x INT);
    CREATE TABLE b(y INT);
    INSERT INTO a VALUES (1);
}

@setup empty-join-left-row
test having-bare-column-empty-join-left-row {
    SELECT count(*) FROM a, b WHERE x = 1 HAVING count(*) >= a.x;
}
expect {
}

# A correlated subquery reads its bare column again for each outer row.
setup outer-and-inner {
    CREATE TABLE inner_t(a);
    INSERT INTO inner_t VALUES (1), (2), (3);
    CREATE TABLE outer_t(k);
    INSERT INTO outer_t VALUES (1), (9), (2);
}

@setup outer-and-inner
test correlated-having-bare-column {
    SELECT k, (SELECT count(*) FROM inner_t WHERE a = k HAVING a IS NULL) FROM outer_t ORDER BY rowid;
}
expect {
    1|
    9|0
    2|
}

@setup outer-and-inner
test correlated-having-subquery-bare-column {
    SELECT k, (SELECT count(*) FROM inner_t HAVING (SELECT a + k) = 2) FROM outer_t ORDER BY rowid;
}
expect {
    1|3
    9|
    2|
}

# SQLite makes a query an aggregate query only for an aggregate in its result
# columns, so an aggregate that appears only in HAVING is an error.
@setup five-rows
test having-aggregate-only-in-having {
    SELECT 1 FROM t HAVING sum(a) > 0;
}
expect error {
    HAVING clause on a non-aggregate query
}

# An aggregate in a result-column subquery whose argument is a column of the
# outer query belongs to the outer query and makes it an aggregate query.
@setup five-rows
test having-with-an-aggregate-moved-up-from-a-result-column-subquery {
    SELECT (SELECT count(t.a)) FROM t HAVING count(*) > 0;
}
expect {
    5
}

@setup five-rows
test having-without-aggregate-with-an-aggregate-moved-up-from-a-result-column-subquery {
    SELECT (SELECT count(t.a)) FROM t HAVING 1;
}
expect {
    5
}

# The same aggregate in a HAVING or ORDER BY subquery does not.
@setup five-rows
test having-with-an-aggregate-moved-up-from-a-having-subquery {
    SELECT 1 FROM t HAVING (SELECT count(t.a)) > 0;
}
expect error {
    HAVING clause on a non-aggregate query
}

@setup five-rows
test having-with-an-aggregate-moved-up-from-an-order-by-subquery {
    SELECT 1 FROM t HAVING 1 ORDER BY (SELECT count(t.a));
}
expect error {
    HAVING clause on a non-aggregate query
}

# As in SQLite, the HAVING error comes before errors in ORDER BY.
@setup five-rows
test having-error-before-order-by-aggregate-error {
    SELECT a FROM t HAVING 1 ORDER BY count(*);
}
expect error {
    HAVING clause on a non-aggregate query
}

@setup five-rows
test having-error-before-order-by-out-of-range-error {
    SELECT a FROM t HAVING 1 ORDER BY 5;
}
expect error {
    HAVING clause on a non-aggregate query
}

@setup five-rows
test having-error-before-order-by-unknown-column-error {
    SELECT a FROM t HAVING 1 ORDER BY nosuch;
}
expect error {
    HAVING clause on a non-aggregate query
}

# A subquery in the result columns without an aggregate that reads a column
# cannot make the query an aggregate query, so the HAVING error still comes
# before the ORDER BY error.
@setup five-rows
test having-error-before-order-by-scalar-subquery {
    SELECT (SELECT 1) FROM t HAVING 1 ORDER BY 5;
}
expect error {
    HAVING clause on a non-aggregate query
}

@setup five-rows
test having-error-before-order-by-in-subquery {
    SELECT a IN (SELECT 1) FROM t HAVING 1 ORDER BY nosuch;
}
expect error {
    HAVING clause on a non-aggregate query
}

@setup five-rows
test having-error-before-order-by-exists-subquery {
    SELECT EXISTS (SELECT 1) FROM t HAVING 1 ORDER BY sum(a);
}
expect error {
    HAVING clause on a non-aggregate query
}

@setup five-rows
test having-error-before-order-by-subquery-with-count-star {
    SELECT (SELECT count(*) FROM t) FROM t HAVING 1 ORDER BY 5;
}
expect error {
    HAVING clause on a non-aggregate query
}

# Here the subquery moves sum(t.a) up, so the query is an aggregate query and
# the ORDER BY error is the one raised.
@setup five-rows
test having-subquery-moves-aggregate-up-order-by-error {
    SELECT (SELECT sum(t.a)) FROM t HAVING 1 ORDER BY 5;
}
expect error {
    1st ORDER BY term out of range - should be between 1 and 1
}

# A window function does not make the query an aggregate query.
@setup five-rows
test having-with-only-a-window-function {
    SELECT sum(a) OVER () FROM t HAVING 1;
}
expect error {
    HAVING clause on a non-aggregate query
}

@setup five-rows
test having-bare-column-with-only-a-window-function {
    SELECT max(a) OVER (ORDER BY a) FROM t HAVING b > 10;
}
expect error {
    HAVING clause on a non-aggregate query
}

@setup five-rows
test having-with-a-window-function-and-an-aggregate {
    SELECT sum(a) OVER (), count(*) FROM t HAVING 1;
}
expect {
    1|5
}

@setup five-rows
test having-in-subquery-with-only-an-outer-aggregate {
    SELECT (SELECT 1 FROM t AS t2 HAVING count(t1.a) > 0) FROM t AS t1;
}
expect error {
    HAVING clause on a non-aggregate query
}

@setup five-rows
test having-in-subquery-with-own-and-outer-aggregate {
    SELECT (SELECT count(*) FROM t AS t2 HAVING count(t1.a) > 0) FROM t AS t1;
}
expect {
    5
}
