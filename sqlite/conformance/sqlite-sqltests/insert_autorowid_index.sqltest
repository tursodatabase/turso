@database :memory:

# Regression test for #5240: INSERT with auto-assigned rowid skips explicit
# index on INTEGER PRIMARY KEY column.

setup schema {
    CREATE TABLE v0 (c1 INTEGER PRIMARY KEY, c2 TEXT, c3 INT, c4 TEXT);
    CREATE INDEX i6 ON v0 (c1);
}

@setup schema
@cross-check-integrity
test auto-rowid-upsert-index {
    INSERT INTO v0 VALUES (10, 'av3 b', 10, 'a__');
    INSERT INTO v0 (c4, c2, c2) VALUES ('v1', 18446744073709551615, 'hijklmnop')
      ON CONFLICT DO UPDATE SET c2 = c4, c4 = c3;
    PRAGMA integrity_check;
}
expect {
    ok
}

@setup schema
@cross-check-integrity
test auto-rowid-plain-insert-index {
    INSERT INTO v0 VALUES (1, 'first', 10, 'a');
    INSERT INTO v0 (c2) VALUES ('second');
    INSERT INTO v0 (c2) VALUES ('third');
    PRAGMA integrity_check;
}
expect {
    ok
}

@setup schema
@cross-check-integrity
test auto-rowid-index-values-correct {
    INSERT INTO v0 VALUES (5, 'a', 1, 'x');
    INSERT INTO v0 (c2, c3) VALUES ('b', 2);
    INSERT INTO v0 (c2, c3) VALUES ('c', 3);
    SELECT c1, c2, c3 FROM v0 ORDER BY c1;
    PRAGMA integrity_check;
}
expect {
    5|a|1
    6|b|2
    7|c|3
    ok
}

@cross-check-integrity
test rowid-notnull-keeps-declaration-and-update-behavior {
    CREATE TABLE rowid_flags(id INTEGER PRIMARY KEY, value TEXT);
    SELECT name, "notnull" FROM pragma_table_info('rowid_flags') ORDER BY cid;
    INSERT INTO rowid_flags VALUES(NULL, 'first');
    UPDATE rowid_flags SET id = 2;
    CREATE TRIGGER before_rowid_update BEFORE UPDATE ON rowid_flags BEGIN SELECT 1; END;
    UPDATE rowid_flags SET id = 3;
    ALTER TABLE rowid_flags RENAME COLUMN id TO renamed;
    SELECT name, "notnull" FROM pragma_table_info('rowid_flags') ORDER BY cid;
    INSERT INTO rowid_flags(value) VALUES('second');
    SELECT renamed, value FROM rowid_flags ORDER BY renamed;
    PRAGMA integrity_check;
}
expect {
    id|0
    value|0
    renamed|0
    value|0
    3|first
    4|second
    ok
}

test rowid-notnull-explicit-and-strict-metadata {
    CREATE TABLE explicit_nullability(id INTEGER PRIMARY KEY NOT NULL);
    CREATE TABLE strict_nullability(id INTEGER PRIMARY KEY) STRICT;
    SELECT "notnull" FROM pragma_table_info('explicit_nullability');
    SELECT "notnull" FROM pragma_table_info('strict_nullability');
    INSERT INTO explicit_nullability VALUES(NULL);
    INSERT INTO strict_nullability VALUES(NULL);
    SELECT id FROM explicit_nullability;
    SELECT id FROM strict_nullability;
}
expect {
    1
    0
    1
    1
}
