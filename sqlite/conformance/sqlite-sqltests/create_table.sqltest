@database :memory:

@cross-check-integrity
test create_table_one_unique_set {
    CREATE TABLE t4 (a, unique(b));
}
expect error {
}

@cross-check-integrity
test create_table_same_uniques_and_primary_keys {
    CREATE TABLE t2 (a,b, unique(a,b), primary key(a,b));
}
expect {
}

@cross-check-integrity
test create_table_unique_contained_in_primary_keys {
    CREATE TABLE t4 (a,b, primary key(a,b), unique(a));
}
expect {
}

@cross-check-integrity
test create_table_boolean_named_columns_in_table_constraints {
    CREATE TABLE t (true INTEGER, false INTEGER, b INTEGER, PRIMARY KEY (true, b), UNIQUE (false, b));
    INSERT INTO t VALUES (1, 2, 3);
    INSERT OR IGNORE INTO t VALUES (1, 4, 3);
    INSERT OR IGNORE INTO t VALUES (5, 2, 3);
    SELECT count(*) FROM t;
}
expect {
    1
}

