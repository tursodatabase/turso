# https://github.com/tursodatabase/turso/issues/4987
@cross-check-integrity
test create_table_trailing_named_column_constraint {
    CREATE TABLE t (
        a INTEGER CONSTRAINT c PRIMARY KEY,
        b,
        d CONSTRAINT e
    );
    INSERT INTO t (a, b, d) VALUES (10, 'left', 'right');
    SELECT a, b, d FROM t;
}
expect {
    10|left|right
}

# https://github.com/tursodatabase/turso/issues/4987
@cross-check-integrity
test create_table_trailing_named_column_constraint_primary_key_enforced {
    CREATE TABLE t(
        a INTEGER CONSTRAINT c PRIMARY KEY,
        b CONSTRAINT d
    );
    INSERT INTO t VALUES(1, 'x');
    INSERT OR IGNORE INTO t VALUES(1, 'y');
    SELECT count(*), min(b), max(b) FROM t;
}
expect {
    1|x|x
}

# https://github.com/tursodatabase/turso/issues/5632
@cross-check-integrity
test create_table_quoted_name_does_not_inject_parse_schema_predicate {
    CREATE TABLE t(x);
    INSERT INTO t VALUES('test');
    CREATE TABLE "x' and 0 union select 'table','t2','t2',2,'create table t2(z)' --"(a);
    SELECT count(*) FROM sqlite_schema WHERE type = 'table' AND name = 't2';
    SELECT * FROM t;
    PRAGMA integrity_check;
}
expect {
    0
    test
    ok
}

# A COLLATE clause on a PRIMARY KEY or UNIQUE table-constraint column applies
# to the implied unique index, exactly like CREATE INDEX ... (a COLLATE x).
@cross-check-integrity
test create_table_primary_key_collate_nocase_uniqueness {
    CREATE TABLE t_pkc(a, PRIMARY KEY(a COLLATE NOCASE));
    INSERT INTO t_pkc VALUES ('x');
    INSERT INTO t_pkc VALUES ('X');
}
expect error {
    UNIQUE constraint failed
}

@skip-if mvcc "WITHOUT ROWID tables are not supported in MVCC mode"
@cross-check-integrity
test create_table_without_rowid_primary_key_collate_nocase_uniqueness {
    CREATE TABLE t_wpkc(a, b, PRIMARY KEY(a COLLATE NOCASE, b)) WITHOUT ROWID;
    INSERT INTO t_wpkc VALUES ('x', 1);
    INSERT INTO t_wpkc VALUES ('X', 1);
}
expect error {
    UNIQUE constraint failed
}

@skip-if mvcc "WITHOUT ROWID tables are not supported in MVCC mode"
@cross-check-integrity
test create_table_without_rowid_primary_key_collate_rtrim_uniqueness {
    CREATE TABLE t_wpkr(a, PRIMARY KEY(a COLLATE RTRIM)) WITHOUT ROWID;
    INSERT INTO t_wpkr VALUES ('x  ');
    INSERT INTO t_wpkr VALUES ('x');
}
expect error {
    UNIQUE constraint failed
}

# SQLite stores a column once per PRIMARY KEY entry when the entries have
# different collations. Turso stores it once, so it rejects such a table
# rather than write a file SQLite cannot read.
@skip-if mvcc "WITHOUT ROWID tables are not supported in MVCC mode"
@skip-if sqlite "SQLite accepts this table"
test create_table_without_rowid_primary_key_repeated_column_collations {
    CREATE TABLE t_wpkd(a, b, PRIMARY KEY(a COLLATE NOCASE, b, a)) WITHOUT ROWID;
}
expect error {
    lists a column more than once with different collations
}

# The same key on a rowid table is allowed: 'A' and 'a' differ under the
# second, BINARY entry.
@cross-check-integrity
test create_table_primary_key_repeated_column_collations {
    CREATE TABLE t_pkrc(a, b, PRIMARY KEY(a COLLATE NOCASE, b, a));
    INSERT INTO t_pkrc VALUES ('A', 1);
    INSERT INTO t_pkrc VALUES ('a', 1);
    SELECT a, b FROM t_pkrc ORDER BY a;
}
expect {
    A|1
    a|1
}

# A WITHOUT ROWID table is stored in primary key order, so a full scan returns
# rows sorted by the PRIMARY KEY's collation.
@skip-if mvcc "WITHOUT ROWID tables are not supported in MVCC mode"
@cross-check-integrity
test create_table_without_rowid_primary_key_collate_nocase_storage_order {
    CREATE TABLE t_wpko(a, PRIMARY KEY(a COLLATE NOCASE)) WITHOUT ROWID;
    INSERT INTO t_wpko VALUES ('b'), ('A'), ('C');
    SELECT a FROM t_wpko;
}
expect {
    A
    b
    C
}

@cross-check-integrity
test create_table_unique_collate_nocase_uniqueness {
    CREATE TABLE t_uqc(a, UNIQUE(a COLLATE NOCASE));
    INSERT INTO t_uqc VALUES ('x');
    INSERT INTO t_uqc VALUES ('X');
}
expect error {
    UNIQUE constraint failed
}

@cross-check-integrity
test create_table_primary_key_collate_desc_accepts_distinct_values {
    CREATE TABLE t_pkd(a, PRIMARY KEY(a COLLATE NOCASE DESC));
    INSERT INTO t_pkd VALUES ('b'), ('A'), ('C');
    SELECT a FROM t_pkd ORDER BY a COLLATE NOCASE;
}
expect {
    A
    b
    C
}

# IF NOT EXISTS on an existing table does not check the body.
test create_table_if_not_exists_skips_body_errors {
    CREATE TABLE t(x);
    CREATE TABLE IF NOT EXISTS t(a, a);
    CREATE TABLE IF NOT EXISTS t(a INTEGER PRIMARY KEY AUTOINCREMENT) WITHOUT ROWID;
    SELECT 'ok';
}
expect {
    ok
}

# Without IF NOT EXISTS, the existing table is reported before body errors.
test create_table_existing_table_reported_before_body_errors {
    CREATE TABLE t(x);
    CREATE TABLE t(a, a);
}
expect error {
    table t already exists
}
