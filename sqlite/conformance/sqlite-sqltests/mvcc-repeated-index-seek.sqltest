@database :temp:
@skip-file-if sqlite "MVCC is not supported in SQLite"

# A join seeks the index of t once per row of o. After the seek for 2 finds a
# row, the next seek for 3 must still find the row added to 3 after the
# checkpoint.
test mvcc-repeated-index-seeks-find-rows-added-after-checkpoint {
    PRAGMA journal_mode='MVCC';
    CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, v INTEGER);
    CREATE INDEX ia ON t(a);
    CREATE TABLE o(k);
    INSERT INTO t(id, a) VALUES (15, 2), (24, 3), (52, 3);
    INSERT INTO o VALUES (2), (3);
    PRAGMA wal_checkpoint(TRUNCATE);
    INSERT INTO t(id, a) VALUES (48, 3);
    SELECT o.k, t.id FROM o JOIN t ON t.a = o.k ORDER BY 1, 2;
    UPDATE t SET v = 1 WHERE id IN (SELECT t.id FROM o JOIN t ON t.a = o.k);
    SELECT count(*) FROM t WHERE v = 1;
    DELETE FROM t WHERE id IN (SELECT t.id FROM o JOIN t ON t.a = o.k);
    SELECT count(*) FROM t;
}
expect {
    mvcc
    0|0|0
    2|15
    3|24
    3|48
    3|52
    4
    0
}

# A semi-join leaves the inner index cursor on its first match. The next outer
# row seeks the same key and must start at the first row of that key again,
# not at the row the cursor was left on.
test mvcc-repeated-index-seeks-start-at-first-row-of-key {
    PRAGMA journal_mode='MVCC';
    CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER);
    CREATE INDEX ia ON t(a);
    CREATE TABLE o(k, m);
    INSERT INTO t VALUES (24, 3), (48, 3), (52, 3);
    INSERT INTO o VALUES (3, 48), (3, 24), (3, 52), (3, 24);
    SELECT o.rowid FROM o WHERE EXISTS (SELECT 1 FROM t WHERE t.a = o.k AND t.id + 0 = o.m) ORDER BY 1;
}
expect {
    mvcc
    1
    2
    3
    4
}

# A UNIQUE index can hold many rows with NULL. The semi-join leaves the cursor
# on (NULL, 2). The next outer row seeks NULL again and must start at the first
# NULL row, so it still finds id 1.
test mvcc-repeated-unique-index-seeks-for-null-start-at-first-row {
    PRAGMA journal_mode='MVCC';
    CREATE TABLE t(id INTEGER PRIMARY KEY, u INTEGER UNIQUE);
    INSERT INTO t VALUES (1, NULL), (2, NULL), (3, NULL);
    CREATE TABLE o(k, m);
    INSERT INTO o VALUES (NULL, 2), (NULL, 1), (NULL, 3), (NULL, 1);
    SELECT o.rowid FROM o WHERE EXISTS (SELECT 1 FROM t WHERE t.u IS o.k AND t.id + 0 = o.m) ORDER BY 1;
}
expect {
    mvcc
    1
    2
    3
    4
}

# A UNIQUE index key without NULL names one row, so a repeated seek for the
# key the cursor is on may be skipped. Rows on both sides of a checkpoint must
# still be found.
test mvcc-repeated-unique-index-seeks-after-checkpoint {
    PRAGMA journal_mode='MVCC';
    CREATE TABLE t(id INTEGER PRIMARY KEY, u INTEGER UNIQUE);
    CREATE TABLE o(k);
    INSERT INTO t VALUES (1, 5), (2, 7);
    INSERT INTO o VALUES (5), (5), (6), (6), (7), (7);
    PRAGMA wal_checkpoint(TRUNCATE);
    INSERT INTO t VALUES (3, 6);
    SELECT o.k, t.id FROM o JOIN t ON t.u = o.k ORDER BY o.rowid;
}
expect {
    mvcc
    0|0|0
    5|1
    5|1
    6|3
    6|3
    7|2
    7|2
}

# UPDATE scans the table and, for each row, probes the REPLACE-ing UNIQUE index
# for a conflict. After the probe for row 2 deletes row 4, the scan must go on
# to rows 3 and 5. They are in the B-tree, while rows 2 and 4 are only in memory.
test mvcc-update-on-conflict-replace-visits-rows-after-probe {
    PRAGMA journal_mode='MVCC';
    CREATE TABLE t(id INTEGER PRIMARY KEY, u UNIQUE ON CONFLICT REPLACE, v);
    INSERT INTO t VALUES (1, 100, 0), (3, 300, 0), (5, 500, 0);
    PRAGMA wal_checkpoint(TRUNCATE);
    INSERT INTO t VALUES (2, 200, 0), (4, 10, 0);
    UPDATE t SET u = CASE WHEN id = 2 THEN 10 ELSE u END, v = v + 1;
    SELECT id, u, v FROM t ORDER BY id;
}
expect {
    mvcc
    0|0|0
    1|100|1
    2|10|1
    3|300|1
    5|500|1
}
