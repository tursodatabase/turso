        a INTEGER PRIMARY KEY,
        b INTEGER
    );
    CREATE INDEX idx_b ON t4(b);
}

@setup empty
test in-empty-table-rowid {
    SELECT a FROM t4 WHERE a IN (1, 2, 3);
}
expect {
}

@setup empty
test in-empty-table-index {
    SELECT a FROM t4 WHERE b IN (1, 2, 3);
}
expect {
}

# Large IN list
setup large {
    CREATE TABLE t5 (
        id INTEGER PRIMARY KEY,
        val INTEGER
    );
    CREATE INDEX idx_val ON t5(val);
    INSERT INTO t5 VALUES(1, 1);
    INSERT INTO t5 VALUES(2, 2);
    INSERT INTO t5 VALUES(3, 3);
    INSERT INTO t5 VALUES(4, 4);
    INSERT INTO t5 VALUES(5, 5);
    INSERT INTO t5 VALUES(6, 6);
    INSERT INTO t5 VALUES(7, 7);
    INSERT INTO t5 VALUES(8, 8);
    INSERT INTO t5 VALUES(9, 9);
    INSERT INTO t5 VALUES(10, 10);
}

@setup large
test in-many-values {
    SELECT id FROM t5 WHERE val IN (2, 4, 6, 8, 10) ORDER BY id;
}
expect {
    2
    4
    6
    8
    10
}

@setup large
test rowid-in-many-values {
    SELECT id FROM t5 WHERE id IN (1, 3, 5, 7, 9) ORDER BY id;
}
expect {
    1
    3
    5
    7
    9
}

# NOCASE collation - IN list should respect index collation
setup nocase {
    CREATE TABLE t6 (
        id INTEGER PRIMARY KEY,
        val TEXT COLLATE NOCASE
    );
    CREATE INDEX idx_val_nocase ON t6(val);
    INSERT INTO t6 VALUES(1, 'hello');
    INSERT INTO t6 VALUES(2, 'HELLO');
    INSERT INTO t6 VALUES(3, 'world');
    INSERT INTO t6 VALUES(4, 'WORLD');
}

@setup nocase
test in-nocase-index {
    SELECT id, val FROM t6 WHERE val IN ('hello', 'world') ORDER BY id;
}
expect {
    1|hello
    2|HELLO
    3|world
    4|WORLD
}

@setup nocase
test in-nocase-index-mixed-case-list {
    SELECT id, val FROM t6 WHERE val IN ('HELLO', 'World') ORDER BY id;
}
expect {
    1|hello
    2|HELLO
    3|world
    4|WORLD
}

# NOCASE IN subquery - ephemeral must inherit LHS collation
@setup nocase
test in-nocase-subquery {
    CREATE TABLE search_vals(v TEXT);
    INSERT INTO search_vals VALUES('hello');
    INSERT INTO search_vals VALUES('world');
    SELECT id, val FROM t6 WHERE val IN (SELECT v FROM search_vals) ORDER BY id;
}
expect {
    1|hello
    2|HELLO
    3|world
    4|WORLD
}

# COLLATE BINARY explicit override on NOCASE column
@setup nocase
test in-collate-binary-override {
    SELECT id FROM t6 WHERE val COLLATE BINARY IN ('hello') ORDER BY id;
}
expect {
    1
}

# BINARY IN must not use a NOCASE index, or it will match extra rows
setup nocase_mismatch {
    CREATE TABLE t7 (
        id INTEGER PRIMARY KEY,
        val TEXT
    );
    CREATE INDEX idx_val_nocase_only ON t7(val COLLATE NOCASE);
    INSERT INTO t7 VALUES(1, 'hello');
    INSERT INTO t7 VALUES(2, 'HELLO');
}

@setup nocase_mismatch
test in-index-collation-mismatch-falls-back {
    SELECT id FROM t7 WHERE val IN ('hello') ORDER BY id;
}
expect {
    1
}

@setup nocase_mismatch
test in-index-collation-match-explicit-nocase {
    SELECT id FROM t7 WHERE val COLLATE NOCASE IN ('hello') ORDER BY id;
}
expect {
    1
    2
}

@setup nocase_mismatch
test in-subquery-collation-mismatch-falls-back {
    CREATE TABLE search_vals2(v TEXT);
    INSERT INTO search_vals2 VALUES('hello');
    SELECT id FROM t7 WHERE val IN (SELECT v FROM search_vals2) ORDER BY id;
}
expect {
    1
}

setup rtrim_mismatch {
    CREATE TABLE t8 (
        id INTEGER PRIMARY KEY,
        val TEXT
    );
    CREATE INDEX idx_val_rtrim_only ON t8(val COLLATE RTRIM);
    INSERT INTO t8 VALUES(1, 'hello');
    INSERT INTO t8 VALUES(2, 'hello   ');
}

@setup rtrim_mismatch
test in-index-collation-mismatch-rtrim-falls-back {
    SELECT id FROM t8 WHERE val IN ('hello') ORDER BY id;
}
expect {
    1
}

@setup rtrim_mismatch
test in-index-collation-match-explicit-rtrim {
    SELECT id FROM t8 WHERE val COLLATE RTRIM IN ('hello') ORDER BY id;
}
expect {
    1
    2
}

setup composite_nocase_mismatch {
    CREATE TABLE t9 (
        id INTEGER PRIMARY KEY,
        val TEXT,
        other INTEGER
    );
    CREATE INDEX idx_val_other_nocase ON t9(val COLLATE NOCASE, other);
    INSERT INTO t9 VALUES(1, 'hello', 1);
    INSERT INTO t9 VALUES(2, 'HELLO', 2);
}

@setup composite_nocase_mismatch
test in-composite-index-collation-mismatch-falls-back {
    SELECT id FROM t9 WHERE val IN ('hello') ORDER BY id;
}
expect {
    1
}

setup desc_index {
    CREATE TABLE td (
        id INTEGER PRIMARY KEY,
        x INTEGER,
        y INTEGER
    );
    CREATE INDEX idx_td_x_desc ON td(x DESC);
    INSERT INTO td VALUES(1, 1, 10);
    INSERT INTO td VALUES(2, 2, 20);
    INSERT INTO td VALUES(3, 3, 30);
    INSERT INTO td VALUES(4, 1, 40);
}

@setup desc_index
test in-desc-index-select {
    SELECT id, x FROM td WHERE x IN (1, 3) ORDER BY id;
}
expect {
    1|1
    3|3
    4|1
}

@setup desc_index
test in-desc-index-update {
    UPDATE td SET y = y + 100 WHERE x IN (1, 3);
    SELECT id, y FROM td ORDER BY id;
}
expect {
    1|110
    2|20
    3|130
    4|140
}

@setup desc_index
test in-desc-index-delete {
    DELETE FROM td WHERE x IN (1, 3);
    SELECT id, x, y FROM td ORDER BY id;
}
expect {
    2|2|20
}

setup replace_inseek {
    CREATE TABLE tr (
        id INTEGER PRIMARY KEY,
        n INTEGER,
        u INTEGER UNIQUE
    );
    CREATE INDEX idx_tr_n ON tr(n);
    INSERT INTO tr VALUES(1, 10, 100);
    INSERT INTO tr VALUES(2, 20, 200);
    INSERT INTO tr VALUES(3, 30, 300);
}

@setup replace_inseek
test in-index-update-or-replace {
    UPDATE OR REPLACE tr SET u = 200 WHERE n IN (10);
    SELECT id, n, u FROM tr ORDER BY id;
}
expect {
    1|10|200
    3|30|300
}

@setup replace_inseek
test in-index-update-or-replace-multirow {
    UPDATE OR REPLACE tr SET u = 999 WHERE n IN (10, 30);
    SELECT id, n, u FROM tr ORDER BY id;
}
expect {
    2|20|200
    3|30|999
}

setup partial_inseek {
    CREATE TABLE tp (
        id INTEGER PRIMARY KEY,
        n INTEGER,
        keep INTEGER
    );
    CREATE INDEX idx_tp_n_keep1 ON tp(n) WHERE keep = 1;
    INSERT INTO tp VALUES(1, 10, 1);
    INSERT INTO tp VALUES(2, 10, 0);
    INSERT INTO tp VALUES(3, 20, 1);
    INSERT INTO tp VALUES(4, 20, 0);
}

@setup partial_inseek
test in-partial-index-predicate-implied {
    SELECT id FROM tp WHERE n IN (10, 20) AND keep = 1 ORDER BY id;
}
expect {
    1
    3
}

@setup partial_inseek
test in-partial-index-predicate-not-implied {
    SELECT id FROM tp WHERE n IN (10, 20) ORDER BY id;
}
expect {
    1
    2
    3
    4
}

setup returning_inseek {
    CREATE TABLE tret (
        id INTEGER PRIMARY KEY,
        n INTEGER,
        v TEXT
    );
    CREATE INDEX idx_tret_n ON tret(n);
    INSERT INTO tret VALUES(1, 10, 'a');
    INSERT INTO tret VALUES(2, 20, 'b');
    INSERT INTO tret VALUES(3, 10, 'c');
}

@setup returning_inseek
test in-index-update-returning {
    UPDATE tret SET v = v || '!' WHERE n IN (10) RETURNING id, v;
    SELECT id, n, v FROM tret ORDER BY id;
}
expect {
    1|a!
    3|c!
    1|10|a!
    2|20|b
    3|10|c!
}

@setup returning_inseek
test in-index-delete-returning {
    DELETE FROM tret WHERE n IN (20) RETURNING id, v;
    SELECT id, n, v FROM tret ORDER BY id;
}
expect {
    2|b
    1|10|a
    3|10|c
}

# NOT IN with NULL - three-valued logic: NOT IN returns empty when NULL is in the list
setup nulls {
    CREATE TABLE tn (
        id INTEGER PRIMARY KEY,
        val TEXT
    );
    INSERT INTO tn VALUES(1, 'a');
    INSERT INTO tn VALUES(2, NULL);
    INSERT INTO tn VALUES(3, 'b');
}

@setup nulls
test not-in-with-null-in-list {
    SELECT id FROM tn WHERE val NOT IN ('a', NULL) ORDER BY id;
}
expect {
}

@setup nulls
test in-with-null-in-list {
    SELECT id FROM tn WHERE val IN ('a', 'b', NULL) ORDER BY id;
}
expect {
    1
    3
}

# NOT IN with NULL in subquery result
@setup nulls
test not-in-subquery-with-null {
    CREATE TABLE sn(v TEXT);
    INSERT INTO sn VALUES('a');
    INSERT INTO sn VALUES(NULL);
    INSERT INTO sn VALUES('b');
    SELECT id FROM tn WHERE val IN (SELECT v FROM sn) ORDER BY id;
}
expect {
    1
    3
}

@setup nulls
test not-in-subquery-with-null-notin {
    CREATE TABLE sn2(v TEXT);
    INSERT INTO sn2 VALUES('a');
    INSERT INTO sn2 VALUES(NULL);
    INSERT INTO sn2 VALUES('b');
    SELECT id FROM tn WHERE val NOT IN (SELECT v FROM sn2) ORDER BY id;
}
expect {
}

# Type coercion: integer column with string/float IN values
setup types {
    CREATE TABLE tt (
        id INTEGER PRIMARY KEY,
        val INTEGER
    );
    CREATE INDEX idx_tt_val ON tt(val);
    INSERT INTO tt VALUES(1, 1);
    INSERT INTO tt VALUES(2, 2);
    INSERT INTO tt VALUES(3, 3);
}

@setup types
test in-integer-col-string-values {
    SELECT id FROM tt WHERE val IN ('1', '2') ORDER BY id;
}
expect {
    1
    2
}

@setup types
test in-integer-col-float-values {
    SELECT id FROM tt WHERE val IN (1.0, 2.0) ORDER BY id;
}
expect {
    1
    2
}

# Type coercion in IN subquery
@setup types
test in-subquery-type-coercion {
    CREATE TABLE ts(v TEXT);
    INSERT INTO ts VALUES('1');
    INSERT INTO ts VALUES('2');
    SELECT id FROM tt WHERE val IN (SELECT v FROM ts) ORDER BY id;
}
expect {
    1
    2
}

# Rowid IN with float/string types
@setup schema
test rowid-in-float-values {
    SELECT b FROM t WHERE a IN (1.0, 2.0) ORDER BY a;
}
expect {
    one
    two
}

@setup schema
test rowid-in-string-values {
    SELECT b FROM t WHERE a IN ('1', '2') ORDER BY a;
}
expect {
    one
    two
}

# Mixed types in typeless column
setup mixed {
    CREATE TABLE tm (
        id INTEGER PRIMARY KEY,
        val
    );
    INSERT INTO tm VALUES(1, 1);
    INSERT INTO tm VALUES(2, 'hello');
    INSERT INTO tm VALUES(3, 3.14);
    INSERT INTO tm VALUES(4, NULL);
    INSERT INTO tm VALUES(5, X'CAFE');
}

@setup mixed
test in-mixed-types {
    SELECT id FROM tm WHERE val IN (1, 'hello', 3.14) ORDER BY id;
}
expect {
    1
    2
    3
}

@setup mixed
test in-mixed-types-with-null {
    SELECT id FROM tm WHERE val IN (1, 'hello', NULL) ORDER BY id;
}
expect {
    1
    2
}

# IN on non-indexed column
@setup schema
test in-non-indexed-column {
    SELECT a FROM t WHERE b IN ('one', 'three') ORDER BY a;
}
expect {
    1
    3
}

# IN subquery with duplicate values in subquery
@setup text_idx
test in-subquery-with-duplicates {
    CREATE TABLE sd(v TEXT);
    INSERT INTO sd VALUES('alice');
    INSERT INTO sd VALUES('alice');
    INSERT INTO sd VALUES('bob');
    INSERT INTO sd VALUES('bob');
    SELECT id FROM t3 WHERE name IN (SELECT v FROM sd) ORDER BY id;
}
expect {
    1
    2
    4
}

# IN subquery returning no rows
@setup text_idx
test in-subquery-empty {
    CREATE TABLE se(v TEXT);
    SELECT id FROM t3 WHERE name IN (SELECT v FROM se) ORDER BY id;
}
expect {
}

# Correlated IN subquery
setup correlated {
    CREATE TABLE tc (
        id INTEGER PRIMARY KEY,
        val INTEGER
    );
    CREATE TABLE sc (
        id INTEGER,
        parent_id INTEGER,
        val INTEGER
    );
    INSERT INTO tc VALUES(1, 10);
    INSERT INTO tc VALUES(2, 20);
    INSERT INTO tc VALUES(3, 30);
    INSERT INTO sc VALUES(1, 1, 10);
    INSERT INTO sc VALUES(2, 1, 20);
    INSERT INTO sc VALUES(3, 2, 30);
}

@setup correlated
test in-correlated-subquery {
    SELECT tc.id FROM tc WHERE tc.val IN (SELECT sc.val FROM sc WHERE sc.parent_id = tc.id) ORDER BY tc.id;
}
expect {
    1
}

# IN list in JOIN context
setup join_ctx {
    CREATE TABLE tj1 (
        id INTEGER PRIMARY KEY,
        val INTEGER
    );
    CREATE TABLE tj2 (
        id INTEGER PRIMARY KEY,
        val INTEGER
    );
    INSERT INTO tj1 VALUES(1, 10);
    INSERT INTO tj1 VALUES(2, 20);
    INSERT INTO tj1 VALUES(3, 30);
    INSERT INTO tj2 VALUES(1, 10);
    INSERT INTO tj2 VALUES(2, 40);
}

@setup join_ctx
test in-list-with-join {
    SELECT tj1.id FROM tj1 JOIN tj2 ON tj1.id = tj2.id WHERE tj1.val IN (10, 30) ORDER BY tj1.id;
}
expect {
    1
}

@setup join_ctx
test in-subquery-with-join {
    SELECT tj1.id FROM tj1 JOIN tj2 ON tj1.id = tj2.id WHERE tj1.val IN (SELECT val FROM tj2) ORDER BY tj1.id;
}
expect {
    1
}

setup multi_join_in_ctx {
    CREATE TABLE mj1 (
        id INTEGER PRIMARY KEY,
        a INTEGER,
        b INTEGER
    );
    CREATE TABLE mj2 (
        id INTEGER PRIMARY KEY,
        a INTEGER,
        c INTEGER
    );
    CREATE TABLE mj3 (
        id INTEGER PRIMARY KEY,
        b INTEGER,
        c INTEGER
    );
    CREATE TABLE ms1(v INTEGER);
    CREATE TABLE ms2(v INTEGER);
    CREATE INDEX idx_mj1_a ON mj1(a);
    CREATE INDEX idx_mj2_a ON mj2(a);
    CREATE INDEX idx_mj2_c ON mj2(c);
    INSERT INTO mj1 VALUES (1, 10, 100);
    INSERT INTO mj1 VALUES (2, 20, 200);
    INSERT INTO mj1 VALUES (3, 30, 300);
    INSERT INTO mj1 VALUES (4, NULL, 400);
    INSERT INTO mj2 VALUES (1, 10, 1);
    INSERT INTO mj2 VALUES (2, 20, 2);
    INSERT INTO mj2 VALUES (3, 40, 3);
    INSERT INTO mj3 VALUES (1, 100, 1);
    INSERT INTO mj3 VALUES (2, 200, 9);
    INSERT INTO mj3 VALUES (3, 300, 3);
    INSERT INTO mj3 VALUES (4, 400, 4);
    INSERT INTO ms1 VALUES (10);
    INSERT INTO ms1 VALUES (30);
    INSERT INTO ms1 VALUES (NULL);
    INSERT INTO ms2 VALUES (1);
    INSERT INTO ms2 VALUES (3);
    INSERT INTO ms2 VALUES (NULL);
}

@setup multi_join_in_ctx
test multi-join-two-independent-in-subqueries {
    SELECT mj1.id, mj2.id, mj3.id
    FROM mj1
    JOIN mj2 ON mj1.a = mj2.a
    JOIN mj3 ON mj1.b = mj3.b AND mj2.c = mj3.c
    WHERE mj1.a IN (SELECT v FROM ms1)
      AND mj2.c IN (SELECT v FROM ms2)
    ORDER BY 1, 2, 3;
}
expect {
    1|1|1
}

@setup multi_join_in_ctx
test multi-left-join-two-independent-in-subqueries {
    SELECT mj1.id, IFNULL(mj2.id, -1), IFNULL(mj3.id, -1)
    FROM mj1
    LEFT JOIN mj2 ON mj1.a = mj2.a AND mj1.a IN (SELECT v FROM ms1)
    LEFT JOIN mj3 ON mj1.b = mj3.b AND mj2.c IN (SELECT v FROM ms2) AND mj2.c = mj3.c
    ORDER BY 1, 2, 3;
}
expect {
    1|1|1
    2|-1|-1
    3|-1|-1
    4|-1|-1
}

setup left_join_in {
    CREATE TABLE lj1 (
        id INTEGER PRIMARY KEY
    );
    CREATE TABLE lj2 (
        id INTEGER PRIMARY KEY,
        val INTEGER
    );
    CREATE INDEX idx_lj2_val ON lj2(val);
    INSERT INTO lj1 VALUES(1);
    INSERT INTO lj1 VALUES(2);
}

@setup left_join_in
test in-list-left-join-on-match {
    INSERT INTO lj2 VALUES(10, 1);
    INSERT INTO lj2 VALUES(11, 2);
    SELECT lj1.id, IFNULL(lj2.id, -1), IFNULL(lj2.val, -1)
    FROM lj1
    LEFT JOIN lj2 ON lj2.val IN (1)
    ORDER BY lj1.id, lj2.id;
}
expect {
    1|10|1
    2|10|1
}

@setup left_join_in
test in-list-left-join-on-no-match {
    INSERT INTO lj2 VALUES(10, 2);
    INSERT INTO lj2 VALUES(11, 3);
    SELECT lj1.id, IFNULL(lj2.id, -1), IFNULL(lj2.val, -1)
    FROM lj1
    LEFT JOIN lj2 ON lj2.val IN (1)
    ORDER BY lj1.id, lj2.id;
}
expect {
    1|-1|-1
    2|-1|-1
}

@setup left_join_in
test in-subquery-left-join-on-match {
    CREATE TABLE lj_search(v INTEGER);
    INSERT INTO lj2 VALUES(10, 1);
    INSERT INTO lj2 VALUES(11, 2);
    INSERT INTO lj_search VALUES(1);
    SELECT lj1.id, IFNULL(lj2.id, -1), IFNULL(lj2.val, -1)
    FROM lj1
    LEFT JOIN lj2 ON lj2.val IN (SELECT v FROM lj_search)
    ORDER BY lj1.id, lj2.id;
}
expect {
    1|10|1
    2|10|1
}

# Nested IN subqueries
setup nested {
    CREATE TABLE tn1(id INTEGER PRIMARY KEY, val INTEGER);
    CREATE TABLE tn2(id INTEGER PRIMARY KEY, val INTEGER);
    CREATE TABLE tn3(id INTEGER PRIMARY KEY, val INTEGER);
    INSERT INTO tn1 VALUES(1,1),(2,2),(3,3);
    INSERT INTO tn2 VALUES(1,1),(2,2);
    INSERT INTO tn3 VALUES(1,1);
}

@setup nested
test in-nested-subqueries {
    SELECT id FROM tn1 WHERE val IN (SELECT val FROM tn2 WHERE val IN (SELECT val FROM tn3));
}
expect {
    1
}

# Self-referencing IN: col IN (col) must not use InSeek (RHS is not constant)
setup self_ref {
    CREATE TABLE tsr (
        x INTEGER PRIMARY KEY
    );
    INSERT INTO tsr VALUES(1);
    INSERT INTO tsr VALUES(2);
    INSERT INTO tsr VALUES(3);
}

@setup self_ref
test in-self-referencing-rowid {
    SELECT COUNT(*) FROM tsr WHERE tsr.x IN (tsr.x);
}
expect {
    3
}

@setup self_ref
test in-self-referencing-indexed {
    CREATE TABLE tsr2(id INTEGER PRIMARY KEY, val INTEGER);
    CREATE INDEX idx_tsr2 ON tsr2(val);
    INSERT INTO tsr2 VALUES(1, 10), (2, 20), (3, 30);
    SELECT COUNT(*) FROM tsr2 WHERE tsr2.val IN (tsr2.val);
}
expect {
    3
}

# Cross-table column reference in IN list (join context)
@setup join_ctx
test in-cross-table-column-ref {
    SELECT tj1.id FROM tj1 JOIN tj2 ON tj1.id = tj2.id WHERE tj1.val IN (tj2.val) ORDER BY tj1.id;
}
expect {
    1
}

test in-list-of-an-earlier-table-column-is-rebuilt-for-each-row {
    CREATE TABLE tr(id INTEGER PRIMARY KEY, v INT);
    CREATE INDEX tr_v ON tr(v);
    INSERT INTO tr VALUES (5, 50), (6, 60), (7, 70);

    SELECT b.id, c.id FROM tr AS b JOIN tr AS c WHERE c.id IN (b.id) ORDER BY 1, 2;
    SELECT b.id, c.id FROM tr AS b JOIN tr AS c WHERE c.v IN (b.v, 70) ORDER BY 1, 2;
    SELECT a.id, b.id, c.id
      FROM tr AS a
      FULL JOIN tr AS b ON 0
      JOIN tr AS c
     WHERE c.id IN (b.id) AND a.id IS NULL
     ORDER BY 2;
}
expect {
    5|5
    6|6
    7|7
    5|5
    5|7
    6|6
    6|7
    7|7
    |5|5
    |6|6
    |7|7
}

# IN on an index column that follows an equality prefix: with an index on
# (source, item_id), `source = ? AND item_id IN (...)` seeks (source, v) once
# per distinct non-NULL value v instead of scanning every row of the prefix.
setup eq_prefix {
    CREATE TABLE ts (
        id INTEGER PRIMARY KEY,
        source TEXT,
        item_id INTEGER
    );
    CREATE INDEX idx_ts ON ts(source, item_id);
    INSERT INTO ts VALUES(1, 'a', 1);
    INSERT INTO ts VALUES(2, 'a', 2);
    INSERT INTO ts VALUES(3, 'a', 3);
    INSERT INTO ts VALUES(4, 'a', 3);
    INSERT INTO ts VALUES(5, 'a', NULL);
    INSERT INTO ts VALUES(6, 'b', 1);
    INSERT INTO ts VALUES(7, 'b', 2);
    INSERT INTO ts VALUES(8, NULL, 1);
    INSERT INTO ts VALUES(9, NULL, NULL);
    INSERT INTO ts VALUES(10, 'a', 5);
}

@setup eq_prefix
test in-list-after-eq-prefix {
    SELECT id FROM ts WHERE source = 'a' AND item_id IN (3, 1, 99) ORDER BY id;
}
expect {
    1
    3
    4
}

# A value spelled several ways, or repeated, reads its rows once.
@setup eq_prefix
test in-list-after-eq-prefix-duplicate-values {
    SELECT id FROM ts WHERE source = 'a' AND item_id IN (3, 3, 3.0, '3', 1) ORDER BY id;
}
expect {
    1
    3
    4
}

@setup eq_prefix
test in-list-after-eq-prefix-null-in-list {
    SELECT id FROM ts WHERE source = 'a' AND item_id IN (NULL, 2) ORDER BY id;
}
expect {
    2
}

# A NULL prefix value matches nothing.
@setup eq_prefix
test in-list-after-eq-prefix-null-prefix {
    SELECT count(*) FROM ts WHERE source = NULL AND item_id IN (1, 2);
}
expect {
    0
}

# IS matches NULL keys, so it is not a prefix equality.
@setup eq_prefix
test in-list-after-is-null-prefix {
    SELECT id FROM ts WHERE source IS NULL AND item_id IN (1, 2) ORDER BY id;
}
expect {
    8
}

@setup eq_prefix
test in-list-after-eq-prefix-expression {
    SELECT id FROM ts WHERE source = lower('A') AND item_id IN (2, 5) ORDER BY id;
}
expect {
    2
    10
}

@setup eq_prefix
test not-in-list-after-eq-prefix {
    SELECT id FROM ts WHERE source = 'a' AND item_id NOT IN (1, 2, 3) ORDER BY id;
}
expect {
    10
}

@setup eq_prefix
test in-subquery-after-eq-prefix {
    SELECT id FROM ts
    WHERE source = 'a' AND item_id IN (SELECT item_id FROM ts WHERE source = 'b')
    ORDER BY id;
}
expect {
    1
    2
}

# The subquery returns a value several times and NULLs.
@setup eq_prefix
test in-subquery-after-eq-prefix-duplicates-and-nulls {
    SELECT id FROM ts
    WHERE source = 'a' AND item_id IN (SELECT item_id FROM ts WHERE id IN (1, 3, 4, 5, 9))
    ORDER BY id;
}
expect {
    1
    3
    4
}

@setup eq_prefix
test in-subquery-after-eq-prefix-no-rows {
    SELECT count(*) FROM ts
    WHERE source = 'a' AND item_id IN (SELECT item_id FROM ts WHERE id < 0);
}
expect {
    0
}

# The IN values are not read in index order: ORDER BY on the IN column must sort.
@setup eq_prefix
test in-list-after-eq-prefix-order-by-in-column {
    SELECT id, item_id FROM ts WHERE source = 'a' AND item_id IN (5, 3, 1) ORDER BY item_id, id;
}
expect {
    1|1
    3|3
    4|3
    10|5
}

@setup eq_prefix
test in-list-after-eq-prefix-order-by-in-column-desc-limit {
    SELECT id, item_id FROM ts
    WHERE source = 'a' AND item_id IN (5, 3, 1)
    ORDER BY item_id DESC, id
    LIMIT 2;
}
expect {
    10|5
    3|3
}

@setup eq_prefix
test in-list-after-eq-prefix-order-by-in-column-limit-one {
    SELECT id, item_id FROM ts WHERE source = 'a' AND item_id IN (5, 3, 1) ORDER BY item_id LIMIT 1;
}
expect {
    1|1
}

@setup eq_prefix
test in-list-after-eq-prefix-order-by-rowid-desc-limit {
    SELECT id, item_id FROM ts WHERE source = 'a' AND item_id IN (5, 3, 1) ORDER BY id DESC LIMIT 2;
}
expect {
    10|5
    4|3
}

setup eq_prefix_left_join {
    CREATE TABLE tl (k TEXT, v INTEGER);
    INSERT INTO tl VALUES('a', 1);
    INSERT INTO tl VALUES('a', 2);
    INSERT INTO tl VALUES('b', 3);
    INSERT INTO tl VALUES('z', 1);
    INSERT INTO tl VALUES(NULL, 9);
}

# The prefix value comes from the outer table. A row without a match, or with a
# NULL prefix value, still produces its NULL-extended row.
@setup eq_prefix
@setup eq_prefix_left_join
test in-list-after-eq-prefix-left-join-on {
    SELECT tl.k, tl.v, ts.id
    FROM tl LEFT JOIN ts ON ts.source = tl.k AND ts.item_id IN (1, 3)
    ORDER BY tl.k, tl.v, ts.id;
}
expect {
    |9|
    a|1|1
    a|1|3
    a|1|4
    a|2|1
    a|2|3
    a|2|4
    b|3|6
    z|1|
}

# A NULL outer key ends the IN loop before its first value, so the
# NULL-extended row does not resume it at a later value.
@setup eq_prefix
@setup eq_prefix_left_join
test in-list-after-eq-prefix-left-join-on-null-key {
    INSERT INTO ts VALUES(11, NULL, 3);
    SELECT tl.k, tl.v, ts.id
    FROM tl LEFT JOIN ts ON ts.source = tl.k AND ts.item_id IN (1, 3)
    WHERE tl.k IS NULL;
}
expect {
    |9|
}

# A WHERE term on the right table also filters the NULL-extended rows.
@setup eq_prefix
@setup eq_prefix_left_join
test in-list-after-eq-prefix-left-join-where {
    SELECT tl.k, tl.v, ts.id
    FROM tl LEFT JOIN ts ON ts.source = tl.k
    WHERE ts.item_id IN (1, 3)
    ORDER BY tl.k, tl.v, ts.id;
}
expect {
    a|1|1
    a|1|3
    a|1|4
    a|2|1
    a|2|3
    a|2|4
    b|3|6
}

@setup eq_prefix
@setup eq_prefix_left_join
test in-list-after-eq-prefix-inner-join {
    SELECT tl.v, ts.id
    FROM tl JOIN ts ON ts.source = tl.k
    WHERE ts.item_id IN (2, 5)
    ORDER BY tl.v, ts.id;
}
expect {
    1|2
    1|10
    2|2
    2|10
    3|7
}

@setup eq_prefix
test in-list-after-eq-prefix-delete {
    DELETE FROM ts WHERE source = 'a' AND item_id IN (1, 3, 99);
    SELECT id FROM ts ORDER BY id;
}
expect {
    2
    5
    6
    7
    8
    9
    10
}

# The UPDATE moves each row to a value that is also in the IN list. Every row
# must be updated once.
@setup eq_prefix
test in-list-after-eq-prefix-update-in-column {
    UPDATE ts SET item_id = item_id + 1 WHERE source = 'a' AND item_id IN (1, 2, 3);
    SELECT id, item_id FROM ts WHERE source = 'a' ORDER BY id;
}
expect {
    1|2
    2|3
    3|4
    4|4
    5|
    10|5
}

@setup eq_prefix
test in-list-after-eq-prefix-update-prefix-column {
    UPDATE ts SET source = 'c' WHERE source = 'a' AND item_id IN (2, 5);
    SELECT id, source FROM ts WHERE source = 'c' ORDER BY id;
}
expect {
    2|c
    10|c
}

setup eq_prefix_desc {
    CREATE TABLE td2 (
        id INTEGER PRIMARY KEY,
        source TEXT,
        item_id INTEGER
    );
    CREATE INDEX idx_td2 ON td2(source, item_id DESC);
    INSERT INTO td2 VALUES(1, 'a', 1);
    INSERT INTO td2 VALUES(2, 'a', 2);
    INSERT INTO td2 VALUES(3, 'a', 3);
    INSERT INTO td2 VALUES(4, 'b', 2);
    INSERT INTO td2 VALUES(5, 'a', 3);
}

@setup eq_prefix_desc
test in-list-after-eq-prefix-desc-index-column {
    SELECT id FROM td2 WHERE source = 'a' AND item_id IN (3, 1, 9) ORDER BY id;
}
expect {
    1
    3
    5
}

@setup eq_prefix_desc
test in-list-after-eq-prefix-desc-index-column-delete {
    DELETE FROM td2 WHERE source = 'a' AND item_id IN (3, 9);
    SELECT id FROM td2 ORDER BY id;
}
expect {
    1
    2
    4
}

setup eq_prefix_nocase {
    CREATE TABLE tcol (
        id INTEGER PRIMARY KEY,
        source TEXT COLLATE NOCASE,
        name TEXT COLLATE NOCASE
    );
    CREATE INDEX idx_tcol ON tcol(source, name);
    INSERT INTO tcol VALUES(1, 'a', 'x');
    INSERT INTO tcol VALUES(2, 'A', 'X');
    INSERT INTO tcol VALUES(3, 'a', 'y');
    INSERT INTO tcol VALUES(4, 'b', 'x');
    INSERT INTO tcol VALUES(5, 'A', 'z');
}

# The prefix and the IN column compare with the NOCASE collation of the index.
@setup eq_prefix_nocase
test in-list-after-eq-prefix-nocase {
    SELECT id FROM tcol WHERE source = 'A' AND name IN ('x', 'X', 'Y') ORDER BY id;
}
expect {
    1
    2
    3
}

# A BINARY comparison on the prefix cannot use the NOCASE index column.
@setup eq_prefix_nocase
test in-list-after-eq-prefix-collation-mismatch-on-prefix {
    SELECT id FROM tcol WHERE source = 'A' COLLATE BINARY AND name IN ('x', 'X', 'Y') ORDER BY id;
}
expect {
    2
}

@setup eq_prefix_nocase
test in-list-after-eq-prefix-collation-mismatch-on-in-column {
    SELECT id FROM tcol WHERE source = 'a' AND name COLLATE BINARY IN ('x', 'y') ORDER BY id;
}
expect {
    1
    3
}

# The prefix gets the affinity of its column: 1 becomes '1' for a TEXT column.
setup eq_prefix_affinity {
    CREATE TABLE taf (
        id INTEGER PRIMARY KEY,
        src TEXT,
        item INTEGER
    );
    CREATE INDEX idx_taf ON taf(src, item);
    INSERT INTO taf VALUES(1, '1', 10);
    INSERT INTO taf VALUES(2, '1', 20);
    INSERT INTO taf VALUES(3, '2', 10);
    INSERT INTO taf VALUES(4, '01', 10);
}

@setup eq_prefix_affinity
test in-list-after-eq-prefix-prefix-affinity {
    SELECT id FROM taf WHERE src = 1 AND item IN (10, 30) ORDER BY id;
}
expect {
    1
}

@setup eq_prefix_affinity
test in-list-after-eq-prefix-in-column-affinity {
    SELECT id FROM taf WHERE src = '1' AND item IN ('20', 10.0) ORDER BY id;
}
expect {
    1
    2
}

# More than two index columns: the IN is on the column after the equalities;
# a column after the IN stays a filter.
setup eq_prefix_three_columns {
    CREATE TABLE t3c (
        id INTEGER PRIMARY KEY,
        a INTEGER,
        b INTEGER,
        c INTEGER
    );
    CREATE INDEX idx_t3c ON t3c(a, b, c);
    INSERT INTO t3c VALUES(1, 1, 1, 5);
    INSERT INTO t3c VALUES(2, 1, 2, 5);
    INSERT INTO t3c VALUES(3, 1, 2, 6);
    INSERT INTO t3c VALUES(4, 1, 2, 7);
    INSERT INTO t3c VALUES(5, 1, 3, 5);
    INSERT INTO t3c VALUES(6, 2, 2, 5);
}

@setup eq_prefix_three_columns
test in-list-after-two-eq-prefix-columns {
    SELECT id FROM t3c WHERE a = 1 AND b = 2 AND c IN (5, 6) ORDER BY id;
}
expect {
    2
    3
}

@setup eq_prefix_three_columns
test in-list-before-an-eq-column {
    SELECT id FROM t3c WHERE a = 1 AND b IN (2, 3) AND c = 5 ORDER BY id;
}
expect {
    2
    5
}

@setup eq_prefix_three_columns
test in-list-after-eq-prefix-with-range-on-in-column {
    SELECT id FROM t3c WHERE a = 1 AND b IN (2, 3) AND b > 2 ORDER BY id;
}
expect {
    5
}

# IN on the second column of a composite PRIMARY KEY after an equality on the first
setup composite_pk {
    CREATE TABLE cpk (a TEXT, b TEXT, v INTEGER, PRIMARY KEY (a, b));
    INSERT INTO cpk VALUES('x', '1', 10);
    INSERT INTO cpk VALUES('x', '2', 20);
    INSERT INTO cpk VALUES('x', '3', 30);
    INSERT INTO cpk VALUES('x', '4', 40);
    INSERT INTO cpk VALUES('y', '1', 50);
    INSERT INTO cpk VALUES('y', '2', 60);
}

@setup composite_pk
test composite-pk-eq-then-in {
    SELECT v FROM cpk WHERE a = 'x' AND b IN ('1', '3', '9') ORDER BY v;
}
expect {
    10
    30
}

# Duplicate and NULL values in the IN list return each row once
@setup composite_pk
test composite-pk-eq-then-in-duplicates-and-null {
    SELECT v FROM cpk WHERE a = 'y' AND b IN ('2', NULL, '2', '1', '1') ORDER BY v;
}
expect {
    50
    60
}

# A NULL prefix value matches nothing
@setup composite_pk
test composite-pk-null-prefix-then-in {
    SELECT v FROM cpk WHERE a = NULL AND b IN ('1', '2');
}
expect {
}
