@database :memory:

# Comparisons of REAL and INTEGER values that are not constants: REAL
# columns, INTEGER columns and arithmetic results, with all six operators.
# The values include -0.0, NULL and integers that a REAL cannot hold exactly.

test compare-real-column-with-integer-constant {
    CREATE TABLE r(id INTEGER PRIMARY KEY, x REAL, n INTEGER);
    INSERT INTO r VALUES (1, 1.5, 1), (2, 2.0, 2), (3, -0.0, 0),
        (4, 9007199254740992.0, 9007199254740993), (5, 3, 3), (6, NULL, NULL),
        (7, -2.5, -3);
    SELECT id, x < 2, x <= 2, x > 2, x >= 2, x = 2, x != 2 FROM r ORDER BY id;
}
expect {
    1|1|1|0|0|0|1
    2|0|1|0|1|1|0
    3|1|1|0|0|0|1
    4|0|0|1|1|0|1
    5|0|0|1|1|0|1
    6||||||
    7|1|1|0|0|0|1
}

test compare-real-column-with-integer-column {
    CREATE TABLE r(id INTEGER PRIMARY KEY, x REAL, n INTEGER);
    INSERT INTO r VALUES (1, 1.5, 1), (2, 2.0, 2), (3, -0.0, 0),
        (4, 9007199254740992.0, 9007199254740993), (5, 3, 3), (6, NULL, NULL),
        (7, -2.5, -3);
    SELECT id, x = n, x < n, x > n, n <= x, n >= x, n != x FROM r ORDER BY id;
}
expect {
    1|0|0|1|1|0|1
    2|1|0|0|1|1|0
    3|1|0|0|1|1|0
    4|0|1|0|0|1|1
    5|1|0|0|1|1|0
    6||||||
    7|0|0|1|1|0|1
}

test compare-integer-column-with-real-constant {
    CREATE TABLE r(id INTEGER PRIMARY KEY, x REAL, n INTEGER);
    INSERT INTO r VALUES (1, 1.5, 1), (2, 2.0, 2), (3, -0.0, 0),
        (4, 9007199254740992.0, 9007199254740993), (5, 3, 3), (6, NULL, NULL),
        (7, -2.5, -3);
    SELECT id, n < 2.5, n = 3.0, x = 0, x < 0, x > -0.0 FROM r ORDER BY id;
}
expect {
    1|1|0|0|0|1
    2|1|0|0|0|1
    3|1|0|1|0|0
    4|0|0|0|0|1
    5|0|1|0|0|1
    6|||||
    7|1|0|0|1|0
}

test compare-real-and-integer-in-where {
    CREATE TABLE r(id INTEGER PRIMARY KEY, x REAL, n INTEGER);
    INSERT INTO r VALUES (1, 1.5, 1), (2, 2.0, 2), (3, -0.0, 0),
        (4, 9007199254740992.0, 9007199254740993), (5, 3, 3), (6, NULL, NULL),
        (7, -2.5, -3);
    SELECT id FROM r WHERE x >= 1.5 AND x <= 3 ORDER BY id;
    SELECT id FROM r WHERE x > 9007199254740991 ORDER BY id;
    SELECT id FROM r WHERE n > 9007199254740992.0 ORDER BY id;
    SELECT id FROM r WHERE x / 2 < n ORDER BY id;
    SELECT count(*) FROM r WHERE x IS NOT 2;
}
expect {
    1
    2
    5
    4
    4
    1
    2
    4
    5
    6
}
