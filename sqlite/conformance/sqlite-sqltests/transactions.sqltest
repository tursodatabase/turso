@database :memory:

test basic-tx-1 {
    BEGIN IMMEDIATE; END
}
expect {
}

test basic-tx-2 {
    BEGIN EXCLUSIVE; END
}
expect {
}

test basic-tx-3 {
    BEGIN DEFERRED; END
}
expect {
}

test temp-table-in-immediate-tx {
    BEGIN IMMEDIATE;
    CREATE TEMP TABLE t1(x);
    INSERT INTO t1 VALUES(1),(2),(3);
    SELECT * FROM t1;
    COMMIT;
}
expect {
    1
    2
    3
}

test temp-table-persists-after-immediate-tx {
    BEGIN IMMEDIATE;
    CREATE TEMP TABLE t2(a, b);
    INSERT INTO t2 VALUES('hello', 'world');
    COMMIT;
    SELECT * FROM t2;
}
expect {
    hello|world
}

test temp-table-in-exclusive-tx {
    BEGIN EXCLUSIVE;
    CREATE TEMP TABLE t3(v TEXT);
    INSERT INTO t3 VALUES('a'),('b'),('c');
    SELECT * FROM t3;
    COMMIT;
}
expect {
    a
    b
    c
}

test temp-table-in-deferred-tx {
    BEGIN DEFERRED;
    CREATE TEMP TABLE t4(n INTEGER);
    INSERT INTO t4 VALUES(10),(20),(30);
    SELECT SUM(n) FROM t4;
    COMMIT;
}
expect {
    60
}

test temp-and-main-table-in-immediate-tx {
    CREATE TABLE main_t(id INTEGER PRIMARY KEY);
    BEGIN IMMEDIATE;
    INSERT INTO main_t VALUES(1),(2);
    CREATE TEMP TABLE temp_t(id INTEGER PRIMARY KEY);
    INSERT INTO temp_t VALUES(10),(20);
    SELECT m.id, t.id FROM main_t m, temp_t t ORDER BY m.id, t.id;
    COMMIT;
}
expect {
    1|10
    1|20
    2|10
    2|20
}

test temp-table-insert-rollback {
    CREATE TEMP TABLE t_rb(x);
    INSERT INTO t_rb VALUES(1);
    BEGIN IMMEDIATE;
    INSERT INTO t_rb VALUES(2),(3);
    ROLLBACK;
    SELECT * FROM t_rb;
}
expect {
    1
}

test temp-table-two-inserts-in-immediate-tx-are-both-rolled-back {
    CREATE TEMP TABLE t(x);
    BEGIN IMMEDIATE;
    INSERT INTO temp.t VALUES (1);
    INSERT INTO temp.t VALUES (2);
    SELECT group_concat(x) FROM temp.t;
    ROLLBACK;
    SELECT count(*) FROM temp.t;
}
expect {
    1,2
    0
}

test begin-immediate-and-exclusive-do-not-open-temp-database {
    CREATE TABLE t(x);
    BEGIN IMMEDIATE;
    INSERT INTO t VALUES(1);
    COMMIT;
    BEGIN EXCLUSIVE;
    INSERT INTO t VALUES(1);
    COMMIT;
    SELECT name FROM pragma_database_list;
}
expect {
    main
}

test temp-table-created-in-immediate-tx-is-rolled-back {
    CREATE TABLE t(x);
    BEGIN IMMEDIATE;
    CREATE TEMP TABLE tt(x);
    INSERT INTO tt VALUES(1);
    INSERT INTO t VALUES(1);
    ROLLBACK;
    SELECT
        (SELECT count(*) FROM temp.sqlite_schema WHERE name = 'tt'),
        (SELECT count(*) FROM t);
}
expect {
    0|0
}

test temp-table-created-in-immediate-tx-then-later-tx-is-rolled-back {
    BEGIN IMMEDIATE;
    CREATE TEMP TABLE tt(x);
    INSERT INTO tt VALUES(1);
    COMMIT;
    BEGIN IMMEDIATE;
    INSERT INTO tt VALUES(2);
    ROLLBACK;
    SELECT x FROM tt;
}
expect {
    1
}

test temp-store-can-change-in-immediate-tx-that-has-not-used-temp {
    BEGIN IMMEDIATE;
    PRAGMA temp_store = MEMORY;
    COMMIT;
    PRAGMA temp_store;
}
expect {
    2
}

test temp-page-count-is-zero-in-immediate-tx-that-has-not-used-temp {
    BEGIN IMMEDIATE;
    PRAGMA temp.page_count;
    COMMIT;
}
expect {
    0
}

test temp-wal-checkpoint-after-immediate-tx-that-has-not-used-temp {
    BEGIN IMMEDIATE;
    COMMIT;
    PRAGMA temp.wal_checkpoint;
}
expect {
    0|-1|-1
}

@requires trigger "needs triggers"
test immediate-tx-rollback-undoes-temp-trigger-writes-from-main-insert {
    CREATE TABLE m(x);
    CREATE TEMP TABLE log(x);
    CREATE TEMP TRIGGER tr AFTER INSERT ON m BEGIN INSERT INTO log VALUES (new.x); END;
    BEGIN IMMEDIATE;
    INSERT INTO m VALUES (1);
    SELECT (SELECT count(*) FROM m), (SELECT count(*) FROM log);
    ROLLBACK;
    SELECT (SELECT count(*) FROM m), (SELECT count(*) FROM log);
}
expect {
    1|1
    0|0
}

test immediate-tx-rollback-undoes-temp-user-version {
    CREATE TEMP TABLE t(x);
    BEGIN IMMEDIATE;
    PRAGMA temp.user_version = 5;
    PRAGMA temp.user_version;
    ROLLBACK;
    PRAGMA temp.user_version;
}
expect {
    5
    0
}

test immediate-tx-rollback-restores-dropped-temp-table-and-index {
    CREATE TEMP TABLE t(x);
    INSERT INTO t VALUES (1);
    CREATE INDEX temp.ti ON t(x);
    BEGIN IMMEDIATE;
    DROP TABLE t;
    ROLLBACK;
    SELECT x FROM t;
    SELECT name FROM temp.sqlite_schema WHERE name IN ('t', 'ti') ORDER BY name;
    PRAGMA temp.integrity_check;
}
expect {
    1
    t
    ti
    ok
}

test immediate-tx-rollback-restores-temp-autoincrement-counter {
    CREATE TEMP TABLE t(id INTEGER PRIMARY KEY AUTOINCREMENT, x);
    INSERT INTO t(x) VALUES ('a');
    BEGIN IMMEDIATE;
    INSERT INTO t(x) VALUES ('b');
    ROLLBACK;
    INSERT INTO t(x) VALUES ('c');
    SELECT id, x FROM t;
}
expect {
    1|a
    2|c
}

test immediate-tx-savepoints-cover-temp-table-first-written-after-them {
    CREATE TABLE m(x);
    CREATE TEMP TABLE t(x);
    BEGIN IMMEDIATE;
    SAVEPOINT a;
    INSERT INTO m VALUES (10);
    SAVEPOINT b;
    INSERT INTO t VALUES (1);
    RELEASE b;
    SAVEPOINT c;
    INSERT INTO t VALUES (2);
    ROLLBACK TO a;
    INSERT INTO t VALUES (3);
    COMMIT;
    SELECT (SELECT group_concat(x) FROM t), (SELECT count(*) FROM m);
}
expect {
    3|0
}

test immediate-tx-savepoint-covers-temp-table-first-read-after-it {
    CREATE TEMP TABLE t(x);
    BEGIN IMMEDIATE;
    SAVEPOINT a;
    SELECT count(*) FROM t;
    SAVEPOINT b;
    INSERT INTO t VALUES (1);
    ROLLBACK TO a;
    INSERT INTO t VALUES (2);
    COMMIT;
    SELECT group_concat(x) FROM t;
}
expect {
    0
    2
}

test exclusive-tx-read-then-write-temp-table-then-rollback {
    CREATE TEMP TABLE t(x);
    INSERT INTO t VALUES (1);
    BEGIN EXCLUSIVE;
    SELECT group_concat(x) FROM t;
    INSERT INTO t VALUES (2);
    UPDATE t SET x = x * 10;
    DELETE FROM t WHERE x = 10;
    SELECT group_concat(x) FROM t;
    ROLLBACK;
    SELECT group_concat(x) FROM t;
}
expect {
    1
    20
    1
}

test immediate-tx-temp-table-created-after-savepoint-is-removed-by-rollback-to {
    BEGIN IMMEDIATE;
    SAVEPOINT sp;
    CREATE TEMP TABLE t(x);
    INSERT INTO t VALUES (1);
    ROLLBACK TO sp;
    CREATE TEMP TABLE t2(y);
    INSERT INTO t2 VALUES (2);
    RELEASE sp;
    COMMIT;
    SELECT y FROM t2;
    SELECT name FROM temp.sqlite_schema WHERE type = 'table' ORDER BY name;
    PRAGMA temp.integrity_check;
}
expect {
    2
    t2
    ok
}

