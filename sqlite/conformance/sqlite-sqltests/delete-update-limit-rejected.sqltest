@database :memory:

# LIMIT and ORDER BY on DELETE and UPDATE are only valid in SQLite builds
# compiled with SQLITE_ENABLE_UPDATE_DELETE_LIMIT. Turso matches the default
# build and rejects them with a parse error. See issue #6076.

setup schema {
    CREATE TABLE t(id INTEGER PRIMARY KEY, x);
    INSERT INTO t VALUES (1, 'a'), (2, 'b'), (3, 'c');
}

@setup schema
test delete-limit-rejected {
    DELETE FROM t LIMIT 1;
}
expect error {
    near "LIMIT": syntax error
}

@setup schema
test delete-limit-offset-rejected {
    DELETE FROM t LIMIT 1 OFFSET 2;
}
expect error {
    near "LIMIT": syntax error
}

@setup schema
test delete-where-limit-rejected {
    DELETE FROM t WHERE id > 1 LIMIT 1;
}
expect error {
    near "LIMIT": syntax error
}

@setup schema
test delete-order-by-limit-rejected {
    DELETE FROM t ORDER BY id LIMIT 1;
}
expect error {
    near "ORDER": syntax error
}

@setup schema
test update-limit-rejected {
    UPDATE t SET x = 'z' LIMIT 1;
}
expect error {
    near "LIMIT": syntax error
}

@setup schema
test update-limit-offset-rejected {
    UPDATE t SET x = 'z' LIMIT 1 OFFSET 2;
}
expect error {
    near "LIMIT": syntax error
}

@setup schema
test update-where-limit-rejected {
    UPDATE t SET x = 'z' WHERE id > 1 LIMIT 1;
}
expect error {
    near "LIMIT": syntax error
}

@setup schema
test update-order-by-limit-rejected {
    UPDATE t SET x = 'z' ORDER BY id LIMIT 1;
}
expect error {
    near "ORDER": syntax error
}
