    CREATE INDEX t2k ON t2(k);
    INSERT INTO t1 VALUES (1,2);
    INSERT INTO t2 VALUES (1,2),(2,2);
    SELECT t1.id, t2.id FROM t1 JOIN t2 ON t1.k = t2.k ORDER BY t1.id, t2.id;
}
expect {
    1|1
    1|2
}

