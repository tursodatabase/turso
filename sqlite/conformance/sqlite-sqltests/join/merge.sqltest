    7|b7
    3|b3
    2|b2
}

test merge-order-by-unrelated-column {
    CREATE TABLE t1(id INTEGER PRIMARY KEY, a TEXT);
    CREATE TABLE t2(id INTEGER PRIMARY KEY, b TEXT);
    INSERT INTO t1 VALUES (1,'a1'),(2,'a2'),(3,'a3'),(5,'a5'),(7,'a7'),(8,'a8'),(10,'a10'),(12,'a12');
    INSERT INTO t2 VALUES (2,'b2'),(3,'b3'),(4,'b4'),(7,'b7'),(9,'b9'),(10,'b10'),(11,'b11'),(13,'b13');
    SELECT t1.id, t1.a, t2.b FROM t1 JOIN t2 ON t1.id = t2.id ORDER BY t2.b DESC;
}
expect {
    7|a7|b7
    3|a3|b3
    2|a2|b2
    10|a10|b10
}

