test merge-self-join-mgr-to-pk {
    CREATE TABLE emp(id INTEGER PRIMARY KEY, mgr INTEGER, name TEXT);
    CREATE INDEX empmgr ON emp(mgr);
    INSERT INTO emp VALUES (1,NULL,'root'),(2,1,'a'),(3,1,'b'),(4,2,'c'),(5,2,'d'),(6,3,'e');
    SELECT e.name, m.name FROM emp e JOIN emp m ON e.mgr = m.id ORDER BY e.id;
}
expect {
    a|root
    b|root
    c|a
    d|a
    e|b
}

test merge-self-join-same-indexed-col {
    CREATE TABLE emp(id INTEGER PRIMARY KEY, mgr INTEGER, name TEXT);
    CREATE INDEX empmgr ON emp(mgr);
    INSERT INTO emp VALUES (1,NULL,'root'),(2,1,'a'),(3,1,'b'),(4,2,'c'),(5,2,'d'),(6,3,'e');
    SELECT x.id, y.id FROM emp x JOIN emp y ON x.mgr = y.mgr AND x.id < y.id ORDER BY x.id, y.id;
}
expect {
    2|3
    4|5
}

test merge-inner-residual-filter {
    CREATE TABLE t1(id INTEGER PRIMARY KEY, k INTEGER, v TEXT);
    CREATE TABLE t2(id INTEGER PRIMARY KEY, k INTEGER, w TEXT);
    CREATE INDEX t1k ON t1(k);
    CREATE INDEX t2k ON t2(k);
    INSERT INTO t1 VALUES (1,5,'L1'),(2,5,'L2'),(3,5,'L3'),(4,2,'L4'),(5,2,'L5'),(6,9,'L6'),(7,NULL,'L7');
    INSERT INTO t2 VALUES (1,5,'R1'),(2,5,'R2'),(3,2,'R3'),(4,2,'R4'),(5,2,'R5'),(6,7,'R6'),(7,NULL,'R7');
    SELECT t1.k, t1.v, t2.w FROM t1 JOIN t2 ON t1.k = t2.k WHERE t2.id > 1 AND t2.w <> 'R4' ORDER BY t1.k, t1.v, t2.w;
}
expect {
    2|L4|R3
    2|L4|R5
    2|L5|R3
    2|L5|R5
    5|L1|R2
    5|L2|R2
    5|L3|R2
}

test merge-both-sides-filtered {
    CREATE TABLE t1(id INTEGER PRIMARY KEY, k INTEGER, v TEXT);
    CREATE TABLE t2(id INTEGER PRIMARY KEY, k INTEGER, w TEXT);
    CREATE INDEX t1k ON t1(k);
    CREATE INDEX t2k ON t2(k);
    INSERT INTO t1 VALUES (1,5,'L1'),(2,5,'L2'),(3,5,'L3'),(4,2,'L4'),(5,2,'L5'),(6,9,'L6'),(7,NULL,'L7');
    INSERT INTO t2 VALUES (1,5,'R1'),(2,5,'R2'),(3,2,'R3'),(4,2,'R4'),(5,2,'R5'),(6,7,'R6'),(7,NULL,'R7');
    SELECT t1.k, t1.v, t2.w FROM t1 JOIN t2 ON t1.k = t2.k WHERE t1.v <> 'L2' AND t2.id < 5 ORDER BY t1.k, t1.v, t2.w;
}
expect {
    2|L4|R3
    2|L4|R4
    2|L5|R3
    2|L5|R4
    5|L1|R1
    5|L1|R2
    5|L3|R1
    5|L3|R2
}

test merge-groupby-join-key {
    CREATE TABLE t1(id INTEGER PRIMARY KEY, k INTEGER, v TEXT);
    CREATE TABLE t2(id INTEGER PRIMARY KEY, k INTEGER, w TEXT);
    CREATE INDEX t1k ON t1(k);
    CREATE INDEX t2k ON t2(k);
    INSERT INTO t1 VALUES (1,5,'L1'),(2,5,'L2'),(3,5,'L3'),(4,2,'L4'),(5,2,'L5'),(6,9,'L6'),(7,NULL,'L7');
    INSERT INTO t2 VALUES (1,5,'R1'),(2,5,'R2'),(3,2,'R3'),(4,2,'R4'),(5,2,'R5'),(6,7,'R6'),(7,NULL,'R7');
    SELECT t1.k, count(*), sum(t2.id) FROM t1 JOIN t2 ON t1.k = t2.k GROUP BY t1.k ORDER BY t1.k;
}
expect {
    2|6|24
    5|6|9
}

test merge-composite-pk-prefix-dups {
    CREATE TABLE pairs(a INTEGER, b INTEGER, v TEXT, PRIMARY KEY(a, b));
    CREATE TABLE singles(a INTEGER PRIMARY KEY, s TEXT);
    INSERT INTO pairs VALUES (1,1,'p11'),(1,2,'p12'),(2,1,'p21'),(3,1,'p31'),(3,2,'p32'),(3,3,'p33'),(5,1,'p51');
    INSERT INTO singles VALUES (1,'s1'),(2,'s2'),(3,'s3'),(4,'s4');
    CREATE TABLE pairs2(a INTEGER, b INTEGER, w TEXT, PRIMARY KEY(a, b));
    INSERT INTO pairs2 VALUES (1,2,'q12'),(2,1,'q21'),(3,2,'q32'),(3,3,'q33'),(4,1,'q41');
    SELECT p.a, p.b, q.b FROM pairs p JOIN pairs2 q ON p.a = q.a ORDER BY p.a, p.b, q.b;
}
expect {
    1|1|2
    1|2|2
    2|1|1
    3|1|2
    3|1|3
    3|2|2
    3|2|3
    3|3|2
    3|3|3
}

test merge-real-vs-int-keys-reversed {
    CREATE TABLE ints(id INTEGER PRIMARY KEY, tag TEXT);
    CREATE TABLE reals(r REAL, note TEXT);
    CREATE INDEX realsr ON reals(r);
    INSERT INTO ints VALUES (1,'i1'),(2,'i2'),(3,'i3'),(4,'i4'),(5,'i5');
    INSERT INTO reals VALUES (1.0,'r1'),(2.5,'r2'),(3.0,'r3'),(3.5,'r4'),(5.0,'r5'),(6.0,'r6');
    SELECT reals.r, reals.note, ints.tag FROM reals JOIN ints ON reals.r = ints.id ORDER BY reals.r;
}
expect {
    1.0|r1|i1
    3.0|r3|i3
    5.0|r5|i5
}
expect @js {
    1|r1|i1
    3|r3|i3
    5|r5|i5
}

test merge-dup-key-at-end-of-inner-index {
