test merge-big-pk-pk-checksum {
    CREATE TABLE t1(id INTEGER PRIMARY KEY, a INTEGER);
    CREATE TABLE t2(id INTEGER PRIMARY KEY, b INTEGER);
    WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM c WHERE x < 500) INSERT INTO t1 SELECT x, x*2 FROM c;
    WITH RECURSIVE c(x) AS (SELECT 3 UNION ALL SELECT x+1 FROM c WHERE x < 502) INSERT INTO t2 SELECT x, x*3 FROM c;
    SELECT count(*), sum(t1.a), sum(t2.b) FROM t1 JOIN t2 ON t1.id = t2.id;
}
expect {
    498|250494|375741
}

test merge-big-dup-keys-checksum {
    CREATE TABLE t1(id INTEGER PRIMARY KEY, k INTEGER, v TEXT);
    CREATE TABLE t2(id INTEGER PRIMARY KEY, k INTEGER, w TEXT);
    CREATE INDEX t1k ON t1(k);
    CREATE INDEX t2k ON t2(k);
    WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM c WHERE x < 500) INSERT INTO t1 SELECT x, x % 50, 'L' || x FROM c;
    WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM c WHERE x < 500) INSERT INTO t2 SELECT x, x % 50, 'R' || x FROM c;
    SELECT count(*), sum(t1.k), sum(t2.id) FROM t1 JOIN t2 ON t1.k = t2.k;
}
expect {
    5000|122500|1252500
}

test merge-big-three-way-checksum {
    CREATE TABLE customer(c_id INTEGER PRIMARY KEY, name TEXT);
    CREATE TABLE orders(o_id INTEGER PRIMARY KEY, custkey INTEGER);
    CREATE TABLE lineitem(orderkey INTEGER, linenum INTEGER, qty INTEGER, PRIMARY KEY(orderkey, linenum));
    WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM c WHERE x < 100) INSERT INTO customer SELECT x, 'c' || x FROM c;
    WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM c WHERE x < 400) INSERT INTO orders SELECT x, (x % 100) + 1 FROM c;
    WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM c WHERE x < 800) INSERT INTO lineitem SELECT (x + 1) / 2, ((x + 1) % 2) + 1, x FROM c;
    SELECT count(*), sum(l.qty), sum(cu.c_id) FROM orders o JOIN lineitem l ON o.o_id = l.orderkey JOIN customer cu ON o.custkey = cu.c_id;
}
expect {
    800|320400|40400
}

test merge-big-three-way-filtered {
    CREATE TABLE customer(c_id INTEGER PRIMARY KEY, name TEXT);
    CREATE TABLE orders(o_id INTEGER PRIMARY KEY, custkey INTEGER);
    CREATE TABLE lineitem(orderkey INTEGER, linenum INTEGER, qty INTEGER, PRIMARY KEY(orderkey, linenum));
    WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM c WHERE x < 100) INSERT INTO customer SELECT x, 'c' || x FROM c;
    WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM c WHERE x < 400) INSERT INTO orders SELECT x, (x % 100) + 1 FROM c;
    WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM c WHERE x < 800) INSERT INTO lineitem SELECT (x + 1) / 2, ((x + 1) % 2) + 1, x FROM c;
    SELECT count(*), sum(l.qty) FROM orders o JOIN lineitem l ON o.o_id = l.orderkey JOIN customer cu ON o.custkey = cu.c_id WHERE cu.c_id <= 10 AND l.qty > 100;
}
expect {
    62|26109
}

@skip-if sqlite "query plan explanation output is different in sqlite"
test merge-plan-pk-pk {
    CREATE TABLE t1(id INTEGER PRIMARY KEY, a INTEGER);
    CREATE TABLE t2(id INTEGER PRIMARY KEY, b INTEGER);
    WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM c WHERE x < 500) INSERT INTO t1 SELECT x, x*2 FROM c;
    WITH RECURSIVE c(x) AS (SELECT 3 UNION ALL SELECT x+1 FROM c WHERE x < 502) INSERT INTO t2 SELECT x, x*3 FROM c;
    EXPLAIN QUERY PLAN SELECT t1.a, t2.b FROM t1 JOIN t2 ON t1.id = t2.id;
}
expect {
    1|0|0|SCAN t1
    2|0|0|MERGE JOIN t2 USING INTEGER PRIMARY KEY
}

@skip-if sqlite "query plan explanation output is different in sqlite"
test merge-plan-covering-index {
    CREATE TABLE t1(id INTEGER PRIMARY KEY, k INTEGER, v TEXT);
    CREATE TABLE t2(id INTEGER PRIMARY KEY, k INTEGER, w TEXT);
    CREATE UNIQUE INDEX t1k ON t1(k);
    CREATE INDEX t2k ON t2(k);
    WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM c WHERE x < 500) INSERT INTO t1 SELECT x, x, 'L' || x FROM c;
    WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM c WHERE x < 500) INSERT INTO t2 SELECT x, x % 50, 'R' || x FROM c;
    EXPLAIN QUERY PLAN SELECT t1.k, t2.k FROM t1 JOIN t2 ON t1.k = t2.k;
}
expect {
    1|0|0|SCAN t1 USING COVERING INDEX t1k
    2|0|0|MERGE JOIN t2 USING COVERING INDEX t2k
}

