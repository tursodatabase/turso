@cross-check-integrity
test left-join-null-probe-key {
    create table t(a, b);
    create table s(a, b);
    insert into t values (1, 'x'), (null, 'y');
    insert into s values (1, 'x');
    select t.a, t.b, s.a, s.b
    from t
    left join s on t.a = s.a and t.b = s.b
    order by t.rowid;
}
