    INSERT INTO t4 (a, c) VALUES (1, 10), (3, NULL);
    SELECT * FROM t3 LEFT JOIN t4 ON t3.b = t4.c ORDER BY t3.a;
}
expect {
    1|||
    2|10.0|1|10
}
expect @js {
    1|||
    2|10|1|10
}

