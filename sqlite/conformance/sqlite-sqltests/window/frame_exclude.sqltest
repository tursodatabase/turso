@database :memory:

setup base {
    CREATE TABLE t(id INTEGER PRIMARY KEY, v INTEGER);
    INSERT INTO t VALUES (1,10),(2,10),(3,20),(4,20),(5,30);
}

@setup base
@cross-check-integrity
test exclude-current-row {
    SELECT id, sum(v) OVER (
        ORDER BY id ROWS BETWEEN 1 PRECEDING AND CURRENT ROW
        EXCLUDE CURRENT ROW
    ) FROM t;
}
expect {
    1|
    2|10
    3|10
    4|20
    5|20
}

@setup base
@cross-check-integrity
test exclude-group {
    SELECT id, sum(v) OVER (
        ORDER BY v ROWS BETWEEN 1 PRECEDING AND CURRENT ROW
        EXCLUDE GROUP
    ) FROM t;
}
expect {
    1|
    2|
    3|10
    4|
    5|20
}

@setup base
@cross-check-integrity
test exclude-ties {
    SELECT id, sum(v) OVER (
        ORDER BY v ROWS BETWEEN 1 PRECEDING AND CURRENT ROW
        EXCLUDE TIES
    ) FROM t;
}
expect {
    1|10
    2|10
    3|30
    4|20
    5|50
}

# Explicit NO OTHERS deliberately takes the same full-rescan path as the
# other EXCLUDE variants. This permits aggregates without an inverse function.
@setup base
@cross-check-integrity
test exclude-no-others {
    SELECT id,
           sum(v) OVER w,
           min(v) OVER w,
           max(v) OVER w,
           group_concat(v, '.') OVER w
    FROM t
    WINDOW w AS (
        ORDER BY id ROWS BETWEEN 1 PRECEDING AND CURRENT ROW
        EXCLUDE NO OTHERS
    );
}
expect {
    1|10|10|10|10
    2|20|10|10|10.10
    3|30|10|20|10.20
    4|40|20|20|20.20
    5|50|20|30|20.30
}

setup partitioned {
    CREATE TABLE t(
        id INTEGER PRIMARY KEY,
        p TEXT,
        k INTEGER,
        v INTEGER,
        s TEXT
    );
    INSERT INTO t VALUES
        (1,'A',10,5,'a'),
        (2,'A',10,7,'b'),
        (3,'A',20,3,'c'),
        (4,'A',20,NULL,'d'),
        (5,'A',30,11,'e'),
        (6,'B',10,2,'f'),
        (7,'B',10,4,'g'),
        (8,'B',20,6,'h');
}

@setup partitioned
@cross-check-integrity
test exclude-current-row-aggregate-and-positional {
    SELECT id,
           sum(v) OVER w,
           count(v) OVER w,
           first_value(v) OVER w,
           last_value(v) OVER w,
           nth_value(v, 1) OVER w
    FROM t
    WINDOW w AS (
        PARTITION BY p ORDER BY id
        ROWS BETWEEN 1 PRECEDING AND CURRENT ROW
        EXCLUDE CURRENT ROW
    )
    ORDER BY id;
}
expect {
    1||0|||
    2|5|1|5|5|5
    3|7|1|7|7|7
    4|3|1|3|3|3
    5||0|||
    6||0|||
    7|2|1|2|2|2
    8|4|1|4|4|4
}

@setup partitioned
@cross-check-integrity
test exclude-no-others-moving-noninvertible-aggregates {
    SELECT id,
           min(v) OVER w,
           max(v) OVER w,
           group_concat(s, '.') OVER w
    FROM t
    WINDOW w AS (
        PARTITION BY p ORDER BY id
        ROWS BETWEEN 2 PRECEDING AND CURRENT ROW
        EXCLUDE NO OTHERS
    )
    ORDER BY id;
}
expect {
    1|5|5|a
    2|5|7|a.b
    3|3|7|a.b.c
    4|3|7|b.c.d
    5|3|11|c.d.e
    6|2|2|f
    7|2|4|f.g
    8|2|6|f.g.h
}

@setup partitioned
@cross-check-integrity
test groups-exclusion-matrix {
    SELECT id,
           sum(v) OVER (
               PARTITION BY p ORDER BY k
               GROUPS BETWEEN 1 PRECEDING AND 1 FOLLOWING
               EXCLUDE CURRENT ROW
           ),
           sum(v) OVER (
               PARTITION BY p ORDER BY k
               GROUPS BETWEEN 1 PRECEDING AND 1 FOLLOWING
               EXCLUDE GROUP
           ),
           sum(v) OVER (
               PARTITION BY p ORDER BY k
               GROUPS BETWEEN 1 PRECEDING AND 1 FOLLOWING
               EXCLUDE TIES
           )
    FROM t ORDER BY id;
}
expect {
    1|10|3|8
    2|8|3|10
    3|23|23|26
    4|26|23|23
    5|3|3|14
    6|10|6|8
    7|8|6|10
    8|6|6|12
}

@setup partitioned
@cross-check-integrity
test range-offset-exclusion-matrix {
    SELECT id,
           sum(v) OVER (
               PARTITION BY p ORDER BY k
               RANGE BETWEEN 5 PRECEDING AND 10 FOLLOWING
               EXCLUDE CURRENT ROW
           ),
           sum(v) OVER (
               PARTITION BY p ORDER BY k
               RANGE BETWEEN 5 PRECEDING AND 10 FOLLOWING
               EXCLUDE GROUP
           ),
           sum(v) OVER (
               PARTITION BY p ORDER BY k
               RANGE BETWEEN 5 PRECEDING AND 10 FOLLOWING
               EXCLUDE TIES
           )
    FROM t ORDER BY id;
}
expect {
    1|10|3|8
    2|8|3|10
    3|11|11|14
    4|14|11|11
    5|||11
    6|10|6|8
    7|8|6|10
    8|||6
}

@setup partitioned
@cross-check-integrity
test exclusion-without-order-by {
    SELECT id,
           sum(v) OVER (
               PARTITION BY p
               ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
               EXCLUDE GROUP
           ),
           sum(v) OVER (
               PARTITION BY p
               ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
               EXCLUDE TIES
           )
    FROM t ORDER BY id;
}
expect {
    1||5
    2||7
    3||3
    4||
    5||11
    6||2
    7||4
    8||6
}

setup collation_and_json {
    CREATE TABLE t(
        id INTEGER PRIMARY KEY,
        p TEXT,
        k TEXT,
        v INTEGER,
        s TEXT
    );
    INSERT INTO t VALUES
        (1,'A','a',5,'x'),
        (2,'A','A',7,'y'),
        (3,'A',NULL,3,'z'),
        (4,'A',NULL,NULL,'q');
}

@setup collation_and_json
@cross-check-integrity
test exclusion-uses-order-by-collation-for-peers {
    SELECT id,
           sum(v) OVER (
               ORDER BY k COLLATE NOCASE
               ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
               EXCLUDE GROUP
           ),
           sum(v) OVER (
               ORDER BY k COLLATE NOCASE
               ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
               EXCLUDE TIES
           )
    FROM t ORDER BY id;
}
expect {
    1|3|8
    2|3|10
    3|12|15
    4|12|12
}

@setup collation_and_json
@cross-check-integrity
test exclude-current-row-json-aggregates {
    SELECT id,
           json_group_array(v) FILTER (WHERE v IS NOT NULL) OVER w,
           json_group_object(s, v) FILTER (WHERE v IS NOT NULL) OVER w
    FROM t
    WINDOW w AS (
        ORDER BY id ROWS BETWEEN 1 PRECEDING AND CURRENT ROW
        EXCLUDE CURRENT ROW
    )
    ORDER BY id;
}
expect {
    1|[]|{}
    2|[5]|{"x":5}
    3|[7]|{"y":7}
    4|[3]|{"z":3}
}

@setup collation_and_json
@cross-check-integrity
test positional-values-preserve-null-and-count-included-rows {
    SELECT id,
           first_value(v) OVER w,
           nth_value(v, 2) OVER w,
           last_value(v) OVER w
    FROM t
    WINDOW w AS (
        ORDER BY id
        ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
        EXCLUDE CURRENT ROW
    )
    ORDER BY id;
}
expect {
    1|7|3|
    2|5|3|
    3|5|7|
    4|5|7|3
}

setup empty_frame {
    CREATE TABLE t(id INTEGER PRIMARY KEY, v INTEGER);
    INSERT INTO t VALUES (1,10),(2,20),(3,30);
}

@setup empty_frame
@cross-check-integrity
test explicit-exclude-empty-frame {
    SELECT id,
           sum(v) OVER w,
           count(v) OVER w,
           first_value(v) OVER w,
           nth_value(v, 1) OVER w
    FROM t
    WINDOW w AS (
        ORDER BY id ROWS BETWEEN 1 PRECEDING AND 2 PRECEDING
        EXCLUDE NO OTHERS
    )
    ORDER BY id;
}
expect {
    1||0||
    2||0||
    3||0||
}

setup varying_n {
    CREATE TABLE t(id INTEGER PRIMARY KEY, v TEXT, n);
    INSERT INTO t VALUES (1,'a',1),(2,'b',2),(3,'c',3);
}

# During the full-frame rescan, nth_value() reads its value argument from each
# included row but keeps N fixed to the current output row.
@setup varying_n
@cross-check-integrity
test exclude-nth-value-uses-current-row-n {
    SELECT id, nth_value(v, n) OVER (
        ORDER BY id
        ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
        EXCLUDE CURRENT ROW
    )
    FROM t ORDER BY id;
}
expect {
    1|b
    2|c
    3|
}

@setup varying_n
@cross-check-integrity
test exclude-nth-value-coerces-lossless-n {
    SELECT id, nth_value(v, '2') OVER (
        ORDER BY id
        ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
        EXCLUDE NO OTHERS
    )
    FROM t ORDER BY id;
}
expect {
    1|b
    2|b
    3|b
}

@setup varying_n
test exclude-nth-value-rejects-rounded-i64-max {
    SELECT nth_value(v, 9223372036854775807.0) OVER (
        ORDER BY id
        ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
        EXCLUDE NO OTHERS
    )
    FROM t;
}
expect error {
    second argument to nth_value must be a positive integer
}

setup composite_peers {
    CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT, v INTEGER);
    INSERT INTO t VALUES
        (1,2,NULL,5),
        (2,2,NULL,7),
        (3,2,'x',3),
        (4,1,'x',11);
}

@setup composite_peers
@cross-check-integrity
test exclusion-composite-desc-nulls-last-peer-key {
    SELECT id,
           sum(v) OVER (
               ORDER BY a DESC, b COLLATE NOCASE NULLS LAST
               ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
               EXCLUDE GROUP
           ),
           sum(v) OVER (
               ORDER BY a DESC, b COLLATE NOCASE NULLS LAST
               ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
               EXCLUDE TIES
           )
    FROM t ORDER BY id;
}
expect {
    1|14|19
    2|14|21
    3|23|26
    4|15|26
}
