@database :memory:

setup multi_window_base {
    CREATE TABLE multi_window_items(g TEXT, v INTEGER);
    INSERT INTO multi_window_items VALUES
        ('a', 10),
        ('a', 20),
        ('b', 30),
        ('b', 40),
        ('c', 50);
}

# When multiple windows appear in one SELECT, each window function must see
# rows in its own window's declared order, not in the order produced by an
# adjacent window. The classic regression: an unordered `OVER ()` ending up
# in the middle of the nesting picks up the enclosing layer's ordering.

@setup multi_window_base
test three-row-number-windows-distinct-defs {
    SELECT g, v,
           row_number() OVER (PARTITION BY g ORDER BY v),
           row_number() OVER (ORDER BY v DESC),
           row_number() OVER ()
    FROM multi_window_items;
}
expect {
    a|10|1|5|1
    a|20|2|4|2
    b|30|1|3|3
    b|40|2|2|4
    c|50|1|1|5
}

@setup multi_window_base
test three-windows-aggregate-between {
    SELECT g, v,
           row_number() OVER (PARTITION BY g ORDER BY v),
           sum(v) OVER (ORDER BY v DESC),
           row_number() OVER ()
    FROM multi_window_items;
}
expect {
    a|10|1|150|1
    a|20|2|140|2
    b|30|1|120|3
    b|40|2|90|4
    c|50|1|50|5
}

# Reordering the window definitions in the SELECT list must change the
# user-visible row order: the first-declared window's PARTITION/ORDER
# defines the outermost layer, so its sort determines the output order.

@setup multi_window_base
test empty-over-first-then-ordered-then-partitioned {
    SELECT g, v,
           row_number() OVER (),
           row_number() OVER (ORDER BY v DESC),
           row_number() OVER (PARTITION BY g ORDER BY v)
    FROM multi_window_items;
}
expect {
    c|50|1|1|1
    b|40|2|2|2
    b|30|3|3|1
    a|20|4|4|2
    a|10|5|5|1
}

# A layer pushes the calls of a deeper window into its subquery as whole
# expressions and reuses one column for equivalent calls. Calls whose OVER
# clause or arguments contain a date/time function or random() keep one window
# function entry per occurrence, so the merged occurrences must not leave an
# entry behind in the deeper window.

setup multi_window_months {
    CREATE TABLE multi_window_months(d TEXT, x INTEGER);
    INSERT INTO multi_window_months VALUES
        ('2026-01-01', 1),
        ('2026-02-02', 2),
        ('2026-03-03', 3);
}

@setup multi_window_months
test repeated-lag-of-aggregate-ordered-by-strftime {
    SELECT strftime('%Y-%m', d) AS k,
           avg(sum(x)) OVER (ORDER BY strftime('%Y-%m', d)) AS running_avg,
           100.0 * (sum(x) - lag(sum(x)) OVER (ORDER BY strftime('%Y-%m', d)))
                 / lag(sum(x)) OVER (ORDER BY strftime('%Y-%m', d)) AS pct_change
    FROM multi_window_months
    GROUP BY 1;
}
expect {
    2026-01|1.0|
    2026-02|1.5|100.0
    2026-03|2.0|50.0
}
expect @js {
    2026-01|1|
    2026-02|1.5|100
    2026-03|2|50
}

@setup multi_window_months
test repeated-lag-of-aggregate-ordered-by-date {
    SELECT date(d) AS k,
           avg(sum(x)) OVER (ORDER BY date(d)) AS running_avg,
           100.0 * (sum(x) - lag(sum(x)) OVER (ORDER BY date(d)))
                 / lag(sum(x)) OVER (ORDER BY date(d)) AS pct_change
    FROM multi_window_months
    GROUP BY 1;
}
expect {
    2026-01-01|1.0|
    2026-02-02|1.5|100.0
    2026-03-03|2.0|50.0
}
expect @js {
    2026-01-01|1|
    2026-02-02|1.5|100
    2026-03-03|2|50
}

# SQLite evaluates the merged calls once, so both read the same random() value.
@setup multi_window_months
test repeated-lag-of-random-in-deeper-window {
    SELECT avg(x) OVER (ORDER BY x),
           lag(x + random()) OVER (ORDER BY x) = lag(x + random()) OVER (ORDER BY x)
    FROM multi_window_months;
}
expect {
    1.0|
    1.5|1
    2.0|1
}
expect @js {
    1|
    1.5|1
    2|1
}

@setup multi_window_months
test repeated-lead-and-sum-ordered-by-date-in-deeper-windows {
    SELECT x,
           avg(x) OVER (ORDER BY date(d)),
           lead(x * 2) OVER (ORDER BY date(d)) + lead(x * 2) OVER (ORDER BY date(d)),
           sum(x * 2) OVER (ORDER BY date(d) ROWS 1 PRECEDING)
               + sum(x * 2) OVER (ORDER BY date(d) ROWS 1 PRECEDING)
    FROM multi_window_months;
}
expect {
    1|1.0|8|4
    2|1.5|12|12
    3|2.0||20
}
expect @js {
    1|1|8|4
    2|1.5|12|12
    3|2||20
}
