@database :memory:

# A WHERE-clause `IN (SELECT ...)` on the right table of a LEFT JOIN must
# filter the join's RESULT, including its null-extended rows. When that
# column is indexed the planner used to drive the right table's loop from the
# IN list (an InSeek), which filtered the join instead: a left row with no
# match still came back, null-extended, and the term was never checked
# against it. Without the index the term was applied correctly. The join key
# is INTEGER on the left and TEXT on the right so the ON term itself cannot
# become the seek; only the IN term is a candidate.

setup tables {
    CREATE TABLE t(id INTEGER PRIMARY KEY);
    CREATE TABLE u(k TEXT);
    CREATE TABLE v(k TEXT);
    INSERT INTO t VALUES (5), (7);
    INSERT INTO u VALUES ('7');
    INSERT INTO v VALUES ('7'), ('9');
    CREATE INDEX ui ON u(k);
}

@setup tables
test left-join-in-subquery-filters-the-null-extended-row {
    SELECT group_concat(t.id) FROM t LEFT JOIN u ON t.id = u.k
    WHERE u.k IN (SELECT k FROM v);
}
expect {
    7
}

@setup tables
test left-join-in-empty-subquery-returns-no-rows {
    SELECT count(*), count(u.k) FROM t LEFT JOIN u ON t.id = u.k
    WHERE u.k IN (SELECT k FROM v WHERE k = 'a');
}
expect {
    0|0
}

@setup tables
test left-join-in-subquery-as-a-delete-filter-spares-the-unmatched-row {
    DELETE FROM t WHERE id IN (
        SELECT t.id FROM t LEFT JOIN u ON t.id = u.k
        WHERE u.k IN (SELECT k FROM v)
    );
    SELECT count(*) FROM t;
}
expect {
    1
}

@setup tables
test left-join-in-list-filters-the-null-extended-row {
    SELECT group_concat(t.id) FROM t LEFT JOIN u ON t.id = u.k
    WHERE u.k IN ('7', '9');
}
expect {
    7
}

@setup tables
test left-join-in-subquery-in-the-on-clause-still-seeks {
    -- An IN term from the join's own ON clause defines what counts as a
    -- match, so it may still drive the seek; both left rows come back.
    SELECT t.id, u.k FROM t LEFT JOIN u ON t.id = u.k AND u.k IN (SELECT k FROM v)
    ORDER BY t.id;
}
expect {
    5|
    7|7
}

@setup tables
test inner-join-in-subquery-on-indexed-column-unchanged {
    SELECT group_concat(t.id) FROM t JOIN u ON t.id = u.k
    WHERE u.k IN (SELECT k FROM v);
}
expect {
    7
}
