@database :memory:

setup schema {
    CREATE TABLE t1 (id TEXT PRIMARY KEY, val TEXT);
    CREATE TABLE t2 (id TEXT PRIMARY KEY, val TEXT);
    INSERT INTO t1 VALUES ('1','apple'),('2','banana');
    INSERT INTO t2 VALUES ('3','xenon'),('4','yam');
}

@setup schema
test union-all-no-in-subquery {
    SELECT 'A' AS dim, val FROM t1
    UNION ALL
    SELECT 'B' AS dim, val FROM t2;
}
expect {
    A|apple
    A|banana
    B|xenon
    B|yam
}

@setup schema
test union-all-where-literal {
    SELECT 'A' AS dim, val FROM t1 WHERE val = 'apple'
    UNION ALL
    SELECT 'B' AS dim, val FROM t2 WHERE val = 'xenon';
}
expect {
    A|apple
    B|xenon
}

@setup schema
test union-all-with-in-subquery-two-cols {
    SELECT 'A' AS dim, val FROM t1
    WHERE id IN (SELECT id FROM t1 WHERE val = 'apple')
    UNION ALL
    SELECT 'B' AS dim, val FROM t2
    WHERE id IN (SELECT id FROM t2 WHERE val = 'xenon');
}
expect {
    A|apple
    B|xenon
}

@setup schema
test union-all-with-in-subquery-three-cols {
    SELECT 'A' AS dim, val, 1 AS n FROM t1
    WHERE id IN (SELECT id FROM t1 WHERE val = 'apple')
    UNION ALL
    SELECT 'B' AS dim, val, 2 AS n FROM t2
    WHERE id IN (SELECT id FROM t2 WHERE val = 'xenon');
}
expect {
    A|apple|1
    B|xenon|2
}

# A row that one block skips, through WHERE or OFFSET, must not end the
# blocks after it.
test union-all-false-where-in-first-block {
    SELECT 1 WHERE 0
    UNION ALL
    SELECT 2;
}
expect {
    2
}

@setup schema
test union-all-false-where-before-table-block {
    SELECT 'none' WHERE 0
    UNION ALL
    SELECT val FROM t1;
}
expect {
    apple
    banana
}

test union-all-offset-skips-first-block {
    SELECT 1 UNION ALL SELECT 2 LIMIT 1 OFFSET 1;
}
expect {
    2
}

test union-all-offset-skips-into-later-blocks {
    SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3 LIMIT 5 OFFSET 1;
}
expect {
    2
    3
}

test union-all-offset-in-from-subquery {
    SELECT * FROM (SELECT 1 UNION ALL SELECT 2 LIMIT 1 OFFSET 1);
}
expect {
    2
}
