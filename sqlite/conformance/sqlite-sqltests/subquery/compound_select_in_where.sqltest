@database :memory:

setup fruits {
    CREATE TABLE fruit (id INTEGER PRIMARY KEY, name TEXT);
    INSERT INTO fruit VALUES (1, 'apple'), (2, 'banana'), (3, 'cherry'),
                             (4, 'date'), (5, 'elderberry');

    CREATE TABLE red_fruit (name TEXT);
    INSERT INTO red_fruit VALUES ('apple'), ('cherry');

    CREATE TABLE yellow_fruit (name TEXT);
    INSERT INTO yellow_fruit VALUES ('banana');

    CREATE TABLE tropical_fruit (name TEXT);
    INSERT INTO tropical_fruit VALUES ('banana'), ('date'), ('mango');
}

# -----------------------------------------------------------------------------
# IN subquery with UNION / UNION ALL / INTERSECT / EXCEPT
# -----------------------------------------------------------------------------

@setup fruits
test in-union {
    SELECT id, name FROM fruit
    WHERE name IN (SELECT name FROM red_fruit
                   UNION
                   SELECT name FROM yellow_fruit)
    ORDER BY id;
}
expect {
    1|apple
    2|banana
    3|cherry
}

@setup fruits
test in-union-all {
    SELECT id, name FROM fruit
    WHERE name IN (SELECT name FROM red_fruit
                   UNION ALL
                   SELECT name FROM yellow_fruit
                   UNION ALL
                   SELECT name FROM tropical_fruit)
    ORDER BY id;
}
expect {
    1|apple
    2|banana
    3|cherry
    4|date
}

@setup fruits
test in-intersect {
    SELECT id, name FROM fruit
    WHERE name IN (SELECT name FROM tropical_fruit
                   INTERSECT
                   SELECT name FROM yellow_fruit)
    ORDER BY id;
}
expect {
    2|banana
}

@setup fruits
test in-except {
    SELECT id, name FROM fruit
    WHERE name IN (SELECT name FROM tropical_fruit
                   EXCEPT
                   SELECT name FROM yellow_fruit)
    ORDER BY id;
}
expect {
    4|date
}

@setup fruits
test not-in-union {
    SELECT id, name FROM fruit
    WHERE name NOT IN (SELECT name FROM red_fruit
                       UNION
                       SELECT name FROM yellow_fruit)
    ORDER BY id;
}
expect {
    4|date
    5|elderberry
}

# -----------------------------------------------------------------------------
# Row-value IN with a compound select returning multiple columns
# -----------------------------------------------------------------------------

setup pairs {
    CREATE TABLE pair (a INTEGER, b INTEGER);
    INSERT INTO pair VALUES (1, 10), (2, 20), (3, 30), (4, 40);

    CREATE TABLE want_a (a INTEGER, b INTEGER);
    INSERT INTO want_a VALUES (1, 10), (3, 30);

    CREATE TABLE want_b (a INTEGER, b INTEGER);
    INSERT INTO want_b VALUES (2, 20);
}

@setup pairs
test row-value-in-union {
    SELECT a, b FROM pair
    WHERE (a, b) IN (SELECT a, b FROM want_a
                     UNION
                     SELECT a, b FROM want_b)
    ORDER BY a;
}
expect {
    1|10
    2|20
    3|30
}

# -----------------------------------------------------------------------------
# Compound SELECT in a WHERE IN subquery that references the outer query.
# This exercises Plan::used_outer_query_ref_ids(), which must walk every
# component SELECT of the compound to collect outer-query refs.
# -----------------------------------------------------------------------------

@setup fruits
test correlated-in-union {
    SELECT id, name FROM fruit f
    WHERE name IN (SELECT name FROM red_fruit    WHERE LENGTH(name) = LENGTH(f.name)
                   UNION
                   SELECT name FROM yellow_fruit WHERE LENGTH(name) = LENGTH(f.name))
    ORDER BY id;
}
expect {
    1|apple
    2|banana
    3|cherry
}

test scalar-limit-expressions-keep-zero-and-numeric-comparison {
    SELECT coalesce((SELECT 7 LIMIT 1 - 1), 'empty'),
           coalesce((SELECT 7 LIMIT '0'), 'empty'),
           (SELECT 7 LIMIT 2.5),
           (SELECT 7 LIMIT 'bad');
}
expect {
    empty|empty|7|7
}

test scalar-limit-null-retains-datatype-error {
    SELECT (SELECT 7 LIMIT NULL);
}
expect error {
    datatype mismatch
}

test scalar-limit-error-is-evaluated {
    SELECT (SELECT 7 LIMIT abs(-9223372036854775808));
}
expect error {
    integer overflow
}

test scalar-compound-union-all-returns-first-row {
    SELECT (SELECT 9 UNION ALL SELECT 3);
}
expect {
    9
}

test scalar-compound-skips-error-after-first-row {
    SELECT (SELECT 1 UNION ALL SELECT abs(-9223372036854775808));
}
expect {
    1
}

@setup fruits
test scalar-compound-order-and-offset {
    SELECT (SELECT name FROM red_fruit UNION ALL SELECT name FROM yellow_fruit
            ORDER BY name DESC LIMIT 5 OFFSET 1);
}
expect {
    banana
}

@setup fruits
test scalar-compound-empty-input {
    SELECT coalesce((SELECT name FROM red_fruit WHERE 0
                     UNION ALL SELECT name FROM yellow_fruit WHERE 0), 'empty');
}
expect {
    empty
}

@setup fruits
test scalar-compound-union-orders-distinct-results {
    SELECT (SELECT name FROM red_fruit UNION SELECT name FROM yellow_fruit
            ORDER BY name DESC);
}
expect {
    cherry
}

@setup fruits
test scalar-compound-intersection {
    SELECT (SELECT name FROM tropical_fruit INTERSECT SELECT name FROM yellow_fruit);
}
expect {
    banana
}

@setup fruits
test scalar-compound-except-orders-results {
    SELECT (SELECT name FROM tropical_fruit EXCEPT SELECT name FROM yellow_fruit
            ORDER BY name);
}
expect {
    date
}

@setup fruits
test scalar-compound-keeps-outer-columns {
    SELECT id, (SELECT name FROM red_fruit WHERE name = f.name
                UNION ALL SELECT name FROM yellow_fruit WHERE name = f.name)
    FROM fruit f ORDER BY id;
}
expect {
    1|apple
    2|banana
    3|cherry
    4|
    5|
}

@setup fruits
test scalar-compound-row-comparison-uses-first-row {
    SELECT id FROM fruit f
    WHERE (f.id, f.name) = (SELECT id, name FROM fruit WHERE id = 1
                          UNION ALL SELECT id, name FROM fruit WHERE id = 2)
    ORDER BY id;
}
expect {
    1
}

test scalar-compound-limit-expressions {
    SELECT coalesce((SELECT 9 UNION ALL SELECT 3 LIMIT 1 - 1), 'empty'),
           coalesce((SELECT 9 UNION ALL SELECT 3 LIMIT '0'), 'empty'),
           (SELECT 9 UNION ALL SELECT 3 LIMIT 2.5 OFFSET 1),
           (SELECT 9 UNION ALL SELECT 3 ORDER BY 1 LIMIT 'bad');
}
expect {
    empty|empty|3|3
}

test scalar-compound-limit-null-retains-datatype-error {
    SELECT (SELECT 9 UNION ALL SELECT 3 LIMIT NULL);
}
expect error {
    datatype mismatch
}

test scalar-compound-retains-types-and-comparison-affinity {
    SELECT typeof((SELECT x'12' UNION ALL SELECT 'later')),
           (SELECT '01' UNION ALL SELECT CAST(9 AS INTEGER)) = 1,
           (SELECT CAST(1 AS INTEGER) UNION ALL SELECT 'later') = '1',
           (SELECT 'A' COLLATE NOCASE UNION ALL SELECT 'later') = 'a';
}
expect {
    blob|1|0|0
}

test scalar-compound-set-comparison-collation {
    SELECT (SELECT 'a' COLLATE NOCASE UNION SELECT 'B' ORDER BY 1 LIMIT 1 OFFSET 1),
           (SELECT 'a' COLLATE NOCASE INTERSECT SELECT 'A');
}
expect {
    B|a
}

test scalar-compound-skips-later-nested-subquery {
    SELECT (SELECT 1 UNION ALL SELECT (SELECT abs(-9223372036854775808)));
}
expect {
    1
}

test scalar-compound-values-input {
    SELECT (SELECT 9 UNION ALL VALUES (3), (1)),
           (SELECT 9 WHERE 0 UNION ALL VALUES (3), (1));
}
expect {
    9|3
}

@setup fruits
test scalar-compound-repeats-correlated-ordering {
    SELECT f.id, (SELECT id FROM fruit WHERE id < f.id
                  UNION ALL SELECT id FROM fruit WHERE id > f.id
                  ORDER BY id DESC LIMIT 1 OFFSET 1)
    FROM fruit f ORDER BY f.id;
}
expect {
    1|4
    2|4
    3|4
    4|3
    5|3
}

test scalar-compound-zero-limit-skips-sorted-input {
    SELECT coalesce((SELECT abs(-9223372036854775808)
                     UNION ALL SELECT 9 ORDER BY 1 LIMIT 0), 'empty');
}
expect {
    empty
}

test scalar-compound-zero-limit-skips-offset {
    SELECT coalesce((SELECT 1 UNION ALL SELECT 9 ORDER BY 1
                     LIMIT 0 OFFSET abs(-9223372036854775808)), 'empty');
}
expect {
    empty
}

test scalar-compound-null-limit-fails-before-sorted-input {
    SELECT (SELECT abs(-9223372036854775808)
            UNION ALL SELECT 9 ORDER BY 1 LIMIT NULL);
}
expect error {
    datatype mismatch
}

@setup fruits
test scalar-compound-rewrites-exists-inside-an-input {
    SELECT (SELECT name FROM red_fruit r
            WHERE EXISTS (SELECT 1 FROM tropical_fruit t WHERE t.name > r.name)
            UNION ALL SELECT 'fallback' ORDER BY 1);
}
expect {
    apple
}
