@database :memory:

test values-correlated-multirow-membership {
    CREATE TABLE outer_values(x INTEGER);
    INSERT INTO outer_values VALUES (1), (2), (NULL);
    SELECT x FROM outer_values WHERE x IN (VALUES (x), (NULL)) ORDER BY x;
}
expect {
    1
    2
}

test values-correlated-multirow-scalar {
    CREATE TABLE outer_values(x INTEGER);
    INSERT INTO outer_values VALUES (1), (2);
    SELECT x, (VALUES (x), (x + 1)) FROM outer_values ORDER BY x;
}
expect {
    1|1
    2|2
}

test values-1 {
    values(1, 2);
}
expect {
    1|2
}

test values-2 {
    values(1, 2), (3, 4);
}
expect {
    1|2
    3|4
}

test values-3 {
    values(1+1, 2*3);
}
expect {
    2|6
}

test values-in-from {
    select * from (values(3, 4, 5), (5, 6, 7), (8, 9, 10));
}
expect {
    3|4|5
    5|6|7
    8|9|10
}

test values-in-join {
    select * from (values(1, 2)) join (values(3, 4), (5, 6));
}
expect {
    1|2|3|4
    1|2|5|6
}

setup dqs_dml {
    .dbconfig dqs_dml on
}

@backend cli
@setup dqs_dml
test values-double-quotes-simple {
    VALUES ("double_quoted_string");
}
expect {
    double_quoted_string
}

@backend cli
@setup dqs_dml
test values-double-quotes-multiple {
    VALUES ("first", "second"), ("third", "fourth");
}
expect {
    first|second
    third|fourth
}

@backend cli
@setup dqs_dml
test values-mixed-quotes {
    VALUES ("double", 'single'), ('single', "double");
}
expect {
    double|single
    single|double
}

@backend cli
@setup dqs_dml
test values-double-quotes-subquery {
    SELECT * FROM (VALUES ("subquery_string"));
}
expect {
    subquery_string
}

# Tests verifying error when DQS is disabled
setup dqs_dml_off {
    .dbconfig dqs_dml off
}

@backend cli
@setup dqs_dml_off
test values-double-quotes-error-dqs-off {
    VALUES ("double_quoted_string");
}
expect error {
    no such column.*double_quoted_string
}

# regression test for: https://github.com/tursodatabase/turso/issues/2158
@cross-check-integrity
test values-between {
    CREATE TABLE t0 (c0);
    INSERT INTO t0 VALUES ((0 BETWEEN 0 AND 0)), (0);
    SELECT * FROM t0;
}
expect {
    1
    0
}

@cross-check-integrity
test values-illegal-column-ref {
    CREATE TABLE t0 (c0);
    INSERT INTO t0 VALUES (c0);
}
expect error {
}

# Unquoted identifiers in VALUES should produce a parse error
test values-unquoted-identifier-single {
    values(asdf);
}
expect error {
}

test values-unquoted-identifier-mixed {
    values(1, asdf);
}
expect error {
}

# Also verify correlated VALUES references outer columns row-by-row
@cross-check-integrity
test values-correlated-values-in-select {
    CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT);
    INSERT INTO users (name) VALUES ('jack'), ('jill');
    SELECT id, (VALUES(name)) AS name_again FROM users;
}
expect {
    1|jack
    2|jill
}


test values-derived-first-row-collation {
    SELECT column1 FROM (VALUES ('A' COLLATE NOCASE), ('a'))
    WHERE column1 = 'a' ORDER BY column1 COLLATE BINARY;
}
expect {
    A
    a
}

test values-derived-later-row-collation-keeps-column-default {
    SELECT column1 FROM (VALUES ('A'), ('a' COLLATE NOCASE))
    WHERE column1 = 'a' ORDER BY column1 COLLATE BINARY;
}
expect {
    a
}

test values-compound-first-row-collation {
    SELECT count(*) FROM (VALUES ('A' COLLATE NOCASE) UNION SELECT 'a');
}
expect {
    1
}

test values-compound-later-row-collation-keeps-first-row-default {
    SELECT count(*) FROM (VALUES ('A'), ('a' COLLATE NOCASE) UNION SELECT 'b');
}
expect {
    3
}

test values-compound-affinity-uses-actual-row-types {
    WITH v(x) AS (
        VALUES (CAST('1' AS TEXT)), (CAST('2' AS TEXT)) UNION ALL SELECT CAST('3' AS TEXT)
    ) SELECT x, typeof(x) FROM v WHERE x = 1;
}
expect {
    1|text
}

test values-compound-literal-rows-have-no-declared-type {
    WITH v(x) AS (
        VALUES ('1'), ('2') UNION ALL SELECT CAST('3' AS TEXT)
    ) SELECT x, typeof(x) FROM v WHERE x = 1;
}
expect {
}

test values-compound-conflicting-row-types-have-no-affinity {
    WITH v(x) AS (
        VALUES ('1'), (2) UNION ALL SELECT CAST('3' AS TEXT)
    ) SELECT x, typeof(x) FROM v WHERE x = 1 OR x = 2 ORDER BY x;
}
expect {
    2|integer
}

test values-derived-cast-defines-output-affinity {
    WITH v(x) AS (VALUES (CAST('1' AS TEXT)), ('2'))
    SELECT x, typeof(x) FROM v WHERE x = 1;
}
expect {
    1|text
}

test values-derived-conflicting-row-types-have-no-affinity {
    WITH v(x) AS (VALUES (CAST(1 AS INTEGER)), ('01'))
    SELECT x, typeof(x) FROM v WHERE x = 1;
}
expect {
    1|integer
}
