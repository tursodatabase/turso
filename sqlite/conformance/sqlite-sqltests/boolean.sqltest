# WHERE clause string literal tests (issue #5039)
# Strings with leading numeric prefixes should be evaluated correctly

test where-string-numeric-prefix-1 {
    SELECT 1 WHERE '9S';
}
expect {
    1
}

test where-string-numeric-prefix-2 {
    SELECT 1 WHERE '1abc';
}
expect {
    1
}

test where-string-numeric-prefix-3 {
    SELECT 1 WHERE '0S';
}
expect {
}

test where-string-non-numeric {
    SELECT 1 WHERE 'abc';
}
expect {
}

test where-string-empty {
    SELECT 1 WHERE '';
}
expect {
}

test where-string-numeric {
    SELECT 1 WHERE '9';
}
expect {
    1
}

test where-string-zero {
    SELECT 1 WHERE '0';
}
expect {
}

test where-string-float-prefix {
    SELECT 1 WHERE '3.14abc';
}
expect {
    1
}

# SQLite replaces `x AND 0` with 0 when one operand is the integer literal 0,
# so the other operand never runs. The shapes below behave the same in the
# SQLite these tests run against (3.50.4) and in the current SQLite; the ones
# only newer SQLite folds (a function call operand, OR with 1, TRUE/FALSE)
# are in turso-sqltests/and-or-constant-fold.sqltest.

test and-with-a-constant-false-operand-never-runs-the-other-operand {
    SELECT 0 AND (SELECT abs(-9223372036854775807 - 1)), (SELECT abs(-9223372036854775807 - 1)) AND 0, typeof((SELECT abs(-9223372036854775807 - 1)) AND 0);
    SELECT CASE WHEN (SELECT abs(-9223372036854775807 - 1)) AND 0 THEN 'y' ELSE 'n' END, CASE (SELECT abs(-9223372036854775807 - 1)) AND 0 WHEN 0 THEN 'z' END;
    SELECT 0x0 AND (SELECT abs(-9223372036854775807 - 1)), ((0)) AND (SELECT abs(-9223372036854775807 - 1)), 00 AND (SELECT abs(-9223372036854775807 - 1));
    SELECT NOT ((SELECT abs(-9223372036854775807 - 1)) AND 0), ((SELECT abs(-9223372036854775807 - 1)) AND 0) OR 1.5, 0 AND (1 OR (SELECT abs(-9223372036854775807 - 1))), (SELECT abs(-9223372036854775807 - 1)) AND 1 AND 0;
    SELECT coalesce(NULL, (SELECT abs(-9223372036854775807 - 1)) AND 0), iif(0 AND (SELECT abs(-9223372036854775807 - 1)), 'y', 'n');
    SELECT 0 AND -(SELECT abs(-9223372036854775807 - 1)), 0 AND ((SELECT abs(-9223372036854775807 - 1)) + 1), 0 AND CAST((SELECT abs(-9223372036854775807 - 1)) AS TEXT), 0 AND (SELECT abs(-9223372036854775807 - 1)) IN (1, 2), 0 AND EXISTS (SELECT abs(-9223372036854775807 - 1));
}
expect {
    0|0|integer
    n|z
    0|0|0
    1|1|0|0
    0|n
    0|0|0|0|0
}

test and-with-a-constant-false-operand-folds-in-every-clause {
    CREATE TABLE fold(a);
    INSERT INTO fold VALUES (5);
    SELECT a AND 0, a OR 1, 0 AND a, 1 OR a, a AND 1, a OR 0 FROM fold;
    SELECT 0 AND (SELECT abs(-9223372036854775807 - 1)) FROM fold;
    SELECT 1 FROM fold WHERE a OR 1;
    SELECT 1 FROM fold WHERE (SELECT abs(-9223372036854775807 - 1)) OR 1;
    SELECT 1 FROM fold WHERE (SELECT abs(-9223372036854775807 - 1)) AND 0;
    SELECT 1 WHERE (SELECT abs(-9223372036854775807 - 1)) AND 0;
    SELECT a FROM fold WHERE CASE WHEN (SELECT abs(-9223372036854775807 - 1)) AND 0 THEN 1 ELSE 1 END;
    SELECT 1 OR a FROM fold ORDER BY a OR 1;
    UPDATE fold SET a = (SELECT abs(-9223372036854775807 - 1)) AND 0 RETURNING a;
    INSERT INTO fold VALUES ((SELECT abs(-9223372036854775807 - 1)) AND 0) RETURNING a;
}
expect {
    0|1|0|1|1|1
    0
    1
    1
    5
    1
    0
    0
}

# A float, a string, NULL, a COLLATE, a unary sign or an integer that does not
# fit in 32 bits is not folded, so the other operand runs.

test and-or-with-a-float-operand-runs-the-other-operand {
    SELECT 1.5 OR json_extract('bare', '$.a');
}
expect error {
    malformed JSON
}

test and-or-with-a-large-integer-operand-runs-the-other-operand {
    SELECT 2147483648 OR json_extract('bare', '$.a');
}
expect error {
    malformed JSON
}

test and-or-with-a-collated-operand-runs-the-other-operand {
    SELECT (0 COLLATE NOCASE) AND json_extract('bare', '$.a');
}
expect error {
    malformed JSON
}

test and-or-with-a-signed-operand-runs-the-other-operand {
    SELECT -1 OR json_extract('bare', '$.a');
}
expect error {
    malformed JSON
}

test and-or-with-a-null-operand-runs-the-other-operand {
    SELECT NULL AND json_extract('bare', '$.a');
}
expect error {
    malformed JSON
}

# An integer literal with a digit separator is not folded either: SQLite only
# reads the value of a plain digit string when it builds the literal.

test and-with-a-digit-separator-operand-runs-the-other-operand {
    SELECT 0_0 AND json_extract('bare', '$.a');
}
expect error {
    malformed JSON
}

test or-with-a-digit-separator-operand-runs-the-other-operand {
    SELECT 1_0 OR json_extract('bare', '$.a');
}
expect error {
    malformed JSON
}

# An aggregate where none is allowed is still a misuse, even next to the
# constant that would decide the AND or OR.

test and-or-with-a-constant-operand-still-rejects-a-misused-aggregate {
    CREATE TABLE misuse(a);
    CREATE TABLE misuse_other(b);
    SELECT a, b FROM misuse LEFT JOIN misuse_other ON sum(a) AND 0;
}
expect error {
    misuse of aggregate
}

# A constant false term does not hide a misused aggregate in the terms after
# it: SQLite rejects the query before it plans anything.

test and-chain-with-a-constant-false-operand-still-rejects-a-misused-aggregate {
    CREATE TABLE misuse_after(a);
    SELECT a FROM misuse_after WHERE 0 AND sum(a);
}
expect error {
    misuse of aggregate function sum()
}

test and-chain-with-a-constant-false-operand-still-rejects-a-misused-window-function {
    CREATE TABLE misuse_after_window(a);
    SELECT a FROM misuse_after_window WHERE 0 AND row_number() OVER ();
}
expect error {
    misuse of window function row_number()
}

test and-chain-with-a-constant-false-operand-still-rejects-a-misused-aggregate-in-on {
    CREATE TABLE misuse_after_on(a);
    CREATE TABLE misuse_after_on_other(b);
    SELECT a, b FROM misuse_after_on JOIN misuse_after_on_other ON 0 AND count(*);
}
expect error {
    misuse of aggregate function count
}

# SQLite resolves every name before it drops an operand of `x OR 1`, so a
# wrong column name inside a subquery of that operand is still an error.

test or-with-a-constant-operand-still-checks-a-name-inside-a-dropped-subquery {
    CREATE TABLE dropped_sub(a);
    SELECT (SELECT nosuchcol) OR 1 FROM dropped_sub;
}
expect error {
    no such column: nosuchcol
}

test and-with-a-constant-false-operand-still-checks-a-name-inside-a-dropped-subquery {
    CREATE TABLE dropped_sub(a);
    INSERT INTO dropped_sub VALUES (1);
    UPDATE dropped_sub SET a = EXISTS (SELECT 1 WHERE nosuchcol = 1) AND FALSE;
}
expect error {
    no such column: nosuchcol
}

# `x AND 0` is decided before names are resolved, as in SQLite's parser.

test and-with-integer-zero-drops-an-unknown-column-name-like-the-parser {
    CREATE TABLE unknown_name(a);
    INSERT INTO unknown_name VALUES (1);
    SELECT 0 AND nosuchcol, a FROM unknown_name;
    UPDATE unknown_name SET a = 2 WHERE 0 AND nosuchcol;
    SELECT a FROM unknown_name;
}
expect {
    0|1
    1
}

# A column name that is only resolved when the statement runs, as in a
# trigger WHEN clause or an UPSERT DO UPDATE, is still checked.

test and-or-with-a-constant-operand-still-checks-a-name-in-a-trigger-when {
    CREATE TABLE later(a);
    CREATE TABLE later_log(x);
    CREATE TRIGGER later_tr AFTER INSERT ON later WHEN nosuchcol OR 1 BEGIN INSERT INTO later_log VALUES (1); END;
    INSERT INTO later VALUES (1);
}
expect error {
    no such column
}

test and-or-with-a-constant-operand-still-checks-a-name-in-an-upsert {
    CREATE TABLE later(a PRIMARY KEY, b);
    INSERT INTO later VALUES (1, 1);
    INSERT INTO later VALUES (1, 2) ON CONFLICT(a) DO UPDATE SET b = 2 WHERE nosuchcol OR 1;
}
expect error {
    no such column
}

# An aggregate in the operand that `x AND 0` or `x OR 1` drops still makes the
# query an aggregate query, so it gives one row.

test and-or-with-a-constant-operand-keeps-an-aggregate-query {
    CREATE TABLE agg(a, g);
    INSERT INTO agg VALUES (1, 1), (3, 1), (5, 2);
    CREATE TABLE agg_empty(a);
    SELECT count(*) OR 1 FROM agg;
    SELECT sum(a) AND 0 FROM agg;
    SELECT sum(a) AND 0 FROM agg_empty;
    SELECT CASE WHEN count(*) OR 1 THEN 'y' END FROM agg;
    SELECT (SELECT count(*) AND 0 FROM agg_empty);
    SELECT g, sum(a) AND 0 FROM agg GROUP BY g ORDER BY g;
    INSERT INTO agg_empty SELECT sum(a) OR 1 FROM agg;
    SELECT count(*) FROM agg_empty;
}
expect {
    1
    0
    0
    y
    0
    1|0
    2|0
    1
}

# In a chain such as `5 AND 0 AND x`, the inner `5 AND 0` is folded to 0
# first, so `x` never runs either, in the result columns and in WHERE and
# HAVING, which keep the whole chain as one term.

test and-chain-with-a-constant-false-operand-never-runs-the-other-operands {
    CREATE TABLE chain(a, g);
    INSERT INTO chain VALUES (1, 1), (3, 2);
    SELECT 5 AND 0 AND (SELECT abs(-9223372036854775807 - 1)), (SELECT abs(-9223372036854775807 - 1)) AND (0 AND 5);
    SELECT a FROM chain WHERE a AND 0 AND (SELECT abs(-9223372036854775807 - 1));
    SELECT a FROM chain WHERE g = 1 AND (a AND 0) AND (SELECT abs(-9223372036854775807 - 1));
    SELECT g FROM chain GROUP BY g HAVING g AND 0 AND (SELECT abs(-9223372036854775807 - 1));
    SELECT count(*) FROM chain;
}
expect {
    0|0
    2
}

# The folded value is the 0 or 1 the AND or OR would have given, not the
# literal operand that decided it.

test and-or-with-a-constant-operand-gives-0-or-1 {
    SELECT 0 OR 5, 5 OR 0, (3) AND 0, 0 AND (3), 5 AND 0 AND 7, 0 OR 5 OR 7, typeof(0 OR 5), typeof(5 AND 0);
}
expect {
    1|1|0|0|0|1|integer|integer
}
