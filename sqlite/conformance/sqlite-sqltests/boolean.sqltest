    SELECT 1 AND x'';
}
expect {
    0
}

test boolean-and-0-blob {
    SELECT 0 AND x'';
}
expect {
    0
}

test boolean-and-0-1 {
    SELECT 0 AND 1;
}
expect {
    0
}

test boolean-and-1-1 {
    SELECT 1 AND 1;
}
expect {
    1
}

