@database :memory:

test delete-self-fk-set-null-keeps-rows-that-did-not-match {
    PRAGMA foreign_keys=ON;
    CREATE TABLE t(id INTEGER PRIMARY KEY, p REFERENCES t ON DELETE SET NULL);
    CREATE INDEX tp ON t(p);
    INSERT INTO t VALUES (1, NULL), (2, 1), (3, 1);
    DELETE FROM t WHERE p IS NULL;
    SELECT id, p IS NULL FROM t ORDER BY id;
}
expect {
    2|1
    3|1
}

test delete-fk-cycle-through-on-update-keeps-rows-that-did-not-match {
    PRAGMA foreign_keys=ON;
    CREATE TABLE a(id INTEGER PRIMARY KEY, p INTEGER REFERENCES b(k) ON UPDATE SET NULL);
    CREATE TABLE b(k INTEGER UNIQUE REFERENCES a(id) ON DELETE SET NULL);
    CREATE INDEX ap ON a(p);
    INSERT INTO a VALUES (1, NULL), (2, NULL), (3, NULL);
    INSERT INTO b VALUES (1);
    UPDATE a SET p = 1 WHERE id IN (2, 3);
    DELETE FROM a WHERE p IS NULL;
    SELECT id, p IS NULL FROM a ORDER BY id;
}
expect {
    2|1
    3|1
}
