@database :memory:

# SQLite joins up to 64 tables in one FROM clause and rejects 65 or more with
# "at most 64 tables in a join" (join.test join-12.2 to join-12.8).

setup t14 {
    CREATE TABLE t14(x);
    INSERT INTO t14 VALUES('abcdefghij');
}

