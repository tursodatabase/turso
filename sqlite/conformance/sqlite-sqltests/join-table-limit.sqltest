}

# A correlated subquery can run as a join with the outer tables. Its tables do
# not count toward the limit, so a 64-table join with such a subquery runs.

@setup t14
test self-join-64-tables-correlated-exists {
    SELECT 1 FROM t14 AS q, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14 WHERE EXISTS (SELECT 1 FROM t14 AS w WHERE w.x = q.x);
}
expect {
    1
}

@setup t14
test self-join-64-tables-correlated-not-exists {
    SELECT 1 FROM t14 AS q, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14 WHERE NOT EXISTS (SELECT 1 FROM t14 AS w WHERE w.x <> q.x);
}
expect {
    1
}

@setup t14
test self-join-64-tables-correlated-in {
    SELECT 1 FROM t14 AS q, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14 WHERE q.x IN (SELECT w.x FROM t14 AS w WHERE w.x = q.x);
}
expect {
    1
}

@setup t14
test self-join-64-tables-correlated-scalar-aggregate {
    SELECT 1 FROM t14 AS q, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14, t14 WHERE (SELECT count(*) FROM t14 AS w WHERE w.x = q.x) = 1;
}
expect {
    1
}
