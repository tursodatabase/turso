@setup chain
test chain-join-64-tables {
    SELECT count(*) FROM c0 JOIN c1 ON c1.id = c0.id JOIN c2 ON c2.id = c1.id JOIN c3 ON c3.id = c2.id JOIN c4 ON c4.id = c3.id JOIN c5 ON c5.id = c4.id JOIN c6 ON c6.id = c5.id JOIN c7 ON c7.id = c6.id JOIN c8 ON c8.id = c7.id JOIN c9 ON c9.id = c8.id JOIN c10 ON c10.id = c9.id JOIN c11 ON c11.id = c10.id JOIN c12 ON c12.id = c11.id JOIN c13 ON c13.id = c12.id JOIN c14 ON c14.id = c13.id JOIN c15 ON c15.id = c14.id JOIN c16 ON c16.id = c15.id JOIN c17 ON c17.id = c16.id JOIN c18 ON c18.id = c17.id JOIN c19 ON c19.id = c18.id JOIN c20 ON c20.id = c19.id JOIN c21 ON c21.id = c20.id JOIN c22 ON c22.id = c21.id JOIN c23 ON c23.id = c22.id JOIN c24 ON c24.id = c23.id JOIN c25 ON c25.id = c24.id JOIN c26 ON c26.id = c25.id JOIN c27 ON c27.id = c26.id JOIN c28 ON c28.id = c27.id JOIN c29 ON c29.id = c28.id JOIN c30 ON c30.id = c29.id JOIN c31 ON c31.id = c30.id JOIN c32 ON c32.id = c31.id JOIN c33 ON c33.id = c32.id JOIN c34 ON c34.id = c33.id JOIN c35 ON c35.id = c34.id JOIN c36 ON c36.id = c35.id JOIN c37 ON c37.id = c36.id JOIN c38 ON c38.id = c37.id JOIN c39 ON c39.id = c38.id JOIN c40 ON c40.id = c39.id JOIN c41 ON c41.id = c40.id JOIN c42 ON c42.id = c41.id JOIN c43 ON c43.id = c42.id JOIN c44 ON c44.id = c43.id JOIN c45 ON c45.id = c44.id JOIN c46 ON c46.id = c45.id JOIN c47 ON c47.id = c46.id JOIN c48 ON c48.id = c47.id JOIN c49 ON c49.id = c48.id JOIN c50 ON c50.id = c49.id JOIN c51 ON c51.id = c50.id JOIN c52 ON c52.id = c51.id JOIN c53 ON c53.id = c52.id JOIN c54 ON c54.id = c53.id JOIN c55 ON c55.id = c54.id JOIN c56 ON c56.id = c55.id JOIN c57 ON c57.id = c56.id JOIN c58 ON c58.id = c57.id JOIN c59 ON c59.id = c58.id JOIN c60 ON c60.id = c59.id JOIN c61 ON c61.id = c60.id JOIN c62 ON c62.id = c61.id JOIN c63 ON c63.id = c62.id;
}
expect {
    2
}

@setup chain
test chain-join-65-tables-rejected {
    SELECT count(*) FROM c0 JOIN c1 ON c1.id = c0.id JOIN c2 ON c2.id = c1.id JOIN c3 ON c3.id = c2.id JOIN c4 ON c4.id = c3.id JOIN c5 ON c5.id = c4.id JOIN c6 ON c6.id = c5.id JOIN c7 ON c7.id = c6.id JOIN c8 ON c8.id = c7.id JOIN c9 ON c9.id = c8.id JOIN c10 ON c10.id = c9.id JOIN c11 ON c11.id = c10.id JOIN c12 ON c12.id = c11.id JOIN c13 ON c13.id = c12.id JOIN c14 ON c14.id = c13.id JOIN c15 ON c15.id = c14.id JOIN c16 ON c16.id = c15.id JOIN c17 ON c17.id = c16.id JOIN c18 ON c18.id = c17.id JOIN c19 ON c19.id = c18.id JOIN c20 ON c20.id = c19.id JOIN c21 ON c21.id = c20.id JOIN c22 ON c22.id = c21.id JOIN c23 ON c23.id = c22.id JOIN c24 ON c24.id = c23.id JOIN c25 ON c25.id = c24.id JOIN c26 ON c26.id = c25.id JOIN c27 ON c27.id = c26.id JOIN c28 ON c28.id = c27.id JOIN c29 ON c29.id = c28.id JOIN c30 ON c30.id = c29.id JOIN c31 ON c31.id = c30.id JOIN c32 ON c32.id = c31.id JOIN c33 ON c33.id = c32.id JOIN c34 ON c34.id = c33.id JOIN c35 ON c35.id = c34.id JOIN c36 ON c36.id = c35.id JOIN c37 ON c37.id = c36.id JOIN c38 ON c38.id = c37.id JOIN c39 ON c39.id = c38.id JOIN c40 ON c40.id = c39.id JOIN c41 ON c41.id = c40.id JOIN c42 ON c42.id = c41.id JOIN c43 ON c43.id = c42.id JOIN c44 ON c44.id = c43.id JOIN c45 ON c45.id = c44.id JOIN c46 ON c46.id = c45.id JOIN c47 ON c47.id = c46.id JOIN c48 ON c48.id = c47.id JOIN c49 ON c49.id = c48.id JOIN c50 ON c50.id = c49.id JOIN c51 ON c51.id = c50.id JOIN c52 ON c52.id = c51.id JOIN c53 ON c53.id = c52.id JOIN c54 ON c54.id = c53.id JOIN c55 ON c55.id = c54.id JOIN c56 ON c56.id = c55.id JOIN c57 ON c57.id = c56.id JOIN c58 ON c58.id = c57.id JOIN c59 ON c59.id = c58.id JOIN c60 ON c60.id = c59.id JOIN c61 ON c61.id = c60.id JOIN c62 ON c62.id = c61.id JOIN c63 ON c63.id = c62.id JOIN c64 ON c64.id = c63.id;
}
