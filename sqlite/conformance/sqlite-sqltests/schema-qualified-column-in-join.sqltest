@database :memory:

# A schema.table.column reference must read the same value as table.column.
# In a hash join, Turso returned NULL for the 3-part form.

setup two-tables {
    CREATE TABLE mt(id, b);
    CREATE TABLE mu(id);
    INSERT INTO mt VALUES (1, 'y'), (2, 'z');
    INSERT INTO mu VALUES (1), (2);
}

@setup two-tables
test schema-qualified-column-in-hash-join {
    SELECT main.mt.b FROM mt JOIN mu ON mt.id = mu.id ORDER BY 1;
}
expect {
    y
    z
}

@setup two-tables
test schema-qualified-rowid-in-hash-join {
    SELECT main.mt.rowid FROM mt JOIN mu ON mt.id = mu.id ORDER BY 1;
}
expect {
    1
    2
}

@setup two-tables
test schema-qualified-column-in-join-grouped-by-table-column {
    SELECT main.mt.b, count(*) FROM mt JOIN mu ON mt.id = mu.id GROUP BY mt.b ORDER BY 1;
}
expect {
    y|1
    z|1
}

test schema-qualified-column-of-an-outer-table-in-a-subquery {
    ATTACH ':memory:' AS aux;
    CREATE TABLE aux.t(x);
    CREATE TABLE t(x);
    INSERT INTO aux.t VALUES (1);
    INSERT INTO t VALUES (2);
    SELECT (SELECT aux.t.x FROM main.t) FROM aux.t;
    SELECT (SELECT main.t.x FROM aux.t) FROM main.t;
}
expect {
    1
    2
}

test schema-qualified-column-of-a-table-not-in-from-errors {
    ATTACH ':memory:' AS aux;
    CREATE TABLE aux.t(x);
    CREATE TABLE t(x);
    INSERT INTO aux.t VALUES (1);
    INSERT INTO t VALUES (2);
    SELECT main.t.x FROM aux.t;
}
expect error {
}
