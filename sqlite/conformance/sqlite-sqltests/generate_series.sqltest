@database :memory:

test generate-series-single-arg-default-stop {
    SELECT count(*), max(value) FROM generate_series(4294967290);
}
expect {
    6|4294967295
}

test generate-series-single-arg-via-where {
    SELECT count(*), max(value) FROM generate_series WHERE start = 4294967290;
}
expect {
    6|4294967295
}

test generate-series-two-args {
    SELECT * FROM generate_series(1, 5);
}
expect {
    1
    2
    3
    4
    5
}

test generate-series-three-args {
    SELECT * FROM generate_series(1, 10, 3);
}
expect {
    1
    4
    7
    10
}

test generate-series-null-arguments-return-no-rows {
    SELECT count(*) FROM generate_series(NULL, 3);
    SELECT count(*) FROM generate_series(1, NULL);
    SELECT count(*) FROM generate_series(1, 3, NULL);
}
expect {
    0
    0
    0
}

test generate-series-explicit-negative-stop {
    SELECT count(*) FROM generate_series(1, -1);
}
expect {
    0
}

test generate-series-hidden-columns-have-no-hidden-type {
    SELECT name, instr(upper(type), 'HIDDEN') FROM pragma_table_xinfo('generate_series') WHERE hidden = 1;
}
expect {
    start|0
    stop|0
    step|0
}

test generate-series-rowid-is-the-value {
    SELECT typeof(rowid), rowid, value FROM generate_series(0, 2);
}
expect {
    integer|0|0
    integer|1|1
    integer|2|2
}

test generate-series-rowid-is-null-on-unmatched-left-join-row {
    SELECT x, typeof(s.rowid) FROM (SELECT 1 AS x) LEFT JOIN generate_series(5, 7) AS s ON s.value = x;
}
expect {
    1|null
}

test json-each-argument-named-like-a-column-of-the-function {
    CREATE TABLE json_args (type);
    INSERT INTO json_args VALUES ('array');
    SELECT 1 FROM json_each(type);
}
expect {
}

test table-function-argument-reads-the-function-itself {
    SELECT 1 FROM json_each(json_each.value);
}
expect {
}

test json-each-argument-named-like-a-column-of-the-function-and-of-another-table-is-ambiguous {
    CREATE TABLE json_args_ambiguous (value);
    SELECT 1 FROM json_args_ambiguous, json_each(value);
}
expect error {
    ambiguous column name: value
}

test json-each-argument-can-name-a-table-listed-after-it {
    CREATE TABLE json_args_later (j);
    INSERT INTO json_args_later VALUES ('[1, 2]');
    SELECT count(*) FROM json_each(json_args_later.j), json_args_later;
}
expect {
    2
}

test json-each-argument-names-the-column-of-the-function-before-it {
    CREATE TABLE json_args_nested (j);
    INSERT INTO json_args_nested VALUES ('{"a": {"x": 1, "y": 2}, "b": {"z": 3}}');
    SELECT count(*) FROM json_args_nested, json_each(j) AS outer_each, json_each(outer_each.value) AS inner_each;
}
expect {
    3
}
