@database :memory:

test pragma-vdbe-trace {
    PRAGMA vdbe_trace = ON;
    PRAGMA vdbe_trace = OFF;
    PRAGMA vdbe_trace = TRUE;
    PRAGMA vdbe_trace = FALSE;
    PRAGMA vdbe_trace = 0;
    PRAGMA vdbe_trace = 1;
    PRAGMA vdbe_trace = 2;
    PRAGMA vdbe_trace;
}
expect {
}

test pragma-vdbe-trace-odd-values {
    PRAGMA vdbe_trace = 0.0;
    PRAGMA vdbe_trace = 1.5;
    PRAGMA vdbe_trace = 256;
    PRAGMA vdbe_trace = 0x10;
    PRAGMA vdbe_trace = +1;
    PRAGMA vdbe_trace = -1;
    PRAGMA vdbe_trace = bogus;
    PRAGMA vdbe_trace = 'true';
    PRAGMA vdbe_trace = OFF;
    PRAGMA vdbe_trace;
}
expect {
}
