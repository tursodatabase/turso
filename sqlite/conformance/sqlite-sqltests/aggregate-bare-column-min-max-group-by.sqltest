@database :memory:

# Bare columns in a GROUP BY query with MIN/MAX. Like SQLite, a column read
# outside an aggregate function reads the row holding the group's MIN/MAX
# value, not the group's first row, both when the rows come from a sorter and
# when they come in GROUP BY order from an index.

setup rows {
    CREATE TABLE t2(a, b, c);
    INSERT INTO t2 VALUES (1, NULL, 2), (1, 2, 3), (1, 1, 4), (2, 3, 5), (2, 1, 6), (2, 3, 7);
}

setup rows-with-index {
    CREATE TABLE t2(a, b, c);
    CREATE INDEX t2a ON t2(a);
    INSERT INTO t2 VALUES (1, NULL, 2), (1, 2, 3), (1, 1, 4), (2, 3, 5), (2, 1, 6), (2, 3, 7);
}

@setup rows
test group-by-max-reads-max-row {
    SELECT a, max(b), c FROM t2 GROUP BY a;
}
expect {
    1|2|3
    2|3|5
}

@setup rows
test group-by-min-reads-min-row {
    SELECT a, min(b), c FROM t2 GROUP BY a;
}
expect {
    1|1|4
    2|1|6
}

@setup rows
test group-by-max-with-where-reads-max-row {
    SELECT max(b), c FROM t2 WHERE a = 1 GROUP BY a;
}
expect {
    2|3
}

@setup rows
test group-by-max-bare-column-in-having-reads-max-row {
    SELECT a, max(b) FROM t2 GROUP BY a HAVING c = 3;
}
expect {
    1|2
}

@setup rows
test group-by-filtered-max-reads-max-row {
    SELECT a, max(b) FILTER (WHERE c > 3), c FROM t2 GROUP BY a;
}
expect {
    1|1|4
    2|3|5
}

@setup rows
test group-by-filtered-max-matching-no-row-reads-first-row {
    SELECT a, max(b) FILTER (WHERE c > 100), c FROM t2 GROUP BY a;
}
expect {
    1||2
    2||5
}

# Like SQLite, the FILTER of a MIN/MAX resets the row choice to "read only if
# this is the group's first row", also when another MIN/MAX has no FILTER.
@setup rows
test group-by-filtered-min-after-max-reads-last-changed-row {
    SELECT a, max(b), min(c) FILTER (WHERE c > 2), c FROM t2 GROUP BY a;
}
expect {
    1|2|3|3
    2|3|5|5
}

@setup rows-with-index
test group-by-index-max-reads-max-row {
    SELECT a, max(b), c FROM t2 GROUP BY a;
}
expect {
    1|2|3
    2|3|5
}

@setup rows-with-index
test group-by-index-min-reads-min-row {
    SELECT a, min(b), c FROM t2 GROUP BY a;
}
expect {
    1|1|4
    2|1|6
}

@setup rows-with-index
test group-by-index-filtered-max-reads-max-row {
    SELECT a, max(b) FILTER (WHERE c > 3), c FROM t2 GROUP BY a;
}
expect {
    1|1|4
    2|3|5
}

@setup rows-with-index
test group-by-index-max-distinct-reads-max-row {
    SELECT a, max(DISTINCT b), c FROM t2 GROUP BY a;
}
expect {
    1|2|3
    2|3|5
}

@setup rows
test group-by-count-reads-first-row {
    SELECT a, count(*), c FROM t2 GROUP BY a;
}
expect {
    1|3|2
    2|3|5
}
