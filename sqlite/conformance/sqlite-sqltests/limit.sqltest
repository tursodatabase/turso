@database :memory:

test limit-i64-min-no-panic {
    SELECT 1 LIMIT -9223372036854775808;
}
expect {
    1
}

@cross-check-integrity
test limit-negative-no-limit {
    CREATE TABLE t(x);
    INSERT INTO t VALUES (1), (2), (3);
    SELECT x FROM t LIMIT -1;
}
expect {
    1
    2
    3
}

test limit-zero {
    SELECT 1 LIMIT 0;
}
expect {
}

test limit-one {
    SELECT 1 UNION ALL SELECT 2 LIMIT 1;
}
expect {
    1
}

test limit-in-subquery {
    SELECT 1 LIMIT (1 IN (SELECT 1));
}
expect {
    1
}

test limit-non-integer-datatype-mismatch {
    CREATE TABLE t(x);
    INSERT INTO t VALUES (1), (2);
    SELECT x FROM t LIMIT (SELECT 'abc');
}
expect error {
    datatype mismatch
}

test limit-compound-subquery {
    SELECT 1 UNION SELECT 2 LIMIT (SELECT 1);
}
expect {
    1
}

test limit-compound-subquery-order-by {
    CREATE TABLE a(x INTEGER);
    INSERT INTO a VALUES (1), (2);
    CREATE TABLE b(n INTEGER);
    INSERT INTO b VALUES (1);
    SELECT x FROM a UNION SELECT x FROM a ORDER BY 1 LIMIT (SELECT n FROM b);
}
expect {
    1
}

test limit-compound-union-all-subquery {
    SELECT 1 UNION ALL SELECT 2 LIMIT (SELECT 1);
}
expect {
    1
}

test limit-compound-intersect-subquery {
    SELECT 1 INTERSECT SELECT 1 LIMIT (SELECT 1);
}
expect {
    1
}

test limit-compound-except-subquery {
    SELECT 1 EXCEPT SELECT 2 LIMIT (SELECT 1);
}
expect {
    1
}

test limit-compound-offset-subquery {
    SELECT 1 UNION SELECT 2 ORDER BY 1 LIMIT 1 OFFSET (SELECT 1);
}
expect {
    2
}

test limit-compound-subquery-no-such-column {
    CREATE TABLE b(n INTEGER);
    SELECT 1 UNION SELECT 2 LIMIT (SELECT nosuchcol FROM b);
}
expect error {
    no such column: nosuchcol
}

test limit-compound-non-integer-datatype-mismatch {
    SELECT 1 UNION SELECT 2 LIMIT (SELECT 'abc');
}
expect error {
    datatype mismatch
}

test limit-compound-subquery-comma-form {
    SELECT 1 UNION SELECT 2 LIMIT (SELECT 1), (SELECT 1);
}
expect {
    2
}

test limit-compound-subquery-negative-no-limit {
    SELECT 1 UNION SELECT 2 ORDER BY 1 LIMIT (SELECT -1);
}
expect {
    1
    2
}
