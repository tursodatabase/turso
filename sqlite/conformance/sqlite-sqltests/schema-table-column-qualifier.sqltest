@database :memory:

# sqlite_schema and sqlite_master name the same table, and so do
# sqlite_temp_schema and sqlite_temp_master. Either name qualifies a column,
# whichever name FROM used, unless FROM gave an alias.

setup schema {
    CREATE TABLE t (a);
}

@setup schema
test sqlite-master-qualifies-column-from-sqlite-schema {
    SELECT sqlite_master.name FROM sqlite_schema;
}
expect {
    t
}

@setup schema
test sqlite-schema-qualifies-column-from-sqlite-master {
    SELECT sqlite_schema.name FROM sqlite_master;
}
expect {
    t
}

@setup schema
test sqlite-master-qualifies-column-from-main-sqlite-schema {
    SELECT sqlite_master.name FROM main.sqlite_schema;
}
expect {
    t
}

@setup schema
test main-sqlite-master-qualifies-column-from-sqlite-schema {
    SELECT main.sqlite_master.name FROM sqlite_schema;
}
expect {
    t
}

@setup schema
test qualifier-case-is-ignored {
    SELECT SQLITE_MASTER.name FROM sqlite_schema;
}
expect {
    t
}

@setup schema
test other-name-qualifies-rowid {
    SELECT sqlite_schema.rowid FROM sqlite_master;
}
expect {
    1
}

@setup schema
test other-name-qualifies-column-in-where {
    SELECT name FROM sqlite_schema WHERE sqlite_master.type = 'table';
}
expect {
    t
}

@setup schema
test other-name-qualifies-outer-column {
    SELECT (SELECT sqlite_master.name) FROM sqlite_schema;
}
expect {
    t
}

@setup schema
test both-names-in-from-are-ambiguous {
    SELECT sqlite_master.name FROM sqlite_schema, sqlite_master;
}
expect error {
    ambiguous column name: sqlite_master.name
}

@setup schema
test alias-hides-schema-table-names {
    SELECT sqlite_master.name FROM sqlite_schema x;
}
expect error {
}

test sqlite-temp-master-qualifies-column-from-sqlite-temp-schema {
    CREATE TEMP TABLE tt (a);
    SELECT sqlite_temp_master.name FROM sqlite_temp_schema;
}
expect {
    tt
}

test sqlite-temp-schema-qualifies-column-from-sqlite-temp-master {
    CREATE TEMP TABLE tt (a);
    SELECT sqlite_temp_schema.name FROM sqlite_temp_master;
}
expect {
    tt
}

test main-names-qualify-temp-column-after-database-name {
    CREATE TEMP TABLE tt (a);
    SELECT temp.sqlite_master.name, temp.sqlite_schema.name FROM sqlite_temp_master;
}
expect {
    tt|tt
}

test main-names-do-not-qualify-temp-column-without-database-name {
    CREATE TEMP TABLE tt (a);
    SELECT sqlite_master.name FROM sqlite_temp_master;
}
expect error {
}

@setup schema
test temp-names-do-not-qualify-main-column {
    SELECT sqlite_temp_master.name FROM sqlite_schema;
}
expect error {
}

# An alias spelled like a schema table name is still an alias: only it
# qualifies the table's columns.

@setup schema
test schema-name-alias-hides-other-names {
    SELECT sqlite_schema.name FROM sqlite_schema AS sqlite_master;
}
expect error {
}

@setup schema
test schema-name-alias-hides-name-used-in-from {
    SELECT sqlite_master.name FROM sqlite_master AS sqlite_schema;
}
expect error {
}

@setup schema
test schema-name-alias-same-as-from-name-hides-other-names {
    SELECT sqlite_master.name FROM sqlite_schema AS sqlite_schema;
}
expect error {
}

@setup schema
test schema-name-alias-qualifies-column {
    SELECT sqlite_schema.name FROM sqlite_master AS sqlite_schema;
}
expect {
    t
}

@setup schema
test schema-name-alias-hides-other-names-for-outer-column {
    SELECT (SELECT sqlite_master.name) FROM sqlite_schema AS sqlite_schema;
}
expect error {
}

@setup schema
test schema-name-alias-hides-other-names-in-parenthesized-join {
    SELECT sqlite_master.name FROM (sqlite_master AS sqlite_schema, t);
}
expect error {
}

test other-name-qualifies-column-in-parenthesized-join {
    CREATE TABLE t (a);
    INSERT INTO t VALUES (1);
    SELECT sqlite_schema.name, sqlite_master.name FROM (sqlite_master, t);
}
expect {
    t|t
}

test temp-name-alias-hides-other-temp-names {
    CREATE TEMP TABLE tt (a);
    SELECT sqlite_temp_master.name FROM sqlite_temp_schema AS sqlite_temp_schema;
}
expect error {
}
