@database :memory:

# sqlite_schema and sqlite_master name the same table, and so do
# sqlite_temp_schema and sqlite_temp_master. Either name qualifies a column,
# whichever name FROM used, unless FROM gave an alias. `<tbl>.*` only accepts
# the alias or the name SQLite stores the table under: sqlite_master, or
# sqlite_temp_master for temp.

setup schema {
    CREATE TABLE t (a);
}

@setup schema
test sqlite-master-qualifies-column-from-sqlite-schema {
    SELECT sqlite_master.name FROM sqlite_schema;
}
expect {
    t
}

@setup schema
test sqlite-schema-qualifies-column-from-sqlite-master {
    SELECT sqlite_schema.name FROM sqlite_master;
}
expect {
    t
}

@setup schema
test sqlite-master-qualifies-column-from-main-sqlite-schema {
    SELECT sqlite_master.name FROM main.sqlite_schema;
}
expect {
    t
}

@setup schema
test main-sqlite-master-qualifies-column-from-sqlite-schema {
    SELECT main.sqlite_master.name FROM sqlite_schema;
}
expect {
    t
}

@setup schema
test qualifier-case-is-ignored {
    SELECT SQLITE_MASTER.name FROM sqlite_schema;
}
expect {
    t
}

@setup schema
test other-name-qualifies-rowid {
    SELECT sqlite_schema.rowid FROM sqlite_master;
}
expect {
    1
}

@setup schema
test other-name-qualifies-column-in-where {
    SELECT name FROM sqlite_schema WHERE sqlite_master.type = 'table';
}
expect {
    t
}

@setup schema
test other-name-qualifies-outer-column {
    SELECT (SELECT sqlite_master.name) FROM sqlite_schema;
}
expect {
    t
}

@setup schema
test both-names-in-from-are-ambiguous {
    SELECT sqlite_master.name FROM sqlite_schema, sqlite_master;
}
expect error {
    ambiguous column name: sqlite_master.name
}

@setup schema
test alias-hides-schema-table-names {
    SELECT sqlite_master.name FROM sqlite_schema x;
}
expect error {
}

test sqlite-temp-master-qualifies-column-from-sqlite-temp-schema {
    CREATE TEMP TABLE tt (a);
    SELECT sqlite_temp_master.name FROM sqlite_temp_schema;
}
expect {
    tt
}

test sqlite-temp-schema-qualifies-column-from-sqlite-temp-master {
    CREATE TEMP TABLE tt (a);
    SELECT sqlite_temp_schema.name FROM sqlite_temp_master;
}
expect {
    tt
}

test main-names-qualify-temp-column-after-database-name {
    CREATE TEMP TABLE tt (a);
    SELECT temp.sqlite_master.name, temp.sqlite_schema.name FROM sqlite_temp_master;
}
expect {
    tt|tt
}

test main-names-do-not-qualify-temp-column-without-database-name {
    CREATE TEMP TABLE tt (a);
    SELECT sqlite_master.name FROM sqlite_temp_master;
}
expect error {
}

@setup schema
test temp-names-do-not-qualify-main-column {
    SELECT sqlite_temp_master.name FROM sqlite_schema;
}
expect error {
}

@setup schema
test sqlite-master-star-from-sqlite-schema {
    SELECT type, name, tbl_name FROM (SELECT sqlite_master.* FROM sqlite_schema);
}
expect {
    table|t|t
}

@setup schema
test sqlite-schema-star-from-sqlite-master {
    SELECT sqlite_schema.* FROM sqlite_master;
}
expect error {
    no such table: sqlite_schema
}

@setup schema
test sqlite-schema-star-from-sqlite-schema {
    SELECT sqlite_schema.* FROM sqlite_schema;
}
expect error {
    no such table: sqlite_schema
}

test sqlite-temp-master-star-from-sqlite-temp-schema {
    CREATE TEMP TABLE tt (a);
    SELECT type, name, tbl_name FROM (SELECT sqlite_temp_master.* FROM sqlite_temp_schema);
}
expect {
    table|tt|tt
}

test sqlite-temp-master-star-from-temp-sqlite-master {
    CREATE TEMP TABLE tt (a);
    SELECT type, name, tbl_name FROM (SELECT sqlite_temp_master.* FROM temp.sqlite_master);
}
expect {
    table|tt|tt
}

test sqlite-master-star-from-temp-sqlite-master {
    SELECT sqlite_master.* FROM temp.sqlite_master;
}
expect error {
    no such table: sqlite_master
}

test sqlite-temp-schema-star-from-sqlite-temp-schema {
    SELECT sqlite_temp_schema.* FROM sqlite_temp_schema;
}
expect error {
    no such table: sqlite_temp_schema
}

@setup schema
test alias-hides-stored-name-for-star {
    SELECT sqlite_master.* FROM sqlite_schema x;
}
expect error {
    no such table: sqlite_master
}

@setup schema
test schema-name-alias-hides-stored-name-for-star {
    SELECT sqlite_master.* FROM sqlite_master AS sqlite_schema;
}
expect error {
    no such table: sqlite_master
}

@setup schema
test schema-name-alias-qualifies-star {
    SELECT type, name, tbl_name FROM (SELECT sqlite_schema.* FROM sqlite_master AS sqlite_schema);
}
expect {
    table|t|t
}

test sqlite-master-star-from-parenthesized-join {
    CREATE TABLE t (a);
    INSERT INTO t VALUES (1);
    SELECT type, name, tbl_name FROM (SELECT sqlite_master.* FROM (sqlite_schema, t));
}
expect {
    table|t|t
}

@setup schema
test sqlite-master-star-from-both-names-is-ambiguous {
    SELECT sqlite_master.* FROM sqlite_schema, sqlite_master;
}
expect error {
}

# An alias spelled like a schema table name is still an alias: only it
# qualifies the table's columns.

@setup schema
test schema-name-alias-hides-other-names {
    SELECT sqlite_schema.name FROM sqlite_schema AS sqlite_master;
}
expect error {
}

@setup schema
test schema-name-alias-hides-name-used-in-from {
    SELECT sqlite_master.name FROM sqlite_master AS sqlite_schema;
}
expect error {
}

@setup schema
test schema-name-alias-same-as-from-name-hides-other-names {
    SELECT sqlite_master.name FROM sqlite_schema AS sqlite_schema;
}
expect error {
}

@setup schema
test schema-name-alias-qualifies-column {
    SELECT sqlite_schema.name FROM sqlite_master AS sqlite_schema;
}
expect {
    t
}

@setup schema
test schema-name-alias-hides-other-names-for-outer-column {
    SELECT (SELECT sqlite_master.name) FROM sqlite_schema AS sqlite_schema;
}
expect error {
}

@setup schema
test schema-name-alias-hides-other-names-in-parenthesized-join {
    SELECT sqlite_master.name FROM (sqlite_master AS sqlite_schema, t);
}
expect error {
}

test other-name-qualifies-column-in-parenthesized-join {
    CREATE TABLE t (a);
    INSERT INTO t VALUES (1);
    SELECT sqlite_schema.name, sqlite_master.name FROM (sqlite_master, t);
}
expect {
    t|t
}

test temp-name-alias-hides-other-temp-names {
    CREATE TEMP TABLE tt (a);
    SELECT sqlite_temp_master.name FROM sqlite_temp_schema AS sqlite_temp_schema;
}
expect error {
}

# Inside a parenthesized join with an alias, SQLite saves each column under the
# table's alias or stored name, so only that name qualifies it, for both
# `<tbl>.<col>` and `<tbl>.*`.

test sqlite-master-qualifies-column-in-aliased-join {
    CREATE TABLE t (a);
    INSERT INTO t VALUES (1);
    SELECT sqlite_master.name, main.sqlite_master.name, sqlite_master.rowid FROM (sqlite_schema, t) AS g;
}
expect {
    t|t|1
}

test sqlite-schema-does-not-qualify-column-in-aliased-join {
    CREATE TABLE t (a);
    INSERT INTO t VALUES (1);
    SELECT sqlite_schema.name FROM (sqlite_schema, t) AS g;
}
expect error {
}

test sqlite-master-star-from-aliased-join {
    CREATE TABLE t (a);
    INSERT INTO t VALUES (1);
    SELECT type, name, tbl_name, a FROM (SELECT sqlite_master.*, t.* FROM (sqlite_schema, t) AS g);
}
expect {
    table|t|t|1
}

test sqlite-schema-star-from-aliased-join {
    CREATE TABLE t (a);
    INSERT INTO t VALUES (1);
    SELECT sqlite_schema.* FROM (sqlite_schema, t) AS g;
}
expect error {
    no such table: sqlite_schema
}

test sqlite-master-qualifies-column-in-nested-aliased-join {
    CREATE TABLE t (a);
    INSERT INTO t VALUES (1);
    SELECT sqlite_master.name FROM ((sqlite_schema, t) AS g, t AS t3);
}
expect {
    t
}

test sqlite-master-star-from-nested-aliased-join {
    CREATE TABLE t (a);
    INSERT INTO t VALUES (1);
    SELECT type, name, tbl_name FROM (SELECT sqlite_master.* FROM ((sqlite_schema, t) AS g, t AS t3));
}
expect {
    table|t|t
}

test sqlite-temp-master-qualifies-column-in-aliased-join {
    CREATE TABLE t (a);
    INSERT INTO t VALUES (1);
    CREATE TEMP TABLE tt (b);
    SELECT sqlite_temp_master.name FROM (temp.sqlite_master, t) AS g;
}
expect {
    tt
}

test main-names-do-not-qualify-temp-column-in-aliased-join {
    CREATE TABLE t (a);
    INSERT INTO t VALUES (1);
    CREATE TEMP TABLE tt (b);
    SELECT temp.sqlite_master.name FROM (sqlite_temp_schema, t) AS g;
}
expect error {
}

test sqlite-temp-master-star-from-aliased-join {
    CREATE TABLE t (a);
    INSERT INTO t VALUES (1);
    CREATE TEMP TABLE tt (b);
    SELECT type, name, tbl_name FROM (SELECT sqlite_temp_master.* FROM (sqlite_temp_schema, t) AS g);
}
expect {
    table|tt|tt
}

test alias-hides-stored-name-in-aliased-join {
    CREATE TABLE t (a);
    INSERT INTO t VALUES (1);
    SELECT sqlite_master.name FROM (sqlite_master AS sqlite_schema, t) AS g;
}
expect error {
}

test schema-name-alias-qualifies-column-in-aliased-join {
    CREATE TABLE t (a);
    INSERT INTO t VALUES (1);
    SELECT sqlite_schema.name FROM (sqlite_master AS sqlite_schema, t) AS g;
}
expect {
    t
}
