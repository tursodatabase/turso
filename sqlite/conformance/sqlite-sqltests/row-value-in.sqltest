@database :memory:

# Regression tests for row value (tuple) IN expression.
# Previously crashed with "insufficient registers allocated for expression vector write".

setup schema {
    CREATE TABLE t(a INT, b INT, c TEXT);
    INSERT INTO t VALUES (1,10,'x'),(2,20,'y'),(1,20,'z'),(3,30,'w');
}

test row-value-in-literal {
    SELECT (1,2) IN ((1,2),(3,4));
}
expect {
    1
}

test row-value-in-literal-no-match {
    SELECT (1,2) IN ((3,4),(5,6));
}
expect {
    0
}

@setup schema
test row-value-in-where-clause {
    SELECT * FROM t WHERE (a, b) IN ((1,10),(2,20)) ORDER BY a, b;
}
expect {
    1|10|x
    2|20|y
}

@setup schema
test row-value-in-where-no-match {
    SELECT * FROM t WHERE (a, b) IN ((9,9),(8,8)) ORDER BY a, b;
}
expect {
}

@setup schema
test row-value-in-single-element-list {
    SELECT * FROM t WHERE (a, b) IN ((1,10)) ORDER BY a, b;
}
expect {
    1|10|x
}

@setup schema
test row-value-not-in {
    SELECT * FROM t WHERE (a, b) NOT IN ((1,10),(2,20)) ORDER BY a, b;
}
expect {
    1|20|z
    3|30|w
}

test row-value-in-three-columns {
    SELECT (1,2,3) IN ((1,2,3),(4,5,6));
}
expect {
    1
}

test row-value-in-three-columns-no-match {
    SELECT (1,2,3) IN ((1,2,4),(4,5,6));
}
expect {
    0
}

@setup schema
test row-value-in-or-condition {
    SELECT * FROM t WHERE (a, b) IN ((1,10)) OR c = 'w' ORDER BY a, b;
}
expect {
    1|10|x
    3|30|w
}

setup row_value_subquery_schema {
    CREATE TABLE t(a INT, b INT, g INT, c TEXT);
    CREATE TABLE s(x INT, y INT, g INT);
    INSERT INTO t VALUES
        (1, 10, 1, 'm1'),
        (1, 20, 1, 'm2'),
        (2, 20, 2, 'm3'),
        (NULL, 20, 2, 'm4'),
        (3, NULL, 3, 'm5'),
        (NULL, NULL, 3, 'm6');
    INSERT INTO s VALUES
        (1, 10, 1),
        (1, 10, 1),
        (1, NULL, 1),
        (2, 20, 2),
        (NULL, 20, 2),
        (3, NULL, 3),
        (NULL, NULL, 3);
}

@setup row_value_subquery_schema
test row-value-correlated-subquery-in {
    SELECT c
    FROM t
    WHERE (a, b) IN (SELECT x, y FROM s WHERE s.g = t.g)
    ORDER BY c;
}
expect {
    m1
    m3
}

@setup row_value_subquery_schema
test row-value-correlated-subquery-not-in {
    SELECT c
    FROM t
    WHERE (a, b) NOT IN (SELECT x, y FROM s WHERE s.g = t.g)
    ORDER BY c;
}
expect {
}

@setup row_value_subquery_schema
test row-value-left-join-correlated-subquery-in {
    CREATE TABLE u(id INT, a INT, b INT);
    INSERT INTO u VALUES (1, 1, 10), (2, 2, 20), (3, 9, 9);
    SELECT t.c, coalesce(u.id, -1)
    FROM t
    LEFT JOIN u
      ON (t.a, t.b) IN (SELECT x, y FROM s WHERE s.g = t.g)
     AND t.a = u.a
     AND t.b = u.b
    ORDER BY t.c, u.id;
}
expect {
    m1|1
    m2|-1
    m3|2
    m4|-1
    m5|-1
    m6|-1
}

@setup row_value_subquery_schema
test row-value-left-join-correlated-subquery-not-in {
    CREATE TABLE u(id INT, a INT, b INT);
    INSERT INTO u VALUES (1, 1, 10), (2, 2, 20), (3, 9, 9);
    SELECT t.c, coalesce(u.id, -1)
    FROM t
    LEFT JOIN u
      ON (t.a, t.b) NOT IN (SELECT x, y FROM s WHERE s.g = t.g)
     AND t.a = u.a
     AND t.b = u.b
    ORDER BY t.c, u.id;
}
expect {
    m1|-1
    m2|-1
    m3|-1
    m4|-1
    m5|-1
    m6|-1
}

setup row_values_with_null_schema {
    CREATE TABLE w(a, b);
    INSERT INTO w VALUES (NULL,1),(1,1),(2,NULL),(2,2);
}

@setup row_values_with_null_schema
test row-value-filter-nulls-literal-list-in {
    SELECT a, b FROM w WHERE (a,b) IN ((1,1),(2,2)) ORDER BY 1,2;
}
expect {
    1|1
    2|2
}

@setup row_values_with_null_schema
test row-value-filter-nulls-literal-list-not-in {
    SELECT a, b FROM w WHERE (a,b) NOT IN ((1,1),(2,2)) ORDER BY 1,2;
}
expect {
}

@setup row_values_with_null_schema
test row-value-filter-nulls-literal-list-containing-null-in {
    SELECT a, b FROM w WHERE (a,b) IN ((2,NULL),(2,2)) ORDER BY 1,2;
}
expect {
    2|2
}

test row-value-false-null-first-in {
    SELECT ((NULL,1) IN ((1,1))) IS NULL;
}
expect {
    1
}

test row-value-false-null-second-in {
    SELECT ((2,NULL) IN ((2,2))) IS NULL;
}
expect {
    1
}

test row-value-false-null-second-not-in {
    SELECT ((2,NULL) NOT IN ((2,2))) IS NULL;
}
expect {
    1
}

test row-value-false-null-three-values-in {
    SELECT ((1,NULL,3) IN ((1,2,3))) IS NULL;
}
expect {
    1
}

test row-value-false-null-multiple-tuples-in {
    SELECT ((NULL,1) IN ((1,1),(9,9))) IS NULL;
}
expect {
    1
}

test row-value-false-null-multiple-tuples-with-null-in {
   SELECT ((2,2) IN ((2,NULL),(9,9))) IS NULL;
}
expect {
    1
}

test row-value-false-null-multiple-tuples-with-null-not-in {
   SELECT ((2,2) NOT IN ((2,NULL),(9,9))) IS NULL;
}
expect {
    1
}

test row-value-false-null-check-inequality-after-null-in {
   SELECT ((1,2,3) IN ((1,NULL,9))) IS FALSE;
}
expect {
    1
}

test row-value-false-null-check-matches-after-null-in {
   SELECT ((2,2) IN ((2,NULL),(2,2))) IS TRUE;
}
expect {
    1
}

test row-value-null-in-lhs-resolves-to-false-on-mismatch-after-in {
    SELECT (NULL,1) IN ((2,2)) IS FALSE;
}
expect {
    1
}

test row-value-null-in-lhs-resolves-to-true-on-mismatch-after-not-in {
    SELECT (NULL,1) NOT IN ((2,2)) IS TRUE;
}
expect {
    1
}

test row-value-mismatch-in-lhs-resolves-to-false-on-null-after-in {
    SELECT (1,NULL) IN ((2,2)) IS FALSE;
}
expect {
    1
}

test row-value-null-in-lhs-resolves-to-false-on-mismatch-after-multiple-rhs-in {
    SELECT (NULL,1) IN ((2,2),(3,3)) IS FALSE;
}
expect {
    1
}

test row-value-null-in-both-lhs-rhs-in {
    SELECT (NULL,1) IN ((NULL,2)) IS FALSE;
}
expect {
    1
}

test row-in-subquery-evaluates-every-left-column {
    CREATE TABLE pairs(a, b); INSERT INTO pairs VALUES (NULL,400),(NULL,500),(50,400);
    SELECT a,b,(a,b) IN (SELECT 50,500),(a,b) NOT IN (SELECT 50,500) FROM pairs ORDER BY b,a;
}
expect {
    |400|0|1
    50|400|0|1
    |500||
}

test row-in-subquery-evaluates-later-operand-errors {
    CREATE TABLE pairs(a,b);
    INSERT INTO pairs VALUES (NULL,-9223372036854775808);
    SELECT (a,abs(b)) IN (SELECT 1,2) FROM pairs;
}
expect error {.*integer overflow.*}

setup logical_correlated_membership {
    CREATE TABLE outer_rows(id INTEGER, k INTEGER, a, b);
    CREATE TABLE inner_rows(k INTEGER, x, y, enabled INTEGER);
    INSERT INTO outer_rows VALUES
    (1,1,10,100),(2,1,10,100),(3,2,20,200),(4,3,NULL,300),(5,NULL,30,NULL),
    (6,4,40,400),(7,1,99,100),(8,2,20,NULL),(9,4,NULL,400);
    INSERT INTO inner_rows VALUES
    (1,10,100,1),(1,10,100,1),(1,NULL,999,1),(1,99,100,0),
    (2,20,NULL,1),(NULL,30,NULL,1),(3,99,999,0),(4,50,500,1);
}

@setup logical_correlated_membership
test logical-correlated-in-duplicates-and-empty {
    SELECT o.id FROM outer_rows o WHERE o.a IN (SELECT i.x FROM inner_rows i WHERE i.k=o.k AND i.enabled=1) ORDER BY o.id;
}
expect {
    1
    2
    3
    8
}

@setup logical_correlated_membership
test logical-correlated-not-in-nulls-and-empty {
    SELECT o.id FROM outer_rows o WHERE o.a NOT IN (SELECT i.x FROM inner_rows i WHERE i.k=o.k AND i.enabled=1) ORDER BY o.id;
}
expect {
    4
    5
    6
}

@setup logical_correlated_membership
test logical-correlated-row-in-duplicates {
    SELECT o.id FROM outer_rows o WHERE (o.a,o.b) IN (SELECT i.x,i.y FROM inner_rows i WHERE i.k=o.k AND i.enabled=1) ORDER BY o.id;
}
expect {
    1
    2
}

@setup logical_correlated_membership
test logical-correlated-row-not-in-false-and-unknown {
    SELECT o.id FROM outer_rows o WHERE (o.a,o.b) NOT IN (SELECT i.x,i.y FROM inner_rows i WHERE i.k=o.k AND i.enabled=1) ORDER BY o.id;
}
expect {
    4
    5
    6
    7
    9
}

@setup logical_correlated_membership
test logical-correlated-row-in-computed-results {
    SELECT o.id FROM outer_rows o WHERE (o.a+1,o.b) IN (SELECT i.x+1,i.y FROM inner_rows i WHERE i.k<=o.k AND i.enabled=1) ORDER BY o.id;
}
expect {
    1
    2
}

@setup logical_correlated_membership
test logical-correlated-row-not-in-disjunction {
    SELECT o.id FROM outer_rows o WHERE (o.a,o.b) NOT IN (SELECT i.x,i.y FROM inner_rows i WHERE (i.k=o.k OR i.y=o.b) AND i.enabled=1) ORDER BY o.id;
}
expect {
    4
    5
    6
    7
    9
}

@setup logical_correlated_membership
test logical-correlated-not-in-null-equal-key {
    SELECT o.id FROM outer_rows o WHERE o.a NOT IN (SELECT i.x FROM inner_rows i WHERE i.k IS o.k AND i.enabled=1) ORDER BY o.id;
}
expect {
    4
    6
}

setup logical_correlated_membership_types {
    CREATE TABLE typed_outer(id INTEGER, k, grp INTEGER);
    CREATE TABLE typed_inner(k TEXT COLLATE NOCASE, grp INTEGER);
    INSERT INTO typed_outer VALUES (1,1,1),(2,1.0,1),(3,'01',1),(4,'1',1),(5,'a',2),(6,'A',2),(7,NULL,3),(8,x'41',2);
    INSERT INTO typed_inner VALUES ('1',1),('A',2),(NULL,4);
}

@setup logical_correlated_membership_types
test logical-correlated-membership-column-affinity {
    SELECT o.id FROM typed_outer o WHERE o.k IN (SELECT i.k FROM typed_inner i WHERE i.grp=o.grp) ORDER BY o.id;
}
expect {
    4
    6
}

@setup logical_correlated_membership_types
test logical-correlated-membership-computed-left-collation {
    SELECT o.id FROM typed_outer o WHERE o.k||'' IN (SELECT i.k COLLATE NOCASE FROM typed_inner i WHERE i.grp=o.grp) ORDER BY o.id;
}
expect {
    1
    4
    5
    6
    8
}

@setup logical_correlated_membership_types
test logical-correlated-not-in-computed-left-collation {
    SELECT o.id FROM typed_outer o WHERE o.k||'' NOT IN (SELECT i.k COLLATE NOCASE FROM typed_inner i WHERE i.grp=o.grp) ORDER BY o.id;
}
expect {
    2
    3
    7
}

@setup logical_correlated_membership
test correlated-not-in-constant-result {
    SELECT o.id FROM outer_rows o WHERE o.a NOT IN (SELECT 10 FROM inner_rows i WHERE i.k=o.k AND i.enabled=1) ORDER BY o.id;
}
expect {
    3
    4
    5
    6
    7
    8
}

@setup logical_correlated_membership
test independent-not-in-constant-result {
    SELECT o.id FROM outer_rows o WHERE o.a NOT IN (SELECT 10 FROM inner_rows i WHERE i.enabled=1) ORDER BY o.id;
}
expect {
    3
    5
    6
    7
    8
}

@setup logical_correlated_membership
test correlated-row-not-in-constant-component {
    SELECT o.id FROM outer_rows o WHERE (o.a,o.b) NOT IN (SELECT i.x,100 FROM inner_rows i WHERE i.k=o.k AND i.enabled=1) ORDER BY o.id;
}
expect {
    3
    4
    5
    6
    9
}

setup membership_nullable_columns {
    CREATE TABLE outer_rows(id INTEGER PRIMARY KEY, k INTEGER NOT NULL, a INTEGER NOT NULL, b INTEGER);
    CREATE TABLE inner_rows(k INTEGER NOT NULL, x INTEGER NOT NULL, y INTEGER);
    INSERT INTO outer_rows VALUES (1,1,10,100), (2,1,20,NULL), (3,2,30,300), (4,3,40,NULL), (5,2,10,100);
    INSERT INTO inner_rows VALUES (1,10,100), (1,20,NULL), (1,60,200), (2,30,NULL);
}

@setup membership_nullable_columns
test correlated-not-in-required-columns {
    SELECT o.id FROM outer_rows o WHERE o.a NOT IN (SELECT i.x FROM inner_rows i WHERE i.k=o.k) ORDER BY o.id;
}
expect {
    4
    5
}

@setup membership_nullable_columns
test correlated-not-in-nullable-right {
    SELECT o.id FROM outer_rows o WHERE o.a NOT IN (SELECT i.y FROM inner_rows i WHERE i.k=o.k) ORDER BY o.id;
}
expect {
    4
}

@setup membership_nullable_columns
test correlated-not-in-nullable-left {
    SELECT o.id FROM outer_rows o WHERE o.b NOT IN (SELECT i.x FROM inner_rows i WHERE i.k=o.k) ORDER BY o.id;
}
expect {
    1
    3
    4
    5
}

@setup membership_nullable_columns
test correlated-not-in-nullable-columns {
    SELECT o.id FROM outer_rows o WHERE o.b NOT IN (SELECT i.y FROM inner_rows i WHERE i.k=o.k) ORDER BY o.id;
}
expect {
    4
}

@setup membership_nullable_columns
test correlated-row-not-in-required-and-nullable-columns {
    SELECT o.id FROM outer_rows o WHERE (o.a,o.b) NOT IN (SELECT i.x,i.y FROM inner_rows i WHERE i.k=o.k) ORDER BY o.id;
}
expect {
    4
    5
}

@setup logical_correlated_membership
test in-outer-projection {
    SELECT o.id FROM outer_rows o WHERE o.a+1 IN (SELECT i.x+o.k FROM inner_rows i WHERE i.k=o.k AND i.enabled=1) ORDER BY o.id;
}
expect {
    1
    2
}

@setup logical_correlated_membership
test not-in-outer-projection {
    SELECT o.id FROM outer_rows o WHERE o.a+1 NOT IN (SELECT i.x+o.k FROM inner_rows i WHERE i.k=o.k AND i.enabled=1) ORDER BY o.id;
}
expect {
    3
    4
    5
    6
    8
}

@setup logical_correlated_membership
test row-in-outer-projection {
    SELECT o.id FROM outer_rows o WHERE (o.a+1,o.b) IN (SELECT i.x+o.k,i.y FROM inner_rows i WHERE i.k=o.k AND i.enabled=1) ORDER BY o.id;
}
expect {
    1
    2
}

@setup logical_correlated_membership
test row-not-in-outer-projection {
    SELECT o.id FROM outer_rows o WHERE (o.a+1,o.b) NOT IN (SELECT i.x+o.k,i.y FROM inner_rows i WHERE i.k=o.k AND i.enabled=1) ORDER BY o.id;
}
expect {
    3
    4
    5
    6
    7
    8
    9
}

@setup logical_correlated_membership
test in-outer-projection-without-filter {
    SELECT o.id FROM outer_rows o WHERE o.a+o.k IN (SELECT i.x+o.k FROM inner_rows i) ORDER BY o.id;
}
expect {
    1
    2
    3
    7
    8
}

@setup logical_correlated_membership
test not-in-outer-projection-without-filter {
    SELECT o.id FROM outer_rows o WHERE o.k+5 NOT IN (SELECT i.enabled+o.k FROM inner_rows i) ORDER BY o.id;
}
expect {
    1
    2
    3
    4
    6
    7
    8
    9
}

@setup logical_correlated_membership
test not-in-outer-projection-empty-input {
    DELETE FROM inner_rows; SELECT o.id FROM outer_rows o WHERE o.a NOT IN (SELECT i.x+o.k FROM inner_rows i) ORDER BY o.id;
}
expect {
    1
    2
    3
    4
    5
    6
    7
    8
    9
}

@setup logical_correlated_membership
test in-projection-reads-only-outer-value {
    SELECT o.id FROM outer_rows o WHERE o.a IN (SELECT o.a FROM inner_rows i WHERE i.k=o.k AND i.enabled=1) ORDER BY o.id;
}
expect {
    1
    2
    3
    6
    7
    8
}

@setup logical_correlated_membership
test not-in-projection-reads-only-outer-value {
    SELECT o.id FROM outer_rows o WHERE o.a NOT IN (SELECT o.a FROM inner_rows i WHERE i.k=o.k AND i.enabled=1) ORDER BY o.id;
}
expect {
    4
    5
}

@setup logical_correlated_membership_types
test in-outer-projection-collation {
    SELECT o.id FROM typed_outer o WHERE o.k IN (SELECT (CASE WHEN o.grp>0 THEN i.k ELSE o.k END) COLLATE NOCASE FROM typed_inner i WHERE i.grp=o.grp) ORDER BY o.id;
}
expect {
    4
    5
    6
}

@setup logical_correlated_membership_types
test not-in-outer-projection-collation {
    SELECT o.id FROM typed_outer o WHERE o.k NOT IN (SELECT (CASE WHEN o.grp>0 THEN i.k ELSE o.k END) COLLATE NOCASE FROM typed_inner i WHERE i.grp=o.grp) ORDER BY o.id;
}
expect {
    1
    2
    3
    7
    8
}

test outer-projection-integer-overflow {
    CREATE TABLE outer_values(id INTEGER, k INTEGER, a INTEGER);
    CREATE TABLE inner_values(x INTEGER);
    INSERT INTO outer_values VALUES (1,1,9223372036854775807),(2,NULL,0);
    INSERT INTO inner_values VALUES (9223372036854775807);
    SELECT o.id FROM outer_values o WHERE o.a+o.k IN (SELECT i.x+o.k FROM inner_values i) ORDER BY o.id;
}
expect {
    1
}
