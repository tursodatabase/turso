@database :memory:

# Regression tests for row value (tuple) IN expression.
# Previously crashed with "insufficient registers allocated for expression vector write".

setup schema {
    CREATE TABLE t(a INT, b INT, c TEXT);
    INSERT INTO t VALUES (1,10,'x'),(2,20,'y'),(1,20,'z'),(3,30,'w');
}

test row-value-in-literal {
    SELECT (1,2) IN ((1,2),(3,4));
}
expect {
    1
}

test row-value-in-literal-no-match {
    SELECT (1,2) IN ((3,4),(5,6));
}
expect {
    0
}

@setup schema
test row-value-in-where-clause {
    SELECT * FROM t WHERE (a, b) IN ((1,10),(2,20)) ORDER BY a, b;
}
expect {
    1|10|x
    2|20|y
}

@setup schema
test row-value-in-where-no-match {
    SELECT * FROM t WHERE (a, b) IN ((9,9),(8,8)) ORDER BY a, b;
}
expect {
}

@setup schema
test row-value-in-single-element-list {
    SELECT * FROM t WHERE (a, b) IN ((1,10)) ORDER BY a, b;
}
expect {
    1|10|x
}

@setup schema
test row-value-not-in {
    SELECT * FROM t WHERE (a, b) NOT IN ((1,10),(2,20)) ORDER BY a, b;
}
expect {
    1|20|z
    3|30|w
}

test row-value-in-three-columns {
    SELECT (1,2,3) IN ((1,2,3),(4,5,6));
}
expect {
    1
}

test row-value-in-three-columns-no-match {
    SELECT (1,2,3) IN ((1,2,4),(4,5,6));
}
expect {
    0
}

@setup schema
test row-value-in-or-condition {
    SELECT * FROM t WHERE (a, b) IN ((1,10)) OR c = 'w' ORDER BY a, b;
}
expect {
    1|10|x
    3|30|w
}

setup row_value_subquery_schema {
    CREATE TABLE t(a INT, b INT, g INT, c TEXT);
    CREATE TABLE s(x INT, y INT, g INT);
    INSERT INTO t VALUES
        (1, 10, 1, 'm1'),
        (1, 20, 1, 'm2'),
        (2, 20, 2, 'm3'),
        (NULL, 20, 2, 'm4'),
        (3, NULL, 3, 'm5'),
        (NULL, NULL, 3, 'm6');
    INSERT INTO s VALUES
        (1, 10, 1),
        (1, 10, 1),
        (1, NULL, 1),
        (2, 20, 2),
        (NULL, 20, 2),
        (3, NULL, 3),
        (NULL, NULL, 3);
}

@setup row_value_subquery_schema
test row-value-correlated-subquery-in {
    SELECT c
    FROM t
    WHERE (a, b) IN (SELECT x, y FROM s WHERE s.g = t.g)
    ORDER BY c;
}
expect {
    m1
    m3
}

@setup row_value_subquery_schema
test row-value-correlated-subquery-not-in {
    SELECT c
    FROM t
    WHERE (a, b) NOT IN (SELECT x, y FROM s WHERE s.g = t.g)
    ORDER BY c;
}
expect {
}

@setup row_value_subquery_schema
test row-value-left-join-correlated-subquery-in {
    CREATE TABLE u(id INT, a INT, b INT);
    INSERT INTO u VALUES (1, 1, 10), (2, 2, 20), (3, 9, 9);
    SELECT t.c, coalesce(u.id, -1)
    FROM t
    LEFT JOIN u
      ON (t.a, t.b) IN (SELECT x, y FROM s WHERE s.g = t.g)
     AND t.a = u.a
     AND t.b = u.b
    ORDER BY t.c, u.id;
}
expect {
    m1|1
    m2|-1
    m3|2
    m4|-1
    m5|-1
    m6|-1
}

@setup row_value_subquery_schema
test row-value-left-join-correlated-subquery-not-in {
    CREATE TABLE u(id INT, a INT, b INT);
    INSERT INTO u VALUES (1, 1, 10), (2, 2, 20), (3, 9, 9);
    SELECT t.c, coalesce(u.id, -1)
    FROM t
    LEFT JOIN u
      ON (t.a, t.b) NOT IN (SELECT x, y FROM s WHERE s.g = t.g)
     AND t.a = u.a
     AND t.b = u.b
    ORDER BY t.c, u.id;
}
expect {
    m1|-1
    m2|-1
    m3|-1
    m4|-1
    m5|-1
    m6|-1
}

setup row_values_with_null_schema {
    CREATE TABLE w(a, b);
    INSERT INTO w VALUES (NULL,1),(1,1),(2,NULL),(2,2);
}

@setup row_values_with_null_schema
test row-value-filter-nulls-literal-list-in {
    SELECT a, b FROM w WHERE (a,b) IN ((1,1),(2,2)) ORDER BY 1,2;
}
expect {
    1|1
    2|2
}

@setup row_values_with_null_schema
test row-value-filter-nulls-literal-list-not-in {
    SELECT a, b FROM w WHERE (a,b) NOT IN ((1,1),(2,2)) ORDER BY 1,2;
}
expect {
}

@setup row_values_with_null_schema
test row-value-filter-nulls-literal-list-containing-null-in {
    SELECT a, b FROM w WHERE (a,b) IN ((2,NULL),(2,2)) ORDER BY 1,2;
}
expect {
    2|2
}

test row-value-false-null-first-in {
    SELECT ((NULL,1) IN ((1,1))) IS NULL;
}
expect {
    1
}

test row-value-false-null-second-in {
    SELECT ((2,NULL) IN ((2,2))) IS NULL;
}
expect {
    1
}

test row-value-false-null-second-not-in {
    SELECT ((2,NULL) NOT IN ((2,2))) IS NULL;
}
expect {
    1
}

test row-value-false-null-three-values-in {
    SELECT ((1,NULL,3) IN ((1,2,3))) IS NULL;
}
expect {
    1
}

test row-value-false-null-multiple-tuples-in {
    SELECT ((NULL,1) IN ((1,1),(9,9))) IS NULL;
}
expect {
    1
}

test row-value-false-null-multiple-tuples-with-null-in {
   SELECT ((2,2) IN ((2,NULL),(9,9))) IS NULL;
}
expect {
    1
}

test row-value-false-null-multiple-tuples-with-null-not-in {
   SELECT ((2,2) NOT IN ((2,NULL),(9,9))) IS NULL;
}
expect {
    1
}

test row-value-false-null-check-inequality-after-null-in {
   SELECT ((1,2,3) IN ((1,NULL,9))) IS FALSE;
}
expect {
    1
}

test row-value-false-null-check-matches-after-null-in {
   SELECT ((2,2) IN ((2,NULL),(2,2))) IS TRUE;
}
expect {
    1
}

test row-value-null-in-lhs-resolves-to-false-on-mismatch-after-in {
    SELECT (NULL,1) IN ((2,2)) IS FALSE;
}
expect {
    1
}

test row-value-null-in-lhs-resolves-to-true-on-mismatch-after-not-in {
    SELECT (NULL,1) NOT IN ((2,2)) IS TRUE;
}
expect {
    1
}

test row-value-mismatch-in-lhs-resolves-to-false-on-null-after-in {
    SELECT (1,NULL) IN ((2,2)) IS FALSE;
}
expect {
    1
}

test row-value-null-in-lhs-resolves-to-false-on-mismatch-after-multiple-rhs-in {
    SELECT (NULL,1) IN ((2,2),(3,3)) IS FALSE;
}
expect {
    1
}

test row-value-null-in-both-lhs-rhs-in {
    SELECT (NULL,1) IN ((NULL,2)) IS FALSE;
}
expect {
    1
}

# SQLite reads a list of row values as a VALUES, so each column compares with
# the collation and the affinity of the left operand's component first, else
# of the component in the last row; the other rows bring neither.
test row-value-in-list-compares-with-the-last-row-collation {
    CREATE TABLE c(a TEXT COLLATE NOCASE);
    INSERT INTO c VALUES('A');
    SELECT ('a', 1) IN (('A', 1), ('x' COLLATE NOCASE, 2)), ('a', 1) IN (('x' COLLATE NOCASE, 2), ('A', 1)), ('a', 1) IN (('A', 1), ('x', 2));
    SELECT ('a' COLLATE NOCASE, 1) IN (('A', 1), ('x', 2)), ('a', 1) IN (('A' COLLATE NOCASE, 1)), ('a', 1) IN (('q', 3), ('A', 1), ('x' COLLATE NOCASE, 2));
    SELECT (a, 1) IN (('a' COLLATE BINARY, 1), ('z', 2)), ('a', 1) IN ((a, 1), ('z', 2)), ('a', 1) IN (('z', 2), (a, 1)) FROM c;
}
expect {
    1|0|0
    1|1|1
    1|0|1
}

test row-value-in-list-compares-with-the-last-row-affinity {
    SELECT (1, 2) IN ((CAST('1' AS TEXT), 2), (CAST('x' AS BLOB), 3)), (1, 2) IN ((CAST('x' AS BLOB), 3), (CAST('1' AS TEXT), 2)), (1, 2) IN ((CAST('1' AS TEXT), 2));
    SELECT (1, 2) IN ((CAST('1' AS TEXT), 2), ('x', 3)), (1, 2) IN (('x', 3), (CAST('1' AS TEXT), 2)), (1, 2) IN (('1', 2), ('x', 3));
}
expect {
    0|1|1
    0|1|0
}

# When a NULL keeps a row from matching, SQLite answers NULL only if the other
# components are equal with the left operand's own collation, not with the
# collation the last row gave the comparison.
test row-value-in-list-null-row-uses-the-left-collation {
    CREATE TABLE c(a TEXT COLLATE NOCASE);
    INSERT INTO c VALUES('A');
    SELECT ('a', NULL) IN (('A', 1), ('x' COLLATE NOCASE, 2)), ('a', NULL) IN (('a', 1), ('x' COLLATE NOCASE, 2)), ('a' COLLATE NOCASE, NULL) IN (('A', 1), ('x', 2));
    SELECT ('a', 1) IN (('A', NULL), ('z' COLLATE NOCASE, 2)), ('a', 1) IN (('a', NULL), ('z' COLLATE NOCASE, 2)), ('a', 1) NOT IN (('A', NULL), ('z' COLLATE NOCASE, 2)), ('a', 1) NOT IN (('a', NULL), ('z' COLLATE NOCASE, 2));
    SELECT (NULL, 1) IN (('A', 1), ('x' COLLATE NOCASE, 2)), (NULL, 1) IN (('A', 2), ('x' COLLATE NOCASE, 2)), ('a', NULL) IN (('x' COLLATE NOCASE, 2), ('A', 1));
    SELECT (a, NULL) IN (('a', 1), ('z', 2)), ('a', NULL) IN ((a, 1), ('z', 2)), ('a', NULL) IN (('z', 2), (a, 1)) FROM c;
}
expect {
    0||
    0||1|
    |0|0
    |0|0
}

# A row value BETWEEN compares component by component, in a result column as
# well as in WHERE; the left side is evaluated once and copied whole.
test row-value-between-compares-each-component {
    CREATE TABLE n(a, b);
    INSERT INTO n VALUES (1, 2);
    SELECT (1, 2) BETWEEN (0, 0) AND (3, 3), (1, 2) NOT BETWEEN (0, 0) AND (3, 3), (4, 2) BETWEEN (0, 0) AND (3, 3);
    SELECT (1, 2) BETWEEN (1, 2) AND (1, 2), (1, NULL) BETWEEN (0, 0) AND (3, 3), (1, 2) BETWEEN (1, 3) AND (1, 1);
    SELECT (a, b) BETWEEN (0, 0) AND (3, 3), (a, b) NOT BETWEEN (1, 2) AND (1, 2), (a, b) BETWEEN (a, b) AND (a, b + 1) FROM n;
    SELECT (1, 'b') BETWEEN (1, 'a') AND (1, 'c'), (1, 'B') BETWEEN (1, 'a') AND (1, 'c'), (1, 'B' COLLATE NOCASE) BETWEEN (1, 'a') AND (1, 'c');
    SELECT (SELECT 1, 2) BETWEEN (0, 0) AND (3, 3), (1, 2, 3) BETWEEN (0, 0, 0) AND (3, 3, 3), CASE WHEN (1, 2) BETWEEN (0, 0) AND (3, 3) THEN 'y' ELSE 'n' END;
}
expect {
    1|0|0
    1|1|0
    1|0|1
    1|0|1
    1|1|y
}
# In a list of two or more items a subquery is one term, as in SQLite; only
# `x IN (SELECT ...)` and a list with that single subquery compare columns.
test row-value-in-list-subquery-item-is-one-term {
    SELECT ('a', 1) IN (('z', 2), (SELECT 'a', 1));
}
expect error {
    element has 1 term - expected 2
}

test row-value-in-list-single-subquery-item-compares-columns {
    SELECT ('a', 1) IN ((SELECT 'a', 1)), ('a', 1) IN ((SELECT 'z', 1)), 'a' IN ((SELECT 'a'), 'z');
}
expect {
    1|0|1
}

test scalar-in-list-subquery-item-with-two-columns-is-an-error {
    SELECT 'a' IN ((SELECT 'a', 1), 'z');
}
expect error {
    sub-select returns 2 columns - expected 1
}
