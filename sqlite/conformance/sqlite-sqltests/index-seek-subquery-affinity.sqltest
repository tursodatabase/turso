@database :memory:

# Comparing a TEXT column against a scalar subquery over an INTEGER column
# uses numeric comparison affinity, so the integer keeps its type and sorts
# before every text value (SQLite's sqlite3CompareAffinity). When the TEXT
# column had a UNIQUE index, Turso's index seek ignored the subquery's column
# affinity, fell back to the TEXT side's affinity, converted the integer to
# text, and compared '4x' < '602393' as strings — returning rows SQLite does
# not.

@cross-check-integrity
test text-index-less-than-integer-subquery-matches-nothing {
    CREATE TABLE a(t TEXT UNIQUE);
    INSERT INTO a VALUES ('4x');
    CREATE TABLE b(i INTEGER);
    INSERT INTO b VALUES (602393);
    SELECT 1 FROM a WHERE t < (SELECT i FROM b);
}
expect {
}

@cross-check-integrity
test text-index-greater-than-integer-subquery-matches-all {
    CREATE TABLE a(t TEXT UNIQUE);
    INSERT INTO a VALUES ('4x');
    CREATE TABLE b(i INTEGER);
    INSERT INTO b VALUES (602393);
    SELECT 1 FROM a WHERE t > (SELECT i FROM b);
}
expect {
    1
}

# A bare integer literal has no affinity of its own, so the TEXT side wins and
# the comparison happens as text: '4x' < '602393'. This must keep working.
@cross-check-integrity
test text-index-less-than-integer-literal-compares-as-text {
    CREATE TABLE a(t TEXT UNIQUE);
    INSERT INTO a VALUES ('4x');
    SELECT 1 FROM a WHERE t < 602393;
}
expect {
    1
}

# Comparing a TEXT column with a scalar subquery that reads an INTEGER column
# applies numeric affinity to the TEXT value, so an index on that column
# cannot be used to find it.
setup text_index_integer_subquery {
    CREATE TABLE t(x TEXT);
    CREATE TABLE u(k INTEGER);
    INSERT INTO t VALUES ('20');
    INSERT INTO u VALUES (20);
    CREATE INDEX i ON t(x);
}

@setup text_index_integer_subquery
test indexed-text-column-compared-with-integer-subquery {
    SELECT (SELECT count(*) FROM t WHERE x = (SELECT k FROM u)),
           (SELECT count(*) FROM t WHERE (SELECT k FROM u) = x),
           (SELECT count(*) FROM t WHERE x > (SELECT k FROM u)),
           (SELECT count(*) FROM t WHERE x >= (SELECT k FROM u));
}
expect {
    1|1|0|1
}

@setup text_index_integer_subquery
test delete-through-indexed-text-column-compared-with-integer-subquery {
    DELETE FROM t WHERE x = (SELECT k FROM u);
    SELECT count(*) FROM t;
}
expect {
    0
}

@setup text_index_integer_subquery
test update-through-indexed-text-column-compared-with-integer-subquery {
    UPDATE t SET x = 'changed' WHERE x = (SELECT k FROM u);
    SELECT x FROM t;
}
expect {
    changed
}

# The optimizer moves these subqueries into the outer query as a semi-join or an
# anti-join, and the comparison must keep the scalar subquery's affinity.
setup correlated_text_index_integer_subquery {
    CREATE TABLE t(x TEXT, v INT);
    CREATE INDEX i ON t(x);
    INSERT INTO t VALUES ('20', 1);
    CREATE TABLE u(k INTEGER);
    INSERT INTO u VALUES (20);
    CREATE TABLE b(y INT);
    INSERT INTO b VALUES (1);
}

@setup correlated_text_index_integer_subquery
test correlated-exists-through-indexed-text-column-compared-with-integer-subquery {
    SELECT count(*) FROM b
    WHERE EXISTS (SELECT 1 FROM t WHERE x = (SELECT k FROM u) AND v = b.y);
}
expect {
    1
}

@setup correlated_text_index_integer_subquery
test correlated-not-exists-through-indexed-text-column-compared-with-integer-subquery {
    SELECT count(*) FROM b
    WHERE NOT EXISTS (SELECT 1 FROM t WHERE x = (SELECT k FROM u) AND v = b.y);
}
expect {
    0
}

@setup correlated_text_index_integer_subquery
test correlated-in-through-indexed-text-column-compared-with-integer-subquery {
    SELECT count(*) FROM b
    WHERE y IN (SELECT v FROM t WHERE x = (SELECT k FROM u) AND v = b.y);
}
expect {
    1
}

@setup correlated_text_index_integer_subquery
test aggregate-subquery-through-indexed-text-column-compared-with-integer-subquery {
    SELECT y, (SELECT count(*) FROM t WHERE x = (SELECT k FROM u) AND v = b.y) FROM b;
}
expect {
    1|1
}

# A column of a derived table, CTE or view that holds a scalar subquery has the
# affinity of the column that subquery selects.
setup scalar_subquery_column_values {
    CREATE TABLE t(x TEXT);
    INSERT INTO t VALUES ('20');
}

@setup scalar_subquery_column_values
test derived-table-column-holding-scalar-subquery-keeps-affinity {
    SELECT q = 20, q IN (20), q IN (SELECT 20)
    FROM (SELECT (SELECT x FROM t) AS q);
}
expect {
    1|1|1
}

@setup scalar_subquery_column_values
test derived-table-column-holding-scalar-subquery-in-where {
    SELECT q FROM (SELECT (SELECT x FROM t) AS q) WHERE q = 20;
}
expect {
    20
}

@setup scalar_subquery_column_values
test cte-column-holding-scalar-subquery-keeps-affinity {
    WITH c AS (SELECT (SELECT x FROM t) AS q) SELECT q = 20 FROM c;
}
expect {
    1
}

@setup scalar_subquery_column_values
test view-column-holding-scalar-subquery-keeps-affinity {
    CREATE VIEW v AS SELECT (SELECT x FROM t) AS q;
    SELECT q = 20 FROM v;
}
expect {
    1
}

@setup scalar_subquery_column_values
test compound-column-holding-scalar-subquery-keeps-affinity {
    SELECT q = 20 FROM (SELECT (SELECT x FROM t) AS q UNION ALL SELECT (SELECT x FROM t));
}
expect {
    1
    1
}
