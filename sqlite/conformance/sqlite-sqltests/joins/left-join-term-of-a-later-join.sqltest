@database :memory:

# A term of a join after a LEFT JOIN that names the LEFT JOIN's right table
# must not decide whether a left row matched. Here `t1.b = t2.b` is the
# LEFT JOIN's only condition; `t2.a IS t3.a` belongs to the next join. Row
# t1.id = 1 matches t2 on b, so it gets no NULL-extended row even for t3
# rows where `t2.a IS t3.a` fails; row t1.id = 3 matches no t2 row, so its
# NULL t2.a pairs with the t3 row whose a is NULL. Without an index on b
# the LEFT JOIN runs as a hash join whose probe table is t2.
setup left-join-later-term-schema {
    CREATE TABLE t1 (id INT PRIMARY KEY, a INT, b INT);
    CREATE TABLE t2 (id INT PRIMARY KEY, a INT, b INT);
    CREATE TABLE t3 (id INT PRIMARY KEY, a INT, d INT);
    INSERT INTO t1 VALUES (1, 1, 10), (2, 2, 20), (3, 3, 30);
    INSERT INTO t2 VALUES (100, 1, 10), (200, 5, 20);
    INSERT INTO t3 VALUES (1000, NULL, 8), (1001, 1, 8), (1002, 7, 9);
}

@setup left-join-later-term-schema
test left-join-then-join-on-right-table-column {
    SELECT t1.id, t2.id, t3.a FROM t1 LEFT JOIN t2 ON t1.b = t2.b
    JOIN t3 ON t2.a IS t3.a WHERE t3.d IS 8 ORDER BY 1, 2, 3;
}
expect {
1|100|1
3||
}

@setup left-join-later-term-schema
test left-join-then-where-on-right-table-column {
    SELECT t1.id, t2.id FROM t1 LEFT JOIN t2 ON t1.b = t2.b, t3
    WHERE t2.a IS t3.a AND t3.d IS 8 ORDER BY 1, 2;
}
expect {
1|100
3|
}

@setup left-join-later-term-schema
test left-join-then-join-on-two-columns {
    SELECT t1.id, t2.id, t3.id FROM t1 LEFT JOIN t2 ON t1.a = t2.a AND t1.b = t2.b
    JOIN t3 ON t2.a IS t3.a ORDER BY 1, 2, 3;
}
expect {
1|100|1001
2||1000
3||1000
}
