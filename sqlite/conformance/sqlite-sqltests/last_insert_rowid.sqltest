@database :memory:

@cross-check-integrity
test last-insert-rowid-unchanged-after-update {
    CREATE TABLE t1(id INTEGER PRIMARY KEY, val TEXT);
    INSERT INTO t1 VALUES (1, 'a');
    INSERT INTO t1 VALUES (5, 'b');
    INSERT INTO t1(val) VALUES ('c');
    SELECT last_insert_rowid();
    UPDATE t1 SET val = 'updated' WHERE id = 1;
    SELECT last_insert_rowid();
    UPDATE t1 SET id = id + 10 WHERE id = 1;
    SELECT last_insert_rowid();
}
expect {
    6
    6
    6
}

@cross-check-integrity
test last-insert-rowid-unchanged-after-upsert-update {
    CREATE TABLE t1(id INTEGER PRIMARY KEY, val TEXT);
    INSERT INTO t1 VALUES (1, 'a');
    INSERT INTO t1 VALUES (5, 'b');
    INSERT INTO t1(val) VALUES ('c');
    SELECT last_insert_rowid();
    INSERT INTO t1(id, val) VALUES (1, 'updated')
        ON CONFLICT(id) DO UPDATE SET val = excluded.val;
    SELECT last_insert_rowid();
}
expect {
    6
    6
}

@cross-check-integrity
test last-insert-rowid-after-insert-returning {
    CREATE TABLE t1(a INTEGER PRIMARY KEY, b TEXT);

    INSERT INTO t1 VALUES(10, 'a');
    SELECT last_insert_rowid();

    INSERT INTO t1 VALUES(20, 'b') RETURNING last_insert_rowid();
    SELECT last_insert_rowid();

    INSERT INTO t1 VALUES(50, 'c') RETURNING *;
    SELECT last_insert_rowid();
}
expect {
    10
    20
    20
    50|c
    50
}

@cross-check-integrity
test last-insert-rowid-unchanged-after-create-table-as-select {
    CREATE TABLE t1(a INTEGER PRIMARY KEY);
    INSERT INTO t1 VALUES (5), (10), (15);
    INSERT INTO t1 VALUES (7);
    CREATE TABLE c1 AS SELECT * FROM t1;
    SELECT last_insert_rowid();
    CREATE TEMP TABLE c2 AS SELECT * FROM t1 WHERE a > 5;
    SELECT last_insert_rowid();
    CREATE TABLE c3 AS SELECT a, last_insert_rowid() AS r FROM t1;
    SELECT * FROM c3;
}
expect {
    7
    7
    5|7
    7|7
    10|7
    15|7
}

@cross-check-integrity
test last-insert-rowid-unchanged-after-analyze {
    CREATE TABLE t1(a INTEGER PRIMARY KEY, b);
    CREATE INDEX i1 ON t1(b);
    CREATE TABLE t2(x);
    INSERT INTO t1 VALUES (5, 1), (10, 2), (15, 3);
    INSERT INTO t2 VALUES (1);
    INSERT INTO t1 VALUES (7, 4);
    ANALYZE t1;
    SELECT last_insert_rowid();
    ANALYZE t2;
    SELECT last_insert_rowid();
    ANALYZE;
    SELECT last_insert_rowid();
}
expect {
    7
    7
    7
}

@cross-check-integrity
test last-insert-rowid-unchanged-after-drop-column {
    CREATE TABLE t1(a INTEGER PRIMARY KEY, b, c);
    INSERT INTO t1 VALUES (5, 1, 2), (10, 3, 4), (15, 5, 6);
    INSERT INTO t1 VALUES (7, 8, 9);
    ALTER TABLE t1 DROP COLUMN c;
    SELECT last_insert_rowid();
}
expect {
    7
}

@skip-if mvcc "CDC not supported in MVCC mode"
test last-insert-rowid-unchanged-by-cdc-internal-inserts {
    CREATE TABLE t1(id INTEGER PRIMARY KEY, val TEXT);
    PRAGMA capture_data_changes_conn = 'full';
    INSERT INTO t1 VALUES (42, 'hello');
    SELECT last_insert_rowid();
}
expect {
    42
}
