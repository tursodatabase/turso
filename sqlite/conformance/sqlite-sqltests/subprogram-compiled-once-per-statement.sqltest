@database :memory:

# A statement compiles each foreign-key action once and calls that program
# from every place it fires, including inside other actions. Turso used to
# compile a new copy at every place, so the program grew exponentially with
# the number of actions that fire each other.

# Each cascade on t runs an UPDATE or DELETE on t, which fires all eight
# actions again.
test fk-actions-that-fire-each-other-compile-once {
    PRAGMA foreign_keys=ON;
    CREATE TABLE t(
        id INTEGER PRIMARY KEY,
        c1 INTEGER REFERENCES t(id) ON DELETE CASCADE ON UPDATE CASCADE,
        c2 INTEGER REFERENCES t(id) ON DELETE CASCADE ON UPDATE CASCADE,
        c3 INTEGER REFERENCES t(id) ON DELETE CASCADE ON UPDATE CASCADE,
        c4 INTEGER REFERENCES t(id) ON DELETE CASCADE ON UPDATE CASCADE,
        c5 INTEGER REFERENCES t(id) ON DELETE CASCADE ON UPDATE CASCADE,
        c6 INTEGER REFERENCES t(id) ON DELETE CASCADE ON UPDATE CASCADE,
        c7 INTEGER REFERENCES t(id) ON DELETE CASCADE ON UPDATE CASCADE,
        c8 INTEGER REFERENCES t(id) ON DELETE CASCADE ON UPDATE CASCADE
    );
    INSERT INTO t(id) VALUES(1);
    INSERT INTO t(id, c1) VALUES(2, 1);
    INSERT INTO t(id, c4, c8) VALUES(3, 1, 2);
    INSERT INTO t(id, c8) VALUES(4, 3);
    INSERT INTO t(id) VALUES(5);
    UPDATE t SET id = 10 WHERE id = 1;
    SELECT id, c1, c4, c8 FROM t ORDER BY id;
    DELETE FROM t WHERE id = 10;
    SELECT id FROM t;
}
expect {
    2|10||
    3||10|2
    4|||3
    5|||
    10|||
    5
}

setup table_with_two_self_cascades {
    PRAGMA foreign_keys=ON;
    CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER REFERENCES t(id) ON DELETE CASCADE, b INTEGER REFERENCES t(id) ON DELETE CASCADE);
}

# Each action appears as one subprogram. The action for b is compiled inside
# the action for a, and the DELETE calls that same program.
@skip-if mvcc "mvcc has different root pages"
@setup table_with_two_self_cascades
snapshot fk-actions-that-fire-each-other-are-one-subprogram-each {
    DELETE FROM t WHERE id = 1;
}
