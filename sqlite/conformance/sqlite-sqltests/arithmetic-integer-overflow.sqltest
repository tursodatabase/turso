@database :memory:

# Integer +, - and * whose result an i64 cannot hold give a REAL, and that REAL
# is what the same operation on the two operands as floats gives. Each test
# states that equality rather than printing the value, so it says what the
# answer is without depending on how a float is formatted.

test add-two-integers {
    SELECT 1 + 2, typeof(1 + 2), 5 - 3, typeof(5 - 3), 6 * 7, typeof(6 * 7);
}
expect {
    3|integer|2|integer|42|integer
}

test add-past-i64-max {
    SELECT typeof(9223372036854775807 + 1),
           (9223372036854775807 + 1) = (9223372036854775807.0 + 1.0);
}
expect {
    real|1
}

test add-two-i64-maxima {
    SELECT typeof(9223372036854775807 + 9223372036854775807),
           (9223372036854775807 + 9223372036854775807)
               = (9223372036854775807.0 + 9223372036854775807.0);
}
expect {
    real|1
}

test subtract-past-i64-min {
    SELECT typeof(-9223372036854775807 - 2),
           (-9223372036854775807 - 2) = (-9223372036854775807.0 - 2.0);
}
expect {
    real|1
}

test subtract-from-i64-min {
    SELECT typeof(-9223372036854775808 - 1),
           (-9223372036854775808 - 1) = (-9223372036854775808.0 - 1.0);
}
expect {
    real|1
}

test multiply-past-i64-max {
    SELECT typeof(9223372036854775807 * 2),
           (9223372036854775807 * 2) = (9223372036854775807.0 * 2.0);
}
expect {
    real|1
}

# One more than i64::MAX, the smallest product that has to become a float.
test multiply-one-past-i64-max {
    SELECT typeof(4611686018427387904 * 2),
           (4611686018427387904 * 2) = (4611686018427387904.0 * 2.0);
}
expect {
    real|1
}

test multiply-past-i64-min {
    SELECT typeof(-9223372036854775807 * 3),
           (-9223372036854775807 * 3) = (-9223372036854775807.0 * 3.0);
}
expect {
    real|1
}

# A float on either side gives a float, whichever side it is on.
test one-float-operand {
    SELECT typeof(1 + 2.5), 1 + 2.5 = 3.5, typeof(2.5 + 1), 2.5 + 1 = 3.5;
}
expect {
    real|1|real|1
}

test one-float-operand-of-each-operator {
    SELECT 1 - 2.5 = -1.5, 2.5 - 1 = 1.5, 2 * 2.5 = 5.0, 2.5 * 2 = 5.0;
}
expect {
    1|1|1|1
}

# The same three operators on a value that comes from a row, so that the
# arithmetic runs in the interpreter rather than wherever a constant
# expression is worked out.
setup extremes {
    CREATE TABLE t(a INTEGER);
    INSERT INTO t VALUES (9223372036854775807),(-9223372036854775807),(4611686018427387904);
}

@setup extremes
test add-past-i64-max-from-a-row {
    SELECT typeof(a + 1), (a + 1) = (9223372036854775807.0 + 1.0)
    FROM t WHERE a = 9223372036854775807;
}
expect {
    real|1
}

@setup extremes
test subtract-past-i64-min-from-a-row {
    SELECT typeof(a - 2), (a - 2) = (-9223372036854775807.0 - 2.0)
    FROM t WHERE a = -9223372036854775807;
}
expect {
    real|1
}

@setup extremes
test multiply-past-i64-max-from-a-row {
    SELECT typeof(a * 2), (a * 2) = (4611686018427387904.0 * 2.0)
    FROM t WHERE a = 4611686018427387904;
}
expect {
    real|1
}

@setup extremes
test arithmetic-on-a-row-that-fits-an-integer {
    SELECT a + 1, typeof(a + 1), a - 1, typeof(a - 1)
    FROM t WHERE a = 4611686018427387904;
}
expect {
    4611686018427387905|integer|4611686018427387903|integer
}
