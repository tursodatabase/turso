---
source: group-by-expression-index.sqltest
expression: |-
  SELECT a, sum(CASE WHEN b->>'x'=1 THEN c END)
        FROM sort_input
       WHERE d BETWEEN 0 AND 10
       GROUP BY a;
info:
  statement_type: SELECT
  tables:
