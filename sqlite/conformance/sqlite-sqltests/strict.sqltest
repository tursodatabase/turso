@database :memory:

@cross-check-integrity
test strict-null-integer-column {
    CREATE TABLE t1 (id INTEGER PRIMARY KEY, a INTEGER, b INTEGER) STRICT;
    INSERT INTO t1 (a) VALUES (5);
    SELECT id, a, b FROM t1;
}
expect {
    1|5|
}

@cross-check-integrity
test strict-null-text-column {
    CREATE TABLE t2 (id INTEGER PRIMARY KEY, first TEXT, last TEXT) STRICT;
    INSERT INTO t2 (first) VALUES ('John');
    SELECT id, first, last FROM t2;
}
expect {
    1|John|
}

@cross-check-integrity
test strict-null-real-column {
    CREATE TABLE t3 (id INTEGER PRIMARY KEY, a REAL, b REAL) STRICT;
    INSERT INTO t3 (a) VALUES (3.14);
    SELECT id, a, b FROM t3;
}
expect {
    1|3.14|
}

@cross-check-integrity
test strict-null-blob-column {
    CREATE TABLE t4 (id INTEGER PRIMARY KEY, a BLOB, b BLOB) STRICT;
    INSERT INTO t4 (a) VALUES (X'CAFE');
    SELECT id, hex(a), b FROM t4;
}
expect {
    1|CAFE|
}

# SQLite 3.53 can wrongly use the INSERT xfer optimization here, bypassing
# STRICT type checks and leaving an integer stored in d.a.
@skip-if sqlite "SQLite 3.53 xfer optimization bug for INSERT ... SELECT into incompatible STRICT tables; reported at https://sqlite.org/forum/forumpost/401abee549, fixed by SQLite check-in f8ca671997bf7bab18f282a2d5de9be0c03364bd for 3.54"
@cross-check-integrity
test strict-insert-select-any-to-blob-rejects-xfer {
    CREATE TABLE s(a ANY) STRICT;
    CREATE TABLE d(a BLOB) STRICT;
    INSERT INTO s VALUES(1);
    INSERT INTO d SELECT * FROM s;
    SELECT typeof(a), quote(a) FROM d;
    PRAGMA integrity_check;
}
expect error {
}

@cross-check-integrity
test strict-explicit-null-insert {
    CREATE TABLE t5 (id INTEGER PRIMARY KEY, a INTEGER, b TEXT) STRICT;
    INSERT INTO t5 VALUES (1, NULL, NULL);
    SELECT * FROM t5;
}
expect {
    1||
}

@cross-check-integrity
test strict-not-null-still-enforced {
    CREATE TABLE t6 (id INTEGER PRIMARY KEY, a INTEGER NOT NULL) STRICT;
    INSERT INTO t6 (id) VALUES (1);
}
expect error {
}

test strict-primary-key-columns-are-not-null {
    CREATE TABLE pk1 (code TEXT PRIMARY KEY, n INT) STRICT;
    CREATE TABLE pk2 (a TEXT, b INT, c INT, PRIMARY KEY (a, b)) STRICT;
    CREATE TABLE pk3 (id INTEGER PRIMARY KEY, x TEXT) STRICT;
    SELECT name, "notnull", pk FROM pragma_table_info('pk1');
    SELECT name, "notnull", pk FROM pragma_table_info('pk2');
    SELECT name, "notnull", pk FROM pragma_table_info('pk3');
}
expect {
    code|1|1
    n|0|0
    a|1|1
    b|1|2
    c|0|0
    id|0|1
    x|0|0
}

test strict-primary-key-schema-sql-after-add-column {
    CREATE TABLE pk1 (code TEXT PRIMARY KEY, n INT) STRICT;
    ALTER TABLE pk1 ADD COLUMN z INT;
    SELECT sql FROM sqlite_schema WHERE name = 'pk1';
}
expect {
    CREATE TABLE pk1 (code TEXT PRIMARY KEY, n INT, z INT) STRICT
}

@cross-check-integrity
test strict-insert-or-ignore-not-null-checked-before-type {
    CREATE TABLE t7 (a INT, b REAL NOT NULL) STRICT;
    INSERT OR IGNORE INTO t7 (a) VALUES ('x');
    SELECT count(*) FROM t7;
}
expect {
    0
}

test strict-insert-not-null-error-before-type-error {
    CREATE TABLE t8 (a INT, b REAL NOT NULL) STRICT;
    INSERT INTO t8 (a) VALUES ('x');
}
expect error {
    NOT NULL constraint failed: t8.b
}

test strict-insert-generated-column-type-error-before-not-null {
    CREATE TABLE t9 (a INT, b TEXT NOT NULL, c INT AS (a + 1)) STRICT;
    INSERT OR IGNORE INTO t9 (a) VALUES ('x');
}
expect error {
    cannot store TEXT value in INT column t9.a
}

test strict-insert-before-trigger-type-error-before-not-null {
    CREATE TABLE t10 (a INT, b TEXT NOT NULL) STRICT;
    CREATE TRIGGER t10_before BEFORE INSERT ON t10 BEGIN SELECT 1; END;
    INSERT OR IGNORE INTO t10 (a) VALUES ('x');
}
expect error {
    cannot store TEXT value in INT column t10.a
}
