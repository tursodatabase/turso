@database :memory:

# SQLite's sqlite3ColumnsFromExprList() does not name a column of a FROM
# subquery, a CTE, a view or CREATE TABLE AS true or false, also when an
# alias or a column list gives that name. It uses columnN instead.

test subquery-true-false-named-column-n {
    SELECT column1, column2, column3 FROM (SELECT true, false, (TRUE));
}
expect {
    1|0|1
}

test subquery-alias-true-named-column-n {
    SELECT column1, column2 FROM (SELECT 1 AS true, 2 AS "False");
}
expect {
    1|2
}

test cte-column-list-true-named-column-n {
    WITH w(true, b) AS (SELECT 1, 2) SELECT column1, b FROM w;
}
expect {
    1|2
}

test view-true-named-column-n {
    CREATE TABLE "TRUE"("true", y);
    INSERT INTO "TRUE" VALUES(1, 2);
    CREATE VIEW v AS SELECT "true", 3 AS FALSE, y FROM "TRUE";
    CREATE VIEW v2(true, b) AS SELECT 4, 5;
    SELECT column1, column2, y FROM v;
    SELECT column1, b FROM v2;
    SELECT column1, y FROM (SELECT "true", y FROM "TRUE");
}
expect {
    1|3|2
    4|5
    1|2
}

test create-table-as-true-false-named-column-n {
    CREATE TABLE c AS SELECT true, 1 AS false, 2 AS x;
    SELECT name FROM pragma_table_info('c');
}
expect {
    column1
    column2
    x
}
