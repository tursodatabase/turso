---
source: subqueries.sqltest
expression: |-
  SELECT count(*)
      FROM groups g
      JOIN watchlist w ON g.a = w.type_id
      JOIN (
          SELECT type_id, avg(price) AS avgp FROM history_txt GROUP BY type_id
      ) h ON w.name = h.avgp;
info:
  statement_type: SELECT
  tables:
  - g.a
  - groups
  - history_txt
  - w.name
  - watchlist
  setup_blocks:
  - groups_watchlist_schema
  database: ':memory:'
---
