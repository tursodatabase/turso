---
source: subqueries.sqltest
expression: |-
  SELECT count(*)
      FROM (SELECT type_id, avg(price) AS avgp FROM history_txt GROUP BY type_id) a,
           (SELECT type_id, max(price) AS maxp FROM history_txt GROUP BY type_id) b
      WHERE a.avgp + b.maxp > 3;
info:
  statement_type: SELECT
  tables:
  - history_txt
  setup_blocks:
  - watchlist_schema
  database: ':memory:'
---
