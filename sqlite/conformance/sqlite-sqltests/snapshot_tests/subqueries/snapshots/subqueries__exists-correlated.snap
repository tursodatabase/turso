---
source: subqueries.sqltest
expression: |-
  SELECT c.id, c.name
      FROM customers c
      WHERE EXISTS (
          SELECT 1
          FROM orders o
          WHERE o.customer_id = c.id
              AND o.total_amount > 500
      );
info:
  statement_type: SELECT
  tables:
  - customers
  - orders
  setup_blocks:
  - schema
  database: ':memory:'
---
QUERY PLAN
|--SCAN customers AS c
`--SEARCH o USING INDEX idx_orders_customer (customer_id=?)

BYTECODE
addr  opcode             p1  p2  p3  p4            p5  comment
   0  Init                0  20   0                 0  Start at 20
   1  OpenRead            0   6   0  k(4,B,B,B,B)   0  table=customers, root=6, iDb=0
   2  OpenRead            1   9   0  k(2,B)         0  index=idx_orders_customer, root=9, iDb=0
   3  OpenRead            2   4   0  k(4,B,B,B,B)   0  table=orders, root=4, iDb=0
   4  Rewind              0  19   0                 0  Rewind table customers
   5    RowId             0   1   0                 0  r[1]=customers.rowid
   6    SeekGE            1  17   1                 0  key=[1..1]
   7      IdxGT           1  17   1                 0  key=[1..1]
   8      DeferredSeek    1   2   0                 0
   9      Column          2   3   2                 0  r[2]=orders.total_amount
  10      RealAffinity    2   0   0                 0
  11      Le              2   3  16                 0  if r[2]<=r[3] goto 16
  12      RowId           0   4   0                 0  r[4]=customers.rowid
  13      Column          0   1   5                 0  r[5]=customers.name
  14      ResultRow       4   2   0                 0  output=r[4..5]
  15      Goto            0  18   0                 0  ; semi-join: early out after first match
  16    Next              1   7   0                 0
  17    Goto              0  18   0                 0  ; semi-join: no match, skip outer row
  18  Next                0   5   0                 1
  19  Halt                0   0   0                 0
  20  Transaction         0   1  11                 0  iDb=0 tx_mode=Read
  21  Integer           500   3   0                 0  r[3]=500
  22  Goto                0   1   0                 0
