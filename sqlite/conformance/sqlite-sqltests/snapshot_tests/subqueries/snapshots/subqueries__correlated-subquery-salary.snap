---
source: subqueries.sqltest
expression: |-
  SELECT e.id, e.name, e.department, e.salary
      FROM employees e
      WHERE e.salary > (
          SELECT avg(e2.salary)
          FROM employees e2
          WHERE e2.department = e.department
      );
info:
  statement_type: SELECT
  tables:
  - employees
  setup_blocks:
  - schema
  database: ':memory:'
---
