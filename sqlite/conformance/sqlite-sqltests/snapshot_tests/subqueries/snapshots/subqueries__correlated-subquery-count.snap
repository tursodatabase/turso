---
source: subqueries.sqltest
expression: |-
  SELECT o.id, o.order_date, o.total_amount
      FROM orders o
      WHERE (
          SELECT count(*)
          FROM order_items oi
          WHERE oi.order_id = o.id
      ) >= 3;
info:
  statement_type: SELECT
  tables:
  - order_items
  - orders
  setup_blocks:
  - schema
  database: ':memory:'
---
