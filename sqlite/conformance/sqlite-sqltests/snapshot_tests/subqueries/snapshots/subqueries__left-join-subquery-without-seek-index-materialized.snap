---
source: subqueries.sqltest
expression: |-
  SELECT count(*), sum(h.avgp)
      FROM watchlist w
      LEFT JOIN (
          SELECT type_id, avg(price) AS avgp FROM history_txt GROUP BY type_id
      ) h ON w.type_id = h.type_id;
info:
  statement_type: SELECT
  tables:
  - history_txt
  - w.type_id
  - watchlist
  setup_blocks:
  - watchlist_schema
  database: ':memory:'
---
