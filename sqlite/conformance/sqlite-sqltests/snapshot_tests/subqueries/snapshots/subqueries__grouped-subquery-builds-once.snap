`--CORRELATED SCALAR SUBQUERY 1
   |--LIST SUBQUERY 2
   |  |--SCAN repeat_inner AS inner_rows
   |  `--USE SORTER FOR GROUP BY
   `--SCAN repeat_middle AS middle_rows

