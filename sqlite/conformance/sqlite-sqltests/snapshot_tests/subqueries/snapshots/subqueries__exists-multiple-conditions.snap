   8      Once            10   0   0                   0  goto 10
   9      OpenRead         3   4   0  k(4,B,B,B,B)     0  table=orders, root=4, iDb=0
  10      RowId            0   4   0                   0  r[4]=products.rowid
  11      SeekGE           1  21   4                   0  key=[4..4]
  12        IdxGT          1  21   4                   0  key=[4..4]
  13        DeferredSeek   1   2   0                   0
  14        Column         2   1   5                   0  r[5]=order_items.order_id
  15        SeekRowid      3   5  20                   0  if (r[5]!=cursor 3.rowid) goto 20
  16        Column         3   2   6                   0  r[6]=orders.order_date
  17        Lt             6   7  20                   0  if r[6]<r[7] goto 20
  18        Integer        1   2   0                   0  r[2]=1
  19        Goto           0  21   0                   0
  20      Next             1  12   0                   0
  21    Return             3   0   1                   0
