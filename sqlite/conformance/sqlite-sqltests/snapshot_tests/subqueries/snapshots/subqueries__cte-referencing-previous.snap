|  |--SCAN top_products AS tp
|  |  `--SCAN product_sales
|  |     `--SCAN order_items AS oi USING INDEX idx_order_items_product
|  `--MERGE JOIN products AS p USING INTEGER PRIMARY KEY
|--SEARCH c USING INTEGER PRIMARY KEY (rowid=?)
`--USE SORTER FOR ORDER BY

