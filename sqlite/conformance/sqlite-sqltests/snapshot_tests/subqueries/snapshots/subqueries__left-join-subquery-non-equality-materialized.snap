---
source: subqueries.sqltest
expression: |-
  SELECT count(*)
      FROM watchlist w
      LEFT JOIN (
          SELECT type_id, avg(price) AS avgp FROM history_txt GROUP BY type_id
      ) h ON w.name > h.avgp;
info:
  statement_type: SELECT
  tables:
  - history_txt
  - w.name
  - watchlist
  setup_blocks:
  - watchlist_schema
  database: ':memory:'
---
