---
source: subqueries.sqltest
expression: |-
  SELECT name, (
          WITH own AS MATERIALIZED (SELECT id FROM orders WHERE customer_id = customers.id)
          SELECT count(*) FROM own
      )
      FROM customers;
info:
  statement_type: SELECT
  tables:
  - customers
  - orders
  - own
  setup_blocks:
  - schema
  database: ':memory:'
---
QUERY PLAN
|--SCAN customers
`--CORRELATED SCALAR SUBQUERY 1
   |--MATERIALIZE own
   |  `--SEARCH orders USING COVERING INDEX idx_orders_customer (customer_id=?)
   `--SCAN own
