---
source: subqueries.sqltest
expression: |-
  SELECT count(*)
      FROM watchlist w
      LEFT JOIN history_txt t ON t.price = w.type_id
      JOIN (
          SELECT type_id, avg(price) AS avgp FROM history_txt GROUP BY type_id
      ) h ON w.name > h.avgp;
info:
  statement_type: SELECT
  tables:
  - history_txt
  - t.price
  - w.name
  - watchlist
  setup_blocks:
  - watchlist_schema
  database: ':memory:'
---
