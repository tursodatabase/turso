---
source: subqueries.sqltest
expression: |-
  SELECT p.id, p.name, p.price
      FROM products p
      WHERE p.price > (
          SELECT avg(p2.price)
          FROM products p2
          WHERE p2.category_id = p.category_id
      );
info:
  statement_type: SELECT
  tables:
  - products
  setup_blocks:
  - schema
  database: ':memory:'
---
