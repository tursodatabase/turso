---
source: subqueries.sqltest
expression: |-
  SELECT c.id, c.name
      FROM customers c
      WHERE c.id IN (
          SELECT o.customer_id
          FROM orders o
          GROUP BY o.customer_id
          HAVING sum(o.total_amount) > 1000
      );
info:
  statement_type: SELECT
  tables:
  - customers
  - orders
  setup_blocks:
  - schema
  database: ':memory:'
---
