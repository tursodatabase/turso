---
source: subqueries.sqltest
expression: |-
  SELECT w.type_id, h.price
      FROM watchlist w
      LEFT JOIN (SELECT type_id, price FROM history_txt WHERE price > 10) h ON w.type_id + h.price > 20;
info:
  statement_type: SELECT
  tables:
  - history_txt
  - w.type_id
  - watchlist
  setup_blocks:
  - watchlist_schema
  database: ':memory:'
---
