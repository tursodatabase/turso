---
source: subqueries.sqltest
expression: |-
  WITH order_totals AS (
          SELECT customer_id, sum(total_amount) AS total
          FROM orders
          GROUP BY customer_id
      )
      SELECT
          c.name,
          ot.total,
          (SELECT avg(total) FROM order_totals) AS avg_total
      FROM customers c
      JOIN order_totals ot ON ot.customer_id = c.id
      WHERE ot.total > (SELECT avg(total) FROM order_totals);
info:
  statement_type: WITH (CTE)
  tables:
  - customers
  - order_totals
  - orders
  - ot.customer_id
  setup_blocks:
  - schema
  database: ':memory:'
---
QUERY PLAN
|--SCALAR SUBQUERY 1
|  |--SCAN orders USING INDEX idx_orders_customer
|  `--SCAN order_totals
|--SCALAR SUBQUERY 2
|  `--SCAN order_totals
|--SCAN customers AS c
`--SEARCH ot USING INDEX ephemeral_subquery_t5 (customer_id=? AND total>?)

