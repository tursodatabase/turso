@database :memory:

test analyze-indexed-table-does-not-insert-null-stat1-row {
    CREATE TABLE t(a, b);
    CREATE INDEX i_t_a ON t(a);
    INSERT INTO t VALUES (1, 10), (2, 20), (2, 30);
    ANALYZE;
    SELECT tbl, coalesce(idx, '<null>'), stat
    FROM sqlite_stat1
    ORDER BY tbl, idx IS NOT NULL, idx;
}
expect {
    t|i_t_a|3 2
}

test analyze-without-tables-creates-stat1 {
    ANALYZE;
    SELECT name FROM sqlite_schema;
}
expect {
    sqlite_stat1
}

test analyze-main-without-tables-creates-stat1 {
    ANALYZE main;
    SELECT name FROM sqlite_schema;
}
expect {
    sqlite_stat1
}

test analyze-with-only-views-creates-stat1 {
    CREATE VIEW v AS SELECT 1;
    ANALYZE;
    SELECT name FROM sqlite_schema WHERE type = 'table';
}
expect {
    sqlite_stat1
}

test analyze-temp-without-tables-creates-stat1 {
    ANALYZE temp;
    SELECT name FROM temp.sqlite_schema;
}
expect {
    sqlite_stat1
}

test insert-into-stat1-after-analyze-without-tables {
    ANALYZE;
    INSERT INTO sqlite_stat1 VALUES ('x', NULL, '1');
    SELECT tbl, stat FROM sqlite_stat1;
}
expect {
    x|1
}
