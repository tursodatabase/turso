---
source: analyze.sqltest
expression: |-
  SELECT c.name, COUNT(*) as purchase_count, SUM(p.amount) as total
      FROM customers c
      JOIN purchases p ON c.id = p.customer_id
      GROUP BY c.id;
info:
  statement_type: SELECT
  tables:
  - c.id
  - customers
  - purchases
  setup_blocks:
  - join_tables
  database: ':memory:'
---
QUERY PLAN
|--SCAN customers AS c
`--SEARCH p USING INDEX ephemeral_purchases_t2 (customer_id=?)

BYTECODE
addr  opcode                    p1  p2  p3  p4            p5  comment
   0          Init               0  56   0                 0  Start at 56
   1          Null               0  10  11                 0  r[10..11]=NULL
