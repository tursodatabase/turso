---
source: analyze.sqltest
expression: |-
  SELECT c.name, COUNT(*) as purchase_count, SUM(p.amount) as total
      FROM customers c
      JOIN purchases p ON c.id = p.customer_id
      GROUP BY c.id;
info:
  statement_type: SELECT
  tables:
  - c.id
  - customers
  - purchases
  setup_blocks:
  - join_tables
  database: ':memory:'
---
QUERY PLAN
|--SCAN customers AS c
`--SCAN purchases AS p

BYTECODE
addr  opcode                    p1  p2  p3  p4            p5  comment
   0          Init               0  46   0                 0  Start at 46
   1          Null               0  10  11                 0  r[10..11]=NULL
   2          Integer            0   6   0                 0  r[6]=0; clear group by abort flag
   3          Null               0   7   0                 0  r[7]=NULL; initialize group by comparison registers to NULL
   4          Gosub             16  42   0                 0  ; go to clear accumulator subroutine
   5          OpenRead           0   2   0  k(2,B,B)       0  table=customers, root=2, iDb=0
   6          OpenRead           1   3   0  k(3,B,B,B)     0  table=purchases, root=3, iDb=0
   7          Rewind             0  29   0                 0  Rewind table customers
   8            Rewind           1  28   0                 0  Rewind table purchases
   9              RowId          0  18   0                 0  r[18]=customers.rowid
  10              Column         1   1  19                 0  r[19]=purchases.customer_id
  11              Ne            18  19  27  Binary         0  if r[18]!=r[19] goto 27
  12              RowId          0  13   0                 0  r[13]=customers.rowid
  13              Column         0   1  14                 0  r[14]=customers.name
  14              Column         1   2  15                 0  r[15]=purchases.amount
  15              RealAffinity  15   0   0                 0
  16              Compare        7  13   1  k(1, Binary)   0  r[7..7]==r[13..13]
  17              Jump          18  22  18                 0  ; start new group if comparison is not equal
  18              Gosub          4  33   0                 0  ; check if ended group had data, and output if so
  19              Move          13   7   1                 0  r[7..7]=r[13..13]
  20              IfPos          6  45   0                 0  r[6]>0 -> r[6]-=0, goto 45; check abort flag
  21              Gosub         16  42   0                 0  ; goto clear accumulator subroutine
  22              AggStep        0  20  10  count          0  accum=r[10] step(r[20])
  23              AggStep        0  15  11  sum            0  accum=r[11] step(r[15])
  24              If             5  26   0                 0  if r[5] goto 26; don't emit group columns if continuing existing group
  25              Column         0   1   8                 0  r[8]=customers.name
  26              Integer        1   5   0                 0  r[5]=1; indicate data in accumulator
  27            Next             1   9   0                 1
  28          Next               0   8   0                 1
  29          Gosub              4  33   0                 0  ; emit row for final group
  30          Goto               0  45   0                 0  ; group by finished
  31          Integer            1   6   0                 0  r[6]=1
  32        Return               4   0   0                 0
  33        IfPos                5  35   0                 0  r[5]>0 -> r[5]-=0, goto 35; output group by row subroutine start
  34      Return                 4   0   0                 0
  35      AggFinal               0  10   0  count          0  accum=r[10]
  36      AggFinal               0  11   0  sum            0  accum=r[11]
  37      Copy                   8   1   0                 0  r[1]=r[8]
  38      Copy                  10   2   0                 0  r[2]=r[10]
  39      Copy                  11   3   0                 0  r[3]=r[11]
  40      ResultRow              1   3   0                 0  output=r[1..3]
  41    Return                   4   0   0                 0
  42    Null                     0   8  11                 0  r[8..11]=NULL; clear accumulator subroutine start
  43    Integer                  0   5   0                 0  r[5]=0
  44  Return                    16   0   0                 0
  45  Halt                       0   0   0                 0
  46  Transaction                0   1   4                 0  iDb=0 tx_mode=Read
  47  Integer                    1  20   0                 0  r[20]=1
