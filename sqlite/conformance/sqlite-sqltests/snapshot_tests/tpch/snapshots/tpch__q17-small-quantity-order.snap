---
source: tpch.sqltest
expression: |-
  select
          sum(l_extendedprice) / 7.0 as avg_yearly
      from
          lineitem,
          part
      where
          p_partkey = l_partkey
          and p_brand = 'Brand#52'
          and p_container = 'LG CAN'
          and l_quantity < (
              select
                  0.2 * avg(l_quantity)
              from
                  lineitem
              where
                  l_partkey = p_partkey
          );
info:
  statement_type: SELECT
  tables:
  - lineitem
  setup_blocks:
  - schema
  database: ':memory:'
---
