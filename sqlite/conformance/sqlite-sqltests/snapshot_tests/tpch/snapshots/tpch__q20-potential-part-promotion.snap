|--SEARCH nation USING INTEGER PRIMARY KEY (rowid=?)
|--LIST SUBQUERY 1
|  |--MATERIALIZE hash build input for partsupp
|  |  `--SEARCH partsupp USING INDEX sqlite_autoindex_partsupp_1 (ps_partkey=?)
|  |--HASH JOIN lineitem
|  |--USE SORTER FOR GROUP BY
|  |--LIST SUBQUERY 2
|  |  `--SCAN part
|  |--LIST SUBQUERY 3
|  `--LIST SUBQUERY 4
`--USE SORTER FOR ORDER BY

