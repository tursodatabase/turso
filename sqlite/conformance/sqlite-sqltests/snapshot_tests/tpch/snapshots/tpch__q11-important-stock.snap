|--SCAN nation
|--USE SORTER FOR GROUP BY
|--SCALAR SUBQUERY 1
|  |--HASH JOIN supplier
|  |--SEARCH partsupp USING COVERING INDEX ephemeral_partsupp_t5 (PS_SUPPKEY=?)
|  `--SCAN nation
`--USE SORTER FOR ORDER BY

