---
source: joins.sqltest
expression: |-
  SELECT right_plan_left.a, right_plan_right.a, right_plan_right.b
      FROM right_plan_left
      RIGHT JOIN right_plan_right
          ON right_plan_left.a=right_plan_right.a
      WHERE right_plan_right.b=5;
info:
  statement_type: SELECT
  tables:
  - right_plan_left
  - right_plan_left.a
  - right_plan_right
  setup_blocks:
  - right_join_unmatched_index_schema
  database: ':memory:'
---
