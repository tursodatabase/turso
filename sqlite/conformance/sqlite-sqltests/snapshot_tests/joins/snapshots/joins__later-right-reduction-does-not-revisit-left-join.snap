---
source: joins.sqltest
expression: |-
  SELECT *
      FROM reduction_chain_a
      LEFT JOIN reduction_chain_b NOT INDEXED
          ON reduction_chain_a.id=reduction_chain_b.id
      JOIN reduction_chain_c ON true
      RIGHT JOIN reduction_chain_d NOT INDEXED
          ON reduction_chain_b.id=reduction_chain_d.id
      WHERE reduction_chain_c.id>0;
info:
  statement_type: SELECT
  tables:
  - reduction_chain_a
  - reduction_chain_a.id
  - reduction_chain_b
  - reduction_chain_b.id
  - reduction_chain_c
  - reduction_chain_d
  setup_blocks:
  - right_join_inner_on_schema
  database: ':memory:'
---
