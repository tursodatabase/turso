|--SCAN reduction_chain_a
|--SEARCH reduction_chain_c USING COVERING INDEX ephemeral_reduction_chain_c_t3 (id>?)
|--SCAN reduction_chain_b LEFT-JOIN
`--SCAN reduction_chain_d

