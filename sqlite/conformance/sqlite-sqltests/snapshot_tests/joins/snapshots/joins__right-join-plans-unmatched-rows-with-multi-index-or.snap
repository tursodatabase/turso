---
source: joins.sqltest
expression: |-
  SELECT right_multi_left.a, right_multi_right.a,
             right_multi_right.b, right_multi_right.c
      FROM right_multi_left
      RIGHT JOIN right_multi_right ON right_multi_left.a=right_multi_right.a
      WHERE right_multi_right.b=5 OR right_multi_right.c=7;
info:
  statement_type: SELECT
  tables:
  - right_multi_left
  - right_multi_left.a
  - right_multi_right
  setup_blocks:
  - right_join_unmatched_multi_index_schema
  database: ':memory:'
