---
source: joins.sqltest
expression: |-
  SELECT left_row.a, right_row.a, coalesce(right_row.b,7)
        FROM separate_index_left AS left_row
        RIGHT JOIN separate_index_right AS right_row
                     INDEXED BY separate_index_right_expr
          ON left_row.a=right_row.a
       WHERE right_row.a=5;
info:
  statement_type: SELECT
  tables:
  - left_row.a
  - separate_index_left
  - separate_index_right
  setup_blocks:
  - right_join_separate_index_cursor_schema
  database: ':memory:'
