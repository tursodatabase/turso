---
source: joins.sqltest
expression: |-
  SELECT
          c.customer_id,
          c.name,
          o.order_id,
          o.order_date,
          o.total_amount
      FROM
          customers c
      RIGHT OUTER JOIN orders o ON c.customer_id = o.customer_id
      ORDER BY c.customer_id;
info:
  statement_type: SELECT
  tables:
  - c.customer_id
  - customers
  - orders
  setup_blocks:
  - schema
  database: ':memory:'
---
