      FROM reduction_chain_a
      LEFT JOIN reduction_chain_b ON reduction_chain_a.id=reduction_chain_b.id
      JOIN reduction_chain_c ON reduction_chain_b.id=reduction_chain_c.id
      RIGHT JOIN reduction_chain_d ON true;
info:
  statement_type: SELECT
  tables:
  - reduction_chain_a
  - reduction_chain_a.id
  - reduction_chain_b
