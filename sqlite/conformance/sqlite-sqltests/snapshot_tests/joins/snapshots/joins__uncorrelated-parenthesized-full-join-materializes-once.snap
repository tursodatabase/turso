---
source: joins.sqltest
expression: |-
  SELECT (SELECT nested_once_value.value
                FROM nested_once_anchor
                RIGHT JOIN (
                     nested_once_value
                     FULL JOIN nested_once_empty ON false
                ) ON true
               WHERE nested_once_anchor.id=nested_once_outer.id
               LIMIT 1)
        FROM nested_once_outer;
