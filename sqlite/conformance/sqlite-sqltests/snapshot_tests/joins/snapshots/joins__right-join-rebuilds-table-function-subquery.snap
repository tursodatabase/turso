---
source: joins.sqltest
expression: |-
  SELECT virtual_subquery_snapshot_left.value,
             virtual_subquery_snapshot_right.value
        FROM virtual_subquery_snapshot_left
        RIGHT JOIN json_each((SELECT virtual_subquery_snapshot_left.json))
                     AS virtual_subquery_snapshot_right
          ON virtual_subquery_snapshot_left.value=virtual_subquery_snapshot_right.value
       ORDER BY virtual_subquery_snapshot_right.value;
info:
  statement_type: SELECT
  tables:
  - json_each
  - virtual_subquery_snapshot_left
  - virtual_subquery_snapshot_left.value
  setup_blocks:
  - right_join_virtual_subquery_schema
  database: ':memory:'
