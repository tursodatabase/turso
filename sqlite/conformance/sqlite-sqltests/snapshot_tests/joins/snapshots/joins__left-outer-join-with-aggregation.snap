---
source: joins.sqltest
expression: |-
  SELECT
          c.customer_id,
          c.name,
          COUNT(o.order_id) AS order_count,
          COALESCE(SUM(o.total_amount), 0) AS total_spent
      FROM
          customers c
      LEFT OUTER JOIN orders o ON c.customer_id = o.customer_id
      GROUP BY
          c.customer_id, c.name
      ORDER BY
          total_spent DESC;
info:
  statement_type: SELECT
  tables:
  - c.customer_id
  - customers
  - orders
  setup_blocks:
  - schema
  database: ':memory:'
---
