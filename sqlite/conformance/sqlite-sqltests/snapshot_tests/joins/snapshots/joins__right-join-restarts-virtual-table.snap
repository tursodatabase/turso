---
source: joins.sqltest
expression: |-
  SELECT virtual_snapshot_left.value, virtual_snapshot_right.value
        FROM virtual_snapshot_left
        RIGHT JOIN json_each('[1,2]') AS virtual_snapshot_right
          ON virtual_snapshot_left.value=virtual_snapshot_right.value
       ORDER BY virtual_snapshot_right.value;
info:
  statement_type: SELECT
  tables:
  - json_each
  - virtual_snapshot_left
  - virtual_snapshot_left.value
  setup_blocks:
  - right_join_virtual_table_schema
  database: ':memory:'
---
