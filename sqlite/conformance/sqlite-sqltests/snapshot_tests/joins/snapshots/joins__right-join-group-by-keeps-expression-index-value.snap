---
source: joins.sqltest
expression: |-
  SELECT left_row.a, sum(left_row.a+left_row.b)
        FROM grouped_expr_left AS left_row
        RIGHT JOIN grouped_expr_right ON left_row.a=x
       GROUP BY left_row.a
       ORDER BY left_row.a;
info:
  statement_type: SELECT
  tables:
  - grouped_expr_left
  - grouped_expr_right
  - left_row.a
  setup_blocks:
  - right_join_grouped_expression_index_schema
  database: ':memory:'
---
