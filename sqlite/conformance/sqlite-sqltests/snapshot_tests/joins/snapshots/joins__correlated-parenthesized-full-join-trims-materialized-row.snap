---
source: joins.sqltest
expression: |-
  SELECT (SELECT count(*)
                FROM nested_correlated_anchor
                RIGHT JOIN (
                     nested_correlated_left
                     FULL JOIN nested_correlated_right
                       ON nested_correlated_right.id=nested_correlated_outer.id
                ) ON true)
        FROM nested_correlated_outer;
info:
  statement_type: SELECT
  tables:
  - nested_correlated_anchor
  - nested_correlated_outer
  - nested_correlated_right
  - nested_correlated_right.id
  setup_blocks:
  - correlated_parenthesized_join_snapshot_schema
  database: ':memory:'
