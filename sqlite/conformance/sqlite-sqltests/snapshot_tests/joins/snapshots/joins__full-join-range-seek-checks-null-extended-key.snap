---
source: joins.sqltest
expression: |-
  SELECT left_row.id, null_range_middle.key, right_row.id
        FROM null_range_left AS left_row
        FULL JOIN null_range_middle ON true
        FULL JOIN null_range_left AS right_row INDEXED BY null_range_left_value
          ON null_range_middle.key<=right_row.value;
info:
  statement_type: SELECT
  tables:
  - null_range_left
  - null_range_middle
  - null_range_middle.key
  setup_blocks:
  - full_join_null_range_schema
  database: ':memory:'
