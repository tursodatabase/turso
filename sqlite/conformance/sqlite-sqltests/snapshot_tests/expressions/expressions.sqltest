# Expression Evaluation Bytecode Snapshots
# These snapshots capture EXPLAIN output to pin down where expressions are
# evaluated: constant subexpressions (including bound parameters, which are
# constant within a single execution) must be hoisted out of scan loops.

@database :memory:
@skip-file-if mvcc "mvcc has slightly different cursor ids, so skipping it for now"

setup schema {
    CREATE TABLE t (x);
}

# Parameters are constant within a query, so the WHERE clause below is fully
# constant: the zeroblob()/length() calls and the comparison must be emitted
# before the Rewind/Next scan loop, and evaluated exactly once. If they show
# up inside the loop, a query binding a large blob would re-allocate it for
# every row.
@setup schema
snapshot constant-parameter-hoisted-out-of-scan {
    SELECT COUNT(*) FROM t WHERE LENGTH(zeroblob(?)) = ?;
}

setup integer_table {
    CREATE TABLE s (x INTEGER);
}

# A statement loads each distinct constant into one register in the init
# section, and each use of the constant reads that register, as in SQLite.
# Each snapshot below has one `Integer 100`.
@setup integer_table
snapshot equal-constants-share-register-in-where-and-result {
    SELECT x + 100 FROM s WHERE x < 100;
}

@setup integer_table
snapshot equal-constants-share-register-in-where {
    SELECT x FROM s WHERE x < 100 AND x + 100 > 0;
}

@setup integer_table
snapshot equal-constants-share-register-in-union-all {
    SELECT x FROM s WHERE x < 100 UNION ALL SELECT x FROM s WHERE x < 100;
}

@setup integer_table
snapshot equal-constants-share-register-in-recursive-cte {
    WITH RECURSIVE t(a) AS (SELECT 1 UNION ALL SELECT a * 2 FROM t WHERE a < 100 UNION ALL SELECT a * 3 FROM t WHERE a < 100) SELECT a FROM t;
}
