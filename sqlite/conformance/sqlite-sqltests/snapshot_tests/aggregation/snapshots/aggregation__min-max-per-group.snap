---
source: aggregation.sqltest
expression: |-
  SELECT
          category,
          MIN(amount) as min_sale,
          MAX(amount) as max_sale
      FROM
          sales
      GROUP BY
          category
      ORDER BY
          category;
info:
  statement_type: SELECT
  tables:
  - sales
  setup_blocks:
