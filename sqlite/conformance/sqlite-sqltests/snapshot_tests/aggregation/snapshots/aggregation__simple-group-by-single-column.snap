---
source: aggregation.sqltest
expression: |-
  SELECT
          category,
          SUM(amount) as total_sales
      FROM
          sales
      GROUP BY
          category
      ORDER BY
          total_sales DESC;
info:
  statement_type: SELECT
  tables:
  - sales
  setup_blocks:
  - schema
  database: ':memory:'
