---
source: aggregation.sqltest
expression: |-
  SELECT
          category,
          SUM(amount) as total_sales,
          AVG(amount) as avg_sale
      FROM
          sales
      GROUP BY
          category
      HAVING
          SUM(amount) > 10000
      ORDER BY
          total_sales DESC;
info:
  statement_type: SELECT
  tables:
  - sales
  setup_blocks:
  - schema
  database: ':memory:'
---
