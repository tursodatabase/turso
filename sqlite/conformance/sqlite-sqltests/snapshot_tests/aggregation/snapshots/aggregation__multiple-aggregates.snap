---
source: aggregation.sqltest
expression: |-
  SELECT
          category,
          COUNT(*) as transaction_count,
          SUM(amount) as total_amount,
          AVG(amount) as avg_amount,
          SUM(quantity) as total_quantity,
          AVG(quantity) as avg_quantity
      FROM
          sales
      GROUP BY
          category
      ORDER BY
          total_amount DESC;
info:
  statement_type: SELECT
  tables:
  - sales
  setup_blocks:
  - schema
  database: ':memory:'
---
