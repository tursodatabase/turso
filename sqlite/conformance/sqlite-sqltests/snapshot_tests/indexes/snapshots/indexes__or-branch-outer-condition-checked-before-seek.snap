---
source: indexes.sqltest
expression: |-
  SELECT DISTINCT n.id
      FROM node n
      JOIN edge e ON (
          (e.fromId = 'a' AND e.toId = n.id AND e.label = 'requires')
          OR (e.toId = 'a' AND e.fromId = n.id AND e.label = 'requires')
      )
      WHERE n.type = 'course'
      ORDER BY n.id;
info:
  statement_type: SELECT
  tables:
  - edge
  - node
  setup_blocks:
  - or_branch_outer_condition
  database: ':memory:'
---
