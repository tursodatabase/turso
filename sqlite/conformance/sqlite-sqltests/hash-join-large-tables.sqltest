@setup hash-schema
test equality-join-key-expression-and-filters {
    SELECT count(*) FROM a JOIN b ON b.k = a.k + 1 WHERE b.v > 3 AND length(a.pad) > 10;
}
expect {
    18574
}

@setup hash-schema
test equality-join-self-join {
    SELECT count(*) FROM a JOIN a AS a2 ON a2.k = a.k;
}
expect {
    47969
}

@setup hash-schema
test equality-join-limit {
    SELECT sum(x) FROM (SELECT a.id + b.id AS x FROM a JOIN b ON b.k = a.k ORDER BY a.id, b.id LIMIT 100);
}
expect {
    55060
}

@setup hash-schema
test equality-join-other-terms {
    SELECT count(*) FROM a, b WHERE b.k = a.k AND b.id > a.id;
}
expect {
    11880
}

@setup hash-schema
test equality-join-exists-filter {
    SELECT count(*) FROM a JOIN b ON b.k = a.k WHERE EXISTS (SELECT 1 FROM c WHERE c.k = b.v);
}
expect {
    30228
}

@setup hash-schema
test equality-join-long-values {
    SELECT max(a.pad || b.pad), count(*) FROM a JOIN b ON b.k = a.k;
}
expect {
    qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq|30228
}

@setup hash-schema
test equality-join-integer-left-side-against-untyped {
    SELECT count(*) FROM a JOIN b ON b.r = a.k;
}
expect {
    21300
}

@setup hash-schema
test equality-join-integer-left-side-against-text {
    SELECT count(*) FROM a JOIN b ON b.t = a.k;
}
expect {
    7200
}

