@database :memory:

# Equality joins with no index on the join columns, over tables large enough
# that a hash table built from one of them spills to disk in a debug build.
# The cases cover integer, real, text and NOCASE keys, keys of different
# types, NULL keys, two-column keys, and joins inside grouped, DISTINCT,
# ordered and filtered queries.

setup hash-schema {
    CREATE TABLE a(id INTEGER PRIMARY KEY, k INT, r REAL, t TEXT, c TEXT COLLATE NOCASE, pad TEXT);
    CREATE TABLE b(id INTEGER PRIMARY KEY, k INT, r, t TEXT, c TEXT COLLATE NOCASE, pad TEXT, v INT);
    CREATE TABLE c(id INTEGER PRIMARY KEY, k INT, w INT);
    WITH RECURSIVE s(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM s WHERE i < 1500) INSERT INTO a SELECT i, CASE WHEN i % 13 = 0 THEN NULL ELSE i % 40 END, CASE WHEN i % 17 = 0 THEN NULL ELSE (i % 6) / 2.0 END, CASE i % 5 WHEN 0 THEN 'x' WHEN 1 THEN 'Z' WHEN 2 THEN '1' WHEN 3 THEN NULL ELSE 'z' END, CASE i % 4 WHEN 0 THEN 'a' WHEN 1 THEN 'A' WHEN 2 THEN 'b' ELSE NULL END, substr('pppppppppppppppppppppppppppppppppppppppppppppppppppppppppppp', 1, i % 60) FROM s;
    WITH RECURSIVE s(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM s WHERE i < 1200) INSERT INTO b SELECT i, CASE WHEN i % 11 = 0 THEN NULL ELSE i % 50 END, CASE i % 4 WHEN 0 THEN 1 WHEN 1 THEN '1.5' WHEN 2 THEN 2.0 ELSE NULL END, CASE i % 6 WHEN 0 THEN 'x' WHEN 1 THEN 'z' WHEN 2 THEN 1 WHEN 3 THEN NULL ELSE 'Y' END, CASE i % 3 WHEN 0 THEN 'A' WHEN 1 THEN 'b' ELSE NULL END, substr('qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq', 1, i % 80), i % 17 FROM s;
    WITH RECURSIVE s(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM s WHERE i < 900) INSERT INTO c SELECT i, i % 45, i % 7 FROM s;
}

@setup hash-schema
test equality-join-integer-key {
    SELECT count(*), sum(a.id), sum(b.id) FROM a JOIN b ON b.k = a.k;
}
expect {
    30228|22677293|17972673
}

@setup hash-schema
test equality-join-real-key-against-untyped-column {
    SELECT count(*), sum(b.v) FROM a JOIN b ON b.r = a.r;
}
expect {
    211500|1687300
}

@setup hash-schema
test equality-join-text-key {
    SELECT count(*), sum(a.id * b.id) FROM a JOIN b ON b.t = a.t;
}
expect {
    180000|81126300000
}

@setup hash-schema
test equality-join-nocase-key {
    SELECT count(*) FROM a JOIN b ON b.c = a.c;
}
expect {
    450000
}

@setup hash-schema
test equality-join-nocase-left-side-against-text {
    SELECT count(*) FROM a JOIN b ON a.c = b.t;
}
expect {
    0
}

@setup hash-schema
test equality-join-two-keys {
    SELECT count(*), sum(b.v) FROM a JOIN b ON b.k = a.k AND b.t = a.t;
}
expect {
    3113|25422
}

@setup hash-schema
test equality-join-grouped {
    SELECT a.k, count(*), sum(b.v) FROM a JOIN b ON b.k = a.k GROUP BY a.k ORDER BY a.k;
}
