@setup hash-schema
test equality-join-distinct {
    SELECT count(*) FROM (SELECT DISTINCT a.k, b.v FROM a JOIN b ON b.k = a.k);
}
expect {
    643
}

@setup hash-schema
test equality-join-three-tables {
    SELECT count(*), sum(c.w) FROM a JOIN b ON b.k = a.k JOIN c ON c.k = b.k;
}
expect {
    604560|1815856
}

