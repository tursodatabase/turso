@database :memory:

# Regression tests: bare columns in ungrouped aggregate queries with 0 matching
# rows must return NULL, not stale values from non-matching rows.
#
# When no rows pass the WHERE filter, the table cursor may still be positioned
# on a valid row from the scan. Without NullRow, Column instructions would read
# stale data from that row instead of returning NULL.

setup single-row {
    CREATE TABLE t(a INTEGER PRIMARY KEY, b TEXT, c INTEGER NOT NULL);
    INSERT INTO t VALUES(NULL, 'hello', 10);
}

@setup single-row
test sum-zero-rows-bare-col {
    SELECT SUM(a IS NOT NULL), b FROM t WHERE a < -999;
}
expect {
    |
}

@setup single-row
test sum-zero-rows-bare-col-with-order-by {
    SELECT SUM(a IS NOT NULL), b FROM t WHERE a < -999 ORDER BY c DESC;
}
expect {
    |
}

@setup single-row
test count-zero-rows-bare-col {
    SELECT COUNT(a), b FROM t WHERE a < -999;
}
expect {
    0|
}

setup multi-row {
    CREATE TABLE t2(a INTEGER PRIMARY KEY, b TEXT, c TEXT, d INTEGER NOT NULL);
    INSERT INTO t2 VALUES(1, 'foo', 'bar', 10);
    INSERT INTO t2 VALUES(2, 'baz', 'qux', 20);
}

@setup multi-row
test count-star-zero-rows-multiple-bare-cols {
    SELECT COUNT(*), b, c FROM t2 WHERE a > 999;
}
expect {
    0||
}

@setup multi-row
test avg-zero-rows-bare-col {
    SELECT AVG(d), b FROM t2 WHERE a > 999;
}
expect {
    |
}

@setup multi-row
test max-zero-rows-bare-col {
    SELECT MAX(d), b, c FROM t2 WHERE a > 999;
}
expect {
    ||
}

# With matching rows the bare column should return a value from a matching row
@setup single-row
test sum-matching-rows-bare-col {
    SELECT SUM(a IS NOT NULL), b FROM t WHERE c = 10;
}
expect {
    1|hello
}

# A correlated aggregate subquery that finds no rows must read the outer column
# of the current outer row, not the value from an earlier outer row.
setup outer-and-inner {
    CREATE TABLE t1(a INT, b TEXT);
    CREATE TABLE t2(a INT, c INT, d TEXT);
    INSERT INTO t1 VALUES (1,'p'),(2,'q'),(3,'r'),(4,'s');
    INSERT INTO t2 VALUES (1,10,'x'),(2,20,'y'),(2,30,'z'),(3,40,'w'),(5,50,'v');
}

@setup outer-and-inner
test correlated-aggregate-zero-rows-reads-current-outer-column {
    SELECT t1.a, (SELECT coalesce(max(c), t1.a) FROM t2 WHERE t2.a = t1.a) FROM t1 ORDER BY 1;
}
expect {
    1|10
    2|30
    3|40
    4|4
}

@setup outer-and-inner
test correlated-count-zero-rows-reads-current-outer-column {
    SELECT t1.a, (SELECT count(*) || '-' || t1.b FROM t2 WHERE t2.a = t1.a) FROM t1 ORDER BY 1;
}
expect {
    1|1-p
    2|2-q
    3|1-r
    4|0-s
}

@setup outer-and-inner
test correlated-count-false-where-reads-outer-column {
    SELECT t1.a, (SELECT count(*) || '-' || t1.b FROM t2 WHERE 0) FROM t1 ORDER BY 1;
}
expect {
    1|0-p
    2|0-q
    3|0-r
    4|0-s
}

# When no row reaches the aggregate, a correlated subquery in the result columns
# must run against the NULL row, not keep its result for the last outer row.
setup outer-row-without-match {
    CREATE TABLE r(a);
    CREATE TABLE l(x);
    INSERT INTO r VALUES (5);
}

@setup outer-row-without-match
test correlated-subquery-join-zero-rows {
    SELECT count(*), (SELECT r.a) FROM r JOIN l ON l.x = r.a;
}
expect {
    0|
}

@setup outer-row-without-match
test correlated-subquery-join-zero-rows-reads-null-row {
    SELECT count(*), (SELECT coalesce(r.a, 7)) FROM r JOIN l ON l.x = r.a;
}
expect {
    0|7
}

@setup outer-row-without-match
test correlated-subquery-join-zero-rows-max {
    SELECT max(l.x), (SELECT r.a) FROM r JOIN l ON l.x = r.a;
}
expect {
    |
}

@setup outer-row-without-match
test correlated-subquery-cross-join-zero-rows {
    SELECT count(*), (SELECT r.a) FROM r, l;
}
expect {
    0|
}

@setup outer-row-without-match
test correlated-in-and-exists-join-zero-rows {
    SELECT count(*), 5 IN (SELECT r.a), EXISTS (SELECT 1 WHERE r.a IS NULL) FROM r JOIN l ON l.x = r.a;
}
expect {
    0||1
}

@setup outer-row-without-match
test correlated-subquery-join-zero-rows-inside-outer-query {
    SELECT k, (SELECT x FROM (SELECT count(*), coalesce((SELECT r.a + k), 'n') AS x FROM r JOIN l ON l.x = r.a))
    FROM (SELECT 1 AS k UNION ALL SELECT 2) ORDER BY k;
}
expect {
    1|n
    2|n
}

@setup outer-row-without-match
test correlated-subquery-inside-aggregate-column-join-zero-rows {
    SELECT count(*) + (SELECT coalesce(r.a, 100)) FROM r JOIN l ON l.x = r.a;
}
expect {
    100
}

@setup outer-row-without-match
test correlated-subquery-inside-aggregate-column-where-zero-rows {
    SELECT count(*) + (SELECT coalesce(r.a, 100)) FROM r WHERE r.a > 10;
}
expect {
    100
}

@setup outer-row-without-match
test correlated-subquery-inside-aggregate-column-zero-rows-inside-outer-query {
    SELECT k, (SELECT count(*) || coalesce((SELECT r.a + k), 'n') FROM r JOIN l ON l.x = r.a)
    FROM (SELECT 1 AS k UNION ALL SELECT 2) ORDER BY k;
}
expect {
    1|0n
    2|0n
}

setup outer-rows-with-one-match {
    CREATE TABLE r(a);
    CREATE TABLE l(x);
    INSERT INTO r VALUES (5), (6);
    INSERT INTO l VALUES (5);
}

@setup outer-rows-with-one-match
test correlated-scalar-aggregate-retains-matching-row {
    SELECT count(*) + (SELECT r.a) FROM r JOIN l ON l.x = r.a;
}
expect {
    6
}

@setup outer-rows-with-one-match
test correlated-exists-aggregate-retains-matching-row {
    SELECT count(*) + EXISTS (SELECT 1 WHERE r.a = 5) FROM r JOIN l ON l.x = r.a;
}
expect {
    2
}

@setup outer-rows-with-one-match
test correlated-scalar-aggregate-where-retains-matching-row {
    SELECT count(*) + (SELECT r.a) FROM r WHERE a = 5;
}
expect {
    6
}

@setup outer-rows-with-one-match
test correlated-scalar-aggregate-null-row-with-no-match {
    SELECT count(*) + (SELECT coalesce(r.a, 100)) FROM r JOIN l ON l.x = r.a WHERE r.a = 6;
}
expect {
    100
}
