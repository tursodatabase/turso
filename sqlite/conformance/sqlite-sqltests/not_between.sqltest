# A column wins over a SELECT-list alias with the same name, even when the alias calls a
# nondeterministic function. The comparisons still use the column's affinity and collation.
test between-column-wins-over-volatile-alias-of-same-name {
    CREATE TABLE t(a INTEGER, s TEXT COLLATE NOCASE);
    INSERT INTO t VALUES (2, 'B'), (3, 'c'), (10, 'a');
    SELECT a, random() * 0 AS a FROM t WHERE a BETWEEN '2' AND '3' ORDER BY 1;
    SELECT s, random() * 0 AS s FROM t WHERE s NOT BETWEEN 'A' AND 'B' ORDER BY 1;
}
expect {
    2|0
    3|0
    c|0
}

# When a column or an earlier alias wins over a nondeterministic alias of the same name, the
# BETWEEN is still split, so it matches the BETWEEN predicate of the partial index.
test between-column-shadowing-volatile-alias-matches-partial-index {
    CREATE TABLE t(a);
    INSERT INTO t VALUES (0), (1), (2);
    CREATE INDEX ix ON t(a) WHERE a BETWEEN 0 AND 1;
    SELECT random() * 0 AS a FROM t INDEXED BY ix WHERE a BETWEEN 0 AND 1;
}
expect {
    0
    0
}

test between-first-of-two-aliases-matches-partial-index {
    CREATE TABLE t(a);
    INSERT INTO t VALUES (0), (1), (2);
    CREATE INDEX ix ON t(a) WHERE a BETWEEN 0 AND 1;
    SELECT a AS r, random() * 0 AS r FROM t INDEXED BY ix WHERE r BETWEEN 0 AND 1 ORDER BY 1;
}
expect {
    0|0
    1|0
}

