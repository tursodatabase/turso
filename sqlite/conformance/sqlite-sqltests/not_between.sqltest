@database :memory:

# Regression test: NOT BETWEEN with self-referencing expressions must not
# be optimized into multi-index union seeks, because the seek key depends
# on the current row and cannot be evaluated before scanning.

@cross-check-integrity
test not-between-self-ref-group-by {
    CREATE TABLE t1 (a INTEGER PRIMARY KEY, b INTEGER, c INTEGER);
    INSERT INTO t1 VALUES (1, 10, 100), (2, 20, 200), (3, NULL, 300), (4, 40, 400);
    SELECT c, AVG(b) FROM t1 WHERE TYPEOF(b) NOT BETWEEN a AND a GROUP BY a, b, c;
}
expect {
    100|10.0
    200|20.0
    300|
    400|40.0
}
expect @js {
    100|10
    200|20
    300|
    400|40
}

@cross-check-integrity
test not-between-self-ref-no-group-by {
    CREATE TABLE t2 (a INTEGER PRIMARY KEY, b INTEGER, c INTEGER);
    INSERT INTO t2 VALUES (1, 10, 100), (2, 20, 200), (3, NULL, 300), (4, 40, 400);
    SELECT * FROM t2 WHERE TYPEOF(b) NOT BETWEEN a AND a;
}
expect {
    1|10|100
    2|20|200
    3||300
    4|40|400
}

@cross-check-integrity
test between-self-ref-group-by {
    CREATE TABLE t3 (a INTEGER PRIMARY KEY, b INTEGER, c INTEGER);
    INSERT INTO t3 VALUES (1, 10, 100), (2, 20, 200), (3, NULL, 300), (4, 40, 400);
    SELECT c, AVG(b) FROM t3 WHERE TYPEOF(b) BETWEEN a AND a GROUP BY a, b, c;
}
expect {
}

@backend cli
@skip-if sqlite "uses the Turso test-only counter"
test between-subquery-lhs-once {
    CREATE TABLE t(a);
    INSERT INTO t VALUES (1), (2), (3), (4);
    SELECT COUNT(*) FROM t
    WHERE (SELECT test_nondet_counter() % 2 + t.a * 0) BETWEEN 0 AND 0;
}
expect {
    2
}

@backend cli
@skip-if sqlite "uses the Turso test-only counter"
test not-between-subquery-lhs-once {
    CREATE TABLE t(a);
    INSERT INTO t VALUES (1), (2), (3), (4);
    SELECT COUNT(*) FROM t
    WHERE (SELECT test_nondet_counter() % 2 + t.a * 0) NOT BETWEEN 0 AND 0;
}
expect {
    2
}

@backend cli
@skip-if sqlite "uses the Turso test-only counter"
test between-subquery-lhs-in-function {
    CREATE TABLE t(a);
    INSERT INTO t VALUES (1), (2), (3), (4);
    SELECT COUNT(*) FROM t
    WHERE abs((SELECT test_nondet_counter() % 2 + t.a * 0)) BETWEEN 0 AND 0;
}
expect {
    2
}

# Known difference from SQLite. A scalar subquery in a bound runs before the
# comparisons, like an IN or EXISTS bound. So the counter in the bounds is
# called for every row (12 calls for 4 rows), even when the lower bound already
# decides. SQLite skips the upper bound: it returns 0 and makes 8 calls.
@backend cli
@skip-if sqlite "uses the Turso test-only counter"
test between-subquery-lhs-and-bounds {
    CREATE TABLE t(a);
    INSERT INTO t VALUES (1), (2), (3), (4);
    SELECT COUNT(*) FROM t
    WHERE (SELECT test_nondet_counter() % 2 + t.a * 0)
        BETWEEN (SELECT test_nondet_counter() % 2 + t.a * 0)
        AND (SELECT test_nondet_counter() % 2 + t.a * 0);
    SELECT test_nondet_counter();
}
expect {
    2
    12
}

@backend cli
@skip-if sqlite "uses the Turso test-only counter"
test between-subquery-lhs-once-with-subquery-bounds {
    CREATE TABLE t(a);
    INSERT INTO t VALUES (1), (2), (3), (4);
    SELECT COUNT(*) FROM t
    WHERE (SELECT test_nondet_counter() % 2 + t.a * 0)
        BETWEEN (SELECT t.a - t.a) AND (SELECT t.a - t.a);
    SELECT test_nondet_counter();
}
expect {
    2
    4
}

