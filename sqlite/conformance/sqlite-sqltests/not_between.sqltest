@backend cli
@skip-if sqlite "uses the Turso test-only counter"
test between-nondeterministic-lhs-once {
    CREATE TABLE t(a);
    INSERT INTO t VALUES (1), (2), (3), (4);
    SELECT COUNT(*) FROM t WHERE test_nondet_counter() % 2 + t.a * 0 BETWEEN 0 AND 0;
}
expect {
    2
}

@backend cli
@skip-if sqlite "uses the Turso test-only counter"
test not-between-nondeterministic-lhs-once {
    CREATE TABLE t(a);
    INSERT INTO t VALUES (1), (2), (3), (4);
    SELECT COUNT(*) FROM t WHERE abs(test_nondet_counter() % 2 + t.a * 0) NOT BETWEEN -0 AND 0;
}
expect {
    2
}

@backend cli
@skip-if sqlite "uses the Turso test-only counter"
test between-nondeterministic-negative-literals-delete {
    CREATE TABLE t(a);
    INSERT INTO t VALUES (1), (2), (3), (4);
    DELETE FROM t WHERE test_nondet_counter() % 2 - 1 + t.a * 0 BETWEEN -1 AND -1;
    SELECT a FROM t ORDER BY a;
}
expect {
    2
    4
}

@cross-check-integrity
test between-deterministic-partial-index-predicate {
    CREATE TABLE t(a TEXT);
    INSERT INTO t VALUES ('a'), ('bb'), ('ccc');
    CREATE INDEX i ON t(a) WHERE length(a) BETWEEN 1 AND 2;
    SELECT a FROM t INDEXED BY i WHERE length(a) BETWEEN 1 AND 2 ORDER BY a;
}
expect {
    a
    bb
}

test between-row-value-in-select-list {
    SELECT (1, 2) BETWEEN (0, 0) AND (3, 3), (1, 2) NOT BETWEEN (0, 0) AND (3, 3), (5, 2) BETWEEN (0, 0) AND (3, 3);
}
expect {
    1|0|0
}

# A comparison applies the column affinity of one side to the other side. The two comparisons
# of a BETWEEN must not see each other's converted value.
test between-affinity-does-not-leak-between-comparisons {
    CREATE TABLE t(id INTEGER PRIMARY KEY, i INTEGER, r REAL, s TEXT);
    INSERT INTO t VALUES (1, 1, 1.5, 'a'), (2, 2, 2.0, 'B'), (3, 0, -1.0, '');
    SELECT id, i || '' BETWEEN r AND 2.5, (random() % 1) + i NOT BETWEEN s AND 0 FROM t ORDER BY id;
}
expect {
    1|0|1
    2|0|1
    3|0|0
}
