@database :memory:
@requires-file trigger "trigger tests require trigger support"

# A statement's OR IGNORE propagates into the trigger bodies it fires, but a
# DELETE always fires its own triggers with the default (ABORT) policy (see
# delete-trigger-resets-conflict-policy.sqltest). The outer policy must not be
# re-applied when a violation raised in such a frame unwinds back out: SQLite
# resolves a conflict where the constraint is checked, never at the frame
# boundary. Turso used to check the enclosing statement's resolution when a
# trigger subprogram returned a constraint error, so an outer OR IGNORE
# swallowed a UNIQUE violation raised below a trigger-fired DELETE and kept
# both effects of a statement that should have failed.

setup nested_delete_trigger {
    CREATE TABLE t(id INTEGER PRIMARY KEY, k INTEGER);
    CREATE UNIQUE INDEX i1 ON t(k);
    CREATE TABLE u(x INTEGER);
    INSERT INTO t VALUES(1,10),(2,20);
    INSERT INTO u VALUES(1);
    CREATE TRIGGER tg0 BEFORE INSERT ON t BEGIN DELETE FROM u WHERE x=1; END;
    CREATE TRIGGER tg1 AFTER DELETE ON u BEGIN UPDATE t SET k=k*2 WHERE id=1; END;
}

# The UPDATE in the AFTER DELETE trigger sets t.k to 20, which the unique index
# already holds for id=2. That frame never inherited the outer OR IGNORE, so
# the violation aborts the whole INSERT.
@setup nested_delete_trigger
test or-ignore-does-not-cross-trigger-fired-delete {
    INSERT OR IGNORE INTO t VALUES(3,30);
}
expect error {
    UNIQUE constraint failed: t.k
}

# ...and neither effect of the aborted statement is kept: the trigger's DELETE
# is rolled back along with the outer row it fired for.
@cross-check-integrity
@setup nested_delete_trigger
test or-ignore-across-trigger-fired-delete-keeps-nothing {
    INSERT OR IGNORE INTO t VALUES(3,30);
    SELECT count(*) FROM u;
    SELECT count(*) FROM t;
}
expect error {
    UNIQUE constraint failed: t.k
}

# Control for the two cases above on the *outer policy* axis: only IGNORE was
# swallowed at the frame boundary, because only IGNORE satisfied the old
# `program.resolve_type != Ignore` test. The same cascade under OR FAIL already
# raised before this change and still does, so this case passes either way and
# pins that the fix did not disturb the other conflict resolutions. (control)
@setup nested_delete_trigger
test or-fail-across-trigger-fired-delete-still-raises-control {
    INSERT OR FAIL INTO t VALUES(3,30);
}
expect error {
    UNIQUE constraint failed: t.k
}

# Control on the *inheritance* axis: an outer OR IGNORE that reaches a trigger's
# UPDATE directly IS inherited, so that UPDATE resolves its own violation inline
# and the outer row lands. This path always worked; it pins that the fix did not
# stop IGNORE propagating where SQLite does propagate it. (control)
@cross-check-integrity
test or-ignore-inherited-by-directly-fired-trigger-update-control {
    CREATE TABLE t(id INTEGER PRIMARY KEY, k INTEGER);
    CREATE UNIQUE INDEX i1 ON t(k);
    CREATE TABLE v(x INTEGER);
    INSERT INTO t VALUES(1,10),(2,20);
    CREATE TRIGGER tg2 AFTER INSERT ON v BEGIN UPDATE t SET k=10 WHERE id=2; END;
    INSERT OR IGNORE INTO v VALUES(1);
    SELECT count(*) FROM v;
    SELECT k FROM t ORDER BY id;
}
expect {
    1
    10
    20
}

# A trigger body is compiled as ONE subprogram: translate/trigger_exec.rs loops
# over every command of the body into a single builder, and the builder carries
# a single `resolve_type` scalar, so a multi-command body collapses to the last
# DML command's resolution. That scalar is not the policy of the command that
# raised either, which is why the boundary check is dropped outright rather
# than repointed at the subprogram: the emitters resolve an ignorable conflict
# where the constraint is checked (Goto row_done / skip_row_label) and only the
# aborting resolutions emit a halt, so a constraint error that unwinds out of a
# subprogram was necessarily raised under a resolution that aborts.
#
# The cases below hold on the unfixed tree too -- the behaviour they pin is one
# that a boundary policy check *introduces*, not one the original bug caused --
# so they are controls against base. They discriminate against a fix that
# repoints the boundary check at `subprogram.resolve_type` instead of removing
# it: every one of the three firing events below then swallows its violation.

setup trailing_ignore_insert {
    CREATE TABLE b(id INTEGER PRIMARY KEY, k INTEGER);
    CREATE UNIQUE INDEX bi ON b(k);
    CREATE TABLE w(x INTEGER);
    INSERT INTO b VALUES(1,10);
    CREATE TRIGGER tgA AFTER INSERT ON w BEGIN
        INSERT INTO b VALUES(2,10);
        INSERT OR IGNORE INTO b VALUES(3,99);
    END;
}

setup trailing_ignore_update {
    CREATE TABLE b(id INTEGER PRIMARY KEY, k INTEGER);
    CREATE UNIQUE INDEX bi ON b(k);
    CREATE TABLE w(x INTEGER);
    INSERT INTO b VALUES(1,10);
    INSERT INTO w VALUES(1);
    CREATE TRIGGER tgD AFTER UPDATE ON w BEGIN
        INSERT INTO b VALUES(2,10);
        INSERT OR IGNORE INTO b VALUES(3,99);
    END;
}

setup trailing_ignore_delete {
    CREATE TABLE b(id INTEGER PRIMARY KEY, k INTEGER);
    CREATE UNIQUE INDEX bi ON b(k);
    CREATE TABLE w(x INTEGER);
    INSERT INTO b VALUES(1,10);
    INSERT INTO w VALUES(1);
    CREATE TRIGGER tgE AFTER DELETE ON w BEGIN
        INSERT INTO b VALUES(2,10);
        INSERT OR IGNORE INTO b VALUES(3,99);
    END;
}

setup leading_ignore_insert {
    CREATE TABLE b(id INTEGER PRIMARY KEY, k INTEGER);
    CREATE UNIQUE INDEX bi ON b(k);
    CREATE TABLE w(x INTEGER);
    INSERT INTO b VALUES(1,10);
    CREATE TRIGGER tgC AFTER INSERT ON w BEGIN
        INSERT OR IGNORE INTO b VALUES(3,99);
        INSERT INTO b VALUES(2,10);
    END;
}

setup single_command_insert {
    CREATE TABLE b(id INTEGER PRIMARY KEY, k INTEGER);
    CREATE UNIQUE INDEX bi ON b(k);
    CREATE TABLE w(x INTEGER);
    INSERT INTO b VALUES(1,10);
    CREATE TRIGGER tgB AFTER INSERT ON w BEGIN
        INSERT INTO b VALUES(2,10);
    END;
}

# Multi-command AFTER INSERT body whose LAST command carries OR IGNORE. The
# violation is raised by the FIRST command, which has no OR clause, so the
# statement aborts and the outer row does not land. Note there is no OR clause
# on the outer INSERT either: a boundary check against the subprogram's
# resolution needs no OR clause anywhere to lose the violation. (control)
@cross-check-integrity
@setup trailing_ignore_insert
test trailing-or-ignore-does-not-excuse-earlier-command-on-insert-control {
    INSERT INTO w VALUES(1);
}
expect error {
    UNIQUE constraint failed: b.k
}

# The same body fired by UPDATE. (control)
@cross-check-integrity
@setup trailing_ignore_update
test trailing-or-ignore-does-not-excuse-earlier-command-on-update-control {
    UPDATE w SET x=2;
}
expect error {
    UNIQUE constraint failed: b.k
}

# The same body fired by DELETE, which additionally resets the policy to the
# default when it fires its own triggers. (control)
@cross-check-integrity
@setup trailing_ignore_delete
test trailing-or-ignore-does-not-excuse-earlier-command-on-delete-control {
    DELETE FROM w WHERE x=1;
}
expect error {
    UNIQUE constraint failed: b.k
}

# Reverse order on the same two commands: the OR IGNORE command runs FIRST and
# resolves its own conflict inline, the plain command raises SECOND. Ordering
# the body the other way must not change the outcome -- this is what makes the
# three cases above about the RAISING command's policy rather than about the
# mere presence of an OR IGNORE somewhere in the body. (control)
@cross-check-integrity
@setup leading_ignore_insert
test leading-or-ignore-does-not-excuse-later-command-control {
    INSERT INTO w VALUES(1);
}
expect error {
    UNIQUE constraint failed: b.k
}

# Single-command plain body: the only command in the subprogram is the one that
# raises, so the subprogram's resolution and the raising command's coincide and
# every candidate boundary check agrees. Pins the one-command case the
# multi-command rows above are contrasted with. (control)
@cross-check-integrity
@setup single_command_insert
test single-command-body-still-aborts-control {
    INSERT INTO w VALUES(1);
}
expect error {
    UNIQUE constraint failed: b.k
}

# An outer OR IGNORE around that same single-command body IS inherited by the
# body, so the violation resolves inline and the outer row lands -- the frame
# boundary is never reached. Pins that removing the boundary check did not turn
# an inherited IGNORE into an abort. (control)
@cross-check-integrity
@setup single_command_insert
test outer-or-ignore-inherited-by-single-command-body-control {
    INSERT OR IGNORE INTO w VALUES(1);
    SELECT count(*) FROM w;
    SELECT count(*) FROM b;
}
expect {
    1
    1
}
