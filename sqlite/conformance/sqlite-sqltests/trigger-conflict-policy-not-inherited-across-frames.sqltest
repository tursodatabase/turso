@database :memory:
@requires-file trigger "trigger tests require trigger support"

# A conflict is resolved where the constraint is checked, never at a frame
# boundary. A statement's OR IGNORE propagates into the trigger bodies it
# fires, but a DELETE fires its own triggers with the default (ABORT) policy
# (see delete-trigger-resets-conflict-policy.sqltest), so a violation raised
# in such a frame aborts the whole statement. Turso used to re-apply the
# enclosing statement's policy when a trigger subprogram returned a constraint
# error, and an outer OR IGNORE swallowed a UNIQUE violation raised below a
# trigger-fired DELETE.

setup nested_delete_trigger {
    CREATE TABLE t(id INTEGER PRIMARY KEY, k INTEGER);
    CREATE UNIQUE INDEX i1 ON t(k);
    CREATE TABLE u(x INTEGER);
    INSERT INTO t VALUES(1,10),(2,20);
    INSERT INTO u VALUES(1);
    CREATE TRIGGER tg0 BEFORE INSERT ON t BEGIN DELETE FROM u WHERE x=1; END;
    CREATE TRIGGER tg1 AFTER DELETE ON u BEGIN UPDATE t SET k=k*2 WHERE id=1; END;
}

# The UPDATE in the AFTER DELETE trigger sets t.k to 20, which the unique index
# already holds for id=2. That frame did not inherit the outer OR IGNORE, so
# the violation aborts the INSERT.
@setup nested_delete_trigger
test or-ignore-does-not-cross-trigger-fired-delete {
    INSERT OR IGNORE INTO t VALUES(3,30);
}
expect error {
    UNIQUE constraint failed: t.k
}

# The same cascade under OR FAIL raises as well.
@setup nested_delete_trigger
test or-fail-across-trigger-fired-delete-raises {
    INSERT OR FAIL INTO t VALUES(3,30);
}
expect error {
    UNIQUE constraint failed: t.k
}

# An outer OR IGNORE that reaches a trigger's UPDATE directly is inherited:
# the UPDATE resolves its own violation inline and the outer row lands.
@cross-check-integrity
test or-ignore-inherited-by-directly-fired-trigger-update {
    CREATE TABLE t(id INTEGER PRIMARY KEY, k INTEGER);
    CREATE UNIQUE INDEX i1 ON t(k);
    CREATE TABLE v(x INTEGER);
    INSERT INTO t VALUES(1,10),(2,20);
    CREATE TRIGGER tg2 AFTER INSERT ON v BEGIN UPDATE t SET k=10 WHERE id=2; END;
    INSERT OR IGNORE INTO v VALUES(1);
    SELECT count(*) FROM v;
    SELECT k FROM t ORDER BY id;
}
expect {
    1
    10
    20
}

# A trigger body is one subprogram with one resolve_type, that of its last
# DML command. The policy that governs a violation is the raising command's
# own: a trailing OR IGNORE does not excuse an earlier plain command, and a
# leading OR IGNORE that resolves its own conflict inline does not excuse a
# later one.

setup trailing_ignore_insert {
    CREATE TABLE b(id INTEGER PRIMARY KEY, k INTEGER);
    CREATE UNIQUE INDEX bi ON b(k);
    CREATE TABLE w(x INTEGER);
    INSERT INTO b VALUES(1,10);
    CREATE TRIGGER tgA AFTER INSERT ON w BEGIN
        INSERT INTO b VALUES(2,10);
        INSERT OR IGNORE INTO b VALUES(3,99);
    END;
}

setup trailing_ignore_update {
    CREATE TABLE b(id INTEGER PRIMARY KEY, k INTEGER);
    CREATE UNIQUE INDEX bi ON b(k);
    CREATE TABLE w(x INTEGER);
    INSERT INTO b VALUES(1,10);
    INSERT INTO w VALUES(1);
    CREATE TRIGGER tgD AFTER UPDATE ON w BEGIN
        INSERT INTO b VALUES(2,10);
        INSERT OR IGNORE INTO b VALUES(3,99);
    END;
}

setup trailing_ignore_delete {
    CREATE TABLE b(id INTEGER PRIMARY KEY, k INTEGER);
    CREATE UNIQUE INDEX bi ON b(k);
    CREATE TABLE w(x INTEGER);
    INSERT INTO b VALUES(1,10);
    INSERT INTO w VALUES(1);
    CREATE TRIGGER tgE AFTER DELETE ON w BEGIN
        INSERT INTO b VALUES(2,10);
        INSERT OR IGNORE INTO b VALUES(3,99);
    END;
}

# The leading command conflicts on k=10 and is ignored inline; the plain
# command behind it conflicts on the same value and raises.
setup leading_ignore_insert {
    CREATE TABLE b(id INTEGER PRIMARY KEY, k INTEGER);
    CREATE UNIQUE INDEX bi ON b(k);
    CREATE TABLE w(x INTEGER);
    INSERT INTO b VALUES(1,10);
    CREATE TRIGGER tgC AFTER INSERT ON w BEGIN
        INSERT OR IGNORE INTO b VALUES(3,10);
        INSERT INTO b VALUES(2,10);
    END;
}

setup single_command_insert {
    CREATE TABLE b(id INTEGER PRIMARY KEY, k INTEGER);
    CREATE UNIQUE INDEX bi ON b(k);
    CREATE TABLE w(x INTEGER);
    INSERT INTO b VALUES(1,10);
    CREATE TRIGGER tgB AFTER INSERT ON w BEGIN
        INSERT INTO b VALUES(2,10);
    END;
}

# The violation is raised by the first command, which has no OR clause, and
# neither does the outer INSERT: the trailing OR IGNORE governs only its own
# command.
@cross-check-integrity
@setup trailing_ignore_insert
test trailing-or-ignore-does-not-excuse-earlier-command-on-insert {
    INSERT INTO w VALUES(1);
}
expect error {
    UNIQUE constraint failed: b.k
}

# The same body fired by UPDATE.
@cross-check-integrity
@setup trailing_ignore_update
test trailing-or-ignore-does-not-excuse-earlier-command-on-update {
    UPDATE w SET x=2;
}
expect error {
    UNIQUE constraint failed: b.k
}

# The same body fired by DELETE, which fires its triggers with the default
# policy.
@cross-check-integrity
@setup trailing_ignore_delete
test trailing-or-ignore-does-not-excuse-earlier-command-on-delete {
    DELETE FROM w WHERE x=1;
}
expect error {
    UNIQUE constraint failed: b.k
}

# The OR IGNORE command runs first and resolves its own conflict inline; the
# plain command raises second. The order of the two commands does not change
# the outcome.
@cross-check-integrity
@setup leading_ignore_insert
test leading-or-ignore-does-not-excuse-later-command {
    INSERT INTO w VALUES(1);
}
expect error {
    UNIQUE constraint failed: b.k
}

# With one command in the body, the subprogram's resolution and the raising
# command's coincide.
@cross-check-integrity
@setup single_command_insert
test single-command-body-still-aborts {
    INSERT INTO w VALUES(1);
}
expect error {
    UNIQUE constraint failed: b.k
}

# An outer OR IGNORE around that same single-command body is inherited by the
# body: the violation resolves inline and the outer row lands.
@cross-check-integrity
@setup single_command_insert
test outer-or-ignore-inherited-by-single-command-body {
    INSERT OR IGNORE INTO w VALUES(1);
    SELECT count(*) FROM w;
    SELECT count(*) FROM b;
}
expect {
    1
    1
}

# NOT NULL and CHECK violations are resolved inline by their emitters under an
# ignorable resolution and never reach the frame boundary. A STRICT table's
# datatype violation is raised by the vdbe at run time, so it escapes the
# subprogram whatever resolution is in force, and the enclosing OR IGNORE must
# not suppress it: the nested and unnested spellings agree.

setup strict_child {
    CREATE TABLE s(id INTEGER PRIMARY KEY, k INTEGER) STRICT;
    CREATE TABLE w(x INTEGER);
    CREATE TRIGGER tgS AFTER INSERT ON w BEGIN
        INSERT INTO s VALUES(2, 'not-an-int');
    END;
}

# The unnested spelling: OR IGNORE does not excuse a STRICT datatype violation
# at the top level.
@setup strict_child
test or-ignore-does-not-excuse-strict-datatype-error-at-top-level {
    INSERT OR IGNORE INTO s VALUES(1, 'not-an-int');
}
expect error {
    cannot store TEXT value in INTEGER column s.k
}

# The nested spelling of the same statement: the violation is raised inside a
# trigger body under an outer OR IGNORE and still aborts.
@cross-check-integrity
@setup strict_child
test or-ignore-does-not-excuse-strict-datatype-error-across-frames {
    INSERT OR IGNORE INTO w VALUES(1);
}
expect error {
    cannot store TEXT value in INTEGER column s.k
}

# RAISE(ABORT) travels a different error path (RaiseIgnore/Abort, not
# LimboError::Constraint). An outer OR IGNORE does not swallow it either.
test outer-or-ignore-does-not-swallow-raise-abort {
    CREATE TABLE w2(x INTEGER);
    CREATE TRIGGER tgR AFTER INSERT ON w2 BEGIN
        SELECT RAISE(ABORT, 'nope');
    END;
    INSERT OR IGNORE INTO w2 VALUES(1);
}
expect error {
    nope
}
