@database :memory:

@cross-check-integrity
test left-join-keeps-rows-for-is-on-nullable-unique {
    CREATE TABLE t (id INTEGER PRIMARY KEY, x INTEGER, c TEXT);
    CREATE TABLE a (id INTEGER PRIMARY KEY, u INTEGER UNIQUE);
    INSERT INTO t VALUES (1,NULL,'p');
    INSERT INTO a VALUES (1,NULL), (2,NULL);
    SELECT t.id FROM t LEFT JOIN a ON a.u IS t.x ORDER BY 1;
}
expect {
    1
    1
}

@cross-check-integrity
test left-join-keeps-rows-for-rowid-equal-to-own-column {
    CREATE TABLE t (id INTEGER PRIMARY KEY, x INTEGER, c TEXT);
    CREATE TABLE a (id INTEGER PRIMARY KEY, y INTEGER);
    INSERT INTO t VALUES (1,1,'p'), (2,2,'q');
    INSERT INTO a VALUES (1,1), (2,2);
    SELECT t.id FROM t LEFT JOIN a ON a.id = a.y ORDER BY 1;
}
expect {
    1
    1
    2
    2
}

@cross-check-integrity
test left-join-keeps-rows-for-unique-text-compared-with-integer {
    CREATE TABLE t (id INTEGER PRIMARY KEY, x INTEGER, c TEXT);
    CREATE TABLE a (id INTEGER PRIMARY KEY, s TEXT UNIQUE);
    INSERT INTO t VALUES (1,1,'p');
    INSERT INTO a VALUES (1,'1'), (2,'1.0');
    SELECT t.id FROM t LEFT JOIN a ON a.s = t.x ORDER BY 1;
}
expect {
    1
    1
}

@cross-check-integrity
test left-join-keeps-rows-for-unique-compared-with-other-collation {
    CREATE TABLE t (id INTEGER PRIMARY KEY, x INTEGER, c TEXT);
    CREATE TABLE a (id INTEGER PRIMARY KEY, s TEXT UNIQUE);
    INSERT INTO t VALUES (1,1,'p');
    INSERT INTO a VALUES (1,'p'), (2,'P');
    SELECT t.id FROM t LEFT JOIN a ON a.s = t.c COLLATE NOCASE ORDER BY 1;
}
expect {
    1
    1
}

@cross-check-integrity
test left-join-keeps-rows-for-partial-unique-index {
    CREATE TABLE t (id INTEGER PRIMARY KEY, x INTEGER, c TEXT);
    CREATE TABLE a (id INTEGER PRIMARY KEY, k TEXT, w INTEGER);
    CREATE UNIQUE INDEX a_k ON a (k) WHERE w > 0;
    INSERT INTO t VALUES (1,1,'p');
    INSERT INTO a VALUES (1,'p',0), (2,'p',0);
    SELECT t.id FROM t LEFT JOIN a ON a.k = t.c ORDER BY 1;
}
expect {
    1
    1
}

@cross-check-integrity
test left-join-keeps-rows-for-part-of-multi-column-unique {
    CREATE TABLE t (id INTEGER PRIMARY KEY, x INTEGER, c TEXT);
    CREATE TABLE a (id INTEGER PRIMARY KEY, p INTEGER, q INTEGER, UNIQUE (p, q));
    INSERT INTO t VALUES (1,1,'p');
    INSERT INTO a VALUES (1,1,1), (2,1,2);
    SELECT t.id FROM t LEFT JOIN a ON a.p = t.x ORDER BY 1;
}
expect {
    1
    1
}

@cross-check-integrity
test left-join-table-used-in-result {
    CREATE TABLE t (id INTEGER PRIMARY KEY, x INTEGER, c TEXT);
    CREATE TABLE a (id INTEGER PRIMARY KEY, y INTEGER, w INTEGER);
    CREATE TABLE b (id INTEGER PRIMARY KEY, z INTEGER);
    INSERT INTO t VALUES (1,1,'p'), (2,9,'q'), (3,2,'r');
    INSERT INTO a VALUES (1,10,5), (2,20,3);
    INSERT INTO b VALUES (10,100), (20,200);
    SELECT t.id, a.w FROM t LEFT JOIN a ON a.id = t.x ORDER BY 1;
}
expect {
    1|5
    2|
    3|3
}

@cross-check-integrity
test left-join-table-used-in-order-by {
    CREATE TABLE t (id INTEGER PRIMARY KEY, x INTEGER, c TEXT);
    CREATE TABLE a (id INTEGER PRIMARY KEY, y INTEGER, w INTEGER);
    CREATE TABLE b (id INTEGER PRIMARY KEY, z INTEGER);
    INSERT INTO t VALUES (1,1,'p'), (2,9,'q'), (3,2,'r');
    INSERT INTO a VALUES (1,10,5), (2,20,3);
    INSERT INTO b VALUES (10,100), (20,200);
    SELECT t.id FROM t LEFT JOIN a ON a.id = t.x ORDER BY a.w, t.id;
}
expect {
    2
    3
    1
}

@cross-check-integrity
test left-join-table-used-in-where {
    CREATE TABLE t (id INTEGER PRIMARY KEY, x INTEGER, c TEXT);
    CREATE TABLE a (id INTEGER PRIMARY KEY, y INTEGER, w INTEGER);
    CREATE TABLE b (id INTEGER PRIMARY KEY, z INTEGER);
    INSERT INTO t VALUES (1,1,'p'), (2,9,'q'), (3,2,'r');
    INSERT INTO a VALUES (1,10,5), (2,20,3);
    INSERT INTO b VALUES (10,100), (20,200);
    SELECT t.id FROM t LEFT JOIN a ON a.id = t.x WHERE a.w IS NULL ORDER BY 1;
}
expect {
    2
}

@cross-check-integrity
test left-join-table-used-in-next-join-on {
    CREATE TABLE t (id INTEGER PRIMARY KEY, x INTEGER, c TEXT);
    CREATE TABLE a (id INTEGER PRIMARY KEY, y INTEGER, w INTEGER);
    CREATE TABLE b (id INTEGER PRIMARY KEY, z INTEGER);
    INSERT INTO t VALUES (1,1,'p'), (2,9,'q'), (3,2,'r');
    INSERT INTO a VALUES (1,10,5), (2,20,3);
    INSERT INTO b VALUES (10,100), (20,200);
    SELECT t.id, b.z FROM t LEFT JOIN a ON a.id = t.x LEFT JOIN b ON b.id = a.y ORDER BY 1;
}
expect {
    1|100
    2|
    3|200
}

@cross-check-integrity
test left-join-table-used-in-result-subquery {
    CREATE TABLE t (id INTEGER PRIMARY KEY, x INTEGER, c TEXT);
    CREATE TABLE a (id INTEGER PRIMARY KEY, y INTEGER, w INTEGER);
    CREATE TABLE b (id INTEGER PRIMARY KEY, z INTEGER);
    INSERT INTO t VALUES (1,1,'p'), (2,9,'q'), (3,2,'r');
    INSERT INTO a VALUES (1,10,5), (2,20,3);
    INSERT INTO b VALUES (10,100), (20,200);
    SELECT t.id, (SELECT z FROM b WHERE b.id = a.y) FROM t LEFT JOIN a ON a.id = t.x ORDER BY 1;
}
expect {
    1|100
    2|
    3|200
}

@cross-check-integrity
test left-join-table-used-in-own-on-subquery {
    CREATE TABLE t (id INTEGER PRIMARY KEY, x INTEGER, c TEXT);
    CREATE TABLE a (id INTEGER PRIMARY KEY, y INTEGER, w INTEGER);
    CREATE TABLE b (id INTEGER PRIMARY KEY, z INTEGER);
    INSERT INTO t VALUES (1,1,'p'), (2,9,'q'), (3,2,'r');
    INSERT INTO a VALUES (1,10,5), (2,20,3);
    INSERT INTO b VALUES (10,100), (20,200);
    SELECT t.id FROM t LEFT JOIN a ON a.id = t.x AND EXISTS (SELECT 1 FROM b WHERE b.id = a.y) ORDER BY 1;
}
expect {
    1
    2
    3
}

@cross-check-integrity
test left-join-table-used-in-group-by {
    CREATE TABLE t (id INTEGER PRIMARY KEY, x INTEGER, c TEXT);
    CREATE TABLE a (id INTEGER PRIMARY KEY, y INTEGER, w INTEGER);
    CREATE TABLE b (id INTEGER PRIMARY KEY, z INTEGER);
    INSERT INTO t VALUES (1,1,'p'), (2,9,'q'), (3,2,'r');
    INSERT INTO a VALUES (1,10,5), (2,20,3);
    INSERT INTO b VALUES (10,100), (20,200);
    SELECT 1 FROM t LEFT JOIN a ON a.id = t.x GROUP BY a.w ORDER BY 1;
}
expect {
    1
    1
    1
}

@cross-check-integrity
test left-join-with-distinct-and-aggregate-keeps-rows {
    CREATE TABLE t (id INTEGER PRIMARY KEY, x INTEGER, c TEXT);
    CREATE TABLE a (id INTEGER PRIMARY KEY, w INTEGER);
    INSERT INTO t VALUES (1,1,'p'), (2,2,'q');
    INSERT INTO a VALUES (1,1), (2,1), (3,7);
    SELECT DISTINCT count(*) FROM t LEFT JOIN a ON a.w = t.x;
}
expect {
    3
}

@cross-check-integrity
test inner-join-with-distinct-still-filters {
    CREATE TABLE t (id INTEGER PRIMARY KEY, x INTEGER, c TEXT);
    CREATE TABLE a (id INTEGER PRIMARY KEY, w INTEGER);
    INSERT INTO t VALUES (1,1,'p'), (2,2,'q');
    INSERT INTO a VALUES (1,1), (2,1), (3,7);
    SELECT DISTINCT t.id FROM t JOIN a ON a.w = t.x ORDER BY 1;
}
expect {
    1
}

@cross-check-integrity
test full-join-with-distinct-keeps-unmatched-rows {
    CREATE TABLE t (id INTEGER PRIMARY KEY, x INTEGER, c TEXT);
    CREATE TABLE a (id INTEGER PRIMARY KEY, w INTEGER);
    INSERT INTO t VALUES (1,1,'p'), (2,2,'q');
    INSERT INTO a VALUES (1,1), (2,1), (3,7);
    SELECT DISTINCT t.id FROM t FULL JOIN a ON a.w = t.x ORDER BY 1;
}
expect {
    
    1
    2
}

@cross-check-integrity
test left-join-keeps-rows-for-non-unique-index {
    CREATE TABLE t (id INTEGER PRIMARY KEY, x INTEGER, c TEXT);
    CREATE TABLE a (id INTEGER PRIMARY KEY, k INTEGER);
    CREATE INDEX a_k ON a (k);
    INSERT INTO t VALUES (1,1,'p');
    INSERT INTO a VALUES (1,1), (2,1);
    SELECT t.id FROM t LEFT JOIN a ON a.k = t.x ORDER BY 1;
}
expect {
    1
    1
}

@cross-check-integrity
test left-join-keeps-rows-for-subquery-named-like-table-with-unique-index {
    CREATE TABLE t (id INTEGER PRIMARY KEY, x INTEGER, c TEXT);
    CREATE TABLE a (id INTEGER PRIMARY KEY, u INTEGER UNIQUE);
    CREATE TABLE s (id INTEGER, u INTEGER);
    INSERT INTO t VALUES (1,1,'p'), (2,2,'q');
    INSERT INTO a VALUES (1,1);
    INSERT INTO s VALUES (1,1), (2,1), (3,1);
    SELECT t.id FROM t LEFT JOIN (SELECT id, u FROM s) a ON a.u = t.x ORDER BY 1;
}
expect {
    1
    1
    1
    2
}

@cross-check-integrity
test update-from-with-unused-left-join {
    CREATE TABLE t (id INTEGER PRIMARY KEY, v INTEGER);
    CREATE TABLE s (id INTEGER PRIMARY KEY, x INTEGER);
    CREATE TABLE u (id INTEGER PRIMARY KEY, c INTEGER);
    INSERT INTO t VALUES (1,0), (2,0), (3,0);
    INSERT INTO s VALUES (1,10), (2,20);
    INSERT INTO u VALUES (1,100);
    UPDATE t SET v = s.x FROM s LEFT JOIN u ON u.id = s.id WHERE t.id = s.id;
    SELECT id, v FROM t ORDER BY 1;
}
expect {
    1|10
    2|20
    3|0
}
