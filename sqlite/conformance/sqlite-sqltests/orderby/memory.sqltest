@database :memory:

@cross-check-integrity
test distinct_orderby_regression {
    CREATE TABLE t (a,b,c,d);
    INSERT INTO t VALUES (1,2,3,4),(2,3,4,5);
    SELECT DISTINCT c,b FROM t ORDER BY d,b;
}
expect {
    3|2
    4|3
}

# In ORDER BY clauses, column aliases take precedence when resolving identifiers to columns.
@cross-check-integrity
test orderby_alias_precedence {
    CREATE TABLE t(x,y);
    INSERT INTO t VALUES (1,200),(2,100);
    SELECT x AS y, y AS x FROM t ORDER BY x;
}
expect {
    2|100
    1|200
}

# Check that ORDER BY with heap-sort properly handle multiple rows with same order key + result values
@cross-check-integrity
test orderby_same_rows {
    CREATE TABLE t(x,y,z);
    INSERT INTO t VALUES (1,2,3),(1,2,6),(1,2,9),(1,2,10),(1,3,-1),(1,3,-2);
    SELECT x, y FROM t ORDER BY x, y LIMIT 10;
}
expect {
    1|2
    1|2
    1|2
    1|2
    1|3
    1|3
}

# https://github.com/tursodatabase/turso/issues/3684
@cross-check-integrity
test orderby_alias_shadows_column {
    CREATE TABLE t(a, b);
    INSERT INTO t VALUES (1, 1), (2, 2), (3, 3);
    SELECT a, -b AS a FROM t ORDER BY a;
}
expect {
    3|-3
    2|-2
    1|-1
}

@cross-check-integrity
test order_by_ambiguous_column {
    CREATE TABLE a(id INT, value INT);
    INSERT INTO a VALUES (1, 10), (2, 20);
    CREATE TABLE b(id INT, value INT);
    INSERT INTO b VALUES (1, 100), (2, 200);
    SELECT
    a.id,
    b.value
    FROM
    a JOIN b ON a.id = b.id
    ORDER BY
    value;
}
expect error {
}

# https://github.com/tursodatabase/turso/issues/4608
# Float literals in ORDER BY should be treated as constant expressions, not column references.
# They should not cause parse errors.
test orderby_float_literal {
    SELECT 1 ORDER BY 0.5;
}
expect {
    1
}

@cross-check-integrity
test orderby_float_literal_with_table {
    CREATE TABLE t(x);
    INSERT INTO t VALUES (3), (1), (2);
    SELECT x FROM t ORDER BY 0.5;
}
expect {
    3
    1
    2
}

# Single-row aggregate queries (aggregates without GROUP BY) produce exactly one row,
# so sqlite removes ORDER BY entirely because it's meaningless - this also means validation
# of the ORDER BY is skipped. In these examples, the ORDER BY contains an invalid subquery
# where the column counts don't match: a IN (SELECT a, b, c FROM t). This would normally fail
# validation but doesn't since the ORDER BY is removed.
@cross-check-integrity
test orderby_single_row_aggregate_optimization {
    CREATE TABLE t(a, b, c);
    SELECT COUNT(a) FROM t ORDER BY COALESCE(a IN (SELECT a, b, c FROM t), b);
}
expect {
    0
}

@cross-check-integrity
test orderby_single_row_aggregate_with_data {
    CREATE TABLE t(a, b, c);
    INSERT INTO t VALUES (1, 2, 3), (4, 5, 6);
    SELECT COUNT(a) FROM t ORDER BY COALESCE(a IN (SELECT a, b, c FROM t), b);
}
expect {
    2
}

# SQLite truncates ORDER BY after a rowid/INTEGER PRIMARY KEY column since the table is
# stored in rowid order and a unique column means no ties. This skips validation of
# subsequent clauses, so even invalid constructs like multi-column IN subqueries pass.
@cross-check-integrity
test orderby_rowid_truncation {
    CREATE TABLE t(a INTEGER PRIMARY KEY, b TEXT);
    INSERT INTO t VALUES (1, 'x'), (2, 'y');
    SELECT a FROM t ORDER BY a DESC, b NOT IN (SELECT a, b FROM t);
}
expect {
    2
    1
}

@cross-check-integrity
test orderby_rowid_truncation_explicit_rowid {
    CREATE TABLE t(a INTEGER, b TEXT);
    INSERT INTO t VALUES (1, 'x'), (2, 'y');
    SELECT a FROM t ORDER BY rowid DESC, b NOT IN (SELECT a, b FROM t);
}
expect {
    2
    1
}

# A window function or aggregate in an ORDER BY term removed by the rowid
# truncation or by duplicate removal must not be planned. min/max with a
# moving frame failed with "table not found" when such a term was a copy of a
# result column whose window ORDER BY or PARTITION BY is nondeterministic.
@cross-check-integrity
test orderby_rowid_truncation_window_min_max {
    CREATE TABLE t0(c0);
    INSERT INTO t0 VALUES(1),(2);
    SELECT rowid, max(c0) OVER (ORDER BY strftime(NULL) ROWS CURRENT ROW) FROM t0 ORDER BY 1, 2;
    SELECT rowid, min(c0) OVER (ORDER BY strftime(NULL) ROWS CURRENT ROW) FROM t0 ORDER BY 1, 2;
    SELECT rowid, max(c0) OVER (ORDER BY random() ROWS CURRENT ROW) FROM t0 ORDER BY 1, 2;
    SELECT rowid, max(c0) OVER (PARTITION BY changes() ORDER BY strftime(NULL) RANGE BETWEEN CURRENT ROW AND CURRENT ROW) FROM t0 ORDER BY 1, 2;
    SELECT rowid, max(c0) OVER (ORDER BY strftime(NULL) ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) FROM t0 ORDER BY rowid, 2 DESC;
    SELECT rowid FROM t0 ORDER BY rowid, max(c0) OVER (ORDER BY c0 ROWS CURRENT ROW);
    SELECT rowid, max(c0) OVER (ORDER BY random() ROWS CURRENT ROW) FROM t0 ORDER BY 2, 2;
}
expect {
    1|1
    2|2
    1|1
    2|2
    1|1
    2|2
    1|2
    2|2
    1|1
    2|2
    1
    2
    1|1
    2|2
}

@cross-check-integrity
test orderby_rowid_truncation_window_min_max_integer_primary_key {
    CREATE TABLE t1(id INTEGER PRIMARY KEY, c0);
    INSERT INTO t1 VALUES(1,1),(2,2);
    SELECT id, max(c0) OVER (ORDER BY strftime(NULL) ROWS CURRENT ROW) FROM t1 ORDER BY 1, 2;
}
expect {
    1|1
    2|2
}

@cross-check-integrity
test orderby_rowid_truncation_skips_aggregate_misuse {
    CREATE TABLE t(a, b);
    INSERT INTO t VALUES (1, 'x'), (2, 'y');
    SELECT a FROM t ORDER BY rowid, min(a);
}
expect {
    1
    2
}

test orderby_rowid_truncation_still_checks_window_name {
    CREATE TABLE t0(c0);
    INSERT INTO t0 VALUES(1),(2);
    SELECT c0 FROM t0 ORDER BY rowid, max(c0) OVER nosuch;
}
expect error {
    no such window: nosuch
}

test orderby_rowid_truncation_still_checks_distinct_window_function {
    CREATE TABLE t0(c0);
    INSERT INTO t0 VALUES(1),(2);
    SELECT c0 FROM t0 ORDER BY rowid, count(DISTINCT c0) OVER ();
}
expect error {
    DISTINCT is not supported for window functions
}

test orderby_rowid_truncation_checks_aggregate_misuse_with_window_in_select {
    CREATE TABLE t0(c0);
    INSERT INTO t0 VALUES(1),(2);
    SELECT c0, max(c0) OVER () FROM t0 ORDER BY rowid, sum(c0);
}
expect error {
    misuse of aggregate: sum()
}

test orderby_rowid_truncation_checks_aggregate_misuse_next_to_window {
    CREATE TABLE t0(c0);
    INSERT INTO t0 VALUES(1),(2);
    SELECT c0, max(c0) OVER () FROM t0 ORDER BY rowid, sum(c0) + max(c0) OVER ();
}
expect error {
    misuse of aggregate: sum()
}

test orderby_rowid_truncation_checks_aggregate_misuse_with_window_in_cut_term {
    CREATE TABLE t0(c0);
    INSERT INTO t0 VALUES(1),(2);
    SELECT c0 FROM t0 ORDER BY rowid, min(c0) OVER (), sum(c0);
}
expect error {
    misuse of aggregate: sum()
}

test orderby_rowid_truncation_checks_aggregate_inside_window_function {
    CREATE TABLE t0(c0);
    INSERT INTO t0 VALUES(1),(2);
    SELECT c0 FROM t0 ORDER BY rowid, max(max(c0)) OVER ();
}
expect error {
    misuse of aggregate: max()
}

# The ORDER BY terms that the rowid truncation or a single-row aggregate removes are
# never evaluated, but SQLite still resolves the names and functions in them.
test orderby_rowid_truncation_checks_subquery_column_names {
    CREATE TABLE z(q, p);
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    SELECT d FROM y ORDER BY id, (SELECT c0 FROM z);
}
expect error {
    no such column: c0
}

test orderby_rowid_truncation_checks_exists_column_names {
    CREATE TABLE z(q, p);
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    SELECT d FROM y ORDER BY id, EXISTS (SELECT c0 FROM z) LIMIT 1;
}
expect error {
    no such column: c0
}

test orderby_rowid_truncation_checks_in_subquery_table_names {
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    SELECT d FROM y ORDER BY rowid, d IN (SELECT 1 FROM nosuch);
}
expect error {
    no such table: nosuch
}

test orderby_rowid_truncation_checks_nested_cte_column_names {
    CREATE TABLE x(a, b);
    INSERT INTO x(a) VALUES (1);
    CREATE TABLE z(q INTEGER, p INTEGER);
    CREATE TABLE y(id INTEGER PRIMARY KEY, d INTEGER);
    UPDATE x SET b = 1
    WHERE 1 OR (
        SELECT d FROM y
        ORDER BY id, MAX(0, d, EXISTS (
            WITH c AS (SELECT * FROM z WHERE p)
            SELECT DISTINCT c0 FROM c WHERE c0 ORDER BY c0
        ))
        LIMIT 1
    )
    RETURNING a, b;
}
expect error {
    no such column: c0
}

test orderby_single_row_aggregate_checks_subquery_column_names {
    CREATE TABLE z(q, p);
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    SELECT count(*) FROM y ORDER BY (SELECT c0 FROM z);
}
expect error {
    no such column: c0
}

test orderby_rowid_truncation_checks_subquery_function_names {
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    SELECT d FROM y ORDER BY id, (SELECT nosuchfn(d));
}
expect error {
    no such function: nosuchfn
}

test orderby_rowid_truncation_checks_function_names {
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    SELECT d FROM y ORDER BY id, nosuchfn(1);
}
expect error {
    no such function: nosuchfn
}

test orderby_rowid_truncation_checks_function_argument_counts {
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    SELECT d FROM y ORDER BY id, (SELECT abs(1, 2, 3));
}
expect error {
    wrong number of arguments to function abs\(\)
}

test orderby_single_row_aggregate_checks_function_names {
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    SELECT count(*) FROM y ORDER BY nosuchfn(1);
}
expect error {
    no such function: nosuchfn
}

test exists_orderby_checks_function_names {
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    INSERT INTO y VALUES (1, 2);
    SELECT EXISTS (SELECT 1 FROM y ORDER BY nosuchfn(d));
}
expect error {
    no such function: nosuchfn
}

test exists_orderby_checks_function_argument_counts {
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    INSERT INTO y VALUES (1, 2);
    SELECT EXISTS (SELECT 1 FROM y ORDER BY abs(d, 1));
}
expect error {
    wrong number of arguments to function abs\(\)
}

test exists_orderby_ignores_unknown_collation {
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    INSERT INTO y VALUES (1, 2);
    SELECT EXISTS (SELECT 1 FROM y ORDER BY d COLLATE bogus);
}
expect {
    1
}

test orderby_rowid_truncation_checks_collation_names {
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    INSERT INTO y VALUES (1, 2);
    SELECT d FROM y ORDER BY id, d COLLATE bogus;
}
expect error {
    no such collation sequence: bogus
}

test orderby_rowid_truncation_checks_collation_names_under_operator {
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    INSERT INTO y VALUES (1, 2);
    SELECT d FROM y ORDER BY id, (d COLLATE bogus) + 1;
}
expect error {
    no such collation sequence: bogus
}

test orderby_single_row_aggregate_checks_collation_names {
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    INSERT INTO y VALUES (1, 2);
    SELECT count(*) FROM y ORDER BY d COLLATE bogus;
}
expect error {
    no such collation sequence: bogus
}

test orderby_rowid_truncation_checks_aggregate_in_subquery_where {
    CREATE TABLE z(q, p);
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    SELECT d FROM y ORDER BY id, (SELECT q FROM z WHERE q = max(y.d));
}
expect error {
    misuse of aggregate function max\(\)
}

test orderby_single_row_aggregate_checks_aggregate_in_subquery_where {
    CREATE TABLE z(q, p);
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    SELECT count(*) FROM y ORDER BY (SELECT q FROM z WHERE q = max(y.d));
}
expect error {
    misuse of aggregate function max\(\)
}

# SQLite cuts the terms after the rowid only when each reads the table or is
# constant. An uncorrelated subquery does neither, so all terms are compiled.
test orderby_rowid_truncation_keeps_terms_with_uncorrelated_subquery {
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    SELECT d FROM y ORDER BY id, (SELECT 1, 2);
}
expect error {
    (sub-select returns 2 columns - expected 1|row value misused)
}

# A wrong column count deep inside the subquery does not make the term read the
# table, so the term is still compiled and the error is reported.
test orderby_rowid_truncation_keeps_terms_with_uncorrelated_subquery_with_wrong_column_count {
    CREATE TABLE z(q, p);
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    INSERT INTO y VALUES (1, 5);
    SELECT d FROM y ORDER BY id, (SELECT q FROM z WHERE q IN (SELECT 1, 2));
}
expect error {
    sub-select returns 2 columns - expected 1
}

@cross-check-integrity
test orderby_removed_term_ignores_wrong_column_count_in_subquery_that_reads_the_table {
    CREATE TABLE z(q, p);
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    INSERT INTO y VALUES (1, 5), (2, 6);
    SELECT d FROM y ORDER BY id, (SELECT q FROM z WHERE q = y.d AND q IN (SELECT 1, 2));
    SELECT d FROM y ORDER BY id, (SELECT (SELECT q FROM z WHERE q = y.d AND q IN (SELECT 1, 2)));
    SELECT count(*) FROM y ORDER BY (SELECT q FROM z WHERE q IN (SELECT 1, 2));
}
expect {
    5
    6
    5
    6
    2
}

@cross-check-integrity
test orderby_rowid_truncation_cuts_terms_that_read_the_table {
    CREATE TABLE z(q, p);
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    INSERT INTO y VALUES (1, 5), (2, 6);
    SELECT d FROM y ORDER BY id, d IN (SELECT 1, 2);
    SELECT d FROM y ORDER BY id, (SELECT q, p FROM z WHERE q = y.d);
    SELECT d FROM y ORDER BY id DESC, (SELECT 1), random();
}
expect {
    5
    6
    5
    6
    6
    5
}

# A GROUP BY term that names a result column by number or alias may read the
# outer query's columns through it.
@cross-check-integrity
test orderby_removed_term_subquery_groups_by_result_column_of_outer_column {
    CREATE TABLE z(q, p);
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    INSERT INTO y VALUES (1, 5), (2, 6);
    INSERT INTO z VALUES (5, 1);
    SELECT d FROM y ORDER BY id, (SELECT d FROM z GROUP BY 1);
    SELECT d FROM y ORDER BY id, (SELECT d AS k FROM z GROUP BY k);
    SELECT count(*) FROM y ORDER BY (SELECT d FROM z GROUP BY 1);
}
expect {
    5
    6
    5
    6
    2
}

# SQLite reports most wrong column counts only while generating code, so a subquery
# with one in a removed ORDER BY term is accepted.
@cross-check-integrity
test orderby_removed_term_subquery_with_wrong_column_count {
    CREATE TABLE z(q, p);
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    INSERT INTO y VALUES (1, 5), (2, 6);
    INSERT INTO z VALUES (5, 1);
    SELECT d FROM y ORDER BY id, (SELECT (1, 2) FROM z WHERE q = y.d);
    SELECT d FROM y ORDER BY id, (SELECT q FROM z WHERE q = y.d ORDER BY (1, 2));
    SELECT d FROM y ORDER BY id, (SELECT q FROM z WHERE q = y.d GROUP BY (1, 2));
    SELECT d FROM y ORDER BY id, (SELECT q FROM z WHERE q = y.d LIMIT (1, 2));
    SELECT d FROM y ORDER BY id, (SELECT q FROM z WHERE y.d IN (SELECT q, p FROM z));
    SELECT d FROM y ORDER BY id, (SELECT q FROM z WHERE q = y.d AND 1 IN ((1, 2)));
    SELECT count(*) FROM y ORDER BY (SELECT (1, 2) FROM z);
    SELECT count(*) FROM y ORDER BY (SELECT q FROM z WHERE q IN (SELECT (1, 2) FROM z));
}
expect {
    5
    6
    5
    6
    5
    6
    5
    6
    5
    6
    5
    6
    2
    2
}

test where_rejects_aggregate_in_term_without_code {
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    SELECT d FROM y WHERE 0 AND max(d);
}
expect error {
    misuse of aggregate function max\(\)
}

test delete_where_rejects_aggregate_in_term_without_code {
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    DELETE FROM y WHERE 0 AND max(d);
}
expect error {
    misuse of aggregate function max\(\)
}

test update_where_rejects_aggregate_in_term_without_code {
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    UPDATE y SET d = 1 WHERE 0 AND count(*);
}
expect error {
    misuse of aggregate function count\(\)
}

test where_checks_function_names_in_term_without_code {
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    SELECT d FROM y WHERE 0 AND nosuchfn(d);
}
expect error {
    no such function: nosuchfn
}

test delete_where_checks_function_names_in_term_without_code {
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    INSERT INTO y VALUES (1, 5);
    DELETE FROM y WHERE 1 OR nosuchfn(d);
}
expect error {
    no such function: nosuchfn
}

test update_where_checks_function_names_in_term_without_code {
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    INSERT INTO y VALUES (1, 5);
    UPDATE y SET d = 1 WHERE 1 OR nosuchfn(d);
}
expect error {
    no such function: nosuchfn
}

test update_where_checks_function_argument_counts_in_term_without_code {
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    INSERT INTO y VALUES (1, 5);
    UPDATE y SET d = 1 WHERE 1 OR abs(1, 2);
}
expect error {
    wrong number of arguments to function abs\(\)
}

test join_on_checks_function_names_in_term_without_code {
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    INSERT INTO y VALUES (1, 5);
    SELECT * FROM y JOIN y AS w ON 1 OR nosuchfn(w.d);
}
expect error {
    no such function: nosuchfn
}

test left_join_on_checks_function_names_in_term_without_code {
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    INSERT INTO y VALUES (1, 5);
    SELECT * FROM y LEFT JOIN y AS w ON 0 AND nosuchfn(w.d);
}
expect error {
    no such function: nosuchfn
}

test join_on_checks_function_argument_counts_in_term_without_code {
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    INSERT INTO y VALUES (1, 5);
    SELECT * FROM y JOIN y AS w ON 1 OR abs(1, 2);
}
expect error {
    wrong number of arguments to function abs\(\)
}

test join_on_rejects_aggregate_in_term_without_code {
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    INSERT INTO y VALUES (1, 5);
    SELECT * FROM y JOIN y AS w ON 0 AND max(w.d);
}
expect error {
    misuse of aggregate function max\(\)
}

test update_from_join_on_checks_function_names_in_term_without_code {
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    INSERT INTO y VALUES (1, 5);
    UPDATE y SET d = 3 FROM y AS a JOIN y AS b ON 1 OR nosuchfn(b.d) WHERE a.id = y.id;
}
expect error {
    no such function: nosuchfn
}

# The WHERE of an aggregate query may use an aggregate of an outer query.
@cross-check-integrity
test where_of_aggregate_subquery_uses_outer_aggregate {
    CREATE TABLE z(q, p);
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    INSERT INTO y VALUES (1, 5), (2, 6);
    INSERT INTO z VALUES (5, 1), (6, 2);
    SELECT d FROM y ORDER BY id, (SELECT count(*) FROM z WHERE q = max(y.d));
    SELECT max(d) FROM y ORDER BY (SELECT count(*) FROM z WHERE q = max(y.d));
}
expect {
    5
    6
    6
}

# An aggregate of the outer query inside a removed term does not make the
# query, or the query around it, an aggregate query.
@cross-check-integrity
test orderby_rowid_truncation_drops_aggregate_in_subquery {
    CREATE TABLE z(q, p);
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    INSERT INTO y VALUES (1, 5), (2, 6);
    INSERT INTO z VALUES (1, 1), (2, 2);
    SELECT d FROM y ORDER BY id, (SELECT max(d) FROM z);
    SELECT q, (SELECT d FROM y WHERE id = z.q ORDER BY id, (SELECT max(d) FROM z)) FROM z;
    SELECT d FROM y ORDER BY id, EXISTS (SELECT 1 FROM z WHERE z.q = y.d);
}
expect {
    5
    6
    1|5
    2|6
    5
    6
}

# Subqueries in ORDER BY can use the aliases of the result columns.
@cross-check-integrity
test orderby_removed_term_subquery_uses_result_column_alias {
    CREATE TABLE z(q, p);
    CREATE TABLE y(id INTEGER PRIMARY KEY, d);
    INSERT INTO y VALUES (1, 5), (2, 6);
    INSERT INTO z VALUES (1, 2);
    SELECT d AS xx FROM y ORDER BY id, (SELECT xx FROM z);
    SELECT d AS xx FROM y ORDER BY id, (SELECT q FROM z WHERE q = xx);
    SELECT sum(d) AS s FROM y ORDER BY (SELECT s);
    SELECT count(*) AS cc FROM y ORDER BY (SELECT cc FROM z);
}
expect {
    5
    6
    5
    6
    11
    2
}

# Unary-plus on integer literals should still resolve as column index
# references, matching SQLite behavior.
# Fixes select1-4.9.2 in sqlite/conformance/upstream/all.test.

test order-by-plus-2 {
    CREATE TABLE t8(a, b);
    INSERT INTO t8 VALUES(1,10);
    INSERT INTO t8 VALUES(2,9);
    SELECT * FROM t8 ORDER BY +2;
}
expect {
    2|9
    1|10
}

test order-by-plus-1 {
    CREATE TABLE t9(a, b);
    INSERT INTO t9 VALUES(2,10);
    INSERT INTO t9 VALUES(1,9);
    SELECT * FROM t9 ORDER BY +1;
}
expect {
    1|9
    2|10
}

test order-by-plus-2-desc {
    CREATE TABLE t10(a, b);
    INSERT INTO t10 VALUES(1,10);
    INSERT INTO t10 VALUES(2,9);
    SELECT * FROM t10 ORDER BY +2 DESC;
}
expect {
    1|10
    2|9
}

test group-by-plus-1 {
    CREATE TABLE t11(a text, b int);
    INSERT INTO t11 VALUES('x',1),('x',2),('y',3);
    SELECT a, sum(b) FROM t11 GROUP BY +1;
}
expect {
    x|3
    y|3
}

# Negative integer literals in ORDER BY should be rejected as invalid
# column index references, matching SQLite behavior.
# Fixes select1-4.10.2 in sqlite/conformance/upstream/all.test.

test order-by-negative-1 {
    CREATE TABLE t12(a, b);
    INSERT INTO t12 VALUES(1,10),(2,9);
    SELECT * FROM t12 ORDER BY -1;
}
expect error {
    1st ORDER BY term out of range - should be between 1 and 2
}

test order-by-negative-100 {
    CREATE TABLE t13(a, b);
    INSERT INTO t13 VALUES(1,10),(2,9);
    SELECT * FROM t13 ORDER BY -100;
}
expect error {
    1st ORDER BY term out of range - should be between 1 and 2
}

# Positive out-of-range and zero column indices should use SQLite-compatible
# error messages. Fixes select1-4.10.1 in sqlite/conformance/upstream/all.test.

test order-by-out-of-range {
    CREATE TABLE t14(a, b);
    INSERT INTO t14 VALUES(1,10),(2,9);
    SELECT * FROM t14 ORDER BY 3;
}
expect error {
    1st ORDER BY term out of range - should be between 1 and 2
}

test order-by-zero {
    CREATE TABLE t15(a, b);
    INSERT INTO t15 VALUES(1,10),(2,9);
    SELECT * FROM t15 ORDER BY 0;
}
expect error {
    1st ORDER BY term out of range - should be between 1 and 2
}

# Only integer literals that fit a 32-bit int are column positions
# (SQLite's sqlite3ExprIsInteger); larger ones are constant expressions.
test order-by-integer-beyond-i32-is-constant {
    CREATE TABLE t16(a);
    INSERT INTO t16 VALUES(1),(2);
    SELECT a FROM t16 ORDER BY 6641019685895816357, a DESC;
}
expect {
    2
    1
}

test order-by-i32-max-is-positional {
    CREATE TABLE t17(a);
    INSERT INTO t17 VALUES(1);
    SELECT a FROM t17 ORDER BY 2147483647;
}
expect error {
    1st ORDER BY term out of range - should be between 1 and 1
}

test order-by-negative-integer-beyond-i32-is-constant {
    CREATE TABLE t18(a);
    INSERT INTO t18 VALUES(1),(2);
    SELECT a FROM t18 ORDER BY -6641019685895816357, a DESC;
}
expect {
    2
    1
}

test group-by-integer-beyond-i32-is-constant {
    CREATE TABLE t19(a);
    INSERT INTO t19 VALUES(1);
    SELECT a FROM t19 GROUP BY 6641019685895816357;
}
expect {
    1
}

# A join ordered by the rowid of one table scans that table first and needs no sorter.
@skip-if sqlite "query plan explanation output is different in sqlite"
test orderby_rowid_join_scans_ordered_table_first {
    CREATE TABLE t1(id INTEGER PRIMARY KEY, a INT);
    CREATE TABLE t2(id INTEGER PRIMARY KEY, b INT);
    EXPLAIN QUERY PLAN SELECT * FROM t1 JOIN t2 ON t1.id = t2.id ORDER BY t1.id;
}
expect {
    1|0|0|SCAN t1
    2|0|0|SEARCH t2 USING INTEGER PRIMARY KEY (rowid=?)
}

# A rowid seek beats a full scan of another index that gives the order.
setup seek_or_ordered_scan {
    CREATE TABLE t(id INTEGER PRIMARY KEY, a INT, b INT);
    CREATE INDEX ta ON t(a);
    CREATE TABLE u(id INTEGER PRIMARY KEY, c INT);
}

@setup seek_or_ordered_scan
@skip-if sqlite "query plan explanation output is different in sqlite"
test orderby_other_index_keeps_rowid_eq_seek {
    EXPLAIN QUERY PLAN SELECT * FROM t WHERE id = 5 ORDER BY a;
}
expect {
    1|0|0|SEARCH t USING INTEGER PRIMARY KEY (rowid=?)
    10|0|0|USE SORTER FOR ORDER BY
}

@setup seek_or_ordered_scan
@skip-if sqlite "query plan explanation output is different in sqlite"
test orderby_other_index_keeps_rowid_in_seek {
    EXPLAIN QUERY PLAN SELECT * FROM t WHERE id IN (1, 2, 3) ORDER BY a;
}
expect {
    1|0|0|SEARCH t USING INTEGER PRIMARY KEY (rowid=?)
    26|0|0|USE SORTER FOR ORDER BY
}

@setup seek_or_ordered_scan
@skip-if sqlite "query plan explanation output is different in sqlite"
test groupby_other_index_keeps_rowid_eq_seek {
    EXPLAIN QUERY PLAN SELECT a, count(*) FROM t WHERE id = 5 GROUP BY a;
}
expect {
    1|0|0|SEARCH t USING INTEGER PRIMARY KEY (rowid=?)
    4|0|0|USE SORTER FOR GROUP BY
}

@setup seek_or_ordered_scan
@skip-if sqlite "query plan explanation output is different in sqlite"
test orderby_other_index_keeps_join_rowid_eq_seek {
    EXPLAIN QUERY PLAN SELECT * FROM u JOIN t ON t.id = u.id WHERE u.id = 5 ORDER BY t.a;
}
expect {
    1|0|0|SEARCH u USING INTEGER PRIMARY KEY (rowid=?)
    2|0|0|SEARCH t USING INTEGER PRIMARY KEY (rowid=?)
    16|0|0|USE SORTER FOR ORDER BY
}
