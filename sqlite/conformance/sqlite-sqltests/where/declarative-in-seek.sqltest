@database :memory:

test declarative-in-seeks-preserve-sql-semantics {
    CREATE TABLE in_rows(id INTEGER PRIMARY KEY, payload TEXT);
    INSERT INTO in_rows VALUES
        (1, 'one'), (2, 'two'), (3, 'three'), (4, 'four'), (5, 'five');

    SELECT id, payload FROM in_rows
        WHERE id IN (5, '1', 1, NULL, 3)
        ORDER BY id LIMIT 2 OFFSET 1;

    CREATE TABLE in_subquery_keys(id);
    INSERT INTO in_subquery_keys VALUES (5), (1), (1), (NULL), (3);
    SELECT id, payload FROM in_rows
        WHERE id IN (SELECT id FROM in_subquery_keys)
        ORDER BY id LIMIT 2 OFFSET 1;

    CREATE TABLE in_indexed(id INTEGER PRIMARY KEY, key NUMERIC, payload TEXT);
    CREATE INDEX in_indexed_key ON in_indexed(key);
    INSERT INTO in_indexed VALUES
        (1, 1, 'one-a'), (2, 1, 'one-b'), (3, 2, 'two'),
        (4, 3, 'three-a'), (5, 3, 'three-b'), (6, 4, 'four');

    SELECT id, payload FROM in_indexed
        WHERE key IN (3, '1', 3, NULL, 2)
        ORDER BY id;
    SELECT id FROM in_indexed
        WHERE key IN (abs(-3), 2)
        ORDER BY id;
}
expect {
    3|three
    5|five
    3|three
    5|five
    1|one-a
    2|one-b
    3|two
    4|three-a
    5|three-b
    3
    4
    5
}
