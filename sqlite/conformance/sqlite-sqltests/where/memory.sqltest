@database :memory:

@cross-check-integrity
test where-direct-column-truthiness {
    CREATE TABLE direct_truth(flag, keep, value);
    INSERT INTO direct_truth VALUES
        (0, 1, 'zero'),
        (1, 1, 'one'),
        (NULL, 1, 'null'),
        (2, 0, 'two-filtered'),
        (-1, 3, 'negative');
    SELECT value FROM direct_truth WHERE flag AND keep;
}
expect {
    one
    negative
}

@cross-check-integrity
test where-declarative-comparisons {
    CREATE TABLE declarative_cmp(id INTEGER, n NUMERIC, name TEXT COLLATE NOCASE);
    INSERT INTO declarative_cmp VALUES
        (1, 2, 'Alpha'),
        (2, 10, 'beta'),
        (3, 15, 'BETA'),
        (4, 20, 'gamma'),
        (5, NULL, 'BETA');
    SELECT id FROM declarative_cmp
    WHERE n = '10'
      AND n != 11
      AND n < 11
      AND n <= '10'
      AND n > 9
      AND n >= '10'
      AND name = 'BETA';
}
expect {
    2
}

@cross-check-integrity
test where-declarative-rowid-point-expression {
    CREATE TABLE declarative_point(id INTEGER PRIMARY KEY, payload TEXT);
    INSERT INTO declarative_point VALUES (1, 'one'), (2, 'two'), (3, 'three');
    SELECT rowid, id, payload
      FROM declarative_point
     WHERE rowid = 1 + 1;
}
expect {
    2|2|two
}

@cross-check-integrity
test where-declarative-composite-index-equality {
    CREATE TABLE declarative_indexed(
        id INTEGER PRIMARY KEY,
        category TEXT,
        rank NUMERIC,
        payload TEXT
    );
    CREATE INDEX declarative_category_rank
        ON declarative_indexed(category, rank);
    INSERT INTO declarative_indexed VALUES
        (1, 'group', 1, 'one'),
        (2, 'group', 2, 'two'),
        (3, 'other', 2, 'other'),
        (4, 'group', NULL, 'null'),
        (5, 'group', 2, 'five');
    SELECT id, payload
      FROM declarative_indexed INDEXED BY declarative_category_rank
     WHERE category = 'group' AND rank = '2'
     ORDER BY id DESC;
}
expect {
    5|five
    2|two
}

@cross-check-integrity
test where-declarative-index-ranges {
    CREATE TABLE declarative_ranged(
        id INTEGER PRIMARY KEY,
        category TEXT,
        rank NUMERIC
    );
    CREATE INDEX declarative_ranged_category_rank
        ON declarative_ranged(category, rank);
    CREATE INDEX declarative_ranged_category_rank_desc
        ON declarative_ranged(category, rank DESC);
    CREATE INDEX declarative_ranged_rank ON declarative_ranged(rank);
    INSERT INTO declarative_ranged VALUES
        (1, 'group', NULL),
        (2, 'group', 1),
        (3, 'group', 2),
        (4, 'group', 2),
        (5, 'group', 3),
        (6, 'group', 4),
        (7, 'other', 2);
    SELECT 'two-sided', id
      FROM declarative_ranged INDEXED BY declarative_ranged_category_rank
     WHERE category = 'group' AND rank > '1' AND rank <= '3'
     ORDER BY id;
    SELECT 'prefix-upper', id
      FROM declarative_ranged INDEXED BY declarative_ranged_category_rank_desc
     WHERE category = 'group' AND rank <= 2
     ORDER BY id;
    SELECT 'single-upper', id
      FROM declarative_ranged INDEXED BY declarative_ranged_rank
     WHERE rank < 3
     ORDER BY id;
    SELECT 'reverse', id
      FROM declarative_ranged INDEXED BY declarative_ranged_category_rank
     WHERE category = 'group' AND rank >= 2 AND rank < 4
     ORDER BY rank DESC, id DESC;
}
expect {
    two-sided|3
    two-sided|4
    two-sided|5
    prefix-upper|2
    prefix-upper|3
    prefix-upper|4
    single-upper|2
    single-upper|3
    single-upper|4
    single-upper|7
    reverse|5
    reverse|4
    reverse|3
}

# in WHERE clauses, column aliases do not take precedence when resolving identifiers to columns.
@cross-check-integrity
test where_alias_precedence {
    CREATE TABLE t(x,y);
    INSERT INTO t VALUES (1,200),(2,100);
    SELECT x AS y, y AS x FROM t WHERE x = 100;
}
expect {
}

# More aliasing tests
@cross-check-integrity
test where_alias_precedence_2 {
    CREATE TABLE t(x,y);
    INSERT INTO t SELECT value, value+100 FROM generate_series(1,3);
    SELECT x AS lol, y AS x FROM t WHERE x = 101;
}
expect {
}

@cross-check-integrity
test where_alias_precedence_3 {
    CREATE TABLE t(x,y);
    INSERT INTO t SELECT value, value+100 FROM generate_series(1,3);
    SELECT x AS lol, y AS lmao FROM t WHERE lmao = 101;
}
expect {
    1|101
}
