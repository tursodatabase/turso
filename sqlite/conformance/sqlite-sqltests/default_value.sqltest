@database :memory:

#!/usr/bin/env tclsh
@cross-check-integrity
test default-value-text {
    CREATE TABLE t1 (x INTEGER PRIMARY KEY, y TEXT DEFAULT 'default_value');
    INSERT INTO t1 (x) VALUES (1);
    SELECT y FROM t1 WHERE x = 1;
}
expect {
    default_value
}

@cross-check-integrity
test default-value-integer {
    CREATE TABLE t2 (x INTEGER PRIMARY KEY, y INTEGER DEFAULT 42);
    INSERT INTO t2 (x) VALUES (1);
    SELECT y FROM t2 WHERE x = 1;
}
expect {
    42
}

@cross-check-integrity
test default-value-real {
    CREATE TABLE t3 (x INTEGER PRIMARY KEY, y REAL DEFAULT 3.14);
    INSERT INTO t3 (x) VALUES (1);
    SELECT y FROM t3 WHERE x = 1;
}
expect {
    3.14
}

test default-value-blob-preserves-prefix-case {
    CREATE TABLE t_blob (a INTEGER);
    ALTER TABLE t_blob ADD COLUMN lower_blob BLOB NOT NULL DEFAULT x'00';
    ALTER TABLE t_blob ADD COLUMN upper_blob BLOB NOT NULL DEFAULT X'AB';
    SELECT name, dflt_value FROM pragma_table_info('t_blob') WHERE name LIKE '%_blob' ORDER BY cid;
}
expect {
    lower_blob|x'00'
    upper_blob|X'AB'
}

@cross-check-integrity
test default-value-null {
    CREATE TABLE t5 (x INTEGER PRIMARY KEY, y TEXT DEFAULT NULL);
    INSERT INTO t5 (x) VALUES (1);
    SELECT y FROM t5 WHERE x = 1;
}
expect {
}

@cross-check-integrity
test default-value-boolean {
    CREATE TABLE t6 (x INTEGER PRIMARY KEY, y BOOLEAN DEFAULT 1);
    INSERT INTO t6 (x) VALUES (1);
    SELECT y FROM t6 WHERE x = 1;
}
expect {
    1
}

@cross-check-integrity
test default-value-function {
    CREATE TABLE t7 (x INTEGER PRIMARY KEY, y INTEGER DEFAULT (ABS(-5)));
    INSERT INTO t7 (x) VALUES (1);
    SELECT y FROM t7 WHERE x = 1;
}
expect {
    5
}

@cross-check-integrity
test default-value-identifier {
    CREATE TABLE t7 (x INTEGER PRIMARY KEY, y DEFAULT asdf);
    INSERT INTO t7 (x) VALUES (1);
    SELECT y FROM t7 WHERE x = 1;
}
expect {
    asdf
}
 
test default-value-ident-to-str {
    CREATE TABLE t7 (x INTEGER NOT NULL, y DEFAULT "x");
    INSERT INTO t7 (x) VALUES (1);
    SELECT y FROM t7 WHERE x = 1;
}
expect {
    x
}

test default-value-column-name {
    CREATE TABLE t7 (x, y DEFAULT ("x"));
}
expect error {
    default value of column \[y\] is not constant
}

test scalar-function-filter-in-default-rejected {
    CREATE TABLE t1(a DEFAULT (abs(-1) FILTER (WHERE 1)));
}
expect error {
    default value of column.*is not constant
}

test scalar-function-filter-in-default-case-rejected {
    CREATE TABLE t1(a DEFAULT (CASE WHEN 0 THEN abs(-1) FILTER (WHERE 1) ELSE 2 END));
}
expect error {
    default value of column.*is not constant
}

test scalar-function-over-in-default-rejected {
    CREATE TABLE t1(a DEFAULT (abs(-1) OVER ()));
}
expect error {
    default value of column.*is not constant
}

test scalar-function-over-star-in-default-rejected {
    CREATE TABLE t1(a DEFAULT (random(*) OVER ()));
}
expect error {
    default value of column.*is not constant
}

test scalar-function-in-default-control {
    CREATE TABLE t1(a DEFAULT (abs(-1)));
    INSERT INTO t1 DEFAULT VALUES;
    SELECT a FROM t1;
}
expect {
    1
}

@skip-if sqlite "DEFAULT in a SET clause is a Turso extension"
test update-set-default-writes-the-column-default {
    CREATE TABLE ud1 (a INTEGER DEFAULT 7, b INTEGER);
    INSERT INTO ud1 VALUES (1, 2);
    UPDATE ud1 SET a = DEFAULT;
    SELECT a, b FROM ud1;
}
expect {
    7|2
}

@skip-if sqlite "DEFAULT in a SET clause is a Turso extension"
test update-set-default-without-a-column-default-writes-null {
    CREATE TABLE ud4 (a INTEGER, b INTEGER);
    INSERT INTO ud4 VALUES (1, 2);
    UPDATE ud4 SET a = DEFAULT;
    SELECT a IS NULL, b FROM ud4;
}
expect {
    1|2
}

@skip-if sqlite "DEFAULT in a SET clause is a Turso extension"
test update-set-row-value-default-writes-the-column-default {
    CREATE TABLE ud2 (a INTEGER DEFAULT 7, b INTEGER);
    INSERT INTO ud2 VALUES (1, 2);
    UPDATE ud2 SET (a, b) = (DEFAULT, 3);
    SELECT a, b FROM ud2;
}
expect {
    7|3
}

@skip-if sqlite "DEFAULT in a SET clause is a Turso extension"
test upsert-set-default-writes-the-column-default {
    CREATE TABLE ud3 (a INTEGER DEFAULT 7, b INTEGER UNIQUE);
    INSERT INTO ud3 VALUES (1, 2);
    INSERT INTO ud3 VALUES (3, 2) ON CONFLICT (b) DO UPDATE SET a = DEFAULT;
    SELECT a, b FROM ud3;
}
expect {
    7|2
}

@skip-if sqlite "DEFAULT in a SET clause is a Turso extension"
test upsert-set-default-inside-a-row-value {
    CREATE TABLE ud4 (a INTEGER DEFAULT 7, b INTEGER UNIQUE, c INTEGER);
    INSERT INTO ud4 VALUES (1, 2, 3);
    INSERT INTO ud4 VALUES (4, 2, 5) ON CONFLICT (b) DO UPDATE SET (a, c) = (DEFAULT, 9);
    SELECT a, b, c FROM ud4;
}
expect {
    7|2|9
}

test update-set-expression-containing-default-is-rejected {
    CREATE TABLE ud5 (a INTEGER DEFAULT 7);
    INSERT INTO ud5 VALUES (1);
    UPDATE ud5 SET a = DEFAULT + 1;
}
expect error {}
