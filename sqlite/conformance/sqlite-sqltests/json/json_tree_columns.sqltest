@database :memory:

# json_tree and json_each expose rowid like any virtual table, so a query
# can select or join on rt.rowid. As in SQLite, rowid counts the rows of a
# scan from 0, separately from the id column.

test json-tree-rowid-is-selectable {
    SELECT count(*) FROM (SELECT rt.rowid AS n FROM json_tree('{"a":[1,2]}') AS rt WHERE rt.type NOT IN ('object','array'));
}
expect {
    2
}

test json-tree-rowid-unqualified {
    SELECT typeof(rowid) FROM json_tree('[5]') WHERE type='integer';
}
expect {
    integer
}

test json-tree-rowid-into-table {
    CREATE TABLE kv(n, key, val);
    INSERT INTO kv SELECT rt.rowid, rt.fullkey, rt.atom FROM json_tree('{"a":[1,2]}') AS rt WHERE rt.type NOT IN ('object','array');
    SELECT key, val FROM kv ORDER BY key;
}
expect {
    $.a[0]|1
    $.a[1]|2
}

test json-each-rowid-counts-rows-from-zero {
    SELECT typeof(rowid), rowid, value FROM json_each('[5,[6],7]');
}
expect {
    integer|0|5
    integer|1|[6]
    integer|2|7
}

test json-each-rowid-of-primitive-root {
    SELECT rowid, value FROM json_each('5');
}
expect {
    0|5
}

test json-tree-rowid-counts-rows-from-zero {
    SELECT typeof(rowid), rowid, fullkey FROM json_tree('[5,[6,{"a":1}],7]');
}
expect {
    integer|0|$
    integer|1|$[0]
    integer|2|$[1]
    integer|3|$[1][0]
    integer|4|$[1][1]
    integer|5|$[1][1].a
    integer|6|$[2]
}

test json-tree-rowid-of-primitive-root {
    SELECT rowid, value FROM json_tree('5');
}
expect {
    0|5
}

test json-each-rowid-restarts-for-each-outer-row {
    SELECT a.value, b.rowid FROM json_each('[1,2]') AS a, json_each('[3,4]') AS b;
}
expect {
    1|0
    1|1
    2|0
    2|1
}

test json-each-rowid-is-null-on-unmatched-left-join-row {
    SELECT x, typeof(j.rowid) FROM (SELECT 1 AS x) LEFT JOIN json_each('[]') AS j;
}
expect {
    1|null
}

# fullkey quotes an object key unless it starts with an ASCII letter and
# continues with ASCII letters and digits only, as SQLite does; the empty
# key is quoted too.

test json-tree-fullkey-quotes-keys-like-sqlite {
    SELECT fullkey FROM json_tree('{"a":{"":1,"$g":2,"_h":3,"a b":4,"x1":5,"é":6}}') WHERE atom IS NOT NULL;
}
expect {
    $.a.""
    $.a."$g"
    $.a."_h"
    $.a."a b"
    $.a.x1
    $.a."é"
}

test json-tree-fullkey-roundtrips-through-extract {
    SELECT count(*) FROM json_tree('{"":{"a b":[1,{"$":2}]},"_":3}') AS rt WHERE rt.type NOT IN ('object','array') AND rt.atom IS NOT (json('{"":{"a b":[1,{"$":2}]},"_":3}') ->> rt.fullkey);
}
expect {
    0
}

# atom is the decoded string, as ->> returns it, not the JSON text with
# its escapes.

test json-tree-atom-is-decoded-text {
    SELECT atom, length(atom) FROM json_tree('["a\"b","é","x\ty","\\\\"]') WHERE type='text';
}
expect {
    a"b|3
    é|1
    x	y|3
    \|1
}

test json-tree-atom-matches-extract {
    SELECT count(*) FROM json_tree('{"a":"oat\r\n","b":["\fpan\b","gem\"hay","y㑘z"]}') AS rt WHERE rt.type='text' AND rt.atom IS NOT (json('{"a":"oat\r\n","b":["\fpan\b","gem\"hay","y㑘z"]}') ->> rt.fullkey);
}
expect {
    0
}

# json_each and json_tree columns have no declared type, so they have no
# affinity: comparing a text path with a number does not convert the number,
# and CREATE TABLE AS SELECT copies no column types.

test json-each-columns-have-no-affinity {
    SELECT count(*) FROM json_each('{"a":1}') WHERE fullkey < 0;
    SELECT fullkey < 0, path < 0 FROM json_each('{"a":1}');
}
expect {
    0
    0|0
}

test json-tree-columns-have-no-affinity {
    SELECT count(*) FROM json_tree('{"a":1}') WHERE fullkey < 0;
    SELECT fullkey < 0, path < 0, type < 0 FROM json_tree('{"a":1}') WHERE fullkey = '$.a';
}
expect {
    0
    0|0|0
}

test json-each-ctas-copies-no-column-types {
    CREATE TABLE t AS SELECT key, value, type, atom, id, parent, fullkey, path FROM json_each('{"a":1}');
    SELECT name, type FROM pragma_table_info('t');
}
expect {
    key|
    value|
    type|
    atom|
    id|
    parent|
    fullkey|
    path|
}

test json-tree-ctas-copies-no-column-types {
    CREATE TABLE t AS SELECT key, value, type, atom, id, parent, fullkey, path FROM json_tree('{"a":1}');
    SELECT name, type FROM pragma_table_info('t');
}
expect {
    key|
    value|
    type|
    atom|
    id|
    parent|
    fullkey|
    path|
}

test json-each-columns-have-no-declared-type {
    SELECT name, type, hidden FROM pragma_table_xinfo('json_each');
}
expect {
    key||0
    value||0
    type||0
    atom||0
    id||0
    parent||0
    fullkey||0
    path||0
    json||1
    root||1
}

test json-tree-columns-have-no-declared-type {
    SELECT name, type, hidden FROM pragma_table_xinfo('json_tree');
}
expect {
    key||0
    value||0
    type||0
    atom||0
    id||0
    parent||0
    fullkey||0
    path||0
    json||1
    root||1
}
