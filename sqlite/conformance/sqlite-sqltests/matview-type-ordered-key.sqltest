@database :memory:
@skip-file-if mvcc "materialized views not supported in MVCC mode"
@skip-file-if sqlite "materialized views and custom types are turso-specific features"
@requires-file materialized_views "requires materialized view support"
@requires-file custom_types "requires numeric and array columns"

# A view keeps its keys in hidden tables. Keys of numeric and array types have to
# sort in the type's order, so 1.5 and 1.50 are one key and 9 sorts below 10.

test distinct-numeric-treats-equal-values-with-different-scale-as-one {
    CREATE TABLE t(n numeric(10,2)) STRICT;
    INSERT INTO t VALUES (1.5), (1.50), (2), (NULL);
    CREATE MATERIALIZED VIEW v AS SELECT DISTINCT n FROM t;
    SELECT count(*), count(n) FROM v;
    INSERT INTO t VALUES (1.500), (3);
    SELECT count(*), count(n) FROM v;
    DELETE FROM t WHERE n = 1.5;
    SELECT count(*), count(n) FROM v;
    PRAGMA integrity_check;
} expect {
    3|2
    4|3
    3|2
    ok
}

test distinct-cast-to-numeric {
    CREATE TABLE t(x);
    INSERT INTO t VALUES (1.5), ('1.50'), (3);
    CREATE MATERIALIZED VIEW v AS SELECT DISTINCT CAST(x AS numeric(10,2)) AS n FROM t;
    SELECT count(*) FROM v;
    INSERT INTO t VALUES (3.0);
    SELECT count(*) FROM v;
    PRAGMA integrity_check;
} expect {
    2
    2
    ok
}

test group-by-numeric-adds-up-rows-of-equal-values {
    CREATE TABLE t(n numeric(10,2), x int) STRICT;
    INSERT INTO t VALUES (1.5, 1), (1.50, 2), (10, 4);
    CREATE MATERIALIZED VIEW v AS SELECT n, sum(x) AS s, count(*) AS c FROM t GROUP BY n;
    SELECT s, c FROM v ORDER BY s;
    DELETE FROM t WHERE x = 2;
    SELECT s, c FROM v ORDER BY s;
    PRAGMA integrity_check;
} expect {
    3|2
    4|1
    1|1
    4|1
    ok
}

test min-and-max-of-numeric-use-the-order-of-values {
    CREATE TABLE t(n numeric(10,2)) STRICT;
    INSERT INTO t VALUES (9), (10), (100);
    CREATE MATERIALIZED VIEW v AS SELECT min(n) AS lo, max(n) AS hi FROM t;
    SELECT (SELECT n = 9 FROM t WHERE n = lo), (SELECT n = 100 FROM t WHERE n = hi) FROM v;
    DELETE FROM t WHERE n = 100;
    SELECT (SELECT n = 9 FROM t WHERE n = lo), (SELECT n = 10 FROM t WHERE n = hi) FROM v;
    PRAGMA integrity_check;
} expect {
    1|1
    1|1
    ok
}

test numeric-union-intersect-except {
    CREATE TABLE t(n numeric(10,2)) STRICT;
    CREATE TABLE u(n numeric(10,2)) STRICT;
    INSERT INTO t VALUES (1.5), (2);
    INSERT INTO u VALUES (1.50), (3);
    CREATE MATERIALIZED VIEW un AS SELECT n FROM t UNION SELECT n FROM u;
    CREATE MATERIALIZED VIEW inter AS SELECT n FROM t INTERSECT SELECT n FROM u;
    CREATE MATERIALIZED VIEW ex AS SELECT n FROM t EXCEPT SELECT n FROM u;
    SELECT (SELECT count(*) FROM un), (SELECT count(*) FROM inter), (SELECT count(*) FROM ex);
    INSERT INTO u VALUES (2.00);
    SELECT (SELECT count(*) FROM un), (SELECT count(*) FROM inter), (SELECT count(*) FROM ex);
    PRAGMA integrity_check;
} expect {
    3|1|1
    3|2|0
    ok
}

test numeric-key-next-to-a-nocase-key {
    CREATE TABLE t(n numeric(10,2), s TEXT COLLATE NOCASE) STRICT;
    INSERT INTO t VALUES (1.5, 'a'), (1.50, 'A'), (2, 'b');
    CREATE MATERIALIZED VIEW v AS SELECT n, s, count(*) AS c FROM t GROUP BY n, s;
    SELECT c FROM v ORDER BY c;
    PRAGMA integrity_check;
} expect {
    1
    2
    ok
}

test distinct-integer-array {
    CREATE TABLE t(a int[]) STRICT;
    INSERT INTO t VALUES (ARRAY[1, 2]), (ARRAY[1, 2]), (ARRAY[10]), (NULL);
    CREATE MATERIALIZED VIEW v AS SELECT DISTINCT a FROM t;
    SELECT count(*), count(a) FROM v;
    DELETE FROM t WHERE a = ARRAY[10];
    INSERT INTO t VALUES (ARRAY[3]), (ARRAY[3]);
    SELECT count(*), count(a) FROM v;
    PRAGMA integrity_check;
} expect {
    3|2
    3|2
    ok
}

test max-of-integer-array-compares-elements-as-numbers {
    CREATE TABLE t(a int[]) STRICT;
    INSERT INTO t VALUES (ARRAY[1]), (ARRAY[9]), (ARRAY[10]);
    CREATE MATERIALIZED VIEW v AS SELECT max(a) AS hi FROM t;
    SELECT hi = ARRAY[10] FROM v;
    DELETE FROM t WHERE a = ARRAY[10];
    SELECT hi = ARRAY[9] FROM v;
    PRAGMA integrity_check;
} expect {
    1
    1
    ok
}

test group-by-text-array {
    CREATE TABLE t(a text[]) STRICT;
    INSERT INTO t VALUES (ARRAY['a', 'b']), (ARRAY['a', 'b']), (ARRAY['c']);
    CREATE MATERIALIZED VIEW v AS SELECT a, count(*) AS c FROM t GROUP BY a;
    SELECT c FROM v ORDER BY c;
    PRAGMA integrity_check;
} expect {
    1
    2
    ok
}

# The name that gives a key column its order means nothing in a user's table.
test key-order-type-name-is-an-ordinary-type-in-a-user-table {
    CREATE TABLE t(a __turso_key_order_numeric);
    INSERT INTO t VALUES ('x'), (1);
    SELECT a FROM t ORDER BY a;
} expect {
    1
    x
}
