@requires strict "uses STRICT tables"
test datetime-time-input-accepts-iso-date-before-time {
    CREATE TABLE t(id INTEGER PRIMARY KEY, tm time) STRICT;
    INSERT INTO t VALUES (1, '2024-01-05 10:00');
    INSERT INTO t VALUES (2, '2024-1-5 10:00');
    INSERT INTO t VALUES (3, '2024-01-05 10:00:00+02');
    INSERT INTO t VALUES (4, '10:00');
    SELECT * FROM t ORDER BY id;
}
expect {
    1|10:00:00
    2|10:00:00
    3|10:00:00
    4|10:00:00
}

