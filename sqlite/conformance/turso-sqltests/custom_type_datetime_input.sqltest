}

# The input is read without the clock, so the ENCODE can be part of an index
# or a generated column.

@requires strict "uses STRICT tables"
test datetime-encode-in-index-expression-and-generated-column {
    CREATE TABLE t(id INTEGER PRIMARY KEY, s text, d text GENERATED ALWAYS AS (temporal_encode(s, 'date'))) STRICT;
    CREATE INDEX ti ON t(CAST(s AS timestamp));
    INSERT INTO t(id, s) VALUES (1, '2024-1-5 10:00'), (2, 'Jan 4 2024');
    SELECT id, d, CAST(s AS timestamp) FROM t ORDER BY CAST(s AS timestamp);
}
expect {
    2|2024-01-04|2024-01-04 00:00:00
    1|2024-01-05|2024-01-05 10:00:00
}

# The stored text sorts in time order, so a range on the column can use an
# index.

@requires strict "uses STRICT tables"
test datetime-range-uses-index-timestamp {
    CREATE TABLE t(id INTEGER PRIMARY KEY, ts timestamp) STRICT;
    CREATE INDEX ti ON t(ts);
    EXPLAIN QUERY PLAN SELECT id FROM t WHERE ts > '2024-01-05 09:30';
}
expect {
    1|0|0|SEARCH t USING COVERING INDEX ti (ts>?)
}

@requires strict "uses STRICT tables"
test datetime-range-uses-index-date-between {
    CREATE TABLE t(id INTEGER PRIMARY KEY, d date) STRICT;
    CREATE INDEX ti ON t(d);
    EXPLAIN QUERY PLAN SELECT id FROM t WHERE d BETWEEN '2024-01-01' AND '2024-02-01';
}
expect {
    1|0|0|SEARCH t USING COVERING INDEX ti (d>=? AND d<=?)
}

@requires strict "uses STRICT tables"
test datetime-range-uses-index-time {
    CREATE TABLE t(id INTEGER PRIMARY KEY, tm time) STRICT;
    CREATE INDEX ti ON t(tm);
    EXPLAIN QUERY PLAN SELECT id FROM t WHERE tm < '09:45:00';
}
expect {
    1|0|0|SEARCH t USING COVERING INDEX ti (tm<?)
}

@requires strict "uses STRICT tables"
test datetime-range-uses-index-timestamptz {
    CREATE TABLE t(id INTEGER PRIMARY KEY, tz timestamptz) STRICT;
    CREATE INDEX ti ON t(tz);
    EXPLAIN QUERY PLAN SELECT id FROM t WHERE tz >= '2024-01-05 08:00:00+00';
}
expect {
    1|0|0|SEARCH t USING COVERING INDEX ti (tz>=?)
}

@requires strict "uses STRICT tables"
test datetime-range-through-index-matches-scan {
    CREATE TABLE t(id INTEGER PRIMARY KEY, ts timestamp) STRICT;
    INSERT INTO t VALUES (1, '2024-1-5 10:00'), (2, '2024-01-05 09:30:00.5'), (3, '0999-12-31 23:59:59'), (4, '2024-12-01 00:00:00'), (5, NULL);
    CREATE INDEX ti ON t(ts);
    SELECT id FROM t WHERE ts > '2024-01-05 09:30:00' ORDER BY ts;
    SELECT id FROM t WHERE ts BETWEEN '0999-12-31 23:59:59' AND '2024-01-05 10:00:00' ORDER BY id;
}
expect {
    2
    1
    4
    1
    2
    3
}

# timestamptz is stored as the UTC instant with no offset, so it equals the
# same timestamp and SQLite's date functions can read it.
@requires strict "uses STRICT tables"
test datetime-timestamp-equals-timestamptz {
    CREATE TABLE t(id INTEGER, ts timestamp, tz timestamptz) STRICT;
    INSERT INTO t VALUES (1, '2024-01-05 10:00:00', '2024-01-05 10:00:00');
    INSERT INTO t VALUES (2, '2024-01-05 10:00:00', '2024-01-05 10:00:00+02');
    SELECT id FROM t WHERE ts = tz;
}
expect {
    1
}

@requires strict "uses STRICT tables"
test datetime-timestamptz-in-sqlite-date-functions {
    CREATE TABLE t(tz timestamptz) STRICT;
    INSERT INTO t VALUES ('2024-01-05 10:00:00'), ('2024-01-05 12:00:00+02');
    SELECT datetime(tz), date(tz), unixepoch(tz) FROM t;
}
expect {
    2024-01-05 10:00:00|2024-01-05|1704448800
    2024-01-05 10:00:00|2024-01-05|1704448800
}

# The order of the fields matters, as in PostgreSQL: `T` needs a date before
# it and a time after it, a date cannot follow a time, and the order of a
# date's numbers and month name is limited.
@requires strict "uses STRICT tables"
test datetime-input-field-order-accepted {
    CREATE TABLE t(id INTEGER PRIMARY KEY, ts timestamp) STRICT;
    INSERT INTO t VALUES (1, '2024-01-05T10:00');
    INSERT INTO t VALUES (2, '2024-01-05 T10:00');
    INSERT INTO t VALUES (3, '2024-01-05 T 10:00');
    INSERT INTO t VALUES (4, '2024-01-05 10:00 PM');
    INSERT INTO t VALUES (5, '5 Jan 2024');
    INSERT INTO t VALUES (6, '2024 Jan 5');
    INSERT INTO t VALUES (7, 'Jan 2024 5');
    INSERT INTO t VALUES (8, '2024 5 Jan');
    INSERT INTO t VALUES (9, '10:00 Jan 5 2024');
    INSERT INTO t VALUES (10, '2024-01-05 PM');
    INSERT INTO t VALUES (11, '2024-01-05 T PM 10:00');
    SELECT * FROM t ORDER BY id;
}
expect {
    1|2024-01-05 10:00:00
    2|2024-01-05 10:00:00
    3|2024-01-05 10:00:00
    4|2024-01-05 22:00:00
    5|2024-01-05 00:00:00
    6|2024-01-05 00:00:00
    7|2024-01-05 00:00:00
    8|2024-01-05 00:00:00
    9|2024-01-05 10:00:00
    10|2024-01-05 12:00:00
    11|2024-01-05 22:00:00
}

@requires strict "uses STRICT tables"
test datetime-input-time-with-t {
    CREATE TABLE t(id INTEGER PRIMARY KEY, tm time) STRICT;
    INSERT INTO t VALUES (1, 'T 10:00'), (2, 'T10:00 PM'), (3, '2024-01-05 10:00');
    SELECT * FROM t ORDER BY id;
}
expect {
    1|10:00:00
    2|22:00:00
    3|10:00:00
}

