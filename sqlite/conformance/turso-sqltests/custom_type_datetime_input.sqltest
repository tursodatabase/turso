# PostgreSQL accepts the values below, but their stored text would not sort in
# time order, so Turso rejects them.

@requires strict "uses STRICT tables"
test datetime-input-rejects-bc {
    CREATE TABLE t(d date) STRICT;
    INSERT INTO t VALUES ('0044-03-15 BC');
}
expect error {
    BC dates are not supported for type date
}

@requires strict "uses STRICT tables"
test datetime-input-rejects-year-past-9999 {
    CREATE TABLE t(ts timestamp) STRICT;
    INSERT INTO t VALUES ('10000-01-01 00:00:00');
}
expect error {
    years must be written with 4 digits
}

@requires strict "uses STRICT tables"
test datetime-input-rejects-3-digit-year {
    CREATE TABLE t(d date) STRICT;
    INSERT INTO t VALUES ('999-01-01');
}
expect error {
    years must be written with 4 digits
}

@requires strict "uses STRICT tables"
test datetime-input-rejects-offset-past-9999 {
    CREATE TABLE t(tz timestamptz) STRICT;
    INSERT INTO t VALUES ('9999-12-31 23:00:00-02');
}
expect error {
    timestamp with time zone values must be between years 0001 and 9999
}

@requires strict "uses STRICT tables"
test datetime-input-rejects-infinity {
    CREATE TABLE t(ts timestamp) STRICT;
    INSERT INTO t VALUES ('infinity');
}
expect error {
    the timestamp value "infinity" is not supported
}

