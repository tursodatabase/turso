@database :memory:
@requires-file custom_types "array tests require custom types support"

test array-element-counts-from-the-lower-bound {
    CREATE TABLE t (id INTEGER PRIMARY KEY, a integer[]) STRICT;
    INSERT INTO t VALUES (1, '[0:2]={10,20,30}');
    SELECT array_element(a, -1), array_element(a, 0), array_element(a, 2), array_element(a, 3) FROM t;
}
expect {
    |10|30|
}

test array-set-element-counts-from-the-lower-bound {
    CREATE TABLE t (id INTEGER PRIMARY KEY, a integer[]) STRICT;
    INSERT INTO t VALUES (1, '[0:2]={10,20,30}');
    SELECT array_set_element(a, 0, 5), array_set_element(a, 2, 7), array_set_element(a, 3, 9), array_set_element(a, -1, 9) FROM t;
}
expect {
    [0:2]={5,20,30}|[0:2]={10,20,7}|[0:2]={10,20,30}|[0:2]={10,20,30}
}

test array-set-element-keeps-an-array-that-starts-at-one {
    CREATE TABLE t (id INTEGER PRIMARY KEY, a integer[]) STRICT;
    INSERT INTO t VALUES (1, '{10,20,30}');
    SELECT array_set_element(a, 1, 5), array_set_element(a, 0, 5) FROM t;
}
expect {
    {5,20,30}|{10,20,30}
}

test array-lower-and-upper-are-subscripts {
    CREATE TABLE t (id INTEGER PRIMARY KEY, a integer[]) STRICT;
    INSERT INTO t VALUES (1, '[0:2]={10,20,30}'), (2, '{10,20,30}'), (3, '[-3:-2]={1,2}'), (4, '{}');
    SELECT array_lower(a, 1), array_upper(a, 1) FROM t ORDER BY id;
}
expect {
    0|2
    1|3
    -3|-2
    |
}

test array-lower-and-upper-of-a-missing-dimension-are-null {
    SELECT array_lower(ARRAY[1,2,3], 2) IS NULL, array_upper(ARRAY[1,2,3], 0) IS NULL, array_lower(NULL, 1) IS NULL;
}
expect {
    1|1|1
}

test array-lower-and-upper-read-an-inner-dimension {
    SELECT array_lower(ARRAY[ARRAY[1,2,3], ARRAY[4,5,6]], 2), array_upper(ARRAY[ARRAY[1,2,3], ARRAY[4,5,6]], 2);
}
expect {
    1|3
}
