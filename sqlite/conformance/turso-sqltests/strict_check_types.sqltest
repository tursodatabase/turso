@database :memory:
@requires-file custom_types "uses custom types"

# Strict type checking for CHECK constraints in STRICT tables.
# In STRICT mode, comparisons in CHECK expressions must have compatible types.
# If the type of an expression cannot be determined, use CAST.

# ============================================================================
# Base type mismatches — must be rejected at CREATE TABLE time
# ============================================================================

@requires strict "uses STRICT tables"
test integer-vs-text-error {
    CREATE TABLE t(a INTEGER CHECK(a < 'hello')) STRICT;
}
expect error {
    type mismatch
}

@requires strict "uses STRICT tables"
test integer-vs-blob-error {
    CREATE TABLE t(a INTEGER CHECK(a < x'FF')) STRICT;
}
expect error {
    type mismatch
}

@requires strict "uses STRICT tables"
test text-vs-integer-error {
    CREATE TABLE t(a TEXT CHECK(a > 42)) STRICT;
}
expect error {
    type mismatch
}

@requires strict "uses STRICT tables"
test text-vs-real-error {
    CREATE TABLE t(a TEXT CHECK(a < 3.14)) STRICT;
}
expect error {
    type mismatch
}

@requires strict "uses STRICT tables"
test blob-vs-text-error {
    CREATE TABLE t(a BLOB CHECK(a = 'text')) STRICT;
}
expect error {
    type mismatch
}

@requires strict "uses STRICT tables"
test blob-vs-integer-error {
    CREATE TABLE t(a BLOB CHECK(a < 5)) STRICT;
}
expect error {
    type mismatch
}

@requires strict "uses STRICT tables"
test real-vs-text-error {
    CREATE TABLE t(a REAL CHECK(a < 'hello')) STRICT;
}
expect error {
    type mismatch
}

@requires strict "uses STRICT tables"
test cross-column-type-mismatch {
    CREATE TABLE t(a INTEGER, b TEXT, CHECK(a = b)) STRICT;
}
expect error {
    type mismatch
}

# ============================================================================
# Valid base type comparisons — must succeed
# ============================================================================

@requires strict "uses STRICT tables"
test integer-vs-integer-valid {
    CREATE TABLE t(a INTEGER CHECK(a >= 18)) STRICT;
    INSERT INTO t VALUES(25);
    SELECT a FROM t;
}
expect {
    25
}

@requires strict "uses STRICT tables"
test integer-vs-real-valid {
    CREATE TABLE t(a INTEGER CHECK(a < 3.14)) STRICT;
    INSERT INTO t VALUES(2);
    SELECT a FROM t;
}
expect {
    2
}

@requires strict "uses STRICT tables"
test real-vs-integer-valid {
    CREATE TABLE t(a REAL CHECK(a > 0)) STRICT;
    INSERT INTO t VALUES(1.5);
    SELECT a FROM t;
}
expect {
    1.5
}

@requires strict "uses STRICT tables"
test text-vs-text-valid {
    CREATE TABLE t(a TEXT CHECK(a != 'bad')) STRICT;
    INSERT INTO t VALUES('good');
    SELECT a FROM t;
}
expect {
    good
}

@requires strict "uses STRICT tables"
test compound-and-valid {
    CREATE TABLE t(a INTEGER CHECK(a > 0 AND a < 100)) STRICT;
    INSERT INTO t VALUES(50);
    SELECT a FROM t;
}
expect {
    50
}

@requires strict "uses STRICT tables"
test compound-or-valid {
    CREATE TABLE t(a INTEGER CHECK(a < 10 OR a > 90)) STRICT;
    INSERT INTO t VALUES(5);
    INSERT INTO t VALUES(95);
    SELECT a FROM t ORDER BY a;
}
expect {
    5
    95
}

@requires strict "uses STRICT tables"
test between-valid {
    CREATE TABLE t(a INTEGER CHECK(a BETWEEN 1 AND 100)) STRICT;
    INSERT INTO t VALUES(50);
    SELECT a FROM t;
}
expect {
    50
}

@requires strict "uses STRICT tables"
test in-list-valid {
    CREATE TABLE t(a INTEGER CHECK(a IN (1, 2, 3))) STRICT;
    INSERT INTO t VALUES(2);
    SELECT a FROM t;
}
expect {
    2
}

@requires strict "uses STRICT tables"
test is-not-null-valid {
    CREATE TABLE t(a INTEGER CHECK(a IS NOT NULL)) STRICT;
    INSERT INTO t VALUES(42);
    SELECT a FROM t;
}
expect {
    42
}

@requires strict "uses STRICT tables"
test null-comparison-valid {
    CREATE TABLE t(a INTEGER CHECK(a != NULL)) STRICT;
    INSERT INTO t VALUES(42);
    SELECT a FROM t;
}
expect {
    42
}

@requires strict "uses STRICT tables"
test arithmetic-valid {
    CREATE TABLE t(a INTEGER, b INTEGER, CHECK(a + b < 100)) STRICT;
    INSERT INTO t VALUES(30, 40);
    SELECT a, b FROM t;
}
expect {
    30|40
}

@requires strict "uses STRICT tables"
test mixed-numeric-arithmetic {
    CREATE TABLE t(a INTEGER CHECK(a * 2.0 < 10.0)) STRICT;
    INSERT INTO t VALUES(3);
    SELECT a FROM t;
}
expect {
    3
}

@requires strict "uses STRICT tables"
test rowid-in-check-valid {
    CREATE TABLE t(a INTEGER CHECK(rowid > 0)) STRICT;
    INSERT INTO t VALUES(42);
    SELECT a FROM t;
}
expect {
    42
}

@requires strict "uses STRICT tables"
test any-column-compatible {
    CREATE TABLE t(a ANY CHECK(a = 42)) STRICT;
    INSERT INTO t VALUES(42);
    SELECT a FROM t;
}
expect {
    42
}

@requires strict "uses STRICT tables"
test boolean-literal-vs-integer-valid {
    CREATE TABLE t(a INTEGER CHECK(a = true)) STRICT;
    INSERT INTO t VALUES(1);
    SELECT a FROM t;
}
expect {
    1
}

# ============================================================================
# BETWEEN and IN with mismatched types — must error
# ============================================================================

@requires strict "uses STRICT tables"
test between-type-mismatch-start {
    CREATE TABLE t(a INTEGER CHECK(a BETWEEN 'low' AND 100)) STRICT;
}
expect error {
    type mismatch
}

@requires strict "uses STRICT tables"
test between-type-mismatch-end {
    CREATE TABLE t(a INTEGER CHECK(a BETWEEN 1 AND 'high')) STRICT;
}
expect error {
    type mismatch
}

@requires strict "uses STRICT tables"
test in-list-type-mismatch {
    CREATE TABLE t(a INTEGER CHECK(a IN (1, 'two', 3))) STRICT;
}
expect error {
    type mismatch
}

# ============================================================================
# Custom type mismatches — must error
# ============================================================================

@requires strict "uses STRICT tables"
test custom-type-vs-real-error {
    CREATE TYPE cents BASE integer ENCODE value * 100 DECODE value / 100;
    CREATE TABLE t(amount cents CHECK(amount < 0.5)) STRICT;
}
expect error {
    type mismatch
}

@requires strict "uses STRICT tables"
test custom-type-vs-text-error {
    CREATE TYPE cents BASE integer ENCODE value * 100 DECODE value / 100;
    CREATE TABLE t(amount cents CHECK(amount = 'hello')) STRICT;
}
expect error {
    type mismatch
}

@requires strict "uses STRICT tables"
test different-custom-types-error {
    CREATE TYPE cents BASE integer ENCODE value * 100 DECODE value / 100;
    CREATE TYPE score BASE integer ENCODE value * 10 DECODE value / 10;
    CREATE TABLE t(a cents, b score, CHECK(a < b)) STRICT;
}
expect error {
    type mismatch
}

# ============================================================================
# Custom type compared with a literal — CHECK sees the value a read gives
# ============================================================================

@requires strict "uses STRICT tables"
test custom-type-literal-valid-insert {
    CREATE TYPE cents BASE integer ENCODE value * 100 DECODE value / 100;
    CREATE TABLE t(id INTEGER PRIMARY KEY, amount cents CHECK(amount < 50)) STRICT;
    INSERT INTO t VALUES(1, 42);
    SELECT id, amount FROM t;
}
expect {
    1|42
}

@requires strict "uses STRICT tables"
test custom-type-literal-check-violation {
    CREATE TYPE cents BASE integer ENCODE value * 100 DECODE value / 100;
    CREATE TABLE t(amount cents CHECK(amount < 50)) STRICT;
    INSERT INTO t VALUES(60);
}
expect error {
    CHECK constraint failed
}

@requires strict "uses STRICT tables"
test custom-type-literal-greater-than-zero {
    CREATE TYPE cents BASE integer ENCODE value * 100 DECODE value / 100;
    CREATE TABLE t(amount cents CHECK(amount > 0)) STRICT;
    INSERT INTO t VALUES(10);
    SELECT amount FROM t;
}
expect {
    10
}

@requires strict "uses STRICT tables"
test custom-type-literal-greater-than-zero-violation {
    CREATE TYPE cents BASE integer ENCODE value * 100 DECODE value / 100;
    CREATE TABLE t(amount cents CHECK(amount > 0)) STRICT;
    INSERT INTO t VALUES(-5);
}
expect error {
    CHECK constraint failed
}

@requires strict "uses STRICT tables"
test custom-type-same-column-comparison {
    CREATE TYPE cents BASE integer ENCODE value * 100 DECODE value / 100;
    CREATE TABLE t(a cents, b cents, CHECK(a < b)) STRICT;
    INSERT INTO t VALUES(10, 20);
    SELECT a, b FROM t;
}
expect {
    10|20
}

@requires strict "uses STRICT tables"
test custom-type-between-literals {
    CREATE TYPE cents BASE integer ENCODE value * 100 DECODE value / 100;
    CREATE TABLE t(amount cents CHECK(amount BETWEEN 0 AND 100)) STRICT;
    INSERT INTO t VALUES(50);
    INSERT INTO t VALUES(130);
}
expect error {
    CHECK constraint failed
}

@requires strict "uses STRICT tables"
test custom-type-in-list-literals {
    CREATE TYPE cents BASE integer ENCODE value * 100 DECODE value / 100;
    CREATE TABLE t(amount cents CHECK(amount IN (10, 20, 30))) STRICT;
    INSERT INTO t VALUES(20);
    INSERT INTO t VALUES(25);
}
expect error {
    CHECK constraint failed
}

# A minus sign in front of a number keeps it a literal of the type's input
# type, so -5 compares with a custom-type column like 5 does.
@requires strict "uses STRICT tables"
test custom-type-negative-literals {
    CREATE TYPE cents BASE integer ENCODE value * 100 DECODE value / 100;
    CREATE TABLE t(
        amount cents CHECK(amount > -5),
        n numeric(10,2) CHECK(n BETWEEN -5.5 AND 5) CHECK(n IN (-1, -4.5))
    ) STRICT;
    INSERT INTO t VALUES(-4, -4.5);
    SELECT amount, n FROM t;
}
expect {
    -4|-4.50
}

@requires strict "uses STRICT tables"
test custom-type-negative-literal-check-violation {
    CREATE TYPE cents BASE integer ENCODE value * 100 DECODE value / 100;
    CREATE TABLE t(amount cents CHECK(amount > -5)) STRICT;
    INSERT INTO t VALUES(-6);
}
expect error {
    CHECK constraint failed
}

@requires strict "uses STRICT tables"
test custom-type-cast-in-check-compares-like-select {
    -- CAST(50 AS cents) gives 50, the value a read gives, and the CHECK
    -- compares it with the amount as a SELECT does.
    CREATE TYPE cents BASE integer ENCODE value * 100 DECODE value / 100;
    CREATE TABLE t(amount cents CHECK(amount < CAST(50 AS cents))) STRICT;
    INSERT INTO t VALUES(40);
    SELECT amount, amount < CAST(50 AS cents) FROM t;
}
expect {
    40|1
}

@requires strict "uses STRICT tables"
test custom-type-cast-in-check-compares-like-select-error {
    CREATE TYPE cents BASE integer ENCODE value * 100 DECODE value / 100;
    CREATE TABLE t(amount cents CHECK(amount < CAST(50 AS cents))) STRICT;
    INSERT INTO t VALUES(60);
}
expect error {
    CHECK constraint failed: amount < CAST\(50 AS cents\)
}

# A CAST gives the decoded value whether or not it is inside another CAST.
@requires strict "uses STRICT tables"
test cast-inside-cast-in-check-gives-decoded-value {
    CREATE TYPE cents BASE integer ENCODE value * 100 DECODE value / 100;
    CREATE TABLE t(i integer CHECK (CAST(CAST(i AS cents) AS integer) = 6 AND CAST(i AS cents) = 6)) STRICT;
    INSERT INTO t VALUES (6);
    SELECT i FROM t;
}
expect {
    6
}

@requires strict "uses STRICT tables"
test integrity-check-sees-custom-type-column-like-insert {
    -- INSERT and integrity_check both run the CHECK on the decoded 'ba'.
    CREATE TYPE rev BASE text ENCODE string_reverse(value) DECODE string_reverse(value);
    CREATE TABLE t(s rev CHECK (s LIKE 'b%')) STRICT;
    INSERT INTO t VALUES ('ba');
    PRAGMA integrity_check;
}
expect {
    ok
}

@requires strict "uses STRICT tables"
test integrity-check-sees-cast-in-check-like-insert {
    CREATE TYPE rev BASE text ENCODE string_reverse(value) DECODE string_reverse(value);
    CREATE TABLE t(s text CHECK (CAST(s AS rev) LIKE 'b%')) STRICT;
    INSERT INTO t VALUES ('ba');
    PRAGMA integrity_check;
}
expect {
    ok
}

# ============================================================================
# Custom types that store values unchanged — compared as their base type
# ============================================================================

@requires strict "uses STRICT tables"
test smallint-vs-integer-literal-valid {
    CREATE TABLE t(n smallint DEFAULT 0 CHECK(n >= 0 AND n <= 2)) STRICT;
    INSERT INTO t VALUES(1) RETURNING n;
}
expect {
    1
}

@requires strict "uses STRICT tables"
test smallint-vs-integer-literal-violation {
    CREATE TABLE t(n smallint CHECK(n >= 0 AND n <= 2)) STRICT;
    INSERT INTO t VALUES(3);
}
expect error {
    CHECK constraint failed
}

@requires strict "uses STRICT tables"
test integer-types-of-different-sizes-valid {
    CREATE TABLE t(a int2, b INTEGER, c int8, d bigint, CHECK(a < b AND b < c AND a < d AND d BETWEEN a AND c AND a IN (1, 2))) STRICT;
    INSERT INTO t VALUES(1, 2, 3, 2);
    SELECT a, b, c, d FROM t;
}
expect {
    1|2|3|2
}

@requires strict "uses STRICT tables"
test integer-types-of-different-sizes-violation {
    CREATE TABLE t(a smallint, c bigint, CHECK(a < c)) STRICT;
    INSERT INTO t VALUES(5, 4);
}
expect error {
    CHECK constraint failed
}

@requires strict "uses STRICT tables"
test smallint-vs-text-error {
    CREATE TABLE t(n smallint CHECK(n < 'hello')) STRICT;
}
expect error {
    type mismatch
}

@requires strict "uses STRICT tables"
test varchar-vs-text-literal-valid {
    CREATE TABLE t(name varchar(10) CHECK(name <> '')) STRICT;
    INSERT INTO t VALUES('alice');
    SELECT name FROM t;
}
expect {
    alice
}

setup integer-types-of-different-sizes {
    CREATE TABLE t(a smallint, b bigint, CHECK(a >= 0 AND a < b)) STRICT;
}

@skip-if mvcc "mvcc has different root pages"
@setup integer-types-of-different-sizes
snapshot check-on-integer-types-of-different-sizes-has-no-cast {
    INSERT INTO t VALUES(1, 2);
}

@requires strict "uses STRICT tables"
test custom-type-without-decode-vs-base-literal-valid {
    CREATE TYPE score BASE integer;
    CREATE TABLE t(s score CHECK(s > 0)) STRICT;
    INSERT INTO t VALUES(7);
    SELECT s FROM t;
}
expect {
    7
}

# ============================================================================
# Built-in function calls in CHECK on STRICT tables
# ============================================================================

@requires strict "uses STRICT tables"
test function-call-length-valid {
    CREATE TABLE t(a TEXT CHECK(length(a) < 10)) STRICT;
    INSERT INTO t VALUES('hello');
    SELECT a FROM t;
}
expect {
    hello
}

@requires strict "uses STRICT tables"
test function-call-length-violation {
    CREATE TABLE t(a TEXT CHECK(length(a) < 5)) STRICT;
    INSERT INTO t VALUES('toolong');
}
expect error {
    CHECK constraint failed
}

@requires strict "uses STRICT tables"
test function-call-abs-valid {
    CREATE TABLE t(x INTEGER CHECK(abs(x) < 100)) STRICT;
    INSERT INTO t VALUES(-42);
    SELECT x FROM t;
}
expect {
    -42
}

@requires strict "uses STRICT tables"
test function-call-abs-of-text-is-a-number {
    -- abs converts text to a number first.
    CREATE TABLE t(a TEXT CHECK(abs(a) < 100)) STRICT;
    INSERT INTO t VALUES('-42');
    SELECT a FROM t;
}
expect {
    -42
}

@requires strict "uses STRICT tables"
test function-call-coalesce-min-max-of-mixed-types {
    -- coalesce, min and max may return any of their arguments, so with an
    -- integer and a text argument the result may be either.
    CREATE TABLE t(
        a TEXT,
        b INTEGER,
        CHECK(coalesce(b, a) <> 'x'),
        CHECK(ifnull(b, a) <> 'x'),
        CHECK(min(b, a) <> 'x'),
        CHECK(max(b, a) <> 'x')
    ) STRICT;
    INSERT INTO t VALUES('y', NULL);
    SELECT a FROM t;
}
expect {
    y
}

@requires strict "uses STRICT tables"
test function-call-iif-else-value {
    -- iif may return its last value, not only its first.
    CREATE TABLE t(a TEXT, b INTEGER, CHECK(iif(b > 0, b, a) <> 'x')) STRICT;
    INSERT INTO t VALUES('y', 0);
    SELECT a FROM t;
}
expect {
    y
}

@requires strict "uses STRICT tables"
test function-call-coalesce-of-text-vs-integer-error {
    CREATE TABLE t(a TEXT, b TEXT, CHECK(coalesce(a, b) > 1)) STRICT;
}
expect error {
    type mismatch
}

@requires strict "uses STRICT tables"
test function-call-coalesce-of-mixed-types-in-arithmetic {
    -- coalesce of an integer and text may be a number, so arithmetic on it is allowed.
    CREATE TABLE t(
        a INTEGER,
        b TEXT,
        CHECK(coalesce(a, b) + 1 > 0),
        CHECK(-ifnull(a, 'none') < 1)
    ) STRICT;
    INSERT INTO t VALUES (5, 'x');
    SELECT * FROM t;
}
expect {
    5|x
}

@requires strict "uses STRICT tables"
test arithmetic-on-text-column-error {
    CREATE TABLE t(a TEXT, CHECK(a + 1 > 0)) STRICT;
}
expect error {
    arithmetic requires numeric types, got TEXT and INTEGER
}

@requires strict "uses STRICT tables"
test function-call-upper-valid {
    CREATE TABLE t(a TEXT CHECK(upper(a) = a)) STRICT;
    INSERT INTO t VALUES('HELLO');
    SELECT a FROM t;
}
expect {
    HELLO
}

@requires strict "uses STRICT tables"
test function-call-typeof-valid {
    CREATE TABLE t(a TEXT CHECK(typeof(a) = 'text')) STRICT;
    INSERT INTO t VALUES('hello');
    SELECT a FROM t;
}
expect {
    hello
}

@requires strict "uses STRICT tables"
test function-call-with-cast-valid {
    CREATE TABLE t(a TEXT CHECK(CAST(length(a) AS INTEGER) < 10)) STRICT;
    INSERT INTO t VALUES('hello');
    SELECT a FROM t;
}
expect {
    hello
}

@requires strict "uses STRICT tables"
test function-call-with-cast-violation {
    CREATE TABLE t(a TEXT CHECK(CAST(length(a) AS INTEGER) < 5)) STRICT;
    INSERT INTO t VALUES('toolong');
}
expect error {
    CHECK constraint failed
}

# likely() returns its argument, so it has the argument's type.
@requires strict "uses STRICT tables"
test likely-of-text-vs-real-error {
    CREATE TABLE t(x REAL, s TEXT, CHECK(x = likely(s))) STRICT;
}
expect error {
    cannot compare REAL with TEXT
}

# floor() of a text value has no fixed type, so the comparison is accepted.
@requires strict "uses STRICT tables"
test floor-of-text-vs-text-valid {
    CREATE TABLE t(x TEXT, CHECK(x = floor(x))) STRICT;
    INSERT INTO t VALUES('3');
    SELECT x FROM t;
}
expect {
    3
}

# ============================================================================
# Non-STRICT tables — no type checking applied
# ============================================================================

test non-strict-integer-vs-text-ok {
    CREATE TABLE t(a INTEGER CHECK(a < 'hello'));
    INSERT INTO t VALUES(42);
    SELECT a FROM t;
}
expect {
    42
}

test non-strict-custom-type-ok {
    CREATE TABLE t(a FAKETYPE CHECK(a < 'hello'));
    INSERT INTO t VALUES(42);
    SELECT a FROM t;
}
expect {
    42
}

# ============================================================================
# Edge cases
# ============================================================================

@requires strict "uses STRICT tables"
test not-expression-valid {
    CREATE TABLE t(a INTEGER CHECK(NOT (a < 0))) STRICT;
    INSERT INTO t VALUES(5);
    SELECT a FROM t;
}
expect {
    5
}

@requires strict "uses STRICT tables"
test unary-minus-valid {
    CREATE TABLE t(a INTEGER CHECK(a > -10)) STRICT;
    INSERT INTO t VALUES(5);
    SELECT a FROM t;
}
expect {
    5
}

@requires strict "uses STRICT tables"
test parenthesized-valid {
    CREATE TABLE t(a INTEGER CHECK((a) > 0)) STRICT;
    INSERT INTO t VALUES(5);
    SELECT a FROM t;
}
expect {
    5
}

@requires strict "uses STRICT tables"
test table-level-check-mismatch {
    CREATE TABLE t(a INTEGER, b TEXT, CHECK(a < b)) STRICT;
}
expect error {
    type mismatch
}

@requires strict "uses STRICT tables"
test column-level-check-mismatch {
    CREATE TABLE t(a INTEGER CHECK(a < 'text')) STRICT;
}
expect error {
    type mismatch
}

@requires strict "uses STRICT tables"
test concat-produces-text {
    CREATE TABLE t(a TEXT, b TEXT, CHECK(a || b != 'bad')) STRICT;
    INSERT INTO t VALUES('go', 'od');
    SELECT a, b FROM t;
}
expect {
    go|od
}

@requires strict "uses STRICT tables"
test modulus-produces-integer {
    CREATE TABLE t(a INTEGER CHECK(a % 2 = 0)) STRICT;
    INSERT INTO t VALUES(4);
    SELECT a FROM t;
}
expect {
    4
}

@requires strict "uses STRICT tables"
test bitwise-produces-integer {
    CREATE TABLE t(a INTEGER CHECK((a & 1) = 0)) STRICT;
    INSERT INTO t VALUES(4);
    SELECT a FROM t;
}
expect {
    4
}

# ============================================================================
# A CHECK sees a custom-type column as SELECT reads it, after DECODE
# ============================================================================

@requires strict "uses STRICT tables"
test check-ceil-of-numeric {
    CREATE TABLE t(n numeric(10,2), CHECK(ceil(n) > 4)) STRICT;
    INSERT INTO t VALUES(4.5);
    INSERT INTO t VALUES(-4.5);
}
expect error {
    CHECK constraint failed: ceil\(n\) > 4
}

@requires strict "uses STRICT tables"
test check-round-of-numeric {
    CREATE TABLE t(n numeric(10,2), CHECK(round(n) > 4)) STRICT;
    INSERT INTO t VALUES(4.5);
    SELECT n, round(n) > 4 FROM t;
}
expect {
    4.50|1
}

@requires strict "uses STRICT tables"
test check-abs-of-numeric {
    CREATE TABLE t(n numeric(10,2), CHECK(abs(n) < 10)) STRICT;
    INSERT INTO t VALUES(-5);
    INSERT INTO t VALUES(-20);
}
expect error {
    CHECK constraint failed: abs\(n\) < 10
}

@requires strict "uses STRICT tables"
test check-substr-of-numeric {
    CREATE TABLE t(n numeric(10,2), CHECK(substr(n, 1, 1) <> '-')) STRICT;
    INSERT INTO t VALUES(4.5);
    INSERT INTO t VALUES(-4.5);
}
expect error {
    CHECK constraint failed: substr\(n, 1, 1\) <> '-'
}

@requires strict "uses STRICT tables"
test check-arithmetic-on-numeric {
    CREATE TABLE t(n numeric(10,2), CHECK(substr(n, 1) + 0 > 0), CHECK(CAST(n AS REAL) * 2 < 10)) STRICT;
    INSERT INTO t VALUES(4.5);
    SELECT n FROM t;
}
expect {
    4.50
}

@requires strict "uses STRICT tables"
test check-arithmetic-on-numeric-violation {
    CREATE TABLE t(n numeric(10,2), CHECK(CAST(n AS REAL) * 2 < 10)) STRICT;
    INSERT INTO t VALUES(20);
}
expect error {
    CHECK constraint failed
}

@requires strict "uses STRICT tables"
test check-numeric-vs-literal {
    CREATE TABLE t(n numeric(10,2), CHECK(n > 4)) STRICT;
    INSERT INTO t VALUES(4.5);
    INSERT INTO t VALUES(3);
}
expect error {
    CHECK constraint failed: n > 4
}

@requires strict "uses STRICT tables"
test check-length-of-uuid {
    CREATE TABLE t(id uuid, CHECK(length(id) = 36), CHECK(substr(id, 15, 1) = '4')) STRICT;
    INSERT INTO t VALUES('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11');
    SELECT id FROM t;
}
expect {
    a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
}

@requires strict "uses STRICT tables"
test check-uuid-violation {
    CREATE TABLE t(id uuid, CHECK(substr(id, 15, 1) = '4')) STRICT;
    INSERT INTO t VALUES('a0eebc99-9c0b-1ef8-bb6d-6bb9bd380a11');
}
expect error {
    CHECK constraint failed
}

@requires strict "uses STRICT tables"
test check-on-update-and-upsert-sees-decoded-values {
    CREATE TABLE t(id INTEGER PRIMARY KEY, n numeric(10,2), m numeric(10,2), CHECK(ceil(n) > 4)) STRICT;
    INSERT INTO t VALUES(1, 4.5, 1);
    UPDATE t SET m = 2;
    INSERT INTO t VALUES(1, 4.5, 3) ON CONFLICT(id) DO UPDATE SET n = 5.5;
    SELECT n, m FROM t;
}
expect {
    5.50|2.00
}

@requires strict "uses STRICT tables"
test check-on-update-violation {
    CREATE TABLE t(id INTEGER PRIMARY KEY, n numeric(10,2), CHECK(ceil(n) > 4)) STRICT;
    INSERT INTO t VALUES(1, 4.5);
    UPDATE t SET n = -4.5;
}
expect error {
    CHECK constraint failed: ceil\(n\) > 4
}

@requires strict "uses STRICT tables"
test check-on-upsert-violation {
    CREATE TABLE t(id INTEGER PRIMARY KEY, n numeric(10,2), CHECK(ceil(n) > 4)) STRICT;
    INSERT INTO t VALUES(1, 4.5);
    INSERT INTO t VALUES(1, 4.5) ON CONFLICT(id) DO UPDATE SET n = -4.5;
}
expect error {
    CHECK constraint failed: ceil\(n\) > 4
}

@requires strict "uses STRICT tables"
test check-added-by-alter-sees-decoded-values {
    CREATE TABLE t(n numeric(10,2)) STRICT;
    INSERT INTO t VALUES(-4.5);
    ALTER TABLE t ADD COLUMN m INTEGER CHECK(ceil(n) > 4);
}
expect error {
    CHECK constraint failed
}
