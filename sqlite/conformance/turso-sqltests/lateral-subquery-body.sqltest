@database :memory:

# Clauses inside a LATERAL subquery that read columns of the left side.
# The statements run only through the SQLite frontend.
# Tests with the same SQL for both frontends are in
# testing/shared-sqltests/lateral-subquery-body.sqltest.

setup data {
    CREATE TABLE t1(a INT, b TEXT);
    CREATE TABLE t2(a INT, c INT, d TEXT);
    CREATE TABLE t3(c INT, e TEXT);
    INSERT INTO t1 VALUES (1, 'p'), (2, 'q'), (3, 'r'), (4, 's');
    INSERT INTO t2 VALUES (1, 10, 'x'), (2, 20, 'y'), (2, 30, 'z'), (3, 40, 'w'), (5, 50, 'v'), (2, 25, 'y'), (3, 40, 'x');
    INSERT INTO t3 VALUES (10, 'k'), (20, 'l'), (30, 'm'), (30, 'n'), (60, 'o');
}

@setup data
test having-without-group-by-reads-outer-column {
    SELECT t1.a, s.n FROM t1, LATERAL (SELECT count(*) AS n FROM t2 HAVING count(*) > t1.a * 2) AS s ORDER BY 1;
}
expect {
    1|7
    2|7
    3|7
}
