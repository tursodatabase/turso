@database :memory:

# LATERAL statements that PostgreSQL 16 also rejects, and a few edge
# cases that it accepts. The error messages are the messages of Turso.
# The statements run only through the SQLite frontend.
# Tests with the same SQL for both frontends are in
# testing/shared-sqltests/lateral-errors.sqltest.

setup data {
    CREATE TABLE t1(a INT, b TEXT);
    CREATE TABLE t2(a INT, c INT, d TEXT);
    CREATE TABLE t3(c INT, e TEXT);
    INSERT INTO t1 VALUES (1, 'p'), (2, 'q'), (3, 'r');
    INSERT INTO t2 VALUES (1, 10, 'x'), (2, 20, 'y'), (2, 30, 'z');
    INSERT INTO t3 VALUES (10, 'k'), (20, 'l');
}

@setup data
test aggregate-of-left-columns-in-having-is-not-allowed {
    SELECT * FROM t1, LATERAL (SELECT count(*) AS n FROM t2 HAVING sum(t1.a) > 0) AS s;
}
expect error {
    aggregate functions are not allowed in FROM clause of their own query level
}
