@database :memory:
@skip-file-if debug "the queries at the nesting limits overflow the stack of a debug build"

# Queries at the nesting limit of Turso, MAX_QUERY_DEPTH (500 nested queries),
# and one level past it, where Turso must give the limit error. Each kind of
# nesting goes through a different recursion path of the parser, the planner,
# the optimizer or the emitter. If a stack frame on one of these paths becomes
# larger, a query at the limit can overflow the stack.
#
# The tests run only on the Rust backend, which runs each test on a worker
# thread with a 2 MiB stack. This is the stack that Rust gives to a thread that
# it starts. The CLI and JS backends have a larger stack. If a query overflows
# the stack, the whole runner stops with "has overflowed its stack". The file is
# skipped in a debug build, because debug frames are much larger: there, 100
# nested FROM subqueries need 5.7 MiB.
#
# The comment before each pair of tests gives the Python expression that makes
# the query for a depth D.

setup t {
    CREATE TABLE t(x);
    INSERT INTO t VALUES(1);
}

# Nested FROM subqueries.
#     "SELECT * FROM " + "(SELECT * FROM " * D + "t" + ")" * D + ";"

