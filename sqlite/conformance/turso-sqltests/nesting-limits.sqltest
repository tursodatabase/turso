# Different windows: each window adds one level of subquery to the plan.
#     cols = ", ".join(f"sum(x) OVER (ORDER BY x ROWS {i} PRECEDING)" for i in range(D - 1))
#     f"SELECT count(*) FROM (SELECT {cols} FROM t);"

