test mvcc-user-sequence-backing-table-compacted-after-commit {
    PRAGMA journal_mode = 'mvcc';
    CREATE SEQUENCE compact_seq START 1 INCREMENT 1;
    SELECT nextval('compact_seq');
    SELECT nextval('compact_seq');
    SELECT nextval('compact_seq');
    SELECT nextval('compact_seq');
    SELECT nextval('compact_seq');
    PRAGMA wal_checkpoint(TRUNCATE);
    SELECT COUNT(*) FROM "__turso_internal_seq_compact_seq";
    SELECT value FROM "__turso_internal_seq_compact_seq";
}
expect {
    mvcc
    1
    2
    3
    4
    5
    0|0|0
    1
    5
}

test mvcc-autoincrement-backing-table-compacted-after-commit {
    PRAGMA journal_mode = 'mvcc';
    CREATE TABLE compacted(id INTEGER PRIMARY KEY AUTOINCREMENT, v TEXT);
    INSERT INTO compacted(v) VALUES ('row1');
    INSERT INTO compacted(v) VALUES ('row2');
    INSERT INTO compacted(v) VALUES ('row3');
    INSERT INTO compacted(v) VALUES ('row4');
    INSERT INTO compacted(v) VALUES ('row5');
    PRAGMA wal_checkpoint(TRUNCATE);
    SELECT COUNT(*) FROM "__turso_internal_seq___turso_internal_autoincrement_compacted";
}
expect {
    mvcc
    0|0|0
    1
}

test mvcc-autoincrement-rollback-does-not-pollute-sqlite-sequence {
    PRAGMA journal_mode = 'mvcc';
    CREATE TABLE rollback_t(id INTEGER PRIMARY KEY AUTOINCREMENT, v TEXT);
    INSERT INTO rollback_t(v) VALUES ('committed1');
    INSERT INTO rollback_t(v) VALUES ('committed2');
    INSERT INTO rollback_t(v) VALUES ('committed3');
    BEGIN;
    INSERT INTO rollback_t(v) VALUES ('rolledback1');
    INSERT INTO rollback_t(v) VALUES ('rolledback2');
    INSERT INTO rollback_t(v) VALUES ('rolledback3');
    INSERT INTO rollback_t(v) VALUES ('rolledback4');
    INSERT INTO rollback_t(v) VALUES ('rolledback5');
    ROLLBACK;
    PRAGMA wal_checkpoint(TRUNCATE);
    SELECT name, seq FROM sqlite_sequence WHERE name = 'rollback_t';
    INSERT INTO rollback_t(v) VALUES ('after_rollback');
    SELECT id FROM rollback_t WHERE v = 'after_rollback';
}
expect {
    mvcc
    0|0|0
    rollback_t|3
    4
}

test mvcc-user-sequence-rollback-does-not-pollute-watermark {
    PRAGMA journal_mode = 'mvcc';
    CREATE SEQUENCE rb_seq START 1 INCREMENT 1;
    SELECT nextval('rb_seq');
    SELECT nextval('rb_seq');
    SELECT nextval('rb_seq');
    BEGIN;
    SELECT nextval('rb_seq');
    SELECT nextval('rb_seq');
    SELECT nextval('rb_seq');
    SELECT nextval('rb_seq');
    SELECT nextval('rb_seq');
    ROLLBACK;
    PRAGMA wal_checkpoint(TRUNCATE);
    SELECT value FROM "__turso_internal_seq_rb_seq";
}
expect {
    mvcc
    1
    2
    3
    4
    5
    6
    7
    8
    0|0|0
    3
}
