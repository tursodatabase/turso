    SELECT count(*), sum(s.n) FROM o JOIN p ON p.x = o.a, LATERAL (SELECT count(*) AS n FROM q WHERE q.z = p.y) AS s;
}
expect {
    1020|9870
}

@setup large
@setup large-indexes
test large-outer-join-then-lateral-with-indexes {
    SELECT count(*), sum(s.n) FROM o JOIN p ON p.x = o.a, LATERAL (SELECT count(*) AS n FROM q WHERE q.z = p.y) AS s;
}
expect {
    1020|9870
}

@setup large
test large-lateral-then-join {
    SELECT count(*), sum(q.id) FROM o, LATERAL (SELECT p.y FROM p WHERE p.x = o.a % 10 ORDER BY p.id LIMIT 2) AS s JOIN q ON q.z = s.y WHERE o.id <= 10;
}
expect {
    193|28908
}

@setup large
@setup large-indexes
test large-lateral-then-join-with-indexes {
    SELECT count(*), sum(q.id) FROM o, LATERAL (SELECT p.y FROM p WHERE p.x = o.a % 10 ORDER BY p.id LIMIT 2) AS s JOIN q ON q.z = s.y WHERE o.id <= 10;
}
expect {
    193|28908
}

@setup large
test large-lateral-top-n {
    SELECT o.id, s.id FROM o, LATERAL (SELECT q.id FROM q WHERE q.x = o.a % 10 ORDER BY q.z DESC, q.id LIMIT 2) AS s WHERE o.id <= 6 ORDER BY 1, 2;
}
expect {
    1|107
    1|197
    2|14
    2|214
    3|121
    3|231
    4|28
    4|138
    5|45
    5|245
    6|152
    6|262
}

