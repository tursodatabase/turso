@setup data
test left-equality-on-a-lateral-reads-rowid {
    SELECT t1.a, s.v FROM t1, LATERAL (SELECT t1.id * 100 + count(*) AS v FROM t2 WHERE t2.a = t1.a) AS s WHERE t1.a = 2 ORDER BY 2;
