@setup large
test large-group-by-outside-of-lateral {
    SELECT o.a, count(*), sum(s.n) FROM o, LATERAL (SELECT count(*) AS n FROM p WHERE p.x = o.a % 10 AND p.y > o.b) AS s GROUP BY o.a ORDER BY 1;
}
expect {
    0|3|70
    1|4|76
    2|4|92
    3|4|72
    4|4|84
    5|3|70
    6|3|58
    7|3|75
    8|3|59
    9|3|61
    10|3|66
    11|3|65
}

