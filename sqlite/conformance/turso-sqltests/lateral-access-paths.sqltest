setup hash-join-next-to-lateral {
    CREATE TABLE o(id, a);
    CREATE TABLE p(x, y);
    CREATE TABLE q(x, z);
    WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM c WHERE n < 10)
    INSERT INTO o SELECT n - 1, n * 100 FROM c;
    WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM c WHERE n < 300)
    INSERT INTO p SELECT n % 10, (n * 7) % 31 FROM c;
    WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM c WHERE n < 300)
    INSERT INTO q SELECT (n * 3) % 10, (n * 11) % 31 FROM c;
    ANALYZE;
}

@setup hash-join-next-to-lateral
test hash-join-between-tables-that-the-lateral-does-not-read {
    EXPLAIN QUERY PLAN
    SELECT count(*), sum(s.e) FROM o, p JOIN q ON p.y = q.z, LATERAL (SELECT o.a AS e) AS s;
}
expect {
    1|0|0|SCAN o
    2|0|0|HASH JOIN q
    3|0|0|SCAN s
    5|3|0|SCAN CONSTANT ROW
    9|0|0|SCAN p
}

@setup hash-join-next-to-lateral
test lateral-after-a-hash-join-between-tables-that-it-does-not-read {
    SELECT count(*), sum(s.e) FROM o, p JOIN q ON p.y = q.z, LATERAL (SELECT o.a AS e) AS s;
}
expect {
    29030|15966500
}

@setup hash-join-next-to-lateral
test lateral-reads-a-table-that-a-hash-join-would-copy-into-its-build-input {
    SELECT count(*), sum(s.e) FROM p JOIN q ON p.y = q.z JOIN o ON o.id = q.x, LATERAL (SELECT o.a AS e) AS s;
}
expect {
    2903|1596200
}
