@setup large
test large-materialized-cte-reads-outer {
    SELECT o.id, s.n FROM o, LATERAL (WITH m AS MATERIALIZED (SELECT y FROM p WHERE p.x = o.a % 10) SELECT count(*) AS n FROM m JOIN q ON q.z = m.y) AS s WHERE o.id <= 12 ORDER BY 1;
}
expect {
    1|290
    2|290
    3|290
    4|291
    5|291
    6|290
    7|290
    8|290
    9|290
    10|291
    11|290
    12|291
}

