@setup data
test left-equality-on-a-lateral-reads-uncovered-column {
    SELECT t1.id, s.v FROM t1, LATERAL (SELECT t1.d || e AS v FROM t2 WHERE t2.a = t1.a) AS s WHERE t1.a = 3 ORDER BY 1, 2;
}
expect {
    4|sn
    4|so
}

