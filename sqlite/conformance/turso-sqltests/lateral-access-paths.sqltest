@setup large
test large-union-inside-reads-outer {
    SELECT o.id, s.n FROM o, LATERAL (SELECT count(*) AS n FROM (SELECT y FROM p WHERE p.x = o.a % 10 UNION SELECT z FROM q WHERE q.x = o.b % 10) AS u) AS s WHERE o.id <= 12 ORDER BY 1;
}
