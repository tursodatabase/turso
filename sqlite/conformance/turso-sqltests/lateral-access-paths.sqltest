@setup large
test large-nested-lateral-with-joins {
    SELECT o.id, s.n FROM o, LATERAL (SELECT sum(u.k) AS n FROM p, LATERAL (SELECT count(*) AS k FROM q WHERE q.z = p.y AND q.x = o.a % 10) AS u WHERE p.x = o.b % 10) AS s WHERE o.id <= 8 ORDER BY 1;
}
expect {
    1|29
    2|29
    3|29
    4|29
    5|29
    6|29
    7|29
    8|29
}

