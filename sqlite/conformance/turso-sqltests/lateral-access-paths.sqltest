@setup data
test left-order-by-a-desc {
    SELECT t1.a, t1.b, s.n FROM t1, LATERAL (SELECT count(*) AS n FROM t2 WHERE t2.a = t1.a) AS s ORDER BY t1.a DESC, t1.b DESC;
}
expect {
    5|60|0
    4|10|0
    3|20|2
    2|40|3
    2|30|3
    1|50|2
}

