@setup large
test large-left-join-lateral-empty-for-some-rows {
    SELECT o.id, s.n FROM o LEFT JOIN LATERAL (SELECT p.id AS n FROM p WHERE p.x = o.a AND p.y = o.b) AS s ON true WHERE o.id <= 20 ORDER BY 1, 2 NULLS FIRST;
