@setup large
test large-window-inside-reads-outer {
    SELECT o.id, s.id, s.r FROM o, LATERAL (SELECT q.id, row_number() OVER (ORDER BY q.z, q.id) AS r FROM q WHERE q.x = o.a % 10) AS s WHERE o.id <= 3 AND s.r <= 2 ORDER BY 1, 3;
}
expect {
    1|217|1
    1|17|2
    2|124|1
    2|234|2
    3|31|1
    3|141|2
}

