test left-or-of-in-and-range {
    SELECT t1.id, s.e FROM t1, LATERAL (SELECT e FROM t2 WHERE t2.id = t1.id) AS s WHERE t1.a IN (1, 5) OR t1.b < 25 ORDER BY 1;
