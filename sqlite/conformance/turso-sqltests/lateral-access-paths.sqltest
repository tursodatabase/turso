@setup data
test left-covering-columns-only {
    SELECT t1.a, t1.b, s.v FROM t1, LATERAL (SELECT t1.a * 1000 + t1.b AS v) AS s WHERE t1.a >= 2 ORDER BY 1, 2;
}
expect {
    2|30|2030
    2|40|2040
    3|20|3020
    4|10|4010
    5|60|5060
}

