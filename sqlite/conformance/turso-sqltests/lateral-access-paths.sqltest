test left-equality-on-a {
    SELECT t1.id, s.c FROM t1, LATERAL (SELECT c FROM t2 WHERE t2.a = t1.a) AS s WHERE t1.a = 2 ORDER BY 1, 2;
}
expect {
    2|20
    2|25
    2|30
    3|20
    3|25
    3|30
}

