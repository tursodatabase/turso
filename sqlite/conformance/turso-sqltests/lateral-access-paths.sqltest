@database :memory:

# Access paths of the tables on both sides of a LATERAL subquery: rowid
# and index seeks, covering and multi-column indexes, IN lists, OR terms,
# range scans, and larger tables where the planner picks hash joins and
# automatic indexes inside the subquery.
# PostgreSQL 16 gave every expected result.

setup data {
    CREATE TABLE t1(id INTEGER PRIMARY KEY, a INT, b INT, d TEXT);
    CREATE TABLE t2(id INTEGER PRIMARY KEY, a INT, c INT, e TEXT);
    INSERT INTO t1 VALUES (1, 1, 50, 'p'), (2, 2, 40, 'q'), (3, 2, 30, 'r'), (4, 3, 20, 's'), (5, 4, 10, 't'), (6, 5, 60, 'u');
    INSERT INTO t2 VALUES (1, 1, 10, 'k'), (2, 2, 20, 'l'), (3, 2, 30, 'm'), (4, 3, 40, 'n'), (5, 3, 45, 'o'), (6, 6, 60, 'p'), (7, 1, 15, 'q'), (8, 2, 25, 'r');
}

setup t1-a {
    CREATE INDEX t1_a ON t1(a);
}

setup t1-b {
    CREATE INDEX t1_b ON t1(b);
}

setup t1-a-b {
    CREATE INDEX t1_a_b ON t1(a, b);
}

setup t1-a-b-d {
    CREATE INDEX t1_a_b_d ON t1(a, b, d);
}

setup t2-a {
    CREATE INDEX t2_a ON t2(a);
}

setup t2-a-c {
    CREATE INDEX t2_a_c ON t2(a, c);
}

setup t2-c {
    CREATE INDEX t2_c ON t2(c);
}

setup t2-unique-c {
    CREATE UNIQUE INDEX t2_c_unique ON t2(c);
}

setup large {
    CREATE TABLE o(id INTEGER PRIMARY KEY, a INT, b INT);
    CREATE TABLE p(id INTEGER PRIMARY KEY, x INT, y INT);
    CREATE TABLE q(id INTEGER PRIMARY KEY, x INT, z INT);
    WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM c WHERE n < 300)
    INSERT INTO p SELECT n, n % 10, (n * 7) % 31 FROM c;
    WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM c WHERE n < 300)
    INSERT INTO q SELECT n, (n * 3) % 10, (n * 11) % 31 FROM c;
    WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM c WHERE n < 40)
    INSERT INTO o SELECT n, n % 12, (n * 5) % 17 FROM c;
}

setup large-indexes {
    CREATE INDEX p_x ON p(x);
    CREATE INDEX p_y ON p(y);
    CREATE INDEX q_x ON q(x);
    CREATE INDEX q_z ON q(z);
    CREATE INDEX o_a ON o(a);
}

@setup data
test left-rowid-equality {
    SELECT t1.id, s.c FROM t1, LATERAL (SELECT c FROM t2 WHERE t2.a = t1.a) AS s WHERE t1.id = 3 ORDER BY 2;
}
expect {
    3|20
    3|25
    3|30
}

@setup data
test left-rowid-in-list {
    SELECT t1.id, s.c FROM t1, LATERAL (SELECT c FROM t2 WHERE t2.a = t1.a) AS s WHERE t1.id IN (1, 4, 9) ORDER BY 1, 2;
}
expect {
    1|10
    1|15
    4|40
    4|45
}

@setup data
test left-rowid-range {
    SELECT t1.id, s.c FROM t1, LATERAL (SELECT c FROM t2 WHERE t2.a = t1.a) AS s WHERE t1.id BETWEEN 2 AND 4 ORDER BY 1, 2;
}
expect {
    2|20
    2|25
    2|30
    3|20
    3|25
    3|30
    4|40
    4|45
}

@setup data
test left-rowid-range-desc {
    SELECT t1.id, s.n FROM t1, LATERAL (SELECT count(*) AS n FROM t2 WHERE t2.a = t1.a) AS s WHERE t1.id > 3 ORDER BY t1.id DESC;
}
expect {
    6|0
    5|0
    4|2
}

@setup data
test left-rowid-read-inside-lateral {
    SELECT t1.id, s.e FROM t1, LATERAL (SELECT e FROM t2 WHERE t2.id = t1.id + 1) AS s ORDER BY 1;
}
expect {
    1|l
    2|m
    3|n
    4|o
    5|p
    6|q
}

