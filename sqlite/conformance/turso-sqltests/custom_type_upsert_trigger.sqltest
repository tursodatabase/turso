@requires strict "uses STRICT tables"

@requires trigger "uses triggers"

test before-insert-trigger-sees-the-value-of-the-statement {
    CREATE TYPE cents BASE integer ENCODE value * 100 DECODE value / 100;
    CREATE TABLE t1(id INTEGER PRIMARY KEY, amount cents, note TEXT) STRICT;
    CREATE TABLE log(msg TEXT);
    CREATE TRIGGER tr_before BEFORE INSERT ON t1
    BEGIN INSERT INTO log VALUES ('new=' || NEW.amount); END;
    INSERT INTO t1 VALUES (1, 10, 'a');
    SELECT * FROM log;
    SELECT id, amount FROM t1;
}
expect {
    new=10
    1|10
}
