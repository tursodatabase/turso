@database :memory:
@requires-file custom_types "array tests require custom types support"

test array-trailing-comma-rejected {
    CREATE TABLE tc1 (id INTEGER PRIMARY KEY, vals integer[]) STRICT;
    INSERT INTO tc1 VALUES (1, '{1,2,}');
}
expect error {
    cannot store non-array value in INTEGER column tc1.vals
}

test array-infinity-rejected {
    CREATE TABLE inf1 (id INTEGER PRIMARY KEY, vals real[]) STRICT;
    INSERT INTO inf1 VALUES (1, '{1e309}');
}
expect error {
    cannot store non-array value in REAL column inf1.vals
}

test array-neg-infinity-rejected {
    CREATE TABLE inf2 (id INTEGER PRIMARY KEY, vals real[]) STRICT;
    INSERT INTO inf2 VALUES (1, '{-1e309}');
}
expect error {
    cannot store non-array value in REAL column inf2.vals
}

test array-infinity-insert-select {
    CREATE TABLE inf3 (id INTEGER PRIMARY KEY, vals real[]) STRICT;
    INSERT INTO inf3 VALUES (1, '{1.0, 2.0, 3.0}');
    INSERT INTO inf3 SELECT id + 1, vals FROM inf3;
    SELECT id, vals FROM inf3 ORDER BY id;
}
expect {
    1|{1.0,2.0,3.0}
    2|{1.0,2.0,3.0}
}

test array-case-display {
    CREATE TABLE cd1 (id INTEGER PRIMARY KEY, vals integer[]) STRICT;
    INSERT INTO cd1 VALUES (1, '{1,2,3}');
    SELECT CASE WHEN 1 THEN vals END FROM cd1;
}
expect {
    {1,2,3}
}

test array-coalesce-display {
    CREATE TABLE cd2 (id INTEGER PRIMARY KEY, vals integer[]) STRICT;
    INSERT INTO cd2 VALUES (1, '{4,5,6}');
    SELECT COALESCE(vals, vals) FROM cd2;
}
expect {
    {4,5,6}
}

test array-iif-display {
    CREATE TABLE cd3 (id INTEGER PRIMARY KEY, vals integer[]) STRICT;
    INSERT INTO cd3 VALUES (1, '{7,8,9}');
    SELECT IIF(1, vals, vals) FROM cd3;
}
expect {
    {7,8,9}
}

test array-nullif-display {
    CREATE TABLE cd4 (id INTEGER PRIMARY KEY, vals integer[]) STRICT;
    INSERT INTO cd4 VALUES (1, '{10,11}');
    SELECT NULLIF(vals, NULL) FROM cd4;
}
expect {
    {10,11}
}

test array-case-literal-display {
    SELECT CASE WHEN 1 THEN ARRAY[1, 2] END;
}
expect {
    {1,2}
}

test array-coalesce-literal-display {
    SELECT COALESCE(NULL, ARRAY[3, 4]);
}
expect {
    {3,4}
}

test array-order-by {
    CREATE TABLE ob1 (id INTEGER PRIMARY KEY, vals integer[]) STRICT;
    INSERT INTO ob1 VALUES (1, '{3,2,1}');
    INSERT INTO ob1 VALUES (2, '{1,2,3}');
    INSERT INTO ob1 VALUES (3, '{1,2}');
    INSERT INTO ob1 VALUES (4, '{1,2,4}');
    SELECT id, vals FROM ob1 ORDER BY vals;
}
expect {
    3|{1,2}
    2|{1,2,3}
    4|{1,2,4}
    1|{3,2,1}
}

test array-order-by-desc {
    CREATE TABLE ob2 (id INTEGER PRIMARY KEY, vals integer[]) STRICT;
    INSERT INTO ob2 VALUES (1, '{3,2,1}');
    INSERT INTO ob2 VALUES (2, '{1,2,3}');
    INSERT INTO ob2 VALUES (3, '{1,2}');
    INSERT INTO ob2 VALUES (4, '{1,2,4}');
    SELECT id, vals FROM ob2 ORDER BY vals DESC;
}
expect {
    1|{3,2,1}
    4|{1,2,4}
    2|{1,2,3}
    3|{1,2}
}

test array-order-by-text {
    CREATE TABLE ob3 (id INTEGER PRIMARY KEY, vals text[]) STRICT;
    INSERT INTO ob3 VALUES (1, '{"cherry","apple"}');
    INSERT INTO ob3 VALUES (2, '{"apple","banana"}');
    INSERT INTO ob3 VALUES (3, '{"apple"}');
    SELECT id, vals FROM ob3 ORDER BY vals;
}
expect {
    3|{apple}
    2|{apple,banana}
    1|{cherry,apple}
}

test array-order-by-with-other-columns {
    CREATE TABLE ob4 (id INTEGER PRIMARY KEY, name TEXT, vals integer[]) STRICT;
    INSERT INTO ob4 VALUES (1, 'a', '{2,1}');
    INSERT INTO ob4 VALUES (2, 'b', '{1,2}');
    SELECT id, name, vals FROM ob4 ORDER BY vals;
}
expect {
    2|b|{1,2}
    1|a|{2,1}
}

test array-trailing-comma-spaces {
    CREATE TABLE tc2 (id INTEGER PRIMARY KEY, vals integer[]) STRICT;
    INSERT INTO tc2 VALUES (1, '{1, 2, }');
}
expect error {
    cannot store non-array value in INTEGER column tc2.vals
}

test array-coalesce-null-then-array {
    CREATE TABLE cn1 (id INTEGER PRIMARY KEY, a integer[], b integer[]) STRICT;
    INSERT INTO cn1 VALUES (1, NULL, '{1,2,3}');
    SELECT COALESCE(a, b) FROM cn1;
}
expect {
    {1,2,3}
}

test array-ifnull-display {
    CREATE TABLE ifn1 (id INTEGER PRIMARY KEY, a integer[], b integer[]) STRICT;
    INSERT INTO ifn1 VALUES (1, NULL, '{5,6}');
    SELECT IFNULL(a, b) FROM ifn1;
}
expect {
    {5,6}
}

test array-nested-case-display {
    CREATE TABLE nc1 (id INTEGER PRIMARY KEY, vals integer[]) STRICT;
    INSERT INTO nc1 VALUES (1, '{1,2}');
    SELECT COALESCE(CASE WHEN 1 THEN vals END, ARRAY[0]) FROM nc1;
}
expect {
    {1,2}
}

test array-custom-type-decode-next-to-literal {
    CREATE TYPE cents_lit BASE integer ENCODE value*100 DECODE value/100;
    CREATE TABLE lit1 (id INTEGER PRIMARY KEY, xs cents_lit[]) STRICT;
    INSERT INTO lit1 VALUES (1, '{1,2,3}');
    SELECT 'l', xs FROM lit1;
}
expect {
    l|{1,2,3}
}

@requires strict "uses STRICT tables"
test array-custom-type-columns-compare-as-arrays {
    -- Arrays of a custom type compare element by element.
    CREATE TYPE test_uint(value any) BASE text
        ENCODE test_uint_encode(value)
        DECODE test_uint_decode(value);
    CREATE TABLE t(id INTEGER PRIMARY KEY, a test_uint[], b test_uint[]) STRICT;
    INSERT INTO t VALUES (1, '{1,2}', '{1}'), (2, '{3}', '{3}'), (3, '{2}', '{3}');
    SELECT id, a = b, a < b FROM t ORDER BY id;
}
expect {
    1|0|0
    2|1|0
    3|0|1
}

test array-cast-null-to-custom-type-array-is-null {
    CREATE TYPE lower_text_cast BASE text ENCODE value DECODE lower(value);
    SELECT CAST(NULL AS lower_text_cast[]) IS NULL;
}
expect {
    1
}

test array-cast-null-in-expression-index-on-custom-type-array {
    CREATE TYPE lower_text_ix BASE text ENCODE value DECODE lower(value);
    CREATE TABLE ct(id INTEGER PRIMARY KEY, c lower_text_ix[]) STRICT;
    INSERT INTO ct VALUES (1, NULL);
    CREATE INDEX ct_ix ON ct(CAST(c AS lower_text_ix[]));
    INSERT INTO ct VALUES (2, NULL), (3, '{A,b}');
    SELECT id, c FROM ct ORDER BY id;
}
expect {
    1|
    2|
    3|{a,b}
}

test array-generated-column-concat-joins-arrays {
    CREATE TABLE g(id INTEGER PRIMARY KEY, a integer[], b integer[], c integer[] GENERATED ALWAYS AS (a || b)) STRICT;
    INSERT INTO g(id, a, b) VALUES (1, '{1,2}', '{3}'), (2, '{5}', '{5}');
    SELECT id, c FROM g ORDER BY id;
}
expect {
    1|{1,2,3}
    2|{5,5}
}

# A column stores its number of array dimensions in three bits, so array types
# have at most 7 dimensions.
test array-type-with-8-dimensions-rejected-in-create-table {
    CREATE TABLE d8(a integer[][][][][][][][]) STRICT;
}
expect error {
    array type integer has 8 dimensions, but arrays have at most 7
}

test array-type-with-8-dimensions-rejected-in-cast {
    SELECT CAST(1 AS integer[][][][][][][][]);
}
expect error {
    array type integer has 8 dimensions, but arrays have at most 7
}

test array-agg-over-7-dimensions-rejected-in-subquery {
    SELECT * FROM (SELECT array_agg(CAST('{1}' AS integer[][][][][][][])));
}
expect error {
    result column 1 is an array with 8 dimensions, but arrays have at most 7
}

test array-column-primary-key-is-not-rowid-alias {
    CREATE TABLE apk1 (id INTEGER, c integer[] PRIMARY KEY) STRICT;
    INSERT INTO apk1 VALUES (1, '{1,2}');
    INSERT INTO apk1 VALUES (2, '{3}');
    SELECT rowid, id, c FROM apk1 ORDER BY id;
    SELECT name FROM sqlite_schema WHERE tbl_name = 'apk1' AND type = 'index';
    SELECT id FROM apk1 WHERE c = '{1, 2}';
}
expect {
    1|1|{1,2}
    2|2|{3}
    sqlite_autoindex_apk1_1
    1
}

test array-table-primary-key-is-not-rowid-alias {
    CREATE TABLE apk2 (id INTEGER, c integer[], PRIMARY KEY(c)) STRICT;
    INSERT INTO apk2 VALUES (1, '{1,2}');
    INSERT INTO apk2 VALUES (2, '{3}');
    SELECT rowid, id, c FROM apk2 ORDER BY id;
    SELECT name FROM sqlite_schema WHERE tbl_name = 'apk2' AND type = 'index';
}
expect {
    1|1|{1,2}
    2|2|{3}
    sqlite_autoindex_apk2_1
}

test array-primary-key-rejects-duplicates {
    CREATE TABLE apk3 (id INTEGER, c integer[] PRIMARY KEY) STRICT;
    INSERT INTO apk3 VALUES (1, '{1,2}');
    INSERT INTO apk3 VALUES (2, '{1,2}');
}
expect error {
    UNIQUE constraint failed: apk3.c
}

@skip-if mvcc "rebuilding affected indexes is not supported in MVCC mode"
test array-primary-key-alter-column-keeps-automatic-index {
    CREATE TABLE apk5 (id INTEGER, c integer[], PRIMARY KEY(c)) STRICT;
    ALTER TABLE apk5 ALTER COLUMN c TO d integer[];
    INSERT INTO apk5 VALUES (1, '{1,2}');
    SELECT rowid, id, d FROM apk5;
}
expect {
    1|1|{1,2}
}

# The INTEGER key is a rowid alias and an INTEGER[] key is not, so the change
# would need an automatic index that the table does not have.
test integer-primary-key-alter-column-to-array-rejected {
    CREATE TABLE apk6 (id INTEGER, c integer, PRIMARY KEY(c)) STRICT;
    ALTER TABLE apk6 ALTER COLUMN c TO d integer[];
}
expect error {
    PRIMARY KEY constraint cannot be altered
}

test array-primary-key-autoincrement-rejected {
    CREATE TABLE apk4 (c integer[] PRIMARY KEY AUTOINCREMENT) STRICT;
}
expect error {
    AUTOINCREMENT is only allowed on an INTEGER PRIMARY KEY
}
