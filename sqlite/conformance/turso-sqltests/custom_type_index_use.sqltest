# Known difference between plans: the seek ENCODEs the literal once before it
# reads a row, and the scan ENCODEs it only for a row that reaches the
# comparison. With no such row, only the seek raises the error.
@requires strict "uses STRICT tables"
test numeric-invalid-literal-without-index-gives-no-row-of-empty-table {
    CREATE TABLE e(id INTEGER PRIMARY KEY, n numeric(10,2)) STRICT;
    CREATE INDEX e_n ON e(n);
    SELECT count(*) FROM e NOT INDEXED WHERE n = 'abc';
}
expect {
    0
}

@requires strict "uses STRICT tables"
test numeric-invalid-literal-with-index-raises-error-on-empty-table {
    CREATE TABLE e(id INTEGER PRIMARY KEY, n numeric(10,2)) STRICT;
    CREATE INDEX e_n ON e(n);
    SELECT count(*) FROM e WHERE n = 'abc';
}
expect error {
    invalid numeric value: "abc"
}

# --- user types that DECODE to another value or compare with functions ---

@requires strict "uses STRICT tables"
test decode-to-another-value-same-rows-with-and-without-index {
    CREATE TYPE ci(value text) BASE text ENCODE value DECODE lower(value) OPERATOR '<';
    CREATE TABLE c(id INTEGER PRIMARY KEY, v ci) STRICT;
    CREATE INDEX c_v ON c(v);
    INSERT INTO c VALUES (1, 'ABC'), (2, 'abc');
    SELECT group_concat(id) FROM (SELECT id FROM c WHERE v = 'abc' ORDER BY id);
    SELECT group_concat(id) FROM (SELECT id FROM c NOT INDEXED WHERE v = 'abc' ORDER BY id);
    SELECT group_concat(id) FROM (SELECT id FROM c WHERE v IN ('abc') ORDER BY id);
}
expect {
    1,2
    1,2
    1,2
}

@requires strict "uses STRICT tables"
test domain-over-decoding-type-same-rows-with-and-without-index {
    CREATE TYPE rev(value text) BASE text ENCODE upper(value) DECODE lower(value) OPERATOR '<';
    CREATE DOMAIN drev AS rev;
    CREATE TABLE dr(id INTEGER PRIMARY KEY, v drev) STRICT;
    CREATE INDEX dr_v ON dr(v);
    INSERT INTO dr VALUES (1, 'abc');
    SELECT id FROM dr WHERE v = 'abc';
    SELECT id FROM dr NOT INDEXED WHERE v = 'abc';
}
expect {
    1
    1
}

@requires strict "uses STRICT tables"
test greater-than-function-same-rows-with-and-without-index {
    CREATE TYPE tag(value text) BASE text ENCODE value DECODE value OPERATOR '<' OPERATOR '>' instr;
    CREATE TABLE tg(id INTEGER PRIMARY KEY, v tag) STRICT;
    CREATE INDEX tg_v ON tg(v);
    INSERT INTO tg VALUES (1, 'abc'), (2, 'zzz'), (3, 'b');
    SELECT group_concat(id) FROM (SELECT id FROM tg WHERE v > 'b' ORDER BY id);
    SELECT group_concat(id) FROM (SELECT id FROM tg NOT INDEXED WHERE v > 'b' ORDER BY id);
}
expect {
    1,3
    1,3
}

# An expression index and a partial index compute their expression from the
# DECODEd column values, as the query does, unless the type has an operator
# function: then the query calls the function and a write does not.
@requires strict "uses STRICT tables"
test uuid-expression-and-partial-index-same-rows-with-and-without-index {
    CREATE TABLE t(id INTEGER PRIMARY KEY, u uuid, k INTEGER) STRICT;
    INSERT INTO t VALUES (1, 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', 1), (2, '00000000-0000-4000-8000-000000000001', 2);
    CREATE INDEX t_lu ON t(lower(u));
    CREATE INDEX t_k_part ON t(k) WHERE u > 'b';
    INSERT INTO t VALUES (3, 'ffffffff-0000-4000-8000-000000000001', 3);
    UPDATE t SET u = 'cccccccc-0000-4000-8000-000000000001' WHERE id = 2;
    EXPLAIN QUERY PLAN SELECT id FROM t WHERE lower(u) >= 'b';
    EXPLAIN QUERY PLAN SELECT id FROM t WHERE k > 0 AND u > 'b';
    SELECT group_concat(id) FROM (SELECT id FROM t WHERE lower(u) >= 'b' ORDER BY id);
    SELECT group_concat(id) FROM (SELECT id FROM t NOT INDEXED WHERE lower(u) >= 'b' ORDER BY id);
    SELECT group_concat(id) FROM (SELECT id FROM t WHERE k > 0 AND u > 'b' ORDER BY id);
    SELECT group_concat(id) FROM (SELECT id FROM t NOT INDEXED WHERE k > 0 AND u > 'b' ORDER BY id);
}
expect {
    1|0|0|SEARCH t USING INDEX t_lu (lower (u)>=?)
    1|0|0|SEARCH t USING COVERING INDEX t_k_part (k>?)
    2,3
    2,3
    2,3
    2,3
}

@requires strict "uses STRICT tables"
test decode-to-another-value-expression-and-partial-index-same-rows-with-and-without-index {
    CREATE TYPE ci(value text) BASE text ENCODE value DECODE lower(value) OPERATOR '<';
    CREATE TABLE c(id INTEGER PRIMARY KEY, v ci, k INTEGER) STRICT;
    INSERT INTO c VALUES (1, 'XYZ', 1), (2, 'abc', 2);
    CREATE INDEX c_part ON c(k) WHERE v = 'abc';
    CREATE INDEX c_expr ON c(v || 'x');
    UPDATE c SET v = 'ABC' WHERE id = 1;
    INSERT INTO c VALUES (3, 'AbC', 3);
    EXPLAIN QUERY PLAN SELECT id FROM c WHERE k > 0 AND v = 'abc';
    EXPLAIN QUERY PLAN SELECT id FROM c WHERE v || 'x' = 'abcx';
    SELECT group_concat(id) FROM (SELECT id FROM c WHERE k > 0 AND v = 'abc' ORDER BY id);
    SELECT group_concat(id) FROM (SELECT id FROM c NOT INDEXED WHERE k > 0 AND v = 'abc' ORDER BY id);
    SELECT group_concat(id) FROM (SELECT id FROM c WHERE v || 'x' = 'abcx' ORDER BY id);
    SELECT group_concat(id) FROM (SELECT id FROM c NOT INDEXED WHERE v || 'x' = 'abcx' ORDER BY id);
}
expect {
    1|0|0|SEARCH c USING COVERING INDEX c_part (k>?)
    1|0|0|SEARCH c USING INDEX c_expr (v || 'x'=?)
    1,2,3
    1,2,3
    1,2,3
    1,2,3
}

# --- arrays compare element by element, the index compares the record blob ---

@requires strict "uses STRICT tables"
test array-same-rows-with-and-without-index {
    CREATE TABLE r(id INTEGER PRIMARY KEY, a integer[]) STRICT;
    CREATE INDEX r_a ON r(a);
    INSERT INTO r VALUES (1, ARRAY[10]), (2, ARRAY[9]), (3, ARRAY[1, 2]), (4, ARRAY[300]), (5, ARRAY[-1]);
    SELECT group_concat(id) FROM (SELECT id FROM r ORDER BY a);
    SELECT group_concat(id) FROM (SELECT id FROM r NOT INDEXED ORDER BY a);
    SELECT group_concat(id) FROM (SELECT id FROM r WHERE a > ARRAY[5] ORDER BY id);
    SELECT group_concat(id) FROM (SELECT id FROM r NOT INDEXED WHERE a > ARRAY[5] ORDER BY id);
}
expect {
    5,3,2,1,4
    5,3,2,1,4
    1,2,4
    1,2,4
}

# --- a covering index read never sees a missing column ---

@requires strict "uses STRICT tables"
test covering-index-read-of-column-with-default {
    CREATE TABLE cd(id INTEGER PRIMARY KEY, a INTEGER, ts timestamp DEFAULT '2000-01-01') STRICT;
    CREATE INDEX cd_ts ON cd(ts);
    INSERT INTO cd(id, a, ts) VALUES (1, 1, '2025-05-05 10:00:00');
    SELECT id, ts FROM cd WHERE ts = '2025-05-05 10:00:00';
    SELECT id, ts FROM cd NOT INDEXED WHERE ts = '2025-05-05 10:00:00';
    SELECT max(ts) FROM cd;
}
expect {
    1|2025-05-05 10:00:00
    1|2025-05-05 10:00:00
    2025-05-05 10:00:00
}
