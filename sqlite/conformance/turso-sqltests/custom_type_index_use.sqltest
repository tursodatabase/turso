# --- IN (SELECT ...): the IN seek uses only a Plain column ---

@requires strict "uses STRICT tables"
@setup uuids
test uuid-in-subquery-same-rows-with-and-without-index {
    CREATE TABLE s(x TEXT) STRICT;
    INSERT INTO s VALUES ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'), ('00000000-0000-4000-8000-000000000001'), ('FFFFFFFF-FFFF-4FFF-BFFF-FFFFFFFFFFFF'), ('junk'), (NULL);
    SELECT group_concat(id) FROM (SELECT id FROM u WHERE v IN (SELECT x FROM s) ORDER BY id);
    SELECT group_concat(id) FROM (SELECT id FROM u NOT INDEXED WHERE v IN (SELECT x FROM s) ORDER BY id);
    SELECT group_concat(id) FROM (SELECT id FROM u WHERE v NOT IN (SELECT x FROM s WHERE x IS NOT NULL) ORDER BY id);
    SELECT group_concat(id) FROM (SELECT id FROM u NOT INDEXED WHERE v NOT IN (SELECT x FROM s WHERE x IS NOT NULL) ORDER BY id);
}
expect {
    1,2
    1,2
    3,5
    3,5
}

@requires strict "uses STRICT tables"
test decode-to-another-value-in-subquery-same-rows-with-and-without-index {
    CREATE TYPE ci(value text) BASE text ENCODE value DECODE lower(value) OPERATOR '<';
    CREATE TABLE c(id INTEGER PRIMARY KEY, v ci) STRICT;
    CREATE INDEX c_v ON c(v);
    INSERT INTO c VALUES (1, 'ABC'), (2, 'abc'), (3, 'xyz');
    CREATE TABLE s(x TEXT) STRICT;
    INSERT INTO s VALUES ('abc'), ('XYZ');
    SELECT group_concat(id) FROM (SELECT id FROM c WHERE v IN (SELECT x FROM s) ORDER BY id);
    SELECT group_concat(id) FROM (SELECT id FROM c NOT INDEXED WHERE v IN (SELECT x FROM s) ORDER BY id);
}
expect {
    1,2
    1,2
}

