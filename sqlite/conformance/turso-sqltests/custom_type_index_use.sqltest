    EXPLAIN QUERY PLAN SELECT kt.id, ev.id FROM kt CROSS JOIN ev ON ev.ts > kt.d;
    EXPLAIN QUERY PLAN SELECT kt_plain.id, ev_plain.id FROM kt_plain JOIN ev_plain ON ev_plain.ts = kt_plain.d;
}
