    2|0|0|SEARCH ev USING COVERING INDEX ev_ts (ts=?)
    1|0|0|SCAN kt
    2|0|0|SEARCH ev USING COVERING INDEX ev_ts (ts>?)
    1|0|0|HASH JOIN ev_plain
    2|0|0|SCAN kt_plain
}

@requires strict "uses STRICT tables"
@setup join_keys
test timestamp-join-same-rows-in-every-plan {
    SELECT group_concat(pair) FROM (SELECT kt.id || ':' || ev.id AS pair FROM kt CROSS JOIN ev ON ev.ts = kt.d ORDER BY 1);
    SELECT group_concat(pair) FROM (SELECT kt.id || ':' || ev.id AS pair FROM kt CROSS JOIN ev NOT INDEXED ON ev.ts = kt.d ORDER BY 1);
    SELECT group_concat(pair) FROM (SELECT kt.id || ':' || ev.id AS pair FROM ev CROSS JOIN kt ON kt.d = ev.ts ORDER BY 1);
    SELECT group_concat(pair) FROM (SELECT kt_plain.id || ':' || ev_plain.id AS pair FROM kt_plain JOIN ev_plain ON ev_plain.ts = kt_plain.d ORDER BY 1);
    SELECT group_concat(pair) FROM (SELECT kt.id || ':' || ev.id AS pair FROM kt CROSS JOIN ev ON ev.ts > kt.d ORDER BY 1);
    SELECT group_concat(pair) FROM (SELECT kt.id || ':' || ev.id AS pair FROM kt CROSS JOIN ev NOT INDEXED ON ev.ts > kt.d ORDER BY 1);
    SELECT group_concat(pair) FROM (SELECT kt.id || ':' || ev.id AS pair FROM ev CROSS JOIN kt ON kt.d < ev.ts ORDER BY 1);
}
expect {
    2:2
    2:2
    2:2
    2:2
    1:1,1:2
    1:1,1:2
    1:1,1:2
}

