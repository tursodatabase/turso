    SELECT group_concat(id) FROM (SELECT id FROM pt NOT INDEXED WHERE k = 1 AND n < 100 ORDER BY id);
    SELECT group_concat(id) FROM (SELECT id FROM pt WHERE k = 1 AND n > 0 ORDER BY id);
    SELECT group_concat(id) FROM (SELECT id FROM pt NOT INDEXED WHERE k = 1 AND n > 0 ORDER BY id);
}
expect {
    1,2,3
    1,2,3
    2
    2
}

