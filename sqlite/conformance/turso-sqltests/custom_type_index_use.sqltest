# --- numeric: only equality seeks, and the term stays as a filter ---
# The comparison functions of numeric read the other operand as the value
# that the user wrote: a literal, a negative literal, a parameter or an
# expression.

@requires strict "uses STRICT tables"
@setup numerics
test numeric-literal-equality-uses-index {
    EXPLAIN QUERY PLAN SELECT id FROM p WHERE n = 12.5;
}
expect {
    1|0|0|SEARCH p USING COVERING INDEX p_n (n=?)
}

@requires strict "uses STRICT tables"
@setup numerics
test numeric-equality-same-rows-with-and-without-index {
    SELECT id FROM p WHERE n = 12.5;
    SELECT id FROM p NOT INDEXED WHERE n = 12.5;
    SELECT id FROM p WHERE n = '12.50';
    SELECT id FROM p NOT INDEXED WHERE n = '12.50';
    SELECT count(*) FROM p WHERE n = -1.5;
    SELECT count(*) FROM p NOT INDEXED WHERE n = -1.5;
    SELECT id FROM p WHERE n = '-1.50';
    SELECT id FROM p NOT INDEXED WHERE n = '-1.50';
}
expect {
    1
    1
    1
    1
    1
    1
    2
    2
}

