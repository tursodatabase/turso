@database :temp:

test vacuum-nonexistent-schema {
    VACUUM nonexistent INTO 'out.db';
}
expect error {
    no such database: nonexistent
}

@skip-if mvcc "plain VACUUM requires PRAGMA wal_checkpoint(TRUNCATE) first on an MVCC database"
test vacuum-preserves-user-sequence {
    CREATE SEQUENCE s START WITH 1 INCREMENT BY 1;
    SELECT nextval('s');
    SELECT nextval('s');
    VACUUM;
    PRAGMA integrity_check;
    SELECT nextval('s');
}
expect {
    1
    2
    ok
    3
}

test vacuum-rejects-query-only {
    CREATE TABLE t(a INTEGER);
    PRAGMA query_only = 1;
    VACUUM;
}
expect error {
    Cannot execute VACUUM in query_only mode
}

@skip-if mvcc "plain VACUUM requires PRAGMA wal_checkpoint(TRUNCATE) first on an MVCC database"
@requires strict "uses STRICT tables"
@requires custom_types "uses custom types"
test vacuum-keeps-pg-storage-tables {
    CREATE TYPE mood(value text) BASE text ENCODE CASE WHEN value IN ('sad', 'ok') THEN value ELSE RAISE(ABORT, 'invalid mood') END DECODE value;
    CREATE TABLE p(id INTEGER PRIMARY KEY, n numeric(10,2), m mood) STRICT, PGSTORAGE;
    INSERT INTO p VALUES (1, 2.5, 'ok');
    VACUUM;
    PRAGMA integrity_check;
    SELECT sql FROM sqlite_schema WHERE name = 'p';
    SELECT id, n, m FROM p;
}
expect {
    ok
    CREATE TABLE p (id INTEGER PRIMARY KEY, n numeric (10, 2), m mood) STRICT, PGSTORAGE
    1|2.50|ok
}
