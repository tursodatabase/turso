@database :memory:

# DDL statements inside BEGIN CONCURRENT transparently upgrade the
# transaction to exclusive instead of failing.

test mvcc-create-table-in-begin-concurrent {
    PRAGMA journal_mode = 'mvcc';
    BEGIN CONCURRENT;
    CREATE TABLE t5(x);
    INSERT INTO t5 VALUES (1);
    COMMIT;
    SELECT * FROM t5;
}
expect {
    mvcc
    1
}

test mvcc-create-index-in-begin-concurrent {
    PRAGMA journal_mode = 'mvcc';
    CREATE TABLE t6(x INTEGER);
    INSERT INTO t6 VALUES (7);
    BEGIN CONCURRENT;
    CREATE INDEX idx6 ON t6(x);
    COMMIT;
    SELECT x FROM t6 WHERE x = 7;
}
expect {
    mvcc
    7
}

test mvcc-drop-table-in-begin-concurrent {
    PRAGMA journal_mode = 'mvcc';
    CREATE TABLE t7(x);
    BEGIN CONCURRENT;
    DROP TABLE t7;
    COMMIT;
    SELECT count(*) FROM sqlite_schema WHERE name = 't7';
}
expect {
    mvcc
    0
}

test mvcc-alter-table-in-begin-concurrent {
    PRAGMA journal_mode = 'mvcc';
    CREATE TABLE t9(x);
    BEGIN CONCURRENT;
    ALTER TABLE t9 ADD COLUMN y;
    INSERT INTO t9 VALUES (1, 2);
    COMMIT;
    SELECT x, y FROM t9;
}
expect {
    mvcc
    1|2
}

test mvcc-writes-before-ddl-in-begin-concurrent {
    PRAGMA journal_mode = 'mvcc';
    CREATE TABLE t10(x);
    BEGIN CONCURRENT;
    INSERT INTO t10 VALUES (1);
    CREATE TABLE t11(y);
    INSERT INTO t11 VALUES (2);
    COMMIT;
    SELECT (SELECT x FROM t10), (SELECT y FROM t11);
}
expect {
    mvcc
    1|2
}

test mvcc-ddl-rollback-in-begin-concurrent {
    PRAGMA journal_mode = 'mvcc';
    BEGIN CONCURRENT;
    CREATE TABLE t12(x);
    ROLLBACK;
    SELECT count(*) FROM sqlite_schema WHERE name = 't12';
}
expect {
    mvcc
    0
}

test mvcc-analyze-in-begin-concurrent {
    PRAGMA journal_mode = 'mvcc';
    CREATE TABLE t24(x);
    INSERT INTO t24 VALUES (1);
    BEGIN CONCURRENT;
    ANALYZE;
    COMMIT;
    SELECT count(*) FROM sqlite_stat1 WHERE tbl = 't24';
}
expect {
    mvcc
    1
}

test mvcc-ddl-works-in-exclusive-transaction {
    PRAGMA journal_mode = 'mvcc';
    BEGIN;
    CREATE TABLE t8(x INTEGER);
    INSERT INTO t8 VALUES (42);
    COMMIT;
    SELECT * FROM t8;
}
expect {
    mvcc
    42
}

test mvcc-savepoint-rollback-undoes-ddl-upgrade {
    PRAGMA journal_mode = 'mvcc';
    CREATE TABLE t20(x);
    BEGIN CONCURRENT;
    INSERT INTO t20 VALUES (1);
    SAVEPOINT sp;
    CREATE TABLE u20(y);
    INSERT INTO u20 VALUES (2);
    ROLLBACK TO sp;
    COMMIT;
    SELECT (SELECT count(*) FROM t20),
           (SELECT count(*) FROM sqlite_schema WHERE name = 'u20');
}
expect {
    mvcc
    1|0
}

test mvcc-savepoint-release-keeps-ddl-upgrade {
    PRAGMA journal_mode = 'mvcc';
    BEGIN CONCURRENT;
    SAVEPOINT sp;
    CREATE TABLE u21(y);
    INSERT INTO u21 VALUES (3);
    RELEASE sp;
    COMMIT;
    SELECT y FROM u21;
}
expect {
    mvcc
    3
}

test mvcc-savepoint-rollback-then-recreate-ddl {
    PRAGMA journal_mode = 'mvcc';
    BEGIN CONCURRENT;
    SAVEPOINT sp;
    CREATE TABLE u22(y);
    ROLLBACK TO sp;
    CREATE TABLE u22(y, z);
    INSERT INTO u22 VALUES (4, 5);
    COMMIT;
    SELECT y, z FROM u22;
}
expect {
    mvcc
    4|5
}

test mvcc-savepoint-rollback-undoes-index-ddl {
    PRAGMA journal_mode = 'mvcc';
    CREATE TABLE t23(x);
    INSERT INTO t23 VALUES (6);
    BEGIN CONCURRENT;
    SAVEPOINT sp;
    CREATE INDEX idx23 ON t23(x);
    ROLLBACK TO sp;
    COMMIT;
    SELECT (SELECT count(*) FROM sqlite_schema WHERE name = 'idx23'),
           (SELECT x FROM t23);
}
expect {
    mvcc
    0|6
}

# BEGIN CONCURRENT is deferred: BEGIN itself opens nothing, an empty
# transaction commits cleanly, and a nested BEGIN gets the standard error.

test mvcc-begin-concurrent-idle-commit {
    PRAGMA journal_mode = 'mvcc';
    BEGIN CONCURRENT;
    COMMIT;
    SELECT 1;
}
expect {
    mvcc
    1
}

test mvcc-begin-concurrent-after-begin-errors {
    PRAGMA journal_mode = 'mvcc';
    BEGIN;
    BEGIN CONCURRENT;
}
expect error {
    cannot start a transaction within a transaction
}

test mvcc-begin-after-begin-concurrent-errors {
    PRAGMA journal_mode = 'mvcc';
    BEGIN CONCURRENT;
    BEGIN;
}
expect error {
    cannot start a transaction within a transaction
}
