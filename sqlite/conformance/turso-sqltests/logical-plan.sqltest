@database :memory:

setup tables {
    PRAGMA unstable_logical_plan = 1;
    CREATE TABLE t1(a INTEGER PRIMARY KEY, b);
    CREATE TABLE t2(a, b);
    CREATE INDEX i1 ON t2(a);
    CREATE VIEW v1 AS SELECT a, b FROM t2;
    INSERT INTO t1 VALUES (1, 10), (2, 20), (3, NULL);
    INSERT INTO t2 VALUES (1, 100), (1, 200), (2, 300), (NULL, 400);
}

@setup tables
test flatten-derived-table-uses-index {
    EXPLAIN QUERY PLAN SELECT * FROM (SELECT a, b FROM t2) s WHERE s.a = 1;
}
expect {
    1|0|0|SEARCH t2 USING INDEX i1 (a=?)
}

@setup tables
test flatten-view-uses-index {
    EXPLAIN QUERY PLAN SELECT * FROM v1 WHERE a = 1;
}
expect {
    1|0|0|SEARCH t2 USING INDEX i1 (a=?)
}

@setup tables
test flatten-cte-uses-index {
    EXPLAIN QUERY PLAN WITH c AS (SELECT a, b FROM t2) SELECT * FROM c WHERE a = 1;
}
expect {
    1|0|0|SEARCH t2 USING INDEX i1 (a=?)
}

@setup tables
test flatten-derived-table-rows {
    SELECT s.a, s.b FROM (SELECT a, b FROM t2 WHERE b > 100) s WHERE s.a = 1 ORDER BY s.b;
    SELECT s.n FROM (SELECT a + b AS n FROM t2) s WHERE s.n IS NOT NULL ORDER BY s.n;
}
expect {
    1|200
    101
    201
    302
}

@setup tables
test unnest-correlated-count {
    SELECT a, (SELECT count(*) FROM t2 WHERE t2.a = t1.a) FROM t1 ORDER BY a;
    SELECT a, (SELECT count(*) FROM t2 WHERE t2.a = t1.a OR t2.b < t1.b * 20) FROM t1 ORDER BY a;
}
expect {
    1|2
    2|1
    3|0
    1|2
    2|3
    3|0
}

@setup tables
test unnest-correlated-average-in-where {
    SELECT a FROM t1 WHERE b * 10 < (SELECT avg(b) FROM t2 WHERE t2.a = t1.a) ORDER BY a;
}
expect {
    1
    2
}
