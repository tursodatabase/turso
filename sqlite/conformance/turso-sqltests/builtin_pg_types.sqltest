@requires strict "uses STRICT tables"
test numeric-input-ignores-surrounding-whitespace {
    -- As in PostgreSQL, spaces, tabs and newlines around the number are
    -- skipped, and text equal to a stored value apart from them compares equal.
    CREATE TABLE t1(id INTEGER PRIMARY KEY, val numeric(10,2)) STRICT;
    INSERT INTO t1 VALUES (1, ' 1.5 '), (2, char(9) || '2' || char(10));
    SELECT id, val FROM t1 ORDER BY id;
    SELECT id FROM t1 WHERE val = ' 2 ';
    SELECT val + ' 1' FROM t1 WHERE id = 1;
}
expect {
    1|1.50
    2|2.00
    2
    2.50
}

@requires strict "uses STRICT tables"
test numeric-limits-apply-to-the-value-not-the-text {
    -- Zero has no digits, whatever its exponent, and leading zeros are not
    -- digits of the value: PostgreSQL accepts both.
    CREATE TABLE t1(val numeric(10,2)) STRICT;
    INSERT INTO t1 VALUES ('0e131073'), ('-0.0e200000');
    SELECT val FROM t1;
    SELECT val + '0e999999999', val + (hex(zeroblob(150000)) || '1') FROM t1 LIMIT 1;
}
expect {
    0.00
    0.00
    0.00|1.00
}

@requires strict "uses STRICT tables"
test numeric-limits-refuse-zero-with-too-many-decimals {
    CREATE TABLE t1(val numeric(10,2)) STRICT;
    INSERT INTO t1 VALUES (1);
    SELECT val + '0e-20000' FROM t1;
}
expect error {
    value overflows numeric format
}

@requires strict "uses STRICT tables"
test numeric-input-rejects-space-inside-the-number {
    CREATE TABLE t1(val numeric(10,2)) STRICT;
    INSERT INTO t1 VALUES ('1 .5');
}
expect error {
    invalid input syntax for type numeric: "1 .5"
}

@requires strict "uses STRICT tables"
test varchar-compare-with-longer-literal-with-and-without-index {
    CREATE TABLE t1(v varchar(3)) STRICT;
    CREATE TABLE t2(v varchar(3)) STRICT;
    CREATE INDEX t2_v ON t2(v);
    INSERT INTO t1 VALUES ('abc');
    INSERT INTO t2 VALUES ('abc');
    SELECT
        (SELECT count(*) FROM t1 WHERE v = 'abcd'),
        (SELECT count(*) FROM t2 WHERE v = 'abcd'),
        (SELECT count(*) FROM t1 WHERE v < 'abcd'),
        (SELECT count(*) FROM t2 WHERE v < 'abcd');
}
expect {
    0|0|1|1
}

@requires strict "uses STRICT tables"
test date-compare-with-other-text-with-and-without-index {
    CREATE TABLE a(d date) STRICT;
    CREATE TABLE b(d date) STRICT;
    CREATE INDEX b_d ON b(d);
    INSERT INTO a VALUES ('2026-10-08');
    INSERT INTO b VALUES ('2026-10-08');
    SELECT
        (SELECT count(*) FROM a WHERE d = 'zzz'),
        (SELECT count(*) FROM b WHERE d = 'zzz'),
        (SELECT count(*) FROM a WHERE d = '2026-10-08T00:00'),
        (SELECT count(*) FROM b WHERE d = '2026-10-08T00:00'),
        (SELECT count(*) FROM a WHERE d IN ('zzz', '2026-10-08')),
        (SELECT count(*) FROM b WHERE d IN ('zzz', '2026-10-08'));
}
expect {
    0|0|0|0|1|1
}

@requires strict "uses STRICT tables"
test timestamp-compare-with-other-text-with-and-without-index {
    CREATE TABLE t1(ts timestamp) STRICT;
    CREATE TABLE t2(ts timestamp) STRICT;
    CREATE INDEX t2_ts ON t2(ts);
    INSERT INTO t1 VALUES ('2026-10-08 12:00:00');
    INSERT INTO t2 VALUES ('2026-10-08 12:00:00');
    SELECT
        (SELECT count(*) FROM t1 WHERE ts = '2026-10-08T12:00:00'),
        (SELECT count(*) FROM t2 WHERE ts = '2026-10-08T12:00:00'),
        (SELECT count(*) FROM t1 WHERE ts >= '2026-10-08T12:00'),
        (SELECT count(*) FROM t2 WHERE ts >= '2026-10-08T12:00');
}
expect {
    0|0|0|0
}
