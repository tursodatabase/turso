    CREATE TABLE t1(val numeric(5,2)) STRICT;
    INSERT INTO t1 VALUES ('12345.67');
}
expect error {
}

# Extra fractional digits round half away from zero, like PostgreSQL.
@requires strict "uses STRICT tables"
test numeric-insert-rounds-extra-digits {
    CREATE TABLE t1(id INTEGER PRIMARY KEY, val numeric(10,2)) STRICT;
    INSERT INTO t1 VALUES (1, 0.019), (2, 0.015), (3, 1.999), (4, '0.019'), (5, -0.015), (6, '-1.994');
    SELECT id, val FROM t1;
}
expect {
    1|0.02
    2|0.02
    3|2.00
    4|0.02
    5|-0.02
    6|-1.99
}

@requires strict "uses STRICT tables"
test numeric-update-rounds-extra-digits {
    CREATE TABLE t1(val numeric(10,2)) STRICT;
    INSERT INTO t1 VALUES ('1.00');
    UPDATE t1 SET val = '2.345';
    SELECT val FROM t1;
}
expect {
    2.35
}

@requires strict "uses STRICT tables"
test numeric-cast-rounds-extra-digits {
    SELECT numeric_decode(CAST(0.019 AS numeric(10,2))), numeric_decode(CAST('-2.345' AS numeric(10,2)));
}
expect {
    0.02|-2.35
}

# Rounding up can add a digit to the left of the decimal point.
@requires strict "uses STRICT tables"
test numeric-rounding-overflows-precision {
    CREATE TABLE t1(val numeric(3,2)) STRICT;
    INSERT INTO t1 VALUES ('9.999');
}
expect error {
}

