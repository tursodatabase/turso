    INSERT INTO t1 VALUES (1, '1.50');
    INSERT INTO t1 VALUES (2, '-7.25');
    INSERT INTO t1 VALUES (3, NULL);
    SELECT id, -val FROM t1 ORDER BY id;
}
expect {
    1|-1.50
    2|7.25
    3|
}

