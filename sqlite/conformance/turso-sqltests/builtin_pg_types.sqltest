@requires strict "uses STRICT tables"
test smallint-compared-with-integer-out-of-its-range {
    -- The range limits what a column stores, not what it is compared with.
    CREATE TABLE t1(val smallint) STRICT;
    INSERT INTO t1 VALUES (5);
    SELECT val FROM t1 WHERE val < 100000;
    SELECT val FROM t1 WHERE val IN (5, 100000);
    SELECT val = 100000 FROM t1;
}
expect {
    5
    5
    0
}

@requires strict "uses STRICT tables"
test smallint-update-overflow {
    CREATE TABLE t1(val smallint) STRICT;
    INSERT INTO t1 VALUES (5);
    UPDATE t1 SET val = 40000;
}
expect error {
    integer out of range for smallint
}

test smallint-cast-out-of-range {
    SELECT CAST(100000 AS smallint);
}
expect error {
    integer out of range for smallint
}

# A CAST to a domain stores the value as the domain's base type does, so
# smallint's range check runs.
test smallint-cast-to-domain-out-of-range {
    CREATE DOMAIN small_pos AS smallint CHECK (value > 0);
    SELECT CAST(100000 AS small_pos);
}
expect error {
    integer out of range for smallint
}

