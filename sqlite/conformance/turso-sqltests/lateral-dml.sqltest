@database :memory:

# LATERAL subqueries in INSERT, UPDATE, DELETE, RETURNING, views,
# triggers and after ALTER TABLE ... RENAME.
# The statements run only through the SQLite frontend.
# Tests with the same SQL for both frontends are in
# testing/shared-sqltests/lateral-dml.sqltest.

setup data {
    CREATE TABLE t1(a INT, b TEXT);
    CREATE TABLE t2(a INT, c INT, d TEXT);
    CREATE TABLE t4(a INT PRIMARY KEY, v INT);
    INSERT INTO t1 VALUES (1, 'p'), (2, 'q'), (3, 'r'), (4, 's');
    INSERT INTO t2 VALUES (1, 10, 'x'), (2, 20, 'y'), (2, 30, 'z'), (3, 40, 'w'), (5, 50, 'v');
    INSERT INTO t4 VALUES (1, 0), (2, 0), (3, 0), (4, 0);
}

setup log {
    CREATE TABLE log(a INT, c INT);
}

@setup data
@setup log
test trigger-inserts-with-lateral-that-reads-new {
    CREATE TRIGGER tr1 AFTER INSERT ON t4 BEGIN INSERT INTO log SELECT NEW.a, s.c FROM LATERAL (SELECT c FROM t2 WHERE t2.a = NEW.a) AS s; END;
    INSERT INTO t4 VALUES (5, 0);
    DELETE FROM t2 WHERE a = 5;
    INSERT INTO t2 VALUES (6, 60, 'u'), (6, 61, 'u');
    INSERT INTO t4 VALUES (6, 0);
    SELECT a, c FROM log ORDER BY 1, 2;
}
expect {
    5|50
    6|60
    6|61
}

@setup data
@setup log
test trigger-inserts-with-table-and-lateral-that-reads-new {
    CREATE TRIGGER tr1 AFTER INSERT ON t4 BEGIN INSERT INTO log SELECT t1.a, s.v FROM t1, LATERAL (SELECT t1.a * 100 + NEW.v AS v) AS s WHERE t1.a <= NEW.a; END;
    INSERT INTO t4 VALUES (6, 7);
    SELECT a, c FROM log ORDER BY 1, 2;
}
expect {
    1|107
    2|207
    3|307
    4|407
}

@setup data
@setup log
test trigger-on-update-with-lateral-that-reads-old-and-new {
    CREATE TRIGGER tr1 AFTER UPDATE ON t4 BEGIN INSERT INTO log SELECT s.x, s.y FROM LATERAL (SELECT OLD.v AS x, NEW.v + count(*) AS y FROM t2 WHERE t2.a = NEW.a) AS s; END;
    UPDATE t4 SET v = 10 WHERE a IN (2, 4);
    SELECT a, c FROM log ORDER BY 1, 2;
}
expect {
    0|10
    0|12
}

@setup data
@setup log
test trigger-on-delete-with-left-join-lateral-that-reads-old {
    CREATE TRIGGER tr1 AFTER DELETE ON t4 BEGIN INSERT INTO log SELECT OLD.a, s.c FROM (SELECT 1 AS one) AS z LEFT JOIN LATERAL (SELECT c FROM t2 WHERE t2.a = OLD.a) AS s ON true; END;
    DELETE FROM t4 WHERE a >= 3;
    SELECT a, c FROM log ORDER BY 1, 2 NULLS FIRST;
}
expect {
    3|40
    4|
}

@setup data
@setup log
test trigger-updates-with-lateral-subquery {
    CREATE TRIGGER tr1 AFTER INSERT ON log BEGIN UPDATE t4 SET v = (SELECT sum(s.c) FROM LATERAL (SELECT c FROM t2 WHERE t2.a = t4.a) AS s) WHERE t4.a = NEW.a; END;
    INSERT INTO log VALUES (2, 0);
    INSERT INTO log VALUES (4, 0);
    SELECT a, v FROM t4 ORDER BY 1;
}
expect {
    1|0
    2|50
    3|0
    4|
}

@setup data
test rename-left-column-read-by-a-view-updates-the-schema {
    CREATE VIEW v1 AS SELECT t1.a, s.c FROM t1, LATERAL (SELECT c FROM t2 WHERE t2.a = t1.a) AS s;
    ALTER TABLE t1 RENAME COLUMN a TO k;
    SELECT count(*) FROM sqlite_schema WHERE name = 'v1' AND sql LIKE '%t2.a = t1.k%' AND sql NOT LIKE '%t1.a%';
}
expect {
    1
}

@setup data
test rename-inner-column-read-by-a-view-updates-the-schema {
    CREATE VIEW v1 AS SELECT t1.a, s.c FROM t1, LATERAL (SELECT c FROM t2 WHERE t2.a = t1.a) AS s;
    ALTER TABLE t2 RENAME COLUMN a TO k;
    SELECT count(*) FROM sqlite_schema WHERE name = 'v1' AND sql LIKE '%t2.k = t1.a%' AND sql NOT LIKE '%t2.a%';
}
expect {
    1
}

@setup data
test rename-column-read-by-a-nested-lateral-in-a-view {
    CREATE VIEW v1 AS SELECT t1.a, s.v FROM t1, LATERAL (SELECT u.v FROM t2, LATERAL (SELECT t2.c + t1.a AS v) AS u WHERE t2.a = t1.a) AS s;
    ALTER TABLE t1 RENAME COLUMN a TO k;
    ALTER TABLE t2 RENAME COLUMN c TO m;
    SELECT * FROM v1 ORDER BY 1, 2;
}
expect {
    1|11
    2|22
    2|32
    3|43
}

@setup data
test rename-column-read-by-a-nested-lateral-updates-the-schema {
    CREATE VIEW v1 AS SELECT t1.a, s.v FROM t1, LATERAL (SELECT u.v FROM t2, LATERAL (SELECT t2.c + t1.a AS v) AS u WHERE t2.a = t1.a) AS s;
    ALTER TABLE t1 RENAME COLUMN a TO k;
    ALTER TABLE t2 RENAME COLUMN c TO m;
    SELECT count(*) FROM sqlite_schema WHERE name = 'v1' AND sql LIKE '%t2.m + t1.k%' AND sql NOT LIKE '%t1.a%' AND sql NOT LIKE '%t2.c%';
}
expect {
    1
}

@setup data
test rename-aliased-left-column-read-by-a-view {
    CREATE VIEW v1 AS SELECT x.b, s.n FROM t1 AS x, LATERAL (SELECT count(*) AS n FROM t2 WHERE t2.a = x.a) AS s;
    ALTER TABLE t1 RENAME COLUMN a TO k;
    SELECT * FROM v1 ORDER BY 1;
}
expect {
    p|1
    q|2
    r|1
    s|0
}

@setup data
@setup log
test rename-column-read-by-a-lateral-in-a-trigger {
    CREATE TRIGGER tr1 AFTER INSERT ON t4 BEGIN INSERT INTO log SELECT x.a, s.c FROM t1 AS x, LATERAL (SELECT c FROM t2 WHERE t2.a = x.a) AS s WHERE x.a = NEW.a; END;
    ALTER TABLE t1 RENAME COLUMN a TO k;
    INSERT INTO t4 VALUES (5, 0);
    INSERT INTO t1 VALUES (5, 'z');
    INSERT INTO t4 VALUES (6, 0);
    DELETE FROM t4 WHERE a = 2;
    INSERT INTO t4 VALUES (2, 0);
    SELECT a, c FROM log ORDER BY 1, 2;
}
expect {
    2|20
    2|30
}

@setup data
@setup log
test rename-column-read-unqualified-by-a-lateral-next-to-a-subquery-in-a-trigger {
    CREATE TRIGGER tr1 AFTER INSERT ON t4 BEGIN INSERT INTO log SELECT s.a, s.c FROM t1, LATERAL (SELECT a AS y) AS l, (SELECT a, c FROM t2) AS s WHERE l.y = s.a AND s.a = NEW.a; END;
    ALTER TABLE t1 RENAME COLUMN a TO k;
    DELETE FROM t4 WHERE a = 2;
    INSERT INTO t4 VALUES (2, 0);
    SELECT a, c FROM log ORDER BY 1, 2;
    SELECT count(*) FROM sqlite_schema WHERE name = 'tr1' AND sql LIKE '%SELECT k AS y%' AND sql LIKE '%SELECT a, c FROM t2%';
}
expect {
    2|20
    2|30
    1
}

@setup data
@setup log
test rename-inner-column-with-an-alias-read-by-a-lateral-in-a-trigger {
    CREATE TRIGGER tr1 AFTER INSERT ON t4 BEGIN INSERT INTO log SELECT NEW.a, s.c FROM LATERAL (SELECT c AS c FROM t2 WHERE t2.a = NEW.a) AS s; END;
    ALTER TABLE t2 RENAME COLUMN c TO m;
    DELETE FROM t4 WHERE a = 2;
    INSERT INTO t4 VALUES (2, 0);
    SELECT a, c FROM log ORDER BY 1, 2;
}
expect {
    2|20
    2|30
}

@setup data
@setup log
test rename-new-column-read-by-a-lateral-in-a-trigger {
    CREATE TRIGGER tr1 AFTER INSERT ON t4 BEGIN INSERT INTO log SELECT NEW.a, s.c FROM LATERAL (SELECT c FROM t2 WHERE t2.a = NEW.a) AS s; END;
    ALTER TABLE t4 RENAME COLUMN a TO k;
    DELETE FROM t4 WHERE k = 3;
    INSERT INTO t4 VALUES (5, 0);
    INSERT INTO t4 VALUES (3, 1);
    SELECT a, c FROM log ORDER BY 1, 2;
}
expect {
    3|40
    5|50
}

@setup data
test update-from-with-left-join-lateral {
    UPDATE t4 SET v = coalesce(s.c, -1) FROM t1 LEFT JOIN LATERAL (SELECT max(c) AS c FROM t2 WHERE t2.a = t1.a HAVING count(*) > 1) AS s ON true WHERE t1.a = t4.a;
    SELECT a, v FROM t4 ORDER BY 1;
}
expect {
    1|-1
    2|30
    3|-1
    4|-1
}
