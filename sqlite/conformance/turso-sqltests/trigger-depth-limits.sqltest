@database :memory:
@skip-file-if debug "the chains at the trigger depth limit overflow the stack of a debug build"

# Chains of triggers and of foreign key actions at the trigger depth limit of
# Turso: 1000 levels, as SQLITE_MAX_TRIGGER_DEPTH in SQLite. Each level is a
# nested program, and its compilation recurses one time for each level, through
# the translator and the emitter of the statement of the trigger body or of the
# foreign key action. If a stack frame on one of these paths becomes larger, a
# chain at the limit can overflow the stack.
#
# The tests run only on the CLI backend, in a tursodb process that has the
# main-thread stack of the runner: 8 MiB in CI. A stack overflow then stops only
# that process. The file is skipped in a debug build, because debug frames are
# much larger.

# t0 to t1000, and a chain of AFTER INSERT, AFTER UPDATE and AFTER DELETE
# triggers. The trigger on t<i> changes t<i + 1>. The setup inserts one row
# into t0 while only the AFTER INSERT triggers exist, so the INSERT chain puts
# one row into each table.

setup trigger_chain {
    CREATE TABLE t0(x);
    CREATE TABLE t1(x);
    CREATE TABLE t2(x);
    CREATE TABLE t3(x);
    CREATE TABLE t4(x);
    CREATE TABLE t5(x);
    CREATE TABLE t6(x);
