# t0 to t1000, each with one row. The key of t<i> refers to the key of
# t<i - 1>, with ON DELETE CASCADE and ON UPDATE CASCADE.

setup fk_chain {
    PRAGMA foreign_keys = ON;
    CREATE TABLE t0(k INTEGER PRIMARY KEY);
    CREATE TABLE t1(k INTEGER UNIQUE REFERENCES t0(k) ON DELETE CASCADE ON UPDATE CASCADE);
