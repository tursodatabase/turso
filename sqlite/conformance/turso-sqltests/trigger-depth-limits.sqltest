@backend cli
test update-trigger-chain-at-limit {
    UPDATE t0 SET x = 2;
    SELECT x FROM t1000;
}
expect {
    2
}

@setup trigger_chain
@backend cli
test delete-trigger-chain-at-limit {
    DELETE FROM t0;
    SELECT count(*) FROM t1000;
}
expect {
    0
}

@setup fk_chain
@backend cli
test on-delete-cascade-chain-at-limit {
    DELETE FROM t0;
    SELECT count(*) FROM t1000;
}
expect {
    0
}

@setup fk_chain
@backend cli
test on-update-cascade-chain-at-limit {
    UPDATE t0 SET k = 2;
    SELECT k FROM t1000;
}
expect {
    2
}
