@database :memory:

test alter-column-rename-and-type {
    CREATE TABLE t (a INTEGER);
    CREATE INDEX i ON t (a);
    ALTER TABLE t ALTER COLUMN a TO b BLOB;
    SELECT sql FROM sqlite_schema;
}
expect {
    CREATE TABLE t (b BLOB)
    CREATE INDEX i ON t (b)
}

test fail-alter-column-primary-key {
    CREATE TABLE t (a);
    ALTER TABLE t ALTER COLUMN a TO a PRIMARY KEY;
}
expect error {
}

test fail-alter-column-unique {
    CREATE TABLE t (a);
    ALTER TABLE t ALTER COLUMN a TO a UNIQUE;
}
expect error {
}

test alter-table-rename-pk-column {
    CREATE TABLE customers (cust_id INTEGER PRIMARY KEY, cust_name TEXT);
    INSERT INTO customers VALUES (1, 'Alice'), (2, 'Bob');

    ALTER TABLE customers RENAME COLUMN cust_id TO customer_id;

    SELECT sql FROM sqlite_schema WHERE name = 'customers';
    SELECT customer_id, cust_name FROM customers ORDER BY customer_id;
}
expect {
    CREATE TABLE customers (customer_id INTEGER PRIMARY KEY, cust_name TEXT)
    1|Alice
    2|Bob
}

test alter-table-rename-composite-pk {
    CREATE TABLE products (category TEXT, prod_code TEXT, name TEXT, PRIMARY KEY (category, prod_code));
    INSERT INTO products VALUES ('Electronics', 'E001', 'Laptop');

    ALTER TABLE products RENAME COLUMN prod_code TO product_code;

    SELECT sql FROM sqlite_schema WHERE name = 'products';
    SELECT category, product_code, name FROM products;
}
expect {
    CREATE TABLE products (category TEXT, product_code TEXT, name TEXT, PRIMARY KEY (category, product_code))
    Electronics|E001|Laptop
}

# Foreign key child column rename
test alter-table-rename-fk-child {
    CREATE TABLE parent (id INTEGER PRIMARY KEY);
    CREATE TABLE child (cid INTEGER PRIMARY KEY, pid INTEGER, FOREIGN KEY (pid) REFERENCES parent(id));
    INSERT INTO parent VALUES (1);
    INSERT INTO child VALUES (1, 1);

    ALTER TABLE child RENAME COLUMN pid TO parent_id;

    SELECT sql FROM sqlite_schema WHERE name = 'child';
}
expect {
    CREATE TABLE child (cid INTEGER PRIMARY KEY, parent_id INTEGER, FOREIGN KEY (parent_id) REFERENCES parent (id))
}

# Foreign key parent column rename - critical test
test alter-table-rename-fk-parent {
    CREATE TABLE orders (order_id INTEGER PRIMARY KEY, date TEXT);
    CREATE TABLE items (item_id INTEGER PRIMARY KEY, oid INTEGER, FOREIGN KEY (oid) REFERENCES orders(order_id));

    ALTER TABLE orders RENAME COLUMN order_id TO ord_id;

    SELECT sql FROM sqlite_schema WHERE name = 'orders';
    SELECT sql FROM sqlite_schema WHERE name = 'items';
}
expect {
    CREATE TABLE orders (ord_id INTEGER PRIMARY KEY, date TEXT)
    CREATE TABLE items (item_id INTEGER PRIMARY KEY, oid INTEGER, FOREIGN KEY (oid) REFERENCES orders (ord_id))
}

# Composite foreign key parent rename
test alter-table-rename-composite-fk-parent {
    CREATE TABLE products (cat TEXT, code TEXT, PRIMARY KEY (cat, code));
    CREATE TABLE inventory (id INTEGER PRIMARY KEY, cat TEXT, code TEXT, FOREIGN KEY (cat, code) REFERENCES products(cat, code));

    ALTER TABLE products RENAME COLUMN code TO sku;

    SELECT sql FROM sqlite_schema WHERE name = 'products';
    SELECT sql FROM sqlite_schema WHERE name = 'inventory';
}
expect {
    CREATE TABLE products (cat TEXT, sku TEXT, PRIMARY KEY (cat, sku))
    CREATE TABLE inventory (id INTEGER PRIMARY KEY, cat TEXT, code TEXT, FOREIGN KEY (cat, code) REFERENCES products (cat, sku))
}

# Multiple foreign keys to same parent
test alter-table-rename-multiple-fks {
    CREATE TABLE users (uid INTEGER PRIMARY KEY);
    CREATE TABLE messages (mid INTEGER PRIMARY KEY, sender INTEGER, receiver INTEGER,
                            FOREIGN KEY (sender) REFERENCES users(uid),
                            FOREIGN KEY (receiver) REFERENCES users(uid));

    ALTER TABLE users RENAME COLUMN uid TO user_id;

    SELECT sql FROM sqlite_schema WHERE name = 'messages';
}
expect {
    CREATE TABLE messages (mid INTEGER PRIMARY KEY, sender INTEGER, receiver INTEGER, FOREIGN KEY (sender) REFERENCES users (user_id), FOREIGN KEY (receiver) REFERENCES users (user_id))
}

# Self-referencing foreign key
test alter-table-rename-self-ref-fk {
    CREATE TABLE employees (emp_id INTEGER PRIMARY KEY, manager_id INTEGER,
                            FOREIGN KEY (manager_id) REFERENCES employees(emp_id));

    ALTER TABLE employees RENAME COLUMN emp_id TO employee_id;

    SELECT sql FROM sqlite_schema WHERE name = 'employees';
}
expect {
    CREATE TABLE employees (employee_id INTEGER PRIMARY KEY, manager_id INTEGER, FOREIGN KEY (manager_id) REFERENCES employees (employee_id))
}

# Chain of FK renames - parent is both PK and referenced
test alter-table-rename-fk-chain {
    CREATE TABLE t1 (a INTEGER PRIMARY KEY);
    CREATE TABLE t2 (b INTEGER PRIMARY KEY, a_ref INTEGER, FOREIGN KEY (a_ref) REFERENCES t1(a));
    CREATE TABLE t3 (c INTEGER PRIMARY KEY, b_ref INTEGER, FOREIGN KEY (b_ref) REFERENCES t2(b));

    ALTER TABLE t1 RENAME COLUMN a TO a_new;
    ALTER TABLE t2 RENAME COLUMN b TO b_new;

    SELECT sql FROM sqlite_schema WHERE name = 't2';
    SELECT sql FROM sqlite_schema WHERE name = 't3';
}
expect {
    CREATE TABLE t2 (b_new INTEGER PRIMARY KEY, a_ref INTEGER, FOREIGN KEY (a_ref) REFERENCES t1 (a_new))
    CREATE TABLE t3 (c INTEGER PRIMARY KEY, b_ref INTEGER, FOREIGN KEY (b_ref) REFERENCES t2 (b_new))
}

# FK with ON DELETE/UPDATE actions
test alter-table-rename-fk-actions {
    CREATE TABLE parent (pid INTEGER PRIMARY KEY);
    CREATE TABLE child (cid INTEGER PRIMARY KEY, pid INTEGER,
                        FOREIGN KEY (pid) REFERENCES parent(pid) ON DELETE CASCADE ON UPDATE RESTRICT);

    ALTER TABLE parent RENAME COLUMN pid TO parent_id;

    SELECT sql FROM sqlite_schema WHERE name = 'child';
}
expect {
    CREATE TABLE child (cid INTEGER PRIMARY KEY, pid INTEGER, FOREIGN KEY (pid) REFERENCES parent (parent_id) ON DELETE CASCADE ON UPDATE RESTRICT)
}

# FK with DEFERRABLE
test alter-table-rename-fk-deferrable {
    CREATE TABLE parent (id INTEGER PRIMARY KEY);
    CREATE TABLE child (id INTEGER PRIMARY KEY, pid INTEGER,
                        FOREIGN KEY (pid) REFERENCES parent(id) DEFERRABLE INITIALLY DEFERRED);

    ALTER TABLE parent RENAME COLUMN id TO parent_id;

    SELECT sql FROM sqlite_schema WHERE name = 'child';
}
expect {
    CREATE TABLE child (id INTEGER PRIMARY KEY, pid INTEGER, FOREIGN KEY (pid) REFERENCES parent (parent_id) DEFERRABLE INITIALLY DEFERRED)
}

# Rename with quoted identifiers in FK
test alter-table-rename-fk-quoted {
    CREATE TABLE "parent table" ("parent id" INTEGER PRIMARY KEY);
    CREATE TABLE child (id INTEGER PRIMARY KEY, pid INTEGER,
                        FOREIGN KEY (pid) REFERENCES "parent table"("parent id"));

    ALTER TABLE "parent table" RENAME COLUMN "parent id" TO "new id";

    SELECT sql FROM sqlite_schema WHERE name = 'child';
}
expect {
    CREATE TABLE child (id INTEGER PRIMARY KEY, pid INTEGER, FOREIGN KEY (pid) REFERENCES "parent table" ("new id"))
}

# Verify FK constraint still works after rename
test alter-table-fk-constraint-after-rename {
    PRAGMA foreign_keys = ON;
    CREATE TABLE parent (id INTEGER PRIMARY KEY);
    CREATE TABLE child (id INTEGER PRIMARY KEY, pid INTEGER, FOREIGN KEY (pid) REFERENCES parent(id));
    INSERT INTO parent VALUES (1);
    INSERT INTO child VALUES (1, 1);

    ALTER TABLE parent RENAME COLUMN id TO parent_id;

    -- This should work
    INSERT INTO child VALUES (2, 1);
    SELECT COUNT(*) FROM child;
}
expect {
    2
}

# FK constraint violation after rename should still fail
test alter-table-fk-violation-after-rename {
    PRAGMA foreign_keys = ON;
    CREATE TABLE parent (id INTEGER PRIMARY KEY);
    CREATE TABLE child (id INTEGER PRIMARY KEY, pid INTEGER, FOREIGN KEY (pid) REFERENCES parent(id));
    INSERT INTO parent VALUES (1);

    ALTER TABLE parent RENAME COLUMN id TO parent_id;

    -- This should fail with FK violation
    INSERT INTO child VALUES (1, 999);
}
expect error {
}

# Complex scenario with multiple table constraints
test alter-table-rename-complex-constraints {
    CREATE TABLE t (
        a INTEGER,
        b TEXT,
        c REAL,
        PRIMARY KEY (a, b),
        UNIQUE (b, c),
        FOREIGN KEY (a) REFERENCES t(a)
    );

    ALTER TABLE t RENAME COLUMN a TO x;
    ALTER TABLE t RENAME COLUMN b TO y;

    SELECT sql FROM sqlite_schema WHERE name = 't';
}
expect {
    CREATE TABLE t (x INTEGER, y TEXT, c REAL, PRIMARY KEY (x, y), UNIQUE (y, c), FOREIGN KEY (x) REFERENCES t (x))
}

# Rename column that appears in both PK and FK
test alter-table-rename-pk-and-fk {
    CREATE TABLE parent (id INTEGER PRIMARY KEY);
    CREATE TABLE child (
        id INTEGER PRIMARY KEY,
        parent_ref INTEGER,
        FOREIGN KEY (id) REFERENCES parent(id),
        FOREIGN KEY (parent_ref) REFERENCES parent(id)
        );

    ALTER TABLE parent RENAME COLUMN id TO pid;

    SELECT sql FROM sqlite_schema WHERE name = 'child';
}
expect {
    CREATE TABLE child (id INTEGER PRIMARY KEY, parent_ref INTEGER, FOREIGN KEY (id) REFERENCES parent (pid), FOREIGN KEY (parent_ref) REFERENCES parent (pid))
}

test rename-self-1 {
    PRAGMA foreign_keys = ON;
    CREATE TABLE s1(id INTEGER PRIMARY KEY, parent INTEGER,
        FOREIGN KEY(parent) REFERENCES s1(id));
    INSERT INTO s1 VALUES (1,NULL);
    INSERT INTO s1 VALUES (2,1);
    ALTER TABLE s1 RENAME TO s1_new;
    SELECT name, tbl_name, sql LIKE '%REFERENCES s1_new%' FROM sqlite_schema WHERE type='table' AND name='s1_new';
}
expect {
    s1_new|s1_new|1
}

test rename-self-2-composite {
    PRAGMA foreign_keys=ON;
    CREATE TABLE sc(id INTEGER, vr INTEGER, parent_id INTEGER, parent_vr INTEGER,
        PRIMARY KEY(id,vr),
        FOREIGN KEY(parent_id, parent_vr) REFERENCES sc(id,vr));
    INSERT INTO sc VALUES(1,1,NULL,NULL);
    INSERT INTO sc VALUES(2,1,1,1);
    
    ALTER TABLE sc RENAME TO sc_new;
    
    SELECT sql FROM sqlite_schema WHERE type='table' AND name='sc_new';
}
expect {
    CREATE TABLE sc_new (id INTEGER, vr INTEGER, parent_id INTEGER, parent_vr INTEGER, PRIMARY KEY (id, vr), FOREIGN KEY (parent_id, parent_vr) REFERENCES sc_new (id, vr))
}

test rename-parent-1 {
    PRAGMA foreign_keys=ON;
    CREATE TABLE p(id INTEGER PRIMARY KEY);
    CREATE TABLE c(id INTEGER PRIMARY KEY, pid INTEGER,
        FOREIGN KEY(pid) REFERENCES p(id));
    INSERT INTO p VALUES(1);
    INSERT INTO c VALUES(10,1);
    
    ALTER TABLE p RENAME TO p_new;
    INSERT INTO p_new VALUES(2);
    INSERT INTO c VALUES(20,2);
    SELECT c.id, c.pid FROM c JOIN p_new ON p_new.id=c.pid ORDER BY c.id;
}
expect {
    10|1
    20|2
}

test rename-parent-2-inline {
    PRAGMA foreign_keys=ON;
    CREATE TABLE p2(id INTEGER PRIMARY KEY);
    CREATE TABLE c2(id INTEGER PRIMARY KEY, pid INTEGER REFERENCES p2(id));
    ALTER TABLE p2 RENAME TO p2_new;
    -- child create SQL must have p2_new
    SELECT sql FROM sqlite_schema WHERE type='table' AND name='c2';
}
expect {
    CREATE TABLE c2 (id INTEGER PRIMARY KEY, pid INTEGER REFERENCES p2_new (id))
}

test rename-parent-3-composite {
    PRAGMA foreign_keys=ON;
    CREATE TABLE p3(a INTEGER, b INTEGER, PRIMARY KEY(a,b));
    CREATE TABLE c3(x INTEGER PRIMARY KEY, fa INTEGER, fb INTEGER,
        FOREIGN KEY(fa,fb) REFERENCES p3(a,b));
    INSERT INTO p3 VALUES(1,1);
    INSERT INTO c3 VALUES(1,1,1);
    
    ALTER TABLE p3 RENAME TO p3_new;
    SELECT sql  FROM sqlite_schema WHERE type='table' AND name='c3';
}
expect {
    CREATE TABLE c3 (x INTEGER PRIMARY KEY, fa INTEGER, fb INTEGER, FOREIGN KEY (fa, fb) REFERENCES p3_new (a, b))
}

# Adding a stored generated column via ALTER TABLE should error
test alter-table-add-generated-column-error {
    CREATE TABLE t(a);
    ALTER TABLE t ADD COLUMN b AS (NULL) STORED;
}
expect error {
    cannot add a STORED column
}

test alter-column-only-to-generated-error {
    CREATE TABLE t(a);
    ALTER TABLE t ALTER COLUMN a TO b AS (123);
}
expect error {
    Parse error: must have at least one non-generated column
}

test alter-column-all-to-generated-error {
    CREATE TABLE t(a, b);
    ALTER TABLE t ALTER COLUMN a TO c AS (123);
    ALTER TABLE t ALTER COLUMN b TO d AS (123);
}
expect error {
    Parse error: must have at least one non-generated column
}

test alter-column-to-generated-with-other-columns {
    CREATE TABLE t(a, b);
    ALTER TABLE t ALTER COLUMN a TO c AS (123);
    SELECT sql FROM sqlite_schema WHERE name = 't';
}
expect {
    CREATE TABLE t (c AS (123), b)
}

test alter-column-to-generated-rewrites-existing-rows {
    CREATE TABLE t(a, b, c);
    INSERT INTO t VALUES(1, 2, 3);
    ALTER TABLE t ALTER COLUMN b TO d AS (a * 3);
    SELECT a, d, c FROM t;
}
expect {
    1|3|3
}

test alter-column-to-generated-missing-column-error {
    CREATE TABLE t(a, b);
    ALTER TABLE t ALTER COLUMN a TO c AS (missing + 1);
}
expect error {
    no such column: missing
}

test alter-column-to-generated-nondeterministic-error {
    CREATE TABLE t(a, b);
    ALTER TABLE t ALTER COLUMN a TO c AS (random());
}
expect error {
    non-deterministic functions prohibited in generated columns
}

# ALTER COLUMN to STORED should be rejected
test alter-column-to-stored-error {
    CREATE TABLE t(a, b);
    ALTER TABLE t ALTER COLUMN a TO c AS (123) STORED;
}
expect error {
    cannot add a STORED column
}

# ALTER COLUMN on table that already has virtual columns
test alter-column-with-existing-virtual {
    CREATE TABLE t(a, b AS (a * 2), c);
    ALTER TABLE t ALTER COLUMN c TO d INTEGER;
    INSERT INTO t(a, d) VALUES(5, 100);
    SELECT a, b, d FROM t;
}
expect {
    5|10|100
}

# ALTER COLUMN to make a column generated when other virtual columns exist
test alter-column-to-generated-with-existing-virtual {
    CREATE TABLE t(a, b, c AS (a + 1));
    ALTER TABLE t ALTER COLUMN b TO d AS (a * 3);
    INSERT INTO t(a) VALUES(10);
    SELECT a, d, c FROM t;
}
expect {
    10|30|11
}

# ALTER COLUMN to generated with NOT NULL should validate existing rows
test alter-column-to-generated-notnull-violation {
    CREATE TABLE t(a, b);
    INSERT INTO t VALUES(NULL, 2);
    ALTER TABLE t ALTER COLUMN b TO c AS (a * 3) NOT NULL;
}
expect error {
    NOT NULL constraint failed
}

# ALTER COLUMN to generated with NOT NULL should succeed when all rows satisfy it
test alter-column-to-generated-notnull-ok {
    CREATE TABLE t(a, b);
    INSERT INTO t VALUES(1, 2), (3, 4);
    ALTER TABLE t ALTER COLUMN b TO c AS (a * 3) NOT NULL;
    SELECT a, c FROM t ORDER BY a;
}
expect {
    1|3
    3|9
}

# ALTER COLUMN to generated with CHECK should validate existing rows
test alter-column-to-generated-check-violation {
    CREATE TABLE t(a, b);
    INSERT INTO t VALUES(1, 2), (3, 4);
    ALTER TABLE t ALTER COLUMN b TO c AS (a * 3) CHECK(c < 5);
}
expect error {
    CHECK constraint failed
}

# Add column with a foreign key reference and verify schema SQL
test alter-table-add-column-with-fk-updates-schema {
    CREATE TABLE t(a);
    CREATE TABLE s(a);
    ALTER TABLE s ADD COLUMN b REFERENCES t(a);
    SELECT sql FROM sqlite_schema WHERE name = 's';
}
expect {
    CREATE TABLE s (a, b, FOREIGN KEY (b) REFERENCES t(a))
}

test alter-table-add-self-ref-fk-updates-schema {
    CREATE TABLE s(a);
    ALTER TABLE s ADD COLUMN b REFERENCES s(a);
    SELECT sql FROM sqlite_schema WHERE name = 's';
}
expect {
    CREATE TABLE s (a, b, FOREIGN KEY (b) REFERENCES s(a))
}

# NOT NULL column without default on EMPTY table should succeed (SQLite behavior)
test alter-table-add-notnull-col-empty-table {
    CREATE TABLE t (a);
    ALTER TABLE t ADD b NOT NULL;
    SELECT sql FROM sqlite_schema WHERE type = 'table' AND name = 't';
}
expect {
    CREATE TABLE t (a, b NOT NULL)
}

# NOT NULL column without default should fail on non-empty table
test fail-alter-table-add-notnull-col-nonempty {
    CREATE TABLE t (a);
    INSERT INTO t VALUES (1);
    ALTER TABLE t ADD b NOT NULL;
}
expect error {
}

# NOT NULL column with DEFAULT NULL should fail on non-empty table
test fail-alter-table-add-notnull-default-null {
    CREATE TABLE t (a);
    INSERT INTO t VALUES (1);
    ALTER TABLE t ADD b NOT NULL DEFAULT NULL;
}
expect error {
}

# NOT NULL column with non-null default should succeed on non-empty table
test alter-table-add-notnull-col-with-default {
    CREATE TABLE t (a);
    INSERT INTO t VALUES (1);
    ALTER TABLE t ADD b NOT NULL DEFAULT 42;
    INSERT INTO t (a) VALUES (2);
    SELECT * FROM t ORDER BY a;
}
expect {
    1|42
    2|42
}

# Binary expressions like (NULL + 5) are rejected as non-constant
test fail-alter-table-add-nonconstant-default {
    CREATE TABLE t (a);
    INSERT INTO t VALUES (1);
    ALTER TABLE t ADD b DEFAULT (NULL + 5);
}
expect error {
}

# CURRENT_TIMESTAMP on empty table should succeed
test alter-table-add-current-timestamp-empty {
    CREATE TABLE t (a);
    ALTER TABLE t ADD b DEFAULT CURRENT_TIMESTAMP;
    SELECT sql FROM sqlite_schema WHERE type = 'table' AND name = 't';
}
expect {
    CREATE TABLE t (a, b DEFAULT CURRENT_TIMESTAMP)
}

# CURRENT_TIMESTAMP on non-empty table should fail
test fail-alter-table-add-current-timestamp-nonempty {
    CREATE TABLE t (a);
    INSERT INTO t VALUES (1);
    ALTER TABLE t ADD b DEFAULT CURRENT_TIMESTAMP;
}
expect error {
}

# CURRENT_TIME on non-empty table should fail
test fail-alter-table-add-current-time-nonempty {
    CREATE TABLE t (a);
    INSERT INTO t VALUES (1);
    ALTER TABLE t ADD b DEFAULT CURRENT_TIME;
}
expect error {
}

# CURRENT_DATE on non-empty table should fail
test fail-alter-table-add-current-date-nonempty {
    CREATE TABLE t (a);
    INSERT INTO t VALUES (1);
    ALTER TABLE t ADD b DEFAULT CURRENT_DATE;
}
expect error {
}

# Bare identifier as default is treated as string literal (SQLite behavior)
test alter-table-add-identifier-default {
    CREATE TABLE t (a);
    ALTER TABLE t ADD b DEFAULT hello;
    INSERT INTO t (a) VALUES (1);
    SELECT a, b, typeof(b) FROM t;
}
expect {
    1|hello|text
}

# Signed literal defaults should work
test alter-table-add-signed-default {
    CREATE TABLE t (a);
    ALTER TABLE t ADD b DEFAULT -42;
    ALTER TABLE t ADD c DEFAULT +99;
    INSERT INTO t (a) VALUES (1);
    SELECT * FROM t;
}
expect {
    1|-42|99
}

# Parenthesized literal defaults should work
test alter-table-add-parens-default {
    CREATE TABLE t (a);
    ALTER TABLE t ADD b DEFAULT (123);
    ALTER TABLE t ADD c DEFAULT (-456);
    INSERT INTO t (a) VALUES (1);
    SELECT * FROM t;
}
expect {
    1|123|-456
}

# Existing rows must be rewritten when ALTER COLUMN changes affinity, so the
# stored serial type matches the new declared type (issue #3706).
test alter-column-numeric-to-text-coerces-existing-rows {
    CREATE TABLE t (x NUMERIC);
    INSERT INTO t VALUES (1), (2.5), ('abc');
    ALTER TABLE t ALTER COLUMN x TO y TEXT;
    SELECT typeof(y), y FROM t ORDER BY rowid;
}
expect {
    text|1
    text|2.5
    text|abc
}

test alter-column-text-to-integer-coerces-existing-rows {
    CREATE TABLE t (x TEXT);
    INSERT INTO t VALUES ('42'), ('abc');
    ALTER TABLE t ALTER COLUMN x TO y INTEGER;
    SELECT typeof(y), y FROM t ORDER BY rowid;
}
expect {
    integer|42
    text|abc
}

test alter-column-same-affinity-keeps-existing-rows {
    CREATE TABLE t (x INTEGER);
    INSERT INTO t VALUES (1), (2);
    ALTER TABLE t ALTER COLUMN x TO y INTEGER;
    SELECT typeof(y), y FROM t ORDER BY rowid;
}
expect {
    integer|1
    integer|2
}

# Issue #6624: Turning a virtual generated column into a regular column shifts
# the on-disk row layout (a new physical slot is added). Existing rows must be
# rewritten so the new schema's column indexes align with stored data, and
# secondary indexes must remain consistent with the rewritten table.
test alter-column-virtual-to-regular-rewrites-rows {
    CREATE TABLE core (
        id TEXT UNIQUE,
        x TEXT AS (id || ':' || row_rank),
        row_rank TEXT UNIQUE
    );
    INSERT INTO core(id, row_rank) VALUES('i-001','A001'),('i-002','A002');
    ALTER TABLE core ALTER COLUMN x TO x2 TEXT;
    INSERT INTO core(x2, id, row_rank) VALUES('x3','i-003','A003');
    SELECT id, row_rank, x2 FROM core NOT INDEXED ORDER BY rowid;
    SELECT row_rank FROM core INDEXED BY sqlite_autoindex_core_2 ORDER BY row_rank;
    PRAGMA integrity_check;
}
expect {
    i-001|A001|
    i-002|A002|
    i-003|A003|x3
    A001
    A002
    A003
    ok
}

# Same scenario as above under MVCC mode.
test alter-column-virtual-to-regular-rewrites-rows-mvcc {
    PRAGMA journal_mode = 'mvcc';
    CREATE TABLE core (
        id TEXT UNIQUE,
        x TEXT AS (id || ':' || row_rank),
        row_rank TEXT UNIQUE
    );
    BEGIN;
    INSERT INTO core(id, row_rank) VALUES('i-001','A001'),('i-002','A002');
    COMMIT;
    ALTER TABLE core ALTER COLUMN x TO x2 TEXT;
    INSERT INTO core(x2, id, row_rank) VALUES('x3','i-003','A003');
    SELECT id, row_rank, x2 FROM core NOT INDEXED ORDER BY rowid;
    SELECT row_rank FROM core INDEXED BY sqlite_autoindex_core_2 ORDER BY row_rank;
}
expect {
    mvcc
    i-001|A001|
    i-002|A002|
    i-003|A003|x3
    A001
    A002
    A003
}

# Rewriting must use the original physical layout when reading source columns.
# With a virtual column at index 1, reading row_rank by its new logical index
# (2) used to land on the wrong stored slot.
test alter-column-virtual-to-regular-preserves-trailing-columns {
    CREATE TABLE t (a TEXT, b TEXT AS (a || '_x'), c TEXT, d INTEGER);
    INSERT INTO t(a, c, d) VALUES('aa','cc',1),('aaa','ccc',2);
    ALTER TABLE t ALTER COLUMN b TO b2 TEXT;
    SELECT a, b2, c, d FROM t ORDER BY rowid;
    PRAGMA integrity_check;
}
expect {
    aa||cc|1
    aaa||ccc|2
    ok
}

# Reverse direction: regular -> virtual generated. The column that previously
# held a stored value must be removed from the row record, and trailing
# columns must keep their values.
test alter-column-regular-to-virtual-rewrites-rows {
    CREATE TABLE t (a TEXT UNIQUE, b TEXT, c TEXT);
    INSERT INTO t VALUES('a1','b1','c1'),('a2','b2','c2');
    ALTER TABLE t ALTER COLUMN b TO b2 TEXT GENERATED ALWAYS AS (a || c) VIRTUAL;
    SELECT a, b2, c FROM t ORDER BY rowid;
    PRAGMA integrity_check;
}
expect {
    a1|a1c1|c1
    a2|a2c2|c2
    ok
}

# Altering a column while keeping its name must not trip the duplicate
# column name check against the column being altered.
test alter-column-same-name-change-type {
    CREATE TABLE t (x INT);
    INSERT INTO t VALUES (1), (2);
    ALTER TABLE t ALTER COLUMN x TO x TEXT;
    SELECT sql FROM sqlite_schema WHERE name = 't';
    SELECT x, typeof(x) FROM t ORDER BY rowid;
    PRAGMA integrity_check;
}
expect {
    CREATE TABLE t (x TEXT)
    1|text
    2|text
    ok
}

test alter-column-same-name-add-default {
    CREATE TABLE t (a INTEGER, b TEXT);
    ALTER TABLE t ALTER COLUMN b TO b TEXT DEFAULT 'none';
    INSERT INTO t (a) VALUES (1);
    SELECT sql FROM sqlite_schema WHERE name = 't';
    SELECT a, b FROM t;
}
expect {
    CREATE TABLE t (a INTEGER, b TEXT DEFAULT 'none')
    1|none
}

# Colliding with a different existing column must still be an error.
test fail-alter-column-collides-with-other-column {
    CREATE TABLE t (a INTEGER, b TEXT);
    ALTER TABLE t ALTER COLUMN a TO b TEXT;
}
expect error {
}

# Adding NOT NULL must check existing rows and fail if any are NULL,
# even when the type does not change and no row rewrite runs.
test fail-alter-column-add-notnull-with-existing-nulls {
    CREATE TABLE t (a INTEGER, b TEXT);
    INSERT INTO t (a) VALUES (1);
    ALTER TABLE t ALTER COLUMN b TO b TEXT NOT NULL;
}
expect error {
}

# Same, through the row-rewrite path (affinity also changes).
test fail-alter-column-add-notnull-with-existing-nulls-rewrite {
    CREATE TABLE t (a INTEGER, b TEXT);
    INSERT INTO t (a) VALUES (1);
    ALTER TABLE t ALTER COLUMN b TO b INTEGER NOT NULL;
}
expect error {
}

test alter-column-add-notnull-without-nulls {
    CREATE TABLE t (a INTEGER, b TEXT);
    INSERT INTO t VALUES (1, 'x');
    ALTER TABLE t ALTER COLUMN b TO b TEXT NOT NULL;
    SELECT sql FROM sqlite_schema WHERE name = 't';
    PRAGMA integrity_check;
}
expect {
    CREATE TABLE t (a INTEGER, b TEXT NOT NULL)
    ok
}

# The added NOT NULL is enforced on later writes.
test fail-insert-null-after-alter-column-add-notnull {
    CREATE TABLE t (a INTEGER, b TEXT);
    INSERT INTO t VALUES (1, 'x');
    ALTER TABLE t ALTER COLUMN b TO b TEXT NOT NULL;
    INSERT INTO t (a) VALUES (2);
}
expect error {
}

test alter-column-drop-notnull {
    CREATE TABLE t (a INTEGER, b TEXT NOT NULL);
    INSERT INTO t VALUES (1, 'x');
    ALTER TABLE t ALTER COLUMN b TO b TEXT;
    INSERT INTO t (a) VALUES (2);
    SELECT a, b IS NULL FROM t ORDER BY a;
}
expect {
    1|0
    2|1
}

# Adding a CHECK must validate existing rows, like the rewrite path does.
test fail-alter-column-add-check-violated-by-existing-rows {
    CREATE TABLE t (x INTEGER);
    INSERT INTO t VALUES (-5);
    ALTER TABLE t ALTER COLUMN x TO x INTEGER CHECK (x > 0);
}
expect error {
}

test alter-column-add-check-existing-rows-pass {
    CREATE TABLE t (x INTEGER);
    INSERT INTO t VALUES (5);
    ALTER TABLE t ALTER COLUMN x TO x INTEGER CHECK (x > 0);
    SELECT sql FROM sqlite_schema WHERE name = 't';
}
expect {
    CREATE TABLE t (x INTEGER CHECK (x > 0))
}

# A CHECK added via ALTER COLUMN must be enforced on later writes.
test fail-insert-check-violation-after-alter-column-add-check {
    CREATE TABLE t (x INTEGER);
    ALTER TABLE t ALTER COLUMN x TO x INTEGER CHECK (x > 0);
    INSERT INTO t VALUES (-1);
}
expect error {
}

test fail-update-check-violation-after-alter-column-add-check {
    CREATE TABLE t (x INTEGER);
    INSERT INTO t VALUES (5);
    ALTER TABLE t ALTER COLUMN x TO x INTEGER CHECK (x > 0);
    UPDATE t SET x = -1;
}
expect error {
}

# Omitting the CHECK in the new definition drops it.
test alter-column-drop-check {
    CREATE TABLE t (x INTEGER CHECK (x > 0));
    ALTER TABLE t ALTER COLUMN x TO x INTEGER;
    INSERT INTO t VALUES (-1);
    SELECT sql FROM sqlite_schema WHERE name = 't';
    SELECT x FROM t;
}
expect {
    CREATE TABLE t (x INTEGER)
    -1
}

# A table-level CHECK does not belong to the column definition and must
# survive an ALTER COLUMN on the column it references.
test fail-alter-column-keeps-table-level-check {
    CREATE TABLE t (x INTEGER, CHECK (x > 0));
    INSERT INTO t VALUES (5);
    ALTER TABLE t ALTER COLUMN x TO x INTEGER DEFAULT 7;
    INSERT INTO t VALUES (-1);
}
expect error {
}

# STRICT: a type change must fail when existing values cannot be stored
# under the new type.
test fail-alter-column-strict-nonconforming-data {
    CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT) STRICT;
    INSERT INTO t VALUES (1, 'abc');
    ALTER TABLE t ALTER COLUMN v TO v INT;
}
expect error {
}

# STRICT: values that convert cleanly are converted, like an insert would.
test alter-column-strict-convertible-data {
    CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT) STRICT;
    INSERT INTO t VALUES (1, '123');
    ALTER TABLE t ALTER COLUMN v TO v INT;
    SELECT v, typeof(v) FROM t;
    PRAGMA integrity_check;
}
expect {
    123|integer
    ok
}

# STRICT: the new type must be a valid STRICT type name.
test fail-alter-column-strict-invalid-type-name {
    CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT) STRICT;
    ALTER TABLE t ALTER COLUMN v TO v VARCHAR;
}
expect error {
}

# STRICT: the new type is enforced on later writes.
test fail-insert-after-alter-column-strict-type-change {
    CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT) STRICT;
    ALTER TABLE t ALTER COLUMN v TO v INT;
    INSERT INTO t VALUES (1, 'abc');
}
expect error {
}

# The old column name matches case-insensitively; same-name means same
# column regardless of case, not a collision.
test alter-column-case-insensitive-old-name {
    CREATE TABLE t (x INT);
    INSERT INTO t VALUES (1);
    ALTER TABLE t ALTER COLUMN X TO x TEXT;
    SELECT sql FROM sqlite_schema WHERE name = 't';
    SELECT x, typeof(x) FROM t;
}
expect {
    CREATE TABLE t (x TEXT)
    1|text
}

# A case-only rename changes the stored name, like SQLite.
test rename-column-case-only {
    CREATE TABLE t (x INT);
    ALTER TABLE t RENAME COLUMN x TO X;
    SELECT sql FROM sqlite_schema WHERE name = 't';
}
expect {
    CREATE TABLE t (X INT)
}

# Renaming a column to itself is a no-op, like SQLite.
test rename-column-to-self-noop {
    CREATE TABLE t (x INT);
    INSERT INTO t VALUES (1);
    ALTER TABLE t RENAME COLUMN x TO x;
    SELECT sql FROM sqlite_schema WHERE name = 't';
    SELECT x FROM t;
}
expect {
    CREATE TABLE t (x INT)
    1
}

# Quoted identifiers: keywords and names with spaces work as old and
# new column names.
test alter-column-quoted-identifiers {
    CREATE TABLE t ("select" INT, "a b" TEXT);
    INSERT INTO t VALUES (1, 'x');
    ALTER TABLE t ALTER COLUMN "select" TO "order" TEXT;
    ALTER TABLE t ALTER COLUMN "a b" TO "a b" INTEGER DEFAULT 3;
    INSERT INTO t ("order") VALUES ('2');
    SELECT sql FROM sqlite_schema WHERE name = 't';
    SELECT "order", "a b" FROM t ORDER BY rowid;
}
expect {
    CREATE TABLE t ("order" TEXT, "a b" INTEGER DEFAULT 3)
    1|x
    2|3
}

test alter-column-replace-default {
    CREATE TABLE t (a INTEGER, b TEXT DEFAULT 'old');
    ALTER TABLE t ALTER COLUMN b TO b TEXT DEFAULT 'new';
    INSERT INTO t (a) VALUES (1);
    SELECT sql FROM sqlite_schema WHERE name = 't';
    SELECT b FROM t;
}
expect {
    CREATE TABLE t (a INTEGER, b TEXT DEFAULT 'new')
    new
}

test alter-column-drop-default {
    CREATE TABLE t (a INTEGER, b TEXT DEFAULT 'x');
    ALTER TABLE t ALTER COLUMN b TO b TEXT;
    INSERT INTO t (a) VALUES (1);
    SELECT sql FROM sqlite_schema WHERE name = 't';
    SELECT a, b IS NULL FROM t;
}
expect {
    CREATE TABLE t (a INTEGER, b TEXT)
    1|1
}

# Inserting the default applies the column's affinity, like CREATE TABLE.
test alter-column-default-applies-column-affinity {
    CREATE TABLE t (a INTEGER, b INTEGER);
    ALTER TABLE t ALTER COLUMN b TO b INTEGER DEFAULT '42';
    INSERT INTO t (a) VALUES (1);
    SELECT b, typeof(b) FROM t;
}
expect {
    42|integer
}

# Non-constant defaults are allowed: existing rows already have values,
# so nothing is applied retroactively (unlike ADD COLUMN, which
# restricts these to empty tables).
test alter-column-current-timestamp-default {
    CREATE TABLE t (a INTEGER, b TEXT);
    INSERT INTO t (a) VALUES (1);
    ALTER TABLE t ALTER COLUMN b TO b TEXT DEFAULT CURRENT_TIMESTAMP;
    INSERT INTO t (a) VALUES (2);
    SELECT a, b IS NULL FROM t WHERE a = 1;
    SELECT a, length(b) >= 19, b LIKE '20%' FROM t WHERE a = 2;
}
expect {
    1|1
    2|1|1
}

# Double-quoted strings resolve as string literals in the new default.
test alter-column-double-quoted-default {
    CREATE TABLE t (a INTEGER, b TEXT);
    ALTER TABLE t ALTER COLUMN b TO b TEXT DEFAULT "foo";
    INSERT INTO t (a) VALUES (1);
    SELECT b FROM t;
}
expect {
    foo
}

# Converting an indexed column must keep the index in sync: index seeks
# must find the converted values and integrity_check must pass.
test alter-column-conversion-rebuilds-index {
    CREATE TABLE t (x TEXT);
    CREATE INDEX i ON t (x);
    INSERT INTO t VALUES ('123'), ('456'), ('abc');
    ALTER TABLE t ALTER COLUMN x TO x INTEGER;
    SELECT x, typeof(x) FROM t WHERE x = 123;
    SELECT x, typeof(x) FROM t WHERE x = 'abc';
    PRAGMA integrity_check;
}
expect {
    123|integer
    abc|text
    ok
}

test alter-column-conversion-rebuilds-unique-index {
    CREATE TABLE t (x TEXT UNIQUE);
    INSERT INTO t VALUES ('7'), ('8');
    ALTER TABLE t ALTER COLUMN x TO x INTEGER;
    SELECT x, typeof(x) FROM t WHERE x = 7;
    PRAGMA integrity_check;
}
expect {
    7|integer
    ok
}

test alter-column-real-to-integer-affinity {
    CREATE TABLE t (x REAL);
    INSERT INTO t VALUES (3.0), (3.5);
    ALTER TABLE t ALTER COLUMN x TO x INTEGER;
    SELECT x, typeof(x) FROM t ORDER BY rowid;
    PRAGMA integrity_check;
}
expect {
    3|integer
    3.5|real
    ok
}

test alter-column-conversion-preserves-nulls {
    CREATE TABLE t (x TEXT);
    INSERT INTO t VALUES ('1'), (NULL);
    ALTER TABLE t ALTER COLUMN x TO x INTEGER;
    SELECT x IS NULL, typeof(x) FROM t ORDER BY rowid;
}
expect {
    0|integer
    1|null
}

test alter-column-rename-and-convert-rebuilds-index {
    CREATE TABLE t (x TEXT);
    CREATE INDEX i ON t (x);
    INSERT INTO t VALUES ('5');
    ALTER TABLE t ALTER COLUMN x TO y INTEGER;
    SELECT y, typeof(y) FROM t WHERE y = 5;
    PRAGMA integrity_check;
}
expect {
    5|integer
    ok
}

test alter-column-conversion-rebuilds-expression-index {
    CREATE TABLE t (x TEXT);
    CREATE INDEX i ON t (x + 1);
    INSERT INTO t VALUES ('10');
    ALTER TABLE t ALTER COLUMN x TO x INTEGER;
    SELECT x FROM t WHERE x + 1 = 11;
    PRAGMA integrity_check;
}
expect {
    10
    ok
}

# Values that become equal after the conversion must fail the UNIQUE
# index rebuild and roll the whole ALTER back.
test fail-alter-column-conversion-unique-collision {
    CREATE TABLE t (x BLOB UNIQUE);
    INSERT INTO t VALUES ('1'), (1);
    ALTER TABLE t ALTER COLUMN x TO x INTEGER;
}
expect error {
}

test alter-column-conversion-unique-collision-rolls-back {
    CREATE TABLE t (x BLOB UNIQUE);
    INSERT INTO t VALUES ('1'), (1);
    SELECT typeof(x) FROM t ORDER BY rowid;
    PRAGMA integrity_check;
}
expect {
    text
    integer
    ok
}

# Non-convertible values keep their stored type; convertible ones
# convert, matching SQLite affinity rules on insert.
test alter-column-text-to-integer-mixed-values {
    CREATE TABLE t (x TEXT);
    INSERT INTO t VALUES ('123'), ('abc'), ('45.0'), ('');
    ALTER TABLE t ALTER COLUMN x TO x INTEGER;
    SELECT quote(x), typeof(x) FROM t ORDER BY rowid;
}
expect {
    123|integer
    'abc'|text
    45|integer
    ''|text
}

# BLOB values are never converted by an affinity change.
test alter-column-conversion-never-touches-blobs {
    CREATE TABLE t (x);
    INSERT INTO t VALUES (x'deadbeef'), (42), ('7');
    ALTER TABLE t ALTER COLUMN x TO x TEXT;
    SELECT quote(x), typeof(x) FROM t ORDER BY rowid;
    PRAGMA integrity_check;
}
expect {
    X'DEADBEEF'|blob
    '42'|text
    '7'|text
    ok
}

# A type change within the same affinity keeps stored values untouched.
test alter-column-varchar-to-text-same-affinity {
    CREATE TABLE t (x VARCHAR);
    INSERT INTO t VALUES ('a'), (1);
    ALTER TABLE t ALTER COLUMN x TO x TEXT;
    SELECT sql FROM sqlite_schema WHERE name = 't';
    SELECT quote(x), typeof(x) FROM t ORDER BY rowid;
}
expect {
    CREATE TABLE t (x TEXT)
    'a'|text
    '1'|text
}

# Conversion must survive values large enough to spill to overflow pages.
test alter-column-conversion-with-overflow-pages {
    CREATE TABLE t (x TEXT);
    INSERT INTO t VALUES (replace(hex(zeroblob(5000)), '00', 'ab'));
    INSERT INTO t VALUES ('77');
    ALTER TABLE t ALTER COLUMN x TO x INTEGER;
    SELECT length(x), typeof(x) FROM t ORDER BY rowid;
    PRAGMA integrity_check;
}
expect {
    10000|text
    2|integer
    ok
}

# Changing the column collation rebuilds the index in the new order so
# seeks respect the new collation.
test alter-column-add-collate-nocase-with-index {
    CREATE TABLE t (name TEXT);
    CREATE INDEX i ON t (name);
    INSERT INTO t VALUES ('Apple'), ('apple'), ('BANANA'), ('banana'), ('cherry');
    ALTER TABLE t ALTER COLUMN name TO name TEXT COLLATE NOCASE;
    SELECT count(*) FROM t WHERE name = 'APPLE';
    SELECT name FROM t WHERE name = 'BaNaNa' ORDER BY rowid;
    PRAGMA integrity_check;
}
expect {
    2
    BANANA
    banana
    ok
}

# Omitting COLLATE drops it back to BINARY.
test alter-column-drop-collation {
    CREATE TABLE t (name TEXT COLLATE NOCASE);
    CREATE INDEX i ON t (name);
    INSERT INTO t VALUES ('Apple');
    ALTER TABLE t ALTER COLUMN name TO name TEXT;
    SELECT count(*) FROM t WHERE name = 'APPLE';
    SELECT count(*) FROM t WHERE name = 'Apple';
    PRAGMA integrity_check;
}
expect {
    0
    1
    ok
}

# An index with its own explicit collation does not follow the column.
test alter-column-collation-keeps-explicit-index-collation {
    CREATE TABLE t (name TEXT);
    CREATE INDEX i ON t (name COLLATE NOCASE);
    INSERT INTO t VALUES ('Apple'), ('apple');
    ALTER TABLE t ALTER COLUMN name TO name TEXT COLLATE NOCASE;
    SELECT count(*) FROM t WHERE name = 'APPLE';
    PRAGMA integrity_check;
}
expect {
    2
    ok
}

test alter-column-notnull-with-default {
    CREATE TABLE t (a INTEGER, b TEXT);
    INSERT INTO t VALUES (1, 'x');
    ALTER TABLE t ALTER COLUMN b TO b TEXT NOT NULL DEFAULT 'd';
    INSERT INTO t (a) VALUES (2);
    SELECT a, b FROM t ORDER BY a;
}
expect {
    1|x
    2|d
}

# A generated expression referencing an unknown column fails cleanly.
test fail-alter-column-generated-expr-unknown-column {
    CREATE TABLE t (a INT, b INT);
    ALTER TABLE t ALTER COLUMN b TO c AS (nosuch + 1);
}
expect error {
}

test fail-alter-column-generated-expr-self-reference {
    CREATE TABLE t (a INT, b INT);
    ALTER TABLE t ALTER COLUMN b TO c AS (c + 1);
}
expect error {
}

test alter-column-virtual-to-virtual-new-expression {
    CREATE TABLE t (a INT, b AS (a * 2));
    INSERT INTO t (a) VALUES (5);
    ALTER TABLE t ALTER COLUMN b TO b2 AS (a * 3);
    SELECT a, b2 FROM t;
    SELECT sql FROM sqlite_schema WHERE name = 't';
}
expect {
    5|15
    CREATE TABLE t (a INT, b2 AS (a * 3))
}

# Changing the type of a composite PRIMARY KEY member keeps the PK
# working: values are converted and the PK index is rebuilt.
test alter-column-composite-pk-member-type-change {
    CREATE TABLE t (a TEXT, b TEXT, c TEXT, PRIMARY KEY (a, b));
    INSERT INTO t VALUES ('x', '1', 'v1'), ('x', '2', 'v2');
    ALTER TABLE t ALTER COLUMN b TO b INTEGER;
    SELECT sql FROM sqlite_schema WHERE name = 't';
    SELECT c FROM t WHERE a = 'x' AND b = 1;
    PRAGMA integrity_check;
}
expect {
    CREATE TABLE t (a TEXT, b INTEGER, c TEXT, PRIMARY KEY (a, b))
    v1
    ok
}

# Changing an INTEGER PRIMARY KEY column to TEXT: rowids are preserved,
# the column keeps the old rowid values as text, and new inserts leave
# it NULL because it is no longer the rowid alias.
test alter-column-rowid-alias-to-text {
    CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT);
    INSERT INTO t VALUES (1, 'a'), (2, 'b');
    ALTER TABLE t ALTER COLUMN id TO id TEXT;
    INSERT INTO t (v) VALUES ('c');
    SELECT rowid, quote(id), v FROM t ORDER BY rowid;
    PRAGMA integrity_check;
}
expect {
    1|'1'|a
    2|'2'|b
    3|NULL|c
    ok
}

# A UNIQUE index created separately stays consistent after conversion.
test alter-column-separate-unique-index-conversion {
    CREATE TABLE t (x TEXT);
    CREATE UNIQUE INDEX u ON t (x);
    INSERT INTO t VALUES ('7'), ('8');
    ALTER TABLE t ALTER COLUMN x TO x INTEGER;
    SELECT x, typeof(x) FROM t WHERE x = 7;
    INSERT INTO t VALUES (7);
    PRAGMA integrity_check;
}
expect error {
}

# Renaming a column through ALTER COLUMN must update triggers and views
# like RENAME COLUMN does.
test alter-column-rename-updates-trigger-and-view {
    CREATE TABLE src (a INT, b TEXT);
    CREATE VIEW v AS SELECT b FROM src;
    CREATE TRIGGER tr AFTER INSERT ON src BEGIN UPDATE src SET b = new.b WHERE a = new.a; END;
    ALTER TABLE src ALTER COLUMN b TO name TEXT;
    INSERT INTO src VALUES (1, 'x');
    SELECT * FROM v;
    SELECT sql LIKE '%new.name%' FROM sqlite_schema WHERE name = 'tr';
}
expect {
    x
    1
}

# A foreign key added via ALTER COLUMN is enforced right away.
test fail-alter-column-add-fk-enforced {
    PRAGMA foreign_keys = ON;
    CREATE TABLE parent (id INTEGER PRIMARY KEY);
    CREATE TABLE child (cid INTEGER, pid INTEGER);
    INSERT INTO parent VALUES (1);
    ALTER TABLE child ALTER COLUMN pid TO pid INTEGER REFERENCES parent(id);
    INSERT INTO child VALUES (1, 1);
    INSERT INTO child VALUES (2, 99);
}
expect error {
}

# Omitting the REFERENCES clause drops the foreign key.
test alter-column-drop-fk-stops-enforcement {
    PRAGMA foreign_keys = ON;
    CREATE TABLE parent (id INTEGER PRIMARY KEY);
    CREATE TABLE child (cid INTEGER, pid INTEGER REFERENCES parent(id));
    ALTER TABLE child ALTER COLUMN pid TO pid INTEGER;
    INSERT INTO child VALUES (1, 99);
    SELECT count(*) FROM child;
}
expect {
    1
}

# A table-level foreign key does not belong to the column definition and
# must survive the alter.
test fail-alter-column-keeps-table-level-fk {
    PRAGMA foreign_keys = ON;
    CREATE TABLE parent (id INTEGER PRIMARY KEY);
    CREATE TABLE child (cid INTEGER, pid INTEGER, FOREIGN KEY (pid) REFERENCES parent(id));
    ALTER TABLE child ALTER COLUMN pid TO pid INTEGER DEFAULT 7;
    INSERT INTO child VALUES (1, 99);
}
expect error {
}

# WITHOUT ROWID: the PRIMARY KEY is the table itself; altering a PK
# column would strip or reorder it. Must be rejected.
test fail-alter-column-without-rowid-pk-member {
    CREATE TABLE w (k TEXT PRIMARY KEY, v TEXT) WITHOUT ROWID;
    ALTER TABLE w ALTER COLUMN k TO k INTEGER;
}
expect error {
}

# WITHOUT ROWID: the row rewrite machinery is rowid-based, so a type
# change that must rewrite rows is rejected instead of leaving the
# schema claiming a type the rows do not have.
test fail-alter-column-without-rowid-type-change {
    CREATE TABLE w (k TEXT PRIMARY KEY, v TEXT) WITHOUT ROWID;
    INSERT INTO w VALUES ('a', '1');
    ALTER TABLE w ALTER COLUMN v TO v INTEGER;
}
expect error {
}

# WITHOUT ROWID: metadata-only changes still work.
test alter-column-without-rowid-default-change {
    CREATE TABLE w (k TEXT PRIMARY KEY, v TEXT) WITHOUT ROWID;
    ALTER TABLE w ALTER COLUMN v TO v TEXT DEFAULT 'd';
    INSERT INTO w (k) VALUES ('a');
    SELECT k, v FROM w;
}
expect {
    a|d
}

# WITHOUT ROWID: the NOT NULL validation scan works.
test fail-alter-column-without-rowid-notnull-with-nulls {
    CREATE TABLE w (k TEXT PRIMARY KEY, v TEXT) WITHOUT ROWID;
    INSERT INTO w (k) VALUES ('a');
    ALTER TABLE w ALTER COLUMN v TO v TEXT NOT NULL;
}
expect error {
}

# ROLLBACK restores both the schema and the pre-ALTER row data.
test alter-column-rollback-restores-schema-and-data {
    CREATE TABLE t (x INT);
    INSERT INTO t VALUES (1);
    BEGIN;
    ALTER TABLE t ALTER COLUMN x TO x TEXT;
    ROLLBACK;
    SELECT sql FROM sqlite_schema WHERE name = 't';
    SELECT x, typeof(x) FROM t;
    PRAGMA integrity_check;
}
expect {
    CREATE TABLE t (x INT)
    1|integer
    ok
}

test fail-alter-column-sqlite-schema-protected {
    ALTER TABLE sqlite_schema ALTER COLUMN name TO name2 TEXT;
}
expect error {
}

# Empty table: pure metadata change, no rewrite needed.
test alter-column-empty-table {
    CREATE TABLE t (x TEXT);
    ALTER TABLE t ALTER COLUMN x TO x INTEGER DEFAULT 5;
    INSERT INTO t VALUES ('9');
    INSERT INTO t (rowid) VALUES (5);
    SELECT x, typeof(x) FROM t ORDER BY rowid;
}
expect {
    9|integer
    5|integer
}

# A partial index whose WHERE references the converted column is
# rebuilt so membership reflects the converted values.
test alter-column-conversion-rebuilds-partial-index {
    CREATE TABLE t (x TEXT, y TEXT);
    CREATE INDEX pi ON t (y) WHERE x > 5;
    INSERT INTO t VALUES ('10', 'a'), ('2', 'b');
    ALTER TABLE t ALTER COLUMN x TO x INTEGER;
    SELECT y FROM t WHERE x > 5;
    PRAGMA integrity_check;
}
expect {
    a
    ok
}

# STRICT ANY -> TEXT must fail when a stored value (a BLOB) cannot be
# stored under TEXT; STRICT never coerces BLOBs.
test fail-alter-column-strict-any-to-text-with-blob {
    CREATE TABLE s (id INTEGER PRIMARY KEY, v ANY) STRICT;
    INSERT INTO s VALUES (1, 'abc'), (2, x'ff');
    ALTER TABLE s ALTER COLUMN v TO v TEXT;
}
expect error {
}

test alter-column-strict-text-to-any {
    CREATE TABLE s (id INTEGER PRIMARY KEY, v TEXT) STRICT;
    INSERT INTO s VALUES (1, 'abc');
    ALTER TABLE s ALTER COLUMN v TO v ANY;
    INSERT INTO s VALUES (2, 42);
    SELECT quote(v), typeof(v) FROM s ORDER BY id;
    PRAGMA integrity_check;
}
expect {
    'abc'|text
    42|integer
    ok
}

test alter-column-conversion-mvcc {
    PRAGMA journal_mode = 'mvcc';
    CREATE TABLE t (x TEXT);
    INSERT INTO t VALUES ('123'), ('abc');
    ALTER TABLE t ALTER COLUMN x TO x INTEGER;
    SELECT quote(x), typeof(x) FROM t ORDER BY rowid;
}
expect {
    mvcc
    123|integer
    'abc'|text
}

# The index refill machinery is not MVCC-safe, so converting an indexed
# column errors in MVCC mode instead of corrupting the index.
test fail-alter-column-mvcc-indexed-conversion {
    PRAGMA journal_mode = 'mvcc';
    CREATE TABLE t (x TEXT);
    CREATE INDEX i ON t (x);
    ALTER TABLE t ALTER COLUMN x TO x INTEGER;
}
expect error {
}

test fail-alter-column-add-notnull-with-nulls-mvcc {
    PRAGMA journal_mode = 'mvcc';
    CREATE TABLE t (a INTEGER, b TEXT);
    INSERT INTO t (a) VALUES (1);
    ALTER TABLE t ALTER COLUMN b TO b TEXT NOT NULL;
}
expect error {
}

# Changing to a custom type must not leave stored values the type's own
# rules reject. Custom-type encoding does not run on existing rows, so
# the change requires an empty table.
test fail-alter-column-to-custom-type-nonempty {
    CREATE TABLE b (id INTEGER PRIMARY KEY, v TEXT) STRICT;
    INSERT INTO b VALUES (1, 'abcdef');
    ALTER TABLE b ALTER COLUMN v TO v VARCHAR(3);
}
expect error {
}

test alter-column-to-custom-type-empty-table {
    CREATE TABLE b (id INTEGER PRIMARY KEY, v TEXT) STRICT;
    ALTER TABLE b ALTER COLUMN v TO v VARCHAR(3);
    INSERT INTO b VALUES (1, 'abc');
    SELECT v FROM b;
}
expect {
    abc
}

# The custom type's rules apply to writes after the change.
test fail-insert-too-long-after-alter-to-varchar {
    CREATE TABLE b (id INTEGER PRIMARY KEY, v TEXT) STRICT;
    ALTER TABLE b ALTER COLUMN v TO v VARCHAR(3);
    INSERT INTO b VALUES (1, 'toolong');
}
expect error {
}

# Domain types require STRICT tables, same as ADD COLUMN: on a
# non-STRICT table the domain's constraints would silently not apply.
test fail-alter-column-domain-type-on-non-strict-table {
    CREATE DOMAIN posint AS integer CHECK (value > 0);
    CREATE TABLE n (x INTEGER);
    ALTER TABLE n ALTER COLUMN x TO x posint;
}
expect error {
}

test alter-column-domain-type-on-strict-table {
    CREATE DOMAIN posint AS integer CHECK (value > 0);
    CREATE TABLE n (id INTEGER PRIMARY KEY, x INTEGER) STRICT;
    ALTER TABLE n ALTER COLUMN x TO x posint;
    INSERT INTO n VALUES (1, -5);
}
expect error {
}
