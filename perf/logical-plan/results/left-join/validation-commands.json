[
  {
    "name": "fmt",
    "command": [
      "cargo",
      "fmt",
      "--all"
    ]
  },
  {
    "name": "optimizer",
    "command": [
      "cargo",
      "test",
      "-p",
      "turso_core",
      "-p",
      "core_tester",
      "-p",
      "sqltest",
      "-p",
      "differential-fuzzer",
      "--features",
      "turso_core/fts,turso_core/bench",
      "--lib",
      "--test",
      "integration_tests",
      "translate::optimizer::tests::"
    ]
  },
  {
    "name": "forced",
    "command": [
      "cargo",
      "test",
      "-p",
      "turso_core",
      "-p",
      "core_tester",
      "-p",
      "sqltest",
      "-p",
      "differential-fuzzer",
      "--features",
      "turso_core/fts,turso_core/bench",
      "--lib",
      "--test",
      "integration_tests",
      "every_supported_unnesting_form_returns_the_same_rows"
    ]
  },
  {
    "name": "integration",
    "command": [
      "cargo",
      "test",
      "-p",
      "turso_core",
      "-p",
      "core_tester",
      "-p",
      "sqltest",
      "-p",
      "differential-fuzzer",
      "--features",
      "turso_core/fts,turso_core/bench",
      "--lib",
      "--test",
      "integration_tests",
      "query_processing::",
      "--",
      "--skip",
      "query_processing::test_write_path::test_busy_snapshot_immediate"
    ]
  },
  {
    "name": "runner-build",
    "command": [
      "cargo",
      "build",
      "-p",
      "core_tester",
      "-p",
      "sqltest",
      "-p",
      "differential-fuzzer",
      "--features",
      "turso_core/fts,turso_core/bench",
      "--bin",
      "sqltest",
      "--bin",
      "differential_fuzzer"
    ]
  },
  {
    "name": "sql",
    "command": [
      "/workspace/target/logical-plan-build/debug/sqltest",
      "run",
      "/workspace/sqlite/conformance/sqlite-sqltests/subquery",
      "/workspace/sqlite/conformance/sqlite-sqltests/limit.sqltest",
      "/workspace/sqlite/conformance/sqlite-sqltests/compound-select-orderby.sqltest",
      "/workspace/sqlite/conformance/sqlite-sqltests/compound-select-order-by-before-operator-error.sqltest",
      "/workspace/sqlite/conformance/sqlite-sqltests/union_all.sqltest",
      "/workspace/sqlite/conformance/sqlite-sqltests/values.sqltest",
      "/workspace/sqlite/conformance/sqlite-sqltests/groupby",
      "/workspace/sqlite/conformance/sqlite-sqltests/agg-functions",
      "/workspace/sqlite/conformance/sqlite-sqltests/unnest-exists.sqltest",
      "/workspace/sqlite/conformance/sqlite-sqltests/row-value-in.sqltest",
      "/workspace/sqlite/conformance/sqlite-sqltests/row-value-arity-mismatch-error.sqltest",
      "/workspace/sqlite/conformance/sqlite-sqltests/affinity.sqltest",
      "/workspace/sqlite/conformance/sqlite-sqltests/index-seek-subquery-affinity.sqltest",
      "/workspace/sqlite/conformance/sqlite-sqltests/index_seek_comparison_affinity.sqltest",
      "/workspace/sqlite/conformance/sqlite-sqltests/from-subquery-affinity.sqltest",
      "/workspace/sqlite/conformance/sqlite-sqltests/window-agg-row-value.sqltest",
      "/workspace/sqlite/conformance/sqlite-sqltests/aggregate-bare-column-zero-rows.sqltest",
      "/workspace/sqlite/conformance/sqlite-sqltests/aggregate-filter-in-subquery-grouped.sqltest",
      "/workspace/sqlite/conformance/sqlite-sqltests/aggregate-of-outer-column.sqltest",
      "/workspace/sqlite/conformance/sqlite-sqltests/collate.sqltest",
      "/workspace/sqlite/conformance/sqlite-sqltests/correlated-subquery-aggregate-groupby.sqltest",
      "/workspace/sqlite/conformance/sqlite-sqltests/cte-union-all-aggregate-literals.sqltest",
      "/workspace/sqlite/conformance/sqlite-sqltests/in-subquery-ungrouped-aggregate.sqltest",
      "/workspace/sqlite/conformance/sqlite-sqltests/join-empty-table-ungrouped-aggregate.sqltest",
      "/workspace/sqlite/conformance/sqlite-sqltests/left-join-null-rejecting-terms.sqltest",
      "/workspace/sqlite/conformance/sqlite-sqltests/left-join-case-iif-null-masking.sqltest",
      "/workspace/sqlite/conformance/sqlite-sqltests/left-join-ifnull-optimization.sqltest",
      "/workspace/sqlite/conformance/sqlite-sqltests/join/default.sqltest",
      "/workspace/sqlite/conformance/sqlite-sqltests/join/natural_join_no_common.sqltest",
      "/workspace/sqlite/conformance/sqlite-sqltests/join/outer_hash_join.sqltest",
      "--snapshot-filter",
      "__never__",
      "--jobs",
      "4"
    ]
  },
  {
    "name": "clippy",
    "command": [
      "cargo",
      "clippy",
      "-p",
      "turso_core",
      "-p",
      "core_tester",
      "-p",
      "sqltest",
      "-p",
      "differential-fuzzer",
      "--all-targets",
      "--features",
      "turso_core/fts,turso_core/bench",
      "--no-deps",
      "--",
      "--deny=warnings"
    ]
  }
]
