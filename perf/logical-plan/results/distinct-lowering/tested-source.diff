+      FROM source NOT INDEXED
+     WHERE target.id = source.id
+       AND NOT EXISTS (
+           SELECT 1
+             FROM blockers
+            WHERE SIGN(-blockers.value)
+              AND blockers.id IS NOT source.id
+       )
+       AND NOT EXISTS (
+           SELECT 1
+             FROM exclusions
+            WHERE exclusions.source_id = source.id
+              AND exclusions.target_id = target.id
+              AND NOT EXISTS (
+                  SELECT 1
+                    FROM exclusion_details
+                   WHERE exclusion_details.exclusion_id = exclusions.id
+              )
+       );
+    SELECT * FROM target ORDER BY id;
+}
+expect {
+    1|10
+    2|200
+}
