+fn compound_column_collation<'a>(
+    inputs: impl Iterator<Item = &'a SelectPlan>,
+    position: usize,
+) -> crate::Result<Option<CollationSeq>> {
+    for input in inputs {
+        if let Some(collation) = get_collseq_from_expr(
+            &input.result_columns[position].expr,
+            &input.table_references,
+        )? {
+            return Ok(Some(collation));
+        }
+    }
+    Ok(None)
+}
