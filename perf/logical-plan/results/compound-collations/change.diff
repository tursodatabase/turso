 /// Emits bytecode for sorting compound select results and outputting them.
 /// Reads from the collection index, inserts into a Sorter with ORDER BY keys,
 /// then reads sorted rows and emits to the real destination with LIMIT/OFFSET.
diff --git a/sqlite/conformance/sqlite-sqltests/compound-select-orderby.sqltest b/sqlite/conformance/sqlite-sqltests/compound-select-orderby.sqltest
index 6e3ad8d116..f2bf3ee494 100644
--- a/sqlite/conformance/sqlite-sqltests/compound-select-orderby.sqltest
+++ b/sqlite/conformance/sqlite-sqltests/compound-select-orderby.sqltest
@@ -1,5 +1,82 @@
 @database :memory:
 
+test compound-collation-union-keeps-leftmost-collation {
+    SELECT count(*) FROM (
+        SELECT 'A' COLLATE NOCASE
+        UNION SELECT 'B' COLLATE BINARY
+        UNION SELECT 'b'
+    );
+}
+expect {
+    2
+}
+
+test compound-collation-intersect-keeps-leftmost-collation {
+    SELECT count(*) FROM (
+        SELECT 'A' COLLATE NOCASE
+        UNION SELECT 'B' COLLATE BINARY
+        INTERSECT SELECT 'b'
+    );
+}
+expect {
+    1
+}
+
+test compound-collation-except-keeps-leftmost-collation {
+    SELECT count(*) FROM (
+        SELECT 'A' COLLATE NOCASE
+        UNION SELECT 'B' COLLATE BINARY
+        EXCEPT SELECT 'b'
+    );
+}
+expect {
+    1
+}
+
+test compound-collation-ordering-finds-middle-collation {
+    SELECT 'Z' AS a
+    UNION ALL SELECT 'b' COLLATE NOCASE
+    UNION ALL SELECT 'a'
+    ORDER BY 1;
+}
+expect {
+    a
+    b
+    Z
+}
+
+test compound-collation-later-input-defines-earlier-comparisons {
+    SELECT count(*) FROM (
+        SELECT 'A' INTERSECT SELECT 'a'
+        UNION ALL SELECT 'B' COLLATE NOCASE
+    );
+    SELECT 'A' INTERSECT SELECT 'a'
+    UNION ALL SELECT 'B' COLLATE NOCASE
+    ORDER BY 1 COLLATE BINARY;
+}
+expect {
+    2
+    A
+    B
+}
+
+test compound-collation-explicit-binary-precedes-later-nocase {
+    SELECT count(*) FROM (
+        SELECT 'A' COLLATE BINARY INTERSECT SELECT 'a'
+        UNION ALL SELECT 'B' COLLATE NOCASE
+    );
+    SELECT 'Z' COLLATE BINARY
+    UNION ALL SELECT 'b' COLLATE NOCASE
+    UNION ALL SELECT 'a'
+    ORDER BY 1;
+}
+expect {
+    1
+    Z
+    a
+    b
+}
+
