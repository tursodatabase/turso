load("//tools/bazel:rust.bzl", "turso_rust_binary", "turso_rust_library", "turso_rust_test")

FUZZER_SRCS = glob(
    ["**/*.rs"],
    exclude = [
        "main.rs",
        "printf_fuzzer.rs",
        "custom_types_fuzzer.rs",
        "probe.rs",
    ],
)

FUZZER_DEPS = [
    "//core:turso_core",
    "//sqlite/parser:turso_parser",
    "//testing/differential-oracle/sql_gen:sql_gen",
    "//testing/differential-oracle/sql_gen_prop:sql_gen_prop",
]

turso_rust_library(
    name = "differential_fuzzer_lib",
    srcs = FUZZER_SRCS,
    cargo_target = "lib:differential_fuzzer",
    crate_name = "differential_fuzzer",
    crate_root = "lib.rs",
    deps = FUZZER_DEPS,
)

turso_rust_test(
    name = "differential_fuzzer_test",
    crate = ":differential_fuzzer_lib",
)

[
    turso_rust_binary(
        name = name,
        srcs = [src],
        deps = [":differential_fuzzer_lib"] + FUZZER_DEPS,
    )
    for name, src in {
        "custom_types_fuzzer": "custom_types_fuzzer.rs",
        "differential_fuzzer": "main.rs",
        "differential_probe": "probe.rs",
        "printf_fuzzer": "printf_fuzzer.rs",
    }.items()
]
