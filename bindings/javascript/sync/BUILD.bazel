load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_shared_library")

SYNC_JS_FEATURES = []

WASM_RUST_STD = "@@rules_rust++rust+rust_linux_x86_64__wasm32-wasip1-threads__stable_tools//:rust_std-wasm32-wasip1-threads"
WASM_TARGET = [
    "@platforms//cpu:wasm32",
    "@platforms//os:wasi",
    "@rules_rust//rust/platform:wasi_preview_1",
]

cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    aliases = aliases(build = True),
    crate_root = "build.rs",
    deps = all_crate_deps(build = True),
    edition = crate_edition(),
)

cargo_build_script(
    name = "wasm_build_script",
    srcs = ["build.rs"],
    aliases = aliases(build = True),
    build_script_env = {"EMNAPI_LINK_DIR": "bindings/javascript/node_modules/emnapi/lib/wasm32-wasi-threads"},
    compile_data = [
        "//bindings/javascript:emnapi_link_files",
        WASM_RUST_STD,
    ],
    crate_root = "build.rs",
    deps = all_crate_deps(build = True),
    edition = crate_edition(),
)

rust_shared_library(
    name = "turso_sync_js_cdylib",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = SYNC_JS_FEATURES,
    crate_name = "turso_sync_js",
    crate_root = "src/lib.rs",
    deps = [":build_script", "//bindings/javascript:turso_node", "//core:turso_core", "//sync/engine:turso_sync_engine"] + all_crate_deps(normal = True),
    edition = crate_edition(),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_shared_library(
    name = "turso_sync_js_wasm",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = ["browser"],
    crate_name = "turso_sync_js",
    crate_root = "src/lib.rs",
    compile_data = [
        "//bindings/javascript:emnapi_link_files",
        WASM_RUST_STD,
    ],
    deps = [":wasm_build_script", "//bindings/javascript:turso_node_wasm_lib", "//core:turso_core", "//sync/engine:turso_sync_engine"] + all_crate_deps(normal = True),
    edition = crate_edition(),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    target_compatible_with = WASM_TARGET,
)
