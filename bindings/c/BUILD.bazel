load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_deps", "crate_edition")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_shared_library", "rust_static_library", "rust_test")

C_FEATURES = ["capi", "lfs", "sqlite3"]

cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    aliases = aliases(build = True),
    crate_root = "build.rs",
    data = ["src/varargs.c"],
    deps = all_crate_deps(build = True),
    edition = crate_edition(),
)

rust_library(
    name = "turso_sqlite3",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = C_FEATURES,
    crate_root = "src/lib.rs",
    deps = [":build_script", "//core:turso_core", "//extensions/core:turso_ext"] + all_crate_deps(normal = True),
    edition = crate_edition(),
    visibility = ["//visibility:public"],
)

rust_shared_library(
    name = "turso_sqlite3_cdylib",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = C_FEATURES,
    crate_name = "turso_sqlite3",
    crate_root = "src/lib.rs",
    deps = [":build_script", "//core:turso_core", "//extensions/core:turso_ext"] + all_crate_deps(normal = True),
    edition = crate_edition(),
)

rust_static_library(
    name = "turso_sqlite3_staticlib",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = C_FEATURES,
    crate_name = "turso_sqlite3",
    crate_root = "src/lib.rs",
    deps = [":build_script", "//core:turso_core", "//extensions/core:turso_ext"] + all_crate_deps(normal = True),
    edition = crate_edition(),
)

rust_test(
    name = "turso_sqlite3_test",
    crate = ":turso_sqlite3",
    crate_features = C_FEATURES,
    aliases = aliases(normal_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

[
    rust_test(
        name = name + "_test",
        srcs = [path],
        aliases = aliases(normal_dev = True),
        crate_features = C_FEATURES,
        crate_root = path,
        data = ["//:testing/system/testing.db"],
        deps = [":turso_sqlite3"] + crate_deps(["tempfile"]) + (["@rules_rust//tools/runfiles"] if name == "compat" else []) + all_crate_deps(normal = True),
        edition = crate_edition(),
        rustc_env = {"CARGO_MANIFEST_DIR": "bindings/c"},
    )
    for name, path in {
        "compat": "tests/compat/mod.rs",
        "oracle": "tests/oracle.rs",
    }.items()
]
